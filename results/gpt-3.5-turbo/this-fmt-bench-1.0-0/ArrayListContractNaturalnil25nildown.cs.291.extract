void TestFunction()
{
    // Since the LastIndexOf method is protected, we cannot directly test it using public methods. 
    // One way to indirectly test this method is to add an element to the ArrayList and then check 
    // if the LastIndexOf method returns -1 when provided with a value that is not in the list.
    
    ArrayList list = new ArrayList();
    list.Add(1);
    
    Debug.Assert(list.LastIndexOf(100) == -1);
}
