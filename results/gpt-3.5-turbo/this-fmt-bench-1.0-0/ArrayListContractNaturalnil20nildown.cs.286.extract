void TestFunction(int index, Object value)
{
    this.Insert(index, value);
    int firstOccurIndex = this.IndexOf(value);
    int lastOccurIndex = this.LastIndexOf(value);
    Debug.Assert(firstOccurIndex <= index && index <= lastOccurIndex);
}
--------------------
void TestFunction(ArrayList list, int index, Object value)
{
    int old_first_index = list.IndexOf(value);
    int old_last_index = list.LastIndexOf(value);
    list.Insert(index, value);
    int new_first_index = list.IndexOf(value);
    int new_last_index = list.LastIndexOf(value);
    Debug.Assert(new_first_index >= old_first_index && new_last_index <= old_last_index);
}
