void TestFunction(int index, Object value)
{
    int initial_first_index = this.IndexOf(value);
    int initial_last_index = this.LastIndexOf(value);
    
    this.Insert(index, value);
    
    int final_first_index = this.IndexOf(value);
    int final_last_index = this.LastIndexOf(value);
    
    Debug.Assert(final_first_index >= initial_first_index && final_last_index <= initial_last_index);
}
--------------------
void TestFunction(object value, int index)
{
    int initial_index = this.IndexOf(value);
    int initial_last_index = this.LastIndexOf(value);
    
    this.Insert(index, value);

    int new_index = this.IndexOf(value);
    int new_last_index = this.LastIndexOf(value);

    Debug.Assert(new_index >= initial_index && new_index <= initial_last_index + 1);
    Debug.Assert(new_last_index <= new_index);
}
--------------------
void TestFunction(Object value, int index)
{
    int initial_index = this.IndexOf(value);
    int final_index = this.LastIndexOf(value);
    this.Insert(index, value);
    Debug.Assert(initial_index <= index && index <= final_index);
}
--------------------
void TestFunction(int index, Object value)
{
    ArrayList list = new ArrayList();
    list.Add(value);
    int old_index = list.IndexOf(value);
    list.Insert(index, value);
    int new_index = list.IndexOf(value);
    Debug.Assert(new_index > old_index && new_index < list.LastIndexOf(value));
}
--------------------
void TestFunction(int index, Object value)
{
    int initial_index = this.IndexOf(value);
    int final_index = this.LastIndexOf(value);
    
    this.Insert(index, value);
    
    Debug.Assert(index >= initial_index && index <= final_index);
}
