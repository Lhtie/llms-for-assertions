
void TestFunction(int index, Object value)
{
    // Assuming 'list' is an instance of ArrayList
    int initial_index = list.LastIndexOf(value);
    list.Insert(index, value);
    int final_index = list.IndexOf(value);
    Debug.Assert(final_index > initial_index && final_index < list.Count - 1);
}
--------------------
void TestFunction(int index, Object value)
{
    int initial_first_index = this.IndexOf(value); // get initial first index of value
    int initial_last_index = this.LastIndexOf(value); // get initial last index of value
    
    this.Insert(index, value);
    
    int final_first_index = this.IndexOf(value); // get final first index of value after insertion
    int final_last_index = this.LastIndexOf(value); // get final last index of value after insertion
    
    Debug.Assert(final_first_index >= initial_first_index && final_last_index >= initial_last_index);
}
--------------------
void TestFunction(ArrayList arrList, object value, int index)
{
    int initialIndexOfValue = arrList.IndexOf(value);
    int oldCount = arrList.Count;
    arrList.Insert(index, value);
    int newCount = arrList.Count;
    int newIndexOfValue = arrList.IndexOf(value);
    Debug.Assert(newIndexOfValue >= initialIndexOfValue && newIndexOfValue < oldCount);
}
