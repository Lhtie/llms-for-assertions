
void TestFunction(Object value)
{
    int ret = this.LastIndexOf(value);
    Debug.Assert(ret >= 0 || !this.Contains(value));
}
--------------------
void TestFunction()
{
    ArrayList list = new ArrayList();
    list.Add(1);
    list.Add(2);
    
    int ret = list.LastIndexOf(2);
    Debug.Assert(ret >= 0);
}
