    this.Insert(index, value);
    int final_lastIndex = this.LastIndexOf(value);
    Debug.Assert(initial_lastIndex == final_lastIndex);
}
--------------------
void TestFunction(Object value, ArrayList list)
{
    int last_index_before_insert = list.LastIndexOf(value);
    list.Insert(list.Count, value);
    Debug.Assert(last_index_before_insert == list.LastIndexOf(value) || last_index_before_insert == -1);
}
