void TestFunction(Object value)
{
    int lastIndexBeforeInsert = this.LastIndexOf(value);
    this.Insert(0, value);
    int lastIndexAfterInsert = this.LastIndexOf(value);
    Debug.Assert(lastIndexAfterInsert >= lastIndexBeforeInsert);
}
