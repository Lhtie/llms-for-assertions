void TestFunction()
{
    ArrayList list = new ArrayList();
    int lastIndex = list.LastIndexOf(value);
    list.Insert(index, value);
    Debug.Assert(lastIndex == list.LastIndexOf(value));
}
--------------------
void TestFunction()
{
    this.Insert(0, new Object());
    int lastIndexBeforeInsert = this.LastIndexOf(new Object());
    this.Insert(0, new Object());
    int lastIndexAfterInsert = this.LastIndexOf(new Object());
    Debug.Assert(lastIndexBeforeInsert == lastIndexAfterInsert);
}
--------------------
void TestFunction(Object value, Object[] array)
{
    int lastIndex = this.LastIndexOf(value);
    this.Insert(array.Length, value);
    Debug.Assert(this.LastIndexOf(value) == lastIndex);
}
