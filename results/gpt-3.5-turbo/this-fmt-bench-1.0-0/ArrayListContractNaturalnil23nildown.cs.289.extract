void TestFunction()
{
    ArrayList list = new ArrayList();
    Object obj = new Object();
    int lastIndex = list.LastIndexOf(obj);
    list.Insert(0, obj);
    Debug.Assert(lastIndex == list.LastIndexOf(obj));
}
