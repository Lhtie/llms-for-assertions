void TestFunction()
{
    ArrayList list = new ArrayList();
    Object value = new Object();

    int indexOfValue = list.LastIndexOf(value);

    if(indexOfValue == -1){
        Debug.Assert(list.IndexOf(value) == -1);
    }
}
