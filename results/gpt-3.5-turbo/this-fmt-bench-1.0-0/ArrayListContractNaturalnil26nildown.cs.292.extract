void TestFunction()
{
    ArrayList arrList = new ArrayList();
    arrList.Add("element1");
    arrList.Add("element2");
    
    int lastIndex = arrList.LastIndexOf("element3");
    int firstIndex = arrList.IndexOf("element3");
    
    Debug.Assert(lastIndex == -1 && firstIndex == -1);
}
