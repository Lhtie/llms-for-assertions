void TestFunction()
{
    // No publicly accessible method to test LastIndexOf directly
    // To indirectly test LastIndexOf, we can perform an operation where LastIndexOf should return -1
    // and then ensure that IndexOf also returns -1
    this.Remove(some_object);
    int last_index = this.LastIndexOf(some_object);
    Debug.Assert(last_index == -1);

    int first_index = this.IndexOf(some_object);
    Debug.Assert(first_index == -1);
}
--------------------
void TestFunction()
{
    int lastIndex = this.LastIndexOf(someValue);
    Debug.Assert(lastIndex == -1 => this.IndexOf(someValue) == -1);
}
