void TestFunction(Object item)
{
    ArrayList list = new ArrayList();
    list.Add("first");
    list.Add("second");
    list.Add("third");

    bool exists = list.Contains(item);
    int first_index = list.IndexOf(item);
    int last_index = list.LastIndexOf(item);
    
    Debug.Assert(!exists && first_index == -1 && last_index == -1);
}
