
void TestFunction(Object item)
{
    ArrayList myArrayList = new ArrayList();
    myArrayList.Add("apple");
    myArrayList.Add("banana");
    myArrayList.Add("cherry");
    
    bool containsItem = myArrayList.Contains(item);
    Debug.Assert(!containsItem || (myArrayList.IndexOf(item) == -1 && myArrayList.LastIndexOf(item) == -1));
}
--------------------
void TestFunction(Object item)
{
    ArrayList myArrayList = new ArrayList();
    
    bool itemContained = myArrayList.Contains(item);
    
    if (!itemContained)
    {
        int firstIndex = myArrayList.IndexOf(item);
        int lastIndex = myArrayList.LastIndexOf(item);
        
        Debug.Assert(firstIndex == -1 && lastIndex == -1);
    }
}
--------------------
void TestFunction(Object item)
{
    ArrayList list = new ArrayList();
    list.Add(1);
    list.Add(2);
    list.Add(3);

    bool containsItem = list.Contains(item);
    int firstIndex = list.IndexOf(item);
    int lastIndex = list.LastIndexOf(item);
    
    Debug.Assert(!containsItem || (firstIndex == -1 && lastIndex == -1));
}
