void TestFunction(Object item)
{
    ArrayList list = new ArrayList();
    
    list.Add("apple");
    list.Add("banana");

    bool containsItem = list.Contains(item);

    if(!containsItem){
        int firstIndex = list.IndexOf(item);
        int lastIndex = list.LastIndexOf(item);

        Debug.Assert(firstIndex == -1 && lastIndex == -1);
    }
}
