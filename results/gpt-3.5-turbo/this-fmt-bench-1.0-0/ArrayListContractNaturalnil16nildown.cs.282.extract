void TestFunction(Object item)
{
    bool containsItem = this.Contains(item);
    if (!containsItem)
    {
        int firstIndex = this.IndexOf(item);
        int lastIndex = this.LastIndexOf(item);
        Debug.Assert(firstIndex == -1 && lastIndex == -1);
    }
}
--------------------
void TestFunction(Object item)
{
    bool isContained = this.Contains(item);
    Debug.Assert(!isContained || (this.IndexOf(item) != -1 && this.LastIndexOf(item) != -1));
}
--------------------
void TestFunction(Object item)
{
    bool found = this.Contains(item);
    if (!found)
    {
        int firstIndex = this.IndexOf(item);
        int lastIndex = this.LastIndexOf(item);
        Debug.Assert(firstIndex == -1 && lastIndex == -1);
    }
}
