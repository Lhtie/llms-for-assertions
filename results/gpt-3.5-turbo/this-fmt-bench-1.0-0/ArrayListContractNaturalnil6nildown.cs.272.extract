
void TestFunction(int index, Object value)
{
    this[index] = value;
    int first_index = this.IndexOf(value);
    int last_index = this.LastIndexOf(value);
    Debug.Assert(first_index <= index && index <= last_index);
}
--------------------
void TestFunction(ArrayList list, int index, Object value)
{
    list[index] = value;
    int firstIndex = list.IndexOf(value);
    int lastIndex = list.LastIndexOf(value);
    
    Debug.Assert(firstIndex <= index && lastIndex >= index);
}
--------------------
void TestFunction()
{
    ArrayList list = new ArrayList();
    Object value = new Object(); // Create a new object for testing

    // Add elements to the list
    list.Add(new Object());
    list.Add(new Object());
    
    int old_index_of_value = list.IndexOf(value);
    
    // Set a value at a specific index
    int index = 1; // Index where the value will be set
    list[index] = value;

    int new_index_of_value = list.IndexOf(value);

    Debug.Assert(old_index_of_value < index && index < new_index_of_value);
}
