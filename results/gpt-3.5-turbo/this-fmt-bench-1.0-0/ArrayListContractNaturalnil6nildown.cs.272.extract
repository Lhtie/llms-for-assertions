void TestFunction(int index, Object value)
{
    int initial_index = this.IndexOf(value);
    this[index] = value;
    int final_index = this.LastIndexOf(value);
    Debug.Assert(initial_index <= index && index <= final_index);
}
--------------------
void TestFunction(Object value)
{
    int index = this.IndexOf(value);
    this[0] = value;
    Debug.Assert(index >= 0 && index <= this.LastIndexOf(value));
}
