// we cannot write the exact test case as specified in the comment.

// However, for public methods, we can test if the value is present in the ArrayList 
// after setting it using the indexer.
void TestFunction(ArrayList list, int index, Object value)
{
    list[index] = value;
    Debug.Assert(list.Contains(value));
}
