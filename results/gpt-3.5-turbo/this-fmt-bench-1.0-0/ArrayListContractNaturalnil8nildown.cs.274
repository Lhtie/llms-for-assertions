void TestFunction(Object value)
{
    int index = this.IndexOf(value);
    this[index] = value;
    Debug.Assert(!this.Contains(value) || this.IndexOf(value) <= index);
}
</code>--------------------<code>
void TestFunction(int index, Object value)
{
    // Arranging the condition where the value exists in the array
    this.Add(value);
    int oldIndex = this.IndexOf(value);

    // Setting the value at index
    this[index] = value;
    
    // Checking if the first index of value decreases or remains same after the operation
    int newIndex = this.IndexOf(value);
    Debug.Assert(newIndex <= oldIndex);
}
</code>--------------------<code>
void TestFunction(Object value, int index, ArrayList list)
{
    int old_index = list.IndexOf(value);
    list[index] = value;
    int new_index = list.IndexOf(value);
    Debug.Assert(!(old_index != -1) || new_index <= old_index);
}
