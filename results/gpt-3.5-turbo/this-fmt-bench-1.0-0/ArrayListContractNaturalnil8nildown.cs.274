void TestFunction()
{
    ArrayList list = new ArrayList();
    list.Add(1);
    int old_index = list.IndexOf(1);
    list[0] = 2;
    int new_index = list.IndexOf(1);
    Debug.Assert(old_index >= new_index);
}
