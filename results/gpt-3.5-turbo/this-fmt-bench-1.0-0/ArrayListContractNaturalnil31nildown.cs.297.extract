
void TestFunction(Object obj)
{
    int initial_index = this.IndexOf(obj);
    this.Remove(obj);
    int final_index = this.IndexOf(obj);
    Debug.Assert(initial_index == -1 || (final_index != -1 && final_index >= initial_index));
}
