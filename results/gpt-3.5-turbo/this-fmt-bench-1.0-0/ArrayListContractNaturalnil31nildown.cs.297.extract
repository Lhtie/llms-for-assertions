void TestFunction()
{
    // Test case where object is not in the ArrayList
    this.Remove(some_object_not_in_array_list);
    Debug.Assert(this.IndexOf(some_object_not_in_array_list) == -1);

    // Test case where object is at index 0
    this.Remove(some_object_at_index_0);
    Debug.Assert(this.IndexOf(some_object_at_index_0) == -1);

    // Test case where object is at index 1
    this.Remove(some_object_at_index_1);
    Debug.Assert(this.IndexOf(some_object_at_index_1) == 1);

    // Additional test cases can be added as needed
}
