void TestFunction(Object value)
{
    int firstIndex = this.IndexOf(value);
    int lastIndex = this.LastIndexOf(value);
    Debug.Assert((firstIndex == -1 && lastIndex == -1) || (firstIndex != -1 && lastIndex != -1));
}
