</code>--------------------<code>
void TestFunction()
{
    // Create an instance of ArrayList
    ArrayList list = new ArrayList();

    // Add an object to the list
    Object obj = new Object();
    list.Add(obj);

    // Get the object at index 0 and check if the array contains it
    Object returnedObj = list[0];
    Debug.Assert(list.Contains(returnedObj));
}
