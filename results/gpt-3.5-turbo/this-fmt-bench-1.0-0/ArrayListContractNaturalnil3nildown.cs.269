void TestFunction(int index)
{
    // Assuming arrList is an instance of ArrayList
    try
    {
        Object obj = arrList[index];
        Debug.Assert(index < arrList.Count && index >= 0);
    }
    catch (ArgumentOutOfRangeException)
    {
        // Index is out of range
    }
}
