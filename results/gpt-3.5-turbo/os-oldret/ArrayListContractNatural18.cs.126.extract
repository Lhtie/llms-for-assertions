
// If the first index of x is -1 then so is the last index
Debug.Assert(Array.IndexOf((Array)_items, value, 0, _size) == -1);
--------------------
Debug.Assert(Array.IndexOf((Array)_items, x, 0, _size) = -1);
--------------------
Debug.Assert(IndexOf(x) == -1 => LastIndexOf(x) == -1);
--------------------
Debug.Assert(Array.IndexOf((Array)_items, value, 0, _size) = -1);
--------------------
Debug.Assert(IndexOf(x) == -1 && IndexOf(OLD(x)) == -1);
----------------------------------------
Debug.Assert(IndexOf(x) == Array.IndexOf((Array)_items, x, 0, _size));
----------------------------------------
Debug.Assert(IndexOf(x) = -1);
----------------------------------------