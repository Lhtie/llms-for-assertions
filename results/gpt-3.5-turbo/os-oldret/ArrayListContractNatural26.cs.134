```cs
Debug.Assert(LastIndexOf(x, SIZE) = -1);
```--------------------<code>
Debug.Assert(LastIndexOf(x) = -1 => IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x) = -1 -> IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x) = -1 => IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x) = -1 => IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(value, _size - 1, _size) = -1 => IndexOf(value) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x, _size - 1, _size) = -1 => IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x) == -1 => IndexOf(x) == -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(x, _size - 1, _size) = -1 => IndexOf(x) = -1);
</code>--------------------<code>
Debug.Assert(LastIndexOf(null) = IndexOf(null));
</code>--------------------