</code>--------------------```cs
public virtual int IndexOf(Object value)
{
    int firstIndex = Array.IndexOf(this._items, value, 0, this._size);
    // Ensure to check firstIndex for -1 before this statement
    int lastIndex = Array.LastIndexOf(this._items, value, this._size - 1, this._size - firstIndex);
    Debug.Assert(firstIndex == -1 || lastIndex == -1);
    
    return firstIndex;
}
```--------------------<code>
Debug.Assert(this.IndexOf(value) != -1 || this.LastIndexOf(value) == -1);
</code>--------------------