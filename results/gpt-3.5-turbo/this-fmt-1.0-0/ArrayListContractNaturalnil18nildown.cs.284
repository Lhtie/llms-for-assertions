public virtual int IndexOf(Object value)
{
    // Check if the first index of value is -1
    int firstIndex = Array.IndexOf(this._items, value, 0, this._size);
    // Check if the last index of value is also -1
    Debug.Assert(firstIndex == -1 ? Array.LastIndexOf(this._items, value, this.Count - 1, this.Count) == -1 : true);
    
    return firstIndex;
}
```--------------------<code>
Debug.Assert(this.IndexOf(value) == -1 && this.LastIndexOf(value) == -1);
</code>--------------------<code>
