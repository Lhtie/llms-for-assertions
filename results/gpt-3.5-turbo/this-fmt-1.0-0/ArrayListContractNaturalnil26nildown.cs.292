public virtual int LastIndexOf(Object value)
{
    int index = Array.LastIndexOf(this._items, value, this._size - 1, this._size);
    Debug.Assert(index == -1 ? this.IndexOf(value) == -1 : true);
    return index;
}
```--------------------```cs
public static void Test_LastIndexOf_Returns_MinusOne_Implies_FirstIndexOf_Also_IsMinusOne()
{
    ArrayList list = new ArrayList();
    
    int lastIndex = list.LastIndexOf(value);
    
    Debug.Assert(lastIndex == -1 && list.IndexOf(value) == -1);
}
