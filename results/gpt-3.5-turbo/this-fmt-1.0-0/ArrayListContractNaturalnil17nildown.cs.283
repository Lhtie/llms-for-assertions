```--------------------```cs
public virtual int IndexOf(Object value)
{
    int index = Array.IndexOf(this.array, value);
	// If and only if the index-of operation for value returns -1, value is not in array
    Debug.Assert(index == -1 || this.Contains(value));
    return index;
}
