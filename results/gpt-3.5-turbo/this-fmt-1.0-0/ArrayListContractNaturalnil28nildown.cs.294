```--------------------```cs
public virtual int LastIndexOf(Object value)
{
    int lastIndex = -1;
    for (int i = 0; i < this.Count; i++)
    {
        if (Object.Equals(value, this[i]))
        {
            lastIndex = i;
        }
    }

    Debug.Assert(lastIndex < 0 || this.IndexOf(value) >= 0);
}
```--------------------```cs
// Check that the last index operation indeed returns a valid index
Debug.Assert(this.LastIndexOf(value) >= 0 || this.IndexOf(value) == -1);
