import numpy as np

assert np.__version__ > '1.1'

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert lambda0 in evalues
assert np.array_equal(lambdavec, lambda0 * vec)

print(evalues, evectors)
--------------------
assert np.__version__ > '1.1'
--------------------
assert np.__version__ > '1.1'
--------------------
assert np.__version__ > '1.1'
