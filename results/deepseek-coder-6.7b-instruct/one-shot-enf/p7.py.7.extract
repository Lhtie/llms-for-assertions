# numpy version is greater than 2
import numpy as np
assert np.version.full_version > '2.0.0'
--------------------
import numpy as np

# numpy version is greater than 2
assert np.version.full_version > '2.0.0'

# matrix mtx is a 2D numpy array with shape (10,10)
mtx = np.random.random((10,10))
assert isinstance(mtx, np.ndarray) and mtx.shape == (10, 10)

evalues, evectors = np.linalg.eig(mtx)

# evalues and evectors are 1D numpy arrays from np.linalg.eig
assert isinstance(evalues, np.ndarray) and evalues.ndim == 1
assert isinstance(evectors, np.ndarray) and evectors.ndim == 2

lambda = evalues[0]

# lambda is a scalar (i.e., a number)
assert lambda.ndim == 0

vec = evectors[:, 0]

# vec is a 1D numpy array
assert isinstance(vec, np.ndarray) and vec.ndim == 1

lambdavec = mtx @ vec

# lambdavec is a 1D numpy array
assert isinstance(lambdavec, np.ndarray) and lambdavec.ndim == 1

# print statements
assert print(evalues, evectors) == None
--------------------
import numpy as np

# numpy version is greater than 2
assert np.version.full_version > '2.0.0'

mtx = np.random.random((10,10))
assert mtx.shape == (10,10)

evalues, evectors = np.linalg.eig(mtx)
assert evalues.shape == (10,)
assert evectors.shape == (10,10)

lambda_ = evalues[0]
assert isinstance(lambda_, float) or isinstance(lambda_, complex)

vec = evectors[:, 0]
assert vec.shape == (10,)

lambdavec = mtx @ vec
assert lambdavec.shape == (10,)

print(evalues, evectors)
--------------------
assert np.__version__ > '2.0.0'
assert isinstance(mtx, np.ndarray) and mtx.shape == (10,10)
assert isinstance(evalues, np.ndarray) and len(evalues) == 10
assert isinstance(evectors, np.ndarray) and evectors.shape == (10,10)
assert isinstance(lambda, np.float64)
assert isinstance(vec, np.ndarray) and len(vec) == 10
assert isinstance(lambdavec, np.ndarray) and len(lambdavec) == 10
print(evalues, evectors)
--------------------