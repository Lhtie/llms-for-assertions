
import numpy as np

assert float(f"{int(np.__version__.split('.')[0])}.{int(np.__version__.split('.')[1])}") > 1.1

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)
--------------------
assert np.__version__ >= '1.1'
--------------------
assert np.__version__ >= '1.1'
--------------------
