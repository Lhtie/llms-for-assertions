
Debug.Assert(New_Ret == Old_arrListCount + 1); // @@@ count of the array list should increase after an addition operation

Debug.Assert(Old_arrListCount == New_arrListCount); // @@@ count of the array list should remain same if insertion is failed

Debug.Assert(New_arrListCount == Old_arrListCount - 1); // @@@ count of the array list should decrease after a removal operation

Debug.Assert(Old_arrListContainsX == false && New_arrListContainsX == false); // @@@ removed element should not exist in the array

Debug.Assert(New_Ret <= Old_arrListCount); // @@@ index returned in ArrayList.IndexOf method should not be greater than current Count of the ArrayList

Debug.Assert(New_Ret == Old_arrListLastIndexOfX || New_Ret == New_arrListCount - 1); // @@@ last index of removed element should be equal to IndexOf method's return value or Count-1 if no such exist

Debug.Assert(New_Ret == Old_arrListIndexOfX); // @@@ index returned in ArrayList.LastIndexOf method should not be greater than current Count-1 and equal or greater than IndexOf method's return value, considering that the List doesn't allow duplicates

Debug.Assert(New_Ret == Old_arrListIndexOfX); // @@@ if exist, index of the new inserted element should be equals to the return value of the ArrayList.Add method

Debug.Assert(New_Ret <= Old_arrListIndexOfX); // @@@ index of the inserted element should be not greater than the position returned by IndexOf or LastIndexOf method, considering that the List may allow duplicates

