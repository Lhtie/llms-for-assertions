Debug.Assert(Old_arrListCount == New_arrListCount); // @@@ After setting a value, the count of ArrayList should remain the same

Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX); // @@@ After setting a value, the last index of inserted value or duplicated value should not increase

Debug.Assert(Old_arrListCount == New_arrListCount); // @@@ After a get operation, the count of the ArrayList should remain the same

Debug.Assert(New_Ret == true || New_Ret == false); // @@@ result of the '.Contains' method should be either true or false

Debug.Assert(New_Ret == Old_arrListCount || (New_Ret >= 0 && New_Ret <= Old_arrListCount)); // @@@ index returned in ArrayList.IndexOf method should be between 0 and Count of the ArrayList or equals to Count if no such exist

Debug.Assert(New_Ret == Old_arrListLastIndexOfX); // @@@ IndexOf method returned value should not be greater than LastIndexOf method returned value and IndexOf method return value should be between -1 (if no such element) and count-1

Debug.Assert(New_Ret <= Old_arrListCount); // @@@ The returned value of the Count property should not be greater than the value returned by the Count property before the Count method is invoked--------------------
