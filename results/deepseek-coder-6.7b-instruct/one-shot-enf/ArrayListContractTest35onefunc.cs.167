```cs

namespace LinkedList.Test
{
    public partial class LinkedListContractTest
    {
        public void PUT_SetContract([PexAssumeUnderTest]LinkedList&lt;int&gt; linkedList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < linkedList.Count);

            int Old_linkedListCount = linkedList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_linkedListIndexOfX = linkedList.IndexOf(x);
            int Old_linkedListLastIndexOfX = linkedList.LastIndexOf(x);
            bool Old_linkedListContainsX = linkedList.Contains(x);

            linkedList[index] = x;

            int New_linkedListCount = linkedList.Count;
            int New_linkedListIndexOfX = linkedList.IndexOf(x);
            int New_linkedListLastIndexOfX = linkedList.LastIndexOf(x);
            bool New_linkedListContainsX = linkedList.Contains(x);

            PexObserve.ValueForViewing("$old_linkedList_Count", Old_linkedListCount);
            PexObserve.ValueForViewing("$new_linkedList_Count", New_linkedListCount);
            PexObserve.ValueForViewing("$old_linkedList_x", Old_x);
            PexObserve.ValueForViewing("$old_linkedList_index", Old_index);
            PexObserve.ValueForViewing("$old_linkedList_IndexOf_x", Old_linkedListIndexOfX);
            PexObserve.ValueForViewing("$new_linkedList_IndexOf_x", New_linkedListIndexOfX);
            PexObserve.ValueForViewing("$old_linkedList_LastIndexOf_x", Old_linkedListLastIndexOfX);
            PexObserve.ValueForViewing("$new_linkedList_LastIndexOf_x", New_linkedListLastIndexOfX);
            PexObserve.ValueForViewing("$old_linkedList_contains_x", Old_linkedListContainsX);
            PexObserve.ValueForViewing("$new_linkedList_contains_x", New_linkedListContainsX);

	    // @@@ index passed in is less than or equal to last index of x in new linked list 
        }
    }
}
