
Debug.Assert(arrList.Count == New_arrListCount); // The count in the new list is the same as the old one
Debug.Assert(arrList.Contains(Old_x));  // The old value exists in the list after addition
Debug.Assert(arrList.IndexOf(Old_x) == Old_arrListIndexOfX); // The index of the old value is the same as before addition
Debug.Assert(arrList.LastIndexOf(Old_x) == Old_arrListLastIndexOfX); // The last index of the old value is the same as before addition
Debug.Assert(New_Ret >= 0);  // The return value after addition is greater than or equal to zero
Debug.Assert(arrList[Old_arrListIndexOfX] == Old_x); // The added value is present in the list at old index
--------------------
Debug.Assert(New_Ret >= Old_arrListCount);
--------------------
Debug.Assert(arrList.Count >= 0);
--------------------
Debug.Assert(New_Ret == Old_arrListCount + 1);
--------------------
Debug.Assert(New_Ret == Old_arrListCount);
--------------------
Debug.Assert(New_Ret == (Old_arrListCount + 1)); // @@@ Count should increase by 1 after Add

Debug.Assert(arrList.Count == Old_arrListCount - 1); // @@@ Count should decrease by 1 after Remove

Debug.Assert(arrList[Old_index] == Old_x && arrList[index] == x && arrList.Count == Old_arrListCount); // @@@ Element x should be replaced at index by old list's count

Debug.Assert(arrList.Count == Old_arrListCount + 1 && arrList.Contains(x)); // @@@ Count should increase by 1 and list should contain x after Insert

Debug.Assert(arrList.Count == Old_arrListCount && !arrList.Contains(Old_x)); // @@@ Count should remain the same and list should not contain x after Remove

Debug.Assert(Old_arrListContainsX && New_Ret >=0); // @@@ Pre-condition of IndexOf should hold true and return value is not -1

Debug.Assert(Old_arrListContainsX && New_Ret != -1); // @@@ Pre-condition for IndexOf should hold true and return value is not -1

Debug.Assert(Old_arrListContainsX && New_Ret == Old_arrListIndexOfX); // @@@ Pre-condition of LastIndexOf should hold true and return value equals to IndexOf result
--------------------
Debug.Assert(New_Ret == Old_arrListCount + 1); // Expecting count increased by one after adding
