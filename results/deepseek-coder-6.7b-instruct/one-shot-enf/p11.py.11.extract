def test_transfer():
    p1 = Person('Person1')
    p2 = Person('Person2')
    
    # the total sum of funds in p1's accounts is equal to or greater than "amnt"
    assert sum([acnt.money for acnt in p1.accounts]) >= amnt
    
    # the transfer operation is successful
    assert transfer(p1, p2, amnt)
    
    # the total sum of funds in p1 and p2's accounts is equal to their initial values plus "amnt"
    assert sum([acnt.money for acnt in p1.accounts]) + sum([acnt.money for acnt in p2.accounts]) == initial_sum
