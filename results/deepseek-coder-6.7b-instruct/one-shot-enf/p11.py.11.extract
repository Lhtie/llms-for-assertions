assert sum([acnt.money for acnt in frm.accounts]) >= amnt
--------------------
assert all(sum(acnt.money for acnt in frm.accounts) >= amnt for acnt in frm.accounts)
--------------------
assert sum(account.money for account in frm.accounts) >= amnt
--------------------
assert sum(frm.accounts, key=lambda acnt: acnt.money) >= amnt
--------------------
# @@@ total balance of all "frm" accounts is not less than "amnt"
assert sum([account.money for account in frm.accounts]) >= amnt

# @@@ total balance of "to" is increased by "amnt"
assert sum([account.money for account in to.accounts]) + amnt == sum([account.money for account in to.accounts])

# @@@ balance of account from which money is being transfered is decreased by "amnt"
assert sum([account.money for account in frm.accounts]) - amnt == sum([account.money for account in frm.accounts])
--------------------
assert sum(frm.accounts, lambda acnt: acnt.money) >= amnt
--------------------
