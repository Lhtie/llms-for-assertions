
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    # transfer amount is not greater than 100 and is positive
    assert amnt > 0 and amnt <= 100
    
    for acnt in frm.accounts:
	if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
--------------------
#transfer amount is not greater than 100 and is positive
assert amnt > 0 and amnt <= 100 
--------------------
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    # transfer amount is not greater than 100 and is positive   
    assert 0 < amnt <= 100
    
    for acnt in frm.accounts:
        # sender account has enough money
        assert acnt.money >= amnt

    # receiver account's money is positive after the transaction
    assert to.accounts[0].money + amnt > 0
--------------------
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    # transfer amount is not greater than 100 and is positive
    assert amnt > 0 and amnt <= 100
    
    # "frm" Person has sufficient funds in at least one of its accounts
    for acnt in frm.accounts:
        assert acnt.money >= amnt

    return True
