
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert np.allclose(lambdavec, lambda * vec)
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
assert np.allclose(lambdavec, lambda * vec), 'lambdavec is not close to lambda times vec'
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
assert np.allclose(lambdavec, lambda*vec), "lambdavec is not close to lambda times vec"
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert np.allclose(lambdavec, lambda*vec), "lambdavec is not close to lambda times vec"

print(evalues, evectors)
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------