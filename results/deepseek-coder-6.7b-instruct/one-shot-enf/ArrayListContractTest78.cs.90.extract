
Debug.Assert(New_Ret >= 0);
--------------------
Debug.Assert(New_Ret >= Old_arrListCount);
--------------------
// PUT_AddContract
Debug.Assert(New_Ret == Old_arrListCount + 1);
Debug.Assert(New_arrListIndexOfX > -1);
Debug.Assert(New_arrListLastIndexOfX > -1);
Debug.Assert(New_arrListContainsX == true);

// PUT_RemoveContract
Debug.Assert(New_arrListCount == Old_arrListCount - 1);
Debug.Assert(New_arrListIndexOfX == -1);
Debug.Assert(New_arrListLastIndexOfX > -1);
Debug.Assert(New_arrListContainsX == false);

// PUT_InsertContract
Debug.Assert(New_arrListCount == Old_arrListCount + 1);
Debug.Assert(New_arrListIndexOfX == Old_index);
Debug.Assert(New_arrListLastIndexOfX > -1);
Debug.Assert(New_arrListContainsX == true);

// PUT_SetContract
Debug.Assert(New_arrListCount == Old_arrListCount);
Debug.Assert(New_arrListIndexOfX > -1);
Debug.Assert(New_arrListLastIndexOfX > -1);
Debug.Assert(New_arrListContainsX == true);

// PUT_GetContract
Debug.Assert(New_Ret == arrList.ToArray()[Old_index]);
Debug.Assert(New_containsNewRet == true);

// PUT_ContainsContract
Debug.Assert(New_Ret == Old_arrListContainsX);

// PUT_IndexOfContract
Debug.Assert(New_Ret >= 0 && New_Ret < Old_arrListCount);

// PUT_LastIndexOfContract
Debug.Assert(New_Ret >= 0 && New_Ret <= Old_arrListCount);

// PUT_CountContract
Debug.Assert(New_Ret == arrList.Count);
--------------------
public static void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
{
    AssumePrecondition.IsTrue(true);


    int Old_arrListCount = arrList.Count;


    int New_Ret = arrList.Count;


    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

    // @@@ New count is less than or equal to old count
    Debug.Assert(New_Ret <= Old_arrListCount);
}
--------------------
Debug.Assert(New_Ret >= 0);
--------------------
Debug.Assert(New_Ret >= 0);
--------------------
{
    Debug.Assert(Old_arrListCount + 1 >= New_arrListCount);
    Debug.Assert(New_arrListContainsX);
    Debug.Assert(New_Ret == Old_arrListCount);
    Debug.Assert(Old_arrListIndexOfX == New_arrListLastIndexOfX);
    Debug.Assert(New_arrListIndexOfX == Old_arrListCount);
    Debug.Assert(New_arrListCount == Old_arrListCount + 1);
}
--------------------
Debug.Assert(New_Ret >= 0); // @@@ If the return value is non-negative, x is in the old array
--------------------
Debug.Assert(arrList.Count >= 0);
--------------------
Debug.Assert(New_Ret >= Old_arrListCount);
