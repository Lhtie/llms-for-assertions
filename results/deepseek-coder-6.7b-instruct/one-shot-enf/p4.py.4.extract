        self.area = -1
        self.perimeter = -1
--------------------
assert (l>0 and w>0), "Invalid values passed in"
--------------------
class Shape:
    def __init__(self, typ):
        assert (typ in ['Circle', 'Rectangle']), "Invalid shape type"
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l > 0 and w > 0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l * w
        self.perimeter = 2 * (l + w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI * r * r
        self.perimeter = 2 * PI * r

def compare_a(s1, s2):
    a1, a2 = s1.area, s2.area
    # s1 and s2 are valid shapes
    assert (hasattr(s1, 'area') and hasattr(s2, 'area')), "One of the shapes does not have an area"
    if a1 > a2: return a1
    else: return a2
--------------------