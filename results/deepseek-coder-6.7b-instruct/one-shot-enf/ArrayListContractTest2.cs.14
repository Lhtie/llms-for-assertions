    [Test]
    public void PUT_AddContract()
    {
        // Assume precondition
        PexAssume.IsTrue(true);

        // Observe values
        PexObserve.ValueForViewing("$old_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$old_arrList_x", x);

        // Actual method call
        arrList.Add(x);

        // Observe values
        PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$old_arrList_IndexOf_x", arrList.IndexOf(x));
        PexObserve.ValueForViewing("$new_arrList_IndexOf_x", arrList.IndexOf(x));
        PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", arrList.LastIndexOf(x));
        PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", arrList.LastIndexOf(x));
        PexObserve.ValueForViewing("$new_arrList_contains_x", arrList.Contains(x));

        // Assertion
        Debug.Assert(((x >= 0) && (x <= arrList.Count)));
    }
    [Test]
    public void PUT_RemoveContract()
    {
        // Assume precondition
        PexAssume.IsTrue(true);

        // Observe values
        PexObserve.ValueForViewing("$old_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$old_arrList_x", x);

        // Actual method call
        arrList.Remove(x);

        // Observe values
        PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$new_arrList_IndexOf_x", arrList.IndexOf(x));
        PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", arrList.LastIndexOf(x));
        PexObserve.ValueForViewing("$new_arrList_contains_x", arrList.Contains(x));

        // Assertion
        Debug.Assert(((x >= 0) && (x <= arrList.Count)));
    }

    // other tests omitted

    [Test]
    public void PUT_GetContract()
    {
        // Assume precondition
        PexAssume.IsTrue(index < arrList.Count && index >= 0);

        // Observe values
        PexObserve.ValueForViewing("$old_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
        PexObserve.ValueForViewing("$old_arrList_index", index);

        // Actual method call
        int New_Ret = (int)(arrList[index]);

        // Observe values
        PexObserve.ValueForViewing("$New_ret", New_Ret);
        PexObserve.ValueForViewing("$new_containsNewRet", arrList.Contains(New_Ret));

        // Assertion
        Debug.Assert(New_Ret > 0);
    }

