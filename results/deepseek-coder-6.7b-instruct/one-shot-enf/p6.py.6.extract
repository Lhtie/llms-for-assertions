<pre>
class Rectangle():
    def __init__(self, n, m):
        self.exp = n # this is how tall
        self.mat = n + m + 2
        self.lin = m # this is how wide
        assert n > 0   # Assert that the height of the rectangle is positive
        assert m > 0   # Assert that the width of the rectangle is positive

def func(n, m):
    r = Rectangle(n, m)
    # height of r is positive
    assert n > 0, "height of r is positive"
</pre>
