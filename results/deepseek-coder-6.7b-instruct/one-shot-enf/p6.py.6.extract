```python
class Rectangle():
    def __init__(n, m):
        assert n > 0, "this is how tall"
        self.mat = n+m+2
        assert m > 0, "this is how wide"

def func(n, m):
    r = Rectangle(n, m)
    # height of r is positive
    assert hasattr(r, 'exp') and r.exp > 0, "height of r is positive"
