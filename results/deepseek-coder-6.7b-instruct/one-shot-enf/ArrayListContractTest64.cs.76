Debug.Assert(!New_Ret && New_arrList_--------------------
Debug.Assert(New_Ret == Old_arrListCount + 1 ); // @@@ Count increases after adding a new element
Debug.Assert((Old_arrListCount > 0 && New_Ret == Old_arrListCount - 1)  || (Old_arrListCount == 0 && New_Ret == 0)); // @@@ Count decreases after removing an element
Debug.Assert((index >= 0 && index <= Old_arrListCount) && (New_Ret == Old_arrListCount)); // @@@ Insert is allowed at any valid index
Debug.Assert((index >= 0 && index < Old_arrListCount) && (New_Ret == Old_arrListCount)); // @@@ Assigning value at specific index results in increasing the count by one
Debug.Assert((index >= 0 && index < Old_arrListCount) && (New_Ret == Old_arrListCount)); // @@@ Removing an existing element by index in the middle reduces the count
Debug.Assert(((index == 0 || index == Old_arrListCount - 1) || (index > 0 && New_Ret == Old_arrListCount)) && (New_Ret == Old_arrListCount + 1)); // @@@ Adding an element to the end or to the beginning increases the count
Debug.Assert(((index == 0 || index == Old_arrListCount - 1) || (index > 0 && New_Ret == Old_arrListCount)) && (New_Ret == Old_arrListCount - 1)); // @@@ Removing an element from the end or from the beginning decreases the count
Debug.Assert((index >= 0 && index < Old_arrListCount) && (New_Ret == Old_arrListCount)); // @@@ Setting an index that was previously present does not change the count
Debug.Assert((index >= 0 && index <= Old_arrListCount) && (New_Ret == Old_arrListCount)); // @@@ Trying to get an invalid index returns the default value
Debug.Assert(New_Ret == Old_arrListCount - (Old_arrListContainsX ? 1 : 0)); // @@@ Trying to remove an item that's not in the list does not change the Count
Debug.Assert((New_Ret >= 0 && New_Ret <= Old_arrListCount) || New_Ret == -1); // @@@ IndexOf is always greater or equal to 0 and less or equal to Count, or returns -1 if item is not present
Debug.Assert((New_Ret >= 0 && New_Ret <= Old_arrListCount) || New_Ret == -1); // @@@ LastIndexOf is always greater or equal to 0 and less or equal to Count, or returns -1 if item is not present
