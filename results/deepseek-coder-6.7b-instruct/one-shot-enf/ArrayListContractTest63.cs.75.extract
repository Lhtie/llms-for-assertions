--------------------
Debug.Assert(New_Ret >= Old_arrListCount + 1 && Old_arrListCount >= 0); // @@@ Count after adding one item should increase by 1

Debug.Assert(New_Ret <= Old_arrListCount, "@@@ The result of Add method should be less than or equal to arrList.Count"); // @@@ Count after removing an item should decrease by 1 or remain the same

Debug.Assert(New_Ret == Old_arrListCount + 1 || New_Ret == Old_arrListCount, "@@@ The result of Add method should be equal to arrList.Count + 1 or arrList.Count"); // @@@ Count after adding one item should increase by 1 or remain the same

Debug.Assert(New_Ret == (Old_arrListCount - 1), "@@@ The result of Add method should be equal to arrList.Count - 1"); // @@@ Count after removing a item should decrease by 1

Debug.Assert(!New_arrListContainsX, "@@@ arrList should not contain the value after removal"); // @@@ After removing value, it should not be in the list

Debug.Assert(New_arrListIndexOfX == -1, "@@@ arrList.IndexOf(x) should return -1 after removal of x from arrList"); // @@@ After removal of the item, IndexOf should return -1

Debug.Assert(New_arrListLastIndexOfX == -1, "@@@ arrList.LastIndexOf(x) should return -1 after removal of x from arrList"); // @@@ After removal of the item, LastIndexOf should return -1

Debug.Assert(New_arrListContainsX == false, "@@@ New_arrList.Contains(Old_x) should be false after Insert"); // @@@ After insertion, Contains of the new list should not contain the inserted value

Debug.Assert(New_arrListContainsX == true, "@@@ New_arrList.Contains(Old_x) should be true after setting x in the index"); // @@@ After setting the value, Contains of the new list should contain the set value

Debug.Assert(New_Ret == Old_arrListCount, "@@@ The value returned by Get method should be equal to arrList.Count"); // @@@ The value returned by Get method should be equal to the Count of the array list

Debug.Assert(New_Ret == false, "@@@ If the return value is false, last position of x in old list is >= -1"); // @@@ If the return value is false, last position of x in old list is >= -1

Debug.Assert(New_Ret != -1, "@@@ If the return value is true, arrList.IndexOf(x) should be >= -1"); // @@@ If the return value is true, arrList.IndexOf(x) should be >= -1

Debug.Assert(New_Ret == Old_arrListCount, "@@@ Count of arrList should remain unchanged after calling Count method"); // @@@ Count of arrList should remain unchanged after calling Count method
