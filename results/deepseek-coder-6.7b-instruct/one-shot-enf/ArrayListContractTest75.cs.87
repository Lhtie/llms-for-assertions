
// @@@ Count after adding an item equals old count plus one 
Debug.Assert(New_arrList_Count == Old_arrListCount + 1);
</code>

<code>
// @@@ Count after removing an item equals old count minus one 
Debug.Assert(New_arrList_Count == Old_arrListCount - 1);
</code>

<code>
// @@@ Index of x is equal to inserted index in the array list 
Debug.Assert(New_arrListIndexOfX == Old_index);
</code>

<code>
// @@@ Value of the given index equals to x in the array list 
Debug.Assert(New_Ret == Old_x);
</code>

<code>
// @@@ If the return value is negative, array list does not contain x 
Debug.Assert(New_Ret != -1 | !Old_arrListContainsX);
</code>

<code>
// @@@ If the return value is positive, array list contains x 
Debug.Assert(New_Ret > 0 | Old_arrListContainsX);
</code>

<code>
// @@@ If the return value is non-negative, it must be equal to old list count or less 
Debug.Assert(New_Ret >= -1 && New_Ret <= Old_arrListCount);
</code>

<code>
// @@@ If the return value is non-negative, last index of x in new list equals old list count when x is not in the old list 
Debug.Assert(New_Ret == Old_arrListLastIndexOfX || New_arrListLastIndexOfX == New_arrListCount);
</code>

<code>
// @@@ If the return value is -1, x does not exist in the array list 
Debug.Assert(New_Ret == -1 | !Old_arrListContainsX);
</code>

<code>
// @@@ For non-negative return values, it must be within the old list count 
Debug.Assert(New_Ret >= 0 && New_Ret <= Old_arrListCount);
</code>
