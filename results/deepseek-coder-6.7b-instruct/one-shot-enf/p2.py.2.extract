def func(n):
    p43_coeffs = []
    sum_of_squares = 0
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)
        sum_of_squares += inp**2
    # @@@ p43_coeffs contains n elements
    assert len(p43_coeffs) == n
    # @@@ sum of squares of values in array is 1
    assert sum_of_squares == 1
--------------------
assert sum(map(lambda x: x**2, p43_coeffs)) == 1
--------------------
assert sum([i**2 for i in p43_coeffs]) == 1
--------------------
assert sum(i**2 for i in p43_coeffs) == 1
--------------------