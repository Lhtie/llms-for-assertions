```cs
Debug.Assert(Old_arrListCount == New_arrListCount); // @@@ count shouldn't change after setting new value
Debug.Assert(Old_x == x); // @@@ the value of "x" should not change
Debug.Assert(Old_index == index); // @@@ "index" of the old array list should not change
Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX); // @@@ index of x in old aray list should change accordingly
Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX); // @@@ last index of x in old array list should change accordingly
Debug.Assert(Old_arrListContainsX == New_arrListContainsX); // @@@ 'contains' property of old array list should change accordingly
```

```cs
Debug.Assert(New_arrListCount == Old_arrListCount + (Old_arrListContainsX ? 0 : 1)); // @@@ count should increase by 1 when x is added to the array list
Debug.Assert(Old_arrListIndexOfX <= index && index < Old_arrListCount); // @@@ new index should be within the valid range of the array list
Debug.Assert(Old_arrListIndexOfX == (Old_arrListContainsX ? index : -1)); // @@@ index of x should be updated
Debug.Assert(Old_arrListLastIndexOfX == index); // @@@ last index of x should be updated
Debug.Assert(Old_arrListContainsX == New_arrListContainsX && New_arrListContainsX == (New_arrListIndexOfX != -1)); // @@@ 'contains' property should be true if the new value is in the list
```
