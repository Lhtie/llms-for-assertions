Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // The count of arrList increases by 1 when adding x
Debug.Assert(Old_arrListCount - 1 == New_arrListCount); // The count of arrList decreases by 1 when removing x
Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // The count of arrList increases by 1 when inserting x at index
Debug.Assert(arrList[index] == x); // x is inserted at index in arrList
Debug.Assert(Old_arrListCount == New_arrListCount); // The count of arrList stays same when setting x at index
Debug.Assert(New_containsNewRet); // The new value is in the list after getting it from the list
Debug.Assert(New_Ret == Old_arrListCount); // The new count of arrList after removing x equals old count
Debug.Assert(New_Ret >= 0); // The index returned from indexOf x is not negative
Debug.Assert(New_Ret <= Old_arrListCount); // The index returned from indexOf x is less than or equal to the old count
Debug.Assert(New_Ret <= Old_arrListCount); // The index returned from lastIndexOf x is less than or equal to the old count
Debug.Assert(New_Ret == IndexOf_x); // The index returned from indexOf x is the same as the old index of x
Debug.Assert(New_Ret == LastIndexOf_x); // The index returned from lastIndexOf x equals to the newest index of x
