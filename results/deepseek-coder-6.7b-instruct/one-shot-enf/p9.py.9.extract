
def sum(x, y):
    sum = x + y
    assert sum >= x and sum >= y
    return sum



class Account:
    def __init__(self, money):
        self.money = money
        assert money >= 0


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]
        assert len(self.accounts) > 0


def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            assert acnt.money >= 0 and to.accounts[0].money >= amnt
            return True

    assert frm.accounts[0].money >= amnt 
    return False
