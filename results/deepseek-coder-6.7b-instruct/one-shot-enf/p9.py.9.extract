def test_transfer():
    sender = Person('Alice')
    receiver = Person('Bob')
    amnt = 50

    assert max([acnt.money for acnt in sender.accounts]) >= amnt
    assert transfer(sender, receiver, amnt)
    assert max([acnt.money for acnt in sender.accounts]) < amnt
    assert sum([acnt.money for acnt in receiver.accounts]) == amnt
