--------------------
import random

class Account:
    def __init__(self, money):
        assert money >= 0, 'money should be non-negative'
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]
        assert len(self.accounts) > 0, 'A person should have at least one account'

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    assert frm != to, 'Cannot transfer between the same accounts'
    assert amnt >= 0, 'Amount to transfer should be non-negative'
    
    # some account of "frm" has more money than "amnt"
    for acnt in frm.accounts:
	assert acnt.money >= amnt, 'Not enough money in account to perform the transfer'
        break

    return True
--------------------
# 'frm' needs to have at least 'amnt' money in some of its accounts
assert any(acnt.money >= amnt for acnt in frm.accounts), "Insufficient funds"

# 'to' Person object must be instance of 'Person' class
assert isinstance(to, Person), "To must be a person"

# 'frm' and 'to' cannot be the same person
assert frm is not to, "Sender and receiver cannot be the same"
--------------------
# Each account has a non-negative number of money.
assert all(acnt.money >= 0 for acnt in Person.accounts for acnt in accounts)
--------------------
assert(frm.accounts[0].money > amnt if frm != to else True) 
--------------------
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    assert any(acnt.money >= amnt for acnt in frm.accounts), "some account of 'frm' has more money than 'amnt'"
    
    for acnt in frm.accounts:
        if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
--------------------