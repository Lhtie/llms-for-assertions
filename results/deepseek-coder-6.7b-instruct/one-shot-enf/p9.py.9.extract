from random import randint

class Account:
    def __init__(self, money):
        self.money = money


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(randint(0, 100)) for _ in range(5)]


def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    assert any(acnt.money >= amnt for acnt in frm.accounts), '@@@ some account of "frm" has more money than "amnt"'

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True
    
    return False

--------------------
# @@@ "frm" has more money than "amnt"
assert any(acnt.money > amnt for acnt in frm.accounts), "Some account of 'frm' has less money than 'amnt'"

# @@@ "to" has more money after the transfer
init_money_to = to.accounts[0].money
transfer(frm, to, amnt)
assert to.accounts[0].money == init_money_to + amnt, "After the transfer, 'to' has less money after the transfer"
--------------------
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    assert any(acnt.money >= amnt for acnt in frm.accounts), "@@@ some account of 'frm' has more money than 'amnt'"

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
