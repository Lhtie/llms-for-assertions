class Shape:
    
    # initializer method with assertion statement on self.typ
    def __init__(self, typ):
        assert typ in ["Rectangle", "Circle"], "Invalid shape type"
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    
    # initializer method with assertion statement on self.len and self.wid
    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    
    # initializer method with assertion statement on self.rad
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r

def compare_a(s1, s2):
    
    # assertion statement on s1.typ and s2.typ to ensure they're of the same shape type
    assert s1.typ == s2.typ, "Cannot compare different shapes"
    
    a1, a2 = s1.area, s2.area
    # a1 and a2 holds the correct value of area

    if a1>a2: return a1
    else: return a2
