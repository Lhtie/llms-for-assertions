def test_transfer():
    alice = Person("Alice")
    bob = Person("Bob")

    assert sum([acnt.money for acnt in alice.accounts]) > 0
    assert sum([acnt.money for acnt in bob.accounts]) > 0
    assert transfer(alice, bob, 10)
    assert sum([acnt.money for acnt in alice.accounts]) == 10
    assert sum([acnt.money for acnt in bob.accounts]) == 60

    assert not transfer(alice, bob, 110)
    assert sum([acnt.money for acnt in alice.accounts]) == 10
    assert sum([acnt.money for acnt in bob.accounts]) == 60
