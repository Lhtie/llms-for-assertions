def test_transfer():
    person1 = Person("Person1")
    person2 = Person("Person2")
    amnt_to_transfer = 50

    total_balance_person1_before_transfer = sum([acnt.money for acnt in person1.accounts])
    total_balance_person2_before_transfer = sum([acnt.money for acnt in person2.accounts])

    assert transfer(person1, person2, amnt_to_transfer)
    
    total_balance_person1_after_transfer = sum([acnt.money for acnt in person1.accounts])
    total_balance_person2_after_transfer = sum([acnt.money for acnt in person2.accounts])

    assert total_balance_person1_before_transfer - sum([acnt.money for acnt in person1.accounts]) == amnt_to_transfer
    assert total_balance_person2_before_transfer + sum([acnt.money for acnt in person1.accounts]) == total_balance_person2_after_transfer
