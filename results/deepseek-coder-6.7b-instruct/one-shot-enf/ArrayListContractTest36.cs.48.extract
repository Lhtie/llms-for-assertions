
Debug.Assert(New_arrListCount - Old_arrListCount == 1);
--------------------
using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
       [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList[index] = x;

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.IsTrue(New_arrListLastIndexOfX != Old_arrListCount);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

        }
    }
}
--------------------
Debug.Assert(New_Ret == Old_arrListCount + 1);
--------------------
Debug.Assert(arrList.Count >= 0);
--------------------
Debug.Assert(New_Ret == Old_arrListCount + 1);
--------------------
Debug.Assert(New_arrListCount >= Old_arrListCount);
--------------------
Debug.Assert(arrList.Count == New_Ret);
--------------------
Debug.Assert(New_arrListCount >= Old_arrListCount );
--------------------
Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // The count of arrList increases by 1 when adding x
Debug.Assert(Old_arrListCount - 1 == New_arrListCount); // The count of arrList decreases by 1 when removing x
Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // The count of arrList increases by 1 when inserting x at index
Debug.Assert(arrList[index] == x); // x is inserted at index in arrList
Debug.Assert(Old_arrListCount == New_arrListCount); // The count of arrList stays same when setting x at index
Debug.Assert(New_containsNewRet); // The new value is in the list after getting it from the list
Debug.Assert(New_Ret == Old_arrListCount); // The new count of arrList after removing x equals old count
Debug.Assert(New_Ret >= 0); // The index returned from indexOf x is not negative
Debug.Assert(New_Ret <= Old_arrListCount); // The index returned from indexOf x is less than or equal to the old count
Debug.Assert(New_Ret <= Old_arrListCount); // The index returned from lastIndexOf x is less than or equal to the old count
Debug.Assert(New_Ret == IndexOf_x); // The index returned from indexOf x is the same as the old index of x
Debug.Assert(New_Ret == LastIndexOf_x); // The index returned from lastIndexOf x equals to the newest index of x
--------------------
Debug.Assert(arrList.Count >= 0); // $new_arrList_Count is greater than or equal to 0
Debug.Assert(index <= arrList.Count && index >= 0); // $old_arrList_index is less than or equal to $new_arrList_Count and greater than or equal to 0
Debug.Assert(New_Ret == index); // $New_ret is equal to $old_arrList_index
Debug.Assert(New_arrListCount == Old_arrListCount + 1); // $new_arrList_Count is equal to $old_arrList_Count plus 1
Debug.Assert((New_arrListIndexOfX == New_Ret && New_arrListLastIndexOfX == New_Ret) || New_arrListCount == 0); // $new_arrList_IndexOf_x and $new_arrList_LastIndexOf_x are equal to $New_ret or $new_arrList_Count is 0
Debug.Assert((Old_arrListIndexOfX == Old_x && Old_arrListLastIndexOfX == Old_x) && arrList.Contains(Old_x)); // $old_arrList_IndexOf_x and $old_arrList_LastIndexOf_x are equal to $old_arrList_x and $old_arrList_contains_x is true
Debug.Assert(New_arrListContainsX == true); // $new_arrList_contains_x is true
Debug.Assert(Old_arrListContainsX == true && New_arrListContainsX == true); // $old_arrList_contains_x and $new_arrList_contains_x are true
Debug.Assert(Old_arrListCount - 1 <= New_arrListCount && New_arrListCount <= Old_arrListCount + 1); // $new_arrList_Count is less than or equal to $old_arrList_Count minus 1 and greater than or equal to $old_arrList_Count plus 1
Debug.Assert(New_Ret == Old_arrListCount); // $New_ret is equal to $old_arrList_Count
