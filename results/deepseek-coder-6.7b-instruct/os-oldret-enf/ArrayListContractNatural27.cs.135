```cs
public virtual void EnsureCapacity(int min)
        {
            if (min > _items.Length)
            {
                // NotpDebug.Assert(min <= ArrayList.MaxArrayLength);
                // NotpDebug.Assert(min > _items.Length);
              
                int newCapacity = _items.Length + 1;
                if (newCapacity < min)
                    newCapacity = min;
                if (newCapacity > ArrayList.MaxArrayLength)
                    throw new ArgumentOutOfRangeException("nameof(min)", "SR.ArgumentOutOfRange_ArrayListCapacity");
                Capacity = newCapacity;
            }
        }
```
