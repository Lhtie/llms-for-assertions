
Debug.Assert(RET > OLD(index) || RET == OLD(index));
--------------------
Debug.Assert(RET >= 0 && RET < _size);
--------------------
Debug.Assert(OLD(_items.length) -1 >= RET && RET >= 0);
--------------------
Debug.Assert(
    Array.IndexOf(_items, value, 0, _size) == -1 || 
    Array.IndexOf(_items, value, 0, _size) >= index);
--------------------
Debug.Assert(OLD(this.Capacity) >= OLD(this.Count) || OLD(this.Capacity) <= 0);
--------------------
Debug.Assert(RET >= OLD(_size) + 1);
--------------------
Debug.Assert(OLD(_items.Length) <= RET || RET == -1);
--------------------
Debug.Assert(RET[index] == value || (Array.IndexOf(this._items, value) == RET[index]));
--------------------
Debug.Assert(_size == Array.IndexOf(_items, value, 0, _size));
--------------------
Debug.Assert(Array.IndexOf(_items, value) != -1 || (value == null && Array.FindIndex(_items, v => v == null) != -1));
