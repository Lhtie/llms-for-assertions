Debug.Assert(RET >= 0 && RET <= Count - 1);
--------------------
Debug.Assert(RET >= 0 && (RET >= 0 && RET < Count));
--------------------
Debug.Assert(_items.Length >= Count && _items.Length >= Capacity);
