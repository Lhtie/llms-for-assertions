public class ArrayList : System.Collections.IList, ICloneable
{
    private Object[] _items; // Do not rename (binary serialization)
    private int _size; // Do not rename (binary serialization)
    private int _version; // Do not rename (binary serialization)
    [NonSerialized]
    private Object _syncRoot;

    private const int _defaultCapacity = 4;

    // Copy of Array.MaxArrayLength
    internal const int MaxArrayLength = 0X7FEFFFFF;

    // Constructs a ArrayList. The list is initially empty and has a capacity
    // of zero. Upon adding the first element to the list the capacity is
    // increased to _defaultCapacity, and then increased in multiples of two as required.
    public ArrayList()
    {
        _items = EmptyArray<Object>.Value;
        // @@@ Default array size is 0
        Debug.Assert(_size == 0);
    }

    // Constructs a ArrayList with a given initial capacity. The list is
    // initially empty, but will have room for the given number of elements
    // before any reallocations are required.
    // 
    public ArrayList(int capacity)
    {
        if (capacity < 0) throw new ArgumentOutOfRangeException("nameof(capacity)", "SR.ArgumentOutOfRange_NeedNonNegNum");
        _items = new Object[capacity];
        // @@@ Capacity initializes to the given value
        Debug.Assert(_items.Length == capacity);
    }

    // Gets and sets the capacity of this list.  The capacity is the size of
    // the internal array used to hold items.  When set, the internal 
    // array of the list is reallocated to the given capacity.
    // 
    public virtual int Capacity
    {
        get { return _items.Length; }
        set 
        {
            if (value < _size) throw new ArgumentOutOfRangeException("nameof(value)", "SR.ArgumentOutOfRange_NeedNonNegNum");
            if (value != _items.Length)
            {
                if (value > 0)
                {
                    Object[] newItems = new Object[value];
                    if (_size > 0) Array.Copy(_items, 0, newItems, 0, _size);
                    _items = newItems;
                }
                else
                {
                    _items = EmptyArray<Object>.Value;
                }
                _version++;
            }
        }
    }

    // Read-only property describing how many elements are in the List.
    public virtual int Count
    {
        get { return _size; }
    }

    // Sets or Gets the element at the given index.
    // 
    public virtual Object this[int index]
    {
        get
        {
            if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
            return _items[index];
        }
        set
        {
            if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
            _items[index] = value;
            _version++;
        }
    }

    // Adds the given object to the end of this list.
    public virtual int Add(Object value)
    {
        if (_size == _items.Length) EnsureCapacity(_size + 1);
        _items[_size] = value;
        _version++;
        _size++;
        // @@@ Size increases by one after Add operation
        Debug.Assert(_size == OLD(_size) + 1);
        return _size - 1;
    }

    // Clears the contents of ArrayList.
    public virtual void Clear()
    {
        if (_size > 0)
        {
            Array.Clear(_items, 0, _size);
            _size = 0;
            _version++;
        }
        // @@@ Size is zero after clearing
        Debug.Assert(_size == 0);
    }

    // Contains returns true if the specified element is in the ArrayList.
    // It does a linear, O(n) search.  Equality is determined by calling
    // item--------------------
Debug.Assert(OLD(this.Count) - 1 == this.Count);
