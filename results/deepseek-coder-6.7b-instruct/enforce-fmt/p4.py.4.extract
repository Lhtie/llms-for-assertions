# Define assertion for rectangle class
rect = Rectangle(5, 2)
assert rect.area == 10, "The calculated area is not correct!"
assert rect.perimeter == 14, "The calculated perimeter is not correct!"
assert rect.len == 5, "The length value is not set correctly!"
assert rect.wid == 2, "The width value is not set correctly!"

# Define assertions for circle class
circ = Circle(3)
assert circ.area == 28.26, "The calculated area is not correct!"
assert circ.perimeter == 18.84, "The calculated perimeter is not correct!"
assert circ.rad == 3, "The radius value is not set correctly!"

# Define assertion for compare_a function
rect2 = Rectangle(4, 2)
assert compare_a(rect, rect2) == 10, "The function does not return the correct area!"
----------------------------------------
PI = 3.14

class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    a1, a2 = s1.area, s2.area
    # s1 and s2 are valid shapes

    if a1>a2: return a1
    else: return a2
