PI = 3.14

class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Rectangle length and width should be greater than 0"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Circle radius should be greater than 0"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    assert (isinstance(s1, Shape) and isinstance(s2, Shape)), "Both arguments should be objects of the Shape class or its subclasses"
    
    a1, a2 = s1.area, s2.area
    # a1 and a2 holds the correct value of area

    if a1>a2: return a1
    else: return a2
```
