from random import randint

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    for acnt in frm.accounts:
	if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

# Test case
p1 = Person("Alice")
p2 = Person("Bob")

# Alice has at least 60 dollars in one of her accounts
print(f"Alice's accounts: {[acnt.money for acnt in p1.accounts]}")

# Bob's account has no money initially
print(f"Bob's account: {p2.accounts[0].money}")

# Transferring 50 dollars from Alice to Bob
assert(transfer(p1, p2, 50))

# Alice's account should now have 10 dollars if she successfully transfers 50 dollars
print(f"Alice's accounts: {[acnt.money for acnt in p1.accounts]}")

# Bob's account should have 50 dollars after being transfered 50 dollars by Alice
print(f"Bob's account: {p2.accounts[0].money}")
