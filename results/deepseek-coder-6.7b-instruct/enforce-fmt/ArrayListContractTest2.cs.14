```cs
[Test]
public void TestAddContract()
{
    // Set up the test case
    ArrayList arrList = new ArrayList();
    int x = 1;

    // Assert preconditions
    Assert.IsTrue(true);

    // Execute the operation
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.Add(x);

    // Assert postconditions
    Assert.AreEqual(Old_arrListCount + 1, arrList.Count);
    Assert.AreEqual(Old_x, (int)arrList[New_Ret]);
    Assert.AreEqual(Old_arrListIndexOfX, arrList.IndexOf(x));
    Assert.AreEqual(Old_arrListLastIndexOfX, arrList.LastIndexOf(x));
    Assert.IsTrue(arrList.Contains(x));
}

// Similar tests can be written for the other PUT_ methods in a similar way.
```

