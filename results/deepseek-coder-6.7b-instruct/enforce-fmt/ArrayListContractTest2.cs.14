```cs
[Test]
public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // Add contract test
    Assert.AreEqual(arrList.Count, arrList.Add(x)); // Asserts that the count after adding x is correct
}

[Test]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // Remove contract test
    Assert.IsTrue(arrList.Contains(x)); // Asserts that the array list contains x before the removal
    arrList.Remove(x);
    Assert.IsFalse(arrList.Contains(x)); // Asserts that the array list no longer contains x after the removal
}

[Test]
public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    // Insert contract test
    Assert.IsFalse(arrList.Contains(x)); // Asserts that the array list does not contain x before the insertion
    arrList.Insert(index, x);
    Assert.IsTrue(arrList.Contains(x)); // Asserts that the array list contains x after the insertion
}

[Test]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    // Set contract test
    Assert.IsTrue(arrList.Contains(arrList[index])); // Asserts that the array list contains the old value at the index before the set
    arrList[index] = x;
    Assert.IsTrue(arrList.Contains(x)); // Asserts that the array list contains x after the set
}

[Test]
public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    // Get contract test
    Assert.IsTrue(arrList.Contains((int)(arrList[index]))); // Asserts that the array list contains the value at the index
}

[Test]
public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // Contains contract test
    Assert.IsTrue(arrList.Contains(x)); // Asserts that the array list contains x
}

[Test]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // IndexOf contract test
    Assert.AreNotEqual(-1, arrList.IndexOf(x)); // Asserts that the array list contains x and returns a valid index
}

[Test]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // LastIndexOf contract test
    Assert.AreNotEqual(-1, arrList.LastIndexOf(x)); // Asserts that the array list contains x and returns a valid last index
}

[Test]
public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // Count contract test
    Assert.IsTrue(arrList.Count >= 0); // Asserts that the count is not negative
}
