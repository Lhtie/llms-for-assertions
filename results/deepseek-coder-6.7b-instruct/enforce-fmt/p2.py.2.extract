def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)
    sum_of_squares = sum([x**2 for x in p43_coeffs])
    assert sum_of_squares == 1, f"Sum of squares of values in array is {sum_of_squares} not 1"
