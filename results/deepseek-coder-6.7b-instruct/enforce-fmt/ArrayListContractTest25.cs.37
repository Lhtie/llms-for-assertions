﻿using NUnit.Framework;
using System;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void AddContract_Test()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 10;

            // When
            arrList.Add(x);

            // Then
            Assert.AreEqual(1, arrList.Count); // @@@ array list size increases by 1 after addition 
        }

        [Test]
        public void InsertContract_Test()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 10;
            int index = 0;

            // When
            arrList.Insert(index, x);

            // Then
            Assert.AreEqual(1, arrList.Count); // @@@ array list size increases by 1 after insertion 
        }

        [Test]
        public void CountContract_Test()
        {
            // Given
            ArrayList arrList = new ArrayList();

            // Then
            Assert.AreEqual(0, arrList.Count); // @@@ count of array list should be 0 when it's empty
        }
    }
}
```
