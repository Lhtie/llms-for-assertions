assert(Rectangle(-1,2).typ == "Rectangle"), "Test 1 failed"
assert(Rectangle(1,2).len == 1), "Test 2 failed"
assert(Rectangle(1,2).wid == 2), "Test 3 failed"
assert(Rectangle(1,2).area == 2), "Test 4 failed"
assert(Rectangle(1,2).perimeter == 6), "Test 5 failed"
assert(Circle(-1).typ == "Rectangle"), "Test 6 failed"
assert(Circle(1).rad == 1), "Test 7 failed"
assert(Circle(1).area == 3.14), "Test 8 failed"
assert(Circle(1).perimeter == 6.28), "Test 9 failed"
assert(compare_a(Rectangle(1,2), Circle(1)) == 3.14), "Test 10 failed"
