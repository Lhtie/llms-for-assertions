Debug.Assert(OLD(Capacity) >= Count);  // The list has enough capacity before any additions.
Debug.Assert(RET >= 0);  // The index of the item being retrieved should be non-negative.
Debug.Assert(RET < Count);  // The index of the item being retrieved should be within the list's range.
Debug.Assert(RET == Count - 1);  // The index of the last item being add should be one less than the count.
Debug.Assert(RET != -1);  // The index of the item being removed should be non-negative.
Debug.Assert(RET < Count);  // The index of the item being removed should be within the list's range.
Debug.Assert(RET == Count);  // After 'Clear', Count should be zero.
Debug.Assert(Capacity >= Count);  // The capacity should be greater or equal to the count after 'Clear'.
