
Debug.Assert(OLD(_size) - 1 == RET);
--------------------
Debug.Assert(OLD(_size) - Count <= 1);
--------------------------------------------------------------------------------
Debug.Assert(COUNT_OLD = COUNT + 1);
--------------------------------------------------------------------------------
Debug.Assert(OLD(_version) + 1 == _version); // @@@ version should increase after an add
Debug.Assert(Count >= 0); // @@@ count should not be negative
Debug.Assert(Capacity >= Count); // @@@ capacity should be greater than or equal to count
Debug.Assert(OLD(Capacity) >= Count); // @@@ capacity should not decrease.
Debug.Assert(Array.IndexOf((Array)_items, value, 0, _size) == index); // @@@ indexOf should return the index where the element is found
Debug.Assert(LastIndexOf(value, _size - 1, _size) == index); // @@@ lastIndexOf should return the index where the element is found
Debug.Assert(Array.LastIndexOf((Array)_items, value, _size - 1, _size - index) == index); // @@@ lastIndexOf on subarray should return the adjusted index where the element is found
--------------------