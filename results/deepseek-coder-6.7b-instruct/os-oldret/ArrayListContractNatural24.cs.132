--------------------```cs
public virtual object this[int index]
{
    get
    {
        // @@@ The value of the object at the given index must be returned
        return _items[index];
    }
    set
    {
        // @@@ The object at the given index must be replaced with the new value
        _items[index] = value;
        _version++;
    }
}

public virtual int Add(object value)
{
    // @@@ The size of the list must be increased by one after an element is added
    if (_size == _items.Length) EnsureCapacity(_size + 1);
    _items[_size] = value;
    _version++;
    return _size++;
}

public virtual void Clear()
{
    // @@@ The size of the list must be set to zero after it is cleared
    _size = 0;
    _version++;
}

public virtual void Insert(int index, object value)
{
    // @@@ The size of the list must be increased by one after an element is inserted
    if (_size == _items.Length) EnsureCapacity(_size + 1);
    if (index < _size)
    {
        Array.Copy(_items, index, _items, index + 1, _size - index);
    }
    _items[index] = value;
    _size++;
    _version++;
}

public virtual void Remove(object obj)
{
    // @@@ The size of the list must be decreased by one after an element is removed
    int index = IndexOf(obj);
    if (index >= 0)
        RemoveAt(index);
}

public virtual void RemoveAt(int index)
{
    Array.Copy(_items, index + 1, _items, index, _size - index - 1);
    _size--;
    _version++;
}
