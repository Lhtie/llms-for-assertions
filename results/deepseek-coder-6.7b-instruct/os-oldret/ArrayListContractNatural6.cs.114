        public virtual Object this[int index]
        {
            // @@@ index is within the valid range of the list
            get
            {
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
                return OLD(_items[index]);
            }
            // @@@ value set at index is what was previously returned by this[index]
            set
            {
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
                _items[index] = value;
                _version++;
            }
        }

        public virtual int Add(Object value)
        {
            // @@@ new size of the list is increased by one
            if (_size == _items.Length) EnsureCapacity(_size + 1);
            _items[_size] = value;
            _version++;
            return OLD(_size++);
        }

        public virtual void Insert(int index, Object value)
        {
            if (index < 0 || index > _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_ArrayListInsert");
            if (_size == _items.Length) EnsureCapacity(_size + 1);
            // @@@ size of the list is increased by one after insertion
            if (index < _size)
            {
                Array.Copy(_items, index, _items, index + 1, _size - index);
            }
            _items[index] = value;
            _size++;
            _version++;
        }

        public virtual void RemoveAt(int index)
        {
            if ((uint)index >= (uint)_size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
            Array.Copy(_items, index + 1, _items, index, _size - index - 1);
            _items[--_size] = null;
            _version++;

            // @@@ After the operation, size of the list decreased by one
        }
```
