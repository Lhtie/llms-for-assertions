
Debug.Assert(Old_arrListCount == New_arrListCount - 1); // The count of arrList should decrease by 1 after Add operation.
Debug.Assert(Old_arrListIndexOfX == -1 && New_arrListIndexOfX >= 0); // If x is in arrList, its index should be >= 0, otherwise -1.
Debug.Assert(Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX >= 0); // If x is in arrList, its last index should be >= 0, otherwise -1.
Debug.Assert(Old_arrListContainsX == false && New_arrListContainsX == true); // After adding x to arrList, it should contain x.

Debug.Assert(Old_arrListCount == New_arrListCount + 1); // The count of arrList should increase by 1 after Remove operation.
Debug.Assert(Old_arrListIndexOfX >= 0 && New_arrListIndexOfX == -1); // After removing x from arrList, its index should be -1 if x is in arrList, otherwise >= 0.
Debug.Assert(Old_arrListLastIndexOfX >= 0 && New_arrListLastIndexOfX == -1); // After removing x from arrList, its last index should be -1 if x is in arrList, otherwise >= 0.
Debug.Assert(Old_arrListContainsX == true && New_arrListContainsX == false); // After removing x from arrList, it should not contain x.

Debug.Assert(Old_arrListCount == New_arrListCount); // The count of arrList should remain the same after Insert operation.
Debug.Assert(Old_index == New_arrListLastIndexOfX && Old_arrListIndexOfX > New_arrListIndexOfX ); // The new index should be greater than the old index and equal to the old last index after Insert operation.

Debug.Assert(Old_arrListCount == New_arrListCount); // The count of arrList should remain the same after Set operation.
Debug.Assert(Old_index >= 0 && Old_index < New_arrListCount ); // The index should be within the range after Set operation.

Debug.Assert(Old_arrListContainsX == true); // The value retrieved from arrList should be in arrList.
Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX && Old_arrListLastIndexOfX <= New_arrListLastIndexOfX ); // The index and last index after Get operation should be >= old index before Get operation.

Debug.Assert(Old_arrListCount == New_arrListCount); // The count of arrList should remain the same after Contains operation.
Debug.Assert(New_Ret == Old_arrListContainsX); // The return value of Contains operation should be equal to whether x is in arrList.

Debug.Assert(New_Ret <= Old_arrListLastIndexOfX); // The return value of IndexOf operation should not exceed the last index of x in arrList.
Debug.Assert(New_Ret <= Old_arrListIndexOfX); // The return value of LastIndexOf operation should not exceed the index of x in arrList.

Debug.Assert(New_Ret >= 0); // The return value of Count operation should be >= 0.
