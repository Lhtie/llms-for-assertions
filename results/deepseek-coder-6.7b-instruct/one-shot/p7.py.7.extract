import numpy as np

# numpy version is greater than 1.7
assert np.__version__ > '1.7'

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)
