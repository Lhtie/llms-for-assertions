import random

class Account:
    def __init__(self, money):
        self.money = money


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]


def calc_total_balance(person):
    total_balance = 0
    for acnt in person.accounts:
        total_balance += acnt.money
    return total_balance


def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    assert calc_total_balance(frm) >= amnt, "@@@ total balance of all frm's accounts is not less than amnt"

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

```

