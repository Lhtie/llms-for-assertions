import re

def generate_assertions(code):
    assert_statements = []

    for line in code.split('\n'):
        if line.strip().startswith('def') or line.strip().startswith('class'):
            continue
        
        if '#' in line:
            comment = line.split('#')[1].strip()
            if comment.startswith('@@@'):
                assert_statements.append(comment[3:])

    return '\n'.join(assert_statements)

code = '''
class Rectangle():
    def __init__(n, m):
        self.exp = n  # this is how tall
        self.mat = n+m+2
        self.lin = m  # this is how wide


def func(n, m):
    r = Rectangle(n, m)
    # @@@ height of r is positive
'''

print(generate_assertions(code))
```

This script works by:
- Splitting the input code by newline (`\n`), which gives us each line of code separately.
- Checking if the line is a function definition or a class definition, ignoring these.
- If the line contains a '#', we split it by '#' and take the second part. This gives us the comment.
- We check if the comment starts with '@@@'. If it does, we add the rest of the comment (without '@@@') to the list of assertions.
- Finally, we join all the assertions by newline and return them.

