import re

def generate_assert(code_string):
    # Extract the comment from the code
    comment = re.search(r'#(.*$)', code_string, re.MULTILINE)
    
    if comment:
        comment_text = comment.group(1).strip()
        
        # If the comment is about positiveness
        if "positive" in comment_text or "positive" in comment_text:
            # Extract the variable from the code
            variable = re.search(r'self\.(.*)\s+is', code_string)
            
            if variable:
                var_name = variable.group(1)
                return f'assert r.{var_name} > 0, "{var_name} is not positive"'
    
    return "No assert statement generated"
    
# Example usage:
