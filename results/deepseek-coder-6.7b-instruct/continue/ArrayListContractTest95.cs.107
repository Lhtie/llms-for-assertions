	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ and new array contains x. 
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is negative, new array does not contain x.
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, count of old array is >= Count of new array
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, last index of x in old array is <= last index of x in new array
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexAtIndex = (int)(arrList[index]);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf((int)(arrList[index]));
            bool Old_arrListContainsIndex = arrList.Contains((int)(arrList[index]));

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsIndex = arrList.Contains((int)(arrList[index]));

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexAtIndex", Old_arrListIndexAtIndex);
            PexObserve.ValueForViewing("$old_arrList_ContainsIndex", Old_arrListContainsIndex);
            PexObserve.ValueForViewing("$new_arrList_ContainsIndex", New_arrListContainsIndex);

            // an assertion using "Debug.Assert\(.*?\);" that @ @@@ 
            // If new array does not contain indexed item => Count of new array <= Count of old array
        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that @ @@@ After Clear(), Count of new ArrayList must be equal to 0
        }
    }
