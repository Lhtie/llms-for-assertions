	[PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_Index = index;
            int Old_arrListOfIndex = (int)(arrList[index]);
            bool Old_arrListContainsIndex= arrList.Contains(Old_arrListOfIndex);

	    int New_arrListCount = arrList.Count;
            int New_arrListOfIndex = -1;
            bool New_arrListContainsIndex = false;

            try
            {
                arrList.RemoveAt(index);
                New_arrListCount = arrList.Count;
                New_arrListOfIndex = (int)(arrList[index]);
                New_arrListContainsIndex = arrList.Contains(New_arrListOfIndex);
            }
            catch (ArgumentOutOfRangeException)
            {
		// do nothing as expected exception
            }

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_Index);
            PexObserve.ValueForViewing("$old_arrList_index_value", Old_arrListOfIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_index_value", Old_arrListContainsIndex);
            PexObserve.ValueForViewing("$new_arrList_index_value", New_arrListOfIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_index_value", New_arrListContainsIndex);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListCapacity = arrList.Capacity;
            bool Old_arrListIsReadOnly = arrList.IsReadOnly;
            bool Old_arrListIsSynchronized = arrList.IsSynchronized;

            arrList.Clear();

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = arrList.Capacity;
            bool New_arrListIsReadOnly = arrList.IsReadOnly;
            bool New_arrListIsSynchronized = arrList.IsSynchronized;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Capacity ", New_arrListCapacity);
            PexObserve.ValueForViewing("$old_arrList_IsReadOnly", Old_arrListIsReadOnly);
            PexObserve.ValueForViewing("$new_arrList_IsReadOnly", New_arrListIsReadOnly);
            PexObserve.ValueForViewing("$old_arrList_IsSynchronized", Old_arrListIsSynchronized);
            PexObserve.ValueForViewing("$new_arrList_IsSynchronized", New_arrListIsSynchronized);

        }
    }
