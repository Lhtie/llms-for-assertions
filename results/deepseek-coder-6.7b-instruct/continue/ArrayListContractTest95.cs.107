        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListGetIndex = (int)(arrList[index]);
            bool Old_arrListContainsOld_arrListGetIndex = arrList.Contains(Old_arrListGetIndex);

