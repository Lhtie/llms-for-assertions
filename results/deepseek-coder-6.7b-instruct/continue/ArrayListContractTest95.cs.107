﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayListTests
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void TestArrayListAddMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        public void TestArrayListAddWithSpecificIndexMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(3);
            arrList.Insert(1,2);

            Assert.AreEqual(2, (int)(arrList[1]));
        }

        [TestMethod]
        public void TestArrayListSetMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList[1] = 3;

            Assert.AreEqual(3, (int)(arrList[1]));
        }

        [TestMethod]
        public void TestArrayListRemoveMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(2);

            Assert.AreEqual(1, arrList.Count);
        }

        [TestMethod]
        public void TestArrayListRemoveAtMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.RemoveAt(1);

            Assert.AreEqual(1, arrList.Count);
        }

        [TestMethod]
        public void TestArrayListContainsMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);

            Assert.IsTrue(arrList.Contains(1));
            Assert.IsFalse(arrList.Contains(2));
        }

        [TestMethod]
        public void TestArrayListIndexOfMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(-1, arrList.IndexOf(3));
        }

        [TestMethod]
        public void TestArrayListLastIndexOfMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(1);
            
            Assert.AreEqual(2, arrList.LastIndexOf(1));
            Assert.AreEqual(-1, arrList.LastIndexOf(3));
        }
    }
}
