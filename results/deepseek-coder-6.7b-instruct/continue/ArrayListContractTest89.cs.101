//test/Microsoft.Pex.Framework.Test/PexContractTest.cs
/*
* Copyright (c) Microsoft Corporation. All rights reserved.
* Licensed under the MIT license.
*
* PexContractTest.cs
* 
* This file implements the PexConstraintTest, that tests the constraints of the Pex framework.
*/

using System;
using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Sdk;
using Microsoft.Pex.Framework.Contracts;
using Microsoft.Pex.Framework.Collections;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.TestServices.Common;
using Microsoft.Pex.Utilities;

using NUnit.Framework;

namespace Microsoft.Pex.Framework.Test
{
    [TestFixture]
    internal class PexContractTest
    {
        #region setup and teardown

        [TestFixtureSetUp]
        public void TestFixtureSetUp()
        {
            PexSettings settings = new PexSettings();
            settings.LogVerbosity = LogVerbosity.Normal;
            settings.PathToLogFile = "C:\\Tests\\Logs\\PexContractTest.log";
            Pex.SetSettings(settings);
        }

        [TestFixtureTearDown]
        public void TestFixtureTearDown()
        {
            Pex.Shutdown();
        }

        #endregion

        [Test, PexMethod]
        public void Pex_Add(int x, [PexInlineData(1)]int y, int z)
        {
            Assume.That(y == 1);

            int result = Pex.Add(x, y, z);

            // Assume.That(result == x + y + z) ensures the post-condition
            Assume.That(result == x + y + z);
        }

        [Test, PexMethod]
        public void Pex_Minus(int x, int y)
        {
            int result = Pex.Minus(x, y);

            Assume.That(result == x - y);
        }
    }
}

