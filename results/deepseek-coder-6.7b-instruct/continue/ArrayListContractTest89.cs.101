            bool Old_arrListContainsX = arrList.Contains(Old_arrListIndexOfX);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(Old_arrListIndexOfX);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(Old_arrListIndexOfX);
            bool New_arrListContainsX = arrList.Contains(Old_arrListIndexOfX);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
