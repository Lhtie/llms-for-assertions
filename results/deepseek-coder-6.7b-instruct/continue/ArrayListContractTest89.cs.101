	    Assert.True(!(New_Ret >= 0 && New_Ret <= Old_arrListIndexOfX));
        }
    }
}

//Tests/ArrayList.Test/ArrayListUnitTest.cs
﻿using NUnit.Framework;
using ArrayList;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test, PexMethod]
        public void ArrayList_Adding([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Assume.That<ArrayList>(arrList != null);
            Assume.That<int>(x > 0 && x < 1000);

            int oldCount = arrList.Count;
            arrList.Add(x);
            Assert.AreEqual(oldCount + 1, arrList.Count);
            Assert.IsTrue(arrList.Contains(x));
        }

        [Test, PexMethod]
        public void ArrayList_Removing([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Assume.That<ArrayList>(arrList != null);
            Assume.That<int>(x > 0 && x < 1000 && arrList.Contains(x));

            int oldCount = arrList.Count;
            arrList.Remove(x);
            Assert.AreEqual(oldCount - 1, arrList.Count);
            Assert.IsFalse(arrList.Contains(x));
        }

        [Test, PexMethod]
        public void ArrayList_Inserting([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Assume.That<ArrayList>(arrList != null);
            Assume.That<int>(x > 0 && x < 1000);
            Assume.That<int>(index >= 0 && index <= arrList.Count);

            arrList.Insert(index, x);
            Assert.IsTrue(arrList.Contains(x));
            Assert.AreEqual(arrList.Count, index + 1);
        }
    }
}

