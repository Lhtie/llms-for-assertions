﻿using System;
using System.Collections.Generic;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using PexAPIWrapper;

namespace PexAPIWrapper.Test
{
    [TestFixture, PexClass]
    public partial class TestContractTest
    {
        [PexMethod]
        public void PUT_Method1([PexAssumeUnderTest]PexAPIWrapper.TestContract tc, int value1, ref int result)
        {
            AssumePrecondition.IsTrue(tc != null);
            
            // store state pre-conditions
            int old_result = result;
            
            // action: call public int Method1(int value1, ref int result)
            result = tc.Method1(value1, ref result);
            
            // new state post-conditions

            // 1. result must be changed
            AssumePrecondition.NotEqual(old_result, result);
            // 2. result should be value1 + 1 or default of int depending on sign
            int expectedResult = value1 + 1;
            AssumePrecondition.Equals(expectedResult, result);

            PexObserve.ValueForViewing("old_result", old_result);
            PexObserve.ValueForViewing("result", result);
        }
        
        // Write additional test methods here...
    }
}﻿using System;
