//ExpertFinder/Pex.Test/ArrayList.Test/ArrayListTest.cs
﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        private ArrayList list;

        [SetUp]
        public void Init()
        {
            list = new ArrayList();
            list.Add(1);
            list.Add(2);
            list.Add(3);
            list.Add(4);
            list.Add(5);
        }

        [Test]
        public void TestAdd()
        {
            Assert.AreEqual(5, list.Count);
            list.Add(6);
            Assert.AreEqual(6, list.Count);
            Assert.AreEqual(6, list[5]);
        }

        [Test]
        public void TestRemove()
        {
            Assert.AreEqual(5, list.Count);
            list.Remove(1);
            Assert.AreEqual(4, list.Count);
            Assert.IsFalse(list.Contains(1));
        }

        [Test]
        public void TestInsert()
        {
            Assert.AreEqual(5, list.Count);
            list.Insert(1, 6);
            Assert.AreEqual(6, list.Count);
            Assert.AreEqual(6, list[1]);
        }

        [Test]
        public void TestSet()
        {
            Assert.AreEqual(5, list.Count);
            list[1] = 6;
            Assert.AreEqual(6, list[1]);
        }

        [Test]
        public void TestGet()
        {
            Assert.AreEqual(5, list.Count);
            Assert.AreEqual(1, list[0]);
        }

        [Test]
        public void TestContains()
        {
            Assert.AreEqual(5, list.Count);
            Assert.IsTrue(list.Contains(1));
            Assert.IsFalse(list.Contains(6));
        }

        [Test]
        public void TestIndexOf()
        {
            Assert.AreEqual(5, list.Count);
            Assert.AreEqual(0, list.IndexOf(1));
            Assert.AreEqual(-1, list.IndexOf(6));
        }

        [Test]
        public void TestLastIndexOf()
        {
            Assert.AreEqual(5, list.Count);
            list.Add(1);
            Assert.AreEqual(9, list.Count);
            Assert.AreEqual(8, list.LastIndexOf(1));
            Assert.AreEqual(-1, list.LastIndexOf(6));
        }

        [Test]
        public void TestClear()
        {
            Assert.AreEqual(5, list.Count);
            list.Clear();
            Assert.AreEqual(0, list.Count);
        }
    }
}

