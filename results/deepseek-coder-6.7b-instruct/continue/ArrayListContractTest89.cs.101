        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_ElementAtIndex = (int)arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsOldElementAtIndex = arrList.Contains(Old_ElementAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_ElementAtIndex", Old_ElementAtIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_oldElementAtIndex", New_arrListContainsOldElementAtIndex);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the list count was greater than zero, the new list count is equal to old list count minus one
	    Assert.IsTrue(Old_arrListCount > 0 ? New_arrListCount == Old_arrListCount - 1 : New_arrListCount == Old_arrListCount);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the list was not empty, new list count must be zero
	    Assert.IsTrue(Old_arrListCount > 0 ? New_arrListCount == 0 : New_arrListCount == Old_arrListCount);

        }

    }


