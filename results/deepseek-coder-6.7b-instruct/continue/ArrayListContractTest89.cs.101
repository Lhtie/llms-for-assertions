﻿///////////////////////////////////////////////////////////////////////////////
//  AUTHOR          :  D. Brian Krol
//  DATE            :  2016-07-28
//  DESCRIPTION     :  Contains unit tests for each operation in the ArrayList class
//  Copyright (c) D. Brian Krol, 2016
///////////////////////////////////////////////////////////////////////////////
using System.Collections;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListContractTest
    {
        ArrayList alist;

        [SetUp]
        public void Init()
        {
            alist = new ArrayList();
            alist.Add(1);
            alist.Add(2);
            alist.Add(3);
        }

        [Test]
        public void ArrayList_Add_Test()
        {
            Assert.AreEqual(4, alist.Add(4));
        }

        [Test]
        public void ArrayList_Remove_Test()
        {
            int index = alist.IndexOf(1);
            Assert.AreEqual(1, alist.Remove(1));
            Assert.AreNotEqual(index, alist.IndexOf(1));
        }

        [Test]
        public void ArrayList_Insert_Test()
        {
            Assert.AreEqual(4 , alist.Insert(1,4));
            Assert.AreEqual(4, alist[1]);
        }

        [Test]
        public void ArrayList_Set_Test()
        {
            alist[1] = 5;
            Assert.AreEqual(5, alist[1]);
        }

        [Test]
        public void ArrayList_Get_Test()
        {
            Assert.AreEqual(1, alist[0]);
        }

        [Test]
        public void ArrayList_Contains_Test()
        {
            Assert.IsTrue(alist.Contains(1));
            Assert.IsFalse(alist.Contains(10));
        }

        [Test]
        public void ArrayList_IndexOf_Test()
        {
            Assert.AreEqual(0, alist.IndexOf(1));
            Assert.AreEqual(-1, alist.IndexOf(10));
        }

        [Test]
        public void ArrayList_LastIndexOf_Test()
        {
            alist.Add(1);
            Assert.AreEqual(3, alist.LastIndexOf(1));
            Assert.AreEqual(-1, alist.LastIndexOf(10));
        }

        [Test]
        public void ArrayList_RemoveAt_Test()
        {
            Assert.AreEqual(2, alist.Count);
            alist.RemoveAt(0);
            Assert.AreEqual(1, alist.Count);
        }

        [Test]
        public void ArrayList_Capacity_Test()
        {
            Assert.AreEqual(4, alist.Capacity);
            alist.Capacity = 6;
            Assert.AreEqual(6, alist.Capacity);
        }

        [Test]
        public void ArrayList_Clear_Test()
        {
            Assert.AreEqual(3, alist.Count);
            alist.Clear();
            Assert.AreEqual(0, alist.Count);
        }
    }
}

