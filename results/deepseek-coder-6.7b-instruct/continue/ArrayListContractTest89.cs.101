export COMPILER="g++"
export COMPILER_FLAGS="-std=c++14 -Wall -g"
export CPP_FILES="PongGame.cpp PongApp.cpp PongMenu.cpp PongPaddle.cpp PongBall.cpp PongPoint.cpp PongUI.cpp util.cpp"

# Create object files
for file in ${CPP_FILES}; do
    ${COMPILER} ${COMPILER_FLAGS} -c ${file}
done

# Create the library
ar rcs lib${PROJECT_NAME}.a PongGame.o PongApp.o PongMenu.o PongPaddle.o PongBall.o PongPoint.o PongUI.o util.o

# Link the library
${COMPILER} ${COMPILER_FLAGS} -o ${OUTPUT_NAME} main.cpp -L. -l${PROJECT_NAME} -lsfml-graphics -lsfml-window -lsfml-system

# Run the application
./${OUTPUT_NAME}

# Remove the object files
rm PongGame.o PongApp.o PongMenu.o PongPaddle.o PongBall.o PongPoint.o PongUI.o util.o

# Remove the library
rm lib${PROJECT_NAME}.a

# Remove the application--------------------            // and if index is smaller or equal to the old list count then the index of new list element is at most the value of the return plus one
	    // an assertion using "Debug.Assert\(.*?\);" that if the return value is negative, the new list doesn't contain x
            // an assertion using "Debug.Assert\(.*?\);" that if the return value is positive, the new list contains x
            // an assertion using "Debug.Assert\(.*?\);" that the size of the list remains the same
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int OldValueAtIndex = (int)(arrList[index]);
            int Old_arrListIndexOfOldValueAtIndex = arrList.IndexOf(OldValueAtIndex);
            int Old_arrListLastIndexOfOldValueAtIndex = arrList.LastIndexOf(OldValueAtIndex);
            bool Old_arrListContainsOldValue = arrList.Contains(OldValueAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfOldValueAtIndex = arrList.IndexOf(OldValueAtIndex);
            int New_arrListLastIndexOfOldValueAtIndex = arrList.LastIndexOf(OldValueAtIndex);
            bool New_arrListContainsOldValue = arrList.Contains(OldValueAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$OldValue_at_index", OldValueAtIndex);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_OldValue", Old_arrListIndexOfOldValueAtIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_OldValue", New_arrListIndexOfOldValueAtIndex);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_OldValue", Old_arrListLastIndexOfOldValueAtIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_OldValue", New_arrListLastIndexOfOldValueAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_OldValue", Old_arrListContainsOldValue);
            PexObserve.ValueForViewing("$new_arrList_contains_OldValue", New_arrListContainsOldValue);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }
    }
}


A: In the contracts you are using the PexObserve.ValueForViewing method to log values that are observed but not used. 


*

*These values are probably there for debugging purposes, but would not affect the logic of your test. You should exclude these from production code, remove or rename the PexObserve.ValueForViewing calls. 

*Also consider using PexAssume and PexAssert. They can make your assumptions more explicit and can help to isolate test failures and bugs.

*Last but not least, don't forget to actually test your production code. Use your contracts to identify potential test cases, but make sure there's actually something to test.


Here are examples of PexAssume and PexAssert usage:
PexAssume.True(x--------------------	    //@@@ And if the return value is not negative, return value is equal to old count of x in the list after the operation

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexAtIndex = (int)(arrList[index]);
            bool Old_arrListContainsIndexValue = arrList.Contains(Old_arrListIndexAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexAtIndex = (index < Old_arrListCount) ? (int)(arrList[index]) : -1; // this value always -1;
            bool New_arrListContainsIndexValue = arrList.Contains(New_arrListIndexAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexAtIndex", Old_arrListIndexAtIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexAtIndex", New_arrListIndexAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_IndexValue", Old_arrListContainsIndexValue);
            PexObserve.ValueForViewing("$new_arrList_contains_IndexValue", New_arrListContainsIndexValue);

        }
    }
}

I expect it will generate a lot of random inputs and run the tests without any problem.

A: Unfortunately, Intellitest does not support Pex. This plugin has been deprecated by Microsoft and is no longer recommended for use.

IntelliTest is a feature of Visual Studio that allows automated unit testing of .NET code with thousands of randomly generated test data.

For unit testing, you might consider using Microsoft's MSTest or NUnit, which support Pex for generating test data.

Please note that IntelliTest and Pex operate in different ways, and MSTest/NUnit and Pex are designed to work with each other and not to replace them. IntelliTest is more a runtime engine for testing .NET programs, while Pex is a tool that helps generating inputs for testing.

Note: Microsoft's "Path Testing" is replaced by IntelliTest, and it should not be confused with Pex.

Source: https://msdn.microsoft.com/en-us/library/dn761563.aspx

That being said, Pex should indeed work with your test fixtures if you use Microsoft's MSTest or NUnit. I would recommend setting up NUnit if you haven't already done so and trying to use Pex with it. It may come out something like this:


*

*First, make sure you have NUnit installed in your projects.

*Then create your tests as methods in your test project.

*Use [Test, PexMethod] attributes instead of regular NUnit attributes.


Lastly, ensure that you have added the following references in your test project:


*

*Microsoft.Pex.Framework

*Microsoft.Pex.Framework.Inteception, 


In visual studio:


*

*Right-click on your test project -> Manage NuGet Packages.

*Search for Microsoft.Pex.Framework and install it.


Another note is it is always a good idea to specify an input range for your Pex tests, by applying [PexMethod, PexAllowedInputRange] attributes to your methods, like this: [PexMethod, PexAllowedInputRange((int)Int32.MinValue, int.MaxValue)]
Hope this could be useful.

A: You'll want to use the NUnit framework along with Microsoft's Pex framework. NUnit was specifically built for unit testing Framework and provides useful features that, while there are other options for automated testing, it is one of the most popular--------------------