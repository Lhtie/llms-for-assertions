        private void CalculateButton_Click(object sender, EventArgs e)
        {
            double firstNumber, secondNumber, sum, difference, product, quotient;

            // converting text boxes string to double since user might enter decimal values
            firstNumber = double.Parse(firstNumberTextBox.Text);
            secondNumber = double.Parse(secondNumberTextBox.Text);
            
            // performing arithmetic operations
            sum = firstNumber + secondNumber;
            difference = firstNumber - secondNumber;
            product = firstNumber * secondNumber;
            quotient = firstNumber / secondNumber;
            
            // displaying results
            sumTextBox.Text = sum.ToString();
            differenceTextBox.Text = difference.ToString();
            productTextBox.Text = product.ToString();
            quotientTextBox.Text = quotient.ToString();
            
        }
    }
