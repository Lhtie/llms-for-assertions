            //an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is negative,  return value is at most index of x in old list minus count of old list
            PexObserve.AssertFalse("@{0}: New_arrListIndexOfX < 0 && Old_arrListLastIndexOfX - Old_arrListCount <= New_arrListIndexOfX", New_arrListIndexOfX < 0 && Old_arrListLastIndexOfX - Old_arrListCount <= New_arrListIndexOfX);
        }

