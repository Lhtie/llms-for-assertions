using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Sdk;
using Microsoft.Pex.TestServices.Common;
using System;

namespace Microsoft.Pex.TestServices.Common
{
    /// <summary>
    /// This class is used to listen for instrumentation events from a Pex session.
    /// </summary>
    internal class PexInstrumentationListener : IPexInstrumentationListener
    {
        #region IPexInstrumentationListener Members

        public void Exiting(PexInvariantInfo info, object result)
        {
        }

        public void Entering(PexInvariantInfo info)
        {
        }

        public void Halt(string message, object argument)
        {
            Console.WriteLine("Halt: " + message + ", argument:" + argument);
        }

        public void PexInvoke(object target, object[] args)
        {
            Console.WriteLine("PexInvoke: " + target + ", args:" + args);
        }

        public void PexCoverage(PexCoverageInfo info)
        {
            Console.WriteLine("PexCoverage: " + info);
        }

        public void PexFailure(string message, object argument)
        {
            Console.WriteLine("PexFailure: " + message + ", argument:" + argument);
        }

        public void PexAssert(string message--------------------            if (New_Ret > 0)
            {
                Assert.IsTrue(New_Ret >= Old_arrListIndexOfX);
            }
        }
    }
}

