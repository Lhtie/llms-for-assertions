﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Tests
{
    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void TestAddingIntegers()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);

            Assert.AreEqual(5, myList[0]);
        }

        [Test]
        public void TestAddingMultipleIntegers()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(6);
            myList.Add(7);

            Assert.AreEqual(5, myList[0]);
            Assert.AreEqual(6, myList[1]);
            Assert.AreEqual(7, myList[2]);
        }

        [Test]
        public void TestRemove()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(6);
            myList.Add(7);
            myList.Remove(6);

            Assert.AreEqual(5, myList[0]);
            Assert.AreEqual(7, myList[1]);
            Assert.AreEqual(2, myList.Count);
        }

        [Test]
        public void TestInsert()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(7);
            myList.Insert(1, 6);

            Assert.AreEqual(5, myList[0]);
            Assert.AreEqual(6, myList[1]);
            Assert.AreEqual(7, myList[2]);
        }

        [Test]
        public void TestSet()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(7);
            myList[1] = 6;

            Assert.AreEqual(5, myList[0]);
            Assert.AreEqual(6, myList[1]);
            Assert.AreEqual(2, myList.Count);
        }

        [Test]
        public void TestContains()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(7);

            Assert.IsTrue(myList.Contains(5));
            Assert.IsTrue(myList.Contains(7));
            Assert.IsFalse(myList.Contains(6));
        }

        [Test]
        public void TestIndexOf()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(7);
            myList.Add(5);

            Assert.AreEqual(0, myList.IndexOf(5));
            Assert.AreEqual(1, myList.IndexOf(7));
            Assert.AreEqual(-1, myList.IndexOf(6));
        }

        [Test]
        public void TestLastIndexOf()
        {
            ArrayList myList = new ArrayList();
            myList.Add(5);
            myList.Add(7);
            myList.Add(5);

            Assert.AreEqual(2, myList.LastIndexOf(5));
            Assert.AreEqual(1, myList.LastIndexOf(7));
            Assert.AreEqual(-1, myList.LastIndexOf(6));
        }
    }
