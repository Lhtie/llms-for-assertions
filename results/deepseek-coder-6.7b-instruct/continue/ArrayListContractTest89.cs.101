﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using WoodlandFm.Domain;

namespace WoodlandFm.Api.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class SearchController : ControllerBase
    {
        // GET api/search
        [HttpGet]
        public ActionResult<IEnumerable<Result>> Get(string name)
        {
            SearchManager _searchManager = new SearchManager();
            var result = _searchManager.GetResult(name);
            return Ok(result);            
        }
    }
}

