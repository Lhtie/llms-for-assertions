--------------------	    int lastIndex = Old_arrListLastIndexOfX != -1 ? Old_arrListLastIndexOfX : New_arrListLastIndexOfX;
	    int secondLastIndex, oldIndexOfItem;
	    secondLastIndex = oldIndexOfItem = lastIndex;
	    do {
		--secondLastIndex;
		oldIndexOfItem = arrList.LastIndexOf(Old_x, oldIndexOfItem - 1);
	    } while (secondLastIndex >= 0 && oldIndexOfItem >= 0 && oldIndexOfItem == secondLastIndex);
	    Debug.Assert(New_arrListLastIndexOfX <= lastIndex);
