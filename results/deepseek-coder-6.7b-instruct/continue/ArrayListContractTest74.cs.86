        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList collection)
        {
            AssumePrecondition.IsTrue(collection.Count > 0);

            int Old_arrListCount = arrList.Count;
            int Old_collectionCount = collection.Count;

            arrList.AddRange(collection);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfFirstCollectionItem = arrList.IndexOf(collection[0]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_collection_Count", Old_collectionCount);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_first_collection_item", New_arrListIndexOfFirstCollectionItem);

        }

    }
}


A: After much hunting, I found the problems, and they were caused because of two fundamental misunderstandings of Pex by Microsoft. 
1) Pex does not handle List's insertion and deletion efficiently
2) Pex currently does not handle generics well
Thus, simply saying that [PexClass] should be enough to ensure all the operations on the ArrayList are under Pex's consideration. But as I found, it is not enough.
You should specify the type and number of elements of a List (ArrayList, in this case) that Pex--------------------           PexObserve.AssertAtBeginning("If the return value is non-negative, new array list's last index of x is <= old arrays count", New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, new array list's contains x is true
           PexObserve.AssertAtBeginning("If the return value is non-negative, new array list's contains x is true", New_Ret >= 0 ? New_arrListContainsX : true);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, new array list's contains x is true
           PexObserve.AssertAtBeginning("If the return value is non-negative, new array list's contains x is true", New_Ret >= 0 ? New_arrListContainsX : true);
          
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

	    // an assertion using "Assert\(.*?\);" that  @@@ If the return value is non-negative, new array list's last index of x is <= old arrays count 
            PexObserve.AssertAtBeginning("If the return value is non-negative, new array list's last index of x is <= old arrays count", New_Ret >= 0 ? New_arrListIndexOfX <= Old_arrListCount : true);
 
        }

     }
}


