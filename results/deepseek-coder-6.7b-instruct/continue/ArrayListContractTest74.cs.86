    using NUnit.Framework;
    using PexAPIWrapper;

    [TestFixture]
    public partial class APIWrapperContractTest
    {
        [PexMethod]
        public void PUT_APIWrapped(string input)
        {
            //Assumption
            AssumePrecondition.IsNotNullOrEmpty(input);

            //Initial Conditions
            var wrapper = new APIWrapper(input);
            int oldAPIWrapperCount = wrapper.APIDataSource.Count;
            string oldAPIWrapperLastElement = wrapper.APIDataSource.GetLastElement();

            //Operations
            wrapper.APIWrap();

            //Post conditions
            int newAPIWrapperCount = wrapper.APIDataSource.Count;
            string newAPIWrapperLastElemenent = wrapper.APIDataSource.GetLastElement();

            //Assertions
            Assert.IsTrue(newAPIWrapperCount <= oldAPIWrapperCount);
            Assert.AreEqual(oldAPIWrapperLastElement, newAPIWrapperLastElemenent);
        }

    }
}

