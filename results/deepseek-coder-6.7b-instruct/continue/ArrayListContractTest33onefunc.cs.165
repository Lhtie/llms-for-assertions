        {
            AssumePrecondition.IsTrue(index >=0 && index < arr.Count);

            // store old values before operation
            int oldCount = arr.Count;
            int oldElement = (int)arr[index];
            int oldIndexOfOldElement = arr.IndexOf(oldElement);
            bool oldContains = arr.Contains(oldElement);
            
