using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void Remove_ArrayList([PexAssumeValid]ArrayList list, [PexAssumeUnderTest]int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < list.Count);
            AssumePrecondition.IsFalse(list.IsFixedSize);

            var oldCount = list.Count;
            var returnVal = list.Remove(index);

            //assert removed item 
            if (index < oldCount)
            {
                Assert.AreEqual(returnVal, list[index]);
            }
            else
            {
                Assert.AreEqual(returnVal, null);
            }

            //assert items are shifted
            if (index < oldCount)
            {
                for (int i = index; i < oldCount - 1; i++)
                {
                    Assert.AreEqual(list[i], list[i + 1]);
                }
            }

            //assert count decremented
            Assert.AreEqual(oldCount - 1, list.Count);
        }
    }
}// Copyright (c) Microsoft Research 2016
