//Microsoft.Pex.Samples.MSTest.ArrayList/Test1.cs
﻿using System;
using System.Collections;
using ArrayList.Program;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    public class Test1
    {
        [TestMethod]
        [PexMethod]
        public void TestMethod1([PexAssumeValid] ArrayList list)
        {
            var Program = new Program();

            // Add some elements to the list
            if(PexAssume.IsTrue(list.Count == 0))
                list.Add(1);
            if (PexAssume.IsTrue(list.Count == 1))
                list.Add("two");
            if (PexAssume.IsTrue(list.Count == 2))
                list.Add(3.234m);

            // Try to copy all elements from the list to an array
            object[] array = new object[list.Count];
            list.CopyTo(array);

            // Validate that all elements at the corresponding positions in the list match the copied array
            Assert.AreEqual(list[0], array[0]);
            Assert.AreEqual(list[1], array[1]);
            Assert.AreEqual(list[2], array[2]);

            // Remove an element from the list
            list.RemoveAt(1);

            // Validate that the list has one less element
            Assert.AreEqual(2, list.Count);
        }
    }
}

