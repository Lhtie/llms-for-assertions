    public class Test2
    {
        [TestMethod]
        [PexMethod]
        public void TestMethod2([PexAssumeValid] ArrayList list)
        {
            var Program = new Program();

            // Add elements to the list
            list.Add("1");
            list.Add("2");
            list.Add("3");

            // Call a method which should sum all elements in the list, assuming the list only contains numbers
            int sum = Program.SumList(list);

            // Validate result
            Assert.AreEqual(6, sum);

            // Remove a number from the list
            list.RemoveAt(1);

            // Call again to validate that method still works correctly
            sum = Program.SumList(list);

            // Validate result
            Assert.AreEqual(5, sum);
        }
    }
}

