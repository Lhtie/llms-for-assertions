using NUnit.Framework;
using System.Collections;
using Pex.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        [Test]
        [PexMethod(typeof(ArrayList))]
        public void ADDDELETE_ArrayListContractTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

        // an assertion using "Debug.Assert\(.*?\);" that the count of new array list is equal to the old plus 1
            Debug.Assert(New_arrListCount == Old_arrListCount + 1);

            arrList.Remove(x);

            int Last_arrListCount = arrList.Count;
            bool Last_arrListContainsX = arrList.Contains(x);

        // an assertion using "Debug.Assert\(.*?\);" that the count of last array list is equal to the new minus 1
            Debug.Assert(Last_arrListCount == New_arrListCount - 1);

            Debug.Assert(New_arrListContainsX && !Last_arrListContainsX);
        }
    }
}
``` 
