using System.Collections;
using Microsoft.Pex.Framework.Contracts;
using System.Collections.Generic;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void Contains_Test([Pex] IList list)
        {
            int old_count = list.Count;
            int someIndex = PexAssume.For(old_count > 0 ? PexRandom.GetInt(0, old_count-1) : PexRandom.GetInt(0,1));
            int item = (int)list[someIndex];

            // Call the function under test
            bool result = list.Contains(item);

            // Check precondition. 
            Assume.That(list.IndexOf(item) != -1);

            // Check postcondition
            Assert.IsTrue(result);
            Assert.AreEqual(old_count, list.Count);
        }

        [PexMethod]
        public void Contains_Test2([Pex] IList list)
        {
            Assume.That(list.Count > 0);

            // Call the function under test
            bool result = list.Contains(PexAssume.For(PexRandom.GetInt())); // pass a value that the list definitely doesn't contain

            // Check that it returns false.
            Assert.IsFalse(result);
        }
    }
}

