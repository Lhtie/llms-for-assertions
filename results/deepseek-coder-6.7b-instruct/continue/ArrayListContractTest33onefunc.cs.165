using System.Collections;
using Microsoft.Pex.Framework.Contracts;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void CopyTo_Test([Pex] IList list, [PexArray] int[] array)
        {
            int old_count = list.Count;
            int old_array_length = array.Length;

            list.CopyTo(array, 0);

            //The count of the source array cannot be larger than the available space from index to the end of the destination array. If index is greater than or equal to the length of the destination array, the method returns without copying any elements.
            Assume.That(0 <= list.Count);
            
            // check that the count of the array has not been overwritten before Assert
            Assert.AreEqual(old_count, list.Count);
            Assert.AreEqual(old_array_length, array.Length);

            for (int i = 0; i < old_array_length; i++) { 
                if (i < old_count)
                    Assert.AreEqual(list[i], array[i]);
                else
                    Assert.AreEqual(default(int), array[i]);
            }
        }


        [PexMethod]
        public void CopyTo_Test2([Pex] IList list, [PexArray] int[] array)
        {
            int outOfRangeIndex = PexAssume.For(PexRandom.GetInt() + list.Count);
            // Trying to copy to an out-of-range index for the array should be safe. The array will not be modified.
            list.CopyTo(array, outOfRangeIndex); 
        }
    }
}

