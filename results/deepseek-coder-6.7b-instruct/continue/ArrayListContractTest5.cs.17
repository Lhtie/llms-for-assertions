﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace PexExample1
{
    public class MyMath
    {
        public int Add(int a, int b)
        {
           return a + b;
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            MyMath math = new MyMath();
            Console.WriteLine(math.Add(2, 3)); // Outputs: 5
            Console.ReadLine();
        }
    }
}

