}namespace BinaryTree
{
    public enum BinaryTreeTraversal
    {
        PreOrder,
        InOrder,
        PostOrder,
        LevelOrder,
    }
}namespace BinaryTree
{
    public class BinaryTreeNode
    {
        public int Value;
        public BinaryTreeNode Left;
        public BinaryTreeNode Right;

        public BinaryTreeNode(int value)
        {
            Value = value;
        }

        public override string ToString()
        {
            return Value.ToString();
        }
    }
}using System;
using System.Collections.Generic;

namespace BinaryTree
{
    public class BinaryTree
    {
        public BinaryTreeNode Root { get; private set; }

        public BinaryTree(int rootValue)
        {
            Root = new BinaryTreeNode(rootValue);
        }

        public void Insert(int value)
        {
            InsertRecursive(Root, value);
        }

        private BinaryTreeNode InsertRecursive(BinaryTreeNode current, int value)
        {
            if (current == null)
            {
                current = new BinaryTreeNode(value);
            }
            else if (value < current.Value)
            {
                current.Left = InsertRecursive(current.Left, value);
            }
            else if (value > current.Value)
            {
                current.Right = InsertRecursive(current.Right, value);
            }

            return current;
        }

        public bool Contains(int value)
        {
            return ContainsRecursive(Root, value);
        }

        private bool ContainsRecursive(BinaryTreeNode current, int value)
        {
            if (current == null) return false;
            if (value == current.Value) return true;
            return value < current.Value 
                ? ContainsRecursive(current.Left, value) 
                : ContainsRecursive(current.Right, value);
        }

        public void Traverse(Action<BinaryTreeNode> action, BinaryTreeTraversal traversal = BinaryTreeTraversal.InOrder)
        {
            switch(traversal)
            {
                case BinaryTreeTraversal.PreOrder:
                    TraversePreOrder(action, Root);
                    break;
                case BinaryTreeTraversal.InOrder:
                    TraverseInOrder(action, Root);
                    break;
                case BinaryTreeTraversal.PostOrder:
                    TraversePostOrder(action, Root);
                    break;
                case BinaryTreeTraversal.LevelOrder:
                    TraverseLevelOrder(action);
                    break;
            }
        }

        private void TraversePreOrder(Action<BinaryTreeNode> action, BinaryTreeNode node)
        {
            if (node == null) return;
            action(node);
            TraversePreOrder(action, node.Left);
            TraversePreOrder(action, node.Right);
        }

        private void TraverseInOrder(Action<BinaryTreeNode> action, BinaryTreeNode node)
        {
            if (node == null) return;
            TraverseInOrder(action, node.Left);
            action(node);
            TraverseInOrder(action, node.Right);
        }

        private void TraversePostOrder(Action<BinaryTreeNode> action, BinaryTreeNode node)
        {
            if (node == null) return;
            TraversePostOrder(action, node.Left);
            TraversePostOrder(action, node.Right);
            action(node);
        }

        private void TraverseLevelOrder(Action<BinaryTreeNode> action)
        {
            var queue = new Queue<BinaryTreeNode>();
            queue.Enqueue(Root);
            while (queue--------------------
	    Assert.IsTrue(New_Ret >= Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that after adding x, it's index of x is greater than or equal to old array size

	    Assert.IsTrue(New_arrListIndexOfX >= Old_arrListCount);

