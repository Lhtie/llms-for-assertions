public partial class CSharpMath
{
    [PexMethod]
    [PexAllowedException(typeof(ArgumentException), typeof(DivideByZeroException))]
    public double DivMod(double dividend, double divisor)
    {
        PexAssert.IsTrue(divisor != 0);

        double result;
        try
        {
            result = dividend / divisor;
        }
        catch (DivideByZeroException)
        {
            throw new ArgumentException("Divisor is 0", nameof(divisor));
        }

        return result;
    }
