            Assert.That(New_arrListLastIndexOfX, Is.GreaterThanOrEqualTo(Old_arrListCount));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the last index is equal to new array size or -1 in absence of x in array
            if (! Old_arrListContainsX) {
                Assert.That(New_arrListLastIndexOfX, Is.EqualTo(-1));

		} else {
                Assert.That(New_arrListLastIndexOfX, Is.EqualTo(New_arrListCount - 1));
            }

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index of x  in new array is greater than or equal to 0
            Assert.That(New_arrListIndexOfX, Is.GreaterThanOrEqualTo(0));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of new array is old array size plus 1
            Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount + 1));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array does not contain x in absence of old array contains x
            if (! Old_arrListContainsX) {
                Assert.That(New_arrListContainsX, Is.False);

	    } else {
                Assert.That(New_arrListContainsX, Is.True);
            }
        }
    }
}

