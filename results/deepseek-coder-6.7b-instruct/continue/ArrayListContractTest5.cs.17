﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using PexExample1;

namespace PexExample1.Test
{
    [TestFixture, PexClass]
    public partial class MyMathTest
    {
        [PexMethod]
        public void PexTargetMethod([PexAssumeUnderTest]MyMath math)
        {
            int a = 5;
            int b = 3;
            int expectedResult = 8;

            AssumePrecondition.IsTrue(a >= 0);
            AssumePrecondition.IsTrue(b >= 0);
            AssumePrecondition.IsTrue(a + b >= 0); // avoid overflow for "checked" additions

            int actualResult = math.Add(a, b);

            PexObserve.ValueForViewing("a", a);
            PexObserve.ValueForViewing("b", b);
            PexObserve.ValueForViewing("expectedResult", expectedResult);
            PexObserve.ValueForViewing("actualResult", actualResult);

            // Assert
            Assert.AreEqual(expectedResult, actualResult);
        }
    }
