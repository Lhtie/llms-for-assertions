namespace BubbleSort
{
    public class Program
    {
        static void Main(string[] args)
        {
        }

        public static void Sort(int[] arr)
        {
            bool isSorted = false;
            int temp;
            while (!isSorted)
            {
                isSorted = true;
                for (int i = 0; i < arr.Length - 1; i++)
                {
                    if (arr[i] > arr[i + 1])
                    {
                        temp = arr[i + 1];
                        arr[i + 1] = arr[i];
                        arr[i] = temp;
                        isSorted = false;
                    }
                }
            }
        }
    }
