}public static int GetFileAgeIndays(string filePath)
{
    if(!File.Exists(filePath))
        return -1;

    FileInfo fileInfo = new FileInfo(filePath);
    DateTime today = DateTime.Now;
    int differenceInDays = (today - fileInfo.CreationTime).Days;

    return differenceInDays;
}

//Usage
Console.WriteLine(GetFileAgeIndays("path\\to\\file.txt"));

//This method returns the number of days that have passed since the file was created, if the file does not exist, it returns -1.

//Remember that GetFileAgeIndays can give inaccurate results if the time elapsed was 24 hours or more, because it only checks for full days. 
//If you need accurate results you should use DateTime.Now.Subtract(fileInfo.CreationTime).TotalDays instead.

//The FileInfo.CreationTime returns the time at which the file was created.

//DateTime.Now returns the current date and time.

//Subtracting two DateTime objects directly will give you a TimeSpan object.

//You can get the total number of days by calling the TotalDays property on the TimeSpan object.

//If a file was created at 3:00 PM on October 30, 2022, and the current date and time is 4:00 PM on the same day; Difference would be 1 day even if the method was called immediately after 3:00 PM. However, TotalDays will return 1.0; it counts fractional days accurately.

//If your use case can accept such inaccuracy then it is fine to use (DateTime.Now - fileInfo.CreationTime).Days; but if the days matter a lot and you want to include fractions of days into consideration then TotalDays should be used.

//Also, please note that TimeSpan represents time in hours, minutes, and seconds; it does not include millisecond resolution; for that, you need to use DateTime.Now.Subtract(fileInfo.CreationTime).TotalMilliseconds in C#.
//Keep in mind that you might not get the perfect solution for all use cases, especially when dealing with timezones.
//Always test thoroughly before deploying anything.

//If you need specific formatting or a different time range, adjust as needed.
//This is a basic example, if you need more customizations, feel free to ask with clarity.
//Note: 'filePath' should be the exact and direct path of the file including the name of the file in string form.
//Replace 'path\\to\\file.txt' with the path to your file.
//The output will be the file age in days.
//If the file doessn't exist, output will be -1.
//The File.Exists(filePath) will check if the file is actually existing at the provided path otherwise it will return false and -1 will be returned.
//If the condition is true FileInfo will create an object of fileInfo and then calculate the difference between now and the creation time of the file and return it.
//It basically return the difference in days from the file creation time to the current date and time.

//The assumption here is that file will be created less than a day ago and current time is later than file creation time.
//If file created more than a day ago, or current time is earlier than file creation time, the result will be incorrect.
//And the method will only give correct result if the time difference is exactly a day, more than a day or negative (less than a day).
//Any other time difference will not be handled right here.

//For handling all cases (past and future times) and sub-minute time differences you could use DateTime.UtcNow.Subtract(fileInfo.CreationTime).TotalDays for UTC times.
//But this is another story ;) and might be too complex depending on your requirements.
//If you need help with something let me know, I'll do my best to help you.
//Happy coding :)
