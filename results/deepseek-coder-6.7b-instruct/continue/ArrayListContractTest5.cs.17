namespace Microsoft.Pex.Framework.Rewriting {
    using System;

    public class UnboundVariableRewriter : Rewriter {
        protected override void Visit(BoundVariableNode node) {
            throw new InvalidOperationException($"Encountered unbound variable {node.VariableName} while trying to perform rewrite operation");
        }
    }
}// Copyright (c) Microsoft Research 2016
// License: MIT. See LICENSE

namespace Microsoft.Pex.Framework.Rewriting
{
    public abstract class Rewriter
    {
        public virtual void Rewrite(Node node)
        {
            this.Visit(node);
        }

        protected abstract void Visit(BoundVariableNode node);

        private void Visit(Node node) {
            if (node is BoundVariableNode)
            {
                Visit((BoundVariableNode)node);
            }
            else if (node is LiteralNode)
            {
                Visit((LiteralNode)node);
            }
            else if (node is OperationNode)
            {
                Visit((OperationNode)node);
            }
            else if (node is QuantifierNode)
            {
                Visit((QuantifierNode)node);
            }
        }

        protected virtual void Visit(LiteralNode node) { }
        protected virtual void Visit(OperationNode node) { }
        protected virtual void Visit(QuantifierNode node) { }
    }
