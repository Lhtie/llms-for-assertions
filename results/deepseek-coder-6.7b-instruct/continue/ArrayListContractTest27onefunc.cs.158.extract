            Debug.Assert(Old_arrListIndexOfX <= index);
----------------------------------------            Debug.Assert(Old_arrListLastIndexOfX >= index);
--------------------            Debug.Assert(Old_arrListLastIndexOfX >= index);
--------------------	    // after execution of this function @@@ with parameter values {arrList, x, index}
            int lastPositionOld = 0;
            for (int i = 0; i < Old_arrListCount; i++) {
                if ((int)arrList[i] == x) {
                    lastPositionOld = i;
                }
            }

            int lastPositionNew = 0;
            for (int i = 0; i < New_arrListCount; i++) {
                if ((int)arrList[i] == x) {
                    lastPositionNew = i;
                }
            }

            Debug.Assert(lastPositionNew >= lastPositionOld);
--------------------	    // at the end of the test, if @@@ =  "arrList.Contains\(Old_x\)" then @@@ = true; at the end of test.

            Assert.IsTrue(Old_arrListIndexOfX >= 0 && New_arrListIndexOfX == index);  
        }
    }
}

