	    int Old_position = -1;
	    for (int i = 0; i < Old_arrListCount; i++) {
		if ((int)arrList[i] == x) {
		    Old_position = i;
		    break;
		}
	    }
	    Debug.Assert(Old_position >= Old_index);
--------------------	     Debug.Assert(Old_arrListIndexOfX >= -1);
