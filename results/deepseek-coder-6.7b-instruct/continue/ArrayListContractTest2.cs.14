                case StateType.None:
                    return "None";
                case StateType.StateA:
                    return "StateA";
                case StateType.StateB:
                    return "StateB";
                case StateType.StateC:
                    return "StateC";
                case StateType.StateD:
                    return "StateD";
                default:
