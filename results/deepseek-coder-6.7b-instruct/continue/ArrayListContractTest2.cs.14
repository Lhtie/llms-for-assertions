            Assert.IsTrue(New_Ret == New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that the count of arrList is increased by 1 after adding x
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);

	    // an assertion using "Debug.Assert\(.*?\);" that if x existed in arrList then x should be in arrList after adding x
            Assert.IsTrue(Old_arrListContainsX == New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that the index of x is maintained same or increased after adding x
            Assert.IsTrue(Old_arrListIndexOfX == New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);"  that the last index of x is maintained or increased after adding x
            Assert.IsTrue(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);
        }

        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList arrList2)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrList2Count = arrList2.Count;
            arrList.AddRange(arrList2);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList2_Count", Old_arrList2Count);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that the count of arrList is increased by count of arrlist2 after adding arrlist2
            Assert.IsTrue(New_arrListCount == Old_arrListCount + Old_arrList2Count);
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

