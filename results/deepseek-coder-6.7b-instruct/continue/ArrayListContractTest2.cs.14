namespace PexAPIWrapper
{
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListTest
    {
        [PexMethod]
        public void PexAPI_Add(int value)
        {
            ArrayList list = new ArrayList();
            int oldCount = list.Count;
            int newIndex = list.Add(value);

            Assert.AreEqual(oldCount+1, list.Count);
            Assert.AreEqual(value, list[newIndex]);
        }

        [PexMethod]
        public void PexAPI_Insert(int index, int value)
        {
            ArrayList list = new ArrayList();
            int oldCount = list.Count;

            list.Insert(index, value);

            Assert.AreEqual(oldCount + 1, list.Count);
            Assert.AreEqual(value, list[index]);
        }

        [PexMethod]
        public void PexAPI_Remove(int value)
        {
            ArrayList list = new ArrayList();
            int oldCount = list.Count;
            list.Add(value);

            list.Remove(value);

            Assert.AreEqual(oldCount, list.Count);
            Assert.IsFalse(list.Contains(value));
        }

        [PexMethod]
        public void PexAPI_IndexOf(int value)
        {
            ArrayList list = new ArrayList();
            list.Add(value);
            int expectedIndex = 0;

            int actualIndex = list.IndexOf(value);

            Assert.AreEqual(expectedIndex, actualIndex);
        }
    }
