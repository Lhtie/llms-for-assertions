using System.Collections.Generic;

namespace Abstractions
{
    public class StateMachine
    {
        private Dictionary<string, IState> StateDictionary;
        public IState CurrentState { get; private set; }

        public StateMachine(Dictionary<string, IState> stateList)
        {
            StateDictionary = stateList;
        }

        public void ChangeState(string stateKey)
        {
            if (CurrentState != null)
            {

            }

            CurrentState = StateDictionary[stateKey];
            CurrentState.Enter();
        }

        public void Update()
        {
            if (CurrentState != null)
            {
                CurrentState.Update();
            }
        }

        public void FixedUpdate()
        {
            if (CurrentState != null)
            {
                CurrentState.FixedUpdate();
            }
        }

        public void Exit()
        {
            if (CurrentState != null)
            {
                CurrentState.Exit();
            }

            CurrentState = null;
        }
    }
}

