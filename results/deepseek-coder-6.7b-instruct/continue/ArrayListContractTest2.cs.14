namespace FluentAPIProject
{
    public class Message : IMessage
    {
        public string SentMessage { get; private set; }

        public Message()
        {
            this.SentMessage = string.Empty;
        }

        public IMessage With(string message)
        {
            this.SentMessage = message;
            return this;
        }

        public IMessage To(string receiver)
        {
            this.SentMessage += "To: " + receiver + Environment.NewLine;
            return this;
        }

        public IMessage CC(string receiver)
        {
            this.SentMessage += "CC: " + receiver + Environment.NewLine;
            return this;
        }

        public IMessage BCC(string receiver)
        {
            this.SentMessage += "BCC: " + receiver + Environment.NewLine;
            return this;
        }
    }
