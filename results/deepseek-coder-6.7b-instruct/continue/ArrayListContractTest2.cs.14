	   // assertion of New_arrList_contains_x is true
            Assert.IsTrue(New_arrListContainsX);

	   // check the index of x in original arraylist  == index of x in updated arraylist
            Assert.IsTrue(Old_arrListIndexOfX.Equals(New_arrListIndexOfX));

	    // check the last index of x in original arraylist == last index of x in updated arraylist
            Assert.IsTrue(Old_arrListLastIndexOfX.Equals(New_arrListLastIndexOfX));
        }
    }
}

