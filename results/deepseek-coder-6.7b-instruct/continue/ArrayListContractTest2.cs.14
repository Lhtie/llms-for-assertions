//Tests/ArrayList.Test/ArrayListRemoveTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public class ArrayListRemoveTest
    {
        [Test, PexMethod]
        public void Remove_Success_Test([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index > -1);

            Object obj = arrList.Get(index);

            // removing the object at index
            arrList.RemoveAt(index);

            // checking if item is really removed
            Assert.IsFalse(arrList.Contains(obj));

            // check if count decreased by 1
            Assert.AreEqual(arrList.Count, arrList.Count - 1);

            // try removing again - should throw exception
            Assert.Throws<IndexOutOfRangeException>(() => arrList.RemoveAt(index)); 

            // try getting item back
            Assert.Throws<IndexOutOfRangeException>(() => arrList.Get(index));
        }


        [Test, PexMethod]
        public void Remove_NonExistentIndex([PexAssumeUnderTest] ArrayList arrList, int invalidIndex)
        {
            AssumePrecondition.IsTrue(invalidIndex <= arrList.Count || invalidIndex < 0);

            Assert.Throws<IndexOutOfRangeException>(() => arrList.RemoveAt(invalidIndex));
        }
    }
}

//Tests/ArrayList.Test/ArrayListSetAndGetTest.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListSetAndGetTest
    {
        [Test, PexMethod]
        public void SetAndGet_Success_Test([PexAssumeUnderTest]ArrayList arrList, int index, Object obj)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index > -1);

            // set item at index
            arrList.Set(index, obj);

            // check if item is the same after set
            Assert.AreSame(obj, arrList.Get(index));

            // set again and check if item changed
            Object newObj = new Object();
            arrList.Set(index, newObj);
            Assert.AreSame(newObj, arrList.Get(index));
            Assert.AreNotSame(obj, arrList.Get(index));
        }

        [Test, PexMethod]

        public void Get_NonExistentIndex([PexAssumeUnderTest] ArrayList arrList, int invalidIndex)
        {
            AssumePrecondition.IsTrue(invalidIndex <= arrList.Count--------------------            if (Old_arrListContainsX == false)
            {
                Assert.IsTrue(Old_arrListIndexOfX == -1 && New_Ret == 0, "Index was not -1, but expected to return -1.");
            }
            else
            {
                Assert.IsTrue(Old_arrListIndexOfX <= New_Ret && New_Ret <= Old_arrListCount - 1, "Index is out of range.");
            }

            // an assertion using "Debug.Assert\(.*?\);" that @@@ the Count property of the collection increases by one 
            Assert.IsTrue(Old_arrListCount + 1 == New_arrListCount, "Count property is not increased by one.");

            // assertion that @@@ the collection remains unchanged if added @@@ the same values
            Assert.IsTrue(New_arrListContainsX == Old_arrListContainsX, "Contains property of the collection has changed.");

            // assertion that @@@ Added item is in the newly generated collection  
            Assert.IsTrue(New_arrListContainsX, "Added item is not present in the new collection.");
        }
    }
