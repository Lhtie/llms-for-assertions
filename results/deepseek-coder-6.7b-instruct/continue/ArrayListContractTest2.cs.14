            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that the count of arrList is increased by 1 after inserting x at index
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);

	    // an assertion using "Debug.Assert\(.*?\);" that if x exists in arrList and the index is less than or equal to the old index of x then the index of x in new array is same or greater than old index
            Assert.IsTrue(Old_arrListIndexOfX <= New_arrListIndexOfX);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
