//ArrayList.Test/ArrayListUnitTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test]
        [PexMethod]
        public void Test_Add_Method([PexAssumeUnderTest]ArrayList arrList)
        {
            int Old_Count = arrList.Count;
            int x = 10;
            int retVal = arrList.Add(x);
            int New_Count = arrList.Count;
            int index = arrList.IndexOf(x);

            Assert.AreEqual(Old_Count + 1, New_Count);
            Assert.AreEqual(x, (int)arrList[index]);
            Assert.AreEqual(0, retVal);
        }

        [Test]
        [PexMethod]
        public void Test_Remove_Method_With_Valid_Element([PexAssumeUnderTest]ArrayList arrList)
        {
            if (arrList.Count > 0)
            {
                int x = (int)arrList[0];
                arrList.Remove(x);
                int New_Count = arrList.Count;
                int index = arrList.IndexOf(x);
                Assert.AreEqual(0, New_Count);
                Assert.AreEqual(-1, index);
            }
        }

        [Test]
        [PexMethod]
        public void Test_RemoveAt_Method_With_Valid_Index([PexAssumeUnderTest]ArrayList arrList)
        {
            if (arrList.Count > 0)
            {
                int index = 0;
                int Old_Count = arrList.Count;
                arrList.RemoveAt(index);
                int New_Count = arrList.Count;
                Assert.AreEqual(Old_Count - 1, New_Count);
                Assert.IsFalse(arrList.Contains(index));
            }
        }

        [Test]
        [PexMethod]
        public void Test_Insert_Method([PexAssumeUnderTest]ArrayList arrList, int x, [PexAssumeValid]int index)
        {
            AssumePrecondition.IsTrue( index <= arrList.Count + 1); 
            AssumePrecondition.IsTrue( index >=0 );
            arrList.Insert( index, x );
            int New_Count = arrList.Count;
            int New_Index  = arrList.IndexOf(x);

            Assert.AreEqual(1, New_Count - arrList.Count);
            Assert.AreEqual(index, New_Index);
        }


    }
}

