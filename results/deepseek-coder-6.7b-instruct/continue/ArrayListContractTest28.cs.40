		/// Initializes a new instance of the <see cref="RavenDBLogger"/> class.
		/// </summary>
		/// <param name="level">The log level.</param>
		/// <param name="session">The session.</param>
		/// <param name="loggerName">Name of the logger.</param>
		public RavenDBLogger(LogLevel level, IDocumentSession session, string loggerName)
			: base(level)
		{
			this.session = session;
			loggerDefinition = new LoggerDefinition
			{
				Name = loggerName,
				Level = Level
			};

			session.Store(loggerDefinition);
		}
		/// <summary>
		/// Performs application-defined tasks associated with freeing, releasing, or resetting unmanaged resources--------------------	    int positionOfNewItem_old = arrList.IndexOf(old_x);
	    int positionOfNewItem_new = arrList.IndexOf(new_x);
            Debug.Assert((positionOfNewItem_old != positionOfNewItem_new)); 

        }
    }
}//Fibonacci/Fibonacci.cs
﻿using System;
using System.Collections.Generic;

namespace CodingChallenge.Fibonacci
{
    public class FibonacciSequence
    {
        public List<int> Generate(int count)
        {
            var fibonacciNumbers = new List<int>();

            if (count > 0)
            {
                fibonacciNumbers.Add(0);
                
                if (count > 1)
                {
                    fibonacciNumbers.Add(1);

                    for (int i = 2; i < count; i++)
                    {
                        fibonacciNumbers.Add(fibonacciNumbers[i - 2] + fibonacciNumbers[i - 1]);
                    }
                }
            }


            return fibonacciNumbers;
        }
    }
}

//FizzBuzz/FizzBuzz.cs
﻿using System;
using System.Collections.Generic;

namespace CodingChallenge.FizzBuzz
{
    public class FizzBuzz
    {
        private const int FizzMultiple = 3;
        private const int BuzzMultiple = 5;
        private const string Fizz = "Fizz";
        private const string Buzz = "Buzz";
        
        public List<string> Generate(int start, int end)
        {
            var fizzBuzzSeries = new List<string>();

            for(int i = start; i <= end; i++)
            {
                if(i % FizzMultiple == 0 && i % BuzzMultiple == 0)
                {
                    fizzBuzzSeries.Add(Fizz + Buzz);
                }
                else if(i % FizzMultiple == 0)
                {
                    fizzBuzzSeries.Add(Fizz);
                }
                else if(i % BuzzMultiple == 0)
                {
                    fizzBuzzSeries.Add(Buzz);
                }
                else
                {
                    fizzBuzzSeries.Add(i.ToString());
                }
            }

            return fizzBuzzSeries;
        }
    }
}

//Program.cs
﻿using System;
using System.Linq;
using CodingChallenge.FizzBuzz;
using CodingChallenge.Fibonacci;

namespace CodingChallenge
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Welcome to the Coding Challenge app!");

            var fibonacci = new FibonacciSequence();
            var fizzBuzz = new FizzBuzz();

            var fibonacciNumbers = fibonacci.Generate(15);
            var fizzBuzzSeries = fizzBuzz.Generate(1, 100);
            
            Console.WriteLine("Fibonacci Sequence: " + string.Join(", ", fibonacciNumbers));
            Console.WriteLine("FizzBuzz Series: " + string.Join(", ", fizzBuzzSeries));

            Console.ReadLine();
        }
    }
}

