    [TestFixture, PexClass]
    public partial class ArrayListPerformanceTest
    {
        private IList<int> _list;

        internal void Init(int ctorArg)
        {
            _list = new ArrayList(ctorArg);
            for (int i = 0; i < ctorArg; ++i)
            {
                _list.Add(i);
            }
        }

        [PexMethod]
        public void PUT_PerfTest([PexAssumeUnderTest]ArrayList arrList, int count)
        {
            Random rnd = new Random();
            int index = -1;
            AssumePrecondition.IsTrue(count >= 0 && count <= 10000);

            for (int i = 0; i < count; i++)
            {
                index = rnd.Next(0, _list.Count);
                arrList.Add(index);
            }

            for (int i = 0; i < count; i++)
            {
                index = rnd.Next(0, _list.Count);
                arrList.RemoveAt(index);
            }
        }

       [PexMethod]
        public void PUT_PerfTest_Insert([PexAssumeUnderTest]ArrayList arrList, int count)
        {
            Random rnd = new Random();
            AssumePrecondition.IsTrue(count >= 0 && count <= 10000);

            for (int i = 0; i < count; i++)
            {
                int index = rnd.Next(0, arrList.Count);
                arrList.Insert(index, i);
            }

            for (int i = 0; i < count; i++)
            {
                int index = rnd.Next(0, arrList.Count);
                arrList.RemoveAt(index);
            }
        }
    }
