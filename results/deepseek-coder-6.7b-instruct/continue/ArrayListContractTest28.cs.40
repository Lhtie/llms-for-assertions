using CodingChallenge.FizzBuzz;
using System;
using System.Collections.Generic;
using Xunit;

namespace CodingChallenge.Tests
{
    public class FizzBuzzTests
    {
        [Fact]
--------------------        }

        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList_A, [PexAssumeUnderTest]ArrayList arrList_B)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrList_ACount = arrList_A.Count;
            int Old_arrList_BCount = arrList_B.Count;

            arrList_A.AddRange(arrList_B);

            int New_arrList_ACount = arrList_A.Count;

            PexObserve.ValueForViewing("$old_arrList_A_Count", Old_arrList_ACount);
            PexObserve.ValueForViewing("$old_arrList_B_Count", Old_arrList_BCount);
            PexObserve.ValueForViewing("$new_arrList_A_Count", New_arrList_ACount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new count of arrList_A is different from old count of arrList_A and arrList_B.
        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new count of arrList is zero. 
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            bool ret = arrList.Contains(x);

            PexObserve.ValueForViewing("$arrList_Contains_x", ret);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ return value of contains operation is correct.
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int ret = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$arrList_IndexOf_x", ret);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ return value of IndexOf operation is correct.
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int ret = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$arrList_LastIndexOf_x", ret);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ return value of LastIndexOf operation is correct.
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ new count of arrList is one less than old count.
        }

    }
