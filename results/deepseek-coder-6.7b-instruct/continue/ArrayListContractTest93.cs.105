        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >=0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_ValAtIndex = (int)(arrList[index]);
            bool Old_arrListContainsValAtIndex = arrList.Contains(Old_ValAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsValAtIndex = arrList.Contains(Old_ValAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$Old_valAtIndex", Old_ValAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_valAtIndex", Old_arrListContainsValAtIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_valAtIndex", New_arrListContainsValAtIndex);

        }
    }
}

