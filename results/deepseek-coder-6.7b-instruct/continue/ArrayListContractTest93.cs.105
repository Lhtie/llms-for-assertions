﻿using System;
using System.Collections;
using ArrayList;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayListTests
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void Test_Add()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        public void Test_Add_Negative()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(4, arrList.Add(-1));
        }

        [TestMethod]
        public void Test_Remove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);

            Assert.AreEqual(2, arrList.Count);
        }

        [TestMethod]
        public void Test_Remove_Negative()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(-1, arrList.Remove(-1));
        }

        [TestMethod]
        public void Test_Insert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList.Insert(1, -1);

            Assert.AreEqual(-1, arrList[1]);
        }

        [TestMethod]
        public void Test_Set()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList[0] = -1;

            Assert.AreEqual(-1, arrList[0]);
        }

        [TestMethod]
        public void Test_Get()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);

