﻿using NUnit.Framework;
using RockPaperScissors.Models;
using System;

namespace RockPaperScissorsTests
{
    public class Tests
    {
        [Test]
        public void ConvertInput_WithValidInputs_ReturnsCorrectChoice()
        {
            Assert.AreEqual(RPSGame.ConvertInput("rock"), RPSGame.Choices.rock);
            Assert.AreEqual(RPSGame.ConvertInput("paper"), RPSGame.Choices.paper);
            Assert.AreEqual(RPSGame.ConvertInput("scissors"), RPSGame.Choices.scissors);
        }

        [Test]
        public void ConvertInput_WithInvalidInputs_ThrowsArgumentException()
        {
            Assert.Throws(typeof(ArgumentException), new TestDelegate(() => RPSGame.ConvertInput("invalid")));
        }

        [Test]
        public void GetWinner_WithDrawGame_ReturnsDraw()
        {
            Assert.AreEqual(RPSGame.GetWinner(RPSGame.Choices.rock, RPSGame.Choices.rock), RPSGame.Winner.draw);
            Assert.AreEqual(RPSGame.GetWinner(RPSGame.Choices.paper, RPSGame.Choices.paper), RPSGame.Winner.draw);
            Assert.AreEqual(RPSGame.GetWinner(RPSGame.Choices.scissors, RPSGame.Choices.scissors), RPSGame.Winner.draw);
        }

        [Test]
        public void GetWinner_WithRockVsPaper_ReturnsPlayer2()
        {
