//src/LibGit2Sharp.Tests/AlternateObjectDatabaseFixture.cs
﻿using System;
using System.IO;
using LibGit2Sharp.Core;
using NUnit.Framework;

namespace LibGit2Sharp.Tests
{
    [TestFixture]
    public class AlternateObjectDatabaseFixture : BaseFixture
    {
        [Test]
        public void CanUseAlternateObjectDatabase()
        {
            const string readmeFile = "README";

            var dir = CloneRepository(TestRepository.Url.AbsoluteUri);
            var repoPaths = Repository.Discover(dir);

            using (var fixtureRepo = new Repository(repoPaths.WorkingDirectory))
            {
                using (var alternateRepo = new Repository(
                    Path.Combine(Environment.CurrentDirectory, "TestRepositories", "TestAlternateObjectDatabase"),
                    new RepositoryOptions
                    {
                        UseAlternateObjectDatabase = fixtureRepo.Info.Path
                    }))
                {
                    Assert.AreEqual(AlternateObjectDatabaseStatus.Enabled, alternateRepO.ObjectDatabase.AlternateObjectDatabaseStatus);

                    var commit = alternateRepo.Commits.GetCommit("8156d351208bb38634546fe36c241f82ab7b1ab1");
                    Assert.IsNotNull(commit);

                    var objectDatabase = ((LibGit2Sharp.Core.Repository) alternateRepo).ObjectDatabase;
                    var objectId = ObjectId.FromString("8156d351208bb38634546fe36c241f82ab7b1ab1");
                    var alternateObjectId = objectDatabase.ResolveAlternateObject(CommitFilter.ObjectIdToSha(objectId));

                    Assert.AreEqual(objectId.Sha, alternateObjectId.Sha);
                    Assert.AreEqual(ObjectKind.Commit, objectDatabase.FindObject(alternateObjectId, typeof (Commit).Guid));
                }
            }
        }
    }
}

