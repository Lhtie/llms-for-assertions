﻿using System;
using System.Linq;

namespace RockPaperScissors.Models
{
    public class RPSGame
    {
        public enum Choices { rock, paper, scissors };
        public enum Winner { player1, player2, draw };

        public static Choices ConvertInput(string input)
        {
            switch (input.ToLower())
            {
                case "rock":
                    return Choices.rock;
                case "paper":
                    return Choices.paper;
                case "scissors":
                    return Choices.scissors;
                default:
                    throw new ArgumentException();
            }
        }

        public static Winner GetWinner(Choices player1Choice, Choices player2Choice)
        {
            if (player1Choice == player2Choice)
                return Winner.draw;

            // Player 1 wins only if player 2 inputs an option
            // that is one position next in the enumerable (wrapping around) 
            // than player 1's choice. 
            if (((int)ChoicesHelper
                .ToList()
                .IndexOf(player2Choice) - (int)ChoicesHelper
                .ToList()
                .IndexOf(player1Choice)) % ChoicesHelper
                .ToList()
                .Count == 1)
            {
                return Winner.player2;
            }
            return Winner.player1;
        }
    }
}

