        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);

            Assert.IsTrue(arrList.Contains(1));
        }

        [TestMethod]
        public void Test_IndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
--------------------
        }

