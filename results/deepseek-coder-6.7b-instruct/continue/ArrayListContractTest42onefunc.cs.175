}//src/Npgsql.EntityFrameworkCore.PostgreSQL.Scaffolding/Internal/NpgsqlDatabaseModelFactory.cs
﻿using JetBrains.Annotations;
using Microsoft.EntityFrameworkCore.Design;
using Microsoft.EntityFrameworkCore.Scaffolding.Internal;
using Npgsql.EntityFrameworkCore.PostgreSQL.Scaffolding.Internal;

namespace Microsoft.EntityFrameworkCore.Scaffolding
{
    public class NpgsqlDatabaseModelFactory : IDatabaseModelFactory
    {
        public NpgsqlDatabaseModelFactory([NotNull] IRelationalTypeMappingSource typeMappingSource)
        {
            TypeMappingSource = typeMappingSource;
        }

        protected IRelationalTypeMappingSource TypeMappingSource { get; }

        public virtual DatabaseModel Create(string connectionString, string databaseProviderType, string modelNamespace)
        {
            var factory = new NpgsqlDesignTimeServicesBuilder()
                .TryAddSqlServer()
                .AddNpgsql()
                .BuildModelFactory();

            return factory.Create(connectionString, databaseProviderType, modelNamespace);
        }
    }
}

//test/Npgsql.EntityFrameworkCore.PostgreSQL.Scaffolding.Tests/NpgsqlCodeGenerationTests.cs
﻿using Microsoft.EntityFrameworkCore.Scaffolding;
using System;
using System.IO;
using System.Linq;
using Xunit;

namespace Npgsql.EntityFrameworkCore.PostgreSQL.Scaffolding.Tests
{
    public class NpgsqlCodeGenerationTests
    {
        private const string ConnectionString = "Host=localhost;Database=ScaffoldTest;Username=postgres;Password=postgres";
        private const string Namespace = "ScaffoldTestApp.Models";
        private const string ModelFolder = "_ModelFiles";

        [Fact]
        public void CanScaffoldModel()
        {
            // Arrange
            if (Directory.Exists(ModelFolder))
                Directory.Delete(ModelFolder, true);

            var scaffolder = new CodeGenerator(new NpgsqlDatabaseModelFactory(new NpgsqlRelationalTypeMappingSource()));

            // Act
            scaffolder.Scaffold(ConnectionString, Namespace, ModelFolder, null, DatabaseType.SqlServer);

            // Assert
            var files = Directory.EnumerateFiles(ModelFolder, "*");

            Assert.NotEmpty(files);
            Assert.True(files.Any(x => x.EndsWith("Context.cs", StringComparison.OrdinalIgnoreCase)));
        }
    }
}

