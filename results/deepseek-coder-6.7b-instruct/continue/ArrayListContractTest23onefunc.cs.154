using System;
using System.Collections;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using Xunit;

namespace ArrayList.Test
{
    public class NullableListTest
    {
        [Fact]
        [PexMethodUnderTest]
        public void TestAdd()
        {
            var list = new NullableList<int>();

            var oldCount = list.Count;
            list.Add(null);
            var newCount = list.Count;

            // Adding to a list increases its Count
            Assert.Equal(oldCount + 1, newCount);
        }

        [Fact]
        [PexMethodUnderTest]
        public void TestInsert()
        {
            var list = new NullableList<int>();
            list.Add(1);
            list.Add(2);

            var oldCount = list.Count;
            list.Insert(0, null);
            var newCount = list.Count;

            // Inserting into a list increases its Count
            Assert.Equal(oldCount + 1, newCount);
        }

        [Fact]
        [PexMethodUnderTest]
        public void TestIndexer()
        {
            var list = new NullableList<int>{1, 2, 3};

            list[0] = null;

            // Can insert null
            Assert.Equal(null, list[0]);
        }

        [Fact]
        [PexMethodUnderTest]
        public void TestRemove()
        {
            var list = new NullableList<int>{1, 2, 3};
            list[1] = null;    // remove 2

            var removed = list.Remove(2);

            // Can remove specific item
            Assert.True(removed);
            Assert.Equal(2, list.Count);
        }

        [Fact]
        [PexMethodUnderTest]
        public void TestContains()
        {
            var list = new NullableList<int>{1, 2, null};

            // Can check if list contains null
            Assert.True(list.Contains(null));
        }
    }
}

