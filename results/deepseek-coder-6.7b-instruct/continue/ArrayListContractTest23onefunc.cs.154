        [PexMethod]
        public void PUT_Insert([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid] int index, [PexAssumeValid] int element)
        {
            // make assumptions on the array list object
            AssumePrecondition.IsTrue(!(arrList is null));
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
            AssumePrecondition.IsTrue(element != 0);

            // Remember original state
            int count = arrList.Count;

            // call method to be tested
            arrList.Insert(index, element);

            // Remember new state
            int newCount = arrList.Count;
          
            // Assertions
            Assert.IsTrue(newCount == (count + 1));
            Assert.IsTrue(arrList.Contains(element));
            Assert.IsTrue(arrList.IndexOf(element) == index);
        }
    }
}
```

```csharp
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_RemoveAt([PexAssumeValid] ArrayList arrList, [PexAssumeValid] int index)
        {
            // make assumptions on the ArrayList object
            AssumePrecondition.IsTrue(!(arrList is null));
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);
            AssumePrecondition.IsTrue(arrList[index] != 0);

            // Remember original state
            int oldListCount = arrList.Count;
            int oldElement = (int)arrList[index];

            // call method to be tested
            arrList.RemoveAt(index);

            // Remember new state
            int newListCount = arrList.Count;

            // Assertions
            Assert.IsTrue(newListCount == (oldListCount - 1));
            Assert.IsFalse(arrList.Contains(oldElement));
        }

        [PexMethod]
        public void PUT_Remove([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid] object element)
        {
            // make assumptions on the ArrayList object
            AssumePrecondition.IsTrue(!(arrList is null));
            AssumePrecondition.IsTrue(element != null);

            // Remember original state
            int oldListCount = arrList.Count;

            // call method to be tested
            arrList.Remove(element);

            // Remember new state
            int newListCount = arrList.Count;

            // Assertions
            Assert.IsTrue(newListCount == (oldListCount - 1));
            Assert.IsFalse(arrList.Contains(element));
        }
    }
}
```

有关详细信息，请参阅以下列表：

- PexMethod：标记了一个方法，可以由 Pex 自动生成测试。方法的每个参数都将被视为“可探索的”。

- PexAssumeUnderTest：指定一个方法被认为它是正在测试的代码的一部分。它将被考虑在代码覆盖率中。

- PexAssumeValid：标记一个参数是有效的。因此，Pex 将仅测试使用此参数的方法。

- AssumePrecondition：类似于 Assert.AreEqual 但提供了一个更强的形式。它验证给定的值是否为 true。

- PexObserve：用于查看测试过程中的值。

- Assert：用于验证。它断言给定的条件返回 true。

- Assume：类似于 Assert.AreEqual 但提供了一个更强的形式。它验证给定的值是否为 true。

- PexMethodAttribute：标记了一个方法，可以由 Pex 自动生成测试。方法的每个参数都将被视为“可探索的”。

- Observe：用于查看测试过程中的值。

- [PexObserve]：用于查看测试过程中的值。

- [PexMethod]：将方法标记为 Pex 可生成的单元测试，任何传递给该方法的参数都将进行可测试的探索。

