﻿using System;
using System.IO;
using System.Text.RegularExpressions;

namespace RegexTest
{
    class Program
    {
        static void Main(string[] args)
        {
            string input = File.ReadAllText("data.txt"); // reading input file

            string pattern1 = @"(\b[A-Z][a-z]*\b)";   // pattern to extract names
            string pattern2 = @"(\b(?:\d{1,3}\.){3}\d{1,3}\b)"; // pattern to extract IP addresses
            string pattern3 = @"(\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b)"; // pattern to extract emails

            MatchCollection names = Regex.Matches(input, pattern1); // match names
            MatchCollection IPs = Regex.Matches(input, pattern2);  // match IP's
            MatchCollection emails = Regex.Matches(input, pattern3); // match emails

            Console.WriteLine("Names found: ");
            foreach (var name in names) { Console.WriteLine(name); }

            Console.WriteLine("\nIP addresses found: ");
            foreach (var IP in IPs) { Console.WriteLine(IP); }

            Console.WriteLine("\nEmail addresses found: ");
            foreach (var email in emails) { Console.WriteLine(email); }

            Console.ReadKey(); // pause to see output until key pressed
        }
    }
}

//RegexTest/RegexTestTest/UnitTest1.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections.Generic;
using System.Text.RegularExpressions;
using RegexTest;

namespace RegexTestTest
{
    [TestClass]
    public class UnitTest1
    {
        [TestMethod]
        public void ExtractNamesTest()
        {
            string input = "Mr. Srinivasa Adikalam, MS, Ph.D., is a professor in the IIT Bombay.";
            string pattern1 = @"(\b[A-Z][a-z]*\b)";   // pattern to extract names
            MatchCollection matches = Regex.Matches(input, pattern1); // match names

            List<string> output = new List<string>();
            foreach (Match match in matches)
            {
                output.Add(match.Value);
            }

            CollectionAssert.Contains(output, "Srinivasa");
            CollectionAssert.Contains(output, "Adikalam");
            CollectionAssert.DoesNotContain(output, "Mr.");
            CollectionAssert.DoesNotContain(output, "Ph.D.");

        }

        [TestMethod]
        public void ExtractIPsTest()
        {
            string input = "My IP address is 192.168.1.1";
            string pattern2 = @"(\b(?:\d{1,3}\.){3}\d{1,3}\b)"; // pattern to extract IP addresses
            MatchCollection matches = Regex.Matches(input, pattern2); // match IP's

            List<string> output = new List<string>();
            foreach (Match match in matches)
            {
                output.Add(match.Value);
            }

            CollectionAssert.Contains(output, "192.168.1.1");

        }

