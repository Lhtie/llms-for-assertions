}﻿using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Door : MonoBehaviour
{
    public Vector3 direction;
    public float openSpeed = 2f;
    public float closeSpeed = 2f;
    public bool open = false;
    public bool close = false;
    private Vector3 startPos;
    private Vector3 endPos;

    void Start()
    {
        startPos = transform.position;
        endPos = transform.position + direction;
    }

    // Update is called once per frame
    void Update()
    {
        if (open)
        {
            transform.position = Vector3.Lerp(transform.position, endPos, openSpeed * Time.deltaTime);
        }

        if (close)
        {
            transform.position = Vector3.Lerp(transform.position, startPos, closeSpeed * Time.deltaTime);
        }
    }
}using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class LightManager : MonoBehaviour
{
    public GameObject blueLight;
    public GameObject redLight;
    public float timeUntilFlip = 3f;
    private float timer = 0f;
    public bool red = false;


    // Start is called before the first frame update
    void Start()
    {
        blueLight.SetActive(true);
        redLight.SetActive(false);
    }

    // Update is called once per frame
    void Update()
    {
        timer += Time.deltaTime;

        if(timer >= timeUntilFlip && !red)
        {
            blueLight.SetActive(false);
            redLight.SetActive(true);
            red = true;
            timer = 0f;
        }

        if (timer >= timeUntilFlip && red)
        {
            blueLight.SetActive(true);
            redLight.SetActive(false);
            red = false;
            timer = 0f;
        }
    }
}using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class LevelStartPulse : MonoBehaviour
{
    public float speed;
    public double amplitude;
    Vector3 tempPos;
    float xPos;
    public float timer;
    public float endTime;
    private float timeCounter;
    // Start is called before the first frame update
    void Start()
    {
        tempPos = transform.position;
        xPos = tempPos.x;
    }

    // Update is called once per frame
    void Update()
    {
        timeCounter += Time.deltaTime;
        tempPos.y = Mathf.Sin(timeCounter * speed) * amplitude + tempPos.y;
        transform.position = tempPos;
        if (timeCounter >= endTime)
            transform.position = Vector3.MoveTowards(transform.position, new Vector3(xPos, 0, 0), 1f);
    }
