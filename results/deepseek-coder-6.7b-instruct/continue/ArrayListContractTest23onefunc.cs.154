            Assert.IsTrue(New_arrListIndexOfX >= Old_index);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListCount is equal to Old_arrListCount plus one
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListContainsX is true
            Assert.IsTrue(New_arrListContainsX);
        }

        [Fact]
        [PexMethodUnderTest]
        public void TestInsert()
        {
            PexRunner.Run(@"ArrayList\Test\ArrayListContractTest.PUT_InsertContract");
        }
    }
}

