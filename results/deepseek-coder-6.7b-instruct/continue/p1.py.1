def verify_signature(signature, data, shared_secret):
    hash = hmac.new(key=bytes(shared_secret, 'utf-8'), msg=data, digestmod='sha1')
    return signature == 'sha1=' + base64.b64encode(hash.digest()).decode('utf-8')


