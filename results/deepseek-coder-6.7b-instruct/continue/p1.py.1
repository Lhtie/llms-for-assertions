def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.push_back(inp)
    # an assertion that  sum of all pairs of differences between terms in the array is atmost 1
    max_diff = max(p43_coeffs)
    min_diff = min(p43_coeffs)
    diff_sum = max_diff - min_diff
    assert diff_sum <= 1

