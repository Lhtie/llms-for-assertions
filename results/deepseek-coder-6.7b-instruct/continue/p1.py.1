def khan_algorithm(course_schedule, prerequisites):
    graph = [[] for _ in range(course_schedule)]
    in_degree = [0] * course_schedule
    topsort_order = []
    queue = LinkedList()

    for pair in prerequisites:
        parent, child = pair[1], pair[0]
        graph[parent].append(child)
        in_degree[child] += 1

    for i in range(course_schedule):
        if in_degree[i] == 0:
            queue.append(LinkedList.Node(i))

    while queue.head is not None:
        node = queue.head
        queue.head = node.next
        topsort_order.append(node.value)

        for child in graph[node.value]:
            in_degree[child] -= 1

            if in_degree[child] == 0:
                queue.append(LinkedList.Node(child))

    return len(topsort_order) == course_schedule, topsort_order


