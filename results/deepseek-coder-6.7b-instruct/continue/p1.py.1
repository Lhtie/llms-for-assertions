    else:
        pivot = nlist[0]
        less_than_pivot = [x for x in nlist[1:] if x <= pivot]
        greater_than_pivot = [x for x in nlist[1:] if x > pivot]
        return quick_sort(less_than_pivot) + [pivot] + quick_sort(greater_than_pivot)

