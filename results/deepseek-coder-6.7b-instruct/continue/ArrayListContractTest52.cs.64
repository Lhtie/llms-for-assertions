//Programming/Object-Oriented Programming/Projects/Pex API Wrapper Project/UnitTestPexExamples/ArrayList.Test/ArrayListTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    // [TestFixture]
    public class ArrayListTest
    {
        [PexMethod]
        public int PUT_AddTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;

            AssumePrecondition.IsTrue((Old_arrListCount + 1) == New_arrListCount);

            return New_Ret;
        }

        [PexMethod]
        public void PUT_RemoveTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;

            bool b = arrList.Remove(x);

            int New_arrListCount = arrList.Count;

            AssumePrecondition.IsTrue(Old_arrListCount >= New_arrListCount && !arrList.Contains(x));

            AssumePrecondition.IsTrue(!b || Old_arrListCount == New_arrListCount);
        }

        [PexMethod]
        public void PUT_InsertTest([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);

            int Old_arrListCount = arrList.Count;

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;

            AssumePrecondition.IsTrue(Old_arrListCount + 1 == New_arrListCount);

            AssumePrecondition.IsTrue(arrList.Contains(x));
        }

        [PexMethod]
        public void PUT_SetTest([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            arrList[index] = x;

            AssumePrecondition.IsTrue(arrList.Contains(x));
        }

        [PexMethod]
        public int PUT_GetTest([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int ret = (int)(arrList[index]);

            AssumePrecondition.IsTrue(arrList.Contains(ret));

            return ret;
        }

        [PexMethod]
        public bool PUT_ContainsTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            bool ret = arrList.Contains(x);

            // Only if x exists, ret should be true, else false

            return ret;
        }
    }
}

