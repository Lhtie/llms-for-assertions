//ArrayList/ArrayListContract.Test/ArrayListContract.cs
using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        // Tests for Add method
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // Precondition
            int countBeforeAdd = arrList.Count;

            // Invoke the method we are analyzing
            arrList.Add(x);

            // Post Condition(s)
            int countAfterAdd = arrList.Count;

            AssumePrecondition.IsTrue(countBeforeAdd + 1 == countAfterAdd);
            AssumePrecondition.IsTrue(arrList.Contains(x));
            
        }

        // Tests for Remove method
        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // Precondition
            AssumePrecondition.IsTrue(arrList.Contains(x));
            int countBeforeRemove = arrList.Count;

            // Invoke the method we are analyzing
            arrList.Remove(x);

            // Post Condition(s)
            int countAfterRemove = arrList.Count;

            AssumePrecondition.IsTrue(countBeforeRemove == countAfterRemove + 1);
            AssumePrecondition.IsFalse(arrList.Contains(x));
            
        }

        // Tests for IndexOf method
        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // Invoke the method we are analyzing
            int index = arrList.IndexOf(x);

            // Post Condition(s)
            AssumePrecondition.IsTrue(index < 0 || arrList[index].Equals(x));
            
        }

//... other similar test methods
    }
}

