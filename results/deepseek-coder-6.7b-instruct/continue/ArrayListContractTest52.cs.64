        // Preexisting test case to make sure our custom ArrayListWrapper is constructed properly
        [PexMethod]
        public void TestArrayListWrapperCreation([PexAssumeUnderTest]int[] initialCollection)
        {
            var arrList = new ArrayListWrapper(initialCollection);

            // Making sure all element in initial collection exist in ArrayListWrapper
            foreach(var elem in initialCollection){
                Assert.IsTrue(arrList.Contains(elem));
            }

            // Making sure the size matches
            Assert.AreEqual(initialCollection.Length, arrList.Count);
        }

        
//... other test cases
    }
}

