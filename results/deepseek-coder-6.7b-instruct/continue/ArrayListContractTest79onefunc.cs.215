//PexTest/Program.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.Pex.Samples.Arrays;

namespace PexTest
{
    class Program
    {
        static void Main(string[] args)
        {
            var sample = new ArrayListContractTest();
            sample.PUT_IndexOfContract();
        }
    }
}

//PexTest/Reproductions/ArrayListProduction.cs
﻿using System;
using System.Collections;

namespace PexTest.Reproductions
{
    public class ArrayListProduction
    {
        ArrayList arrList = new ArrayList();

        public int IndexOf(int value)
        {
            try
            {
                return arrList.IndexOf(value);
            }
            catch (Exception)
            {
                return -1;
            }
        }

        public int Count()
        {
            try
            {
                return arrList.Count;
            }
            catch (Exception)
            {
                return -1;
            }
        }

        public void Add(int value)
        {
            try
            {
                arrList.Add(value);
            }
            catch (Exception)
            {
                //Do Nothing
            }
        }

        public bool Contains(int value)
        {
            try
            {
                return arrList.Contains(value);
            }
            catch (Exception)
            {
                return false;
            }
        }
    }
}

//PexTest/ArrayListContractTest.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.Pex;
using Microsoft.VisualStudio.TestTools.Pex.Samples.Arrays;
using NUnit.Framework;
using PexTest.Reproductions;

namespace PexTest
{
    [TestFixture]
    public class ArrayListContractTest
    {
        private ArrayListProduction arrListInstance;

        [SetUp]
        public void SetUp()
        {
            arrListInstance = new ArrayListProduction();
        }

        [PexMethod]
        public void PUT_IndexOf_Int32(int value)
        {
            int result = arrListInstance.IndexOf(value);

            if (result >= 0)
            {
                Assert.IsTrue(arrListInstance.Contains(value));
                Assert.AreEqual(value, arrListInstance.IndexOf(value));
            }
            else
            {
                Assert.IsFalse(arrListInstance.Contains(value));
            }
        }

        [PexMethod]
        public void PUT_Add_Int32(int value)
        {
            int count = arrListInstance.Count();
            arrListInstance.Add(value);

            Assert.Greater(arrListInstance.Count(), count);
            Assert.IsTrue(arrListInstance.Contains(value));
        }
    }
}

