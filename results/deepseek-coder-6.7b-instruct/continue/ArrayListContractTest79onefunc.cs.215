﻿using Microsoft.VisualStudio.TestTools.UnitTesting;
using PexTest;
using PexTest.Reproductions;

namespace UnitTests.ArrayListTests
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void TestMethod1()
        {
            var test = new ArrayListProduction();
            test.Add(1);
            Assert.AreEqual(1, test.Count());
        }
    }
