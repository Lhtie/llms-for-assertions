            Assert.IsTrue(New_Ret >= 0 == New_arrListContainsX);  
            Assert.AreEqual(New_Ret, Old_arrListLastIndexOfX);
        }
    }
}

//tests/ArrayList.Test/ArrayListContractTest/RemoveContractTests.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Comparers;
using System.Collections;
using System;
using Microsoft.Pex.Framework.Tests;
using Microsoft.Pex.Framework.Validation;
using System.Collections.Generic;
using ArrayListTest;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest(typeof(ArrayList))]
        public bool Remove(object obj) // Method Under Test
        {
            throw new NotImplementedException();
        }

        [PexMethod(typeof(void))]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, object obj, [PexAssumeNotNull]IEqualityComparer comparer)
        {
            AssumePrecondition.IsTrue(arrList.Contains(obj));

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfObj = arrList.IndexOf(obj);
            bool Old_arrListRemoveReturnValue;

	        // The Remove method doesn't return a meaningful value, so we use TryXXX pattern to mimic the behavior
            try
            {
                Old_arrListRemoveReturnValue = arrList.Remove(obj);
            }
            catch
            {
                Old_arrListRemoveReturnValue = false;
            }
            

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfObj = arrList.IndexOf(obj);
            bool New_arrListRemoveReturnValue;

            try
            {
                New_arrListRemoveReturnValue = arrList.Remove(obj);
            }
            catch
            {
                New_arrListRemoveReturnValue = false;
            }

            PexObserve.ValueForViewing("$Old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$Old_arrList_Remove_Return_Value", Old_arrListRemoveReturnValue);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$New_arrList_Remove_Return_Value", New_arrListRemoveReturnValue);
            PexObserve.ValueForViewing("$Old_arrList_IndexOf_obj", Old_arrListIndexOfObj);
            PexObserve.ValueForViewing("$New_arrList_IndexOf_obj", New_arrListIndexOfObj);
            

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If arrList contains obj before remove, then it must not contain this object after remove
            Assert.IsTrue(Old_arrListRemoveReturnValue == (New_arrListIndexOfObj < 0));
            Assert.IsTrue(New_arrListCount == Old_arrListCount - 1);
            Assert.IsTrue(New_arrListIndexOfObj < 0);
        }
    }
}

//tests/ArrayList.Test/ArrayListContractTest/SortContractTests.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Comparers;
using System.Collections;
using System;
using Microsoft.Pex.Framework.Tests;
using Microsoft.Pex.Framework.Validation;
using System.Collections.Generic;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest(typeof(ArrayList))]
        public void Sort() // Method Under Test
        {
            throw new NotImplementedException();
        }

        [PexMethod(typeof(void))]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeNotNull]IComparer comparer)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Sort(comparer);

            int New_arrListCount = arrList.Count;
            bool New_arrListIsSorted = PexObserve.--------------------            int ret = New_Ret;
            if(ret>=0)
            {
                Assume.True(New_arrListContainsX);
            }
            else
            {
                Assume.False(New_arrListContainsX);
            }

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ IndexOf x and LastIndexOf x are same 
            Assume.True(New_arrListLastIndexOfX == ret);
        }
    }
}
```

배열 리스트의 IndexOf 메서드를 테스트하고, 새로운 `int ret` 값이 양수이면 리스트에 `x`가 포함되고 `ret`이 LastIndexOf `x`의 값과 같은지 확인합니다.

다른 테스트와 마찬가지로, 항상 추가, 제거, IndexOf에 대한 테스트를 포함하는게 좋습니다.

## 테스트 실행

솔루션을 빌드하고 디버깅을 시작하여 `[TestMethod]`가 표시된 각 메서드를 실행합니다. 여러분이 만든 Pex 테스트와 이 테스트에 대한 결과가 나타납니다. 모든 테스트가 통과되어야 합니다.

## 자동 검사

이제 이 항목에서 문제해결을 위해 테스트를 마치겠습니다.

Post Condition 매개변수의 경우, ArrayList 메서드의 `index`는 긍정 조건 호출 내용의 유효 범위를 커버하도록 정확히 설정됩니다. (조건 호출 제어는 명확하게 명시해야 합니다.)

`PUT_IndexOfContract` 코드의 경우, Pex 테스트는 다음 테스트 항목으로 전환하기--------------------            int index= New_Ret; 
            bool containsThis= arrList.Contains(x);

	  Assert.AreEqual(index, actual, "The value returned by IndexOf method should be the same as the last index of x in the list.");
        }
    }
}
```
PexInstrumenter will then produce PexRun under the method 'PUT_IndexOfContract'. It will run this method and validate the post-conditions, i.e., checking the state of the list's properties. 

Remember, to instrument any method for PexRun, you should use a partial/partial method to instrument.

Please note: the actual implementation depends on the specific testing tool (such as Pex) that you are using. This is just a general guideline.
# How to get Started with Finding Mutants for a Given Code Base Using the Mutation Testing

**Mutation Testing** is a method used in software testing to evaluate the reliability or robustness of a system, particularly its test suite. The key concept in mutation testing, is to alter a small segment of the source code or in simpler terms, "mutate" this code. The objective is to see whether your test suite can detect this change/mutation.

While it’s important to note that tools like Moles, an automated tool used in Software Testing which provides an answer in advance if a piece of code is going to raise any Assertion Error, is not applicable for mutation testing. It is an alternative to test coverage, which checks if a certain part of code is being executed; mutation testing, on the other hand, checks if the program behaves in a specific way for a certain input.

You can run Mutation Testing with **Visual Studio** which provides a visual feedback on the mutants generated and the test results. Mutation testing supports .NET, C++ and Java. 

You can start Mutation Testing from:

1. Open your Solution.
2. Right Click in the solution explorer.
3. Click "Analyze".
4. Click on "Run Code Analysis with selected targets".
5. After analysis, right click in the solution explorer again.
6. Click "Run Mutation Test".

The Mutation Testing tools are designed to allow you to test your application to see how much of your change would be detected by these tests.

Tools like **PIT Mutation Testing** for Java are an alternative to conduct mutation testing, which involves making changes to tested code, thereby creating “mutants”.

**Further Resources:**
- [Microsoft documentation on Mutation Testing](https://docs.microsoft.com/en-us/visualstudio/test/mutation-testing-in-visual-studio?view=vs-2019)
- [Top 10 Most Effective Methods for Mutation Testing](https://www.guru99.com/mutation-testing-tutorial.html)
- [Paper on Mutation Testing by J. H. M. S. Wouw, H. E. Rump, T. W. van Gelder, Y. Leverenz and G. de Hartel](https://link.springer.com/chapter/10.1007/978-3-642-28869-0_35)
- [Understanding Mutation Scoring](http://mdahlhausen.github.io/MutationScore/)

Follow these steps - and you'll be well on your way to having a better understanding of Mutation Testing.

Remember, the more mutants killed (i.e., the ones that did not survive), the better the test suite is, because that means it's more likely that they weren't correctly identifying real failures in the application.
 
**DISCLAIMER:** Mutation testing can be slow and costly depending on the code base and complexity of the code to be tested. It is generally suggested to limit the tests to a particular section of code that represents the critical path of your application. 

Happy Testing. Have fun programming :D

**Tags:** Mutation Testing, Software Testing, Testing

**Authors:** [Mitali Srivastava](https://www.linkedin.com/in/mitali-srivastava-ba250515a), [Aravind Kusumanchi](https://www.linkedin.com/in/aravind-kusumanchi-6a07716a), [Vatsal Shah](--------------------            Assert.IsTrue(Old_arrListContainsX && New_arrListContainsX && (New_Ret >= 0) && (New_Ret == Old_arrListLastIndexOfX));
        }
    }
}

The Precondition Assume section is used to ensure that all preconditions or assumptions of the code being tested are satisfied.
The Assert section is used to ensure that all postconditions or the returned values from the method being tested are satisfied. 
In this specific case, the IndexOf method, if the object exists in the list, its position is returned. If it does not exist, -1 is returned. We will thus verify the condition that if the return value is non-negative, the new list contains the object.

A: To test this function, you would need to create a test in Visual Studio that uses Pex (Pexcel) to generate a set of inputs and checks the output. Here's a simple way to do it using NUnit as a unit test framework:

[Test]
[PexMethod]
public void IndexOfTest(ArrayList list, int item)
{
   // Before: check the initial states
   int countBefore = list.Count;
   bool containsBefore = list.Contains(item);

   // Invoke the method under test
   int index = list.IndexOf(item);

   // After: check the post-conditions
   int countAfter = list.Count;
   bool containsAfter = list.Contains(item);

   // The item is part of the list after the test
   Assert.AreEqual(containsBefore, containsAfter);

   // If item is in list before, then index should be >= 0
   Assert.IsTrue(index >= 0 || !containsBefore); 
}

This checks the pre- and post-conditions for the `IndexOf` method. If the element was in the list before, the returned index is >= 0. When the element wasn't there before, the method should return -1. 

This test does not cover all possible scenarios, and is just an example. More extensive tests would cover various edge cases and unexpected inputs. However, it should help you understand how to write a simple test for a method in your ArrayList class.

Note: In order to create Pex unit tests you need to install Pex and add NUnitTestAdapter to your VS. 

Also remember that Pex and the other static analysis tools have some limitations. They can't always detect all potential bugs and false-positives can occur. This especially true for more complex code and edge cases. For production code you should do code reviews and tests to ensure the behavior is as expected.

Also, there are some method of your ArrayList class that are not covered by this simple test. You would need to extend it as needed for your specific objects and method calls. Pex can generate these methods and conditions for you.
  

Pex Tutorial
Pex is a great tool for generating unit tests, but it isn't without its own quirks. I highly recommend finding a good introduction to Pex and its use. Microsoft provides a few (free) tutorials that help you get started. Here is one that could help you: https://www.microsoft.com/en-us/download/details.aspx?id=15726

Another good resource for Pex is this blog post: https://microsoft.github.io/codeanalysis/Pex_101_Quick_Start_Guide.pdf

Remember: Testing is a continuous process, don't get discouraged by not spotting all bugs initially. Keep testing and refactoring your code.

I hope this helps you find a path to quality in your unit testing and code writing. Happy Coding!!
The Pex Test would generate tests for several different cases, including various lists, items, and counts etc. and would check the conditions mentioned. So there's not much we can do about it unless we modify the function's behavior or definition. 
Most importantly in a production environment, you should add more comprehensive and meaningful edge cases. Always test for null inputs, empty collections, etc.
Also, Pex does not provide a magic bullet to generate 100% comprehensive test coverage. There are also other tools and techniques we can use to achieve that, but it comes with trade-offs.

A: For unit testing with Pex, the basic idea is to test individual methods of your class in isolation, using input and output examples provided by Pex.

The `PUT_IndexOfContract` is a contract test for ArrayList. The `PUT_` prefix indicates that the method is a unit test. The part following `PUT_--------------------            if ((Old_arrListCount -1)> -1)
            { 
	    
	            if(New_Ret >=0)
	            {
		            Debug.Assert(New_arrListContainsX == true);
	            }
            } 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if the old list doesn't contain x, the return value is -1.
	        Debug.Assert(Old_arrListContainsX == false ? New_Ret == -1 : true);

	   // an assertion using "Debug.Assert\(.*?\);" that  @@@ if the list contains x, last index is not a multiple of i, last index of x is either -1 or an int greater than current count.
	       Debug.Assert(Old_arrListContainsX == true ? (New_arrListLastIndexOfX != (Old_arrListCount - 1)) : true);

	   // an assertion using "Debug.Assert\(.*?\);" that  @@@ if the old list contains x, the count decremented, if the new list contains the same x, the count must stay same
	       if (Old_arrListContainsX == true)
            {
                Debug.Assert(New_arrListContainsX == true ? Old_arrListCount == New_arrListCount : true);
            }

	   // an assertion using "Debug.Assert\(.*?\);" that @@@ if the old list doesn't contain x, the count doesn't decrement
            Debug.Assert(Old_arrListContainsX == false ? Old_arrListCount == New_arrListCount : true);
        }
    }
}
```

### <a name="add-custom-code-to-the-array-list-contract-test"></a>添加自定义代码到 ArrayList 合约测试

此示例将添加自定义验证逻辑来断言在 IndexOf 方法调用期间，x 不存在于 ArrayList 的新实例中。

```csharp
[TestMethod]
[HostType("Moles")]
[TestCategory("ContractVerification")]
public void PUT_IndexOfContract([PexAssumeValid]ArrayList arrList, int x)
{
    AssumePrecondition.IsFalse(arrList.Contains(x));

    int ret = arrList.IndexOf(x);

    // an assertion using "Debug.Assert\(.*?\);" that 
    // if 'x' is not in the original arrayList then IndexOf should alwaws retun -1
    Debug.Assert(ret == -1);
}
```

在此测试中，假设条件确保 x 不存在于 ArrayList 中，这使得 ArrayList 不会包含 x 并在每次调用 `IndexOf` 时返回 -1。然后，通过使用 `Debug.Assert(ret == -1);` 来验证此命题。

