cat << EOF > ${HOME}/.p/11_2_1_1/source.cs
using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod] // The Pex method
        public void RemoveAtContract([PexAssumeValid]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            object Old_arrListItemAtIndex = index < arrList.Count ? arrList[index] : null;
 
            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
 
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_ItemAtIndex", Old_arrListItemAtIndex);
            PexObserve.ValueForViewing("$index", index);

            // an assertion using "Debug.Assert\(.*?\);" that 
	    Debug.Assert(
                  Old_arrListCount - 1 == New_arrListCount,
		     string.Format("The count of the array list decreased by one. Old: {0}, New {1}",
                     Old_arrListCount, New_arrListCount));

	    Debug.Assert(
                 !arrList.Contains(Old_arrListItemAtIndex),
		     string.Format("After removal, array list should not contain element at index. Removed: {0}", Old_arrListItemAtIndex));

    	    Debug.Assert(
                 index >= New_arrListCount && index < Old_arrListCount,
		     string.Format("Post conditions violated. The removed index is within new and old count. New: {0}, Old: {1}, Removed Index: {2}",
                    New_arrListCount, Old_arrListCount, index));

	}
    }
}
EOF

echo 'Generating test cases...'
timeout 11s mono ${HOME}/.p/bin/pex.exe -no-static-methods -filter=ArrayList.Test.ArrayListContractTest ${HOME}/.p/11_2_1_1/source.cs
timeout 11s mono ${HOME}/.p/bin/pex.exe -no-static-methods -filter=ArrayList.Test.ArrayListContractTest ${HOME}/.p/11_2_1_1/source.cs

