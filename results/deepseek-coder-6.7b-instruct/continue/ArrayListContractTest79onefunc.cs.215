            {
                Assert.IsTrue(New_Ret >= 0 && New_arrListContainsX);
            }
	        // else it should be -1 and new list should not contain x
            else
            {
                Assert.IsTrue(New_Ret == -1 && !New_arrListContainsX);
            }
                
            // an assertion using "Debug.Assert\(.*?\);" that if x is added to old count, new count is old count + 1.
            Assert.AreEqual(Old_arrListCount, New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that the last returned index from the last index of x is not greater than the count.
            Assert.IsTrue(New_arrListLastIndexOfX <= New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that the last returned index does not exceed the old list count.
            Assert.IsTrue(New_Ret <= Old_arrListCount);
