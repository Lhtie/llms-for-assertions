﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System;
using System.Collections;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.InvalidOperationException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.IndexOutOfRangeException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.TypeInitializationException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.ComponentModel.InvalidEnumArgumentException", AllowDerived = true)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException", AllowDerived = true)]
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest]
        [PexExplore]
        public void ExploreTest(ArrayList arrList)
        {
            PexObserve.ValueForViewing("$explore_arrList", arrList);
        }

        [PexMethodUnderTest]
        [PexExplore]
        public void ExploreRemoveTest(ArrayList arrList, object obj)
        {
            PexObserve.ValueForViewing("$explore_arrList", arrList);

            if (obj == null)
            {
                arrList.Remove(null);
            }
            else
            {
                arrList.Remove(obj);
            }
        }
    }
}

