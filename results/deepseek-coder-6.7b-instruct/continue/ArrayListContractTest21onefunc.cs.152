[PexMethod]
[PexCategory("Remove")]
public void TestRemove(
      [PexAssumeValid] List<int> list,
      [PexAssumeValid] int value,
      [PexReturnsUnderTest]ArrayList arrayList,
      [PexIgnore] out bool containsValue){

Assume.That(list.Contains(value)); // ensures that the list contains the value
Assume.That(arrayList.Count==list.Count); // ensures that initial ArrayList count is same as list count
arrayList = new ArrayList(list); // Initialize the arrayList with the list data

arrayList.Remove(value); // Removal operation

containsValue= arrayList.Contains(value); // Checks whether the value exists in the list after removal

Assert.AreEqual(list.Count - 1, arrayList.Count); // Checks whether the count of ArrayList is reduced by 1
Assert.IsFalse(containsValue); // Checks whether the value exists in the ArrayList

