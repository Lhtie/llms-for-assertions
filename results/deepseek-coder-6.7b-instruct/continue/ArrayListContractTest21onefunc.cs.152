            Debug.Assert(New_arrListIndexOfX >= -1);
            
            // an assertion using "Debug.Assert\(.*?\);" that @@@ arrList.count is eq old.arrList.count minus 1
	    Debug.Assert(New_arrListCount == Old_arrListCount - 1);
	    
            // an assertion using "Debug.Assert\(.*?\);" that if x exists in arrList then @@@ index of x in new array is geq old.index 
	    Debug.Assert(!Old_arrListContainsX || New_arrListIndexOfX >= Old_arrListIndexOfX);
	    
            // an assertion using "Debug.Assert\(.*?\);" that if x exists in arrList then @@@ last index of x in new array is leq old.last_index 
	    Debug.Assert(!Old_arrListContainsX || New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
	    
            // an assertion using "Debug.Assert\(.*?\);" that @@@ arrList contains x is fals
	    Debug.Assert(!New_arrListContainsX);
        }
    }
}

I hope you find this useful. Please let me know if you have more questions.

A: I assume you are trying to test ArrayList's Remove(object) method. 
Here is one way to do it using NUnit & Pex:
[Test]
[PexMethod]
public void TestRemove(
    [PexAssumeValid]List<int> list,
    [PexAssumeValid]int element, 
    [PexReturnsUnderTest]ArrayList arrayList, 
    [PexIgnore] out bool containsRemovedElement)
{
    Assume.That(list.Contains(element));
    Assume.That(arrayList.Count == list.Count);
    arrayList = new ArrayList(list);

    arrayList.Remove(element);
    containsRemovedElement = arrayList.Contains(element);

    Assert.AreEqual(list.Count - 1, arrayList.Count);
    Assert.IsFalse(containsRemovedElement);
    PexObserve.ValueForViewing("Removed element", element);
    PexObserve.ValueForViewing("ArrayList after removal", arrayList);
}

In this test, the Pex runs different permutations of the test cases, with PexAssumeValid attributes for the test parameters to make them valid under Pex concolic tests. The test method is marked as PexMethod, Pex runs it. 
PexIgnore attribute is used on the "containsRemovedElement" parameter to prevent Pex from exploring it. 
PexConsiderValues and PexAllValues attributes are used on the "list" parameter to consider some values during the concolic exploration. 
Asserts are used to check if the remove operation as expected.
The PexObserve.ValueForViewing method is used to add additional values or data to the exploration coverage.
The assumption is that the 'list' parameter originally contains the element to be removed. The arrayList parameter is designed to be in a valid state at the beginning of the test, and Pex is expected to try different values for this parameter.
Let me know, if you need more details.

