}using System;
using System.Collections.Generic;

namespace ArrayList.Test
{
    public class ListContractTest
    {
        static Random rnd = new Random();

        public static void AddContract<T>(List<T> list)
        {
            T value = default(T);
            int oldCount = list.Count;
            
            list.Add(value);
            
            Assume.True(list.Count == oldCount + 1);
        }

        public static void RemoveContract<T>(List<T> list)
        {
            if (list.Count > 0){
                T value = list[rnd.Next(0, list.Count)];
                int oldCount = list.Count;

                list.Remove(value);
                
                Assume.True(list.Count == oldCount - 1);
            }
        }

        public static void IndexOfContract<T>(List<T> list)
        {
            if (list.Count > 0){
                T value = list[rnd.Next(0, list.Count)];

                int index = list.IndexOf(value);
                
                Assume.True(index >= 0 && index < list.Count);
            }
        }
    }
