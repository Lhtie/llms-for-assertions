------------------------------------------------------------            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListIndexOfX); 
----------------------------------------  // count of arrayList after action should be greater by 1
            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListIndexOfX && New_arrListLastIndexOfX - Old_arrListIndexOfX == 1);

            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);

