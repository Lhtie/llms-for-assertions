<jupyter_code>
import numpy.linalg as la

# We represent webpages as nodes in a network and 
# a directed link from page i to page j as an edge 
# from node i to node j. Each row represents the 
# number of outgoing links from a page to other pages. 

M = np.array([[0,0,0,0,1],
              [0.5,0,0,0,0],
              [0.5,0,0,0,0],
              [0.5,0.5,0.5,0.5,0],
              [0,0.5,0,0.5,0]])

# We normalize the matrix so that the sum of 
# outgoing links from each page is 1.

M /= np.sum(M, axis=1)[:, None]

# We can find the eigenvalues and eigenvectors 
# of the matrix 𝐴. The PageRank 𝑃 of a page 
# is the component in the corresponding eigenvector. 
# The sum of the PageRanks is 1.

# Note that eigenvalues with negative real part represent 
# 'dangling nodes', which are pages with no outgoing links, 
# but that are linked by incoming links from other pages.

evalues, evectors = la.eig(M.T)

# We get the PageRanks as the normalized components 
# of the first eigenvector (with the largest positive eigenvalue).
pranks = evectors[:, np.argmax(evalues)]
pranks /= np.sum(pranks)

print(pranks)
