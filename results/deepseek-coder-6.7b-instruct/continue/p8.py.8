mtx = np.random.normal(0, 1, (50, 50))

# calculate eigenvalues and eigenvectors
evalues, evectors = np.linalg.eig(mtx)

# plot a histogram of logarithm of eigenvalues
plt.hist(np.log(evalues), bins=20, density=True)
plt.show()
