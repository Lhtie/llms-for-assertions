4. Write a function to compute the Jacobi iteration method to find the eigenvectors and eigenvalues.
<jupyter_code>
def jacobi_eig(A,tol=1e-4):
    # A is the matrix whose eigenvalues do you find, tol is the tolerance
    
    # Initialize variables
    n = A.shape[0]
    x,y = np.zeros((n,n)), np.identity(n)
    max_iter = 10000 # maximum number of iterations
    i = 0
    
    while True:
        a = np.identity(n)
        for p in range(n):
            for q in range(n):
                if p != q:
                    max_val = np.max([abs(A[p,q]), abs(A[q,p])]) 
                    m = np.sign(A[p,q]) * max_val 
                    z = np.sqrt(m**2 + A[p,p]*A[q,q] - 2*m*A[p,q])
                    cos = (A[p,p] - A[q,q] + m**2) / (2*z)
                    sin = (A[p,q] - m*A[q,p]) / (2*z)
                    x_new = np.copy(x)
                    x_new[p,p] = cos
                    x_new[q,q] = cos
                    x_new[p,q] = sin
                    x_new[q,p] = -sin
                    y = y @ x_new
                    A = (x_new.T @ A @ x_new)
        i += 1 
            
        # check to see if we have converged
        if np.max(np.abs(A -A.T)) < tol or i >= max_iter:
            break
            
    # Diagonalize the resulting matrix
    eigenvalues = np.diag(A)
    eigenvectors = y
    
    return eigenvalues, eigenvectors
