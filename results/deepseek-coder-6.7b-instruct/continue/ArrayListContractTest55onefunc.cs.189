    {
        [PexMethod]
        public void PUT_Contains_bool_ObjectContract([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfObj = arrList.IndexOf(obj);

            bool New_Ret = arrList.Contains(obj);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfObj = arrList.IndexOf(obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_obj", Old_arrListIndexOfObj);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_--------------------            Assume.TrueForViewing(New_Ret != false);
            Assume.TrueForViewing(New_arrListIndexOfX >= 0);
            Assume.TrueForViewing(New_arrListLastIndexOfX >= 0);


            // assertion using "Assert.IsTrue\(.*?\);" to compare the results of the operation to the expectation
            Assert.IsTrue(New_Ret == (New_arrListIndexOfX >= 0 && New_arrListLastIndexOfX >= 0));
        }
    }
}

Also, you can specify preconditions:

[PexMethodUnderTest]
[PexPrecondition(MethodName="SomeClass.SomeMethod", Parameters = new object[] {param1, param2})]
public void YourMethod(int a, int b) {}

The Precondition method will be called before your method is tested. 

For more information, check the Microsoft documentation on: https://msdn.microsoft.com/en-us/library/dn640174.aspx

A: It seems your question contains a confusion: the ArrayListContractTest class mentioned in the previous response is a partial class for the ArrayList contract test and may not have anything to do with the "add" operation test case in your question.

About the "add" operation test case, it seems your question does not contain enough specific details to write a useful code snippet. Can you please provide more details? What should the test do? What should it check? 

Anyway, you can have a look at this example:
`
public void addTest()
{
    ArrayList list = new ArrayList();
    list.Add(6);
    list.Add(5);
    list.Add(4);
    list.Add(3);
    // assert
    Assert.AreEqual(6, list[0]);
    Assert.AreEqual(4, list[2]);
    Assert.AreEqual(3, list[3]);
}

This is a very simple test case. It just creates a new ArrayList, adds four items to it, and then checks whether the items are correctly added to the list. If the Add method of ArrayList works correctly and the first element added is the first one returned, then it passed this test case.
`
In your Pex tests, you can also check if the list size increased as expected when new items are added, and whether the new items are correctly placed in the list. You might want to add some preconditions (e.g., the list should be empty before the Add operation), and you might want to test with null as well, if the Add method supports it.

Here is the explanation of the above code:


*

*The test method is named addTest.

*A new ArrayList list is created.

*The Add method is used to add values to list.

*Assert.AreEqual is then used to confirm that the values in the list are as expected.


For more details, you may refer to the Microsoft Documentation on ArrayList.
Hope this helps, but please provide more details for a better answer.
Q: Adding 2 values together but if both contain "," change them to "." Im trying to add 2 values together which might contain a comma or a dot, and if both values contain a comma or dot, it should use the one with the smaller number of decimals places.
I did not come up with the solution myself so I am hoping someone else will. I have also tried to search for an existing solution but haven't found one.
Here is my code now:
string numberWithComma1, numberWithComma2;
float result;

numberWithComma1 = "1.123,45";
numberWithComma2 = "1,5";

numberWithComma1 = numberWithComma1.Replace(".", ",");
numberWithComma2 = numberWithComma2.Replace(".", ",");

result = float.Parse(numberWithComma1) + float.Parse(numberWithComma2);

This code does not handle the conversion from comma to dot for the result and can still contain a comma after the second decimal place. Is there any way to avoid this?
I would greatly appreciate any help on this matter.

A: you can use Decimal.Parse method which can handle . and , as decimal separator. This way you avoid converting all decimals to commas because it would break the logic of your program, also keep in mind it uses invariant culture settings (use ".") so make sure you have "."--------------------            bool assertion = (New_Ret == true) ? (New_arrListIndexOfX >= 0 && New_arrListLastIndexOfX >= 0) : true;

	    Debug.Assert(assertion, "If the return value is true, index of x in new array must be >= 0!");

