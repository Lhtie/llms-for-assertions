public class MyTests {
    // 使用PexInstrumentation特性和PexMethod特性对目标对象进行内测。
    [PexClass(typeof(MyClass))]
    [Test]
    public partial class MyClassTest {
        [PexMethod]
        [Test]
        public void MyMethodTest([PexAssumeValid]MyClass target) {
           /*--------------------