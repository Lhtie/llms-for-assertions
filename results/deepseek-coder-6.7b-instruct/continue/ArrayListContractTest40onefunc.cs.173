﻿// Copyright (c) .NET Foundation and contributors. All rights reserved.
// Licensed under the MIT license. See LICENSE file in the project root for full license information.

using System;
using System.Diagnostics.CodeAnalysis;
using Microsoft.DotNet.Testing.Abstractions.EventMapping;

namespace Microsoft.DotNet.Testing.Abstractions
{
    public abstract class TestLogger
    {
        public abstract void SendMessage(string message);

        [SuppressMessage("Microsoft.Design", "CA1030:UseEventsWhereAppropriate", Justification = "This method does not have an equivalent event.")]
        public virtual TestResultMessage ProcessMessage(string message)
        {
            try
            {
                return EventMapper.MapEventMessage(message);
            }
            catch (Exception)
            {
                // Exception thrown when processing some unsupported message type. So, ignore the exception.
                return null;
            }
        }

        public virtual void LogStarting(string message)
        {
            SendMessage(message);
        }

        public virtual void LogStarted()
        {
            // No operation
        }

        public virtual void LogResult(TestResultMessage report)
        {
            SendMessage(report.ToString());
        }

        public virtual void LogFinished()
        {
            // No operation.
        }
    }
}

