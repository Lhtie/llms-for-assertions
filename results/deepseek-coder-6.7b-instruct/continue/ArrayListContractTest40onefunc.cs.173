    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, object x)
        {
            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

            // Test case where the expected changes in value of count
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);

            // Test case where the expected changes in value contains
            Assert.IsTrue(New_arrListContainsX);

            // Test case where a new value is added to the list
            Assert.AreEqual(x, arrList[New_arrListCount - 1]);
        }

        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList arrList1)
        {
            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsX = arrList.Contains(arrList1);

            arrList.AddRange(arrList1);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(arrList1);

            // Test case where the expected changes in value of count
            Assert.AreEqual(Old_arrListCount + arrList1.Count, New_arrListCount);

            // Test case where the expected changes in value contains
            Assert.IsTrue(New_arrListContainsX);
        }

        
        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, object x)
        {
            bool Old_arrListContainsX = arrList.Contains(x);

            bool result = arrList.Contains(x);

            // Test case where the expected changes in value contains
            Assert.AreEqual(Old_arrListContainsX, result);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, object x)
        {
            if (arrList.Contains(x))
            {
                int Old_arrListCount = arrList.Count;
                int Old_arrListIndexOfX = arrList.IndexOf(x);

                bool result = arrList.Remove(x);

                int New_arrListCount = arrList.Count;

                // Test case where count decreases after an element is removed?
                Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

                // Test case where IndexOf returns -1 after an element is removed?
                Assert.AreEqual(-1, arrList.IndexOf(x));
            }
        }

