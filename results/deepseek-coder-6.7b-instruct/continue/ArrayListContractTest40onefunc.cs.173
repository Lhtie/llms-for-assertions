//src/ArrayList.Test/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Assertions;
using System;
using System.Collections;
using System.Collections.Generic;

[assembly: PexUseType(typeof(List<int>))]

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest("System.Collections.ArrayList.Add")]
    [PexInstrumentException]
    [PexAllowedCallOtherMethods("System.Object.Equals(object)")]
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest("System.Collections.ArrayList.Add")]
        public void AddContract([PexAssumeUnderTest]ArrayList array)
        {
            int OldCount = array.Count;

            // Execute the method under test
            array.Add(12);

            int NewCount = array.Count;

            // Assert all invariants
            PexAssert.IsTrue(NewCount == OldCount + 1);
        }

        [PexMethodUnderTest("System.Collections.ArrayList.Remove")]
        public void RemoveContract([PexAssumeUnderTest]ArrayList array)
        {
            Assume.IsTrue(array.Count > 0);

            int OldCount = array.Count;

            // Execute the method under test.
            array.RemoveAt(0);

            int NewCount = array.Count;

            // Assert all invariants
            PexAssert.IsTrue(NewCount == OldCount - 1);
        }

        [PexMethodUnderTest("System.Collections.ArrayList.Clear")]
        public void ClearContract([PexAssumeUnderTest]ArrayList array)
        {
            Assume.IsTrue(array.Count > 0);

            // Execute the method under test.
            array.Clear();

            // Assert all invariants
            PexAssert.IsTrue(array.Count == 0);
        }
    }
