            Assert.AreEqual(Old_index, New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that last index of x in array list after setting is same as new index 
            Assert.AreEqual(New_arrListLastIndexOfX, Old_arrListLastIndexOfX);

