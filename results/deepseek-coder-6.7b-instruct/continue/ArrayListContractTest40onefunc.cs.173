﻿using System;
using System.Collections;

namespace ArrayList.Test.Utilities
{
    public class Helper
    {
        public static int[] GetRandomIntArray(int length)
        {
            Random randomGenerator = new Random();
            int[] array = new int[length];
            for (int i = 0; i < length; ++i)
                array[i] = Math.Abs(randomGenerator.Next() % 1000);
            return array;
        }

        public static ArrayList ToArrayList(int[] array)
        {
            ArrayList list = new ArrayList();
            for (int i = 0; i < array.Length; i++)
            {
                list.Add(array[i]);
            }
            return list;
        }

        public static int[] ToArray(ArrayList arrayList)
        {
            int[] array = new int[arrayList.Count];
            for (int i = 0; i < arrayList.Count; i++)
            {
                array[i] = (int)arrayList[i];
            }
            return array;
        }

      
    }
}

