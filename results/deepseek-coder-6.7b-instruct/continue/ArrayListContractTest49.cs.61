//PexTests.cs
﻿using System;
using Microsoft.Pex.Framework;

using PexApiWrapper;

namespace PexTests
{
    [TestClass]
    public class PexTests
    {
        private int[] nums = new int[] { 1, 2, 3, 4 };

        [TestMethod]
        [PexMethod]
        public void TestAdd1()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Add(nums);

            Assert.AreEqual(5, arrList.Count);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsTrue(arrList.Contains(3));
        }

        [TestMethod]
 [PexMethod]
        public void TestAdd2()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Add(nums);
            arrList.Add(null);

            Assert.AreEqual(5, arrList.Count);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsTrue(arrList.Contains(3));
            Assert.IsFalse(arrList.Contains(null));
        }

        [TestMethod]
 [PexMethod]
        public void TestAdd3()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList[0] = 2;

            Assert.AreEqual(1, arrList.Count);
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(1));
        }

        [TestMethod]
 [PexMethod]
        public void TestRemove1()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);

            Assert.AreEqual(1, arrList.Count);
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(1));
        }

        [TestMethod]
 [PexMethod]
        public void TestRemove2()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Add(2);
            arrList.RemoveAt(0);

            Assert.AreEqual(1, arrList.Count);
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(1));
        }

        [TestMethod]
 [PexMethod]
        public void TestInsert1()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Insert(0, 2);

            Assert.AreEqual(2, arrList.Count);
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(1));
        }
    }
