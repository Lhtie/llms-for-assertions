}﻿using UnityEngine;
using System.Collections;

public class BallMovement : MonoBehaviour
{

    public float speed = 1f;
    public Rigidbody2D rb;
    public GameObject nextBall;

    // This boolean is for when we want to start the program and don't want the ball to move instantly
    private bool notMoving = true;

    void Start()
    {
        rb = GetComponent<Rigidbody2D>();
        notMoving = true;
    }

    // Update is called once per frame
    void Update()
    {
        // Only move the ball if we set notMoving to false
        if (!notMoving)
        {
            rb.velocity = rb.velocity.normalized * speed;
        }
    }

    public void SetNextBall(GameObject nextBall)
    {
        this.nextBall = nextBall;
    }

    public GameObject GetNextBall()
    {
        return nextBall;
    }

    // This function is for launching the game
    public void StartMoving()
    {
        notMoving = false;
    }
}﻿using DG.Tweening;
using UnityEngine;
using System.Collections;
using UnityEngine.UI;

public class BlockHealth : MonoBehaviour
{
    public int Health = 4; // block's health
    public Image healthBar;
    private float barFullLength;
    private const float BARFULLHEIGHT = 25f;

    void Start()
    {
        barFullLength = Health * BARFULLHEIGHT;
    }

    //method for taking damage
    public void TakeDamage(int amount)
    {
        Health -= amount;
        CheckHealth();
        RefreshHealthBar();
    }

    //check if the block is still alive
    private void CheckHealth()
    {
        if (Health <= 0)
        {
            //do something, like explode, disappear, etc.
            gameObject.GetComponent<BlockBehaviour>().BreakBlock();
        }
    }

    private void RefreshHealthBar()
    {
        if(healthBar != null)
        {
            healthBar.DOFade(0,1);
            healthBar.fillAmount = (float)Health / 4;
            healthBar.DOFade(1,1);
        }
    }
