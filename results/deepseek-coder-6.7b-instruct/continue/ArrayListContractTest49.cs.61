        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, ICloneable[] iCloneableArray, int index)
        {
            AssumePrecondition.IsTrue(true);
            AssumePrecondition.NotNull(iCloneableArray);
            AssumePrecondition.IsTrue(index <= iCloneableArray.Length );

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_iCloneableArrayCount = iCloneableArray.Length;
            iCloneableArray.CopyTo(iCloneableArray, index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$old_iCloneableArray_Count", Old_iCloneableArrayCount);

        }       
    }
