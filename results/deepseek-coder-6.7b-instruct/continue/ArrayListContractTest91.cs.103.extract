	    // an assertion using "DebugAssert.AreEqual(new Ret, arrList[New_Ret]);"

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >=0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            bool Old_arrListContainsIndexedItem = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsIndexedItem = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_contains_indexedItem", Old_arrListContainsIndexedItem);
            PexObserve.ValueForViewing("$new_arrList_contains_indexedItem", New_arrListContainsIndexedItem);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the old list contains the removed item, then the new list also contains it 
        }

