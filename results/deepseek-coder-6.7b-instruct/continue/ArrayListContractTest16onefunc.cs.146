using UnityEngine;

public class ClueHandler : MonoBehaviour
{
    private string _clueCode;
    private bool _isDetected;
    public ClueManager ClueManager;

    private void Start()
    {
        _isDetected = false;
    }

    private void OnTriggerEnter(Collider other)
    {
        if (_isDetected) return;
        if (!other.CompareTag("Player")) return;
        if (String.IsNullOrEmpty(_clueCode)) return;

        if (ClueManager) ClueManager.ProcessClue(_clueCode);
        _isDetected = true;
    }

    public void SetClueCode(string clueCode)
    {
        _clueCode = clueCode;
    }
