            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if new array size is old size -1, then old index of x is smaller or equal to new arrList_last index of x and new indexOf x is larger or equal to old_index +1
           if (New_arrListCount == Old_arrListCount - 1)
           {
             Debug.Assert(Old_arrListIndexOfX <= New_arrListLastIndexOfX && Old_arrListIndexOfX >= New_arrListIndexOfX);
           }
            
            Debug.Assert(Old_arrListContainsX == New_arrListContainsX);
            Debug.Assert(Old_arrListCount >= New_arrListCount);
            Debug.Assert((Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX == -1) || Old_arrListLastIndexOfX >= New_arrListLastIndexOfX);
        }
    }
