    {
        private ArrayList arrList;

        [TestInitialize]
        public void TestInitialize()
        {
            arrList = new ArrayList();
        }

        [TestMethod]
        public void Add_IncreasesSize()
        {
            arrList.Add(10);
            Assert.AreEqual(1, arrList.Count);
        }

        [TestMethod]
        public void Clear_EmptiesArrayList()
        {
            arrList.Add(10);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }

        [TestMethod]
        public void Contains_ReturnTrueIfItemExists()
        {
            arrList.Add(10);
            Assert.IsTrue(arrList.Contains(10));
        }

