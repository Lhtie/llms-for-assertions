using ArrayList;
using Xunit;

namespace Tests
{
    public class ArrayListTest
    {
        [Fact]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            arrList.Add(7);
            
            Assert.Equal(2, arrList.Count);
            Assert.Equal(5, arrList[0]);
            Assert.Equal(7, arrList[1]);
        }

        [Fact]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            arrList.Add(7);
            arrList.Add(9);
            arrList.Remove(7);

            Assert.Equal(2, arrList.Count);
            Assert.Equal(5, arrList[0]);
            Assert.Equal(9, arrList[1]);
        }--------------------            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that index of x in old array is not in new array
            Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that Contains x in new array should be false
            Debug.Assert(!New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that Count in old array is smaller than or equal to new array size
            Debug.Assert(Old_arrListCount <= New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that LastIndexOf x in old array is equal to New_arrListLastIndexOfX 
            Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
        }
    }
}
```

此测试包含多个断言，以确保基于 `ArrayList` 方法的结果符合预期。使用 `AssumePrecondition.IsTrue(true);` 确保测试的所有方法都应该被运行。

此测试的属性为 `[PexMethod]`，这意味着该方法将由 Pex 生成的测试驱动，并且可以用于测试 `ArrayList` 类的方法。

在测试中，观察了数组的 count、索引的位置、最后一次出现的位置和是否包含该元素，然后使用断言来检查列表的状态是如何变化的。

最后，测试检查了列表的元素在被移除后状态是否符合预期，其中包括：

- 旧列表的最后一次出现位置是小于或等于新列表中的元素数量
- 移除的元素在旧列表中的位置不在新列表中
- 新列表中不再包含移除的元素
- 旧列表的大小（即元素数量）小于或等于新列表的大小
- 旧列表中移除元素的最后一次出现位置是等于新列表中该元素的最后一次出现位置
- 最后，使用 Debug.Assert 来检查一些假设条件，以确保其满足。

请注意，此测试使用了许多断言来确保实现符合预期，这使得它成为一个可信的测试。

**重要提示：** 这种测试不全面，它只测试了 Remove 方法，不涉及其他方法。为了全面测试 ArrayList 类的方法，需要添加更多的测试。

