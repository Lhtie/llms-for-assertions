using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Altimetrik.Data.Utilities.CsvHandler
{
    public static class CsvExtensions
    {
        public static string ToCsv<T>(this IEnumerable<T> recs)
        {
            var stringBuilder = new StringBuilder();
            var fields = typeof(T).GetProperties();
            bool headerWritten = false;
            foreach (var rec in recs)
            {
                foreach (var fi in fields)
                {
                    if (headerWritten)
                    {
                        stringBuilder.Append(',');
                    }

                    var value = fi.GetValue(rec, null) ?? string.Empty;
                    var needsQuotes = value.ToString().Contains(',');

                    if (needsQuotes)
                    {
                        stringBuilder.AppendFormat("\"{0}\"", value.ToString().Replace("\"", "\"\""));
                    }
                    else
                    {
                        stringBuilder.Append(value);
                    }

                    if (!headerWritten)
                    {
                        stringBuilder.AppendLine();
                        headerWritten = true;
                    }
                }
            }
            return stringBuilder.ToString();
        }
    }

