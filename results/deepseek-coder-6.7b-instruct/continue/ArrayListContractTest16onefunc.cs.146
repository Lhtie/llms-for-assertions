//tests/Test.ArrayList/ArrayListRandomTest.cs
﻿using ArrayList;
using System;
using System.Collections;
using Xunit;

namespace Tests
{
    public class ArrayListRandomTest
    {
        ArrayList _arrList;
        Random _rand;

        public ArrayListRandomTest()
        {
            _arrList = new ArrayList();
            _rand = new Random();
        }

        /// <summary>
        /// Tests Add, Remove, and IndexOf methods on an ArrayList implementation
        /// </summary>
        [Fact]
        public void TestArrayListRandomOperations()
        {
            // Add 30 random integers to the array
            for (int i = 0; i < 30; i++)
            {
                _arrList.Add(_rand.Next());
            }

            // Test Add method
            Assert.Equal(30, _arrList.Count);

            // Add 15 random integers to the array
            for (int i = 0; i < 15; i++)
            {
                _arrList.Add(_rand.Next());
            }

            // Test Count property after adding more integers
            Assert.Equal(45, _arrList.Count);

            // Remove 4 random integers from the array
            for (int i = 0; i < 4; i++)
            {
                _arrList.RemoveAt(_rand.Next(_arrList.Count));
            }

            // Test Count property after removing integers
            Assert.Equal(41, _arrList.Count);

            // Test IndexOf method on a random integer
            int randomIndex = _rand.Next(_arrList.Count);
            Assert.Equal(randomIndex, _arrList.IndexOf(_arrList[randomIndex]));

            // Test Contains method on a random integer
            Assert.True(_arrList.Contains(_arrList[randomIndex]));

            // Remove all integers from the ArrayList
            _arrList.Clear();

            // Test Count property after clearing the ArrayList
            Assert.Empty(_arrList);
        }
    }
}

