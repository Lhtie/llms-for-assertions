            {
                var startInfo = new ProcessStartInfo();
                startInfo.FileName = "cmd.exe";

                foreach (var arg in args)
                {
                    startInfo.ArgumentList.Add("/" + arg);
                }

                var process = Process.Start(startInfo);
                process.WaitForExit();

                return process.ExitCode;
            }
