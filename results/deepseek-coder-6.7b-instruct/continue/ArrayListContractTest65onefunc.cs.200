            if (New_Ret < 0)
                 Debug.Assert(Old_arrListCount == New_arrListCount);

	    // An assertion using "Assert.IsTrue\(.*?\);" that @@@ If list contains x, new IndexOf should not be less than old LastIndexOf x
             Assert.IsTrue(Old_arrListContainsX ? (New_Ret >= Old_arrListLastIndexOfX) : true);
			
	    // An assertion using "Debug.Assert\(.*?\);" that @@@ Add x should decrease arraylist count
		Assert.IsTrue(Old_arrListContainsX ? (Old_arrListCount > New_arrListCount) : true);
        }
    }
}

