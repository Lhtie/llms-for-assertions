//Testing ArrayList/ContractTest.cs

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Rules;
using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {

        [PexMethod]
        [PexExploratory]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {

            int Old_arrListCount = arrList.Count;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Add(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // Addition of x should not affect the count
            Assert.AreEqual(Old_arrListCount, New_arrListCount);

            // After adding x, IndexOf(x) should return a positive value
            Assert.IsTrue(New_Ret >= 0);

            // After adding x, LastIndexOf(x) should return the same value as IndexOf(x)
            Assert.IsTrue(New_arrListLastIndexOfX == New_Ret);

            // After adding, Contains(x) should return true
            Assert.IsTrue(New_arrListContainsX);

            // After adding x, the last index of x should be the same as IndexOf(x)
            Assert.IsTrue(Old_arrListLastIndexOfX == arrList.LastIndexOf(x));
        }


        [PexMethod]
        [PexExploratory]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            arrList.Add(x);

            Assert.AreEqual(Old_arrListCount + 1, arrList.Count);
            Assert.IsTrue(arrList.Contains(x));
        }

        [PexMethod]
        [PexExploratory]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) {
                int Old_arrListCount = arrList.Count;
                arrList.Remove(x);

                Assert.AreEqual(Old_arrListCount - 1, arrList.Count);
                Assert.IsFalse(arrList.Contains(x));
            }
        }

        [PexMethod]
        [PexExploratory]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList range)
        {
            int Old_arrListCount = arrList.Count;
            arrList.AddRange(range);

            Assert.AreEqual(Old_arrListCount + range.Count, arrList--------------------            if (New_Ret >= 0)
            {
                PexAssert.AreEqual(Old_arrListCount, New_arrListCount);
            }
            else
            {
                PexAssert.IsFalse(New_Ret >= 0);
                PexAssert.IsFalse(Old_arrListContainsX);
                PexAssert.AreEqual(Old_arrListCount, New_arrListCount);
                PexAssert.AreEqual(Old_x, New_arrListLastIndexOfX == 0 ? New_Ret : New_arrListLastIndexOfX);
            }
        }

        public void PUT_Add_Contract([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListAdd = arrList.Add(obj);
            bool Old_arrListContainsObj = arrList.Contains(obj);

            int New_Ret = arrList.Add(obj);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsObj = arrList.Contains(obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Add", Old_arrListAdd);
            PexObserve.ValueForViewing("$old_arrList_contains_obj", Old_arrListContainsObj);
            PexObserve.ValueForViewing("$new_arrList_contains_obj", New_arrListContainsObj);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            PexAssert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            PexAssert.IsTrue(Old_arrListContainsObj);
            PexAssert.IsTrue(New_arrListContainsObj);
        }
    }
}

