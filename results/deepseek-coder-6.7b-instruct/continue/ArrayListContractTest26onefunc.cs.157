            PexContract.Ensure(arrList.IndexOf(x) == index); // The item should now be located at the specified index
            PexContract.Ensure(arrList.LastIndexOf(x) == index); //The Last Index Of item should be same as the insertion index
            PexContract.Ensure(arrList.Contains(x)); //The ArrayList should still contain the item
            PexContract.Ensure(arrList.Capacity > arrList.Count); //Capacity should be increased after insert
        }

        [TestMethod]
        public void PexTest_Insert_EdgeCases([PexAssumeValid] ArrayList arrList, int x, int index)
        {
            Assume.That(arrList.Count < index);

            // Testing the case where the provided index is the array's count
            arrList.Insert(arrList.Count, x);

            // Testing the case where the provided index is 0 (inserting at the start of the array)
            arrList.Insert(0, x);

            // Testing where the provided index is at the middle of the array
            arrList.Insert(arrList.Count / 2, x);
        }

        [TestMethod]
