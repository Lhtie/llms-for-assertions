            Assert.AreEqual(3, list.Count);
            Assert.AreEqual(item, list[index]);
        }

        [Test]
        public void Remove([PexInline(1)]object item)
        {
            // Arrange
            var list = new ArrayList { 1, 2, 3 };

            // Act
            list.Remove(item);

            // Assert
            Assert.IsFalse(list.Contains(item));
            Assert.AreEqual(2, list.Count);
        }
    }
