            Assert.IsTrue(New_arrListIndexOfX == Old_arrListCount || New_arrListIndexOfX == Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ first position of x after insertion is greater than or equal to original array index 
            Assert.IsTrue(New_arrListLastIndexOfX == Old_index || New_arrListLastIndexOfX == Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ x is contained in the array after inserting x at index 
            Assert.IsTrue(New_arrListContainsX);
        }
    }
}

