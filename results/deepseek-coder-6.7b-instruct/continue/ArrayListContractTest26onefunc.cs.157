//testing/ArrayList.Test/ArrayListContractTestPartial/ArrayListContractTest_Remove.cs
﻿using Microsoft.Pex.Framework;
using System;
using System.Collections;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count - 1 && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfN = index;
            object Old_arrListItemN = arrList[index];
            bool Old_arrListContainsItemN = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsItemN = arrList.Contains(Old_arrListItemN);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Contains_Item_N", Old_arrListContainsItemN);
            PexObserve.ValueForViewing("$new_arrList_Contains_Item_N", New_arrListContainsItemN);

            Debug.Assert(New_arrListCount == Old_arrListCount - 1);
            Debug.Assert(New_arrListContainsItemN == false);
        }
    }
}

//testing/ArrayList.Test/ArrayListFactTest.cs
﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using FluentAssertions;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListFactTest
    {
        [TestMethod]
        public void TestArrayListInitialCount()
        {
            var arrList = new ArrayList();

            arrList.Count.Should().Be(0);
        }

        [TestMethod]
        public void TestArrayListAddCount()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            arrList.Count.Should().Be(3);
        }

        [TestMethod]
        public void TestArrayListInsertCount()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Insert(1, 2);

            arrList.Count.Should().Be(4);
        }

        [TestMethod]
        public void TestArrayListRemoveCount()
        {
            var arrList = new ArrayList {1, 2, 3};
            arrList.Remove(2);

            arrList.Count.Should().Be(2);
        }

        [TestMethod]
        public void TestArrayListContains()
        {
            var arrList = new ArrayList {1, 2, 3};
            arrList.Contains(2).Should().BeTrue();
        }
    }
}

