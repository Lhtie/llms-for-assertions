            catch (System.ArgumentOutOfRangeException) { }

            //Testing the negative index insertion
            try
            {
                arrList.Insert(-1, x);
                Assert.Fail("Should have thrown an Exception");
            }
            catch (System.ArgumentOutOfRangeException) { }
        }
