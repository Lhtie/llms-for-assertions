﻿namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList collection)
        {
            int Old_arrListCount = arrList.Count;
            int Old_collectionCount = collection.Count;
            bool AnyCollection = Old_collectionCount > 0;

            arrList.AddRange(collection);

            int New_arrListCount = arrList.Count;

            Assert.AreEqual(Old_arrListCount + Old_collectionCount, New_arrListCount, "arrList.Count should be equal to old count + collection count after AddRange invocation");

        }

        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
            AssumePrecondition.IsTrue(count <= arrList.Count && count >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_count = count;

            arrList.RemoveRange(index, count);

            int New_arrListCount = arrList.Count;

            Assert.AreEqual(Old_arrListCount - Old_count, New_arrListCount, "arrList.Count should be equal to old count - count after RemoveRange invocation");
        }

        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, ArrayList array, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrayLength = array.Count;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;
            int New_arrayLength = array.Count;

            Assert.AreEqual(Old_arrListCount, New_arrListCount, "arrList.Count should not change after CopyTo invocation");
            Assert.AreEqual(Old_arrayLength, New_arrayLength, "array.Count should not change after CopyTo invocation");
        }
    }
