using NUnit.Framework;
using System.Collections;
using ArrayList;
using System;

namespace Tests
{
    public class Tests
    {
        ArrayList al;
        [SetUp]
        public void Setup()
        {
            al = new ArrayList();
        }

        [Test]
        public void TestCount()
        {
            Assert.AreEqual(0, al.Count);
        }

        [Test]
        public void TestAddElements()
        {
            al.Add(1);
            al.Add("test");
            Assert.AreEqual(2, al.Count);
        }

        [Test]
        public void TestElementRetrieval()
        {
            al.Add(1);
            al.Add("test");
            Assert.AreEqual(1, al[0]);
            Assert.AreEqual("test", al[1]);
        }

        [Test]
        public void TestRemoveElement()
        {
            al.Add(1);
            al.Add("test");
            al.RemoveAt(0);
            Assert.AreEqual(1, al.Count);
            Assert.AreEqual("test", al[0]);
        }

        [Test]
        public void TestClear()
        {
            al.Add(1);
            al.Add("test");
            al.Clear();
            Assert.AreEqual(0, al.Count);
        }
    }
}

