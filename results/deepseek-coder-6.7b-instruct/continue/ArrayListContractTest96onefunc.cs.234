        }
      

        //
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList list)
        {
            AssumePrecondition.ListSizeIsNotLimited(list);
            AssumePrecondition.IsTrue(true);

            Index index = PexObserve.ValueForViewing("$index", Index.FromStart(list.Count));
            PexAssume.IsTrue(Index.IsInRange(index, list.Count));

            object item = PexObserve.ValueForViewing("$item", list[0]);

            list.Insert(index.Value, item);

            PexAssert.IsTrue(list.Count == list.Count + 1);
            PexAssert.IsTrue(list.Contains(item));
            PexAssert.AreEqual(item, list[list.Count - 1]);
        }
    }
}
```

The contracts are described as following:

- PUT_CountContract: Assumes the list is not empty and then ensures that the Count property is either equal to zero or greater than zero. 

- PUT_InsertContract: Assumes that our list is not limited by the size, then it inserts an item at the end of the list and checks the properties.

## Sample 3: Test with PexMethodUnderTest

In many cases, you have to create multiple combinations of inputs to test your method. With `[PexMethodUnderTest]`, you only pass the specific input value that you want to test.

```CSharp
[TestMethod]
[PexMethodUnderTest]
public void ArrayList_Add_Test([PexAssumeValid]object obj) 
{
    ArrayList list = new ArrayList();
    list.Add(obj);
    
    Assert.AreEqual(1, list.Count);
    Assert.AreEqual(obj, list[0]);
}
```

In the above sample, the method to test is `ArrayList.Add`. `[PexAssumeValid]` attribute ensures the method is invoked with valid inputs.

## Sample 4: Test with PexMemberUnderTest

When you want to test some non-public members of a class, you can use `[PexMemberUnderTest]`. 

```CSharp
[TestMethod]
[PexMethodUnderTest]
public void ArrayList_GetObject_Test([PexMemberUnderTest]GetObjectDelegate myDelegate)
{
    ArrayList list = new ArrayList();
    list.Add(1);
    object obj = myDelegate(list);
    
    Assert.AreEqual(1, list.Count);
}

// Delegate
public delegate object GetObjectDelegate(ArrayList list);
```

In the above sample, `GetObjectDelegate` is a delegate that points the `ArrayList.Get` method.

## Conclusion

With `[PexClass]`, `[PexMethodUnderTest]`, `[PexMemberUnderTest]` and other attributes, you can create tests for your code easily and effectively. It allows you to automate testing and also gives you a deeper understanding of your code by providing detailed reports with visualisations. It is more effective with small code units and less effective with larger code units.

Please note that there are a few limitations and it should be used judiciously. Don't use it for every test; it’s best used in combination with other testing approaches for critical parts of a system.

Remember: Don't forget to add Pex Reference for the Microsoft Pex Test Framework when you use these kind of attributes.

Happy Testing !
























































































































































































--------------------	    PexAssert.AreGreaterThanOrEqual("@@@ Count value of array must be either 0 or greater than or equal to 1.", arrList.Count, 0); 

        }
        
        [PexMethod]
        public ArrayList PUT_ArrayListContract([PexAssumeUnderTest]ArrayList list, int index)
        {
            AssumePrecondition.IsTrue(list.Count > index);
            AssumePrecondition.IsTrue(index >= 0);

            int oldCount = list.Count;
            object obj = list[index]; 

            list.RemoveAt(index); 

            // we check that the count of the modified list was as expected 
            PexAssert.AreEqual(list.Count, oldCount -1);
            // we check that we have returned the object that we removed
            PexAssert.AreEqual(list[index], obj);
            

            // we return the final list
            return list;  
        }   
    }
}

