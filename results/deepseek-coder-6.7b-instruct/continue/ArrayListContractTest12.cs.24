using Microsoft.Pex.Framework;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [PexMethod]
        public void TestAdd(ArrayList list, int item)
        {
            int oldCount = list.Count;
            list.Add(item);

            Assert.AreEqual(oldCount + 1, list.Count);
            Assert.AreEqual(item, list[oldCount]);
        }

        [PexMethod]
        public void TestRemove(ArrayList list, int item)
        {
            list.Add(item);
            int oldCount = list.Count;
            list.Remove(item);

            Assert.AreEqual(oldCount - 1, list.Count);
            Assert.IsFalse(list.Contains(item));
        }

         [PexMethod]
        public void TestAddRange(ArrayList list, int[] items)
        {
            int oldCount = list.Count;
            list.AddRange(items);

            Assert.AreEqual(oldCount + items.Length, list.Count);
            foreach (var item in items)
            {
                Assert.IsTrue(list.Contains(item));
            }
        }
    }
}

