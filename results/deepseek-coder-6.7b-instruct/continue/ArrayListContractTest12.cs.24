namespace StackQueueLinkedList
{
    class QueueNode<T>
    {
        public T Data;
        public QueueNode<T> Next;

        public QueueNode(T data)
        {
            this.Data = data;
            Next = null;
        }
    }

    class Queue<T>
    {
        private QueueNode<T> front;
        private QueueNode<T> rear;

        public Queue()
        {
            front = null;
            rear = null;
        }

        public bool IsEmpty()
        {
            return front == null;
        }

        public void Enqueue(T item)
        {
            QueueNode<T> temp = new QueueNode<T>(item);

            if (rear == null)
            {
                rear = front = temp;
            }
            else
            {
                rear.Next = temp;
                rear = temp;
            }
        }

        public T Dequeue()
        {
            if (IsEmpty())
            {
                throw new InvalidOperationException("Queue is empty");
            }
            else
            {
                T item = front.Data;
                front = front.Next;

                if (front == null)
--------------------            PexAssert.AreEqual(Old_arrListContainsX, Old_arrListIndexOfX >= -1, "Failure: IndexOf X >= -1");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old array is >= -1 
            PexAssert.AreEqual(Old_arrListContainsX, Old_arrListLastIndexOfX >= -1, "Failure: LastIndexOf X >= -1");

	    // assertion that adding x to arrList incremented Count by 1 
            PexAssert.AreEqual(New_arrListCount, Old_arrListCount + 1, "Failure: Count incremented by 1");

	    // assertion that x is now in arrlist 
            PexAssert.IsTrue(New_arrListContainsX, "Failure: Contains X");
        }
    }
}

//Assignments/Pex/ArrayList/ArrayList.Test/ArrayListTest.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayListTest
{
    [TestClass]
    public class ArrayListTest
    {
        [TestMethod]
        public void ArrayList_Add_Item_To_End_And_Check_Count()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            int itemToAdd = 1;
            int expectedCount = 1;

            // Act
            arrList.Add(itemToAdd);
            int actualCount = arrList.Count;

            // Assert
            Assert.AreEqual(expectedCount, actualCount);
        }

        [TestMethod]
        public void ArrayList_Add_Item_To_End_And_Check_Item()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            int itemToAdd = 1;

            // Act
            arrList.Add(itemToAdd);

            // Assert
            Assert.IsTrue(arrList.Contains(itemToAdd));
        }

        [TestMethod]
        public void ArrayList_Clear_ArrayList_And_Check_Count_And_Contains_Item()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            int expectedCount = 0;
            int itemToCheck = 1;

            // Act
            arrList.Clear();
            int actualCount = arrList.Count;

            // Assert
            Assert.AreEqual(expectedCount, actualCount);
            Assert.IsFalse(arrList.Contains(itemToCheck));
        }

        [TestMethod]
        public void ArrayList_Add_Multiple_Items_And_Check_IndexOf_Item()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            // Act
            int indexOfTwo = arrList.IndexOf(2);

            // Assert
            Assert.AreEqual(1, indexOfTwo);
        }

        [TestMethod]
        public void ArrayList_Add_Items_Increase_Count()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            int initialCount = arrList.Count;
            int itemToAdd = 1;

            // Act
            arrList.Add(itemToAdd);
            int actualCount = arrList.Count;

            // Assert
            Assert.AreEqual(initialCount + 1, actualCount);
        }
    }
}

//Assignments/Pex/ArrayList/ArrayList.Test/PexArrayListTest.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using Microsoft.Pex.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public partial class PexArrayListTest
    {
        [PexMethod]
        public void ArrayList_Add_Item_To_End_And_Check_Count(ArrayList arrList, int itemToAdd)
        {
            // Arrange
            int initialCount = arrList.Count;

            // Act
            arrList.Add(itemToAdd);
            int actualCount = arrList.Count;

            // Assert
            Assert.AreEqual(initialCount + 1, actualCount);
        }

        [PexMethod--------------------	    Assert.IsTrue(Old_arrListIndexOfX == -1 ? New_arrListCount : Old_arrListIndexOfX <= New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  the index of x in new array is equal to the return value of arrList.Add()
	    Assert.IsTrue(New_Ret == New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  the LastIndexOf x in new array is  >= IndexOf x in new array
	    Assert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  the Contains method indicates x exists in new array with @@@ true value
	    Assert.IsTrue(New_arrListContainsX == true);
        }
    }
}
