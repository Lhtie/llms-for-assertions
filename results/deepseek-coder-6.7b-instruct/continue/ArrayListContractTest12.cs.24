namespace ContentExplorerSample
{
  class Program
  {
    static void Main(string[] args)
    {

      // Set your own Personal Access Token for Azure DevOps Authentication
      const string pats = "<Your_Personal_Access_Token>";

      var uri = new Uri("https://dev.azure.com/<OrgName>");
      var connection = new VssConnection(uri, new VssBasicCredential(string.Empty, pats));

      RunAsync(connection).GetAwaiter().GetResult();
    }

    private static async System.Threading.Tasks.Task RunAsync(VssConnection connection)
    {
      var client = connection.GetClient<ContentExplorerHttpClient>();

      var request = new ContentExplorerItemRequest
      {
        ItemPath = "/<ProjectName>",
        RecursionLevel = RecursionLevel.Full,
        IncludeContentMetadata = true,
      };

      var response = await client.GetItemAsync(request);

      PrintContentExplorerItem(response.Value);

      connection.Dispose();
    }

    private static void PrintContentExplorerItem(ContentExplorerItem item)
    {
      if (item != null)
      {
        Console.WriteLine(
          $"{item.Path}:{item.Type}:{item.IsFolder}:{item.Length}:{item.LastModifiedDate}:{item.ContentMetadata.Sha1Hash}");

        foreach (var childItem in item.Children)
        {
          PrintContentExplorerItem(childItem);
        }
      }
    }
    // </CodeSnippet1>
  }
