﻿// Copyright (c) 2017 Nickoman

using System.Collections.Generic;
using System.Drawing;

namespace SVG2PNG.Interpolation
{
    public class WeightedInterpolator : IInterpolator
    {
        public Color Interpolate(List<Color> colorList)
        {
            int r = 0;
            int g = 0;
            int b = 0;

            for (var i = 0; i < colorList.Count; i++)
            {
                var color = colorList[i];
                r += (color.R * (i + 1));
                g += (color.G * (i + 1));
                b += (color.B * (i + 1));
            }

            r /= colorList.Count;
            g /= colorList.Count;
            b /= colorList.Count;

            return Color.FromArgb(r, g, b);
        }
    }
}

