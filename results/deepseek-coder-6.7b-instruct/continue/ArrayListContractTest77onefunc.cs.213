//TechXamarin/TestProjects/ArrayList.Test/InsertSpecificIndex.cs
﻿using Microsoft.Pex.Framework;
using System.Collections;
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_InsertContract([PexAssumeValid]ArrayList arrList, int index, object value)
        {
            AssumePrecondition.IsInRange(index, 0, arrList.Count);

            int Old_arrListCount = arrList.Count;

            // Insert an item at specified index
            arrList.Insert(index, value);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion to check if count of old arrList and new arrList are same
            Debug.Assert(Old_arrListCount == New_arrListCount - 1, "The count of old list should equal to the new list count minus 1");
            Debug.Assert(New_arrListCount >= index, "The count of new list should always be equal or greater than the specified index");
        }
    }
}

//TechXamarin/TestProjects/ArrayList.Test/RemoveAt.cs
﻿using Microsoft.Pex.Framework;
using System.Collections;
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAtContract([PexAssumeValid]ArrayList arrList, int index)
        {
            AssumePrecondition.IsInRange(index, 0, arrList.Count - 1);

            int Old_arrListCount = arrList.Count;

            // Remove the item at specified index
            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$index", index);

            // an assertion to check if count of old arrList and new arrList are same
            Debug.Assert(Old_arrListCount == New_arrListCount + 1, "The count of old list should equal to the new list count plus 1");
            Debug.Assert(New_arrListCount >= index, "The count of new list should always be equal or greater than the specified index");
        }
    }
}

