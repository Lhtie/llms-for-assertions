            PexAssume.Assert(New_arrListCount >= Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If new array contains x, index of x in new array should equal to the original number of elements in array less one
            PexAssume.Assert(New_arrListContainsX && New_Ret == Old_arrListCount - 1);
        }
