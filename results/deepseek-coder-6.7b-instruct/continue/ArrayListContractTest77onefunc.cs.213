            Debug.Assert(Old_arrListLastIndexOfX <= New_Ret); 

            //an assertion that arrList contains x 
            Debug.Assert(New_arrListContainsX);

            // an assertion that Old_arrListCount is equivalent to New_arrListCount
            Debug.Assert(Old_arrListCount == New_arrListCount);
	    //if Precondition is true then assertion is true
        } 

	} // end of class
} // end of namespace
```
