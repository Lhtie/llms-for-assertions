namespace CSharpTest
{
    public class WorkDayCalculator
    {
        public DateTime calculateBusinessDay(DateTime startDate, int daysToAdd)
        {
            DateTime tempDate = startDate;
            for(int i = 0; i< daysToAdd; i++)
            {
                tempDate = tempDate.AddDays(1);
                while(isWeekend(tempDate) || isHoliday(tempDate))
                {
                    tempDate = tempDate.AddDays(1);  
                }
            } 
            return tempDate ;
        }
        private bool isWeekend(DateTime dt)
        {
            return (dt.DayOfWeek == DayOfWeek.Saturday || dt.DayOfWeek == DayOfWeek.Sunday); 
        }
        private bool isHoliday(DateTime dt)
        {
            return (dt.Month == 12 && dt.Day == 25 || dt.Month == 1 && dt.Day == 1);  
        }
    }
