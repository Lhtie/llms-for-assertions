﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test]
        public void Test_ArrayList_Init()
        {
            var arrList = new ArrayList();
            var intArrList = new ArrayList();
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i + 1);
                intArrList.Add(i + 1);
            }
            Assert.AreEqual(arrList.Count, intArrList.Count);
            for (int i = 0; i < arrList.Count; i++)
            {
                Assert.AreEqual(intArrList[i], arrList[i]);
            }
        }

        [Test]
        public void Test_ArrayList_Add()
        {
            var arrList = new ArrayList();
            var intArrList = new ArrayList();
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i + 1);
                intArrList.Add(i + 1);
            }

            arrList.Add(11);
            intArrList.Add(11);

            Assert.AreEqual(arrList.Count, intArrList.Count);
            for (int i = 0; i < arrList.Count; i++)
            {
                Assert.AreEqual(intArrList[i], arrList[i]);
            }
        }
        [Test]
        public void Test_ArrayList_Remove()
        {
            var arrList = new ArrayList();
            var intArrList = new ArrayList();
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i + 1);
                intArrList.Add(i + 1);
            }

            arrList.Remove(5);
            intArrList.Remove(5);

            Assert.AreEqual(arrList.Count, intArrList.Count);
            for (int i = 0; i < arrList.Count; i++)
            {
                Assert.AreEqual(intArrList[i], arrList[i]);
            }
        }


        [Test]
        public void Test_ArrayList_IndexOf()
        {
            var arrList = new ArrayList();
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i + 1);
                Assert.AreEqual(i, arrList.IndexOf(i + 1));
            }

            Assert.AreEqual(-1, arrList.IndexOf(11));

        }

        [Test]
        public void Test_ArrayList_Contains()
        {
            var arrList = new ArrayList();
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i + 1);
                Assert.IsTrue(arrList.Contains(i + 1));
            }

            Assert.IsFalse(arrList.Contains(11));
        }
    }





}

