namespace CSharpTest
{
    public interface IOutput
    {
        void Output(String output);
    }
}using System;
using System.Diagnostics.Contracts;

namespace CSharpTest
{
    public class HelloWorld : IOutput
    {
        public String Message { get; set; }
        
        public HelloWorld(){
            this.Message = "Hello World!";
        }

        [ContractInvariantMethod]
        private void ObjectInvariant()
        {
            // This ensures that the class invariant (object state) holds throughout the lifetime of an object.
            // It basically means that the Message must not be null.
            Contract.Invariant(!String.IsNullOrEmpty(this.Message));
        }

        public void Output(String output)
        {
            Console.WriteLine(this.Message + " " + output);
        }
    }
}//File/FileIO.cs
﻿using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace File
{
    public class FileIO
    {
        public bool Write(string data,string path)
        {
            try
            {
                using (StreamWriter writer = new StreamWriter(path, false))
                {
                    writer.Write(data);
                }
                return true;
            }
            catch (Exception)
            {
                return false;
            }
        }
        public string Read(string path)
        {
            try
            {
                using (StreamReader reader = new StreamReader(path))
                {
                    return reader.ReadToEnd();
                }
            }
            catch (Exception)
            {
                return string.Empty;
            }
        }
    }
}

