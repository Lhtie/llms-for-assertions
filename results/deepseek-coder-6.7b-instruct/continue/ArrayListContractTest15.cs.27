A: If you have a contract test and want to assert that some property should hold true, you should use the regular NUnit Assert methods.
For example:
Assert.AreEqual(expected, actual)

It will throw an exception when the assertion fails. The provided code can just be used to observe the properties without triggering exceptions, which is useful for debugging the code.
Debug.Assert is most often used to verify conditions that are theoretically impossible to occur during execution, such as stack frames in a debugging scenario, but not during normal execution.
Please remember that Pex does not support Debug.Assert. Debug.Assert is translated to a conditional compilation symbol in your output assembly, and the Debug.Assert calls are effectively ignored. The framework will still observe your method's behavior.
I've made a small change in your code: if in the precondition x is not in the arrList, Pex will throw an exception because LastIndexOf returns -1 and Remove may fail.
[PexMethod]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsFalse(arrList.IndexOf(x) < 0);

    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
    PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
    PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
    PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
    PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
    PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

    // This will fail if the value existed in the list.
    Assert.IsFalse(New_arrListContainsX);
}

I've replaced the Debug.Assert with a regular NUnit Assert to verify the expected behavior. For the actual code, I've also ensured there is no exception if the element does not exist in the array list.

A: Here is an example of how to use NUnit assertions in this context.
[Test]
public void RemoveContract([Values(int.MinValue, int.MaxValue, 0, 1, -1)] int x)
{
    ArrayList list = new ArrayList() { x, 2, 3, x };

    int oldCount = list.Count;

    list.Remove(x);

    Assert.AreEqual(oldCount - 1, list.Count);  // Count should be reduced by 1
    Assert.IsFalse(list.Contains(x));  // It should have been removed
}

This tests that the count of the list decreases by 1 when an element is removed, and that the element is no longer in the list after the removal. The values provided for the test are the minimum and maximum int values, as well as 0, 1, and -1, which will test all possible cases. Note: if the element does not exist in the list, it will throw an exception, so you should take that into account in your assumptions--------------------        }
    }
}﻿using UnityEngine;

public class DialogScript : MonoBehaviour
{
    public bool isInRange;
    public GameObject UItext;
  

    // Start is called before the first frame update
    void Start()
    {
        
    }

    // Update is called once per frame
    void Update()
    {
        if (isInRange && Input.GetKeyDown(KeyCode.E))
        {
            UItext.SetActive(!UItext.activeSelf);
        }
    }

    private void OnTriggerEnter2D(Collider2D other)
    {
        if(other.CompareTag("Player"))
        {
            isInRange = true;
        }
    }

    private void OnTriggerExit2D(Collider2D other)
    {
        if (other.CompareTag("Player"))
        {
            isInRange = false;
            UItext.SetActive(false);
        }
    }
