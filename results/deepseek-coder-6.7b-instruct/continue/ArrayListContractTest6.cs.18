namespace GW_Tools.Core
{
    /// <summary>
    /// Class to save and handle the different modes the application supports
    /// </summary>
    public static class ModeHandler
    {
        #region Fields

        private static string activeMode;

        #endregion

        #region Properties

        /// <summary>
        /// Property for retrieving the active mode
        /// </summary>
        public static string ActiveMode
        {
            get { return activeMode; }
            set
            {
                if(value != activeMode)
                {
                    // Trigger event
                    ModeChanged?.Invoke();

                    // Set the new active mode
                    activeMode = value;
                }
            }
        }

        #endregion

        #region Events

        /// <summary>
        /// Event that is triggered when active mode changes
        /// </summary>
        public static event ModeChangedEventHandler ModeChanged;

        #endregion


        #region Methods

        /// <summary>
        /// Resets the active mode
        /// </summary>
        public static void ResetMode()
        {
            ActiveMode = null;
        }

        #endregion
    }
