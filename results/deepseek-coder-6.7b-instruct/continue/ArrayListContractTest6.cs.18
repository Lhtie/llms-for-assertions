using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x, int start)
        {
            AssumePrecondition.IsTrue(start >= 0 && start <= arrList.Count);

            int Old_arrListIndexOfXStart = arrList.IndexOf(x, start);

            int New_IndexOfXStart = arrList.IndexOf(x, start);

            PexObserve.ValueForViewing("$old_arrList_IndexOf_x_start", Old_arrListIndexOfXStart);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x_start", New_IndexOfXStart);

	    // an assertion using "Debug.Assert\(.*?\);" that whether New_IndexOfXStart is greater than or equal to start and lesser than the count of array
            Assert.IsTrue(New_IndexOfXStart >= start && New_IndexOfXStart < arrList.Count);

	    // an assertion using "Debug.Assert\(.*?\);" that whether Old_arrListIndexOfXStart is equal to New_IndexOfXStart and whether there's no match is also equal to the difference between count and Old_arrListIndexOfXStart and New_IndexOfXStart
            Assert.IsTrue(Old_arrListIndexOfXStart == New_IndexOfXStart || (arrList.Count - Old_arrListIndexOfXStart) == (New_IndexOfXStart - old_arrListIndexOfXStart));

            Assert.AreEqual(Old_arrListIndexOfXStart, New_IndexOfXStart);
        }
    }
