using Microsoft.Pex.Framework;

namespace PexAPIWrapper
{
    [PexClass]
    public class ArrayList
    {
        private List<int> data;

        // Constructor.
        public ArrayList()
        {
            this.data = new List<int>();
        }

        public int Count
        {
            get 
            {
                return this.data.Count;
            }
        }

        public int Add(int value)
        {
            this.data.Add(value);
            return this.data.Count - 1;
        }

        public bool Contains(int value)
        {
            return this.data.Contains(value);
        }

        public int IndexOf(int value)
        {
            return this.data.IndexOf(value);
        }

        public int LastIndexOf(int value)
        {
            for (int i = this.data.Count - 1; i >= 0; i--)
            {
                if (this.data[i] == value)
                {
                    return i;
                }
            }

            return -1;
        }

        public int this[int index]
        {
            get 
            {
                return this.data[index];
            }
            set 
            {
                this.data[index] = value;
            }
        }
    }
}﻿using System;
using System.Threading;
using System.Threading.Tasks;

namespace ParallelExample
{
    internal class Program
    {
        static void Main(string[] args)
        {
            // Avoid the "ArgumentOutOfRangeException"
            Console.WriteLine("Parallel For Loop");
            long[] factorialResult = new long[10];

            Parallel.For(0, 10, i =>
            {
                factorialResult[i] = Factorial(i);
                Console.WriteLine($"Factorial {i} is {factorialResult[i]}");
            });

            Console.WriteLine("Parallel Invoke");

            var values = new[] { 1, 2, 3, 4, 5 };
            var results = new int[values.Length];

            // The task delegate takes a value and fills the corresponding result array slot
            Action<int> task = (index) =>
            {
                results[index] = values[index] * 2;
            };

            // Run each task on its own thread
            var tasks = new Task[values.Length];
            for (int i = 0; i < values.Length; i++)
            {
                tasks[i] = Task.Factory.StartNew(() =>
                {
                    task(i);
                    Console.WriteLine($"Value {values[i]} doubled is {results[i]}");
                });
            }

            // Wait for all tasks to complete
            Task.WaitAll(tasks);

            Console.ReadKey();
        }

        static long Factorial(long number)
        {
            if (number <= 1)
                return 1;
            else
                return number * Factorial(number - 1);
        }
    }
