﻿using System;

namespace BankApp
{
    class Program
    {
        static void Main(string[] args)
        {
            BankAccount ba1 = new BankAccount("Mohan", 1000);
            
            ba1.Deposit(500);
            ba1.Withdraw(200);
            
            BankAccount ba2 = new BankAccount("Sohan", 2000);
            
            ba2.Deposit(1000);
            ba2.Withdraw(500);
            
            ba1.Print();
            ba2.Print();
        }
    }
}

