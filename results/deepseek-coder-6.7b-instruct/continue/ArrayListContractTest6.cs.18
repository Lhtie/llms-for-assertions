﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace PexAPIWrapper
{
    public class ListWrapper : List<int>, IListWrapper
    {
        public ListWrapper() : base()
        {
        }
        public ListWrapper(int capacity) : base(capacity)
        {
        }

        public ListWrapper(IEnumerable<int> collection) : base(collection)
        {
        }

        public int AddUnique(int item)
        {
            if(!this.Contains(item))
            {
                this.Add(item);
            }
            return this.Count;
        }

        public int CountUnique
        {
            get
            {
                return this.Distinct().Count();
            }
        }

        public int RemoveAll(int item)
        {
            return this.RemoveAll(i => i.Equals(item));
        }

        public int CountDuplicates()
        {
            return this.Count - this.Distinct().Count();
        }
    }
}

//ArrayList.Test/ArrayListPropertiesTest.cs
﻿using System;
using Microsoft.Pex.Framework;
using PexAPIWrapper;
using NUnit.Framework;

[TestFixture]
public class ArrayListPropertiesTest
{
    [Test]
    [PexMethod]
    public void Test_Properties([PexAssumeValid]ArrayList arrList, int x, int y)
    {
        AssumePrecondition.IsTrue(arrList.Count > 0);
        AssumePrecondition.IsTrue(arrList.Count >= arrList.IndexOf(x));
        AssumePrecondition.IsTrue(arrList.Count >= arrList.IndexOf(y));

        int CountBeforeInsertion = arrList.Count;

        // Inserting x and y, and checking the count after insertion
        arrList.Insert(0, x);
        int CountAfterInsertX = arrList.Count;
        arrList.Insert(1, y);
        int CountAfterInsertY = arrList.Count;

        Assert.AreEqual(CountBeforeInsertion + 2, CountAfterInsertX);
        Assert.IsTrue(CountAfterInsertY == CountAfterInsertX -1);

        // Check index of inserted values
        Assert.IsTrue(arrList.IndexOf(x) == 0);
        Assert.IsTrue(arrList.IndexOf(y) == 1);
    }
}

//ArrayList.Test/ArrayListRemoveTest.cs
﻿using System;
using Microsoft.Pex.Framework;
using PexAPIWrapper;
using NUnit.Framework;

[TestFixture]
public class ArrayListRemoveTest
{
    [Test]
    [PexMethod]
    public void Test_Remove([PexAssumeValid]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(arrList.Count > 0);
        AssumePrecondition.IsTrue(arrList.Contains(x));

        int CountBeforeRemoval = arrList.Count;

        // removing x and checking the count after removal
        arrList.Remove(x);
        int CountAfterRemoval = arrList.Count;

        Assert.AreEqual(CountBeforeRemoval -1, CountAfterRemoval);
    }
}

