            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
--------------------            Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX || New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
--------------------	    Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
--------------------            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
------------------------------------------------------------            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
----------------------------------------            if (Old_arrListContainsX && Old_arrListIndexOfX <= Old_index && index <= New_arrListIndexOfX)
	    {
                int expected = (Old_arrListIndexOfX <= Old_index ? Old_arrListIndexOfX : Old_index) + 1;
		Debug.Assert(expected <= New_arrListIndexOfX,"Insertion did not push the elements correctly");
--------------------	    // and that all elements in new array list are equal to those in old array list except the position at which @@@ x is inserted 
	    // and all elements to right of @@@ x are to the left or equal to those in old array list.
        }
    }
}

This PEX test case checks that the Insert() function in the ArrayList class does not alter elements beyond the inserted element's position, not forgetting that ArrayList will also automatically grow if the provided index is out of bounds.

The assertion to be made could be:
```
Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX &&
              Enumerable.SequenceEqual(Enumerable.Range(0, Old_arrListCount),
                                      arrList.Cast<int>()
                                      .Zip(Enumerable.Range(0, Old_arrListCount), (x, i) => New_arrListIndexOfX < i ? i : i - 1))
              && New_arrListContainsX && 
	      arrList.Cast<int>().Take(New_arrListCount).SequenceEqual(arrList.Cast<int>().Take(Old_arrListCount).Concat(new[] { Old_x })));
