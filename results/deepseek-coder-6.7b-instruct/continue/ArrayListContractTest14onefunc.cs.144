//ArrayList.Test/ArrayListContractTest.cs
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList.Test;

namespace ArrayList.Test
{
    [TestClass]
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void RemoveAllOnNonEmptyArray([PexAssumeValid] ArrayList arrList)
        {
            AssumePrecondition.CollectionHasAtLeastOneElement(arrList);

            int oldCount = arrList.Count;
            bool oldIsSynchronized = arrList.IsSynchronized;
            object oldSyncRoot = arrList.SyncRoot;

            arrList.RemoveAll(x => true);

            int newCount = arrList.Count;
            bool newIsSynchronized = arrList.IsSynchronized;
            object newSyncRoot = arrList.SyncRoot;

            // There must not be added elements after a 'RemoveAll'
            Assert.AreEqual(oldCount, newCount);
            Assert.AreEqual(oldIsSynchronized, newIsSynchronized);
            Assert.AreEqual(oldSyncRoot, newSyncRoot);
        }

    }
}

