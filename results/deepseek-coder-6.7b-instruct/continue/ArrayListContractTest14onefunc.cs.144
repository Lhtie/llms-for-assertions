using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Collections;
using NUnit.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            arrList.Sort();

            for (int index = 0; index < arrList.Count - 1; ++index)
            {
                Assert.IsTrue((IComparable)arrList[index] <= (IComparable)arrList[index + 1]);
            }
        }
    }
}

