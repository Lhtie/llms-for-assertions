//ExampleTestProject/ArrayListContractTest/RemoveRangeContract.cs
﻿namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexEntryPoint]
        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, [PexMarshalAs(PexMarshalAs.Out)] [PexArrayRange(1,10)] int[] range)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_rangeCount = range.Length;

            arrList.RemoveRange(0, Old_arrListCount);
  
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list count should decrease with the same amount as we removed.
            Debug.Assert(New_arrListCount == Old_arrListCount - Old_rangeCount);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list contains is not throwing exception with right parameters.
            PexMethodCall(arrList.Contains, 5);
           
            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list count should not allow negative numbers after removing range elements
            Debug.Assert(New_arrListCount >= 0);
        }
    }
}

//ExampleTestProject/ArrayListContractTest/SortContract.cs
﻿namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexEntryPoint]
        public void PUT_SortContract([PexAssumeUnderTest] ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            arrList.Sort();
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that array list count is not changed after a sort operation.
            Debug.Assert(Old_arrListCount == New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that after sort operation, array list count is greater and equal to zero.
            Debug.Assert(New_arrListCount >= 0);
            
            // an assertion using "Debug.Assert\(.*?\);" that array list will be sorted.
            for (int i = 1; i < arrList.Count; i++)
                Debug.Assert((int)arrList[i - 1] <= (int)arrList[i]);

            // an assertion using "Debug.Assert\(.*?\);" that array list will be unique.
            for (int i = 1; i < arrList.Count; i++)
                Debug--------------------            Debug.Assert(Old_arrListCount != New_arrListCount);
            
            if (Old_arrListContainsX && arrList.Count < Old_arrListCount)
            {
                Debug.Assert(New_arrListContainsX == false);
            }

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list IndexOf(x) is not equal to -1 and is lesser than Old_arrListIndexOfX
            if (Old_arrListContainsX && New_arrListIndexOfX != -1) 
            {

                Debug.Assert(New_arrListIndexOfX < Old_arrListIndexOfX); 
            }

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list LastIndexOf(x) is greater than Old_arrListLastIndexOfX && is equal to New_arrListIndexOfX
            Debug.Assert(Old_arrListContainsX && arrList.LastIndexOf(x) > Old_arrListLastIndexOfX && arrList.LastIndexOf(x) == New_arrListIndexOfX);
        }
    }
}
```

### <a name="remarks"></a>설명

이 선언의 대상 테스트 메서드는 `PUT_RemoveContract` 메서드입니다. 다음은 이 메서드의 기대 동작입니다.

* `Old_arrListCount`는 메서드 전에 대상 ArrayList의 길이(Count)입니다. `New_arrListCount`는 동일한 ArrayList의 수정 후 길이입니다. 즉, ArrayList에서 하나의 항목을 제거하면 Count가 1 줄어듭니다.

* `Old_arrListIndexOfX` 및 `Old_arrListLastIndexOfX`는 `x`가 ArrayList에서 처음으로 발견되거나 마지막으로 발견된 인덱스입니다. 이 값이 메서드 후에 `x`가 ArrayList에 존재하지 않았다면 -1이 됩니다.

* `New_arrListIndexOfX` 또는 `New_arrListLastIndexOfX`가 `x`의 값보다 작은지 확인함으로써 ArrayList에서 `x`를 제거했을 때 `x`보다 높은 인덱스에 있는 기존의 항목이 따라오는지 확인할 수 있습니다. `x`가 ArrayList에 없는 경우 `IndexOf` 또는 `LastIndexOf`가 -1이 �--------------------	    
            if (Old_arrListCount > 0)
            {
                Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
                if (Old_arrListContainsX)
                {
                    Assert.AreEqual(-1, New_arrListIndexOfX);
                    Assert.AreNotEqual(-1, New_arrListLastIndexOfX);
                    Assert.IsFalse(New_arrListContainsX);
                }
                else
                {
                    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
                    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
                    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
                }
	    }
        }
    }
}

//TestProject/ContractTests/ArrayListContractTest - RemoveAt.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Collections;
using NUnit.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        // [PexMethodUnderTest("Remove")]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            object Old_arrListItemByIndex = arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            object New_arrListItemByIndex = (index < arrList.Count) ? arrList[index] : null;


            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_itemByIndex", Old_arrListItemByIndex);
            PexObserve.ValueForViewing("$new_arrList_itemByIndex", New_arrListItemByIndex);

            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
            Assert.AreEqual(Old_arrListItemByIndex, New_arrListItemByIndex);
        }
    }
}

