//ArrayList.Test/ArrayListUnitTest.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using ArrayList.Library;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListUnitTest
    {
        [TestMethod]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            arrList.Insert(1, 15);
            Assert.AreEqual(arrList[1], 15);
            Assert.AreEqual(arrList.Count, 4);
        }
        
        [TestMethod]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            arrList.Remove(20);
            Assert.AreEqual(arrList.Count, 2);
        }
        
        [TestMethod]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            Assert.IsTrue(arrList.Contains(20));
            Assert.IsFalse(arrList.Contains(40));
        }

        [TestMethod]
        public void TestClear()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            arrList.Clear();
            Assert.AreEqual(arrList.Count, 0);
        }
    }
}

//ArrayList/Program.cs
﻿using System;
using ArrayList.Library;
using System.Collections;

namespace ArrayList
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Hello World!");

            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            arrList.Insert(1, 15);
            arrList.Remove(20);

            foreach(var n in arrList)
            {
                Console.WriteLine(n);
            }

            Console.WriteLine(arrList.Contains(15));
            
            arrList.Clear();

            Console.WriteLine(arrList.Count);
        }
    }
}

//ArrayList.Test/ArrayListContractUnitTest.cs
﻿using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using ArrayList.Library;
using Microsoft.Pex.Framework;
using System;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractUnitTest
    {
      [TestMethod]     
      [PexMethod]
    public void ArrayList_Insert_Contract([PexAssumeValid]ArrayList arrList, [--------------------            Debug.Assert(Old_arrListIndexOfX <= index && index <= Old_arrListLastIndexOfX);

        }
    }
}

Note: It's just a basic test, more complex data structures will require more sophisticated verification methods. Plus, your ArrayList Contract Test depends on what ArrayListContractAttribute you use, because it contains some critical attributes, you may need to tweak this part.

And you should be familiar with the usage of these frameworks, such as Arrange, Act, Assert in unit testing.

Also, if there is no Pex library in your project, you should add this reference to you project. 

In summary, Pex is a tool that allows you to create random and meaningful input values for tests by using mutation analysis to refine and improve tests. This process increases test coverage.

Pex works in addition to a normal unit test, not replace it. Pex doesn't provide a complete replacement because of the complex interactions of various dependencies with each other. Pex should be used in combination with your unit tests.

Pex makes black-boxtesting more realistic and effective by providing interesting test cases based on the structure and complexity of the code under test.

For more details and examples, you may refer to https://msdn.microsoft.com/en-us/library/dn439713.aspx.
=======
﻿using System.Collections.Generic;
using System.Linq;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayListProject
{
    [TestClass]
    public class ArrayListContractTest
    {
        [ContractTestCase]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            arrList.Insert(index, x);
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);

	    // an assertion using "Assert.IsTrue\(.*?\);" that  index of x in new array is exactly same as the input index  
            Assert.IsTrue(New_arrListIndexOfX == index);

        }
    }
}

In this contract test, the inputs are an ArrayList, an integer x, and an index. We first assume that the index is within the bounds of the ArrayList's current size. We then perform the Insert operation on the ArrayList using the given inputs.

We observe the old and new counts of the ArrayList to verify that the count has increased by one as expected. We then observe the index of x in the ArrayList and verify that it matches the provided index. The index of x should be the position where the element was inserted, so the ArrayList should report the same index as the input.
=======
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System;
using System.Collections;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        [ContractTestCase]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int value, int index)
        {
            Assume.True(index <= arrList.Count); // Index is within the range of arrList's current size

            arrList.Insert(index, value); // Insert operation
            arrList.Contains(value); // Check if value is in arrList
            arrList.Count; // Observe the count of arrList
            arrList.IndexOf(value); // Observe the index of the inserted value

            // Assert that the IndexOf the inserted value equals to index
            Assert.AreEqual(index, arrList.IndexOf(value));
            // Assert that the count of ArrayList is same as its initial count plus 1
            Assert.AreEqual(arrList.Count - 1, arrList.Count);
            // Assert that the inserted value is in the ArrayList
            Assert.--------------------	    EnsuresOnTopPath(arrList.IndexOf(x) >= Old_arrListIndexOfX);
	    
            // An invariant property that ensures the element count has increased by 1
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            
            // An invariant property that ensures X is found at position index
            Assert.AreEqual(x, arrList[index]);

            // An invariant property that ensures the index of x is between the old and new Count
            Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX && New_arrListIndexOfX <= Old_arrListCount);

            // An invariant property that ensures the last index of x is between the old and new Count
            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX && New_arrListLastIndexOfX <= Old_arrListCount);

            // An invariant property that ensures the x is contained in the array list
            Assert.IsTrue(New_arrListContainsX);

        }
    }
}

The first Assert statement is self-explanatory. The Assert.AreEqual checks that the addition of one element did indeed increase the count by one. The Assert.AreEqual for the Assert.AreEqual checks that the inserted element is indeed found at the specified index.

The remaining Assert statements ensure that the IndexOf and LastIndexOf methods provide the correct results, i.e., that they provide a position in the interval [0, N], where N is the current count of the ArrayList.

Lastly, the Assert.IsTrue checks that the Contains method returns true whenever x is in the ArrayList.

Remember, these tests should only be run on a debugging version of the application as the invariant property Assert.AreEqual(x , arrList[index]) can fail in the release version of the application for certain inputs due to the nature of the List<T> and ArrayList's implementation.

Please note that these are partial tests for now, because the full coverage is quite complex and for beginners. We have tested only one scenario. The array list contains some assumptions that should be checked if they are correct or not. 

In case you have any more scenarios that you would like to test, please, provide and I'll be happy to help.

NOTE: In practice, Pex would typically run hundreds of test cases, so the above is overly simplistic and illustrative instead of exhaustive. Also, Pex is much more than a testing tool, and its real power comes from working with the test suite generated by Pex. That includes, but is not limited to, auto-generating boundary values, complex data structures (like trees, graphs, etc.), and fuzz testing.

Please, tell me if you want more.

Here it is:

```csharp
[TestMethod]
public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrayList, int x, int index)
{
    Assume.That(index <= arrayList.Count && index >= 0);
    
    int oldCount = arrayList.Count;
    
    arrayList.Insert(index, x);
    
    int newCount = arrayList.Count;
    int oldIndexOfX = arrayList.IndexOf(x);
    int newIndexOfX = arrayList.IndexOf(x);
    bool containsX = arrayList.Contains(x);

    Assert.AreEqual(oldCount + 1, newCount);
    Assert.AreEqual(x, arrayList[index]);
    Assert.IsTrue(newIndexOfX >= oldIndexOfX && newIndexOfX <= oldCount);
    Assert.IsTrue(containsX);
    // add more tests here if needed
}
```

NOTE: There are some quirks about Pex and code coverage that will be easier to fix in the C# compiler itself. As of yet, the latest version doesn't always catch every potential code path that Pex might be analyzing, so you'll often have to adjust your code manually.

NOTE: The Pex team has decided to discontinue its support for this version of Visual Studio and for new projects. Consider upgrading to .Net framework version 4.5/.Net core/.Net 5, which are more recent and have full support from Microsoft and the Pex team.

## Unit Testing 101

Unit testing is about testing of the smallest testable part of an application, the module. Each unit test should verify a small, well-defined functionality of your software.

