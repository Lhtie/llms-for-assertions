using ArrayList;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System;
using System.Linq;
using System.Collections.Generic;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListUnitTest
    {
        [TestMethod]
        public void ArrayListConstructorTest()
        {
            ArrayList arrList = new ArrayList();
            Assert.AreEqual(0, arrList.Count);
        }

        [TestMethod]
        public void ArrayListAddTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(1, arrList[0]);
        }

        [TestMethod]
        public void ArrayListInsertTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Insert(0, 0);
            Assert.AreEqual(3, arrList.Count);
            Assert.AreEqual(0, arrList[0]);
            Assert.AreEqual(1, arrList[1]);
            Assert.AreEqual(2, arrList[2]);
        }

        [TestMethod]
        public void ArrayListRemoveAtTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.RemoveAt(0);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(2, arrList[0]);
        }

        [TestMethod]
        public void ArrayListClearTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }

        [TestMethod]
        public void ArrayListContainsTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsFalse(arrList.Contains(2));
        }

        [TestMethod]
        public void ArrayListIndexOfTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(-1, arrList.IndexOf(2));
        }

        [TestMethod]
        public void ArrayListLastIndexOfTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(1);
            Assert.AreEqual(0, arrList.LastIndexOf(1));
            Assert.AreEqual(2, arrList.LastIndexOf(2));
        }
    }
