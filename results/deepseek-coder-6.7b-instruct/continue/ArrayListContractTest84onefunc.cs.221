//ArrayList/Test/ArrayListContractTest/PUT_RemoveAtContract.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using NUnit.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            object OldItem = arrList[index];  // element that would be removed

            int Old_arrListCount = arrList.Count;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            Assume.That<int>((i) => i >= 0 && i <= Old_arrListCount);

            Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount - 1));  // count decreases by 1 after RemoveAt

            // check if the element that would be removed is already in list after remove
            Assert.That(!arrList.Contains(OldItem), Is.True);  
        }
    }
}

//ArrayList/Test/ArrayListContractTest/PUT_RemoveContract.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using NUnit.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            int Old_arrListCount = arrList.Count;

            bool wasRemoved = arrList.Remove(obj);

            int New_arrListCount = arrList.Count;

            Assert.That(wasRemoved, Is.EqualTo(arrList.Contains(obj))); // after remove, whether ArrayList contains the object
            Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount - (wasRemoved ? 1 : 0)));
        }
    }
}

