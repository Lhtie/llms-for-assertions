using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveAtContract([PexAssumeUnderTest] ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListCapacity = arrList.Capacity;
            
            object item = arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = arrList.Capacity;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity);
            PexObserve.ValueForViewing("$removed_item", item);

            AssumePostcondition.IsTrue(New_arrListCount == Old_arrListCount - 1);
            AssumePostcondition.IsTrue(New_arrListCapacity >= Old_arrListCapacity);
        }
    }
}

//src/Tests/ArrayList.Test/ArrayListContractTest.RemoveRange.cs
﻿// Copyright (c) Microsoft. All rights reserved.
// Licensed under the MIT license. See LICENSE file in the project root for full license information.

using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveRangeContract([PexAssumeUnderTest] ArrayList arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(index >= 0 && (count >= 0 && count <= arrList.Count - index));
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListCapacity = arrList.Capacity;

            arrList.RemoveRange(index, count);

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = arrList.Capacity;

            AssumePostcondition.IsTrue(New_arrListCount == Old_arrListCount - count && New_arrListCapacity >= Old_arrListCapacity);
        }
    }
}

