namespace ArrayList
{
    [PexClass(typeof(ArrayList))]
    [PexGenerateEquality]
    public partial class ArrayListEqualityTest
    {
        [PexMethod]
        [PexExplore]
        public void EqualsTest(ArrayList x, ArrayList y)
        {
            bool isEqual = ArrayList.Equals(x, y);
            if (isEqual == true)
            {
                //If the objects are equal, the following conditions must be met
                //1) They must be not null
                if ((x == null && y != null) || (x != null && y == null))
                {
                    isEqual = false;
                }
                //2) Their count of elements must be the same
                else if (x.Count != y.Count)
                {
                    isEqual = false;
                }
                //3) Their elements must be identical at corresponding positions
                else
                {
                    for (int i = 0; i < x.Count; i++)
                    {
                        if (!x[i].Equals(y[i]))
                        {
                            isEqual = false;
                            break;
                        }
                    }
                }
            }
            Assert.AreEqual(isEqual, x.Equals(y));
        }

        [PexMethod]
        [PexExplore]
        public void GetHashCodeTest(ArrayList x)
        {
            ArrayList.GetHashCode(x);

            // The GetHashCode implementation is defined to return the count of items in the list
            // Thus, two lists with the same content should have the same hashcode
            if (x != null)
            {
                ArrayList sameList = new ArrayList();
                for (int i = 0; i < x.Count; i++)
                {
                    sameList.Add(x[i]);
                }
                Assert.AreEqual(x.GetHashCode(), sameList.GetHashCode());
            }
        }
    }
