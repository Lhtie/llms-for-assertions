using System;
using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using System.Linq;

namespace PexAPIWrapper
{
    public static class PexAPI
    {
        public static void Test([PexAssumeUnderTest]Int32[] a) 
        {
            AssumePrecondition.IsFalse(a.Length < 2); 

            int x = a[0];
            
            int old_Count = a.GetLength(a.Rank - 1);
            int old_IndexOfX = Array.IndexOf(a, x);
            int old_LastIndexOfX = Array.LastIndexOf(a, x);

            Array.Reverse(a); 

            int new_Count = a.GetLength(a.Rank - 1);
            int new_IndexOfX = Array.IndexOf(a, x);
            int new_LastIndexOfX = Array.LastIndexOf(a, x);

            PexObserve.ValueForViewing("$old_Array_Count", old_Count);
            PexObserve.ValueForViewing("$new_Array_Count", new_Count);
            PexObserve.ValueForViewing("$old_Array_IndexOf_x", old_IndexOfX);
            PexObserve.ValueForViewing("$new_Array_IndexOf_x", new_IndexOfX);
            PexObserve.ValueForViewing("$old_Array_LastIndexOf_x", old_LastIndexOfX);
            PexObserve.ValueForViewing("$new_Array_LastIndexOf_x", new_LastIndexOfX);

            Postcondition.IsTrue(new_Count == old_Count);--------------------        }
    }

}

//Tests/ArrayList.Test/ArrayListContractTest_Stress.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest_Stress
    {
        [PexMethod, PexExploration, PexAssemblyTimeout(2000)]
        public object PUT_AddStress([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListLastIndex = arrList.LastIndexOf(obj);
            bool Old_arrListContains = arrList.Contains(obj);

            arrList.Add(obj);

            int New_arrListCount = arrList.Count; 
            int New_arrListLastIndex = arrList.LastIndexOf(obj);
            bool New_arrListContains = arrList.Contains(obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$New_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_LastIndex", Old_arrListLastIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndex", New_arrListLastIndex);
            PexObserve.ValueForViewing("$old_arrList_Contains", Old_arrListContains);
            PexObserve.ValueForViewing("$new_arrList_Contains", New_arrListContains);

            for (int i = 0; i < 1000; i++)
            {
                arrList.Add(obj);
            }

            int New_arrListCount_Stress = arrList.Count;

            PexObserve.ValueForViewing("$New_arrList_Count_Stress", New_arrListCount_Stress);

            arrList[arrList.Count - 1] = obj;

            return obj;
        }

        [PexMethod, PexExploration, PexAssemblyTimeout(2000)]
        public object PUT_RemoveStress([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListLastIndex = arrList.LastIndexOf(obj);
            bool Old_arrListContains = arrList.Contains(obj);

            arrList.Remove(obj);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndex = arrList.LastIndexOf(obj);
            bool New_arrListContains = arrList.Contains(obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_LastIndex", Old_arrListLastIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndex", New_arrListLastIndex);
            PexObserve.ValueForViewing("$old_arrList_Contains", Old_arrListContains);
            PexObserve.ValueForViewing("$new_arrList_Contains", New_arrListContains);

            for (int i = 0; i < 1000; i++)
            {
                arrList.Remove(obj);
            }

            int New_arrListCount_Stress = arrList.Count;

            PexObserve.ValueForViewing("$new_arrList_Count_Stress", New_arrListCount_Stress);

            return obj;
        }
    }
}

