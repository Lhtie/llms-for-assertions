            // If x is not in old array, assert that arrList's count did not change
            if (Old_arrListContainsX)
            {
                Assert.AreEqual(Old_arrListLastIndexOfX, New_Ret);
            }
            else
            {
                Assert.AreEqual(Old_arrListCount, New_arrListCount);
