	    // or if the return value is negative, x is not in the old array.  
	    // also, the array list index of x should be the positive return value.
	    Debug.Assert(New_Ret < 0 || Old_arrListContainsX);
	    Debug.Assert(New_Ret == Old_arrListLastIndexOfX);
	    Debug.Assert(New_Ret == arrList[New_Ret]);
	    PexObserve.ValueForViewing("$assertion_passed", "passed");
        }
    }
}
```

