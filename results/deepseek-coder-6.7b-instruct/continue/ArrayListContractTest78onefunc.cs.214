//NUnitTests/ArrayListContractTest.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.StaticValidation;
using System;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;
using ArrayList;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    public class ArrayListContractTest
    {

        
        [PexMethod(typeof(Object), Exclude=new Type[] {typeof(NotImplementedException)})]
        void ArrayListIndexOfContract(ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsObj = arrList.Contains(obj);

            int New_Ret = arrList.IndexOf(obj);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsObj = arrList.Contains(obj);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, obj is in the old 
            // array list. If obj is not found in the array list, the return value is negative.
            Debug.Assert((New_Ret >= 0 && Old_arrListContainsObj)||(New_Ret<0 && !Old_arrListContainsObj));

            // an assertion using "Debug.Assert\(.*?\);" that  the return value is non-negative.
            Debug.Assert(New_Ret>=0);

            // an assertion using "Debug.Assert\(.*?\);" that  the count after the add and index of is the same.
            Debug.Assert(New_arrListCount == Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  index of obj is not larger than the count of array list.
            Debug.Assert(New_Ret <= New_arrListCount);

        }
    }
}

//NUnitTests/AddRangeContractTest.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.StaticValidation;
using System;
using System.Collections;
using System.Collections.Generic;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExploration(MaxConstraintSolverTime = 1000)]
        public void AddRangeContract([PexAssumeUnderTest]ArrayList list, ICollection c) 
        {
           AssumePrecondition.IsTrue(true);            

           int oldCount = list.Count;
           list.AddRange(c);

           bool cond = (list.Count == oldCount + c.Count);           

           PexObserve.ValueForViewing("$oldCount",oldCount);
           PexObserve.ValueForViewing("$newCount",list.Count);
           PexObserve.ValueForViewing("$cCount",c.Count);

           AssumePostcondition.IsTrue(cond);
        }
    }
}

