namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            bool Old_arrListContainsX = arrList.Contains(x);
            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsXAfterAddingX = AddItem(arrList, x);
            int Old_arrListIndexOfXAfterAddingX = arrList.IndexOf(x);
            bool Old_arrListRemoveXAfterAddingX = RemoveItem(arrList, x);

            bool New_Ret = arrList.Contains(x);
            int New_arrListCount = arrList.Count;
            bool New_arrListContainsXAfterRemovingX = arrList.Contains(x);
            int New_arrListIndexOfXAfterRemovingX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$old_arrList_Contains_x_afterAdding_x", Old_arrListContainsXAfterAddingX);
            PexObserve.ValueForViewing("$old_arrList_indexof_x_afterAdding_x", Old_arrListIndexOfXAfterAddingX);
            PexObserve.ValueForViewing("$old_arrList_Contains_x_afterRemoving_x", Old_arrListRemoveXAfterAddingX);
            PexObserve.ValueForViewing("$new_arrList_Contains_x", New_Ret);
            PexObserve.ValueForViewing("$new_arrList_Contains_x_afterRemoving_x", New_arrListContainsXAfterRemovingX);
            PexObserve.ValueForViewing("$new_arrList_indexof_x_afterRemoving_x", New_arrListIndexOfXAfterRemovingX);

            throw new PexPendOnException();
        }

        private bool AddItem(ArrayList arr, int x)
        {
            arr.Add(x);
            return arr.Contains(x);
        }

        private bool RemoveItem(ArrayList arr, int x)
        {
            arr.Remove(x);
            return !arr.Contains(x);
        }
    }
