﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Graph
{
    public class Vertex<T>
    {
        public T Value { get; set; }
        public Dictionary<Vertex<T>, int> Connections { get; set; }

        public Vertex(T value)
        {
            this.Value = value;
            this.Connections = new Dictionary<Vertex<T>, int>();
        }

        public void AddConnection(Vertex<T> vertex, int weight = 1)
        {
            this.Connections[vertex] = weight;
        }
    }
}

