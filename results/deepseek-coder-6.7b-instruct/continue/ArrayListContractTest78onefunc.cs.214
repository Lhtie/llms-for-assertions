            // assertion that if x is in old array, new array list's count remains the same and the last index of x in the array list 
            // and new ret is greater than or equal to old index of x found in the list.
            if (Old_arrListContainsX)
            {
                Assert.AreEqual(Old_arrListCount, New_arrListCount);
                Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
                Assert.IsTrue(New_Ret >= Old_arrListLastIndexOfX);
            }
        }
    }
}
