{
    public class BinaryTree
    {
        public Node Root { get; set; }

        public bool Add(int value)
        {
            if(Root == null)
            {
                Root = new Node(value);
                return true;
            }
            else
            {
                return Root.Add(value);
            }
        }

        public bool Contains(int value)
        {
            if(Root == null)
            {
                return false;
            }
            else
            {
                return Root.Contains(value);
            }
        }
    }
