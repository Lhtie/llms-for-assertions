namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.IndexOutOfRangeException")]
    public partial class ArrayListContractTest
    {
        public void GET_ItemContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            object Old_obj = arrList[index];
            object New_obj = arrList[index];

            PexObserve.ValueForViewing("$old_obj", Old_obj);
            PexObserve.ValueForViewing("$new_obj", New_obj);

            // Assert that @@@ The returned value is non-null if old value was non-null and equals to the new value
            Debug.Assert
                (
                (New_obj != null && Old_obj != null)
                ?
                (ReferenceEquals(New_obj, Old_obj))
                :
                (New_obj == Old_obj)
                );
        }

        [PexMethod(MaxPassingTestCount = 10, MaxFailingTestCount = 5)]
        public void GET_ItemTests(ArrayListSource arrListSource, int index)
        {
            ArrayList arrList = arrListSource.ArrayList;
            PexObserve.ValueForViewing("Original ArrayList:", arrList.ToString());
            PexAssume.NotNull(arrList);
            PexAssume.IsTrue(index >= 0 && index < arrList.Count); // To make sure the ArrayList not empty

            // call the @Target method
            PexRunUnderTest.InvokeAllMethods();
        }
    }
