//ArrayList.Test/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Constraints;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExplore(1000)]
        public void PUT_IndexOf_Contract([PexAssumeValid] IList arrList, int index)
        {
            Assume.That(index, IsBetween(0, arrList.Count - 1));

            if (arrList.Count == 0) Assert.AreEqual(-1, arrList.IndexOf(index));
            else Assert.AreEqual(index, arrList.IndexOf(arrList[index]));
        }

        [PexMethod]
        [PexExplore(1000)]
        public void PUT_Contains_Contract(ArrayList arrList, object value)
        {
            bool oldContains = arrList.Contains(value);
            arrList.Add(value);
            bool newContains = arrList.Contains(value);

            Assert.AreNotEqual(oldContains, newContains);
        }
    }
}

