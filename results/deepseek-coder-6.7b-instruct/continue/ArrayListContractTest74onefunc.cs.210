	    // but since we are adding elements in arrList it could change even if arrList doesn't contain x, count could get bigger and new arrList's last index could be bigger than prev one
	    PexObserve.AssertionForViewing("$assert_last_index", (New_Ret >= 0) == (New_arrListLastIndexOfX <= Old_arrListCount));

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ If old arrList contains x, new array list's contains x should be true
	    PexObserve.AssertionForViewing("$assert_contains", Old_arrListContainsX == New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ if x is contained in old arrList, new array list's count should be the same as old array list's
            PexObserve.AssertionForViewing("$assert_count", Old_arrListContainsX == (Old_arrListCount == New_arrListCount));
         }
    }
}

