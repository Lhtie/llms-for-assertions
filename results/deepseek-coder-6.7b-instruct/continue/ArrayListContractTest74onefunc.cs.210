Code Contracts uses Pex to generate a large number of test cases to ensure your code conforms to the contracts you have defined. Pex stands for Practical Extensible Contracts and is used to automatically generate inputs for your methods to test. By applying Pex on your methods and--------------------            Assert.True(New_arrListCount >= New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ This must be false if the old array list does contains x
            if(Old_arrListContainsX)
                Assert.False(New_Ret >= 0);
            

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ Post condition x's old array list's last index must equals to new array list returned index, if it's in the collections
            if(Old_arrListLastIndexOfX >= 0)
                Assert.Equal(Old_arrListLastIndexOfX, New_Ret);

            // an assertion using   "Debug.Assert\(.*?\);" that  @@@ If x is added to array list, count increases by 1, last index of x is +1
	    
	     Assert.Equal(New_arrListCount, Old_arrListCount+1);
	     Assert.Equal(New_arrListLastIndexOfX, Old_arrListLastIndexOfX+1);
        }
    }
}

//test/xUnit/ArrayList/Test/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System;
using System.Collections;
using Xunit;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedException(typeof(ArgumentOutOfRangeException))]
    [PexAllowedException(typeof(ArgumentNullException))]
    [PexMethodUnderTest("System.Collections.ArrayList.Add")]
    [PexMethodUnderTest("System.Collections.ArrayList.Insert")]
    [PexMethodUnderTest("System.Collections.ArrayList.Remove")]
    [PexMethodUnderTest("System.Collections.ArrayList.IndexOf")]
    public partial class ArrayListContractTest
    {
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int number)
        {
            int OldSize = arrList.Count;
            arrList.Add(number);
            int NewSize = arrList.Count;
            
            Assert.True(NewSize == OldSize + 1);
            Assert.True(arrList.Contains(number));
        }
        
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, int number)
        {
            int OldSize = arrList.Count;
            arrList.Insert(index, number);
            int NewSize = arrList.Count;
            
            Assert.True(NewSize == OldSize + 1);
            Assert.True(arrList[index] == number);
        }

        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int number)
        {
            int OldSize = arrList.Count;
            arrList.Remove(number);
            int NewSize = arrList.Count;
            
            Assert.True(NewSize == OldSize - 1);
            Assert.False(arrList.Contains(number));
        }

        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int number)
        {
            int index = arrList.IndexOf(number);
            Assert.True(index >= 0 && index < arrList.Count);
            Assert.True(arrList[index] == number);
        }
    }
}

