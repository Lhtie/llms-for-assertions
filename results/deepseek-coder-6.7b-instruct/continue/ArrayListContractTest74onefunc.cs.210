    {
        [TestMethod]
        public void TestInitializeDefaultSize()
        {
            // Arrange
            ArrayListImpl arrList = new ArrayListImpl();

            // Act
            int size = arrList.Count;

            // Assert
            Assert.AreEqual(0, size);
        }

        [TestMethod]
        public void TestAddItems()
        {
            // Arrange
            ArrayListImpl arrList = new ArrayListImpl();
            int numItems = 10;

            // Act
            for (int i = 0; i < numItems; i++)
            {
                arrList.Add(i);
            }

            // Assert
            Assert.AreEqual(numItems, arrList.Count);
        }

