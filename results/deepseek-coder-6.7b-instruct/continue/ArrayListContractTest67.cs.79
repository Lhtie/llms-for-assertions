namespace Task1
{
    class Program
    {
        static void Main(string[] args)
        {

            Console.Write("Enter a number: ");
            string input = Console.ReadLine();
            int number;
            bool success = Int32.TryParse(input, out number);
            if (!success) Console.WriteLine("That is not an integer!");
            else
            {
                List<int> factors = Factors(number);
                Console.WriteLine($"The factors of {number} are:");
                foreach (var item in factors)
                {
                    Console.WriteLine($"{item}");
                }
            }

            Console.ReadLine();
        }

        public static List<int> Factors(int number)
        {
            List<int> factors = new List<int>();
            for (int i = 1; i <= number / 2; i++)
            {
                if (number % i == 0)
                {
                    factors.Add(i);
                }
            }
            factors.Add(number);
            return factors;
        }
    }
}using UnityEngine;

public enum ResourceType
{
    Money,
    Food,
    Wood,
    Stone,
    Metal
}

public class Resource : MonoBehaviour
{
    [SerializeField] private ResourceType type;
    [SerializeField] private int amount;

    public ResourceType Type => type;
    public int Amount => amount;

    public void Collect(int value)
    {
        if(amount - value > 0)
        {
            amount -= value;
        }
        else
        {
            Destroy(gameObject);
        }
    }
