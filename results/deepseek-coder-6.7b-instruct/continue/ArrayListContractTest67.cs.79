public class Builder : MonoBehaviour
{
    [SerializeField] private List<Building> buildings = new List<Building>();
    [SerializeField] private int woodCosts = 50;
    
    private Camera mainCamera;

    private void Start()
    {
        mainCamera = Camera.main;
    }
    
    private void Update()
    {
        if (CanBePlaced())
        {
            RenderPlacement();

            if (Input.GetMouseButtonDown(0))
            {
                TryToBuild();
            }
        }
        else if (buildings.Any())
        {
            RemoveRenderPlacement();
        }
    }

    private bool CanBePlaced()
    {
        Plane plane = new Plane(Vector3.up, 0);
        Ray ray = mainCamera.ScreenPointToRay(Input.mousePosition);

        if(plane.Raycast(ray, out float position))
        {
            Vector3 worldPoint = ray.GetPoint(position);

            if (worldPoint.y <= 0 && buildings.Any() && buildings.First().IsPlacementFree(worldPoint))
            {
                return true;
            }
        }
