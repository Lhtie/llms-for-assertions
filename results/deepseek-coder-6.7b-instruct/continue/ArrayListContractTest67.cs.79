        public void Add_Method_Test()
        {
            ArrayList list = new ArrayList();
            list.Add('1');
            Assert.AreEqual(list[0],'1');
        }

        [Test]
        public void Count_Property_Test()
        {
            ArrayList list = new ArrayList();
            list.Add('1');
            Assert.AreEqual(list.Count, 1);
        }

        [Test]
        public void IndexOf_Method_Test()
        {
            ArrayList list = new ArrayList();
            list.Add('1');
            Assert.AreEqual(list.IndexOf('1'), 0);
        }

        [Test]
        public void Insert_Method_Test()
        {
            ArrayList list = new ArrayList();
            list.Insert(0, '1');
            Assert.AreEqual(list[0], '1');
        }

        [Test]
        public void Remove_Method_Test()
        {
            ArrayList list = new ArrayList();
            list.Add('1');
            list.Remove('1');
            Assert.AreEqual(list.Count, 0);
        }
    }
}

