            bool TestAssertion = (New_Ret < 0) ? !New_arrListContainsX : true;
            AssumePrecondition.IsTrue(TestAssertion);
	    // This is because negative values returned by the indexOf function indicate that the specified item is not present in the list.

	}

        }
    }
