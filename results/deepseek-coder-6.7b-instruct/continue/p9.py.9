    assert any(account.money >= amnt for account in frm.accounts), 'Not enough money on accounts'

    # find the account where we got the money from
    src_account = next(account for account in frm.accounts if account.money >= amnt)

    # deduct the amount
    src_account.money -= amnt

    # add to the target account
    to.accounts[0].money += amnt

    print(f'{frm.name} transferred {amnt} to {to.name}')


