import threading
class Account:
    def __init__(self, money):
        self.money = money
        self.lock = threading.Lock()

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    assert any(acc.money > amnt for acc in frm.accounts), f"Not enough money in {frm.name}'s accounts"
    assert frm is not to, "Don't send money to yourself!"
    
    acc1 = next(acc for acc in frm.accounts if acc.money > amnt and acc.lock.acquire(timeout=1)) 
    # select an account with enough money and lock it
    if acc1 is not None:
        time.sleep(0.01)    # let's give it some time to change 
        acc1.money -= amnt
        to.accounts[0].money += amnt
        acc1.lock.release()


