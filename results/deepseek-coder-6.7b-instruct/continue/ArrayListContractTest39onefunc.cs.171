//ArrayList.Tests/ArrayListRemoveTests.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using Microsoft.Pex.Framework;
using System.Collections.Generic;
using System;
using ArrayList;

namespace ArrayList.Test
{
	[TestClass]
	public class ArrayListRemoveTests
	{

		[PexMethod]
		public void RemoveAt_Test([PexAssumeValid]ArrayList arrList, int index)
		{
			if (arrList.Count < index || index < 0)
			{
                Assert.Fail("Index out of range");
			}

			if (index < arrList.Count)
			{
				object actual = arrList[index];

				arrList.RemoveAt(index);
				Assert.IsTrue(arrList.Count == (arrList.Count - 1));

				for (int i = index; i < arrList.Count; i++)
				{
					Assert.AreSame(actual, arrList[i]);
				}
			}
		}

        [PexMethod]
        public void Remove_object_Test([PexAssumeValid]ArrayList arrList, object obj)
        {
            if (obj == null)
            {
                Assert.Fail("Object parameter cannot be null");
            }

            if (arrList.Contains(obj))
            {
                int index = arrList.IndexOf(obj);
				arrList.Remove(obj);

                Assert.IsTrue(arrList.Count == (arrList.Count - 1));
                Assert.IsFalse(arrList.Contains(obj));

                for (int i = index; i < arrList.Count; i++)
                {
                    Assert.AreNotSame(obj, arrList[i]);
                }
            }
        }

        [PexMethod]
        public void RemoveAll_Test([PexAssumeValid]ArrayList arrList, object obj)
        {
            if (obj == null)
            {
                Assert.Fail("Object parameter cannot be null");
            }

            while (arrList.Contains(obj))
            {
                arrList.Remove(obj);
            }

            Assert.IsFalse(arrList.Contains(obj));
        }

	}
}

