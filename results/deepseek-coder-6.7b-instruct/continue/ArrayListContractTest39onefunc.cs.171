            Debug.Assert((Old_arrListLastIndexOfX <= index));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array x at index > old array count 
            Debug.Assert(Old_arrListCount < New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ first position of x in new array >= index 
            Debug.Assert((New_arrListIndexOfX >= index));

            PexObserve.ValueForViewing("$new_arrList_x_at_index", arrList[index]);

	// Assert on the conditions that you want to test
            //...
        }
    }
}


A: In your test code, you need to add 
[PexMethod]

This attribute is placed on the method that you want to have automated property tests on, and it tells the Pex engine to test your method as a hypothesis-driven property test.

PexMethod attribute tells the Pex engine which methods to test. If you don’t set the PexMethod attribute, the engine won’t run tests for them, even if the method is public and unit testable. So always include PexMethod for any method you wish to have Pex test your code.

Note: The PexSettings have been altered to ignore the array size as that is a static parameter being tested against.

The code then becomes:


[TestMethod]
[PexMethod]


public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, [PexAllowNull] int index, object x)
{


The results are that the test discovered potentially invalid code paths due to the Pex engine searching through various permutations of the inputs provided, hence, it helped improve the quality and performance of the code.

A: 
I am trying to test the PUT method from my class using Microsoft Fakes Framework and NUnit test but don't know how.
  

You need to use Microsoft Fakes Framework to create stub for the method you want to test. Here is a basic idea of how you can create a testing scenario like this:

public class YourTests
{
    [Test]
    public void PUT_SetContract_Test()
    {
        //Arrange
        var stubarrList = new StubArrayList();
        var x = <YourValue>;
        var index = <YourIndex>;
        stubarrList.SetReturnValue(<YourArrangeMethod>, x);        

        //Act
        arrList.Set(index, x);

        //Assert
        stubarrList.AssertMethodCalled(<YourAssertMethod>, index, x);
    }
}

Replace <YourValue>, <YourIndex>, <YourArrangeMethod> which you want to arrange in your code, and <YourAssertMethod> with method you want to check call of stub method.

It's not a full example, but it gives you an idea.
  
You must call appropriate methods you can find them using PexAnalyzer or Reflector tool.

There are a lot of online resources available about creating stubs and shims in Microsoft Fakes Framework. You might want to find "Fakes, Stubs, and Mock Objects in .NET" code lab on MSDN. Also it might be helpful to have a look at this video tutorial which helped me to understand this concept.

Remember that Microsoft Fakes is only available in the Visual Studio 2012 and 2013 versions and not available for earlier versions. 

Hope this helps. If you need more clarification you can ask.

Please note: Fakes should be used along with other techniques like CodeContracts to create unit tests. It's not a replacement for unit testing and will not always detect every problem. Make sure to add tests for all unit tests you create with fakes.

Hope this clears your doubt.

Thanks...

A: The Pex and Fakes are both tools from Microsoft, and used for Test Driven Development. They are used to help generate meaningful tests cases and can generate meaningful tests for a broader class of problems than just simple unit testing.

While they can be used together, they do not always provide mutually reliable, or even overlapping results for complex tests.

Fakes often provides the basic skeleton of tests where the input(s) and output(s) are stubbed, and the "real" logic is either hard-coded or st--------------------            int x_pos_old = Old_arrListIndexOfX;
            int x_pos_new = New_arrListLastIndexOfX;
            //Debug.Assert(x_pos_old <= x_pos_new);

            // an assertion for the same but new position
            Debug.Assert(Old_arrListCount == New_arrListCount);
            Debug.Assert(Old_index == New_arrListIndexOfX);

            // an invariant for the list count
            Debug.Assert(New_arrList_Count == Old_arrListCount);
        }
    }
}//PexCustomTracks/ArrayList.Test/RemoveAtContractTest.cs
﻿using Microsoft.Pex.Framework;
using System.Collections;

namespace ArrayList.Test
{
    [PexMethod(MaxRank = 2)]
    public partial class ArrayListContractTest
    {
        public void RemoveAtContract([PexAssumeValid]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            object item = arrList[index];
            arrList.RemoveAt(index);

            PexObserve.ValueForViewing("$old_arrList_index", index);
            PexObserve.ValueForViewing("$old_arrList_item", item);
            PexObserve.ValueForViewing("$new_arrList_count", arrList.Count);

            // an invariant that shows that the count of the list is reduced by 1 as we remove an item
            Debug.Assert(arrList.Count == index);
        }
    }
}

//PexTests/Test.cs
﻿using Moq;
using System;
using System.Collections;
using ArrayList.Test;
using NUnit.Framework;

namespace PexTests
{
    [TestFixture]
    public class Test
    {
        private MockRepository mockRepository;

        [SetUp]
        public void SetUp()
        {
            this.mockRepository = new MockRepository(MockBehavior.Strict);
        }

        [TearDown]
        public void TearDown()
        {
            this.mockRepository.VerifyAll();
        }

        [Test]
        public void TestPexRemoveAt()
        {
            // Arrange
            var arrListMock = this.mockRepository.Create<ArrayList>();
            arrListMock.SetupGet(x => x.Count).Returns(5);
            arrListMock.Setup(x => x.RemoveAt(It.IsAny<int>())).Callback<int>((index) =>
            {
                // Action on the mock: remove the element at the specified index
                Assert.IsTrue(0 <= index && index < arrListMock.Object.Count); // checks whether index is in range
                arrListMock.Object.RemoveAt(index);
            });

            // Act
            ArrayListContractTest t = new ArrayListContractTest();
            t.RemoveAtContract(arrListMock.Object, 3);

            // Assert
            arrListMock.Verify(x => x.RemoveAt(3), Times.Once());
        }
    }
