    # code inside the function attempting to transfer "amnt" money from "frm" to "to"

    return frm, to


def test_transfer():
    alice = Person('Alice')
    bob = Person('Bob')
    total_balance = sum([acc.money for acc in alice.accounts])
    result = transfer(alice.accounts, bob.accounts, total_balance // 2)

    assert result == (alice.accounts, bob.accounts)
