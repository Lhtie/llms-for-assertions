    assert p43(p43_coeffs) == 0
----------------------------------------    diffs = []
    l = len(p43_coeffs)

    for i in range(l-1):
        diffs.push_back(abs(p43_coeffs[i] - p43_coeffs[i+1]))

    return sum(diffs) <= 2*(l-1)

