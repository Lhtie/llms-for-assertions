assert sum(p43_coeffs) <= 1000, "Sum exceeds 1000"
--------------------    temp = p43_coeffs[0] - p43_coeffs[1]
    for i in range(n-1):
        temp_prev = temp
        temp = p43_coeffs[i] - p43_coeffs[i+1]
        if abs(temp_prev + temp) > 1:
            return false
    return true

n = int(input())
