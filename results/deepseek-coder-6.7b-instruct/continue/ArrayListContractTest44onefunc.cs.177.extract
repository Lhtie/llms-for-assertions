using ArrayList.Test.Properties;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveAtIndexTest([PexAssumeValid]ArrayList myList, int index)
        {
            AssumePrecondition.IsTrue(index < myList.Count && index >= 0);

            int old_myListCount = myList.Count;

            myList.RemoveAt(index);

            int new_myListCount = myList.Count;

            PexObserve.ValueForViewing("$old_myList_Count", old_myListCount);
            PexObserve.ValueForViewing("$new_myList_Count", new_myListCount);

            // an assertion using "Debug.Assert(.*?);" that new myList Count is one less than old myList Count
----------------------------------------           Debug.Assert(index != Old_arrListCount);
----------------------------------------	    Debug.Assert(index != Old_arrListCount);
--------------------	    // an assertion using "Debug.Assert\(.*?\);" that @@@ index passed in is not less than zero
            // an assertion using "Debug.Assert\(.*?\);" that @@@ index passed in is not more than the old array size

            // an assertion using "Debug.Assert\(.*?\);" that new array list count equals old array list count minus one
            // an assertion using "Debug.Assert\(.*?\);" that new result contains in array
            // an assertion using "Debug.Assert\(.*?\);" that new array list count doesn't equals old array list count

