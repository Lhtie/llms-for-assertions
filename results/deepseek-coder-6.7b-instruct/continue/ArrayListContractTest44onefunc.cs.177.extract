
            Assert.IsTrue(Old_arrListCount == New_arrListCount,
                          "The size of the array list does not have changed.");

           // an assertion using "Debug.Assert\(.*?\);" that the @@@ index passed in is not equal to the old index 
           Assert.IsTrue(Old_index == index,
                          "The index is the same as the old index.");

            // an assertion using "Debug.Assert(.*)==(.*)", that the returned value does not equal the New_ret value 
            Assert.IsTrue((int)arrList[index] == New_Ret,
                          "The returned value does not equal the New_ret value.");
----------------------------------------            Debug.Assert(!(Old_index == Old_arrListCount));
--------------------            Debug.Assert(old_arrList_Count != index);
--------------------
	    // an assertion using "Debug.Assert\(.*?\);" that index passed in is not less than 0

	    // an assertion using "Debug.Assert\(.*?\);" that index passed in is not greater than or equal  to New-arrListCount

	    // an assertion using "Debug.Assert\(.*?\);" that arrList returned by index exists in the array list 
        }
    }
}

