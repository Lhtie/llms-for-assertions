//Tests/Source/Contracts/AddContract.cs
﻿using System;
using ArrayList.Test;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Count <= int.MaxValue);

            int Old_arrListCount = arrList.Count;
            arrList.Add(x);
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            //an assertion using "Debug.Assert\(.*?\);" that  @@@ On the addition of the element, the size of list increases by 1 
            Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        }
        
    }
}

