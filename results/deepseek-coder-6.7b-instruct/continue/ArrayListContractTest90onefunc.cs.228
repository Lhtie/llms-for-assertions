//Examples/MauiTodoApp/MauiTodoApp/Data/Database.cs
﻿using MauiTodoApp.Models;
using SQLite;
using System.Collections.Generic;

namespace MauiTodoApp.Data
{
    public class Database
    {
        private SQLiteConnection _database;

        /// <summary>
        /// Initializes a new instance of the <see cref="Database"/> class.
        /// </summary>
        public Database()
        {
            _database = new SQLiteConnection(Constants.DatabasePath, Constants.Flags);
            _database.CreateTable<TodoModel>();
        }

        public List<TodoModel> GetItems()
        {
            return _database.Table<TodoModel>().ToList();
        }

        public TodoModel GetItem(int id)
        {
            return _database.Table<TodoModel>().FirstOrDefault(t => t.Id == id);
        }

        public int SaveItem(TodoModel item)
        {
            return _database.InsertOrReplace(item);
        }

        public int DeleteItem(int id)
        {
            return _database.Delete<TodoModel>(id);
        }
    }
}

