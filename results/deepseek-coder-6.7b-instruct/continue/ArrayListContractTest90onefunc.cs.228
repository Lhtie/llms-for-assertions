﻿using SQLite;

namespace MauiTodoApp.Models
{
    public class TodoModel
    {
        [PrimaryKey, AutoIncrement]
        public int Id { get; set; }
        public string Title { get; set; }

        public bool IsComplete { get; set; } = false;
