}using System;
using System.Linq;

public static class Kata
{
    public static int Enough(int cap, int on, int wait)
    {
        int freeSpace = cap - on;
        if (wait <= freeSpace)
        {
            return 0;
        }
        else
        {
            return (wait - freeSpace);
        }
    }
}using System;
using System.Linq;

public class Kata
{
    public static int CalculateYears(double principal, double interest,  double tax,  double desiredPrincipal)
    {
        int years = 0;
        while (principal < desiredPrincipal)
        {
            double interestAmount = principal * interest;
            double taxedAmount = interestAmount * tax;
            principal += interestAmount - taxedAmount;
            years++;
        }
        return years;
    }
}using System;

public class Kata
{
    public static bool IsPowerOfTwo(int n)
    {
        while (n > 1)
        {
            if (n % 2 != 0)
                return false;
            n /= 2;
        }
        return n == 1;
    }
}

//Other solution, using bitwise operations.
public class Kata
{
    public static bool IsPowerOfTwo(int n)
    {
        return n > 0 && (n & (n - 1)) == 0;
    }
}using System;  
using System.Linq;  

public class Kata 
{  
    public static string NbaCup(string resultSheet, int toYear) 
    {  
        var statsOverYears = resultSheet.Split("-")
            .Select(str => str.Split(" "))
            .Select(arr => new
            {
                Team = arr[0],
                Played = int.Parse(arr[1]),
                Won = int.Parse(arr[2]),
                Drawn = int.Parse(arr[3]),
                Lost = int.Parse(arr[4]),
                Gf = int.Parse(arr[5]),
                Ga = int.Parse(arr[6]),
                Gd = int.Parse(arr[7]),
                Points = int.Parse(arr[8])
            })
            .OrderByDescending(s => s.Points)
            .ThenByDescending(s => s.Gd)
            .ThenByDescending(s => s.Gf - s.Ga)
            .ThenBy(s => s.Team)
            .ToList();
      
        return string.Format("{0}:{1}-{2}-{3}-{4}-{5}-{6}-{7}-{8}", 
                             statsOverYears[0].Team, statsOverYears[0].Played, statsOverYears[0].Won, 
                             statsOverYears[0].Drawn, statsOverYears[0].Lost, 
                             statsOverYears[0].Gf, statsOverYears[0].Ga, statsOverYears[0].Gd, 
                             statsOverYears[0].Points);
    }  
}

