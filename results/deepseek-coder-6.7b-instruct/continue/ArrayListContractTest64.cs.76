using System;
using ArrayList;

namespace ex5
{
    class Program
    {
        static void Main(string[] args)
        {
            ArrayList aList = new ArrayList();
            aList.Add(1);
            aList.Add(2);
            aList.Add(3);
            aList.Add(2);
            
            Console.WriteLine("Original list:");
            aList.Display();

            aList.Remove(2);

            Console.WriteLine("After removing the number 2:");
            aList.Display();

        }
    }
