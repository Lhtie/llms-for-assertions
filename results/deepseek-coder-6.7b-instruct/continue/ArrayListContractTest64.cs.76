//UnitTestProject/ArrayList.Test/ArrayListTest.cs
﻿using System;
using NUnit.Framework;
using ArrayList;


namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestArrayListAdd()
        {
            ArrayList arrList = new ArrayList();
            Assert.AreEqual(0,arrList.Count);
            arrList.Add(5);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(true, arrList.Contains(5));
        }

        [Test]
        public void TestArrayListRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            arrList.Remove(5);
            Assert.AreEqual(0, arrList.Count);
            Assert.AreEqual(false, arrList.Contains(5));
        }

      [Test]
        public void TestArrayListInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
           arrList.Insert(0,7);
          Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(true, arrList.Contains(7));
        }

      [Test]
        public void TestArrayListSet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            arrList[0] = 7;
            Assert.AreEqual(true, arrList.Contains(7));
            Assert.AreEqual(false, arrList.Contains(5));
        }

        [Test]
        public void TestArrayListGet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            Assert.AreEqual(5,(int)arrList[0]);
        }


        [Test]
        public void TestArrayListContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            Assert.AreEqual(true, arrList.Contains(5));
            Assert.AreEqual(false, arrList.Contains(7));
        }
    }
