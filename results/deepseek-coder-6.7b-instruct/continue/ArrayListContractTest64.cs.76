﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ex5
{
    [TestClass]
    public class StringOperationsTests
    {
        [TestMethod]
        public void TestRemove()
        {
            ArrayList list = new ArrayList();
            list.Add("string1");
            list.Add("string2");
            list.Add("string3");
            list.Remove("string2");

            Assert.AreEqual(2, list.Count);
        }

        [TestMethod]
        public void TestAdd()
        {
            ArrayList list = new ArrayList();
            list.Add("string1");
            Assert.AreEqual(1, list.Count);
        }
    }
}

//ex5/ex5Tests.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ex5
{
    [TestClass]
    public class Ex5Tests
    {
        [TestMethod]
        public void TestInsert()
        {
            ArrayList list = new ArrayList();
            list.Add(1);
            list.Add(2);
            list.Add(3);

            list.Insert(1, "string");

            Assert.AreEqual(4, list.Count);
            Assert.AreEqual("string", list.Get(1));
        }

        [TestMethod]
        public void TestGet()
        {
            ArrayList list = new ArrayList();
            list.Add(1);
            list.Add("string");
            list.Add(3.4);

            Assert.AreEqual(1, list.Get(0));
            Assert.AreEqual("string", list.Get(1));
            Assert.AreEqual(3.4, list.Get(2));
        }
    }
