using System.Web;

namespace BugTracker2._0
{
    class Logger
    {
        private static string _filename = HttpContext.Current.Server.MapPath("/logs/" + DateTime.Now.ToString("yyyy-MM-dd") + ".log");

        public static void WriteLogInfo(string logInfo)
        {
            write(logInfo, "INFO");
        }

        public static void WriteLogError(string logInfo)
        {
            write(logInfo, "ERROR");
        }

        private static void write(string logInfo,string logType)
        {
            try
            {
                if (!File.Exists(_filename))
                {
                    using (File.Create(_filename)) { }
                }

                using (StreamWriter w = File.AppendText(_filename))
                {
                    w.WriteLine(DateTime.Now.ToString(new CultureInfo("en-US"))+" - "+ logType +" - "+ logInfo);
                }
            }
            catch (Exception)
            {
                throw;
            }
        }
    }
