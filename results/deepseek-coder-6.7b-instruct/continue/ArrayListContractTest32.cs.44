﻿using System;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Example;
using NUnit.Framework;

namespace Example.List.Test
{
	/// <summary>
	/// This is a class for unit test
	/// </summary>
	[TestFixture]
	public static partial class Test
	{
		/// <summary>
		/// This method tests a method of the class.
		/// </summary>
		[PexMethod]
		public static void TestMethod1([PexAssumeUnderTest]CustomList list, int index1, int index2)
		{
			AssumePrecondition.IsTrue(index1 >= 0);
			AssumePrecondition.IsTrue(index2 >= 0);
			AssumePrecondition.IsTrue(index1 != index2);
			AssumePrecondition.IsTrue(list.Count > index1);
			AssumePrecondition.IsTrue(list.Count > index1);

			// Remember initial list data
			CustomList initialList = new CustomList(new System.Collections.Generic.List<int>(list));

			// Call tested target
			list.Swap(index1, index2);

			// Compare result
			Assert.AreEqual(
				initialList[index1],
				list[index2]
			);
			Assert.AreEqual(
				initialList[index2],
				list[index1]
			);
		}
	}
}

