﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using ArrayList.Test;
using ArrayList;

namespace Pex
{
    class Program
    {
        static void Main(string[] args)
        {
            ArrayList arrList = new ArrayList();

            // Test Add()
            for (int i=1; i<=5; i++)
            {
                arrList.Add(i);
            }

            // Test Remove()
            arrList.Remove(2);

            // Test Contains()
            if (arrList.Contains(3))
            {
                Console.WriteLine("Contains 3");
            }
            else
            {
                Console.WriteLine("Doesn't Contain 3");
            }

            // Test Clear()
            arrList.Clear();

            if (arrList.Count == 0)
            {
                Console.WriteLine("Clear completed!");
            }

            // Test Insert()
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Insert(1, 9);

            // Test Set()
            arrList[2] = 7;
        }
    }
}

