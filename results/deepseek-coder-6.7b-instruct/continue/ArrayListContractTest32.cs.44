//Stack/Program.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Stack
{
    class Program
    {
        static void Main(string[] args)
        {
            Stack myStack = new Stack(5);
            myStack.push(1);
            myStack.push(2);
            myStack.push(3);
            myStack.push(4);
            myStack.push(5);
            Console.WriteLine("Top element: " + myStack.top());
            Console.WriteLine("Fulled: " + myStack.isFull());
            Console.WriteLine("Emptied: " + myStack.isEmpty());
            myStack.pop();
            Console.WriteLine("After one pop, top element: " + myStack.top());
            Console.WriteLine("Fulled: " + myStack.isFull());
            Console.WriteLine("Emptied: " + myStack.isEmpty());
            myStack.push(6);
            Console.WriteLine("After one push of 6, top element: " + myStack.top());
            Console.WriteLine("Fulled: " + myStack.isFull());
            Console.WriteLine("Emptied: " + myStack.isEmpty());
        }
    }
}

