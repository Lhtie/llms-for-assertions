    public class ArrayListTest
    {
        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;
            int index = 0;

            for (int i =0; i < 10; i++)
            {
                arrList.Add(i);
            }

            arrList.Insert(index, x);

            Assert.IsTrue(arrList.Contains(x));
        }
        
        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;

            arrList.Add(x);
            arrList.Remove(x);

            Assert.IsFalse(arrList.Contains(x));
        }

        [Test]
        public void TestSetAndGet()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;
            int index = 0;

            arrList.Add(x);
            arrList[index] = x;

            Assert.IsTrue(arrList[index] == x);
        }
    }
