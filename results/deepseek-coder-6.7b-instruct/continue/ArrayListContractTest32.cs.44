//List/List.Test/ListContractTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ListAPIWrapper;

namespace ListAPIWrapper.Test
{
    [TestFixture, PexClass]
    public partial class ListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]List listClass, int x)
        {
            int old_Count = listClass.Count;
            listClass.Add(x);
            int new_Count = listClass.Count;

            Assert.IsTrue(new_Count == old_Count + 1);
            Assert.IsTrue(listClass.Contains(x));
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]List listClass, int x)
        {
            int old_Count = listClass.Count;
            listClass.Remove(x);
            int new_Count = listClass.Count;

            Assert.IsTrue(old_Count > new_Count);
            Assert.IsFalse(listClass.Contains(x));

        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]List listClass, int x, int index)
        {
            int old_Count = listClass.Count;
            listClass.Insert(index, x);
            int new_Count = listClass.Count;

            Assert.IsTrue(new_Count == old_Count + 1);
            Assert.IsTrue(listClass.Contains(x));
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]List listClass, int x, int index)
        {
            listClass[index] = x;

            Assert.IsTrue(listClass.Contains(x));
        }
    }
}

