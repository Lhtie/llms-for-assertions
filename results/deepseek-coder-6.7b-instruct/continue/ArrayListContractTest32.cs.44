public class LRUCache {

    private class Node {
        public int Key;
        public int Value;
        public Node Prev;
        public Node Next;
        
        public Node(int key, int value) {
            this.Key = key;
            this.Value = value;
        }
    }
    
    private int capacity;
    private Dictionary<int, Node> dic;
    private Node head;
    private Node tail;

    public LRUCache(int capacity) {
        this.capacity = capacity;
        this.dic = new Dictionary<int, Node>();
        head = new Node(0,0);
        tail = new Node(0,0);
        head.Next = tail;
        tail.Prev = head;
    }
    
    private void removeNode(Node node) {
        Node prev = node.Prev;
        Node next = node.Next;
        prev.Next = next;
        next.Prev = prev;
    }
    
    private void addToHead(Node node)
    {
        node.Next = head.Next;
        node.Prev = head;
        head.Next.Prev = node;
        head.Next = node;
    }

    public int Get(int key) {
        if (dic.ContainsKey(key)) {
            Node node = dic[key];
            removeNode(node);
            addToHead(node);
            return node.Value;
        }
        else {
            return -1;
        }
    }
    
    public void Put(int key, int value) {
        if (dic.ContainsKey(key)) {
            Node node = dic[key];
            node.Value = value;//update value
            removeNode(node);
            addToHead(node);
        }
        else {
            if (dic.Count == capacity) {
                dic.Remove(tail.Prev.Key);
                removeNode(tail.Prev);
            }
            Node newNode = new Node(key, value);
            addToHead(newNode);
            dic.Add(key, newNode);
        }
    }
}

/**
 * Your LRUCache object will be instantiated and called as such:
 * LRUCache obj = new LRUCache(capacity);
 * int param_1 = obj.Get(key);
 * obj.Put(key,value);
 */
//Time complexity for Get and Put operations is O(1)
//Space complexity is O(capacity) as we store the nodes in the dictionary and the LinkedList.
//For each operation, we first try to find the node in the dictionary. If it is not in the dictionary, we need to add it to both the dictionary and the doubly-linked list. If the dictionary is full (at capacity), we remove the least recently used item.
//In any case in either operation, whether the item was found or not, we update the usage to make it the most recent one (by removing from the existing position and inserting it to the head of the linked list).
//The LinkedList is designed to make movement of data around efficient. In this case we want to have an eligibility to easily remove entries from both ends (tail and heads).
//The Dictionary is used to provide a fast look-up efficiency O(1) as it has constant time complexity for basic operations - lookup, insert and delete. The dictionary contains key-value pairs and each key maps to a value in a one-to-one fashion.
//This allows for the constant-time retrieval and updating of data from the cache directly using the provided key.

//The overall approach works like a cache, but limited in both size (capacity) and time (latest usage) with least-recently-used (LRU) eviction policy. This is achieved by a combination of dictionary and doubly linked list data structure manipulation.

//This solution works as it helps us manage our cache in an efficient way with minimum computation time. It optimizes our Get and Put operation to return value at any given time in constant time O(1) and also handles the LRU eviction policy.
//Thanks to the use of a dictionary, we prevent duplicate entries and the doubly linked list can easily remove from either end thus--------------------