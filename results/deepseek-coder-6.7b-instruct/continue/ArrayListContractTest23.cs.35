	    Debug.Assert(New_arrListIndexOfX <= Old_index);
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            bool Old_arrListContains_OldIndex = arrList.Contains(arrList[index]);

            int x = arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOf_x = arrList.IndexOf(x);
            bool New_arrListContains_x = arrList.Contains(x);

            Debug.Assert(Old_arrListCount > New_arrListCount && 
                      Old_arrListContains_OldIndex &&
                      New_arrListCount <= Old_arrListCount &&
                      New_arrListIndexOf_x == -1 && 
                      !New_arrListContains_x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_Contains_x", Old_arrListContains_OldIndex);
            PexObserve.ValueForViewing("$old_x", x);
            PexObserve.ValueForViewing("$new_arrList_Contains_x", New_arrListContains_x);
        }
    }
