﻿using NUnit.Framework;
using Microsoft.Pex.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass(typeof(ArrayList))]
    public class ArrayListTest
    {
        [Test, PexMethod]
        public void Add_Test([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) {
                Assert.AreEqual(arrList.Count, arrList.Add(x));
            } else {
                Assert.AreEqual(arrList.Count + 1, arrList.Add(x));
            }
        }

        [Test, PexMethod]
        public void Remove_Test([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) {
                arrList.Remove(x);
                Assert.IsFalse(arrList.Contains(x));
            }
        }

        [Test, PexMethod]
        public void IndexOf_Test([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) {
                Assert.IsTrue(arrList.IndexOf(x) >= 0);
            } else {
                Assert.AreEqual(-1, arrList.IndexOf(x));
            }
        }

        [Test, PexMethod]
        public void LastIndexOf_Test([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) {
                Assert.IsTrue(arrList.LastIndexOf(x) >= 0);
            } else {
                Assert.AreEqual(-1, arrList.LastIndexOf(x));
            }
        }

        [Test, PexMethod]
        public void Insert_Test([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            if (index < arrList.Count && index >= 0) {
                arrList.Insert(index, x);
                Assert.IsTrue(arrList.Contains(x));
            } else {
                Assert.Throws<System.IndexOutOfRangeException>(() => arrList.Insert(index, x));
            }
        }
    }
}

