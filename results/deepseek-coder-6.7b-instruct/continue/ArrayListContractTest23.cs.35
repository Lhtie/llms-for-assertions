namespace Bai4_OOP
{
    class Student : Person // class Student ke thua tu class Person
    {
        // private instance variables
        private string _program;
        // protected instance variable
        protected double _fee;


        // constructor

        public Student(string name, string address, string program, double fee) : base(name, address)
        {
            _program = program;
            _fee = fee;
        }

        // public properties
        public string Program { get => _program; set => _program = value; }
        public double Fee { get => _fee; set => _fee = value; }

        public override string ToString()
        {
            return $"Student [Person [Name: {Name}, Address: {Address}]"+
                    $"Program: {_program}, Fee: {_fee}]";
        }

        public override bool Equals(object obj)
        {
            return obj is Student student &&
                   base.Equals(obj) &&
                   _program == student._program &&
                   _fee == student._fee;
        }

        public override int GetHashCode()
        {
            return HashCode.Combine(base.GetHashCode(), _program, _fee);
        }

        // method
        public void Display()
        {
            Console.WriteLine("Student's name is: "+Name);
            Console.WriteLine("Student's address is: "+Address);
            Console.WriteLine("Student's program of study is: "+_program);
            Console.WriteLine("Fee of student is: "+_fee);
        }
    }
