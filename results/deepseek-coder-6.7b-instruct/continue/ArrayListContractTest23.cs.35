//test/Pex API Test/ArrayList.Test/ArrayListUnitTest.cs
﻿using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test]
        public void TestArrayList()
        {
            ArrayList arrListTest = new ArrayList();
            arrListTest.Add(1);
            arrListTest.Add(2);
            arrListTest.Add(3);

            // Check Count
            Assert.AreEqual(3, arrListTest.Count);
            
            // Check IndexOf
            Assert.AreEqual(0, arrListTest.IndexOf(1));
            Assert.AreEqual(1, arrListTest.IndexOf(2));
            Assert.AreEqual(2, arrListTest.IndexOf(3));

            // Check Contains
            Assert.IsTrue(arrListTest.Contains(1));
            Assert.IsTrue(arrListTest.Contains(2));
            Assert.IsTrue(arrListTest.Contains(3));

            // Check Remove 
            arrListTest.Remove(1);
            Assert.IsFalse(arrListTest.Contains(1));
            Assert.AreEqual(2, arrListTest.Count);

            // Check Clear
            arrListTest.Clear();
            Assert.AreEqual(0, arrListTest.Count);
        }
    }
}

