	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, old list's IndexOf(x) remains the same as new list's IndexOf(x) 
           AssumePrecondition.IsTrue(New_Ret ? Old_arrListIndexOfX == New_arrListIndexOfX : New_arrListIndexOfX == -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, old list's LastIndexOf(x) remains the same as new list's LastIndexOf(x)
           AssumePrecondition.IsTrue(New_Ret ? Old_arrListLastIndexOfX == New_arrListLastIndexOfX : New_arrListLastIndexOfX == -1);
        }
