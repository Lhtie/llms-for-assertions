﻿// Copyright (c) Microsoft Corporation. All rights reserved.
// Licensed under the MIT License. See LICENSE file in the project root for full license information.

using System;
using System.IO;

namespace Microsoft.Pex.Engine
{
    public class Program
    {
        static void Main(string[] args)
        {
            string filepath = null;
            foreach (string arg in args)
            {
                if (File.Exists(arg))
                {
                    filepath = arg;
                    break;
                }
            }

            if (filepath == null)
            {
                PrintUsage();
                return;
            }

            try
            {
                Console.WriteLine("Running PEX tests for {0}...", filepath);
                PexRunner runner = new PexRunner();
                runner.Run(filepath, args);
                Console.WriteLine("SUCCEEDED");
            }
            catch (Exception ex)
            {
                Console.WriteLine("FAILED: {0}", ex);
            }
        }

        static void PrintUsage()
        {
            Console.WriteLine("Usage: dotnet Microsoft.Pex.Engine.dll <path to the PEATestInput.xml>");
        }
    }
}

