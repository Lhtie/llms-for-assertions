using System;
using System.Collections.Concurrent;
using System.Globalization;
using System.Reflection;
using System.Runtime.CompilerServices;
using Microsoft.Pex.Common;
using Microsoft.Pex.Engine.Targets;
using Microsoft.Pex.Framework.Statistics;
using Microsoft.Pex.Members;
using Microsoft.Pex.Reflection;
using Microsoft.Pex.State;

namespace Microsoft.Pex.Engine.CodeContracts
{
    public class CodeContractsHandler : TargetElement
    {
        private readonly IAppDomain _ad;
        private static readonly AssemblyReference<object> _codeContractsRef = new AssemblyReference<object>("Microsoft.VisualStudio.TestTools.UnitTesting", "12.0.0.0");
        private CallWrapper _getAssertApi;

        public CodeContractsHandler(IAppDomain ad)
            : base(TargetElementType.BeforeMethod)
        {
            _ad = ad;
        }

        public override void Initialize(Type elementType)
        {
            base.Initialize(elementType);
            _getAssertApi = _codeContractsRef.Type("Microsoft.VisualStudio.TestTools.UnitTesting.Assert", "Assert");
        }

        public override void Execute(ITargetMethodInvoker callInvoker, ExecutionInfo executionInfo, ICoverageTracker coverage)
        {
            if (executionInfo.State == ExecutionState.PostConditionCheckFail)
            {
                MemberInfo member = executionInfo.MemberInfo.Method;
                AssertType assertion = new AssertType(member.DeclaringType.FullName, member.Name);
                object[] values = new object[] { executionInfo.State.PostCondition, executionInfo.State.Coverage };
                _getAssertApi.Invoke(_ad, values);
            }

            executionInfo.Continue();
        }
    }
}

