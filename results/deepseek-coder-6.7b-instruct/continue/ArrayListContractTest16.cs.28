﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using ArrayList;

class TestFixture
{
    static ArrayList CreateArrayList()
    {
        ArrayList list = new ArrayList();
        for (int i = 0; i < 5; i++)
        {
            list.Add(i * 2);
        }
        for (int i = 0; i < 8; i++)
        {
            list.Add(null);
        }
        return list;
    }

    public ArrayList CreateBigArrayList()
    {
        return PexReflection.GetSize<ArrayList>(10000);
    }

    [PexMethod]
    public void TestAdd(ArrayList list, object obj)
    {
       Assert.AreEqual(list.Count + 1, list.Add(obj));
    }

    [PexMethod]
    public void TestRemove(ArrayList list, object obj)
    {
        int oldCount = list.Count;
        Assert.AreEqual(true, list.Remove(obj));
        Assert.AreEqual(oldCount - 1, list.Count);
    }

    [PexMethod]
    public void TestInsert(ArrayList list, int index, object obj)
    {
        int oldCount = list.Count;
        list.Insert(index, obj);
        Assert.AreEqual(oldCount + 1, list.Count);
    }

    [PexMethod]
    public void TestClear(ArrayList list)
    {
        list.Clear();
        Assert.AreEqual(0, list.Count);
    }
}

