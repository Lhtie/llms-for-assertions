namespace PexLib
{
    /// <summary>
    /// Base class for all PEX types
    /// </summary>
    public abstract partial class PexType
    {
        /// <summary>
        /// Creates the appropriate <see cref="PexType"/> based on the runtime type
        /// </summary>
        public static PexType CreatePexType(Type type)
        {
            return new PexClass(type);
        }

        /// <summary>
        /// The actual runtime type
        /// </summary>
        public abstract Type RuntimeType { get; }

        /// <summary>
        /// Gets the base <see cref="PexType"/> this extends
        /// </summary>
        public virtual PexType BaseType
        {
            get { return null; }
        }

        /// <summary>
        /// Whether this type is implicitly convertible to <paramref name="type"/>.
        /// </summary>
        public virtual bool IsImplicitlyConvertibleTo(PexType type)
        {
            return RuntimeType.IsAssignableFrom(type.RuntimeType);
        }

        /// <summary>
        /// Check if the object is valid or not
        /// </summary>
        public abstract bool IsValidInstance(object obj);

        /// <summary>
        /// Generate a default value for this PEX type.
        /// </summary>
        public abstract object GenerateDefaultValue();

        /// <summary>
        /// Returns a string that represents the current object.
        /// </summary>
        public override string ToString()
        {
            return RuntimeType.ToString();
        }

        internal virtual bool IsNumericType()
        {
            return false;
        }

        internal virtual bool IsEnumerable()
        {
            return typeof(IEnumerable).IsAssignableFrom(RuntimeType);
        }

        internal virtual bool IsPrimitive()
        {
            return RuntimeType.IsPrimitive;
        }

        internal virtual bool IsValueType()
        {
            return RuntimeType.IsValueType;
        }
    }
