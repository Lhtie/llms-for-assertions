using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using ArrayList;

namespace ArrayListExamples
{
    [PexClass]
    public partial class ArrayListExamples
    {
        [PexMethod]
        public void AddAndRemoveExample(int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            arrList.Remove(x);
        }

        [PexMethod]
        public int FindElement(ArrayList arrList, int x)
        {
            if (arrList.Contains(x)) return arrList.IndexOf(x);
            else return -1;
        }

        [PexMethod]
        public int GetElementAtIndex(ArrayList arrList, int index)
        {
            if (index < arrList.Count)
                return (int)arrList[index];
            else
                return -1;
        }

        [PexMethod]
        public int GetArrayListCount(ArrayList arrList)
        {
            return arrList.Count;
        }

        [PexMethod]
        public bool ContainsElement(ArrayList arrList, int x)
        {
            return arrList.Contains(x);
        }

        [PexMethod]
        public void ClearArrayList(ArrayList arrList)
        {
            arrList.Clear();
        }

    }
