﻿using System;
using System.Collections;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
        [Test]
        public void AddContractTest()
        {
            ArrayList<string> lst = new ArrayList<string>();
            int old_count = lst.Count;
            lst.Add("Hello");
            Assert.AreEqual(old_count + 1,  lst.Count);
        }

        [Test]
        public void RemoveContractTest()
        {
            ArrayList<string> lst = new ArrayList<string>();
            lst.Add("Hello");
            int old_count = lst.Count;
            lst.Remove("Hello");
            Assert.IsTrue(lst.Count <= old_count); // The new count should be <= old count.
        }
    }
}public class ClassTest
{
    public int PropertyTest { get; set; }

    public event Action<string> PropertyChanged;

    public void InvokePropertyChanged(string name)
    {
        PropertyChanged?.Invoke(name);
    }
}

public class ClassTestObserver
{
    public ClassTestObserver(ClassTest test)
    {
        test.PropertyChanged += Test_PropertyChanged;
    }

    private void Test_PropertyChanged(string obj)
    {
        Console.WriteLine($"Property {obj} changed");
    }
}

public class MainClass
{
    public static void Main()
    {
        ClassTest test = new ClassTest();
        ClassTestObserver observer = new ClassTestObserver(test);

        test.PropertyTest = 5;
        test.InvokePropertyChanged("PropertyTest");
    }
