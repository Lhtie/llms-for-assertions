//C#_CodeCoverage_NUnit/ArrayListTest/ArrayListContractTest.cs
using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
        [Test]
        public void TestAdd([Values(-5, -1, 0, 1, 5)]int n)
        {
            var list = new ArrayList();
            list.Add(n);
            Assert.AreEqual(1, list.Count);
            Assert.IsTrue(list.Contains(n));
            Assert.AreEqual(n, list[0]);
        }

        [Test]
        public void TestRemove([Values(-5, -1, 0, 1, 5)]int n)
        {
            var list = new ArrayList();
            list.Add(n);
            list.Remove(n);
            Assert.AreEqual(0, list.Count);
            Assert.IsFalse(list.Contains(n));
        }

        [Test]
        public void TestRemoveAt([Values(0, 1, 2, 3)]int n)
        {
            var list = new ArrayList();
            list.Add(5);
            list.RemoveAt(n);
            Assert.AreEqual(0, list.Count);
            Assert.IsFalse(list.Contains(5));
        }
    }
}

