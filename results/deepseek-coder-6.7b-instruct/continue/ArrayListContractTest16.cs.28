//SpecflowAPIAutoFramework/StepDefinitions/EmployeeSteps.cs
﻿using BoDi;
using NUnit.Framework;
using RestSharp;
using SpecflowAPIAutoFramework.Models;
using SpecflowAPIAutoFramework.Utilities;
using TechTalk.SpecFlow;

namespace SpecflowAPIAutoFramework.StepDefinitions
{
    [Binding]
    public class EmployeeSteps
    {
        private readonly IObjectContainer _objectContainer;
        private readonly ScenarioContext _scenarioContext;
        private readonly Employee _employee;

        public EmployeeSteps(IObjectContainer objectContainer, ScenarioContext scenarioContext, Employee employee)
        {
            _objectContainer = objectContainer;
            _scenarioContext = scenarioContext;
            _employee = employee;
        }

        [Given(@"I have the employee details")]
        public void GivenIHaveTheEmployeeDetails(Table table)
        {
            foreach (var row in table.Rows)
            {
                _employee.FirstName = row["FirstName"];
                _employee.LastName = row["LastName"];
                _employee.Id = int.Parse(row["Id"]);
            }
        }

        [When(@"I send the create employee request")]
        public void WhenISendTheCreateEmployeeRequest()
        {
            var client = new RestClient(Configuration.BaseUrl);
            var request = new RestRequest(ApiResources.EmployeeDetail);
            request.AddJsonBody(_employee);

            var response = client.Post(request);
            _scenarioContext.Add("Response", response);
        }

        [Then(@"I should receive a successful status code for the create employee")]
        public void ThenIShouldReceiveASuccessfulStatusCodeForTheCreateEmployee()
        {
            var response = _scenarioContext.Get<RestResponse>("Response");
            Assert.AreEqual(200, (int)response.StatusCode);
        }

    }
}

