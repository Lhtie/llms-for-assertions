//C#_CodeCoverage_ReSharper/ArrayList/ArrayList.cs
﻿using System;
using System.Text;
using System.Collections.Generic;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void TestAddMethod()
        {
            // Create a new ArrayList and add an item
            ArrayList<int> arrList = new ArrayList<int>();
            int count = arrList.Count;
            arrList.Add(1);

            // Verify that the new count is one more than the old count
            Assert.AreEqual(count + 1, arrList.Count, "ArrayList.Add() didn't increase the Count property");

            // Check that the item was added
            Assert.IsTrue(arrList.Contains(1, null), "ArrayList.Add() didn't add the item");
        }

        [TestMethod]
        public void TestRemoveMethod()
        {
            // Create a new ArrayList, add an item, and then remove it
            ArrayList<int> arrList = new ArrayList<int>();
            arrList.Add(1);
            arrList.Remove(1);

            // Verify that the Count property has decreased by one
            Assert.AreEqual(0, arrList.Count, "ArrayList.Remove() didn't decrease the Count property");

            // Check that the item was indeed removed
            Assert.IsFalse(arrList.Contains(1, null), "ArrayList.Remove() didn't remove the item");
        }

        // Add other test methods as needed
    }
}

