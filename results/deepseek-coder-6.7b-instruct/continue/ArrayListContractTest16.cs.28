//ArrayList.Test/ArrayListTest.cs
﻿using NUnit.Framework;
using ArrayList;
using System;

namespace ArrayList.Test
{
	[TestFixture]
	public class ArrayListTest
	{
		[Test]
		public void AddAndCountTest()
		{
			ArrayList list = new ArrayList();
			Assert.AreEqual(0, list.Count);

			list.Add(1);
			Assert.AreEqual(1, list.Count);

			list.Add(2);
			Assert.AreEqual(2, list.Count);
		}

		[Test]
		public void AddAndGetTest()
		{
			ArrayList list = new ArrayList();

			list.Add(1);
			Assert.AreEqual(1, list.Get(0));

			list.Add(2);
			Assert.AreEqual(2, list.Get(1));
			
			Assert.Throws<IndexOutOfRangeException>(() => list.Get(2));
		}

		[Test]
		public void RemoveTest()
		{
			ArrayList list = new ArrayList();
			list.Add(1);
			list.Add(2);
			list.Add(3);

			list.Remove(2);
			Assert.AreEqual(2, list.Count);
			Assert.AreEqual(1, list.Get(0));
			Assert.Throws<IndexOutOfRangeException>(() => list.Get(1));

			list.Remove(1);
			Assert.AreEqual(1, list.Count);
			Assert.AreEqual(3, list.Get(0));
		}

		[Test]
		public void ContainsTest()
		{
			ArrayList list = new ArrayList();
			list.Add(1);
			list.Add(2);

			Assert.IsTrue(list.Contains(1));
			Assert.IsTrue(list.Contains(2));
			Assert.IsFalse(list.Contains(3));
		}

		[Test]
		public void IndexOfTest()
		{
			ArrayList list = new ArrayList();
			list.Add(1);
			list.Add(2);

			Assert.AreEqual(0, list.IndexOf(1));
			Assert.AreEqual(1, list.IndexOf(2));
			Assert.AreEqual(-1, list.IndexOf(3));
		}

		[Test]
		public void LastIndexOfTest()
		{
			ArrayList list = new ArrayList();
			list.Add(1);
			list.Add(2);
			list.Add(2);

			Assert.AreEqual(0, list.LastIndexOf(1));
			Assert.AreEqual(2, list.LastIndexOf(2));
			Assert.AreEqual(-1, list.LastIndexOf(3));
		}

		[Test]
		public void ClearTest()
		{
			ArrayList list = new ArrayList();
			list.Add(1);
			list.Add(2);

			list.Clear();

			Assert.AreEqual(0, list.Count);
		}
	}
}

