}




public partial class ArrayList
{

    public void PUT_CopyTo_Test_Precondition(Array array, int index)
    {
        AssumePrecondition.IsTrue(array != null);
        AssumePrecondition.IsTrue(index >= 0);
        AssumePrecondition.IsTrue(index <= new_arrList_Count);
    }


    [PexMethod]
     public bool PUT_CopyTo_Test([PexAssumeUnderTest]ArrayList arrList, Array array, int index)
     {
         this.PUT_CopyTo_Test_Precondition(array, index);
            
         arrList.CopyTo(array, index);
         
         if ((array.Length - index) != arrList.Count)
             return false;
         return true;
     }
}

//PexAPITest/PexAPIWrapper/ArrayListTestCases.cs
﻿using System;
using ArrayList;
using Microsoft.Pex.Framework;


namespace PexAPIWrapper
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest("Add")]
    public class ArrayListTestCases
    {
        // Test Case for Add method
        [PexMethod]
        public void TestAdd([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int InitialCount = arrList.Count;
            arrList.Add(x);
            int FinalCount = arrList.Count;
            Microsoft.Pex.Framework.Assert.AreEqual(InitialCount + 1, FinalCount);
        }

        // Test Case for Remove method 
        [PexMethod]
        public void TestRemove([PexAssumeUnderTest] ArrayList arrList, int x)
        {
            arrList.Add(x);
            int InitialCount = arrList.Count;
            arrList.Remove(x);
            int FinalCount = arrList.Count;
            Microsoft.Pex.Framework.Assert.AreEqual(InitialCount - 1, FinalCount);
        }

        // Test Case for IndexOf method
        [PexMethod]
        public void TestIndexOf([PexAssumeUnderTest] ArrayList arrList, int x)
        {
            arrList.Add(x);
            int Index = arrList.IndexOf(x);
            Microsoft.Pex.Framework.Assert.AreEqual(0, Index);
        }
    }
}

