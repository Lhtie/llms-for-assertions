public static class ArrayListExtensions
{
    public static bool IsSorted(this ArrayList list)
    {
        for (int i = 0; i < list.Count - 1; i++)
        {
            if ((IComparable)list[i] > (IComparable)list[i + 1])
            {
                return false;
            }
        }
        return true;
    }
}

