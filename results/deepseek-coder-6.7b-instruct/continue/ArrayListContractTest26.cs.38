public class C2 { 
   public void Foo () 
   {
      Console.WriteLine("C2.Foo");
   }

   public void Bar () 
   {
      Console.WriteLine("C2.Bar");
      Foo();
   }
}

public class C1 : C2 {

   public override void Foo () 
   {
      Console.WriteLine("C1.Foo");
   }

   public new void Bar() 
   {
      Console.WriteLine("C1.Bar");
      Foo();
   }
}

class Program
{
   static void Main(string[] args)
   {
      C1 c1 = new C1();
      c1.Bar();
      
      C2 c2 = new C2();
      c2.Bar();
      
      C2 c2Ref = c1;
      c2Ref.Bar();
   }
}
