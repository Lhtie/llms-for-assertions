public class HealthBar : MonoBehaviour
{
    [SerializeField] Image bar;

    float maxHealth = 100f;
    float curHealth = 100f;

    public float CurHealth
    {
        get
        {
            return curHealth;
        }
        set
        {
            curHealth = Mathf.Clamp(value, 0, maxHealth);
            SetHealthBar();
        }
    }

    void Start()
    {
        
    }

    void Update()
    {
        
    }

    void SetHealthBar()
    {
        float ratio = curHealth / maxHealth;
        bar.rectTransform.localScale = new Vector3(ratio, 1, 1);
    }
}using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Player : MonoBehaviour
{
    public HealthBar healthBar;
    public float damage = 10f;

    private void OnCollisionEnter2D(Collision2D collision)
    {
        if(collision.gameObject.tag == "Enemy")
        {
            healthBar.CurHealth -= damage;
        }
    }
}﻿using UnityEngine;

public class PlayerController : MonoBehaviour
{
    [SerializeField] private float speed = 10.0f;
    [SerializeField] private float rotationSpeed = 360.0f;
    [SerializeField] private GameObject cam1;
    [SerializeField] private GameObject cam2;
    private Rigidbody rb;
    private bool isActive = false;
    private float moveVelocity;
    private float rotationVelocity;

    private void Start()
    {
        rb = GetComponent<Rigidbody>();
        cam1.SetActive(isActive);
        cam2.SetActive(!isActive);
    }

    private void Update()
    {
        if (Input.GetButtonDown("ToggleCam"))
        {
            isActive = !isActive;
            cam1.SetActive(isActive);
            cam2.SetActive(!isActive);
        }
    }

    private void FixedUpdate()
    {
        Move();
        RotatePlayer();
    }

    private void Move()
    {
        moveVelocity = Input.GetAxis("Vertical") * speed;
        Vector3 moveDirection = transform.forward * moveVelocity * Time.deltaTime;
        rb.MovePosition(rb.position + moveDirection);
    }

    private void RotatePlayer()
    {
        float turnDirection = Input.GetAxis("Horizontal");
        rotationVelocity = turnDirection * rotationSpeed * Time.deltaTime;
        rb.MoveRotation(rb.rotation * Quaternion.Euler(0, rotationVelocity, 0));
    }
}﻿using System.Web.Mvc;

namespace TatnAmWeb.Areas.Admin
{
    public class AdminAreaRegistration : AreaRegistration 
    {
        public override string AreaName 
        {
            get 
            {
                return "Admin";
            }
        }

        public override void RegisterArea(AreaRegistrationContext context) 
        {
            // The context argument defines an interface to the routes of the application.
            // We will use this to map the default URL (i.e., /Admin) to the Admin home.

            context.MapRoute(
                "Admin_default",
                "Admin/{controller}/{action}/{id}",
                new { controller = "AdminHome", action = "Index", id = UrlParameter.Optional } // Default routing parameter
            );
        }
    }
