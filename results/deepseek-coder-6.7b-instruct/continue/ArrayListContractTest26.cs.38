{
    public void PUT_RemoveRange_Test_Precondition(int index, int count)
    {
        AssumePrecondition.IsTrue(index <= this.Count && index >= 0);
        AssumePrecondition.IsTrue(count >= 0 && count <= (this.Count - index));
    }

    [PexMethod, PexExplore]
    public void PUT_RemoveRange_Test([PexAssumeUnderTest]ArrayList arrList, int index, int count)
    {
        this.PUT_RemoveRange_Test_Precondition(index, count);

        int Old_arrListCount = arrList.Count;

        arrList.RemoveRange(index, count);

        int New_arrListCount = arrList.Count;

        PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
        PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

         @@@ Debug.Assert(New_arrListCount <= Old_arrListCount);
