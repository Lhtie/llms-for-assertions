			for(int i = 0; i < countOfElements; i++)
			{
				arrayList.Add(i);
			}
			//Assert
			Assert.AreEqual(expectedCount, arrayList.Count);
		}

		[Test]
		[TestCase(3)]
		public void TestRemoveMethod(int countOfElements)
		{
			//Arrange
			ArrayList arrayList = new ArrayList();

			int expectedCount = countOfElements - 1;
			for (int i = 0; i < countOfElements; i++)
			{
				arrayList.Add(i);
			}

			//Act
			arrayList.RemoveAt(0);

			//Assert
			Assert.AreEqual(expectedCount, arrayList.Count);
		}

