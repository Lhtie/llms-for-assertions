        private int[] data;
        private int size;

        public MyArrayList()
        {
            data = new int[10];
            size = 0;
        }

        public int Add(int value)
        {
            if (size == data.Length)
            {
                int[] newData = new int[data.Length * 2];
                Array.Copy(data, newData, size);
                data = newData;
            }

            data[size] = value;
            size++;

            return size - 1;
        }

