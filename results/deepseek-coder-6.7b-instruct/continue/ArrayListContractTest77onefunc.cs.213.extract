            Debug.Assert(Old_arrListLastIndexOfX <= New_Ret); 
--------------------	    Debug.Assert(New_Ret <= Old_arrListLastIndexOfX);
------------------------------------------------------------            Debug.Assert(New_Ret <= Old_arrListLastIndexOfX, "The returned index must be smaller than or equal to the last index of the element in old ArrayList");
----------------------------------------------------------------------------------------------------            Debug.Assert(
                Old_arrListContainsX
                && Old_arrListLastIndexOfX <= New_arrListLastIndexOfX
                && New_Ret >= 0,
                "The Last Index of x in an array has been increased or x is not present in target array.");
