class Complex:
    def __init__(self, real, imaginary=0):
        #assert isinstance(real,int) or isinstance(real,float),'Invalid type: {}'.format(real)
        #assert isinstance(imaginary,int) or isinstance(imaginary,float),'Invalid type: {}'.format(imaginary)
        self.real = real
        self.imaginary = imaginary

    def __add__(self, other):
        return Complex(self.real + other.real, self.imaginary + other.imaginary)

    def __sub__(self, other):
        return Complex(self.real - other.real, self.imaginary - other.imaginary)

    def __mul__(self, other):
        return Complex(self.real*other.real - self.imaginary*other.imaginary, self.real*other.imaginary + self.imaginary*other.real)

    def __truediv__(self, other):
        r_sq = other.real**2 + other.imaginary**2
        return Complex((self.real*other.real + self.imaginary*other.imaginary)/r_sq, (self.imaginary*other.real - self.real*other.imaginary)/r_sq)

    def __abs__(self):
        return (self.real**2 + self.imaginary**2)**0.5

    def __str__(self):
        return "{} + {}i".format(self.real, self.imaginary)

    def __eq__(self, other):
        return self.real == other.real and self.imaginary == other.imaginary

