import shape

def draw_rectangle(t, rect):
    # Precondition: t is a turtle that is facing in a direction that draws
    # to the right, right angles to the path, and with pen up. The 
    # rect argument should be a shape.Rectangle instance. This method will 
    # draw a rectangle with given length and width.

    # postconditions: t will draw a rectangle of given size with respect to the 
    # turtle's starting position and direction.
    
    # hint: you won't be able to draw a rectangle in a single move
    t.forward(rect.len)
    t.right(90)
    t.forward(rect.wid)
    t.right(90)
    t.forward(rect.len)
    t.right(90)
    t.forward(rect.wid)

def draw_circle(t, circ):
    # Precondition: same as above but circ should be an instance of the Circle 
    # Class and the turtle starts facing to the right.
  
    # postconditions: turtle draws circle of given radius with respect to the 
    # turtle's starting position and direction.

    t.circle(circ.rad)

def draw_shape_to_turtle(t, shape):
    # Precondition: t is a turtle at the desired location and facing the 
    # desired direction (right), and shape is an instance of the rectangle or 
    # circle class.
    # postcondition: the turtle is positioned and oriented in such a way as to 
    # result in the shape being drawn following by the turtle.
    
    if shape.typ == "Rectangle":
        draw_rectangle(t, shape)
    else: # must be a Circle
        draw_circle(t, shape)


