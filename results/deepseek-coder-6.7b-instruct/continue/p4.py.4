#shapes.py
import math

# Constants
PI = math.pi

class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    a1, a2 = s1.area, s2.area
    # an assertion that  s1 and s2 are valid shapes
    assert (a1>0 and a2>0), "Invalid shape"
    return max(a1,a2)

def compare_p(s1, s2):
    '''returns perimeter of shape with larger perimeter'''
    p1, p2 = s1.perimeter, s2.perimeter
    assert (p1>0 and p2>0), "Invalid shape"
    return max(p1,p2)

def main():
    c1 = Circle(5)
    rect = Rectangle(3,4)
    print("Circle: ", c1.area, c1.perimeter)
    print("Rectangle: ", rect.area, rect.perimeter)
    print("flipped rectangle: ", rect.flipped().area, rect.flipped().perimeter)
    print("highest area: ", compare_a(c1, rect))
    print("highest perimeter: ", compare_p(c1, rect))
main()

