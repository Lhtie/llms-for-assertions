import unittest
from shapes_hw3b import *

class TestShapes(unittest.TestCase):

    def test_rectangle(self):
        r = Rectangle(2,3)
        self.assertEqual(r.typ, "Rectangle")
        self.assertEqual(r.len, 2)
        self.assertEqual(r.wid, 3)
        self.assertEqual(r.area, 6)
        self.assertEqual(r.perimeter, 10)
        rf = r.flipped()
        self.assertEqual(rf.len, 3)
        self.assertEqual(rf.wid, 2)
        self.assertEqual(rf.area, 6)
        self.assertEqual(rf.perimeter, 10)

    def test_circle(self):
        c = Circle(4)
        self.assertAlmostEqual(c.area, 50.26, places=2)
        self.assertAlmostEqual(c.perimeter, 25.13, places=2)

    def test_compare_a(self):
        r = Rectangle(2,3)
        c = Circle(4)
        self.assertEqual(compare_a(r,c), "Circle")

        rf = r.flipped()
        self.assertEqual(compare_a(rf,r), "Both shapes")

    def test_compare_p(self):
        r = Rectangle(2,3)
        c = Circle(4)
        self.assertEqual(compare_p(r,c), "Circle")

        rf = r.flipped()
        self.assertEqual(compare_p(rf,r), "Rectangle")

unittest.main()

