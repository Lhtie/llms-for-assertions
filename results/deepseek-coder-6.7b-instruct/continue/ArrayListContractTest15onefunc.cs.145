This test is used for verifying the Remove method with the ArrayList class from System.Collections.ArrayList. The contract ensures that it follows three principles:
 - It’s a pure function, means the change in the external state is due to the supplied parameters, not any effect from external influences
 - It maintains the size property. The old list count should be one less than the new list count.
 - It returns the expected results. It verifies the method returns -1 if the item was not found in the list before, and the item was removed, it maintains the property that it returned the old index of the item being removed.
 - Precondition: The list should contain the element that is going to be removed.
- Postcondition: The list should no longer contain the element that was removed.

This test is based on a model that uses Pex-defined arrays. Each test is given a specific array, any index in that array and checks the Remove function for it.
-arrList is a random array and x is a random value from arrList. So, we assume that Remove(x) will work correctly because the contract assumes that x exists in arrList, which is ensured by the Precondition.

Then it observes the variables: old & new lists and the old & new indexes of x, and checks that the observations align with the requirements. If they don't, the test method fails.
*/

//CSharpCodeCoverage/ArrayListContractTest/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using System.Linq;
using System.Diagnostics;

namespace ArrayList.Test
{
    [TestClass]
    public partial class ArrayListContractTest
    {
        // PUT_RemoveContract is a Contract for Remove method using Pex Fuzzing.
        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePostcondition.IsTrue(() => !arrList.Contains(x));

            int oldCount = arrList.Count;
            int oldIndex = arrList.IndexOf(x);
            int oldLastIndex = arrList.LastIndexOf(x);

            arrList.Remove(x);

            int newCount = arrList.Count;
            int newIndex = arrList.IndexOf(x);
            int newLastIndex = arrList.LastIndexOf(x);

            Debug.WriteLine("Old Count: " + oldCount);
            Debug.WriteLine("New Count: " + newCount);
            Debug.WriteLine("Old Index Of X: " + oldIndex);
            Debug.WriteLine("New Index Of X: " + newIndex);
            Debug.WriteLine("Old Last Index Of X: " + oldLastIndex);
            Debug.WriteLine("New Last Index Of X: " + newLastIndex);
            Debug.WriteLine("Does new array list contain X: " + (newIndex == -1));

            Assert.IsTrue(() => oldCount == newCount + 1);
            Assert.IsTrue(() => (newIndex == -1) && (oldIndex == newLastIndex));
            Assert.IsFalse(() => arrList.Contains(x));
        }

        // PUT - ADD_Contract for Add Method using Pex Fuzzing.
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int oldCount = arrList.Count;

            arrList.Add(x);

            int newCount = arrList.Count;
            int lastIndex = arrList.LastIndexOf(x);

            Debug.WriteLine("Old Count: " + oldCount);
            Debug.WriteLine("New Count: " + newCount);
            Debug.WriteLine("Last Index of X in the ArrayList: " + lastIndex);

            // Check that the count before and after the method call increase by 1.
--------------------