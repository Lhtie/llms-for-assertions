            Debug.Assert(Old_arrListLastIndexOfX != Old_arrListCount ? New_arrListCount == Old_arrListCount - 1 : New_arrListCount == Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list contains x is false in new array list after removing x from old array list
            Debug.Assert( (!New_arrListContainsX) ? !(New_arrListIndexOfX == Old_arrListLastIndexOfX || New_arrListLastIndexOfX >= Old_arrListIndexOfX && Old_arrListIndexOfX >= 0) : New_arrListContainsX == Old_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list index of x in new array list is -1 after removing x from old array list 
            Debug.Assert( (!Old_arrListContainsX) ? New_arrListIndexOfX == -1 : New_arrListIndexOfX == Old_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list last index of x in new array list is not -1 after removing x from old array list
            Debug.Assert(!New_arrListContainsX ? New_arrListLastIndexOfX == -1 : New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
        }
    }
}

Which I get an error saying "The method call 'arrList.Remove(x)' is invalid" when I try to run the test. Anybody know why this is occurring and how I can solve it? 

A: I don't think the exact reason for this can be stated since the error message indicates that the Remove method itself is marked as [PexGenerated] which I would not expect in this context. However, there are several possible explanations:


*

*The testing library you're using does not support the Remove method. Testing libraries, like Pex and InternalsVisibleTo, mark certain methods as [PexGenerated]. If you're using such a testing library, you may be limited in the methods you can test.

*If this is inside a property you marked with [PexMethod] attribute Pex is unable to handle. Properties/methods can't easily be instrumented by tools which is the reason why you cannot test remove method in ArrayList

*The class ArrayList does not have a [PexMethod] or [PexAssembly] attribute on the Remove method. Pex is an automatic property based testing tool and cannot test a method not associated with a property.

*Your code or data is making Pex inoperable, maybe due to complex or circular references, which is not supported by Pex.


The general advice would be to reconsider whether you're trying to test something that you can manually test as well. Maybe a simple unit test for the ArrayList Remove operation would suffice. Remember, a good test is a functionally correct one and you write it only for the function it demonstrates, not for any particular testing library or framework.
