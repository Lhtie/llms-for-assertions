A: You would declare the ArrayList with the types that you want to store in it - like so:
ArrayList<int> arrList = new ArrayList<int>();

Then you can use the methods you have:
arrList.Add(42);
int val = arrList[0];

I can't provide more help without knowing what the specific 'ArrayList' methods you want to test are, like Add, Remove, Contains, etc.

A: Your method PUT_LastIndexOfContract seems to have a problem. 
Debug.Assert(New_Ret >= 0 || !Old_arrListContainsX);

You're checking if New_Ret is not negative or if Old_arrListContainsX is false.  It sounds like you want to ensure that if New_Ret is negative, Old_arrListContainsX should be false.
You might want to fix it as follows:
Debug.Assert((New_Ret < 0 && !Old_arrListContainsX) || (New_Ret >= 0 && Old_arrListContainsX));

The second part of the assertion checks that if New_Ret is not negative, it should be in Old_arrList (hence Old_arrListContainsX is true).  The first part of the assertion checks that if New_Ret is negative (which--------------------	    PexAssume.WasFalse(New_Ret < 0 && !Old_arrListContainsX);

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListAtIndex = (int)(arrList[index]);
            bool Old_arrListContainsOldAtIndex = arrList.Contains(Old_arrListAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsOldAtIndex = arrList.Contains(Old_arrListAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_at_index", Old_arrListAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_OldAtIndex", Old_arrListContainsOldAtIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_OldAtIndex", New_arrListContainsOldAtIndex);

            PexAssume.WasTrue(New_arrListCount + 1 == Old_arrListCount && New_arrListContainsOldAtIndex == false);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            PexAssume.WasTrue(New_arrListCount == 0 && Old_arrListCount > 0);

        }
    }
