//Tests/UnitTests/UnitTest1.--------------------            if(New_Ret < 0)
                Assert.IsFalse(Old_arrListContainsX);  
        
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListGetIndex = (int)(arrList[index]);
            bool Old_arrListContainsOldIndex = arrList.Contains(Old_arrListGetIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsOldIndex = arrList.Contains(Old_arrListGetIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_GetIndex", Old_arrListGetIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_OldIndex", Old_arrListContainsOldIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_OldIndex", New_arrListContainsOldIndex);

        }


      // This is a contract test on Clear Method,
      // It checks whether: All elements in Original arraylist are removed and new ArrayList count is zero.
      [PexMethod]
      public void Test_ArrayList_Clear([PexAssumeUnderTest]ArrayList list)
      {
         AssumePrecondition.IsTrue(list.Count >= 0);

	    int Old_Count = list.Count;

        list.Clear();    

        int New_Count = list.Count;
  
        PexObserve.ValueForViewing("$old_Count", Old_Count);
        PexObserve.ValueForViewing("$new_Count", New_Count);
	    
        Assert.IsTrue(New_Count==0);
      } 
    }
}﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using CustomStringBuilder;

namespace CustomStringBuilder.Test
{
    [TestFixture, PexClass]
    public partial class CustomStringBuilderContractTest
    {
        [PexMethod]
        public void PUT_CustomStringBuilderContract([PexAssumeUnderTest]CustomStringBuilder CustStrBldr, string x)
        {
            AssumePrecondition.IsTrue(CustStrBldr != null && x != null);

            int Old_Length = CustStrBldr.Length;
            int Old_Capacity = CustStrBldr.Capacity;

            String Old_ToString = CustStrBldr.ToString();

            CustStrBldr.Append(x);

            int New_Length = CustStrBldr.Length;
            int New_Capacity = CustStrBldr.Capacity;

            String New_ToString = CustStrBldr.ToString();

            PexObserve.ValueForViewing("$Old_Length", Old_Length);
            PexObserve.ValueForViewing("$New_Length", New_Length);
            PexObserve.ValueForViewing("$Old_Capacity", Old_Capacity);
            PexObserve.ValueForViewing("$New_Capacity", New_Capacity);
            PexObserve.ValueForViewing("$Old_ToString", Old_ToString);
            PexObserve.ValueForViewing("$New_ToString", New_ToString);
        }
    }
}﻿using System;
