using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using PexAPIWrapper;
using ArrayList;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", Severity.High)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", Severity.High)]
    public partial class ArrayListContractTests
    {
        [PexMethod]
        public void PUT_Add(ArrayList list, object item)
        {
            int count = list.Count;
            list.Add(item);
            PexAssert.AreEqual(count + 1, list.Count);
        }

        [PexMethod]
        public void PUT_Remove(ArrayList list, object item)
        {
            if (list.Contains(item))
            {
                int count = list.Count;
                list.Remove(item);
                PexAssert.AreEqual(count - 1, list.Count);
            }
        }

        [PexMethod]
        public void PUT_Insert(ArrayList list, int index, object item)
        {
            int count = list.Count;
            list.Insert(index, item);
            PexAssert.AreEqual(count + 1, list.Count);
        }

        [PexMethod]
        public void PUT_Set(ArrayList list, int index, object item)
        {
            list[index] = item;
            PexAssert.AreEqual(item, list[index]);
        }

        [PexMethod]
        public void PUT_Contains(ArrayList list, object item)
        {
            bool contains = list.Contains(item);
            if (contains)
            {
                PexAssert.IsTrue(list.IndexOf(item) >= 0);
            }
        }

        [PexMethod]
        public void PUT_Clear(ArrayList list)
        {
            list.Clear();
            PexAssert.AreEqual(0, list.Count);
        }
    }
}

