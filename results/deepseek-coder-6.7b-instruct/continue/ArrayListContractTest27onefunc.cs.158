using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void GenericConstructor_ShouldCreateValidList([PexInlineData(0), PexInlineData(1), PexInlineData(10)] int count)
        {
            ArrayList list = new ArrayList(count);

            // Check the initial count.
            PexAssert.AreEqual(count, list.Count);

            // Check that we can add items.
            for (int i = 0; i < count; i++)
            {
                list.Add(i);
            }

            // Check that the add worked correctly.
            PexAssert.AreEqual(count, list.Count);
            for (int i = 0; i < count; i++)
            {
                PexAssert.AreEqual(i, list[i]);
            }

            // Clear the list and check the count.
            list.Clear();
            PexAssert.AreEqual(0, list.Count);
        }
    }
}

