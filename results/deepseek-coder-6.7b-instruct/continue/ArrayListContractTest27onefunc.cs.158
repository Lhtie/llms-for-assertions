// documentation for--------------------            Debug.Assert(Old_arrListLastIndexOfX >= index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ Index of x in new array is equal to input index
            Debug.Assert(New_arrListIndexOfX == Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains property of new array is true for x element
            Debug.Assert(New_arrListContainsX == true);
        }
    }
}

This code is a test for ArrayList's Insert method. This test uses Pex and assumes the initial conditions are valid (index less than or equal to the array list size and larger than or equal to 0). 
It then executes the method that it is testing.
The test then observes the changes in size, the index of the inserted element and verifies that the last index of the element before insertion plus one is equal to the index of the inserted element in the array list. It also asserts that contains for the element is now true.
And finally it asserts that the last index of an element in the array list is always greater than or equal to its original index.
This test should be executed and passed in order to ensure that the ArrayList's Insert method is working correctly according to the contract provided.
    


For more info, refer the following link:
https://docs.microsoft.com/en-us/visualstudio/test/writing-unit-tests-for-managed-code-by-using-microsoft-visualstudio-testtools?view=vs-2019

A: You are correct in your question. 
When inserting an element at the beginning of the ArrayList, ArrayList.Insert(0, x) in ArrayList is essentially the same as ArrayList.Add(x) since at index 0 you're essentially appending an element to the end of the list. Same goes for ArrayList.Add(x, index) => essentially inserting at index position.
So for the Pex test you should assume a precondition such as: index is a valid and reasonable position where new element can be inserted.
Unfortunately, Pex does not automatically generate the right value for the inserted index so you might want to use a [PexMethod] where you manually insert values for index.
But in case your ArrayList does not allow an item to be duplicated (it is meant not to) then you also need to ensure the test that:
Old_arrListLastIndexOfX is always greater than or equal to its original position.
Old_arrListIndexOfX is always less than or equal to the new position.
P.S. For a more rigorous test, you may prefer the PexClass and PexMethod attribute on the test fixture with large input sizes that generate different random indices, positive indices, indices at the start, end, and middle of the array etc.
Hope this helps~

A: Based on your code, it seems like the problem is that the insertion test case does not verify whether the array list indeed includes the element x. The actual check is for the element's index (which might be incorrect for example, if x already existed in the array list), instead of verifying whether the array list indeed includes the element x. 

You may want to replace your assertions like this:
Debug.Assert(New_arrListLastIndexOfX >= Old_index, "The last position of x in old array is greater than or equal to a position of x in the new array");
Debug.Assert(New_arrListIndexOfX == Old_index, "The index of x in new array is equal to input index");
Debug.Assert(New_arrListContainsX, "The contains property of new array should return true for x element");

With these corrections, the test will verify whether the element x has been correctly inserted, and whether New_arrListContainsX returns true.

Another suggestion could be to use the InsertAndGet method instead of manually inserting the item and checking if the list contains it. Pex allows you to insert an item in the middle of a list and generate all the possible output values, but it may not always be able to infer the correct behaviour, especially if the method depends on side-effects or is non-deterministic.

Keep in mind that Pex is not a perfect testing tool and it's often helpful to add more non-Pex code coverage to your unit tests to enhance the robustness of your tests.

Remember, Pex can't perfectly infer all possible behaviours with a method under test. It generates input based on the preconditions and constraints--------------------	    // after execution of this function @@@ with parameter values {arrList, x, index}
            int lastPositionOld = 0;
            for (int i = 0; i < Old_arrListCount; i++) {
                if ((int)arrList[i] == x) {
                    lastPositionOld = i;
                }
            }

            int lastPositionNew = 0;
            for (int i = 0; i < New_arrListCount; i++) {
                if ((int)arrList[i] == x) {
                    lastPositionNew = i;
                }
            }

            Debug.Assert(lastPositionNew >= lastPositionOld);
        }
    }
}

```

Here, we use PexObserve.ValueForViewing to record the values of various entities involved in the test (the initial and resulting list counts, the index of x, and whether the list contains x) for later visualization and examination in PexExplorer. The debug assertion checks whether, after the insertion, the last occurrence of x in the old and new lists remain in the same or a subsequent position respectively.

### Postconditions

Assuming that the `Insert` method maintains the current items order and returns a reference to the newly added element, here is how we may specify the postconditions:

```csharp
public void Postcondition_Insert(ArrayList source, int item, int index, ArrayList result)
{
    Contract.Requires(source != null);
    Contract.Requires(index >= 0 && index <= source.Count);
    Contract.Requires(result != null);
    Contract.Ensures(result.Count == source.Count);
    foreach (object o in source)
        Contract.Ensures(result.Contains(o));
    Contract.Ensures(result[index].Equals(item));
}
```

There is one postcondition that must hold for all valid inputs (`source`, `item`, and `index`). This is that there must be as many items in the result as were in the source. We go through each of the source's items, and ensure they should all be in the result. The last postcondition ensures the `item` is at the designated `index` in the result.

### Test Cases

Test cases are crucial in a testing suite. We can write a `TestInsert` function to test each of these postconditions:

```csharp
[TestMethod]
public void TestInsert()
{
    ArrayList source = new ArrayList() {1, 2, 3};
    int item = 4;
    int index = 1;

    ArrayList result = new ArrayList(source);
    result.Insert(index, item);

    Postcondition_Insert(source, item, index, result);
}
```

We create a copy of 'source' to preserve its original state in tests running on the same data. Then we use the Insert function and pass the result to Postcondition_Insert which we just wrote. This method will ensure that our result meets all the conditions we specified in Postcondition_Insert above.

And these are the basics of parameterized testing and pre/postconditions for ArrayList class.

### Conclusion

This example shows how parameterized testing, along with pre and postconditions, can be used to test an ArrayList class. Preconditions ensure that your test is performed on valid inputs, and postconditions ensure that your test's results are correct under various circumstances. You can then use the test case method to write actual test scenarios and verify your program's results. Keep in mind, however, in a real-world project, you may need a more extensive set of tests that take into account all of the various edge cases and different class and method behavior.

This is just a quick example, in a real-world situation, you would also need to handle any exceptions thrown by your ArrayList class methods to ensure they behave as expected under erroneous circumstances. These kind of edge cases would typically not be included in a typical unit test, as they are more suited to integration tests or functional tests (if a part of your project is supposed to behave differently in some edge cases).

Happy testing.

> This article is part of the "Parameterized Unit Testing in .NET" series. Make sure you check out the other parts [Part 1](https://www.codeproject.com/Articles/1241738/Parameterized-Unit-Testing-in-NET) and [Part 2](https://www.codeproject.com/Articles/1245163/Parameter--------------------	    // at the end of the test, if @@@ =  "arrList.Contains\(Old_x\)" then @@@ = true; at the end of test.

            Assert.IsTrue(Old_arrListIndexOfX >= 0 && New_arrListIndexOfX == index);  
        }
    }
}

//CodeCoverage/ArrayList.Test/ArrayListContractTest/RemoveContract.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System.Collections;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentException))]
        public void REMOVE_RemoveContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeNotNull] object obj)
        {
            AssumePrecondition.IsTrue(!arrList.Contains(obj));
            arrList.Remove(obj); // should throw if the object was not in the list

            PexObserve.ValueForViewing(arrList.Contains(obj));
            PexObserve.ValueForViewing(arrList.Count);
            PexObserve.ValueForViewing(obj);
            Debug.Assert(!arrList.Contains(obj));
        }
    }
}

//CodeCoverage/ArrayList.Test/ArrayListPropertyTest/ArrayList.cs
﻿using Microsoft.Pex.Framework;
using System;
using System.Collections;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedException(typeof(OverflowException))]
    public partial class ArrayListPropertyTest
    {
        [PexMethod]
        public void COUNT_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            int count = list.Count;

            PexObserve.ValueForViewing("Count", count);
            PexAssert.AreEqual(InvalidElements.Get(list), count, "The count should be equal to the number of actual elements in the ArrayList");
        }

        [PexMethod]
        public void CAPACITY_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            int capacity = list.Capacity;

            PexObserve.ValueForViewing("Capacity", capacity);
            PexAssert.IsTrue(capacity >= InvalidElements.Get(list), "The capacity should be equal or larger than the count");
        }

        [PexMethod]
        public void ITEMS_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            int count = list.Count;
            object[] items = (object[])list.Items;

            PexObserve.ValueForViewing("Count", count);
            PexObserve.ValueForViewing("Items", items);
            PexAssert.AreEqual(count, items.Length, "The length of Items should be equal to the count");
        }

        [PexMethod]
        public void SYNCROOT_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            object syncRoot = list.SyncRoot;

            PexAssert.IsNotNull(syncRoot, "SyncRoot should never be null");
        }

        [PexMethod]
        public void ISREADONLY_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            bool isReadOnly = list.IsReadOnly;

            PexObserve.ValueForViewing("IsReadOnly", isReadOnly);
            PexAssert.IsFalse(isReadOnly, "ArrayList should not be read-only");
        }

        [PexMethod]
        public void ISSYNCHRONIZED_GetProperty_Valid([PexAssumeUnderTest]ArrayList list)
        {
            bool isSync = list.IsSynchronized;

            PexObserve.ValueForViewing("IsSynchronized", isSync);
            PexAssert.IsFalse(isSync, "ArrayList should not be synchronized");
        }
    }
}

