﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Ranges;
using NUnit.Framework;
using System.Collections;
using ArrayList.Test;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void GET_ItemContract([PexAssumeUnderTest]ArrayList arrList, [PexRange(0, 100)]int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count);

            int x = (int)arrList[index];

            Assert.IsTrue(x >= 0);
        }
    }
}//CSharp-Algorithm/BubbleSort/BubbleSort.cs
﻿using System;

namespace BubbleSort
{
    public class Bubble
    {
        public void BubbleSort(int[] arr)
        {
            int temp;
            int j;
            for (int write = 0; write < arr.Length; write++)
            {
                for (j = 0; j < arr.Length - 1; j++)
                {
                    if (arr[j] > arr[j + 1])
                    {
                        temp = arr[j + 1];
                        arr[j + 1] = arr[j];
                        arr[j] = temp;
                    }
                }
            }
        }

        public void Bubble_Sort(int[] arr)
        {
            int temp;
            for (int j = 0; j <= arr.Length - 1; j++)
            {
                for (int i = 0; i < arr.Length - 1; i++)
                {
                    if (arr[i] > arr[i + 1])
                    {
                        temp = arr[i + 1];
                        arr[i + 1] = arr[i];
                        arr[i] = temp;
                    }
                }
            }
        }
    }
}

//CSharp-Algorithm/BubbleSortTest/BubbleSortTest.cs
using BubbleSort;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace BubbleSortTest
{
    [TestClass]
    public class BubbleSortTest
    {
        [TestMethod]
        public void SimpleCase_ShouldBeSorted()
        {
            int[] expectedArray = new int[] { 1, 2, 3, 4, 5, 6 };
            Bubble bs = new Bubble();
            bs.Bubble_Sort(expectedArray);

            int[] actualArray = new int[] { 6, 5, 4, 3, 2, 1 };

            CollectionAssert.AreEqual(expectedArray, actualArray);
        }

        [TestMethod]
        public void SameNumberCase_ShouldBeSorted()
        {
            int[] expectedArray = new int[] { --------------------	    // AFTER inserting x at index into the arrlist
           // int oldPosition = old_arrListLastIndexOfX; 
           // int newPosition = arrList.LastIndexOf(x)
           // Debug.Assert(oldPosition >= newPosition);
        }
    }
}
```
In this contract, we want to test the scenario where `arrList.Insert(index, x)` is called with two parameters and ensures that the list maintains its properties such as `Count` remains unchanged while `IndexOf(x)`, `LastIndexOf(x)` remains unchanged while `Contains(x)` stays true.

This contract only checks the ArrayList properties without considering the impact on the index; the test case should be adjusted according to the testable criteria for the index.

#### Customizing Test Cases

We have introduced a new test case to test whether `IndexOf`, `LastIndexOf`, and `Contains` remain unchanged after calling `arrList.Insert(index, x)`. This test case will be executed in a separate `ContractInvariantMethod` and is annotated with a precondition that the index is within the appropriate range. The test case also reports the old and new values for these properties (`arrList.IndexOf(x)`, `arrList.LastIndexOf(x)`, `arrList.Contains(x)`) to help understand the behavior of the test at each point in the testing process. 

Additionally, there is a comment under the test case which shows an assertion that tests the postcondition. A more sophisticated assertion might check that the last position of `x` in the old array is not smaller than the position of `x` in the newly inserted array, indicating that the list has remained in sorted order etc.

#### Code Contracts And Specifications
This code contracts and specifications provides useful insights, but sometimes can get complex based on the specific project requirements. It’s a good practice to review and analyze these aspects to ensure that the contracts and contracts are applicable and reasonable.

