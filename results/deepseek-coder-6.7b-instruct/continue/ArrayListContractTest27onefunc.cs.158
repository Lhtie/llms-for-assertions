﻿using LiteDB;
using System;

namespace LiteDB_Test.Models
{
    public class Productor
    {
        public ObjectId Id { get; set; }

        public String Name { get; set; }

        public String Description { get; set; }

        public DateTime LastUpdate { get; set; }

        public override string ToString()
        {
            return $"Nome: {Name} - Descrição: {Description} - Ultima Atualização: {LastUpdate}";
        }
    }
}

//Repositories/IProductorRepository.cs
﻿using LiteDB;
using LiteDB_Test.Models;
using System;

namespace LiteDB_Test.Repositories
{
    public interface IProductorRepository
    {
        Productor Create(Productor productor);

        Productor GetById(ObjectId id);
    }
}

//Repositories/ProductorRepository.cs
﻿using LiteDB;
using LiteDB_Test.Models;

namespace LiteDB_Test.Repositories
{
    public class ProductorRepository : IProductorRepository
    {
        private LiteDatabase _database;

        public ProductorRepository(LiteDatabase database)
        {
            _database = database;
        }

        public Productor Create(Productor productor)
        {
            var collection = _database.GetCollection<Productor>();
            collection.Insert(productor);
            return productor;
        }

        public Productor GetById(ObjectId id)
        {
            var collection = _database.GetCollection<Productor>();
            return collection.FindById(id);
        }
    }
}

//Program.cs
﻿using LiteDB;
using LiteDB_Test.Models;
using LiteDB_Test.Repositories;
using System;

namespace LiteDB_Test
{
    internal class Program
    {
        static void Main(string[] args)
        {
            var db = new LiteDatabase(@"MyData.db");

            var prodRepository = new ProductorRepository(db);

            prodRepository.Create(new Productor() 
            {
                Name = "Productor 01",
                Description = "Description 01",
                LastUpdate = DateTime.Now
            });

            var prod = prodRepository.GetById(new ObjectId("5f3747cbc30fbb4f507b7c4e"));

            Console.WriteLine(prod.ToString());

            db.DropCollection("products");
        }
    }
