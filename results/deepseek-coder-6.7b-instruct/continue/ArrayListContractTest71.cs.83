﻿using System.Configuration;

namespace WebPush.Core
{
    public class PushSubscription
    {
        public string Endpoint { get; set; }
        public string P256DH { get; set; }
        public string Auth { get; set; }

        public bool IsValid => !string.IsNullOrWhiteSpace(Endpoint) && !string.IsNullOrWhiteSpace(P256DH) && !string.IsNullOrWhiteSpace(Auth);

        public bool Equals(PushSubscription other)
        {
            return Endpoint == other.Endpoint && P256DH == other.P256DH && Auth == other.Auth;
        }
    }
}

