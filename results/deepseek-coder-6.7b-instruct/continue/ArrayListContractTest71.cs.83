}﻿using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Linq;

namespace Bingo
{
    public class BingoGame
    {
        // Private Fields
        private readonly List<BingoBoard> _bingoBoards = new List<BingoBoard>();
        private readonly List<int> _numbersDrawn = new List<int>();

        // Constructor
        public BingoGame(List<BingoBoard> boards, List<int> numbers)
        {
            Debug.Assert(boards.Count > 0);
            Debug.Assert(numbers.Count > 0);

            _bingoBoards.AddRange(boards);
            _numbersDrawn.AddRange(numbers);
        }

        // Public Methods
        public BingoBoard RunGame()
        {
            foreach (var numberDrawn in _numbersDrawn)
            {
                MarkBoards(numberDrawn);

                foreach (var board in _bingoBoards)
                {
                    if (board.HasBingo())
                    {
                        return board;
                    }
                }
            }

            throw new InvalidOperationException("No bingo after all drawn numbers.");
        }

        public BingoBoard RunGameUntilLastBoardWins()
        {
            foreach (var numberDrawn in _numbersDrawn)
            {
                MarkBoards(numberDrawn);

                if (_bingoBoards.Count == 1 && _bingoBoards[0].HasBingo())
                {
                    return _bingoBoards[0];
                }

                _bingoBoards.RemoveAll(board => board.HasBingo());
            }

            throw new InvalidOperationException("Not enough drawn numbers to win a board.");
        }

        // Internal Methods
        private void MarkBoards(int number)
        {
            foreach (var board in _bingoBoards)
            {
                board.MarkNumber(number);
            }
        }
    }
}//Bingo/BingoBoard.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;

namespace Bingo
{
    public class BingoBoard
    {
        // Private Fields
        private readonly List<List<BingoNumber>> _numbers = new List<List<BingoNumber>>();

        // Constructor
        public BingoBoard(List<List<int>> values)
        {
            foreach (var row in values)
            {
                _numbers.Add(row.Select(value => new BingoNumber(value)).ToList());
            }
        }

        // Public Methods
        public bool HasBingo()
        {
            if (_numbers.Any(row => row.All(number => number.IsMarked)))
            {
                return true;
            }

            for (int columnIndex = 0; columnIndex < _numbers[0].Count; columnIndex++)
            {
