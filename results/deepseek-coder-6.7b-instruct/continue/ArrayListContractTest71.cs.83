}﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace TaskManager.Data_Access_Layer
{
    public class DAL : IDAL
    {
        private Models.TaskContext db = new Models.TaskContext();

        public List<Models.TaskItem> GetTasks()
        {
            return db.Tasks.ToList();
        }

        public void AddTask(Models.TaskItem taskItem)
        {
            db.Tasks.Add(taskItem);
            db.SaveChanges();
        }

        public void RemoveTask(string taskName)
        {
            Models.TaskItem task = db.Tasks.Where(t=>t.TaskName == taskName).FirstOrDefault();
            if (task != null)
            {
                db.Tasks.Remove(task);
                db.SaveChanges();
            }
        }
    }
