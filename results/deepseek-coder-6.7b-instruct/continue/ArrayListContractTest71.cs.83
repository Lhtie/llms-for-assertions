            Console.WriteLine(player.FirstName + " adli oyuncu eklendi.");
        }

        public void Delete(Player player)
        {
            Console.WriteLine(player.FirstName + " adli oyuncu silindi.");
        }

        public void Update(Player player)
        {
            Console.WriteLine(player.FirstName + " adli oyuncu guncellendi.");
        }
    }
