	    // This Assertion covers the case when the elemnt is not in the list. The last index of an item which is not in the list will be -1
            AssumePrecondition.IsTrue(New_Ret != -1 || New_arrListLastIndexOfX == -1);

        }

        [PexMethod] 
        public void PUT_LastIndexOfContract([PexAssumeUnderTest] ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is negative, index of x is -1 too
            // This Assertion covers the case when the elemnt is not in the list. If the element is not found it should return -1
	    AssumePrecondition.IsTrue(New_Ret != -1 || Old_arrListIndexOfX == -1);

        }
    };
}


A: As you found out, Pex does not have built-in support for such scenarios. However, you can achieve this by using PexAssumeUnderTest, PexAssumeValid and custom test code.
Here's how you can set the last index of an element assuming the element exists:
1. Create a PexMethod and use PexAssumeUnderTest to create a list with the given element, use PexAssumeValid to ensure the element's index is valid.
2. If you want to make sure that the element exists in the list, you'll probably need to add a custom test code in the Assert section. This can check that LastIndexOf returns a value that is greater than or equal to 0 and smaller than the list count.
If you do not want the element to exist in the list, you just need to negate the condition in the Assert line.
You can write up your test in a different test class. Here is a sample code:
[TestClass]
public partial class CustomAssertsTest
{

    [PexMethod]
    [PexCustomAttribute(typeof(CustomAssertAttribute))]
    public void CustomAssert([PexAssumeUnderTest]List<int> list, [PexAssumeValid]int index)
    {
        Assert.AreEqual(list.LastIndexOf(list[index]), index);
    }

    [PexClass(typeof(List<int>))]
    [PexAllowedException(typeof(ArgumentException))]
    [PexMethod(MaxTestMethodNameLengthInVS = 15)]
    public void CustomAssert_ExceptionOnEmptyList([PexAssumeUnderTest]List<int> list, [PexAssumeValid]int index)
    {
    }

}

public class CustomAssertAttribute : PexCustomizationAttribute
{
    public override void Customize(object target)
    {
        if (target is PexAssertSettings)
        {
            var settings = (PexAssertSettings)target;
            settings.HandleException<ArgumentException>();
            settings--------------------	   

        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is negative, index of x in new array is -1 too 

        }
    }
