//C#-tests/AutoTest/TestCases/ArrayListTest/ArrayListContractTest/14.RemoveRange.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.PexGeneratedAttribute;
using Microsoft.Pex.Framework.Validation;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexGenerated]
        public void RemoveRange_Contract([PexAssumeUnderTest] ArrayList arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(true);

            if (index < 0 || index >= arrList.Count) index = 0;
            if (count < 0 || index + count > arrList.Count) count = arrList.Count - index;

            int Old_arrListCount = arrList.Count;
            AssumePrecondition.IsTrue(index < Old_arrListCount);

            arrList.RemoveRange(index, count);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$Index", index);
            PexObserve.ValueForViewing("$Count", count);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ The new array list count should be old array list count - count
            AssumePostcondition.AreEqual<int>(Old_arrListCount - count, New_arrListCount);
        }
    }
}

