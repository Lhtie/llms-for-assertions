A: The contracts you wrote are generally correct for the ArrayList.NET classes, provided that the contracts are valid under the context of your application and are consistent with the actual behavior of your code.
The problems with the last contract that states "If the return value is non-negative, x is in the old array list" comes from the fact that you only observe old state of your collection. To make sure observation on new state is included the test case must have a separate part where you insert x into the ArrayList and then make the observation.
Please consider the following contract:
[PexMethod]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    // New state observation
    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);
    PexObserve.ValueForViewing("$old_arrList_x", Old_x);
    PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
    PexObserve.ValueForViewing("$new_arrList_IndexOf_x", arrList.IndexOf(x));
    PexObserve.ValueForViewing("$New_ret", New_Ret);
    PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
    PexObserve.ValueForViewing("$new_arrList_contains_x", arrList.Contains(x));

    // If the return value is non-negative, x is in the old array list
    if (New_Ret >= 0)
    {
        PexAssert.AreEqual(Old_x, arrList[New_Ret]);
    }
}

This contract also checks if x is in the old array list, and asserts to check if if (LastIndexOf(x) >= 0) the x is in the old array list.

A: I've worked on similar contracts and for this the method I was using was:
[PexMethod]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;

    arrList[index] = x;

    // New state observation
    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);

    // Checking if the modified index of ArrayList contains the value initialized before
    PexAssert.AreEqual(arrList[index],x);
}

This contract checks if the value x was set in the specified index and if it is present in the ArrayList.

A: I would make a few modifications to your contract. Specifically, you should verify the number of items in the list changes by exactly one, not just check the count changes at all. And you should include an assertion that if IndexOf returns a value, that value should refer to the index you inserted the item to.
Here's a modified version:
[PexMethod]
public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

    int Old_arrListCount = arrList.Count;
    arrList.Insert(index, x);

    // New state observation
    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", arrList.Count);

    // Checking if an item was actually added to the old array list
    PexAssert.AreEqual(Old_arrListCount + 1, arrList.Count);

    // If IndexOf returns a value, that value should refer to the index we--------------------	    PexObserve.ValueForViewing("$$assert$$", "If the return value is non-negative, x is in the old array list");

        }

    }
}

