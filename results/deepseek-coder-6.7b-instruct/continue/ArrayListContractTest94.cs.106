﻿namespace LyricFinder.Services
{
    public class FileService
    {
        private const string BaseDir = "D:\\CodeProjects\\LyricFinder\\Data";

        public string GetFilePath(string filename)
        {
            return Path.Combine(BaseDir, filename);
        }

        public bool IsFileExists(string filename)
        {
            var filePath = GetFilePath(filename);
            return File.Exists(filePath);
        }

        public string ReadFromFile(string filename)
        {
            if (!IsFileExists(filename))
            {
                return "File not found";
            }

            var filePath = GetFilePath(filename);
            return File.ReadAllText(filePath);
        }
    }
}

//LyricFinder/Controllers/LyricsController.cs
﻿using LyricFinder.Services;
using Microsoft.AspNetCore.Mvc;

namespace LyricFinder.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class LyricsController : ControllerBase
    {
        private readonly FileService _fileService;

        public LyricsController(FileService fileService)
        {
            _fileService = fileService;
        }

        [HttpGet("{artist}/{title}")]
        public ActionResult<string> Get(string artist, string title)
        {
            var filename = $"{artist.Replace(" ", "+")}-{title.Replace(" ", "+")}.txt";
            var lyrics = _fileService.ReadFromFile(filename);

            if (lyrics == "File not found")
            {
                return NotFound($"No lyrics found for song: {title} by {artist}");
            }

            return Ok(lyrics);
        }
    }
}

