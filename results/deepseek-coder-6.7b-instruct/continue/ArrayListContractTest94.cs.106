﻿using System;
using NUnit.Framework;
using CustomList;

namespace CustomList.Test
{
    [TestFixture]
    public class CustomListTest
    {
        [Test]
        public void Test_add()
        {
            var customList = new CustomList();
            customList.Add(1);
            Assert.AreEqual(1, customList.Count);
            customList.Add(2);
            Assert.AreEqual(2, customList.Count);
        }

        [Test]
        public void Test_get()
        {
            var customList = new CustomList();
            customList.Add(1);
            customList.Add(2);
            Assert.AreEqual(1, customList.GetItem(0));
            Assert.AreEqual(2, customList.GetItem(1));
        }

        [Test]
        public void Test_set()
        {
            var customList = new CustomList();
            customList.Add(1);
            customList.SetItem(0, 2);
            Assert.AreEqual(2, customList.GetItem(0));
        }

        [Test]
        public void Test_remove()
        {
            var customList = new CustomList();
            customList.Add(1);
            customList.Add(2);
            customList.RemoveItem(1);
            Assert.AreEqual(1, customList.Count);
        }

        [Test]
        public void Test_insert()
        {
            var customList = new CustomList();
            customList.Add(1);
            customList.InsertItem(0, 2);
            Assert.AreEqual(2, customList.GetItem(0));
            Assert.AreEqual(1, customList.GetItem(1));
            Assert.AreEqual(2, customList.Count);
        }
    }
}

