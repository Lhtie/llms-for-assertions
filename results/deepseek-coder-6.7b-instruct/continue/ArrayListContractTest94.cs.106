using UnityEngine;

public class PlayerMovement : MonoBehaviour
{
    [SerializeField] private float moveSpeed; //Speed of the player

    private Vector2 moveDirection; //Direction of the player movement
    private Rigidbody2D rig; //Rigidbody of the player

    void Start()
    {
        rig = gameObject.GetComponent<Rigidbody2D>(); //Get Rigidbody Component
    }

    void Update()
    {
        moveDirection = new Vector2(Input.GetAxis("Horizontal"), Input.GetAxis("Vertical")); //Get direction from input
    }

    private void FixedUpdate()
    {
        rig.velocity = new Vector2(moveDirection.x * moveSpeed, rig.velocity.y); //Move on X
    }
