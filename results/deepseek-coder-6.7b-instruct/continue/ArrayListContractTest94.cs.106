using UnityEngine;

public class CameraShaker : MonoBehaviour
{
    public static CameraShaker instance;

    public float shakeDuration = 0.3f;
    public float shakeStrength = 1f;
    public float dampingSpeed = 1f;
    
    Vector3 initialPosition;
    float timer;

    void Awake() {
        // Singleton pattern
        if (instance == null) {
            instance = this;
        } else {
            Destroy(gameObject);
        }

        // Save initial position of camera
        initialPosition = transform.localPosition;
    }

    void Update() {
        if (timer > 0) {
            timer -= Time.deltaTime;
            transform.localPosition = Vector3.Lerp(transform.localPosition, initialPosition + Random.insideUnitSphere * shakeStrength, dampingSpeed * Time.deltaTime);
            
            if (timer <= 0) {
                transform.localPosition = initialPosition;
            }
        }
    }

    /// <summary>
    /// Shakes camera with custom parameters
    /// </summary>
    /// <param name="strength">Strength of the shake</param>
    /// <param name="duration">Duration of the shake</param>
    /// <param name="damping">Damping of the shake</param>
    public void ShakeCamera(float strength, float duration, float damping) {
        shakeStrength = strength;
        shakeDuration = duration;
        dampingSpeed = damping;

        timer = shakeDuration;
    }

    /// <summary>
    /// Shakes camera with default parameters
    /// </summary>
    public void ShakeCamera() {
        ShakeCamera(shakeStrength, shakeDuration, dampingSpeed);
    }
}using UnityEngine;
