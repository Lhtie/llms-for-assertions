//Test/ArrayListTest.cs
﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void Test_add()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
            arrList.Add(2);
            Assert.AreEqual(2, arrList.Count);
        }

        [Test]
        public void Test_get()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            Assert.AreEqual(1, arrList[0]);
            Assert.AreEqual(2, arrList[1]);
        }

        [Test]
        public void Test_set()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList[0] = 2;
            Assert.AreEqual(2, arrList[0]);
        }

        [Test]
        public void Test_remove()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);
            Assert.AreEqual(1, arrList.Count);
        }

        [Test]
        public void Test_insert()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Insert(0, 2);
            Assert.AreEqual(2, arrList[0]);
            Assert.AreEqual(1, arrList[1]);
            Assert.AreEqual(2, arrList.Count);
        }
    }
}

