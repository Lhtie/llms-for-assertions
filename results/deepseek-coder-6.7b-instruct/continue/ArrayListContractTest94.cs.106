
	    // a postcondition that represents invariants over ArrayList state. This check should compare the state of the array list (after the fact) to its state right before the operation. This ensures that the array list's size hasn't changed or that some invariants are now true.

	    // an invariant that expresses that ArrayList is not empty

        }
    }
}

