﻿using NUnit.Framework;
using ArrayList;

namespace TestProject
{
    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void AddTest_NewItem_ItemAdded()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            var item = 1;

            // Act
            arrList.Add(item);

            // Assert
            Assert.That(arrList.Count, Is.EqualTo(1));
            Assert.That(arrList.Contains(item), Is.True);
        }

        [Test]
        public void RemoveTest_ExistingItem_ItemRemoved()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            var item = 1;
            arrList.Add(item);

            // Act
            arrList.Remove(item);

            // Assert
            Assert.That(arrList.Count, Is.EqualTo(0));
            Assert.That(arrList.Contains(item), Is.False);
        }

        [Test]
        public void InsertTest_ItemAtIndex_ItemAddedAtIndex()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            var index = 1;
            var item = 4;

            // Act
            arrList.Insert(index, item);

            // Assert
            Assert.That(arrList.Count, Is.EqualTo(4));
            Assert.That(arrList[index], Is.SameAs(item));
        }
    }
