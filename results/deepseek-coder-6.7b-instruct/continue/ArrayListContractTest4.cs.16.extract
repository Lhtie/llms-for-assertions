
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x in new array is >= last index of x in old array 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of new array is > count of old array after adding one Element
        }
    }
}


