//Tests/ArrayList.Test/ArrayListContractTest.cs
﻿using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList.Test;
using NUnit.Framework;


namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest(nameof(ArrayList.Contains))]
    public partial class ArrayListContractTest
    {
        [PexExploration]
        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Contains))]
        [PexExpectedException(typeof(PexAssertException))]
        public void PUT_Contains_ThrowsExceptionContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);

            if (arrList.Contains(x)) {
                Assert.Less(arrList.IndexOf(x), arrList.Count);
            } else {
                Assert.AreEqual(-1, arrList.IndexOf(x));
                Assert.AreEqual(-1, arrList.LastIndexOf(x));
            }
        }
    }
}

//Tests/ArrayList.Test/ArrayListContractTest1.cs
﻿using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList.Test;
using NUnit.Framework;


namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest(nameof(ArrayList.Contains))]
    public partial class ArrayListContractTest
    {
        [PexExploration]
        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Contains))]
        [PexExpectedException(typeof(PexAssertException))]
        public void PUT_Contains_ThrowsExceptionContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);

           if (arrList.Contains(x)) {
                Assert.True(arrList.IndexOf(x)>=0 && arrList.IndexOf(x) <= arrList.Count-1);
                Assert.AreEqual(arrList.IndexOf(x), arrList.LastIndexOf(x));
            } else {
                Assert.AreEqual(-1, arrList.IndexOf(x));
                Assert.AreEqual(-1, arrList.LastIndexOf(x));
            }
            
        }
    }
}

