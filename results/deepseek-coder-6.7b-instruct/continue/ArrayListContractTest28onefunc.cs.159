using System;
using System.Linq;

public class Arrange
{
    /// <summary>
    /// Assists in arranging sequences by a key function
    /// </summary>
    /// <typeparam name="T">The sequence type</typeparam>
    /// <typeparam name="K">The key type</typeparam>
    /// <param name="x">The item to examine</param>
    /// <param name="y">The item to compare with</param>
    /// <param name="kx">The key derived from x</param>
    /// <param name="ky">The key derived from y</param>
    /// <param name="comparer">The comparer to use in the comparison</param>
    public static int ByKey<T,K>(T x, T y, out K kx, out K ky, Func<T,K> key, IComparer<K> comparer = null) 
    {
        kx = key(x);
        ky = key(y);
        if(comparer != null) 
            return comparer.Compare(kx,ky);
        else
            return kx.CompareTo(ky);
    }

}//-----------------------------------------------------------------------------
