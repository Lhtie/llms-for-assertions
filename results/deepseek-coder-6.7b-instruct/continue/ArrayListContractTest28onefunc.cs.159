using System;
using System.Linq;

public sealed partial class xfunc
{
    /// <summary>
    /// Assumes that a function has a specific arity
    /// </summary>
    [AttributeUsage(AttributeTargets.Method, AllowMultiple = false, Inherited = false)]
    public sealed class arity : Attribute
    {
        /// <summary>
        /// Specifies a function with a specific arity
        /// </summary>
        /// <param name="arity">The ar--------------------            Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX);
            Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);

            // assertion for index of x in new arr list should be equals to index specified in the input parameter
            Debug.Assert(New_arrListIndexOfX == Old_index);

            // Assertion to check if the arr list count has increased by 1 after the insertion.
            Debug.Assert(Old_arrListCount + 1 == New_arrListCount);
            
            // Assertion to check if old arr list contains the x or not
            Debug.Assert(Old_arrListContainsX);

            // Assertion to check if new arr list contains the x or not
            Debug.Assert(New_arrListContainsX);

            // Assertion to check if arr list has the same elements before and after the insertion.
            AssumePrecondition.CollectionEqual(arrList, (ICollection)arrList);
        }
    }
}
