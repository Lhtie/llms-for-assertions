            PexAssume.True(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);
  
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ insertion point is within arrList's range
            PexAssume.True(Old_index == New_arrListIndexOf_X);
  
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ after the insertion @@ x is contained in the list
            PexAssume.True(New_arrListContainsX);
        }
    }
}

