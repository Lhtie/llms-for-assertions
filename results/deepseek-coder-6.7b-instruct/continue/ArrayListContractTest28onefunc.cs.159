A: The assertions you described can be implemented in code as follows:
public void PUT_InsertContract([PexAssumeUnderTest] ArrayList arrList, int x, int index)
{
    //... (existing code)

    // Assertion about the last positions of an item 'x' on old and new lists
    int Old_x_last_position = ( Old_arrListIndexOfX == -1 ) ? -1 : Old_arrListLastIndexOfX - Old_arrListIndexOfX;
    int New_x_last_position = ( New_arrListIndexOfX == -1 ) ? -1 : New_arrListLastIndexOfX - New_arrListIndexOfX;

    if (Old_x_last_position == New_x_last_position)
    {
        throw new System.Exception("The last position of 'x' in the old and new list is the same");
    }

    // Assertion about the increased count of the old list
    if (Old_arrListCount + 1 != New_arrListCount)
    {
        throw new System.Exception("The count of the old list doesn't increase by one");
    }

    // Assertion about the index of 'x' in new list being greater than its index in the old list
    if (Old_arrListIndexOfX + 1 != New_arrListIndexOfX)
    {
        throw new System.Exception("The index of 'x' in new list isn't greater than its index in the old list");
    }

   // Assertion about the equality of the index of 'x' on new list and the last index of 'x' in new list
    if (New_arrListIndexOfX != New_arrListLastIndexOfX)
    {
        throw new System.Exception("The index of 'x' in new list and the last index of 'x' in new list aren't the same");
    }

    // Assertion about the presence of 'x' in the new list
    if (!New_arrListContainsX)
    {
        throw new System.Exception("The new list does not contain 'x'");
    }
}

This code should work according to these assertions. Please pay attention that the given index of 'x' should be valid (greater or equal 0 and less or equal to arrList.Count, or 'x' should be present in the list to get valid index for it). If there is attempt to use an invalid index this code could throw an exception.

