﻿using System.Threading.Tasks;
using XBServer.Application.Events.Handlers;
using XBServer.Application.Playlists.Events;
using Microsoft.Extensions.Logging;

namespace XBServer.Application.Playlists.Events.Handlers
{
    public class PlaylistAddedEventHandler : IEventHandler
    {
        private readonly ILogger _logger;

        public PlaylistAddedEventHandler(ILogger<PlaylistAddedEventHandler> logger)
        {
            _logger = logger;
        }

        public Task HandleAsync(IEvent @event)
        {
            if(@event is PlaylistAddedEvent playlistAddedEvent)
            {
                _logger.LogInformation(
                    $"The playlist '{playlistAddedEvent.Name}' ({playlistAddedEvent.PlaylistId}) was added.");
            }

            return Task.CompletedTask;
        }
    }
}

