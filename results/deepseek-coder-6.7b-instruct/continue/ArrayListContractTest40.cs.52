﻿using PexAPIWrapper;
using NUnit.Framework;
using System;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {

        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;

            int countBeforeAdd = arrList.Count;
            int indexRet = arrList.Add(x);
            int countAfterAdd = arrList.Count;

            Assert.AreEqual(countBeforeAdd + 1, countAfterAdd);
            Assert.AreEqual(0, indexRet);
            Assert.IsTrue(arrList.Contains(x));

        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;
            arrList.Add(x);

            int countBeforeRemove = arrList.Count;
            arrList.Remove(x);
            int countAfterRemove = arrList.Count;

            Assert.AreEqual(countBeforeRemove - 1, countAfterRemove);
            Assert.IsFalse(arrList.Contains(x));
        }

        [Test]
        public void TestInsertAndSet()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;
            int index = 0;

            arrList.Insert(index, x);
            Assert.AreEqual(x, arrList[index]);
            Assert.IsTrue(arrList.Contains(x));

            int y = 6;
            arrList[index] = y;
            Assert.AreEqual(y, arrList[index]);
            Assert.IsTrue(arrList.Contains(y));
        }

        [Test]
        public void TestExists()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;
            arrList.Add(x);
            Assert.IsTrue(arrList.Contains(x));
        }

        [Test]
        public void TestRemoveAt()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;
            arrList.Add(x);
            int index = 0;

            int countBeforeRemove = arrList.Count;
            arrList.RemoveAt(index);
            int countAfterRemove = arrList.Count;

            Assert.AreEqual(countBeforeRemove - 1, countAfterRemove);
            Assert.IsFalse(arrList.Contains(x));
        }
    }
}

