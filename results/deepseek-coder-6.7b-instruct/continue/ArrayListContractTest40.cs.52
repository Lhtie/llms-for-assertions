        }

        [Test]
        public void TestConcatMethod()
        {
            string str1 = "hello";
            string str2 = " world";
            string expected = "hello world";

            Assert.AreEqual(expected, StringHelper.Concat(str1, str2));
        }

        [Test]
        public void TestIndexOfMethod()
        {
            string str = "hello world";
            string substr = "world";
            int expected = 6;

            Assert.AreEqual(expected, StringHelper.IndexOf(str, substr));
        }

        [Test]
        public void TestSplitMethod()
        {
            string str = "hello world";
            string[] expected = { "hello", "world" };

            Assert.AreEqual(expected, StringHelper.Split(str));
        }
    }
}

