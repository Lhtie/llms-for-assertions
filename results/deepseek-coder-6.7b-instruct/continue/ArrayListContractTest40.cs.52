'@))#!/usr/bin/env pwsh

param (
    [string]$base_dir = "C:\Users\Gabriela\Desktop\test_folder_2",
    [string]$log_file = "C:\Users\Gabriela\Desktop\logs\log_1.txt",
    [string]$pattern = "*"
)

$files_processed = 0
$dirs_processed = 0

function Process-Files {
    param (
        [string]$base_dir,
        [string]$pattern
    )

    Get-ChildItem -Path $base_dir -Recurse -Include $pattern |
    ForEach-Object {

        if($_.PSIsContainer){
            $dirs_processed += 1
        } else {
            Add-Content -Path $log_file -Value $_.FullName
            $files_processed += 1
        }
    }
}

try {
    Process-Files -base_dir $base_dir -pattern $pattern
}
catch {
    Write-Error "An error occurred during the process: $_"
}
finally {
    Write-Output "Summary: I processed $files_processed files in $dirs_processed directories in $base_dir."
}
