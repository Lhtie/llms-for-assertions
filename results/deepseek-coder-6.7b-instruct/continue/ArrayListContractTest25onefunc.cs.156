	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index of x is still the same after insertion
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the last index of x is the same after insertion
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);

