            int New_arrListLastIndexOfValueRemoved = arrList.LastIndexOf(Old_valueRemoved);
            bool New_arrListContainsValueRemoved = arrList.Contains(Old_valueRemoved);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
