using System;
using System.Collections;
using Microsoft.QuickCheck;
using Microsoft.QuickCheck.Classification;
using Microsoft.QuickCheck.Exceptions;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList.Test;

[assembly: TestClass]
[assembly: QuickCheck]

namespace ArrayList.Test
{
    // Assumption that all array lists are mutable and can be modified by adding and removing elements.
    [TestClass]
    public partial class ArrayListContractTest
    {
        [Property]
        public bool PropertyInvariantContracts([Inject]ArrayList arrList)
        {
            int oldCount = arrList.Count;
            int oldCapacity = arrList.Capacity;

            arrList.Add(10);  // Precondition
            arrList.RemoveAt(0); //Operation
            arrList.Add(11);  // Precondition

            int newCount = arrList.Count;
            int newCapacity = arrList.Capacity;


            //Post condition
		
	    Assert.IsTrue(newCount <= oldCount+1 && newCount >= oldCount - 1, "ArrayList Count Property is Invalid" );

            //Post condition
            if(newCapacity > oldCapacity) 
                Assert.IsTrue(newCount <= newCapacity && newCount >= 0, "ArrayList Capacity Property is Invalid");

            return true;
        }
    }
}

