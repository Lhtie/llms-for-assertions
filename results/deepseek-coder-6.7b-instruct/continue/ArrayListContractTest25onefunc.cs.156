using System.Collections;
using NUnit.Framework;
using Test_ArrayList;

[TestFixture]
public class Test_ArrayListInsert
{
    private ArrayList _arrList;
    private const int MaxListSize = 100;

    [SetUp]
    public void Init()
    {
        _arrList = new ArrayList();
        for (var i = 0; i < MaxListSize; i++)
        {
            _arrList.Add(i);
        }
    }

    [Test]
    [TestCase(-1, 99)]
    [TestCase(100, 99)]
    [TestCase(50, 99)]
    [TestCase(0, 99)]
    public void InvalidInputIndexShouldNotChangeListCount(int index, int addValue)
    {
        var oldSize = _arrList.Count;
        _arrList.Insert(index, addValue);
        var newSize = _arrList.Count;
        
        Assert.That(oldSize, Is.EqualTo(newSize));
    }

    [Test]
    [TestCase(0, 99)]
    [TestCase(3, 99)]
    [TestCase(50, 99)]
    [TestCase(99, 99)]
    public void ValidInputIndexShouldChangeListCount(int index, int addValue)
    {
        var oldSize = _arrList.Count;
        _arrList.Insert(index, addValue);
        var newSize = _arrList.Count;

        Assert.That(oldSize + 1, Is.EqualTo(newSize));
    }

    [Test]
    [TestCase(0, 99)]
    [TestCase(3, 99)]
    [TestCase(50, 99)]
    [TestCase(99, 99)]
    public void InsertedValueShouldHaveCorrectIndexAndValue(int index, int addValue)
    {
        _arrList.Insert(index, addValue);

        Assert.That(_arrList[index], Is.EqualTo(addValue));
    }

    [Test]
    [TestCase(0, 99)]
    [TestCase(3, 99)]
    [TestCase(50, 99)]
    [TestCase(99, 99)]
    public void Test_ArrayList_Insert(int index, int value)
    {
        Assert.IsTrue(_arrList.Insert(index, value));
    }

    [TearDown]
    public void CleanUp()
    {
        _arrList.Clear();
    }

    private object GetObjectAt(int index)
    {
        return _arrList[index];
    }
}

