//src/Common.CQRS/Handlers/CommandHandler.cs
﻿using Common.CQRS.Commands;
using Common.CQRS.Results;
using Common.Data.DbContext;
using Common.Data.Entity;
using Microsoft.EntityFrameworkCore;
using System;
using System.Threading.Tasks;

namespace Common.CQRS.Handlers
{
    public abstract class CommandHandler<TCommand, TResult, TEntity> : ICommandHandler<TCommand, TResult>
        where TCommand : ICommand<TResult>
        where TEntity : class, IAuditable, IEntity, new()
    {
        protected readonly IDbContext Db;

        public CommandHandler(IDbContext db)
        {
            Db = db ?? throw new ArgumentNullException(nameof(db));
        }

        public virtual Task<TResult> Handle(TCommand command)
        {
            throw new NotImplementedException();
        }

        protected async Task<int> AddEntity(TEntity entity)
        {
            Db.Set<TEntity>().Add(entity);
            return await Db.SaveChangesAsync();
        }

        protected async Task<int> UpdateEntity(int id, Action<TEntity> updateAction)
        {
            var entity = await Db.Set<TEntity>().FindAsync(id);

            updateAction(entity);

            return await Db.SaveChangesAsync();
        }


        protected async Task<int> DeleteEntity(int id)
        {
            var entity = await Db.Set<TEntity>().FindAsync(id);

            if (entity == null)
                throw new Exception("Item does not exist!");

            Db.Set<TEntity>().Remove(entity);

            return await Db.SaveChangesAsync();
        }
    }
}

