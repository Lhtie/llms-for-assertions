using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllocation]
    [PexGenericType(typeof(int))]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void TestContracts(ArrayList arrList, int index, [PexAssumeValid] object item)
        {
            arrList.Add(item);
            PUT_InsertContract(arrList, item, index);

            arrList.Add(item);
            PUT_RemoveAtContract(arrList, index);
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            bool Old_arrListContainsX = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = (arrList.Contains(arrList[index])) ? arrList.IndexOf(arrList[index]) : -1;
            bool New_arrListContainsX = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that
            Debug.Assert(Old_arrListCount - 1 == New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that
            Debug.Assert(Old_arrListIndexOfX < New_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that
            Debug.Assert(Old_arrListContainsX == !New_arrListContainsX);
        }
    }
}

