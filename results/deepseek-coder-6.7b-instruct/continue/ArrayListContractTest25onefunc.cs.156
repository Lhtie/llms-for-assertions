using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using ArrayList;

namespace UnitTests
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void TestInsert()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Insert(0, 10);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(0, arrList.IndexOf(10));

            arrList.Insert(0, 20--------------------            Assert.AreEqual<int>(Old_arrListCount + 1, New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ inserted element is found in @@ position after insertion
            if (Old_arrListIndexOfX < index)
            {
                Assert.AreEqual<int>(Old_index, New_arrListIndexOfX);
            }
            else
            {
                Assert.AreEqual<int>(Old_index + 1, New_arrListIndexOfX);
            }

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ inserted element is found in @@ position after last insertion
            Assert.AreEqual<int>(Old_index, New_arrListLastIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ inserted element is contained in array list after insertion
            Assert.IsTrue(New_arrListContainsX);
        }
    }
