        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count-1 && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            object Old_valueRemoved = arrList[index];
            int Old_arrListIndexOfValueRemoved = arrList.IndexOf(Old_valueRemoved);
