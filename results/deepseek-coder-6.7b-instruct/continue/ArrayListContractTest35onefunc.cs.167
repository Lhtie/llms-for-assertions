    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentException))]
        public void RemoveContract([PexAssumeNotNull]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));
            arrList.Remove(x);
            AssumePostcondition.IsFalse(arrList.Contains(x));
