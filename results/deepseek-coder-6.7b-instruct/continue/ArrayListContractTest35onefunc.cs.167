//Test/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException")]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException",
                                          "Index was out of range. Must be non-negative and less than the size of the collection.")]
    [PexMethodUnderTest("System.Collections.ArrayList.set_Item")]
    
    public partial class ArrayListContractTest
    {
        // Testing add with null item 
        public void SetItem_NullValue([PexAssumeNotNull]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);

            arrList[index] = null;
        }
    }
}

//Tests/ArrayListBasicContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest("System.Collections.ArrayList.Add")]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException")]
    public partial class ArrayListBasicContractTest
    {
        public void POST_AddContract([PexAssumeNotNull]ArrayList arrList, [PexAssumeNotNull]Object testItem)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListAdd = arrList.Add(testItem);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsTestItem = arrList.Contains(testItem);
            int New_arrListIndexOfTestItem = arrList.IndexOf(testItem);
            object New_arrListElementAtNewCount = arrList[New_arrListCount - 1];

            PexObserve.ValueForViewing("Old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("New_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("Old_arrList_add_Result", Old_arrListAdd);
            PexObserve.ValueForViewing("New_arrList_Contains_TestItem", New_arrListContainsTestItem);
            PexObserve.ValueForViewing("New_arrList_IndexOf_TestItem", New_arrListIndexOfTestItem);
            PexObserve.ValueForViewing("New_arrList_ElementAt_NewCount", New_arrListElementAtNewCount);

            PexAssert.AreEqual(Old_arrListCount, New_arrListCount - 1);
            PexAssert.IsTrue(New_arrListContainsTestItem);
            PexAssert.AreEqual(testItem, New_arrListElementAtNewCount);
        }
    }
}

