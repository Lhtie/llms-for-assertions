//Programming-Fundamentals-C#/Advanced/10. Test Driven Development and Code Review/04. TestDrivenExercise/ArrayList.Test/ArrayListTest.cs
﻿using NUnit.Framework;
using System.Collections;

namespace ArrayList.Test
{
    using ArrayListContractTest = ArrayListContractTests;
    
    [TestFixture]
    public class ArrayListTest : ArrayListContractTests
    {
        [Test]
        public void Add_Element_ElementIsAddedCorrectly()
        {
            var list = new ArrayList();
            var element = "Pesho";

            list.Add(element);

            Assert.That(list, Has.Member(element));
        }

        [Test]
        public void AddRange_ElementsArray_ElementsAreAddedCorrectly()
        {
            var list = new ArrayList();
            var elements = new object[] { "Pesho", "Gosho", "Tosho" };

            list.AddRange(elements);

            foreach (var element in elements)
            {
                Assert.That(list, Has.Member(element));
            }
        }

        [Test]
        public void IndexOf_Element_ReturnsCorrectIndex()
        {
            var list = new ArrayList { "Pesho", "Gosho", "Tosho" };

            var index = list.IndexOf("Gosho");

            Assert.AreEqual(1, index);
        }

        [Test]
        public void Remove_Element_ElementIsRemovedCorrectly()
        {
            var list = new ArrayList { "Pesho", "Gosho", "Tosho" };

            list.Remove("Gosho");

            Assert.That(list, Has.No.Member("Gosho"));
        }

        [Test]
        public void RemoveAt_Index_ElementIsRemovedCorrectly()
        {
            var list = new ArrayList { "Pesho", "Gosho", "Tosho" };

            list.RemoveAt(1);

            Assert.That(list, Has.No.Member("Gosho"));
        }

        [Test]
        public void Clear_List_ClearsTheListCorrectly()
        {
            var list = new ArrayList { "Pesho", "Gosho", "Tosho" };

            list.Clear();

            Assert.IsTrue(list.Count == 0);
        }
    }
