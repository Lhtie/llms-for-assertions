## <a name="q--d-null-reference-exception"></a>Q. D: Null Reference Exception

```csharp
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentNullException))]
        public void AddNullContract([PexAssumeNotNull]ArrayList arrList)
        {
            arrList.Add(null);
        }

        [PexMethod]  
        [PexExpectedException(typeof(ArgumentNullException))]
        public void InsertNullContract([PexAssumeNotNull]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);
            arrList.Insert(index, null);
        }

        [PexMethod]  
        [PexExpectedException(typeof(ArgumentNullException))] 
        public object IndexerContract_Get([PexAssumeNotNull]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            return arrList[index];
        }

        [PexMethod]
        [PexExpectedException(typeof(ArgumentNullException))]
        public void IndexerContract_Set([PexAssumeNotNull]ArrayList arrList, int index, [PexAssumeNotNull]object x)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            arrList[index] = x;
        }
    }
}
```


