﻿using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;
using System.Linq;
using System.Web;

namespace RentACar.Models.Tables
{
    [Table("Customers")]
    public class Customer
    {
        [Key]
        public int ID { get; set; }

        [Required(ErrorMessage = "Потребителското име е задължително.")]
        [DisplayName("Потребителско име: ")]
        public string UserName { get; set; }

        [Required(ErrorMessage = "Паролата е задължителна.")]
        [DataType(DataType.Password)]
        [DisplayName("Парола: ")]
        public string Password { get; set; }

        [Required(ErrorMessage = "Името е задължително.")]
        [DisplayName("Име: ")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Фамилията е задължителна.")]
        [DisplayName("Фамилия: ")]
        public string Surname { get; set; }

        [DisplayName("Email: ")]
        [EmailAddress(ErrorMessage = "Невалиден Email")]
        public string Email { get; set; }

        [DisplayName("Летище: ")]
        public string PlaceOfBirth { get; set; }

        [DisplayName("Екип: ")]
        public string Team { get; set; }

        [ForeignKey("CustomerRole")]
        public int RoleId { get; set; }
        
        public virtual CustomerRole CustomerRole { get; set; }
    }
}

//RentACar/Controllers/AdminController.cs
﻿using RentACar.Models.Tables;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;

namespace RentACar.Controllers
{
    public class AdminController : Controller
    {
        private RentACarContext db = new RentACarContext();

        public ActionResult Index()
        {
            if (Session["UserID"] != null) 
            {

            var role =  db.CustomerRoles.Where(a => a.RoleName == "Admin").FirstOrDefault();

                if(role != null)
                {
                    var user = db.Customers.Where(a => a.ID == (int)Session["UserID"] && a.RoleId == role.Id).FirstOrDefault();

                    if(user != null)
                    {

                        return View();
                    }
                    else
                    {
                        return RedirectToAction("Login", "Home");
                    }
                }
                else
                {
                    return RedirectToAction("Login", "Home");
                }

            }
            else
            {
                return RedirectToAction("Login", "Home");
            }
        }
    }
}

