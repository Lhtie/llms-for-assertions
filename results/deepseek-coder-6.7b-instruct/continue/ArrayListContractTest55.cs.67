}﻿Console.WriteLine("Please enter a 4-digit number:");
int num = int.Parse(Console.ReadLine());

if(num < 1000 || num > 9999)
{
    Console.WriteLine("you didn't enter a 4-digit number, please try again.");
}
else
{
    int num1 = num / 1000;
    int num2 = (num / 100) % 10;
    int num3 = (num / 10) % 10;
    int num4 = num % 10;

    if (num1 == num4 && num2 == num3)
    {
        Console.WriteLine($"The number {num} is a palindrome.");
    }
    else
    {
        Console.WriteLine($"The number {num} is not a palindrome.");
    }
}
Console.ReadLine();//waits the program to be closed



//Note: A palindromic number is a number that remains the same when its digits are reversed. 
//      For example: 121 is a palindromic number, but 123 is not i.e if the first digit is equal to the fourth digit
//      and the second digit is equal to the third digit.
//
// Example:
// Please enter a 4-digit number:
// 1221
// The number 1221--------------------        // the same applies to the old array, if the return value is false it should be < 0
        }
    }
