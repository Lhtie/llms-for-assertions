	    // and is <= new array count @@@ 
            if (New_Ret) 
            {
	       AssumePrecondition.IsTrue(New_arrListIndexOfX >= 0 && New_arrListIndexOfX <= New_arrListCount);
            }

        }

	[PexMethod]
	public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
	{
	    int New_arrListCount = arrList.Count;
	    arrList.Clear();
	    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
	    PexObserve.ValueForViewing("$new_arrList_Count_after_clear", arrList.Count);
        AssumePrecondition.IsTrue(arrList.Count == 0); 
	}
    }
