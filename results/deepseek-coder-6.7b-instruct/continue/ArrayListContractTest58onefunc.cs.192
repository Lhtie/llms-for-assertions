using System;

namespace QuantiBit.Cukes.Runner.Model
{
    public class GherkinFeatureFile
    {
        private readonly GherkinDocument _document;
        private readonly string _filename;

        public readonly GherkinFeatureModel Feature;

        public GherkinFeatureFile(GherkinDocument document, string filename)
        {
            _document = document;
            _filename = filename;

            Feature = new GherkinFeatureModel(_document.Feature, filename);
        }

        public string Keyword
        {
            get { return _document.Feature.Keyword; }
        }

        public string Name
        {
            get { return _document.Feature.Name; }
        }

        public string Description
        {
            get { return _document.Feature.Description; }
        }

        public string[] Tags
        {
            get { return _document.Feature.Tags; }
        }

        public GherkinScenarioModel[] Scenarios
        {
            get { return Feature.Scenarios; }
        }

        public GherkinStepModel[] Steps
        {
            get { return Feature.Steps; }
        }

        public override string ToString()
        {
            return String.Format("Feature: {0}, File: {1}", Name, _filename);
        }
    }
}

