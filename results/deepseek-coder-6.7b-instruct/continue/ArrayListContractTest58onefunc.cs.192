{
    [TestClass]
    public class ArrayListContractTest
    {
        [TestMethod]
        public void ArrayListContractTest_MainTest()
        {
            Contract.EnsuresOnThrow<ArgumentException>(() =>
                new ArrayList(-1));    
        }
    }
}

