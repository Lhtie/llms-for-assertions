            if (New_Ret == false)
                Assert.That(Old_arrListIndexOfX >= New_arrListIndexOfX);

	    // an assertion using "Assert.IsTrue\(.*?\);" that ArrayList count remains same after a Contains call
            Assert.IsTrue(Old_arrListCount == New_arrListCount);

	    // an assertion using "Assert.AreEqual\(.*?\);" that IndexOf X before and after should be same or less
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);

	    // an assertion using "Assert.AreEqual\(.*?\);" that LastIndexOf X before and after should be same or more
            Assert.AreEqual(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX, true);
        }
    }
}

//src/Tests/ArrayList.Test/ArrayListGenericContractTest.cs
using System;
using System.Collections;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListGenericContractTest
    {
        [PexMethod]
        public void PUT_GenericContainsContract<T>(ArrayList arrList, T t) where T : IComparable
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfT = arrList.IndexOf(t);
            int Old_arrListLastIndexOfT = arrList.LastIndexOf(t);

            bool New_Ret = arrList.Contains(t);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfT = arrList.IndexOf(t);
            int New_arrListLastIndexOfT = arrList.LastIndexOf(t);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_t", Old_arrListIndexOfT);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_t", New_arrListIndexOfT);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_t", Old_arrListLastIndexOfT);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_t", New_arrListLastIndexOfT);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            if (New_Ret == false)
                Assert.That(Old_arrListIndexOfT >= New_arrListIndexOfT);

            Assert.IsTrue(Old_arrListCount == New_arrListCount);

            Assert.AreEqual(Old_arrListIndexOfT, New_arrListIndexOfT);

            Assert.AreEqual(Old_arrListLastIndexOfT <= New_arrListLastIndexOfT, true);
        }

        [PexMethod]
        public void PUT_GenericAddContract<T>(ArrayList arrList, T t) where T : IComparable
        {
            int Old_arrListCount = arrList.Count;

            arrList.Add(t);

            int New_arrListCount = arrList.Count;

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
        }
    }
}

