//DotNetSDK/tests/codeContracts/ArrayList/ArrayListIntegrationTests.cs
using System;
using ArrayList;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;

namespace ArrayListIntegrationTests
{
    [TestClass]
    public class ArrayListIntegrationTests
    {
        [TestMethod]
        [PexMethod]
        public void Pex_Add(
            [PexAssumeValid] ArrayList input, 
            [PexAssumeValid] int value)
        {
            int oldCount = input.Count;
            input.Add(value);

            // Postcondition
            PexAssert.IsTrue(input.Count == oldCount + 1);
            PexAssert.IsTrue(input.Contains(value));
        }

        [TestMethod]
        [PexMethod]
        public void Pex_Remove(
            [PexAssumeValid] ArrayList input, 
            [PexAssumeValid] int value)
        {
            // Precondition
            int oldCount = input.Count;
            bool valueExists = input.Contains(value);

            input.Remove(value);

            // Postconditions
            PexAssert.IsTrue(input.Count == oldCount - 1);
            PexAssert.IsFalse(input.Contains(value));
            PexAssert.IsTrue(valueExists); // Make sure it was removed, not just removed accidentally
        }

        // And so on for other operations...
    }
}

