using MyString;

namespace MyString.Test
{
    [TestFixture]
    public class MyStringTest
    {
        [Test]
        public void TestLength()
        {
            // Prepare
            MyString str = new MyString(new char [] {'a', 'b', 'c'});
            int expected = 3;
            // Act
            int actual = str.Length;

            // Assert
            Assert.AreEqual(expected, actual);
        }

        [Test] 
        public void TestCharAt() 
        {
            MyString str = new MyString(new char [] {'a', 'b', 'c'});
            char expected = 'b';

            char actual = str.CharAt(1);
            Assert.AreEqual(expected, actual);
        }

        [Test]
        public void TestSubstring()
        {
            MyString str = new MyString(new char[] { 'a', 'b', 'c', 'd', 'e' });
            MyString expected = new MyString(new char[] { 'c', 'd', 'e' });
            MyString actual = str.Substring(2);

            Assert.AreEqual(expected.ToString(), actual.ToString());
        }

        [Test]
        public void TestConcat() 
        {
            MyString str1 = new MyString(new char[] { 'a', 'b', 'c' });
            MyString str2 = new MyString(new char[] { 'd', 'e', 'f' });

            MyString expected = new MyString(new char[] { 'a', 'b', 'c', 'd', 'e', 'f' });
            MyString actual = str1.Concat(str2);

            Assert.AreEqual(expected.ToString(), actual.ToString());
        }
    }
}

