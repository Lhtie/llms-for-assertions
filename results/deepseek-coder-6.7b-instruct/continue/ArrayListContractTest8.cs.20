namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;

            int Old_arrListItemRemoved = arrList[index];

            bool Old_arrListContainsItemRemoved = arrList.Contains(Old_arrListItemRemoved);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            bool New_arrListContainsItemRemoved = arrList.Contains(Old_arrListItemRemoved);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_ItemRemoved", Old_arrListItemRemoved);
            PexObserve.ValueForViewing("$old_arrList_ContainsItemRemoved", Old_arrListContainsItemRemoved);
            PexObserve.ValueForViewing("$new_arrList_ContainsItemRemoved", New_arrListContainsItemRemoved);

            if(Old_arrListContainsItemRemoved == false) {
                Assert.IsTrue(Old_arrListCount == New_arrListCount);
            } else {
                Assert.IsTrue(Old_arrListCount - 1 == New_arrListCount);
            }
            
	    // an assertion using "Debug.Assert\(.*?\);" that new array list contains item removed

            Assert.IsTrue(New_arrListContainsItemRemoved == false);
        }
    }
