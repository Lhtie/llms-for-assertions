﻿using HierarchicalList.Tests.Model;
using NUnit.Framework;

namespace HierarchicalList.Tests
{
    [TestFixture]
    public class HierarchyComparerTests
    {
        [Test]
        public void Test_Compare_Nulls()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(null, null);
            Assert.AreEqual(0, result);
        }

        [Test]
        public void Test_Compare_First_Null()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(null, new Foo() { Name = "B" });
            Assert.AreEqual(-1, result);
        }

        [Test]
        public void Test_Compare_Second_Null()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "A" }, null);
            Assert.AreEqual(1, result);
        }

        [Test]
        public void Test_Compare_Equal()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "A" }, new Foo() { Name = "A" });
            Assert.AreEqual(0, result);
        }

        [Test]
        public void Test_Compare_One_Level_Down()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "A" }, new Foo() { Name = "B" });
            Assert.AreEqual(-1, result);
        }

        [Test]
        public void Test_Compare_One_Level_Up()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "B" }, new Foo() { Name = "A" });
            Assert.AreEqual(1, result);
        }

        [Test]
        public void Test_Compare_Several_Levels_Down()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "A", Child = new Foo() { Name = "B" } }, new Foo() { Name = "C" });
            Assert.AreEqual(-1, result);
        }

        [Test]
        public void Test_Compare_Several_Levels_Up()
        {
            var comparer = new HierarchyComparer<Foo>(x => x.Name);
            var result = comparer.Compare(new Foo() { Name = "C" }, new Foo() { Name = "A", Child = new Foo() { Name = "B" } });
            Assert.AreEqual(1, result);
        }
    }
}

