namespace Umbraco.Community.RateLimiting
{
    public interface IRateLimiter
    {
        bool CanExecute();

        Task<bool> WaitForExecution();
    }
}﻿using System;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using Umbraco.Core;
using Umbraco.Core.Cache;

namespace Umbraco.Community.RateLimiting
{
    public class BasicRateLimiter : IRateLimiter
    {
        private readonly ReaderWriterLockSlim _lockSlim = new ReaderWriterLockSlim();
        private readonly string[] _allowedKeys;
        private readonly string _current;
        private readonly IDistributedCache _distributedCache;

        public BasicRateLimiter(string[] allowedKeys, string current, IDistributedCache distributedCache)
        {
            _allowedKeys = allowedKeys ?? new string[0];
            _current = current.ToLowerInvariant();
            _distributedCache = distributedCache;
        }

        public bool CanExecute()
        {
            _lockSlim.EnterReadLock();
            try
            {
                return CanExecuteInternal();
            }
            finally
            {
                _lockSlim.ExitReadLock();
            }
        }

        private bool CanExecuteInternal()
        {
            foreach (var key in _allowedKeys)
            {
                var value = _distributedCache.GetCacheItem(key);
                if (value != null && value.CreateDateUtc.AddMilliseconds(value.ExpirationTime) >= DateTime.UtcNow)
                {
                    return false;
                }
            }

            return true;
        }

        public async Task<bool> WaitForExecution()
        {
            while (!CanExecute())
            {
                await Task.Delay(100);
            }

            return true;
        }

        public void ExecuteAction()
        {
            _lockSlim.EnterWriteLock();
            try
            {
                foreach (var key in _allowedKeys)
                {
                    var absExpiration = DateTime.UtcNow.AddMilliseconds(1);
                    var distributedCache = ApplicationContext.Current.ApplicationManager.AppCache.RequestCache;
                    distributedCache.InsertCacheItem(key, null, absExpiration);
                }
            }
            finally
            {
                _lockSlim.ExitWriteLock();
            }
        }
    }
}﻿using System;

namespace Umbraco.Community.RateLimiting
{
    public class DistributedRateLimiterException : Exception
    {
        public DistributedRateLimiterException()
        {
        }

        public DistributedRateLimiterException(string message)
            : base(message)
        { }

        public DistributedRateLimiterException(string message, Exception innerException)
            : base(message, innerException)
        { }
    }
}//src/Umbraco.Community.RateLimiting/RateLimitingExtensions.cs
﻿using Umbraco.Core;
using Umbraco.Web;

namespace Umbraco.Community.RateLimiting
{
    public static class RateLimitingExtensions
    {
        public static bool RateLimitCanExecute(this DistributedRateLimiterService service, string key)
        {
            var umbracoHelper = new UmbracoHelper(UmbracoContext.Current.Application);

            //TODO: Use umbracoHelper to get the current ip or member Id if authenticated
            var current = umbracoHelper.TypedRequestParser().CurrentClientIpAddress;
            return service.CanExecute(current, key);
        }
    }
