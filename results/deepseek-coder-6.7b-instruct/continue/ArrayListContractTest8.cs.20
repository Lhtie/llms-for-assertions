﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using List;
using PexAPIWrapper;

namespace List.Test
{
    [TestFixture, PexClass]
    public partial class ListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]List list, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_listCount = list.Count;
            int Old_x = x;
            int Old_listIndexOfX = list.IndexOf(x);
            int Old_listLastIndexOfX = list.LastIndexOf(x);
            bool Old_listContainsX = list.Contains(x);

            int New_Ret = list.Add(x);

            int New_listCount = list.Count;
            int New_listIndexOfX = list.IndexOf(x);
            int New_listLastIndexOfX = list.LastIndexOf(x);

            bool New_listContainsX = list.Contains(x);

            PexObserve.ValueForViewing("$old_list_Count", Old_listCount);
            PexObserve.ValueForViewing("$new_list_Count", New_listCount);
            PexObserve.ValueForViewing("$old_list_x", Old_x);
            PexObserve.ValueForViewing("$old_list_IndexOf_x", Old_listIndexOfX);
            PexObserve.ValueForViewing("$new_list_IndexOf_x", New_listIndexOfX);
            PexObserve.ValueForViewing("$old_list_LastIndexOf_x", Old_listLastIndexOfX);
            PexObserve.ValueForViewing("$new_list_LastIndexOf_x", New_listLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_list_contains_x", Old_listContainsX);
            PexObserve.ValueForViewing("$new_list_contains_x", New_listContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x is geq an index of x in new list 
	    Assert.True(New_listContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that last index of x in new list is more or equal last index of x in old list @@@ last index of x in a new list is geq or more than that in an old list of x
	    Assert.True(New_listLastIndexOfX >= Old_listLastIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);"
	    Assert.True(New_Ret == Old_listCount);
--------------------	    Assert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);
	
	    // an assertion using "Debug.Assert\(.*?\);" that count in new array list is one more than old count 
	    Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);
	
	    // an assertion using "Debug.Assert\(.*?\);" that index of x in new array list is eq as new ret value 
	    Assert.IsTrue(New_arrListIndexOfX == New_Ret);
	
	    // an assertion using "Debug.Assert\(.*?\);" that new array list contains x 
	    Assert.IsTrue(New_arrListContainsX == true);
	
	    // an assertion using "Debug.Assert\(.*?\);" that the last index of x in new array list is geq as the index of x in new array list 
	    Assert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);
	
	    AssumeLastIndexOf(Old_arrListLastIndexOfX + 1, x, New_arrListLastIndexOfX);
        }

        public void AssumeLastIndexOf(int Old_arrListCount, int x, int New_arrListLastIndexOfX)
        {
            // Assume that the value of arrList Count is geq than the arrList last index of x in last test method
            Assume.True(Old_arrListCount <= New_arrListLastIndexOfX);

            // Assume that arrList last index of x is geq than arrList count 
            Assume.True(New_arrListLastIndexOfX >= Old_arrListCount);

            // Assume that arrList contains x
            Assume.True(true);
        }
    }
}

