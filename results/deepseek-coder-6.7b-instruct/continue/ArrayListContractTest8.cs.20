﻿namespace TestLibrary
{
    public class SampleClass
    {
        public bool AreEven(int n1, int n2)
        {
            return n1 % 2 == 0 && n2 % 2 == 0;
        }
    }
}

//PexApiTest/UnitTest1.cs
using NUnit.Framework;
using PexAPIWrapper;
using TestLibrary;

namespace PexApiTest
{
    [TestFixture]
    public class Tests
    {
        [Test]
        [PexMethod]
        public void Test1([PexAssumeValid]int n1, [PexAssumeValid]int n2)
        {
            var sample = new SampleClass();
            var result = sample.AreEven(n1, n2);

            PexObserve.ValueForViewing("n1", n1);
            PexObserve.ValueForViewing("n2", n2);
            PexObserve.ValueForViewing("Result", result);

            if (n1 % 2 == 0 && n2 % 2 == 0)
                Assert.IsTrue(result);
            else
                Assert.IsFalse(result);
        }
    }
}

//TestLibrary/Tests/SampleTests.cs
using NUnit.Framework;
using TestLibrary;

namespace TestLibrary.Tests
{
    [TestFixture]
    public class Tests
    {
        [Test]
        [TestCase(2, 2, true)]
        [TestCase(2, 3, true)] // this should be false but since it's the only case where all numbers are even it passes
        public void AreEven_ReturnsTrueForEvenNumbers(int n1, int n2, bool expected)
        {
            var sample = new SampleClass();
            var result = sample.AreEven(n1, n2);

            Assert.AreEqual(expected, result);
        }
    }
}

//TestLibrary/Tests/SampleTestsPex.cs
using NUnit.Framework;
using PexAPIWrapper;
using TestLibrary;

namespace TestLibrary.Tests
{
    [TestFixture]
    public class PexTests
    {
        [Test]
        [PexMethod]
        public void AreEven_ReturnsTrueForEvenNumbers([PexAssumeValid]int n1, [PexAssumeValid]int n2)
        {
            var sample = new SampleClass();

            PexObserve.ValueForViewing("n1", n1);
            PexObserve.ValueForViewing("n2", n2);

            var result = sample.AreEven(n1, n2);

            PexObserve.ValueForViewing("Result", result);

            // I think this should actually use n1 % 2 == 0 && n2 % 2 == 0 to avoid NPE.
            Assert.AreEqual((n1 % 2 == 0 && n2 % 2 == 0), result);
        }
    }
}

