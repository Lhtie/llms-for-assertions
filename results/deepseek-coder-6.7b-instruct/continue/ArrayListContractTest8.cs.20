	    // an assertion that new array list count is geq old array list count plus one
	    Assert.IsTrue(New_arrListCount >= Old_arrListCount + 1);

	    // an assertion that new array list contains x equals old array list contains x
	    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);

