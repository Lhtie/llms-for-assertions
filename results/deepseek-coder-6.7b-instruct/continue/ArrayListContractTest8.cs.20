            Assert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);
        }
    }
}

And this is the code of ArrayList I am using:

        public class ArrayList
        {
            private int[] _data;
            private int _nextIndex;
            public ArrayList()
            {
                _data = new int[4];
                _nextIndex = 0;                
            }

            public int Count
            {
                get { return _nextIndex; }
            }

            public int Add(int value)
            {
                if (_nextIndex >= _data.Length)
                {
                    int[] newArray = new int[_data.Length * 2];
                    Array.Copy(_data, newArray, _data.Length);
                    _data = newArray;
                }

                int index = _nextIndex;
                _data[index] = value;
                _nextIndex++;
                return index;
            }

            public bool Contains(int value)
            {
                for (int index = 0; index < _nextIndex; index++)
                {
                    if (_data[index] == value)
                    {
                        return true;
                    }
                }
                return false;
            }

            public int IndexOf(int value)
            {
                for (int index = 0; index < _nextIndex; index++)
                {
                    if (_data[index] == value)
                    {
                        return index;
                    }
                }
                return -1;
            }

            public int LastIndexOf(int value)
            {
                for (int index = _nextIndex - 1; index >= 0; index--)
                {
                    if (_data[index] == value)
                    {
                        return index;
                    }
                }
                return -1;
            }                

        }

Problem: 
The test is unable to find the right value for count, index, or lastIndexOf variables which are calculated before and after the execution, as evident from the test reports. For e.g when Add is called, the Count, IndexOf and LastIndexOf before and after addition are different which is against the contract.

Please help me identify what I am doing wrong.

A: Pex isn't able to verify the precise sequence in which the methods are executed because of the lack of execution control in Pex (you can only call a method once in Pex). This means that, although Pex tries to find test cases that exercise many different possible paths through your code, it may miss some cases where it expects methods or properties to be in a specific order. 

This becomes a real challenge when you have preconditions that depend on the state of the object after a method call (like your case where you depend on the Count after an Add call). 

You can use a mocking framework or simulate your sequence, but those will not replace the fundamental problem. 

A better approach would be to try to isolate your list's behavior into methods (similar to yours). Then the order of method calls and property interactions will be more predictable and Pex could be able to test them more accurately. You can start by creating methods like InsertAt, RemoveAt etc. And then separately test these operations.

Also, you should use a different tool for your contracts. A tool designed for method contracts, like the method contract coverage tool, is more suitable.

Hope this helps to improve your understanding of the fundamental limitations of Pex.
Regards,
Vineet Ojha

A: You need to take into consideration that your Pex test runs Add() method more than one time and you cannot predict in what order the methods will be called. Therefore, it's possible that the Count or Index property will return wrong values. 
For example, after three different Add() calls, if Count property returns value greater than three then your Add returns wrong index. 
Thus, it is important to always check the value of the Count property before and after an Add and make sure that this value is incremented correctly.
Moreover, you need to make sure that the Count and the added index are equal or the added index is less than the Count.
