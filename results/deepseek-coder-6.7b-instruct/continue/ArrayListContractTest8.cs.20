        [Test]
        public void Test_Add()
        {
            ArrayList list = new ArrayList();
            list.Add(100);
            Assert.AreEqual(1, list.Count);
            list.Add(200);
            Assert.AreEqual(2, list.Count);
        }

        [Test]
        public void Test_Add_Object()
        {
            ArrayList list = new ArrayList();
            list.Add(new object());
            Assert.AreEqual(1, list.Count);
        }

        [Test]
        public void Test_Add_Item_By_Index()
        {
            ArrayList list = new ArrayList();
            list.Add(100);
            list.Add(200);
            list.Add(300);
            list.Add(2, 400);
            Assert.AreEqual(400, list.Get(2));
        }
    }
}

