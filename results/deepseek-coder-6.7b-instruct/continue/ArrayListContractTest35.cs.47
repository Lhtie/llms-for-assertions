//ArrayList/ArrayListTests/ArrayListUnitTest.cs
﻿using System;
using System.Collections;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTests
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Remove(1);
            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Insert(0, 1);
            Assert.AreEqual(1, arrList[0]);
        }

        [Test]
        public void TestSet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList[0] = 2;
            Assert.AreEqual(2, arrList[0]);
        }

        [Test]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.IsTrue(arrList.Contains(1));
        }

        [Test]
        public void TestIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(0, arrList.IndexOf(1));
        }

        [Test]
        public void TestLastIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(1);
            Assert.AreEqual(1, arrList.LastIndexOf(1));
        }
    }
