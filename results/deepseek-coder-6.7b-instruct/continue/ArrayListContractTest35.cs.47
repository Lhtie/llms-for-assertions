public class MathUtilsTest
{
    [Test]
    [TestCase(1, 1, ExpectedResult = 1)]
    [TestCase(2, 2, ExpectedResult = 4)]
    [TestCase(3, 3, ExpectedResult = 27)]
    [TestCase(4, 4, ExpectedResult = 256)]
    [TestCase(5, 5, ExpectedResult = 3125)]
    public int Pow_PositiveNumber_ShouldSquareNumbers(int baseNumber, int exponent)
    {
        return MathUtils.Power(baseNumber, exponent);
    }

    [Test]
    [TestCase(-1, 1, ExpectedResult = -1)]
    [TestCase(-2, 2, ExpectedResult = 4)]
    [TestCase(-3, 3, ExpectedResult = -27)]
    [TestCase(2, -2, ExpectedResult = 0.25)]
    [TestCase(2, -1, ExpectedResult = 0.5)]
    public int Pow_NegativeNumber_ShouldHandlePositiveExponent(int baseNumber, int exponent)
    {
        return MathUtils.Power(baseNumber, exponent);
    }

    [Test]
    [TestCase(0, 0)]
    [TestCase(0, 2)]
    [TestCase(2, 0)]
    public void Pow_Zero_ShouldThrowArgumentException(int baseNumber, int exponent)
    {
        Assert.Throws<ArgumentException>(() => MathUtils.Power(baseNumber, exponent));
    }
}

public static class MathUtils
{
    public static int Power(int baseNumber, int exponent)
    {
        if ((baseNumber == 0 && exponent <= 0) || (baseNumber < 0 && exponent % 2 != 0))
        {
            throw new ArgumentException();
        }

        int result = 1;
        for (int i = 0; i < exponent; i++)
        {
            result *= baseNumber;
        }

        return result;
    }
}﻿using System;
