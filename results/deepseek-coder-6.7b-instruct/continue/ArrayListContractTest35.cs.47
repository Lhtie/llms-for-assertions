using System;

namespace NServiceBus.MsmqTransport.Tests.Utils
{
    public static class MessageSerializationExtensions
    {
        public static T DeserializeAndReturn<T>(this byte[] bytes, IWantToUseInitializableWireFormatter frmt)
        {
            var message = Serialization.MessageSerializer.DeserializeJson(bytes, frmt);
            return (T)message;
        }

        public static T DeserializeAndReturn<T>(this string str)
        {
            var message = Serialization.MessageSerializer.DeserializeJson(str);
            return (T)message;
        }
    }
}using System;
using System.IO;
using System.Runtime.Serialization.Formatters;
using NServiceBus.Serialization;
using NServiceBus.Settings;

namespace NServiceBus.MsmqTransport.Tests.Utils
{
    public class CustomSerialization : ISerializationMethod
    {
        static IFormatter formatter = new BinaryFormatter();

        public object Deserialize(MessagePersistenceWrapper wrapper, ReadOnlySettings settings)
        {
            using (var memoryStream = new MemoryStream(wrapper.Body))
            {
                return formatter.Deserialize(memoryStream);
            }
        }

        public object DeserializeHeader(byte[] header, ReadOnlySettings settings)
        {
            using (var memoryStream = new MemoryStream(header))
            {
                return formatter.Deserialize(memoryStream);
            }
        }

        public void Serialize(object message, Stream stream, ReadOnlySettings settings)
        {
            formatter.Serialize(stream, message);
        }

        public ReadOnlySettings Settings { get; set; }
    }
}﻿using System;
using System.IO;
using System.IO.Compression;
using System.Xml.Serialization;
using NServiceBus.Settings;

namespace NServiceBus.MsmqTransport.Tests.Utils
{
    public class CustomSerializationV2
    {

        public static void Serialize(object message, Stream stream)
        {
            var xmlSerializer = new XmlSerializer(message.GetType());


            using (var gzipStream = new GZipStream(stream, CompressionMode.Compress))
            {
                xmlSerializer.Serialize(gzipStream, message);
            }
        }

        public static object Deserialize(Type type, Stream stream)
        {
            var xmlSerializer = new XmlSerializer(type);

            using (var gzipStream = new GZipStream(stream, CompressionMode.Decompress))
            {
                return xmlSerializer.Deserialize(gzipStream);
            }
        }
    }

    public class CustomSerializationMethod : ISerializationMethod
    {
        public object Deserialize(MessagePersistenceWrapper wrapper, ReadOnlySettings settings)
        {
            return CustomSerializationV2.Deserialize(wrapper.Type, new MemoryStream(wrapper.Body));
        }

        public object DeserializeHeader(byte[] header, ReadOnlySettings settings)
        {
            throw new NotImplementedException();
        }

        public void Serialize(object message, Stream stream, ReadOnlySettings settings)
        {
            CustomSerializationV2.Serialize(message, stream);
        }

        public ReadOnlySettings Settings { get; set; }
    }
