#### ContractInvariant
```csharp
[ContractInvariantMethod]
private void ObjectInvariant()
{
    Contract.Invariant(this.Count >= 0);
    Contract.Invariant(this.Capacity >= 0);
}
```
#### IsValid
```csharp
protected virtual bool IsValid(T item)
{
    return true;
}
```
#### Private Fields
```csharp
private T[] array;
private int count;
```
#### Public Properties
```csharp
public int Count { get { return this.count; } }
public int Capacity { get { return this.array.Length; } }
public T this[int index]
{
    get { return this.array[index]; }
    set
    {
        if (!this.IsValid(value))
            throw new ArgumentException();

        this.array[index] = value;
    }
}
```
#### Public Methods
```csharp
public void Add(T item)
{
    if (!this.IsValid(item))
        throw new ArgumentException();

    this.EnsureCapacity();
    this.array[this.count] = item;
    this.count++;
}

public bool Remove(T item)
{
    for (int i = 0; i < this.count; i++)
    {
        if (Object.Equals(this.array[i], item))
        {
            if (i != this.count - 1)
                this.array[i] = this.array[this.count - 1];

            this.count--;
            return true;
        }
    }

    return false;
}
```

### ArrayList2
`ArrayList2` is a replacement for `ArrayList` which uses generics and allows you to specify a specific validate function for all items within the list.
#### Fields
```csharp
private T[] array;
private int count;
private Func<T, bool> validate;
```
#### Constructor
```csharp
public ArrayList2(Func<T, bool> validate)
{
	this.array = new T[4];
	this.validate = validate;
}
```
#### Properties
```csharp
public int Count { get { return this.count; } }
public int Capacity { get { return this.array.Length; } }

public T this[int index]
{
    get { return this.array[index]; }
    set
    {
        if (index < 0 || index >= this.count)
            throw new IndexOutOfRangeException();

        if (!this.validate(value))
            throw new ArgumentException();

        this.array[index] = value;
    }
}
```
#### Methods
```csharp
