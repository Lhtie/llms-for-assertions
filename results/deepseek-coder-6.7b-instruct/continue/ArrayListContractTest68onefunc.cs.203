}﻿using System.Collections.Generic;
using Verse;
using UnityEngine;

namespace ExtraLaser;

public class CompProjectileExtraLaser : ThingComp
{
    private Dictionary<Thing, ExtraLaserRecord> extraLaserRecords = new Dictionary<Thing, ExtraLaserRecord>();

    public ExtraLaserRecord GetExtraLaserRecord(Thing thing)
    {
        if (!extraLaserRecords.ContainsKey(thing))
        {
            extraLaserRecords[thing] = new ExtraLaserRecord();
        }
        return extraLaserRecords[thing];
    }

    public bool IsExtraLaserActive(Thing thing)
    {
        if (!thing.Spawned)
        {
            return false;
        }
        var laserSpot = parent as Building_LaserDefense;
        return thing.def.category == ThingCategory.Projectile
               && !thing.DestroyedOrNull()
               && parent.Position.InHorDistOf(thing.Position, 1f * ((laserSpot != null) ? laserSpot.power : 1f))
               && !ParentHediffHasFlagWith(thing, "LASER_REFLECTED");
    }

    public bool IsLaser(ThingDef def)
    {
        return def.category == ThingCategory.Projectile && !def.EverSpawned;
    }

    private bool ParentHediffHasFlagWith(Thing thing, string flag)
    {
        foreach (var hediff in parent.AllWornHediffs)
        {
            if (hediff.def.HasStage &&
                hediff.IsPermanent() &&
                !hediff.def.IsHealSet() &&
                !hediff.def.preventAutoHeal &&
                hediff.def.hasActiveStage &&
                hediff.def.stages.Exists(
                    stage => stage.postTickAction == StagePostTickAction.RevealAllPainRelated &&
                             (stage.commonCauses != null) &&
                             stage.commonCauses.Contains(flag))
            )
            {
                return thing == hediff.pawn || hediff.pawn.inventory != null &&
                       hediff.pawn.inventory.Contains(thing);
            }
        }
        return false;
    }
}

