            {
                PexAssert.AreEqual(-1, New_Ret);
            }

            // Assertion about @@@ If the return value is greater or equal than 0, x is in old list and its first present position is equal to return value.
            if (Old_arrListContainsX && New_Ret >= 0)
            {
                PexAssert.AreEqual(Old_arrListLastIndexOfX, New_Ret);
            }

            // Assertion about size remains the same.
            PexAssert.AreEqual(Old_arrListCount, New_arrListCount);

            // Assertion about contains remains the same.
            PexAssert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
        }
    }
