            Debug.Assert(New_arrListLastIndexOfX == Old_arrListCount ? New_Ret : Old_arrListLastIndexOfX);

	    //  an assertion using "Debug.Assert\(.*?\);" that @@ if x is in the original list so it should be in the new list
