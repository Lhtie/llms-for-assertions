﻿using System.Data;
using System.Runtime.Serialization.Formatters.Binary;
using System.IO;

namespace ExcelDna.Extensions
{
    public static class SerializationExtensions
    {
        public static byte[] ToByteArray(this DataTable toBeSerialized)
        {
            BinaryFormatter binaryFormatter = new BinaryFormatter();
            MemoryStream memoryStream = new MemoryStream();
            binaryFormatter.Serialize(memoryStream, toBeSerialized);
            return memoryStream.ToArray();
        }

        public static DataTable ToDataTable(this byte[] toBeDeserialized)
        {
            MemoryStream memoryStream = new MemoryStream(toBeDeserialized);
            BinaryFormatter binaryFormatter = new BinaryFormatter();
            return (DataTable)binaryFormatter.Deserialize(memoryStream);
        }
    }
}

//ExcelDna/ExcelDna/Helpers/SerializationHelper.cs
﻿using System;
using System.IO;
using System.Runtime.Serialization.Formatters.Binary;
using System.Xml.Serialization;

namespace ExcelDna.Helpers
{
    public static class SerializationHelper
    {
        public static string BinarySerialize<T>(T objectToSerialize)
        {
            using (MemoryStream stream = new MemoryStream())
            {
                BinaryFormatter formatter = new BinaryFormatter();
                formatter.Serialize(stream, objectToSerialize);
                return Convert.ToBase64String(stream.ToArray());
            }
        }

        public static T BinaryDeserialize<T>(string serializedObject)
        {
            byte[] bytes = Convert.FromBase64String(serializedObject);

            using (MemoryStream stream = new MemoryStream(bytes))
            {
                BinaryFormatter formatter = new BinaryFormatter();
                return (T)formatter.Deserialize(stream);
            }
        }

        public static string XmlSerialize<T>(T objectToSerialize)
        {
            XmlSerializer xmlSerializer = new XmlSerializer(typeof(T));
            using (StringWriter textWriter = new StringWriter())
            {
                xmlSerializer.Serialize(textWriter, objectToSerialize);
                return textWriter.ToString();
            }
        }

        public static T XmlDeserialize<T>(string serializedObject)
        {
            XmlSerializer xmlSerializer = new XmlSerializer(typeof(T));
            using (StringReader textReader = new StringReader(serializedObject))
            {
                return (T) xmlSerializer.Deserialize(textReader);
            }
        }
    }
}

