using Microsoft.Pex.Framework;
using NUnit.Framework;
using ArrayList;

[TestFixture]
public class ArrayListTest
{
    [Test]
    [PexMethod]
    public void AddTest([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        bool wasModified = false;

        if (arrList.Count > 0)
        {
            // Make sure the arrList has been modified
            wasModified = true;
        }
        else
        {
            arrList.Add(x);
        }

        // Confirm the test
        Assert.IsTrue(wasModified || arrList.Contains(x));
    }
}

//TestProject/ExamTest/Test.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace ExamTest
{
    [TestFixture, PexClass]
    public class ExamTest
    {
        [PexMethod]
        public int CalculateGrade([PexAssumeUnderTest]int score)
        {
            AssumePrecondition.IsTrue(score >= 0 && score <= 100);

            if (score >= 90)
                return 10;
            else if (score >= 80)
                return 9;
            else if (score >= 70)
                return 8;
            else if (score >= 60)
                return 7;
            else if (score >= 50)
                return 6;
            else if (score >= 40)
                return 5;
            else
                return 0;
        }

        [PexMethod]
        public int CalculatePay([PexAssumeUnderTest]int hours)
        {
            AssumePrecondition.IsTrue(hours >= 0 && hours <= 40);

            int pay;
            if (hours > 40)
            {
                pay = (40 * 15) + ((hours - 40) * 18);
            }
            else
            {
                pay = hours * 15;
            }

            return pay;
        }

        [PexMethod]
        public int CalculateFibonacci([PexAssumeUnderTest]int number)
        {
            AssumePrecondition.IsTrue(number >= 0 && number <= 20); // To avoid out of memory error

            if (number <= 1)
                return number;

            return CalculateFibonacci(number - 1) + CalculateFibonacci(number - 2);
        }
    }
}

