	    
        }	    
}
    }
}

This is an example of how you can define Preconditions, Asserts, Test Observers for the contracts, and how to use it for each test method.

The key to using observers and preconditions is to ensure the initial state is well defined (i.e., "Assume" conditions) and the final state is well observed (i.e., "Observe" results). 

One can add as many preconditions and observers as needed to test any additional properties or behaviors that you require.


A: I'm assuming that ArrayList is from the System.Collections library and that you've implemented all the necessary properties and methods, which I'm not sure without more of the ArrayList class.

The code provided can be improved by using NUnit's Assert library to test individual properties and methods in the ArrayList. Here is an example of how such a test might look with NUnit:

    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestIndexOf()
        {
            // Create the array
            ArrayList arrList = new ArrayList();
            
            // Add items to the array
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            
            // Use NUnit's Assert library to check the IndexOf method
            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));
            Assert.AreEqual(2, arrList.IndexOf(3));
            Assert.AreEqual(-1, arrList.IndexOf(4));
        }
        
        // Similar tests for other methods...
    }

In this example, we're creating an ArrayList, adding items to it, and then checking the IndexOf method. The Assert.AreEqual method checks if the expected and actual results are the same, and if they aren't, the test fails.

It's also important to note that automated testing with Pex, as described in this post, should be used to identify and test complex edge-case scenarios. These scenarios should not be tested using individual Assert statements as it can become extremely time-consuming and difficult to maintain.

Lastly, always remember to test a variety of edge cases. What might seem like a simple check in a human's viewpoint, might not be as obvious when we are checking it programmatically. 

Consider reading up on Test Driven Development to learn more about this. Basically, you write tests before you write the actual code, so that you can ensure that your code behaves the way you expect it to. 

As a final advice, a good unit-test suite should be readable by humans and machines and easy to write, easy to maintain, easy to run, easy to update, and easy to understand.

So, NUnit and Pex together are a powerful tool for achieving that, if you are not already utilizing them.


Note: Pex is a part of Visual Studio 2010 Ultimate/Premium/Professional with MSFForge 2010 installed and NUnit or MSTest is part of a project where Pex will be added as a reference. Pex can be used by right clicking a method and choosing 'Pex - Generate All Tests...'


A: As you correctly mentioned, one of the most important aspects of testing is to cover as many scenarios as you can by writing multiple Unit Tests. In the case of Pex and NUnit combined, here's an example of a Unit Test with Pex:
[Test, PexMethod]
public void MyArrayListTest(int x, int y)
{
    // Arrange
    PexAssume.IsTrue(x >= y); // Precondition
    ArrayList list = new ArrayList();

    // Act
    list.Add(x);
    list.Add(y);

    // Assert
    Assert.AreEqual(x, list[0]);
    Assert.AreEqual(y, list[1]);
}

NUnit will auto-generate various sets of inputs (here x and y inputs) from your precondition (x >= y), and the above test will be executed with each of those. This allows you to thoroughly test an algorithm regardless of the input values that you provide to it.

Another aspect which can be helpful for your testing, is to look at the Pex coverage report. It will show you exactly which parts of your testing coverage are low and which parts are missing. 

Please note that Pex cannot--------------------	    PexObserve.IfThen("&lt;Assert_LastIndexOf_x&gt;", New_Ret == true, New_arrListLastIndexOfX <= Old_arrListLastIndexOfX );

         }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the Ret is not -1, new list's last index of x is <= old list's last index of x  
	    PexObserve.IfThen("&lt;Assert_IndexOf_x&gt;", New_Ret != -1, New_arrListLastIndexOfX <= Old_arrListLastIndexOfX );
  

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }

        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Sort();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }
    }
