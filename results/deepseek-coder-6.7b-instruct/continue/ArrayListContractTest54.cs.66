}using System;
using Microsoft.SPOT;
using System.Threading;
using Microsoft.SPOT.Hardware;

namespace IntervalTimers.IntervalTimer
{
    public class IntervalTimer : IDisposable
    {
        public delegate void ActionDelegate();

        public struct Interval
        {
            public int msInterval;
            public int msSlack;
            public ActionDelegate actionDelegate;
        }

        private bool _running = false;
        private Thread _intervalThread;
        private Interval[] _intervals;

        public IntervalTimer(Interval[] intervals, bool runImmediately = true)
        {
            _intervals = intervals;
            if (runImmediately)
                Start();
        }

        public void Start()
        {
            if (_running) return;

            _running = true;

            _intervalThread = new Thread(ThreadedAction);
            _intervalThread.Start();
        }

        public void Stop()
        {
            _running = false;
        }

        private void ThreadedAction()
        {
            while (true)
            {
                foreach (var interval in _intervals)
                {
                    ManualResetEventSlim waitEvent = new ManualResetEventSlim(false);
                    ThreadPool.QueueUserWorkItem(x =>
                    {
                        Thread.Sleep(interval.msInterval + interval.msSlack);
                        waitEvent.Set();
                    });

                    if (waitEvent.Wait(interval.msInterval))
                        interval.actionDelegate();
                }

                Thread.Sleep(1); // yield to other threads
            }
        }

        public void Dispose()
        {
            _running = false;
            _intervalThread.Abort();
        }
    }
}using System;
using Microsoft.SPOT;
using System.Net.Sockets;
using System.Net;
using System.IO;

namespace IntervalTimers.Networking
{
    public class Networking : IDisposable
    {
        string server = "stormboard.com";
        int port = 55555;

        TcpClient client = new TcpClient();
        public bool Connected = false;

        StreamWriter writer;
        StreamReader reader;

        public Networking()
        {
            try
            {
                client.Connect(server, port);
                Connected = client.Connected;
                writer = new StreamWriter(client.GetStream());
                reader = new StreamReader(client.GetStream());
            }
            catch (Exception)
            {
                Connected = false;
            }
        }

        public void SendData(int intervalID, int reading)
        {
            if (Connected)
            {
                writer.WriteLine(intervalID + "," + reading);
                writer.Flush();
            }
        }

        public string ReadData()
        {
            if (Connected)
            {
                return reader.ReadLine();
            }

            return "";
        }

        public void Dispose()
        {
            if (Connected)
            {
                client.Close();
            }
        }
    }
}using System;
