        [Test]
        public void TestGet()
        {
            ArrayList list = new ArrayList();
            int x = 1;
            list.Add(x);
            int index = 0;
            Assert.AreEqual(x, list[index]);
        }

        [Test]
        public void TestContains()
        {
            ArrayList list = new ArrayList();
            int x = 1;
            Assert.IsFalse(list.Contains(x));
            list.Add(x);
            Assert.IsTrue(list.Contains(x));
        }
    }
