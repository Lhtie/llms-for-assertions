﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

using ArrayList;
using NUnit.Framework;

namespace ArrayList.Test 
{ 
    [TestFixture]
    public class ArrayListTest 
    { 
        [Test]
        public void testConstructor() 
        {
            ArrayList emptyList = new ArrayList();
            Assert.AreEqual(emptyList.Count, 0);

            ArrayList countList = new ArrayList(5);
            Assert.AreEqual(countList.Count, 5);
        }

        [Test]
        public void testAdd() 
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            Assert.AreEqual(list.Count, 1);
            Assert.AreEqual(list[0], 10);

            list.Add(20);
            Assert.AreEqual(list.Count, 2);
            Assert.AreEqual(list[1], 20);
        }

        [Test]
        public void testRemove()
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            list.Add(20);
        
            int a = list.Remove(1);
            Assert.AreEqual(list.Count, 1);
            Assert.AreEqual(list[0], 10);
            Assert.AreEqual(a, 20);
        }

        [Test]
        public void testInsert()
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            list.Add(20);

            list.Insert(1, 15);
            Assert.AreEqual(list.Count, 3);
            Assert.AreEqual(list[1], 15);
            Assert.AreEqual(list[2], 20);

        }

        [Test]
        public void testSet()
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            list.Add(20);

            list[1] = 30;
            Assert.AreEqual(list.Count, 2);
            Assert.AreEqual(list[1], 30);
        }

        [Test]
        public void testGet()
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            list.Add(20);

            Assert.AreEqual(list[0], 10);
            Assert.AreEqual(list[1], 20);
        }

        [Test]
        public void testContains()
        {
            ArrayList list = new ArrayList();
            list.Add(10);
            list.Add(20);

            Assert.IsTrue(list.Contains(10));
            Assert.IsFalse(list.Contains(50));
        }
    }
}using System;

class Program {
  static void Main() {
       
   double[] salarios = new double[10];

   double soma = 0;
   
    for(int i=0; i < 10; i++)
    {
       Console.Write("Digite o salário " + (i+1) + ": ");
       salarios[i]= double.Parse(Console.ReadLine());
       soma += salarios[i];  
    }

   double media = soma / 10;

   Console.WriteLine("A média salarial é R$ "  + media);
   
   int qtdeAcimaDaMedia = 0;

   for(int i=0; i < 10; i++)
    {
       if(salarios[i]>media)
      
        qtdeAcimaDaMedia++;
    }

   Console.WriteLine("Quantidade de funcionários que recebem mais que a média: " + qtdeAcimaDaMedia);

  }
}

