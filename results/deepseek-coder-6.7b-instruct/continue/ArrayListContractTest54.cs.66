    }

    public void Insert(int index, int item)
    {
        list.Insert(index,item);
    }

    public int this[int index]
    {
        set { list[index] = value; }
        get { return list[index]; }
    }

    public int IndexOf(int item)
    {
        return list.IndexOf(item);
    }

    public int LastIndexOf(int item)
    {
        return list.LastIndexOf(item);
    }

    public bool Contains(int item)
    {
        return list.Contains(item);
    }
}

I've used a List<T> internally to represent the ArrayList in C# as you're probably testing your ArrayList class as well, but with an important point to note. 
You should avoid testing your ArrayList class methods individually using PEX as it tends to find lots of corner cases and timeouts that do not make sense in the context of a regular List<T>. 
Instead you should try to write a test that exercises your class as a whole. Also, I've included a getter for Count property of ArrayList in the class for consistency with original--------------------
                }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_x_at_Old_index = (int)arrList[index];
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(Old_x_at_Old_index);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(Old_x_at_Old_index);
            bool Old_arrListContainsX = arrList.Contains(Old_x_at_Old_index);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(Old_x_at_Old_index);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(Old_x_at_Old_index);
            bool New_arrListContainsX = arrList.Contains(Old_x_at_Old_index);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x_at_old_index", Old_x_at_Old_index);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }

