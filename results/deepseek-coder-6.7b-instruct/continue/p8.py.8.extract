Question 2: Matrix Square Root
<jupyter_code>
def nearest_symetric(A):
    M = (A + A.T) / 2
    np.fill_diagonal(M, M.diagonal() * 0.5)
    return M

def symmetrize(A):
    return (A + A.T) / 2

def matrix_sqrt(A):
    w, v = np.linalg.eig(A)
    assert np.all(w >= 0)  # ensure A is positive semi-definite
