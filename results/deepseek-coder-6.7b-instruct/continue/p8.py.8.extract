# another assertion that vec is an eigenvector (v' should be v divided by its 2-norm)
np.testing.assert_allclose(vec / np.linalg.norm(vec, 2), evectors[:, 0])

# calculate inverse of the matrix
mtx_inv = np.linalg.inv(mtx)

# assertion that eigenvalues from a inverse matrix should be the reciprocals if the original matrix has real eigenvalues
assert np.allclose(evalues ** -1, np.linalg.eigvals(mtx_inv))
--------------------# i.e., lambda * vec is the eigenvector for the eigenvalue lambda in the matrix mtx
assert np.allclose(lambda * vec, lambdavec)
