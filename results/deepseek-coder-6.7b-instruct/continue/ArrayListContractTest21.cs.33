}﻿using SQLite;
using System;
using System.Collections.Generic;

namespace ZXing.Mobile.NetStandard.Demo
{
    public class CodeLogsRepository
    {
        private SQLiteConnection connection;

        public CodeLogsRepository(ISQLitePlatform sqlitePlatform)
        {
            connection = new SQLiteConnection(sqlitePlatform, "ScanCodes.db3");
            connection.CreateTable<CodeLog>();
        }

        public void AddLog(CodeLog codeLog)
        {
            if (connection == null)
                return;

            connection.Insert(codeLog);
        }

        public List<CodeLog> GetLogs()
        {
            if (connection == null)
                return new List<CodeLog>();

            return connection.Table<CodeLog>().ToList();
        }
    }
