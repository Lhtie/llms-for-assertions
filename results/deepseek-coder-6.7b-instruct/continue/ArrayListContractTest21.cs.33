namespace ZXing.Mobile.NetStandard.Demo
{
    public class CodeLog
    {
        [PrimaryKey, AutoIncrement]
        public int Id { get; set; }
        public DateTime ScannedAt { get; set; }
        public string Content { get; set; }

        public CodeLog()
        {
        }

