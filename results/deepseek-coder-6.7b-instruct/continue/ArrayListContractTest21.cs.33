﻿using System;

namespace FizzBuzz
{
    class Program
    {
        static void Main(string[] args)
        {
            FizzBuzz(100);
            Console.ReadLine();
        }

        public static void FizzBuzz(int n)
        {
            for (int i = 1; i <= n; i++)
            {
                if (i % 3 == 0 && i % 5 == 0)
                {
                    Console.WriteLine("FizzBuzz");
                }
                else if (i % 3 == 0)
                {
                    Console.WriteLine("Fizz");
                }
                else if (i % 5 == 0)
                {
                    Console.WriteLine("Buzz");
                }
                else
                {
                    Console.WriteLine(i);
                }
            }
        }
    }
}

//FizzBuzzTest/UnitTest1.cs
using FizzBuzz;
using NUnit.Framework;
using System;

namespace FizzBuzzTest
{
    public class Tests
    {
        [SetUp]
        public void Setup()
        {
        }

        [Test]
        public void FizzBuzz_Test()
        {
            StringAssert.Contains("1", GetFizzBuzzForNumber(1));
            StringAssert.Contains("2", GetFizzBuzzForNumber(2));
            StringAssert.Contains("Fizz", GetFizzBuzzForNumber(3));
            StringAssert.Contains("4", GetFizzBuzzForNumber(4));
            StringAssert.Contains("Buzz", GetFizzBuzzForNumber(5));
            StringAssert.Contains("Fizz", GetFizzBuzzForNumber(6));
            StringAssert.Contains("7", GetFizzBuzzForNumber(7));
            StringAssert.Contains("8", GetFizzBuzzForNumber(8));
            StringAssert.Contains("Fizz", GetFizzBuzzForNumber(9));
            StringAssert.Contains("Buzz", GetFizzBuzzForNumber(10));
            StringAssert.Contains("11", GetFizzBuzzForNumber(11));
            StringAssert.Contains("Fizz", GetFizzBuzzForNumber(12));
            StringAssert.Contains("13", GetFizzBuzzForNumber(13));
            StringAssert.Contains("14", GetFizzBuzzForNumber(14));
            StringAssert.Contains("FizzBuzz", GetFizzBuzzForNumber(15));
        }

        private string GetFizzBuzzForNumber(int n)
        {
            var consoleOutput = new ConsoleOutput(() => Program.FizzBuzz(n));
            return consoleOutput.GetOuput();
        }
    }

    public class ConsoleOutput : IDisposable
    {
        private StringWriter stringWriter;
        private TextWriter originalOutput;

        public ConsoleOutput(Action action)
        {
            stringWriter = new StringWriter();
            originalOutput = Console.Out;
            Console.SetOut(stringWriter);

            action();
        }

        public string GetOuput()
        {
            return stringWriter.ToString();
        }

        public void Dispose()
        {
            Console.SetOut(originalOutput);
            stringWriter.Dispose();
        }
    }
