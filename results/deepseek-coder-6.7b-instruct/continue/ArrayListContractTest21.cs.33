﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using MySQLConnectExample;

namespace MySQLConnectExample.Test
{
    [TestFixture, PexClass]
    public partial class MySQLConnectExampleContractTest
    {
        [PexMethod, PexExplorationComplete]
        public void PUT_ConnectContract([PexAssumeUnderTest]Database db, string connectionString)
        {
            AssumePrecondition.IsTrue(true);

            bool Old_dbConnected = db.IsConnected();

            db.Connect(connectionString);

            bool New_dbConnected = db.IsConnected();

            PexObserve.ValueForViewing("$old_db_Connected", Old_dbConnected);
            PexObserve.ValueForViewing("$new_db_Connected", New_dbConnected);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if old db not connected, new db must be connected 
	    return (Old_dbConnected == false && New_dbConnected == true);

        }

        [PexMethod, PexExplorationComplete]
        public void PUT_DisconnectContract([PexAssumeUnderTest]Database db)
        {
            AssumePrecondition.IsTrue(true);

            bool Old_dbConnected = db.IsConnected();

            db.Disconnect();

            bool New_dbConnected = db.IsConnected();

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if old db was connected, new db must not be connected 
	    return (Old_dbConnected == true && New_dbConnected == false);

        }
    }
}

