﻿using Android.App;
using Android.Content;
using XamarinForms_DependencyServices.DependencyServices;
using XamarinForms_DependencyServices.Droid;

[assembly: Xamarin.Forms.Dependency(typeof(LocalSettings))]
namespace XamarinForms_DependencyServices.Droid
{
    public class LocalSettings : ILocalSettings
    {
        private ISharedPreferences _appSettings;

        public LocalSettings()
        {
            _appSettings = Application.Context.GetSharedPreferences("AppSettings", FileCreationMode.Private);
        }

        public void AddSetting(string key, string value)
        {
            var editor = _appSettings.Edit();
            editor.PutString(key, value);
            editor.Commit();
        }

        public string GetSetting(string key)
        {
            return _appSettings.GetString(key, "");
        }
    }
}

//XamarinForms_DependencyServices/XamarinForms_DependencyServices.iOS/LocalSettings.cs
﻿using Foundation;
using XamarinForms_DependencyServices.DependencyServices;
using XamarinForms_DependencyServices.iOS;

[assembly: Xamarin.Forms.Dependency(typeof(LocalSettings))]
namespace XamarinForms_DependencyServices.iOS
{
    public class LocalSettings : ILocalSettings
    {
        private NSMutableDictionary _appSettings;

        public LocalSettings()
        {
            _appSettings = new NSMutableDictionary(NSString.FromString("AppSettings"), null);
        }

        public void AddSetting(string key, string value)
        {
            _appSettings[NSString.FromString(key)] = NSString.FromString(value);
        }

        public string GetSetting(string key)
        {
            var val = _appSettings.ValueForKey(new NSString(key));
            return val != null ? val.ToString() : "";
        }
    }
}

