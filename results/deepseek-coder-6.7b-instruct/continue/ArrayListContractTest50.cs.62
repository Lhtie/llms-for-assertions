            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            // an assertion using "Debug.Assert\(.*?\);" ensuring that New ret is >= old indexOfX and <= old arrList count
            Debug.Assert(New_Ret >= Old_arrListIndexOfX && New_Ret <= Old_arrListCount - 1);
        }
    }	
