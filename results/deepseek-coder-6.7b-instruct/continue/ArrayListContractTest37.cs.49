        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            object Old_arrListElementAtIndex = arrList[index];
            bool Old_arrListContainsX = arrList.Contains(Old_arrListElementAtIndex);

            arrList.RemoveAt(index);


            int New_arrListCount = arrList.Count;
            object New_arrListElementAtIndex = index < New_arrListCount ? arrList[index] : null;
            bool New_arrListContainsX = arrList.Contains(Old_arrListElementAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$New_arrListElementAtIndex", New_arrListElementAtIndex);
            PexObserve.ValueForViewing("$old_arrList_elementAt_index", Old_arrListElementAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_X", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_X", New_arrListContainsX);

        }


