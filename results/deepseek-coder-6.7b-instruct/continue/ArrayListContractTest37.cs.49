﻿using System.Collections;
using ArrayList;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace TestArrayList
{
    [TestClass]
    public class TestArrayList
    {
        [TestMethod]
        public void TestInitializeArrayList()
        {
            ArrayList arrList = new ArrayList();
            Assert.IsNotNull(arrList);
        }

        [TestMethod]
        public void TestAddRemove()
        {
            ArrayList arrList = new ArrayList();
            
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            
            Assert.AreEqual(3, arrList.Count);

            arrList.Remove(20);
            Assert.AreEqual(2, arrList.Count);
        }


        [TestMethod]
        public void TestIndexOf()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(50);
            arrList.Add(20);
            arrList.Add(30);

            int index = arrList.IndexOf(50);

            Assert.AreEqual(0, index);

            index = arrList.IndexOf(80);
            Assert.AreEqual(-1, index);
        }

        [TestMethod]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(10);
            arrList.Add(30);
            arrList.Add(40);

            arrList.Insert(1, 20);

            Assert.AreEqual(20, arrList[1]);
            Assert.AreEqual(4, arrList.Count);
        }

        [TestMethod]
        [ExpectedException(typeof(System.ArgumentOutOfRangeException))]
        public void TestArrayListInsertException()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Insert(3, 20);
        }

