//Projects/ArrayList/Test/ArrayListContractTest(PexAPI).cs
﻿using ArrayList;
using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
       [Test, PexAPI]
       public void PUT_AddRemoveContract_PexAPI([PexAssumeUnderTest] ArrayList arrList, int x)
       {
           int OldCount = arrList.Count;

           arrList.Add(x);

           int NewCount = arrList.Count;

           Assert.IsTrue(NewCount == OldCount + 1);

           arrList.Remove(x);

           int FinalCount = arrList.Count;

           Assert.IsTrue(FinalCount == OldCount);
       }

        [Test, PexAPI]
       public void PUT_InsertContract_PexAPI([PexAssumeUnderTest] ArrayList arrList, int x, int index)
       {
           int OldCount = arrList.Count;

           arrList.Insert(index, x);

           int NewCount = arrList.Count;

           Assert.IsTrue(NewCount == OldCount + 1);

           arrList.Remove(x);

           int FinalCount = arrList.Count;

           Assert.IsTrue(FinalCount == OldCount);
       }
    }
}

