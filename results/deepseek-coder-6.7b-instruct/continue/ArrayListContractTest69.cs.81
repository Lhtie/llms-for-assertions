//src/Tests/ArrayList.Test/ArrayListTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [PexMethod]
        public void Test_Add([PexAssumeUnderTest] ArrayList list, int a)
        {
            int oldCount = list.Count;
            list.Add(a);
            Assert.IsTrue(list.Count == oldCount + 1);
            Assert.IsTrue(list.Contains(a));
        }

        [Test]
        [PexMethod]
        public void Test_Insert([PexAssumeUnderTest] ArrayList list, int a, int index)
        {
            int oldCount = list.Count;
            if (index < oldCount)
            {
                list.Insert(index, a);
                Assert.IsTrue(list.Count == oldCount + 1);
                Assert.IsTrue(list.Contains(a));
            }
            else
            {
                Assert.Throws(typeof(ArgumentOutOfRangeException), () => list.Insert(index, a));
            }
        }

        [Test]
        [PexMethod]
        public void Test_Remove([PexAssumeUnderTest] ArrayList list, int a)
        {
            if (list.Contains(a))
            {
                int oldCount = list.Count;
                list.Remove(a);
                Assert.IsTrue(list.Count == oldCount - 1);
                Assert.IsFalse(list.Contains(a));
            }
            else
            {
                Assert.Throws(typeof(ArgumentOutOfRangeException), () => list.Remove(a));
            }
        }
    }
}

