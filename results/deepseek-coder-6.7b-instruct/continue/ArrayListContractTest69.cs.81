public class dbconnection
{
    public SqlConnection sqlConnection = null;

    public dbconnection()
    {
        sqlConnection = new SqlConnection();
        sqlConnection.ConnectionString = "Data Source=(local);Initial Catalog=CMS;Integrated Security=True";
    }

    public void openConnection()
    {
        sqlConnection.Open();
    }

    public void closeConnection()
    {
        sqlConnection.Close();
    }
