//Binaries/M14/Examples/NUnitTests/src/ArrayList/ArrayList.Test/ArrayListTest.cs
﻿using System;
using System.Collections.Generic;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void BasicTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);

            Assert.AreEqual(3, arrayList.Count);
            Assert.AreEqual(1, arrayList[0]);
            Assert.AreEqual(2, arrayList[1]);
            Assert.AreEqual(3, arrayList[2]);
        }

        [Test]
        public void RemoveTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);

            arrayList.Remove(2);

            Assert.AreEqual(2, arrayList.Count);
            Assert.AreEqual(1, arrayList[0]);
            Assert.AreEqual(3, arrayList[1]);
        }

        [Test]
        public void InsertTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Insert(0, 1);
            arrayList.Insert(1, 2);
            arrayList.Insert(1, 3);

            Assert.AreEqual(3, arrayList.Count);
            Assert.AreEqual(1, arrayList[0]);
            Assert.AreEqual(3, arrayList[1]);
            Assert.AreEqual(2, arrayList[2]);
        }

        [Test]
        public void SetTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Add(1);
            arrayList.Add(2);

            arrayList[1] = 3;

            Assert.AreEqual(2, arrayList.Count);
            Assert.AreEqual(1, arrayList[0]);
            Assert.AreEqual(3, arrayList[1]);
        }

        [Test]
        public void ContainsTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);

            Assert.IsTrue(arrayList.Contains(2));
            Assert.IsFalse(arrayList.Contains(4));
        }

        [Test]
        public void IndexOfTests()
        {
            ArrayList arrayList = new ArrayList();

            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);

            Assert.AreEqual(1, arrayList.IndexOf(2));
            Assert.AreEqual(-1, arrayList.IndexOf(4));
        }
    }
}

