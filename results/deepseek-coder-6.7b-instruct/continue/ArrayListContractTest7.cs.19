﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Library
{
    public class RomanNumberGenerator : INumberGenerator
    {
        public string Generate(int arabNumber)
        {
            int[] values = { 1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1 };
            string[] romanDigits = { "M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I" };

            string result = "";

            for (int i = 0; i < values.Length && arabNumber >= 0; i++)
            {
                while (arabNumber >= values[i])
                {
                    arabNumber -= values[i];
                    result += romanDigits[i];
                }
            }
            return result;
        }
    }
}

