//Tests/ArrayList.Test/ArrayListTest.cs
﻿using System;
using ArrayList;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));
            Assert.AreEqual(0, arrList.LastIndexOf(1));
            Assert.AreEqual(1, arrList.LastIndexOf(2));
        }

        [Test]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(3));
        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);

            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(0, arrList.IndexOf(2));
            Assert.AreEqual(0, arrList.LastIndexOf(2));
            Assert.IsFalse(arrList.Contains(1));
        }
    }
}

