    public class SampleClass
    {
        private string _myProperty;

        public string MyProperty
        {
            get { return _myProperty; }
            set { _myProperty = value; }
        }

        public SampleClass(string input)
        {
            this.MyProperty = input;
        }

        public void Concatenate(string additionalText)
        {
            if (MyProperty == null)
                MyProperty = string.Empty;
            MyProperty += additionalText;
        }

        public int CalculateLength()
        {
            if (MyProperty == null)
                return 0;
            else
                return MyProperty.Length;
        }
    }
