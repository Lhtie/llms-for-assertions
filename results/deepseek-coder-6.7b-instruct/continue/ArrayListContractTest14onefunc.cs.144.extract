            Debug.Assert(New_arrListCount != arrList.LastIndexOf(x));
------------------------------------------------------------            PexObserve.Message("If count is 1, then index of item should not exist: Expected=False, Reality=" + ((Old_arrListCount == 1) ? New_arrListIndexOfX.ToString() + " is not same as " + Old_x.ToString() : "True"));
            
            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list count is greater than "0" after removing an item
            Debug.Assert(New_arrListCount >= 0);
--------------------            Debug.Assert(Old_arrListCount != New_arrListCount);
