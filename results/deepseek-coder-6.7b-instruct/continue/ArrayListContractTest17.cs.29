            PexObserve.ValueForViewing("$old_arrList_IndexOf_index", Old_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_index", New_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_index", Old_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_index", New_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ the last position of index in old array--------------------        }
    }

}

//Source/PexAPIWrapper/Test/ArrayList/Test.cs
﻿using System;
using ArrayList;
using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayList.Tests
{
    [TestFixture]
    public class ArrayListTest
    {
        ArrayList al;
      
        [SetUp]
        public void Initialize()
        {
            al = new ArrayList();
        }

        #region Add method Unit Tests

        [Test]
        public void Add_EmptyList_Test()
        {
            AssertEmptyList(al);
            Assert.AreEqual(0, al.Count);

            al.Add(1);

            Assert.AreEqual(1, al.Count);
            Assert.AreEqual(1, al[0]);
        }

        [Test]
        public void Add_ExistingList_Test()
        {
            al.Add(1);
            Assert.AreEqual(1, al.Count);

            al.Add(2);
            Assert.AreEqual(2, al.Count);
            Assert.AreEqual(2, al[1]);
        }

        [Test]
        public void Add_OverCapacity_Test()
        {
            for (int i = 0; i < ArrayList.INITIAL_CAPACITY + 10; i++)
                al.Add(i);

            Assert.AreEqual(ArrayList.INITIAL_CAPACITY + 10, al.Count);
        }

        #endregion

        #region Remove method Unit Tests

        [Test]
        public void Remove_ItemInList_Test()
        {
            int removedValue = 1;

            al.Add(removedValue);
            al.Add(2);
            Assert.AreEqual(2, al.Count);

            al.Remove(removedValue);
            Assert.AreEqual(1, al.Count);
            Assert.AreEqual(2, al[0]);
        }

        [Test]
        public void Remove_ItemNotInList_Test()
        {
            int valueToRemove = 1;

            al.Add(0);
            al.Add(2);
            Assert.AreEqual(2, al.Count);

            // The remove operation should return false.
            Assert.IsFalse(al.Remove(valueToRemove));
            Assert.AreEqual(2, al.Count);

            Assert.AreEqual(0, al[0]);
            Assert.AreEqual(2, al[1]);
        }

        [Test]
        public void Remove_AllItemsInList_Test()
        {
            al.Add(0);
            al.Add(1);
            Assert.AreEqual(2, al.Count);

            al.Remove(0);
            Assert.AreEqual(1, al.Count);

            al.Remove(1);
            AssertEmptyList(al);
        }

        #endregion

        private void AssertEmptyList(ArrayList al)
        {
            Assert.AreEqual(0, al.Count);
            Assert.AreEqual(0, al.Capacity);
        }
    }
}

