    public class PexGenericTests
    {
        [PexMethod]
        public void DictionaryTest1<TKey, TValue>(
            [PexGenericType("typeof(System.Collections.Generic.Dictionary<,>)")] Type genericType,
            TKey key, 
            TValue value)
        {
            Type dictionaryType = genericType.MakeGenericType(typeof(TKey), typeof(TValue));
            var dictionary = (IDictionary<TKey, TValue>)Activator.CreateInstance(dictionaryType);
            dictionary.Add(key, value);
            TValue outValue = dictionary[key];
            // Here `value' must be the same as `outValue'
            object[] args = new object[] { key, value };
            Assume.True(outValue.Equals(value));
        }
    }
