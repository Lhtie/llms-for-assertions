        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);



            //an assertion using "Debug.Assert\(.*?\);" that arrList contains x at an index greater or equal to a specific value
	    AssumePrecondition.IsTrue(New_arrListIndexOfX < New_arrListCount);
	    AssumePrecondition.IsTrue(New_arrListIndexOfX != -1);

	    AssumePrecondition.IsTrue(Old_arrListIndexOfX != New_arrListIndexOfX);
	    AssumePrecondition.IsTrue(New_arrListIndexOfX == index);
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            //int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListIndex = arrList.IndexOf(index);
            bool Old_arrListContainsIndex = arrList[index] != null;

            int x = arrList[Old_arrListIndex];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndex = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);


            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Index", Old_arrListIndex);
            PexObserve.ValueForViewing("$new_arrList_Index", New_arrListIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_index", Old_arrListContainsIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

	    AssumePrecondition.IsTrue(New_arrListIndex != Old_arrListIndex);
        }

