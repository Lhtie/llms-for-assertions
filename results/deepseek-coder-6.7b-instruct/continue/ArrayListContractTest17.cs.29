	    // Pex: Pex should consider this a precondition and should fail with an appropriate message.
            System.Diagnostics.Debug.Assert(Old_arrListLastIndexOfX <= arrList.IndexOf(x));


        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, int x)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count);

            arrList.Insert(index, x); 

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", arrList.Count);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$index", index);
            PexObserve.ValueForViewing("$old_arrList_x", x);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);


        }
    }
}

