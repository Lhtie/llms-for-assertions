﻿using System;
using System.Text;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListUnitTest
    {
        [TestMethod]
        public void AddTest_01()
        {
            var arrList = new ArrayList();
            int expectedRet = 0;
            int actualRet = arrList.Add(100);
            Assert.AreEqual(expectedRet, actualRet);
        }

        [TestMethod]
        public void RemoveTest_01()
        {
            var arrList = new ArrayList();
            arrList.Add(100);
            arrList.Remove(100);
            Assert.AreEqual(0, arrList.Count);
        }

        [TestMethod]
        public void InsertTest_01()
        {
            var arrList = new ArrayList();
            arrList.Insert(0, 150);
            Assert.AreEqual(150, arrList[0]);
        }

        [TestMethod]
        public void ClearTest_01()
        {
            var arrList = new ArrayList();
            arrList.Add(100);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }
    }

}

