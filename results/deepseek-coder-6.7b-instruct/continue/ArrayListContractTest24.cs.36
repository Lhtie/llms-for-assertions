//ArrayList-master/ArrayList/PexAPIWrapper/PexAPI.cs
﻿using System;
using System.Reflection;

namespace PexAPIWrapper
{


    public class PexAPI 
    {

        private static Type pexFrameworkType = null;
        private static FieldInfo pexObserveField = null;

        static PexAPI()
        {

            // load the PexFramework
            pexFrameworkType = typeof(Microsoft.Pex.Framework.PexInstance).Assembly.GetType("Microsoft.Pex.Framework.PexFramework", false, false);
            if (pexFrameworkType != null)
            {
                MethodInfo getPexObserveMethod = pexFrameworkType.GetMethod("GetPexObserve", BindingFlags.Static | BindingFlags.NonPublic);
                if(getPexObserveMethod != null)
                {
                    pexObserveField = getPexObserveMethod.ReturnType.GetField("observeStore", BindingFlags.Instance | BindingFlags.NonPublic);
                }
            }
        }


        public static IPexObserve GetPexObserve(object obj)
        {

            object pexObserve = pexObserveField.GetValue(null);

            if (pexObserve != null)
            {
                Type observeStoreType = pexObserve.GetType();
                MethodInfo getObservationMethod = observeStoreType.GetMethod("GetObservationValue", BindingFlags.NonPublic | BindingFlags.Instance);
                return (IPexObserve)getObservationMethod.Invoke(pexObserve, new object[] { obj });
            }
            else
            {
                return null;
            }
        }

    }


}

