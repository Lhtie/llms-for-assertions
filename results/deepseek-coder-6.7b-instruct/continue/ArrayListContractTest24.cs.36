//test/ArrayList/ArrayList.Test/ArrayListContractTest.cs
﻿using System;
using System.Collections.Generic;
using System.Text;

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        public virtual void AddContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Assert.IsTrue(New_arrListCount >= Old_arrListCount);
            Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
        }

        public virtual void RemoveContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Assert.IsTrue(New_arrListCount <= Old_arrListCount);
            Assert.IsTrue(New_arrListIndexOfX <= Old_arrListIndexOfX || New_arrListIndexOfX < 0);
        }

        public virtual void InsertContract(ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);
            Assert.IsTrue(New_arrListIndexOfX == index);
            Assert.IsTrue(New_arrListIndexOfX <= Old_arrListIndexOfX || New_arrListIndexOfX < 0);
        }

        [TestMethod]
        public void TestAdd()
        {
            PexRunner.AssemblySettings = new PexAssemblySettings(this.GetType());

            PexRunner.RunTest(this.AddContract, new object[] { new ArrayList() });
        }

        [TestMethod]
        public void TestRemove()
        {
            PexRunner.AssemblySettings = new PexAssemblySettings(this.GetType());

            PexRunner.RunTest(this.RemoveContract, new object[] { new ArrayList() });
        }

        [TestMethod]
        public void TestInsert()
        {
            PexRunner.AssemblySettings = new PexAssemblySettings(this.GetType());

            PexRunner.RunTest(this.InsertContract, new object[] { new ArrayList() });
        }
    }
