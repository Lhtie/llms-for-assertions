﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Tests
{
    [TestClass]
    public class ArrayListUnitTest
    {
        [TestMethod]
        public void AddTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            Assert.AreEqual(2, arrList.Count);
        }

        [TestMethod]
        public void RemoveTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Remove(10);
            Assert.AreEqual(1, arrList.Count);
        }

        [TestMethod]
        public void InsertTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(30);
            arrList.Insert(1, 20);
            Assert.AreEqual(20, arrList[1]);
            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        [ExpectedException(typeof(ArgumentOutOfRangeException))]
        public void Insert_InvalidIndex_TestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Insert(-1, 10);            
        }

        [TestMethod]
        public void IndexOfTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            Assert.AreEqual(0, arrList.IndexOf(10));
        }

        [TestMethod]
        public void LastIndexOfTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(10);
            Assert.AreEqual(2, arrList.LastIndexOf(10));
        }

        [TestMethod]
        public void ContainsTestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            Assert.IsTrue(arrList.Contains(10));
            Assert.IsFalse(arrList.Contains(30));
        }
    }
}﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ArrayList
{
    public class ArrayList
    {
        private int[] array;
        private int size;

        public ArrayList()
        {
            array = new int[16];
            size = 0;
        }

        public int Count
        {
            get
            {
                return size;
            }
        }

