}﻿using Microsoft.VisualStudio.TestTools.UnitTesting;
using System;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        [TestMethod]
        [TestCategory("ArrayListContractTest")]
        public void Test_AddContract()
        {
            // Test setup. The test object 'arrlist' and 'item' needs to be created.
            ArrayList arrList = new ArrayList();
            int item = 10;

            ArrayListContractTest_AddContract(arrList, item);
        }

        // Helper 
        public void ArrayListContractTest_AddContract([PexAssumeUnderTest]ArrayList arrList, int item)
        {
            int oldCount = arrList.Count;
            arrList.Add(item);
            int newCount = arrList.Count;

            // Post conditions - The new size must be increased. 
            Assert.IsTrue(oldCount < newCount);
            Assert.IsTrue(arrList.Contains(item));
        }

        [TestMethod]
        [TestCategory("ArrayListContractTest")]
        public void Test_RemoveContract()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(220);
            ArrayListContractTest_RemoveContract(arrList, 220);
        }

        public void ArrayListContractTest_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int item)
        {
            AssumePrecondition.IsTrue(arrList.Contains(item));

            int oldCount = arrList.Count;
            arrList.Remove(item);
            int newCount = arrList.Count;

            //After calling Remove(), the new size must be reduced. 
            Assert.IsTrue(oldCount > newCount);
            Assert.IsFalse(arrList.Contains(item));
        }
    }
}//AssessmentOne/Program.cs
﻿using System;

namespace AssessmentOne
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Hello World!");
        }
    }

    public static class Calculator
    {
        public static int Add(int num1, int num2)
        {
            return num1 + num2;
        }

        public static int Subtract(int num1, int num2)
        {
            return num1 - num2;
        }

        public static int Multiply(int num1, int num2)
        {
            return num1 * num2;
        }

        public static int Divide(int num1, int num2)
        {
            if (num2 == 0)
            {
                throw new DivideByZeroException();
            }
            return num1 / num2;
        }
    }
}

//Assessment.Tests/CalculatorTests.cs
using AssessmentOne;
using NUnit.Framework;

public class CalculatorTests
{
