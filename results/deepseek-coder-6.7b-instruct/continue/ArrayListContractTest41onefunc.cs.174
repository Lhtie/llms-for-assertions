    {
        [Test]
        public void SET_SetContract([PexAssumeNotNull]ArrayList arrayList, [PexAssumeNotNull]object item, int index)
        {
            
            object Old_arrListItem = arrayList[index];
            arrayList[index] = item;
            object New_arrListItem = arrayList[index];

            Assert.IsTrue(arrayList.Count == arrayList.Count);
            Assert.IsTrue(arrayList.Contains(item));
            Assert.IsTrue(arrayList.IndexOf(item) == index);
            Assert.IsTrue(arrayList.LastIndexOf(item) >= index);
