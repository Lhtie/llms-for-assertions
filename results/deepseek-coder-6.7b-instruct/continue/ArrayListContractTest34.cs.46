}﻿using System.Collections.Generic;

namespace SortedSequences
{
    public interface ISortedSequence
    {
        int Add(int number);
        int Remove(int number);
        int Count { get; }
        int this[int index] { get; }
    }

    public interface ISequenceFactory
    {
        ISortedSequence CreateSortedSequence();
    }
}//SortedSequences/SortedListSequence.cs
﻿using System.Collections.Generic;

namespace SortedSequences
{
    public class SortedListSequence : ISortedSequence
    {
        private SortedList<int, int> _sequenceList = new SortedList<int, int>();

        public int Add(int number)
        {
            if (_sequenceList.ContainsKey(number)) return _sequenceList[number];

            _sequenceList.Add(number, number);
            return number;
        }

        public int Remove(int number)
        {
            if (!_sequenceList.ContainsKey(number)) return -1;

            _sequenceList.Remove(number);
            return number;
        }

        public int Count
        {
            get { return _sequenceList.Count; }
        }

        public int this[int index]
        {
            get { return _sequenceList.Keys[index]; }
        }

        public override string ToString()
        {
            return string.Join(", ", _sequenceList.Keys);
        }
    }

    public class SortedListFactory : ISequenceFactory
    {
        public ISortedSequence CreateSortedSequence()
        {
            return new SortedListSequence();
        }
    }
}

//PerformanceTests/Program.cs
﻿using System;
using System.Diagnostics;
using System.Collections.Generic;
using SortedSequences;
using System.Linq;

namespace PerformanceTests
{
    class Program
    {
        static void Main(string[] args)
        {
            int itemsCount = 1000;

            TestSequence(new HashSetFactory(), itemsCount);
            TestSequence(new SortedSetFactory(), itemsCount);
            TestSequence(new SortedListFactory(), itemsCount);
            TestSequence(new TreesetFactory(), itemsCount);
        }

        private static void TestSequence(ISequenceFactory factory, int itemsCount)
        {
            var sequence = factory.CreateSortedSequence();

            var rand = new Random();
            var items = Enumerable.Range(0, itemsCount).Select(i => rand.Next()).ToArray();

            var stopwatch = new Stopwatch();

            stopwatch.Start();
            for (int i = 0; i < itemsCount; ++i)
            {
                sequence.Add(items[i]);
            }
            stopwatch.Stop();

            Console.WriteLine($"{factory.GetType().Name}: add {itemsCount} items into sequence - {stopwatch.ElapsedMilliseconds} ms");

            stopwatch.Restart();
            for (int i = 0; i < itemsCount; ++i)
            {
                sequence.Remove(items[i]);
            }
            stopwatch.Stop();

            Console.WriteLine($"{factory.GetType().Name}: remove {itemsCount} items from sequence - {stopwatch.ElapsedMilliseconds} ms");
        }
    }
