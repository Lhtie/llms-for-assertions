//Asserts/AssertionLibrary/Test/AssertionLibrary.Test/AssertTests.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using AssertionLibrary;

// These tests use Microsoft.VisualStudio.TestTools.UnitTesting namespace
namespace AssertionLibrary.Test
{
    [TestClass]
    public class AssertTests
    {
        [TestMethod]
        public void TestIntGreaterThanZero()
        {
            // Arrange
            int zero = 0;
            int seven = 7;

            // Act & Assert
            // Should throw InvalidOperationException because number is not greater than zero
            Assert.AreEqual(new InvalidOperationException(), CustomAssert.IsGreaterThan(zero, "number"));
            // Should not throw exception because number is greater than zero
            CustomAssert.IsGreaterThan(seven, "number");
        }

        [TestMethod]
        public void TestStringNotEmpty()
        {
            // Arrange
            string empty = "";
            string hello = "Hello";

            // Act & Assert
            // Should throw InvalidOperationException because string is empty
            Assert.AreEqual(new InvalidOperationException(), CustomAssert.IsNotNullOrEmpty(empty, "string"));
            // Should not throw exception because string is not empty
            CustomAssert.IsNotNullOrEmpty(hello, "string");
        }

        [TestMethod]
        public void TestBooleanTrue()
        {
            // Arrange
            bool falseValue = false;
            bool trueValue = true;

            // Act & Assert
            // Should throw InvalidOperationException because boolean is false
            Assert.AreEqual(new InvalidOperationException(), CustomAssert.IsTrue(falseValue, "boolean"));
            // Should not throw exception because boolean is true
            CustomAssert.IsTrue(trueValue, "boolean");
        }
    }
}

//NUnitExamples/NUnitExamples/Calc/CalcController.cs
﻿using System;

namespace NUnitExamples
{
	public class CalcController
	{
		public CalcModel Model { get; set; }

		public CalcController()
		{
			Model = new CalcModel();
		}

		public double Add(double a, double b)
		{
			return Model.Add(a, b);
		}

		public double Subtract(double a, double b)
		{
			return Model.Subtract(a, b);
		}

		public double Multiply(double a, double b)
		{
			return Model.Multiply(a, b);
		}

		public double Divide(double a, double b)
		{
			if (b == 0)
				throw new DivideByZeroException();
			return Model.Divide(a, b);
		}
	}
}

