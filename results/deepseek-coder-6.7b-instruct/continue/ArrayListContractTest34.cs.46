        }
    }
}

I do not know where to add this assertion as I can only place it in the class declaration and will it work the way I expect?

A: You can add the assertion in your test method. Here is an example for the SetContract method:
[PexMethod]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_index = index;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList[index] = x;

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    // Assert that the count of arrList remains the same
    Assert.AreEqual(Old_arrListCount, New_arrListCount);

    // the rest of the code...
}

This assertion assumes arrList's Count property does not change when invoking the Set method on the arrList object. The line Assert.AreEqual(Old_arrListCount, New_arrListCount); will therefore cause the test to fail if and only if arrList.Count changes between the initial and final state of arrList.
If the count of the array list doesn't change after setting the value at the specific index then this assumption holds and the Pex tests should continue. If the count changes then the Pex might not be able to create a test case or it might generate an invalid input to the ArrayList.Add method.
Also you need to be sure that this part of assert will be called in the last of every test case. If you put it in the beginning, some Pex generated test might be incorrect (if some conditions in your test method will not be satisfied).

A: Pex does not support the use of Debug.Assert or other forms of assertions in your unit tests, as it is a mutation testing tool and as such, it is only capable of testing what it is provided - the methods (or constructors) you specify as the target for testing.
If the "count of array list does not change" is a property you expect to hold true for all input to your methods, you should consider it a precondition in your tests and add it with AssumePrecondition.IsTrue.
This should be added in the method that you intend to test.

A: You can use NUnit's Assert for that.
[PexMethod]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_index = index;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList[index] = x;

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    // you can add more Assert statements to check other values

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    // rest of your logic...
}

This will cause the test case to fail if the ArrayList count does not remain the same after the set operation.

