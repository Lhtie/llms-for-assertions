﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using ArrayList;
using NUnit.Framework;

namespace ArrayListTest
{
    [TestFixture]
    public partial class TestClass1
    {
        [PexMethod]
        public void TestMethod([PexAssumeUnderTest]ArrayList arr)
        {
            AssumePrecondition.IsTrue(arr.Count >= 0 && arr.Count <= 50, "count is in the permissible range");

            for (int i = 0; i < arr.Count; i++)
            {
                AssumePrecondition.IsTrue((int)arr.get(i) >= 0 && (int)arr.get(i) <= 100, "element of array is in the permissible range");
            }

            arr.Order();

            int temp = -1;
            for(int i = 0; i < arr.Count; i++)
            {
                AssumePostcondition.IsTrue((int)arr.get(i) >= temp, "array is sorted");

                temp = (int)arr.get(i);
            }
        }
    }
}

