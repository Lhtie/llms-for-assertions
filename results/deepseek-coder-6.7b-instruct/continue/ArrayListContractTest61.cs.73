//Bug-Tracker/Bug-Tracker-TestProject/ArrayList.Test/Test.cs
using System;
using System.Reflection;

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using ArrayList;

namespace ArrayList.Test
{
    class Test
    {
        [PexMethod]
        public void Test1([PexAssumeUnderTest] ArrayList arrList)
        {
            int OldListSize = arrList.Count;
            int NewListSize;
            if ((PexSettings.Default.RandomSeed) % 2 == 0)
            {

                arrList.Add(0);
                NewListSize = arrList.Count;
                AssumePrecondition.IsTrue(NewListSize == OldListSize - 1);
            }
            else
            {
                AssumePrecondition.IsTrue(OldListSize >= 0);
            }
        }
       [PexMethod]
        public void Test2([PexAssumeUnderTest] ArrayList arrList)
        {
            int OldListSize = arrList.Count;
            int i = (PexSettings.Default.RandomSeed) % arrList.Count;
         
            arrList.RemoveAt(i);

            int NewListSize = arrList.Count;
            AssumePrecondition.IsTrue(OldListSize == NewListSize + 1);
        }

         [PexMethod]
        public void Test3([PexAssumeUnderTest] ArrayList arrList)
        {
           
            int OldListSize = arrList.Count;
            AssumePrecondition.IsTrue(OldListSize >= 0);
            
            arrList[0] = -1;

            int NewListSize = arrList.Count;
            AssumePrecondition.IsTrue(NewListSize == OldListSize);
        }

         [PexMethod]
        public void Test4([PexAssumeUnderTest] ArrayList arrList)
        {
           
            int OldListSize = arrList.Count;
            int i = (PexSettings.Default.RandomSeed) % OldListSize;
            int OldValue = (int) arrList[i];
         
            arrList.Remove(OldValue);

            int NewListSize = arrList.Count;
            AssumePrecondition.IsTrue(NewListSize == OldListSize - 1);
        }

         [PexMethod]
        public void Test5([PexAssumeUnderTest] ArrayList arrList)
        {
           
            int OldIndex = (PexSettings.Default.RandomSeed) % arrList.Count;
            arrList.Insert(OldIndex,0);
            
            int NewIndex = arrList.IndexOf(0);
           
            AssumePrecondition.IsTrue(OldIndex <= NewIndex && NewIndex <= OldIndex+1);
        }
    }
}

//Bug-Tracker/Bug-Tracker-TestProject/PexAPIWrapper/ArryListPexMethodsWrapper.cs
using System;
using Microsoft.Pex.Framework;
using ArrayList;

namespace PexAPIWrapper
{
    public static class ArryListPexMethodsWrapper
    {
        [PexMethod]
        public static void AddWrapper([PexAssumeUnderTest] ArrayList arrList, object element)
        {
            arrList.Add(element);
        }

        [PexMethod]
        public static object GetWrapper([PexAssumeUnderTest] ArrayList arrList, int index)
        {
            return arrList[index];
        }

        [PexMethod]
        public static void InsertWrapper([PexAssumeUnderTest] ArrayList arrList, int index, object element)
        {
            arrList.Insert(index, element);
        }
    }
}

