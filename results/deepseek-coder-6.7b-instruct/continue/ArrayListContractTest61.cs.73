using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using PexAPIWrapper;

namespace PexAPIWrapper.Test
{
    [TestFixture, PexClass]
    public partial class PexAPIWrapperContractTest
    {
        [PexMethod]
        public void PUT_SubtractContract([PexAssumeUnderTest]PexAPIWrapper pexapi)
        {
            AssumePrecondition.IsTrue(pexapi.X > 0 && pexapi.Y > 0);

            int Old_X = pexapi.X;
            int Old_Y = pexapi.Y;
            int Old_diff = pexapi.X - pexapi.Y;

            int New_Ret = pexapi.Subtract();

            int New_Diff = pexapi.X - pexapi.Y;

            PexObserve.ValueForViewing("$old_x", Old_X);
            PexObserve.ValueForViewing("$old_y", Old_Y);
            PexObserve.ValueForViewing("$old_diff", Old_diff);
            PexObserve.ValueForViewing("$new_ret", New_Ret);
            PexObserve.ValueForViewing("$new_diff", New_Diff);

            // an assertion using "Assert.AreEqual(.*?);" that compares the new difference with the previous difference. @@@ The old difference should be >= -1.
            AssumePrecondition.IsTrue(Old_diff >= -1);
            Assert.GreaterOrEqual(New_Diff, Old_Diff);

            // an assertion using "Assert.AreEqual(.*?);" that compares the new return value with the old difference. @@@ The return value should be equal to the old difference.
            Assert.AreEqual(New_Ret, Old_Diff);
            
        }
    }
}﻿using System;

namespace PexAPIWrapper
{
    public class PexAPIWrapper
    {
        public int X { get; set; }
        public int Y { get; set; }

        public PexAPIWrapper(int x, int y)
        {
            this.X = x;
            this.Y = y;
        }

        public int Subtract()
        {
            return this.X -= this.Y;
        }
    }
