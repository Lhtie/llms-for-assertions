﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using ArrayList;
using NUnit.Framework;

namespace ArrayListTest
{
    [TestFixture, PexClass]
    public partial class ArrayListOrderTest
    {
        [PexMethod]
        public void TestMethod( [PexAssumeUnderTest]ArrayList arr)
        {
            AssumePrecondition.IsTrue(arr.Count >=0 && arr.Count <= 100);

            arr.OrderCustom();

            int x=0;
            for(int i = 0; i <arr.Count-1; i++)
            {
                AssumePrecondition.IsTrue((int)arr.get(i) <= (int)arr.get(i + 1));

                int y = (int)arr.get(i);
                int z = (int)arr.get(i + 1);

                PexObserve.ValueForViewing("x", x);
                PexObserve.ValueForViewing("y", y);
                PexObserve.ValueForViewing("z", z);
            }
	    
        }
    }
}

