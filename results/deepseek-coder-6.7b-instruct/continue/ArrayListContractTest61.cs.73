﻿using System;
using System.Collections.Generic;
using NUnit.Framework;
using PexAPIWrapper.Test;

namespace PexAPIWrapper
{
    public class PexAPIWrapper<TKey, TValue> : Dictionary<TKey,TValue>
    {
        public void Call()
        {
            PexAPIWrapperContractTest pexAPIWrapperContract = new PexAPIWrapperContractTest();

            IDictionary<TKey,TValue> pexDictionaryImpl = this;
            IDictionary<TKey,TValue> dictionary = new Dictionary<TKey,TValue>();

            pexAPIWrapperContract.PUT_CallContract(pexDictionaryImpl, dictionary);
        }
    }
}

