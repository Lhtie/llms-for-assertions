﻿using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.Linq;
using System.Threading.Tasks;

namespace MVC_Core_PizzaApi.Models
{
    public class PizzaOrder
    {
        //properties

        public int Id { get; set; }

        [Required]
        [DisplayName("Pizza Name")]
        public string PizzaName { get; set; }

        [Required]
        [DisplayName("Pizza Size")]
        public string PizzaSize { get; set; }

        [Required]
        [DisplayName("Number of Pizzas")]
        [Range(1, 5, ErrorMessage = "You can order between 1 and 5 pizzas only")]
        public int NumberOfPizzas { get; set; }

        [Required]
        public string Address { get; set; }


        //Navigation property
        public Pizza Pizza { get; set; }
    }
}

