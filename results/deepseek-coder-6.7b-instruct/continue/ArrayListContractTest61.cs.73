﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public partial class TestClass2
    {
        [PexMethod]
        public void PexMethodAddRemove([PexAssumeUnderTest]ArrayList arr)
        {
            AssumePrecondition.IsTrue(arr.Count >= 0 && arr.Count <= 100, "Initial count of array is in the permissible range");

            int initCount = arr.Count;

            int element = 10;
            arr.Add(element);

            AssumePostcondition.IsTrue(arr.Count == initCount + 1, "After adding one element, the count of array should increase by one");

            int indexRemove = arr.Count - 1;
            if (indexRemove >= 0)
            {
                arr.RemoveAt(indexRemove);

                AssumePostcondition.IsTrue(arr.Count == initCount, "After one remove operation, the count of array should decrease by one");
            }
        }
    }
}

