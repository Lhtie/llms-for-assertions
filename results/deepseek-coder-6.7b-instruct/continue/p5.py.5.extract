    # this is equivalent to asserting "height is non-negative"
    # as well as asserting "width is positive" and "length is positive"
    # i.e., that all dimensions are positive
    assert(r.exp>0 and r.lin>0 and r.mat>0), "all dimensions must be positive"
    return r

