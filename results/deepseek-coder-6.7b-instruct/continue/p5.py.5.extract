    assert r.lin > 0,      "Error: Not a positive height"
----------------------------------------    assert r.lin > 0, "Rectangle has non-positive height"
--------------------    assert r.lin > 0
--------------------    assert r.lin > 0, "This rectangle has non-positive height."
--------------------    assert r.mat > 0, 'The height of the rectangle is not a positive number'
--------------------    assert r.lin > 0, "height is not greater than zero"
--------------------    assert r.lin > 0,"The height of the rectangle is not positive"
----------------------------------------    assert(r.mat > 0)
    return r

n, m = 10, 5
print(func(n, m).exp, func(n, m).lin)

# prints: 10 5
