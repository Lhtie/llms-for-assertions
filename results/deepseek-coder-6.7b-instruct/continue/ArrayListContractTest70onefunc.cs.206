namespace System.Collections { 

public partial class ArrayList {

    private void EnsureCapacity(int min) {
        if (min > array.Length) {
            int newCapacity = array.Length * 2;
            if (newCapacity < min)
                newCapacity = min;
            newCapacity++;
            LogResize(newCapacity);
            array = (T[]) Array.Copy(array, newCapacity);
        }
    }


    private void LogResize(int newCapacity) {
        System.Diagnostics.Debug.WriteLine(GetType().Name + ": Resized to " + newCapacity.ToString());
    }
}

