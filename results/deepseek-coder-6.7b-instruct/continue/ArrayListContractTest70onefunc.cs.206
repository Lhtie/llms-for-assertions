	    Debug.Assert(!(New_Ret < 0 && Old_arrListLastIndexOfX == -1) //@ Assertion Message @@@
			|| ("Method indexOf should return the last index of x in old array if x is in array and -1 if it's not."));

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ If x is removed, and ArrayList count reduces by 1, old_arrListCount - New_arrListCount == 1
	    Debug.Assert(!(Old_arrListContainsX && New_arrListCount == Old_arrListCount - 1) //@ Assertion Message @@@
			|| ("When an x is removed by remove, ArrayList count should reduce by 1."));

            PexAssume.IsFalse(/*your condition here*/);
        }
    }
}


A: If you want to test if your remove function works correctly; let's assume your ArrayList class is named 'MyArrayList'. Your test function would look like this:
public void PUT_RemoveContract([PexAssumeUnderTest] MyArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(arrList.Contains(x)); // x should be in the list

    int Old_Count = arrList.Count;

    arrList.Remove(x); // Remove x from the list

    int New_Count = arrList.Count;

    PexObserve.ValueForViewing("$old_list_Count", Old_Count);
    PexObserve.ValueForViewing("$new_list_Count", New_Count);

    AssumePrecondition.IsFalse(arrList.Contains(x)); // x should no longer be in the list

    // Asserts
    Debug.Assert(New_Count == Old_Count - 1); // Check if count was reduced by 1
}

This contract checks that when you remove an element from the list, the count of the list decreases by one. If Count doesn’t decrease by one, it means that your function isn’t correctly removing the element.
Remember to change the class names, as the provided names are for clarity and understanding the concept.
Q: Add class on button after selection I have a button on my website and I wish to add a class of "selected" after it is clicked. At present I have this HTML:
<div class="tab">
    <a href="#" class="tab-link" data-val="1">Tab 1</a>
</div>

And this JS:
var $items = $('.tab-link');
$items.click(function() {
  $(this).addClass('selected');
});

The class of "selected" works fine when clicking on the tab for the first time. But if clicked again, the class will not be removed. How to make it work again when clicked again?

A: The issue here is that you're using the .click() event, which only triggers once, meaning that you can't select the same thing twice.
A jQuery method to add and remove classes from elements is .toggleClass(). This can be used to add the 'selected' class if it isn't already there and remove it if it is. So your code would look something like:


var $items = $('.tab-link');
$items.click(function() {
  $(this).toggleClass('selected');
});
.selected {
  background-color: red;
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<div class="tab">
  <a href="#" class="tab-link" data-val="1">Tab 1</a>
</div>



A: Use the .toggleClass() function built into jQuery:


$(".tab-link").click(function() {
  $(this).toggleClass("selected");
});
.selected {
  color: red;
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<div class="tab">
  <a href="#" class="tab-link" data-val="1">Tab 1</a>
</div>


