//ArrayList_Test/Test_GET_Item.cs
﻿using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Utilities;
using System.Collections;
using System.Collections.Generic;
using System;
using NUnit.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void GET_LISTItemContract([PexAssumeUnderTest]ArrayList arrayList)
        {
            AssumePrecondition.IsTrue(arrayList.Count > 0);

            int index = 0;
            if (arrayList.Count > 1)
                index = arrayList.Count / 2;

            // the method under test
            object item = arrayList[index];

            // we want the item to be a reference from the original list
            PexAssume.IsTrue(arrayList.Contains(item));

            // verify our indexer works
            object verifyItem = arrayList[index];
            Debug.Assert(item == verifyItem);
        }
    }
}

//ArrayList_Test/Test_REMOVE_RemoveAt.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Utilities;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void REMOVE_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            // Select a random index
            int index = PexRandom.Next(0, arrList.Count);

            // Obtain the size of the list prior to removal
            int PreRemoveCount = arrList.Count;

            // Obtain the item to be removed
            object item = arrList[index];

            // Call the method under test
            arrList.RemoveAt(index);

            // Validate the post conditions

            // Test the list count has reduced by one
            bool PostRemoveCount = arrList.Count == PreRemoveCount - 1;

            // The list no longer contains the item
            bool PostRemoveContainsItem = !arrList.Contains(item);

            // The items previous and next to 'index' should match the 'index'
            bool PreRemoveAndPostRemoveEquals =
              (index == 0 || arrList[index - 1] == arrList[index]) &&
              (index == arrList.Count - 1 || arrList[index] == arrList[index + 1]);

            // Collect the data for observing
            PexObserve.ValueForViewing("PRE_RemoveCount", PreRemoveCount);
            PexObserve.ValueForViewing("POST_RemoveCount", arrList.Count);
            PexObserve.ValueForViewing("Item", item);

            // Assert all conditions
            System.Diagnostics.Debug.Assert(PostRemoveCount);
            System.Diagnostics.Debug.Assert(PostRemoveContainsItem);
            System.Diagnostics.Debug.Assert(PreRemoveAndPostRemoveEquals);
        }
    }
}

