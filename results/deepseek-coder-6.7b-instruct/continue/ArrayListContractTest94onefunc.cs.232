        Task<--------------------            // and the last occurrence of x is at index greater than or equal to $new_ret; otherwise, $new_ret is -1 

            if (Old_arrListContainsX) { Assert.IsTrue(New_Ret >= Old_arrListIndexOfX || Old_arrListIndexOfX == 0); }
            else { Assert.IsTrue(New_Ret == -1);}
