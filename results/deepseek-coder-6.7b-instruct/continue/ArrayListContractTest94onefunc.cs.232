//code/csharp/tests/ArrayList.Test/MiscObjectives/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Signed;
using System.Collections;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", Severity = ExceptionSeverity.High)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", Severity = ExceptionSeverity.High)]
    [PexGenericType(typeof(IList), typeof(ArrayList))]
    [PexMethodUnderTest(nameof(ArrayList.IndexOf))]
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Add))]
        public void AddContract([PexAssumeUnderTest]ArrayList arrList, object value)
        {
            AssumePrecondition.IsTrue(arrList.Count <= IntMaxValue.Value);
            AssumePrecondition.IsNotNull(value);

            int oldCount = arrList.Count;

            arrList.Add(value);

            Debug.Assert(arrList.Count == oldCount + 1);
            Debug.Assert(arrList.Contains(value));

            PexObserve.IndexedValue(arrList, arrList.Count - 1, value);
        }

        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Remove))]
        public void RemoveContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            object removed = arrList[0];
            int oldCount = arrList.Count;

            arrList.Remove(removed);

            Debug.Assert(arrList.Count == oldCount - 1);
            Debug.Assert(!arrList.Contains(removed));
        }

        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.RemoveAt))]
        public void RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid(IntMaxValue.Value)] int index)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            object removed = arrList[index];
            int oldCount = arrList.Count;

            arrList.RemoveAt(index);

            Debug.Assert(arrList.Count == oldCount - 1);
            Debug.Assert(!arrList.Contains(removed));
        }

        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Contains))]
        public void ContainsContract([PexAssumeUnderTest]ArrayList arrList, object value)
        {
            AssumePrecondition.IsNotNull(value);

            bool oldContains = arrList.Contains(value);

            arrList.Add(value);

            bool newContains = arrList.Contains(value);

            Debug.Assert(newContains && oldContains || !newContains && !oldContains);
        } 
    }
}

