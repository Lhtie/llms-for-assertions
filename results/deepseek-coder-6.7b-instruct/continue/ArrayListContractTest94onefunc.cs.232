        [PexExploration(MaxTestIterations = 1500, MedianTestDuration = 50)]
        [PexExpectedException(typeof(IOException))]
        [PexExpectedException(typeof(ArgumentException))]
        public void PUT_LastIndexOfTest([PexAssumeValid]ArrayList x, [PexAssumeNotNull]int[] a)
        {

            x.AddRange(a);
            int ret = x.LastIndexOf(100); // LastIndexOf should return a negative number 
            PexObserve.ValueForViewing("$Ret", ret);
            Assert.AreEqual(-1, ret);
        }

