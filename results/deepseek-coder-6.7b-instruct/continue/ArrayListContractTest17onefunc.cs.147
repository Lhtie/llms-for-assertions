		{
			switch(Name)
			{
				case "Length":
					return this.Length;
				case "Width":
					return this.Width;
				case "SeatHeight":
					return this.SeatHeight;
				case "Coaches":
					return this.Coaches;
				default:
					return null;
			}
		}
