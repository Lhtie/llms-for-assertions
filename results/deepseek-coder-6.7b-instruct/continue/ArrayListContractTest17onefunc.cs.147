A: You should only cast x to object if it's a value type, for example int, not string etc. I would like to provide a more complete understanding about it.
ArrayList.Remove() method takes an object, not an int, when you have an ArrayList with elements of type int. So you should cast x to object when you call the Remove(x) method but not when you call IndexOf() or Contains() methods, they do not require casting, because they are designed--------------------	    Debug.Assert(Old_arrListLastIndexOfX >= 0 && Old_arrListLastIndexOfX == New_arrListIndexOfX);

	    //an assertion using "Debug.Assert\(.*?\);" that x is no longer contained in the array
	    Debug.Assert(Old_arrListContainsX == true && New_arrListContainsX == false);
        }
    }
}﻿using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class DoorScript : MonoBehaviour
{
    public GameObject[] ObjectsToOpenWith;
    public GameObject LockedObject;

    // Use this for initialization
    void Start()
    {

    }

    // Update is called once per frame
    void Update()
    {
        if (ObjectsNeededCheck())
        {
            OpenDoor();
        }
        else
        {
            CloseDoor();
        }
    }

    bool ObjectsNeededCheck()
    {
        if (LockedObject)
        {
            return false;
        }

        if (ObjectsToOpenWith.Length > 0)
        {
            foreach (GameObject obj in ObjectsToOpenWith)
            {
                if (obj && obj.activeInHierarchy)
                {
                    return false;
                }
            }
        }

        return true;
    }

    void OpenDoor()
    {
        GetComponent<Animation>().Play("Open");
    }

    void CloseDoor()
    {
        GetComponent<Animation>().Play("Close");
    }
}﻿using System;
