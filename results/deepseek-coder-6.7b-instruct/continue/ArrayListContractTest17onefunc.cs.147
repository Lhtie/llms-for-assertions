	    Debug.Assert(LastPosOfOldX > Old_arrListCount);
        }
    }
}

//Code Contracts Tests/ArrayList.Test/ArrayListContractTest1.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.PexObservers;
using Microsoft.Pex.Framework.Helpers;
using System.Collections;
using ArrayListDemo;
using System.Diagnostics;
using System;

namespace ArrayList.Test
{
	public class ArrayListContractTest1
	{
		public string POST_Add(ArrayList arrayList)
		{
			ArrayList arrayListCopy = (ArrayList)arrayList.Clone();
			int Old_ArrayList_Count = arrayList.Count;

			ArrayList arrayListToAdd = new ArrayList(){
				12, 'a', "Hello", 12.5, false, null, new NotSupportedException(), new NotImplementedException(), 12.5f
			};
			
			arrayListToAdd.Add("Foo");
			arrayListToAdd.Add("Bar");
		
			arrayList.AddRange(arrayListToAdd);

			int New_ArrayList_Count = arrayList.Count;

			string result = GetArrayListContent(arrayListCopy, arrayList) + "\nOld Count: " + Old_ArrayList_Count + "\nNew Count: " + New_ArrayList_Count;

			return result;
		}

		private string GetArrayListContent(ArrayList arrayList1, ArrayList arrayList2)
		{
			string result = "";
			foreach(object a in arrayList1){
				result += a == null ? "null, " : a.GetType().ToString() + ": " + a.ToString() + ", ";
			}

			result += "\n\n";

			foreach(object b in arrayList2){
				result += b == null ? "null, " : b.GetType().ToString() + ": " + b.ToString() + ", ";
			}

			return result;
		}
	}
}

