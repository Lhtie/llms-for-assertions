     [PexMethod]
 [PexArgument(typeof(ArrayList), new object[] { new object[] { 1, 2, 3, 5 } })]
 [PexExpectedException(typeof(ArgumentException))]
 public void PUT_Remove_ArgumentExceptionContract([PexAssumeUnderTest] ArrayList arrList, int x)
 {
     AssumePrecondition.IsFalse(arrList.Contains(x));
     try
     {
         arrList.Remove(x);
     }
     catch (ArgumentException)
     {
         // success
	 return;
     }
     catch (Exception ex)
     {
         // fail if any other exception type is thrown
         throw ex;
     }

    PexObserve.ExceptionForViewing("$Exception", ex);
    Debug.Assert(ex is ArgumentException);
 }

    }

}

the code is generating input for PUT_RemoveContract and PUT_Remove_ArgumentExceptionContract method, but it doesn't seem to catch the exception properly.
I get this error: "ex is not declared in the scope". Can some one help with that, please?

A: The issue here is that within the context of the try-catch block, the variable 'ex' is only in scope within that block. You can't 'see' it outside of that block. To fix this problem, you should declare 'ex' outside the try-catch block, and it should be of type 'Exception', as the catch block always has to catch an Exception. Your corrected code would look like this:
[PexMethod]
[PexArgument(typeof(ArrayList), new object[] { new object[] { 1, 2, 3, 5 } })]
[PexExpectedException(typeof(ArgumentException))]
public void PUT_Remove_ArgumentExceptionContract([PexAssumeUnderTest] ArrayList arrList, int x)
{
    AssumePrecondition.IsFalse(arrList.Contains(x));
    Exception ex = null;
    try
    {
        arrList.Remove(x);
    }
    catch (Exception e)
    {
        ex = e;
    }

    PexObserve.ExceptionForViewing("$Exception", ex);
    Debug.Assert(ex is ArgumentException);
}

This declaration 'Exception ex = null;' of 'ex' outside of the try-catch block should resolve the scope error that you are encountering.

A: It looks to me like you are trying to use local variables in a way that they are not available to your assertion.
Look at the part where Pex is trying to display ex:
PexObserve.ExceptionForViewing("$Exception", ex);

You've declared ex inside your try { } block, so its out of scope in your test output and assertion. If you want to use ex in your test, you need to assign it in your catch { } block.
Alternatively you could use PexAssume to catch exceptions. Note that for that, you'd--------------------	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in new array is geq @@@ index of x in old array minus 1 
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains x on old array is false 
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains x on new array is @@@ contains x on old array minus one 
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of new arrlist is minus the count of old arrList
        }

        [PexMethod]
        [PexExpectedException(typeof(ArgumentException))]
        public void PUT_RemoveContract_Exception([PexAssumeUnderTest] ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            // if the first element of the list is deleted, a ArgumentException should be thrown
            arrList.RemoveAt(0);
        }
    }
}
}

