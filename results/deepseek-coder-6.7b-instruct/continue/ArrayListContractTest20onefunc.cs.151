﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Hosting;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        PexMethod<ArrayList> pexMethod;

        [SetUp]
        public void Init()
        {
            pexMethod = PexRunner.PexRun(typeof(ArrayList), "Microsoft.Pex.Framework.Samples");
        }

        [Test]
        public void RunTests()
        {
            // Execute test using PexRunner
            // Each method is converted to a pex test by the PexRunner
            foreach (var method in pexMethod)
            {
                Console.WriteLine("Running: " + method.Name);
                try
                {
                    method.Run();
                }
                catch (PexAssertException e)
                {
                    Assert.Fail(string.Format("Assertion in '{0}' failed: {1}", method.Name, e.Message));
                }
            }
        }
    }
}

