namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList arrList2)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            arrList.AddRange(arrList2);
            int New_arrListCount = arrList.Count;
            bool New_arrListContainsAnyOf2 = arrList.ContainsAny(arrList2.ToArray());
            int New_arrListLastIndexOf2 = LastIndexOf(arrList, arrList2.ToArray());

            int arrListCount = arrList2.Count;
            bool arrList2ContainsAnyOfOriginal = arrList2.ContainsAny(arrList.ToArray());

            PexObserve.ValueForViewing("$original_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_containsAny_arrList2", New_arrListContainsAnyOf2);
            PexObserve.ValueForViewing("$new_arrList_lastIndexOf_arrList2", New_arrListLastIndexOf2);
            PexObserve.ValueForViewing("$arrList2_Count", arrListCount);
            PexObserve.ValueForViewing("$arrList2_containsAny_Original_arrList", arrList2ContainsAnyOfOriginal);

            Debug.Assert((New_arrListCount == Old_arrListCount + arrListCount));
            Debug.Assert((New_arrListContainsAnyOf2 == true));
            Debug.Assert((New_arrListLastIndexOf2 >= Old_arrListCount));
            Debug.Assert((arrList2ContainsAnyOfOriginal == false));

            // Verifies that the list has been updated correctly 
            // according to the specification of the AddRange method 
            // in the ArrayList class.
        }

        private int LastIndexOf(ArrayList list, object[] array)
        {
            for (int i = list.Count - 1; i >= 0; i --)
            {
                if (array.Contains(list[i]))
                    return i;
            }
            return -1;
        }
    }
