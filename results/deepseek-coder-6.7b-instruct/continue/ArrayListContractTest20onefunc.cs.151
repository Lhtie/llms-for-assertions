	    _target.ArrayList arrList = _target.Create<_target.--------------------            PexAssert.AreEqual("Old index is greater or equal to -1", Old_arrListIndexOfX >= -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of removed x in old array is geq minus 1 
            PexAssert.AreEqual("Old last index is greater or equal to -1", Old_arrListLastIndexOfX >= -1);

	     // an assertion using "Debug.Assert\(.*?\);" that  @@@ whether old array contains x is not 
            PexAssert.IsFalse("Old arrList contains x", Old_arrListContainsX, "@Old_arrListContainsX");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ whether new array count minus old array count equals 1 
            PexAssert.AreEqual(1, New_arrListCount - Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ whether new array index of x equals -1 or old index of x plus 1 
