            AssertForViewing(false, Old_arrListIndexOfX >= -1, true, "old index of x in arrList is geq minus 1");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new index of x in arrList is geq minus 1 
            AssertForViewing(false, New_arrListIndexOfX >= -1, true, "new index of x in arrList is geq minus 1");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ old LastIndexOf x in arrList is eq to New LastIndexOf x 
            AssertForViewing(false, Old_arrListLastIndexOfX == New_arrListLastIndexOfX, true, "old lastIndexOf x in arrList is eq to new lastIndexOf x");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new Count of arrList is eq to old Count of arrList minus 1 
            AssertForViewing(false, New_arrListCount == Old_arrListCount - 1, true, "new count of arrList is eq to old count of arrList minus 1");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new contains x is false 
            AssertForViewing(false, New_arrListContainsX, false, "new contains x is false");
        }

        [PexMethod]
        public void TestPUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            PUT_RemoveContract(arrList, x);
        }
    }
