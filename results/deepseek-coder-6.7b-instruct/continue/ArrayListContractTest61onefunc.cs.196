	    Debug.Assert(Old_arrListCount > -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, new list size > -1
	    Debug.Assert(New_arrListCount > -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ 'new_arrList_Count' == old_arrList_Count
	    Debug.Assert(New_arrListCount == Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ 'new_arrList_IndexOf_x' matches old_arrList_IndexOf_x
	    Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ 'new_arrList_LastIndexOf_x' matches old_arrList_LastIndexOf_x
	    Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, we should keep old_arrList_x, otherwise it could be any integer, in range of Count
	    if(New_Ret == true)
		Debug.Assert(Old_x == arrList[Old_arrListIndexOfX]);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, old_arrList_x is not in new _arrList
	    if (New_Ret == false)
		Debug.Assert(Old_arrListIndexOfX == -1) ; 
        }
    }
}

So, in reality it will never have a problematic branch which will run for all inputs given by Pex, however if we're just interested in testing the Contains property, then we should only put the test in the branch where Contains is true.

``` csharp
[PexMethod]
public void TestContains([PexAssumeValid]ArrayList arrList, int x)
{
    bool ret = arrList.Contains(x);
    if (ret)
    {
        int indexOfX = arrList.IndexOf(x);
        Debug.Assert(indexOfX > -1);
    }
}
```
The important part here is having specific inputs that your tests interact with as they would be in the production code. That's why it's very important to write tests with different kinds of inputs in mind.

And that's a basic introduction to the Pex and how we can use the tool effectively. If you want to explore more, I recommend reading more about Pex from the official documentations.

