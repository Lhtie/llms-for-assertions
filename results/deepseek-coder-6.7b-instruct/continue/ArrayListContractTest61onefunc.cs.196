	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the input list size is -1 and the return value is false, then the old list index of X is also -1 but after adding the element, it's not -1
	    ArbitraryCondition.ForExampleOnly(Old_arrListCount == -1 && New_Ret == false ==> Old_arrListIndexOfX == -1 && New_arrListIndexOfX != -1);
	    
	    // an assertion using "Debug.Assert\(.*?\);" that If the input list size is -1, then the last old list index of X and new list index of X are both -1
	    ArbitraryCondition.ForExampleOnly(Old_arrListCount == -1 ==> Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX == -1);
        }
    }
}

