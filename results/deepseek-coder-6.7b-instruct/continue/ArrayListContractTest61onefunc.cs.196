using System;
using Microsoft.Pex.Framework;
using System.Collections;
using System.Diagnostics;

[TestClass]
public class ArrayListContractTest
{
    [TestMethod]
    [PexMethod]
    public void PUT_ContainsContract([PexAssumeValid]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(arrList.Count>=0);
        AssumePrecondition.IsTrue(x>=int.MinValue && x<= int.MaxValue);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = -1;
        int Old_arrListLastIndexOfX = -1;

        if (arrList.Count>0)
        {
            Old_arrListIndexOfX = arrList.IndexOf(x);
            Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        }

        bool New_Ret = arrList.Contains(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = -1;
        int New_arrListLastIndexOfX = -1;

        if (arrList.Count>0)
        {
            New_arrListIndexOfX = arrList.IndexOf(x);
            New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        }

        Debug.WriteLine("$old_arrList_Count: "+ Old_arrListCount);
        Debug.WriteLine("$new_arrList_Count: "+ New_arrListCount);
        Debug.WriteLine("$old_--------------------
            if (!New_Ret)
            {
                Assert.IsTrue(Old_arrListCount >= -1); 
           
            }

	    // an assertion using "Assert\.AreEqual.*?" that will test if index of x has either increased or stayed the same

            Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
            
	    // an assertion using "Assert\.AreEqual.*?" that will check if last index of x has either increased or stayed the same

            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);

            // an assertion using "Assert.AreEqual" ensuring that the List's Count has either increased or stayed the same after .Contains method

	    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);   

        }
    }
}
```

通过PexInstrument代码，生成的单元测试将检查将元素添加到ArrayList后是否返回了正确的结果。它还将对列表的大小进行断言。

#### `PUT_GetRangeContract`

此方法用于测试具有参数的`GetRange`操作。

```csharp
[PexMethod]
[PexExplorationState(State = ExplorationState.Explored)]
public void PUT_GetRangeContract([PexAssumeUnderTest]ArrayList arrList, int index, int count)
{
    ArrayList old = new ArrayList(arrList);

    ArrayList New_Ret = arrList.GetRange(index, count);

    Assert.IsTrue(New_Ret.Count == count);

    for (int i = 0; i < count; i++)
    {
        Assert.IsTrue(New_Ret[i].Equals(old[index + i]));
    }
}
```

#### `PUT_IndexOfContract`

此方法用于测试参数化索引方法。

```csharp
[PexMethod]
[PexExplorationState(State = ExplorationState.Explored)]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, object x)
{
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListCount = arrList.Count;

    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListCount = arrList.Count;

    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    
    if (Old_arrListIndexOfX != -1)
    {
	    Assert.IsTrue(New_arrListIndexOfX == Old_arrListIndexOfX || New_arrListIndexOfX == Old_arrListCount - 1);
    }
    else if (New_arrListIndexOfX != -1)
    {
        Assert.IsTrue(Old_arrListCount + 1 == New_arrListCount);
    }
    else
    {
        Assert.IsTrue(New_arrListCount == Old_arrListCount);
    }
}
```

通过PexInstrument代码，生成的单元测试将检查将元素添加到ArrayList后是否返回了正确的索引。

这展示了如何使用Pex方法为ArrayList的每个方法编写单元测试。生成的单元测试不仅确保方法按预期执行，而且还检查了许多重要的“行为”属性，如一致性、完整性和前后一致性。

然而，需要注意的是，并非所有方法都进行了测试。一些方法，如Sort()或Insert()，需要自定义验证/观察方法，而其他方法仅在ArrayList按正确的顺序进行操作时更能提供有意义的结果。如果使用PexInstrument测试ArrayList的这些方法，会得到更详细的单元测试场景。对于这些方法，您可能需要参考Microsoft的Pex文档了解如何使用PexInstrument进行测试。

此外，使用Pex进行自动化测试可能是一种快速测试ArrayList的方法，但它并不一定是一种“最好的”测试方法。根据项目的具体需求，其他测试方法（如手动测试、集成测试等）可能更合适。最后，测试应该经过适当的审查和审计，以验证它们的完整性和有效性。

