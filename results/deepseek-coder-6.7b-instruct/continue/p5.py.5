class Matrix():
    def __init__(self, m):
        self.m = m
        self.height = len(m)
        self.width = len(m[0])
        
    def transpose(self):
        transposed = [[row[i] for row in self.m] for i in range(self.width)]
        return Matrix(transposed)

    def dot_product(a, b):
        if a.width != b.height:
            raise Exception("Incompatible matrices")
        result = [[sum(a.m[i][k]*b.m[k][j] for k in range(a.width)) for j in range(b.width)] for i in range(a.height)]
        return Matrix(result)

