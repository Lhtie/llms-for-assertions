User-defined Exceptions
<jupyter_code>
class Error(Exception):
    """Base class for other customized exception"""
    pass

class ValueTooHighError(Error):
    """Exception raised when the input value is too high."""
    pass

class ValueTooSmallError(Error):
    """Exception raised when the input value is too small."""
    pass

# user input
while(True):
    try:
        user_input = int(input('Enter a number: '))
        if(user_input > 10):
            raise ValueTooHighError
        elif(user_input < 5):
            raise ValueTooSmallError
        else:
            print('correct number entered')
            break
    except ValueTooHighError:
        print('This value is too high')
        print()
    except ValueTooSmallError:
        print('This value is too small')
        print()
