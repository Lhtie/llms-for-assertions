class Solution:
    def maximumGroups(self, grades: List[int]) -> int:
        grades.sort()

        l = 0
        r = len(grades)
        res = 0

        while l <= r:
            mid = (l+r) // 2
            if check(mid, grades):
                res = mid
                l = mid + 1
            else:
                r = mid - 1
        return res


def check(mid, grades):
    freq = [0] * (max(grades) + 1)
    for i in range(mid):
        freq[grades[i]] += 1
    prev = sum(freq[:mid])
    for i in range(mid, len(grades)):
        if grades[i] >= mid:
            return True
        elif prev < sum(freq[:mid+1]):
            prev = sum(freq[:mid+1])
            freq[grades[i]] += 1
            mid += 1
        else:
            freq[grades[i]] += 1
    return False


