Using try-except block
<jupyter_code>
class Rectangle():
    def __init__(n, m):
        self.exp = n # this is how wide
        self.mat = n+m+2
        self.lin = m # this is how tall

def func(n, m):
    try:
        r = Rectangle(n, m)
        assert(r.mat > 0)
        assert(r.lin > 0)
        return r
    except AssertionError:
        return "AssertionError raised"

print(func(3, 6))
print(func(3, -6))
