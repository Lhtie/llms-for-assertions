        res = 0
        count = {ch:0 for ch in "abc"}
        
        for r in range(len(s)):
            count[s[r]]+=1
            
            while all(count.values()):
                count[s[r]]-=1
                r+=1
                res +=1
                
            if r == len(s):
                break
        return res
    
    
