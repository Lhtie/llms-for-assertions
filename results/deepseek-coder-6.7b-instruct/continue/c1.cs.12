#include <fstream>
#include <iostream>
#include <sstream>
#include <vector>
#include <cassert>

using namespace std;

int main()
{
    string fileName;
    while (true)
    {
        cout << "Enter the desired template file: ";
        cin >> fileName;

        ifstream file(fileName);
        if (file.fail())
            continue;

        vector<string> lines;
        for (string line; getline(file, line); )
        {
            istringstream lineStream(line);
            for (string word; lineStream >> word; )
                lines.push_back(word);
        }

        assert(!lines.empty());     // the template file is not empty

        break;
    }

    return 0;
}

