Tarefa 11 - Aproximaç�es Numéricas: Método da Bissecção
<jupyter_code>
# Definição da Função
def fun_01(x):
    from math import exp, sin
    return (exp(-x)*sin(x))
# Função Principal
def bissec(a, b):
    if (fun_01(a) * fun_01(b)) > 0:
        return 'Não há raiz no intervalo'
    else:
        while ((b - a) >= 0.01):
            c = (a + b) / 2
            if (fun_01(c) == 0.0):
                break
            elif (fun_01(a) * fun_01(c)) < 0:
                b = c
            else:
                a = c
        return c
# Chama a função principal
root = bissec(-1, 1)

print(f"A raiz encontrada foi {root}")--------------------    assert 0 < amnt <= 100, "bad amount"
    
