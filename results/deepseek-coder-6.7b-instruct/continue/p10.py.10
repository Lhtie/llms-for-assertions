    assert amnt <= frm.money and amnt > 0, f'can\'t transfer such amount from your account'

    frm.money -= amnt
    to.money += amnt


def transfer_between_persons(p1, p2, amnt):
    """ Transfer money from one person's accounts to the other's """

    # make sure the two people aren't the same person
    assert p1 != p2, 'can\'t transfer to yourself'

    p1_accounts = p1.accounts
    p2_accounts = p2.accounts

    # select account at random
    a1 = random.choice(p1_accounts)
    a2 = random.choice(p2_accounts)

    # make the transfers in parallel
    transfer(a1, a2, amnt)


def test_banking_functionality():
    joe = Person("Joe")
    bob = Person("Bob")

    p1_accounts = joe.accounts

    bob_account = random.choice(bob.accounts)

    # pick any one of joe's account and subtract some amount from it
    a1 = random.choice(p1_accounts)
    subtract_amnt = random.randint(1, a1.money)
    a1.money -= subtract_amnt

    # try to transfer joe's account to Bob's account
    try:
        transfer_between_persons(joe, bob, subtract_amnt)
    except AssertionError as e:
        print(f'caught an error trying to transfer from Joe to Bob \n{e}')
    else:
        print('test 1: failed')

    random_account = random.choice(joe.accounts)
    # try to transfer to same person from same account
    try:
        transfer(random_account, random_account, 50)
    except AssertionError as e:
        print(f'caught an error trying to transfer to self from same account \n{e}')
    else:
        print('test 2: failed')

    # try to transfer too much money from one person to another
    try:
        transfer_between_persons(joe, bob, bob_account.money + 50)
    except AssertionError as e:
        print(f'caught an error trying to transfer more than is available in source account \n{e}')
    else:
        print('test 3: failed')


test_banking_functionality()def gcd_while(a, b):
    """
    Finds the Greatest Common Divisor (GCD) of two integers a and b using the while loop.
    """
    while b != 0:
        t = b
        b = a % b
        a = t
    return a


def gcd_recursive(a, b):
    """
    Finds the Greatest Common Divisor (GCD) of two integers a and b using the recursive approach.
    """
    if b == 0:
        return a
    else:
        return gcd_recursive(b, a % b)


def main():
    a = int(input('Enter first number: '))
    b = int(input('Enter second number: '))

    print('Using while loop: GCD is', gcd_while(a, b))
    print('Using recursive approach: GCD is', gcd_recursive(a, b))


if __name__ == '__main__':
    main()def calculate_pi(n):
    """
    Calculates the value of pi by the Leibniz formula for π and the given n number of terms.
    """
    pi = 0
    for i in range(n):
        pi += ((-1) ** i) / (2 * i + 1)
    return 4 * pi


def main():
    n = int(input('Enter the number of terms: '))
    print('Estimated value of pi using', n, 'terms is', calculate_pi(n))


