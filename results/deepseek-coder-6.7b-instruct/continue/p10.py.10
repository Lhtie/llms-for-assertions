def transfer_from_person(frm: Person, to_idx, amnt):
    """ the person "frm" selects one of his accounts and transfers "amnt" money to the "to_idx"-th account of the person """

    # an assertion using "assert .*?" that @@@ the "to_idx" is within valid limits (0 to 4)
    assert to_idx >= 0 and to_idx <= 4, "Invalid to_idx"

    from_account = random.choice(frm.accounts)
    transfer(from_account, frm.accounts[to_idx], amnt)


def multitransaction(people):
    for _ in range(10):
        for person in people:
            from_idx = random.choice(range(5))
            to_idx = random.choice(range(5))
            while from_idx == to_idx:
                to_idx = random.choice(range(5))
            amnt = random.randint(1, 100)
            transfer_from_person(person, to_idx, amnt)


