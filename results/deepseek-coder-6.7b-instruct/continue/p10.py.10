import random

logging.basicConfig(filename='demo.log', level=logging.DEBUG)
logging.warning("this is a warning")
logging.info("this is an info message")
logging.error("this is an error message")


def quadratic_equation(a, b, c):
    """ finds the roots of a quadratic equation ax^2 + bx + c = 0"""
    try:
        root = b**2 - 4*a*c
        if root < 0:
            raise ValueError("The equation has no real root")
        root1 = (-b + root**0.5) / (2*a)
        root2 = (-b - root**0.5) / (2*a)
        return (root1, root2)
    except ZeroDivisionError as e:
        logging.error(f"Error: {e}, a cannot be zero.")
    except TypeError as e:
        logging.error(f"Error: {e}, input must be numeric.")
    except Exception as e:
        logging.error(f"Error: {e}")


print(quadratic_equation(1, 2, 1))
# ValueError: The equation has no real root

print(quadratic_equation(1, 2, 3))
# (-1.0, -3.0)

print(quadratic_equation(0, 2, 3))
# Error: a cannot be zero., None

print(quadratic_equation("1", 2, 3))
# Error: input must be numeric., None

print(quadratic_equation(1, "2", 3))
# Error: input must be numeric., None

print(quadratic_equation(1, 2, "3"))
# Error: input must be numeric., None

print(quadratic_equation(1, 2, [3]))
# Error: input must be numeric., None

print(quadratic_equation(1, 2, 3))
#(-1.0, -3.0)

