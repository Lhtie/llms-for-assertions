import threading
import time

# The lock
lock = threading.Lock()

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ transfers "amnt" money from "frm" to "to" """
    
    # acquire the lock
    with lock:
        # an assertion that  tranfter amount is not greater than 100 and is positive
        assert amnt < frm.money and amnt > 0 

        frm.money -= amnt
        to.money += amnt

        # sleep to pretend doing more work, to make the threads more visible
        time.sleep(0.1)

def transact(persons):
    """ randomly transfers money from one account to another. """
    
    frm_acct = random.choice(persons.accounts)
    to_acct = random.choice(persons.accounts)

    # We don't want the 'from' and 'to' accounts to be the same...
    while to_acct == frm_acct:
        to_acct = random.choice(persons.accounts)

    transfer(frm_acct, to_acct, random.randint(1,100))

# Create a bunch of people
persons = [Person(f'Person #{i}') for i in range(10)]

# Randomly interact with them
threads = [threading.Thread(target=transact, args=(random.choice(persons),)) for _ in range(100)]

for thread in threads:
    thread.start()

for thread in threads:
    thread.join()

# Print out the states of all accounts
for person in persons:
    for acct in person.accounts:
        print(f'{person.name} has {acct.money} left in Account #{id(acct)}')from flask import Flask, request, render_template
import pandas as pd
import numpy as np

app = Flask(__name__)


@app.route("/")
def hello():
    return render_template("index.html")


@app.route('/uploader', methods=['POST'])
def upload_file():
    df = pd.read_csv(request.files.get('file'))
    df = df.replace('?', np.nan)
    df = df.dropna(how='any')
    return df.head().to_html()


if __name__ == "__main__":
    app.run(debug=True)from flask import Flask, request, render_template, url_for
