    assert 0<amnt<=100, "Transfer amount out of range"
    
    # an assertion for the number of accounts from Person object "frm" is more than 0 
    assert len(frm.accounts)>0, "No account to transfer from"
    
    # an assertion for the number of accounts to Person object "to" is more than 0 
    assert len(to.accounts)>0, "No account to tranfer to"
    
    # An assert for checking the amount in 'frm' account is more than amount to be transfered
    assert frm.accounts[0].money>=amnt, "Transfer amount larger than available funds"

    frm.accounts[0].money -= amnt
    to.accounts[0].money += amnt

