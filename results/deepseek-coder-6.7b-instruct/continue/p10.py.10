class Account:
    def __init__(self, money, currency):
        self.money = money
        self.currency = currency


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = []


def transfer(frm, to, amnt, currency):
    def validate_money(money):
        return isinstance(money, (int, float)) and money > 0

    def validate_currency(from_currency, to_currency):
        return from_currency == to_currency

    if not (validate_money(amnt) and validate_currency(frm.currency, to.currency)):
        raise ValueError(f'Invalid money or currency values')

    if frm.money < amnt:
        raise ValueError('Not enough money in the account')

    frm.money -= amnt
    to.money += amnt


