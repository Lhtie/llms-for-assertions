def moneyTransfer(personA, personB, amnts):
    total_amnt = sum(amnts)

    # assertion to ensure all amounts are valid and the total amount should be less than or equal to personA's total money
    assert all((0 < x <= 100 for x in amnts)), "Some of the transfer amounts are not valid"
    assert sum(x.money for x in personA.accounts) >= total_amnt, "PersonA does not have enough money"

    accountA = random.choice(personA.accounts)
    accountB = random.choice(personB.accounts)

    try:
        transfer(accountA, accountB, total_amnt)
    except AssertionError as e:
        print(f"Money transfer failed due to: {str(e)}")
    except Exception as e:
        print("Unexpected Error: ", str(e))
    else:
        print(f"Money transferred successfully from {personA.name} to {personB.name}")


