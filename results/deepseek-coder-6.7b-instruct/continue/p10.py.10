        account.money += amnt


def main():
    alice = Person("Alice")
    bob = Person("Bob")

    alice_account = random.choice(alice.accounts)
    bob_account = random.choice(bob.accounts)

    transfer(alice, bob, 30)

    print("Alice has", sum(account.money for account in alice.accounts), "money.")
    print("Bob has", sum(account.money for account in bob.accounts), "money.")


if __name__ == "__main__":
    main()


