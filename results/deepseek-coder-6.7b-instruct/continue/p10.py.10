def distribute_random_money(persons):
    """ distribute random money among all persons """

    # an assertion using "assert .*?" that persons length is not zero
    assert len(persons) > 0, "Person length is zero"

    total = sum(person.accounts[0].money for person in persons)
    per_person = total / len(persons)

    for person in persons:
        transfer(person.accounts[0], person.accounts[1], per_person)


