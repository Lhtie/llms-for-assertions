def check_balance(p):
    """ "Checks" the balance of "person" """
    balance = sum([acc.money for acc in p.accounts])
    print(f"{p.name} current balance = {balance}")


def run_transfers(p1, p2, ntimes):
    """ random transfers for n times """
    print(f"Starting transfers for {p1.name} and {p2.name} {ntimes} times")

    for _ in range(ntimes):
        from_acct = random.choice(p1.accounts)
        to_acct = random.choice(p2.accounts)

        # using try/except block to handle any potential error from transfer function
        try:
            transfer(from_acct, to_acct, random.randint(1, 100))
        except AssertionError as e:
            print(f"Transfer failed because: {e}")
        except Exception:
            print(f"Unhandled exception occurred")

        check_balance(p1)
        check_balance(p2)


p1 = Person("Alice")
p2 = Person("Bob")

# Run transfers many times
