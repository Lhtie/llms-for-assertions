class Mesh(object):
    def __init__(self, vertices, elements):
        self.vertices = np.array(vertices, dtype=float)
        self.elements = np.array(elements, dtype=int)

    def get_point(self, element, u, v):
        element_value = self.elements[element]
        vertex_value = self.vertices[element_value, :]

        p = (1 - u - v) * vertex_value[0, :] + u * vertex_value[1, :] + v * vertex_value[2, :]
        return p

