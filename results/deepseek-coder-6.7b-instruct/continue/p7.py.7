import math

def isqrt(n):
    return math.floor(math.sqrt(n))

def clamp(value, min_value=0, max_value=1):
    return max(min(value, max_value), min_value)

def lerp(min_value, max_value, amount):
    return min_value + amount * (max_value - min_value)

