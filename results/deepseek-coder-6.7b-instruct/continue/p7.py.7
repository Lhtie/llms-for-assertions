def is_consecutive(x):
    """
    Purpose: Check if np.array is consecutive
    Parameters:
    x - np.array

    Returns:
    bool - True if consecutive, else False
    """
    if np.array_equal(x, np.arange(x.min(), x.max() + 1)):
        return True
    else:
        return False


def test_is_consecutive():
    assert is_consecutive(np.array([1, 2, 3, 4, 5])) == True
    assert is_consecutive(np.array([5, 4, 3, 2, 1])) == True
    assert is_consecutive(np.array([1, 2, 4, 5])) == False
    assert is_consecutive(np.array([2, 1, 0, -1])) == False

