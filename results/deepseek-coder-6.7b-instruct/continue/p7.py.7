def sigmoid(z):

    """
    Compute the sigmoid of z

    Args:
        z (ndarray): A scalar, a vector, or a matrix of any size.

    Returns:
        g (ndarray): sigmoid(z) element-wise
    
    """

    g = 1 / (1 + np.exp(-z))
    return g

def sigmoid_grad(g):

    """
    Compute the gradient of the sigmoid function at every point in g

    Args:
        g (ndarray): A scalar, a vector, or a matrix (any size).

    Returns:
        sigmoid_gradient (ndarray): The gradient of the sigmoid function at every point in g
    """

    sigmoid_gradient = g * (1 - g)
    return sigmoid_gradient

def softmax(x):

    """
    Compute the softmax of matrix x.

    Args:
        x (ndarray): A matrix.

    Returns:
        softmax (ndarray): The softmax of x.
    """

    e_x = np.exp(x - np.max(x))
    softmax = e_x / e_x.sum(axis=0)
    return softmax

def softmax_grad(softmax):

    """
    Compute the gradient for the softmax of the given matrix.

    Args:
        softmax (ndarray): A matrix.

    Returns:
        softmax_grad (ndarray): Gradient of the softmax.
    """

    diag = softmax.diagonal()
    mat = np.outer(diag, diag)
    softmax = softmax.reshape(-1, 1)
    softmax_grad = mat - np.dot(softmax, softmax.T)
    return softmax_grad

