def moving_average(x, n=3):
    """
    Purpose: Compute moving average of np.array
    Parameters:
    x - np.array
    n - window size

    Returns:
    ma: np.array with same size as x with moving average
    """

    weights = np.repeat(1.0, n) / n
    ma = np.convolve(x, weights, 'valid')

    return ma


def test_moving_average():
    assert np.allclose(moving_average(np.array([1, 2, 3, 4, 5]), 2), np.array([1.5, 2.5, 3.5, 4.5]))
    assert np.allclose(moving_average(np.array([1, 2, 3, 4, 5]), 3), np.array([2, 3, 4]))
    assert np.allclose(moving_average(np.array([-1, -1, -1, -1, -1]), 2), np.array([-1, -1, -1]))
    assert np.allclose(moving_average(np.array([1, 2, 3, 4, 5]), 1), np.array([1, 2, 3, 4, 5]))

    print('moving_average: all tests passed')

test_moving_average()

def rolling_variance(x, n=3):
    """
    Purpose: Compute rolling variance of np.array
    Parameters:
    x - np.array
    n - window size

    Returns:
    rv: np.array with same size as x with rolling variance
    """
    mean = moving_average(x, n)
    diff = [(i - mean[i]) ** 2 for i in x]
    weights = np.repeat(1.0, n) / n
    rv = np.convolve(diff, weights, 'valid')

    return rv


def test_rolling_variance():
    assert np.allclose(rolling_variance(np.array([1, 2, 3, 4, 5]), 2), np.array([0.5, 1.5, 2.5, 3.5]))
    assert np.allclose(rolling_variance(np.array([1, 2, 3, 4, 5]), 3), np.array([1, 2, 2.5]))
    assert np.allclose(rolling_variance(np.array([-1, -1, -1, -1, -1]), 2), np.array([0.5, 0.5, 0.5]))
    assert np.allclose(rolling_variance(np.array([1, 2, 3, 4, 5]), 1), np.array([0, 0, 0, 0, 0]))

    print('rolling_variance: all tests passed')

test_rolling_variance()
