        public void CopyToContract([PexAssumeValid]ArrayList arrList, int index, [PexAssumeValid] ArrayList array)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            AssumePrecondition.IsNotNull(array);
            AssumePrecondition.IsTrue(index + arrList.Count <= array.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrayCount = array.Count;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;
            int New_arrayCount = array.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_array_Count", Old_arrayCount);
            Pex--------------------            Assume.If(arrList.Count > 0 && New_arrListLastIndexOfX >= 0, New_Ret <= New_arrListLastIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the value x doesn't exist in the list, New Ret is -1
            Assume.If(!Old_arrListContainsX, New_Ret == -1);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ New Ret is always <= old list count
            bool Postcondition = New_Ret <= Old_arrListCount;

           // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the x doesn't exist in the list, New Ret is -1
           Postcondition &= (arrList.Contains(x)) == (New_Ret != -1);

           // an assertion using "Debug.Assert\(.*?\);" that if the x doesn't exist in the list, New list count is = Old list count
           Postcondition &= (arrList.Contains(x)) == (New_arrListCount == Old_arrListCount);

           PexAssert.IsTrue(Postcondition);
        }
    }
}

//code_coverage/ArrayList/Test/ArrayListContractTest/RemoveAtContractTests.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexEntryPoint]
        public void RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, [PexValidateFrom(0)]int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            AssumePrecondition.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            object Old_arrListElementIndex = arrList[index];
            bool Old_arrListContainsIndexElement = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsIndexElement = arrList.Contains(Old_arrListElementIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Element_Index", Old_arrListElementIndex);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Contains_IndexElement", New_arrListContainsIndexElement);

            // An assertion using PexObserve.ValueForViewing(".*?", ) that New list count is always >= old list count -1
            PexAssert.IsTrue(New_arrListCount >= Old_arrListCount - 1);

            // An assertion using PexAssert.IsFalse that If element is in old list, it's not in the new list
            PexAssert.IsFalse(Old_arrListContainsIndexElement && !New_arrListContainsIndexElement);
        }
    }
}

//code_coverage/ArrayList/Test/ArrayListContractTest/SortContractTest.cs
﻿using Microsoft.Pex.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexEntryPoint]
        public void SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            arrList.Sort();
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion that @@@: new list count is always equal to old list count
            PexAssert.AreEqual(Old_arrListCount, New_arrListCount);

            // an assertion that @@@: New sorted array list is always different from old array--------------------	    // and if the return value is negative, new ret == -1 (the method can only return a negative value when x is not present in list)
	    Debug.Assert(
		(Old_arrListContainsX && New_Ret <= Old_arrListLastIndexOfX)
		|| (!Old_arrListContainsX && New_Ret == -1)
		);
        }
    }
}

//ArrayListTest/ArrayListTests/ArrayListTests/ArrayTest.cs
﻿using System;
using System.Collections.Generic;
using ArrayList;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayListTests
{
    [TestClass]
    public class ArrayTest
    {
        [TestMethod]
        public void TestConstructorWithArray()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        public void TestConstructorWithList()
        {
            List<int> list = new List<int> {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(list);
            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        public void TestIndexOf()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            Assert.AreEqual(1, arrList.IndexOf(2));
            Assert.AreEqual(-1, arrList.IndexOf(4));
        }

        [TestMethod]
        public void TestAdd()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            arrList.Add(4);
            Assert.AreEqual(4, (int) arrList[3]);
            Assert.AreEqual(4, arrList.Count);
        }

        [TestMethod]
        public void TestRemove()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            arrList.Remove(2);
            Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(4, arrList.Capacity);
            Assert.AreEqual(1, (int) arrList[1]);
        }

        [TestMethod]
        public void TestClear()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
            Assert.AreEqual(2, arrList.Capacity);
        }

        [TestMethod]
        public void TestContains()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(4));
        }

        [TestMethod]
        public void TestCopyTo()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            int[] copy = new int[3];
            arrList.CopyTo(copy);
            Assert.AreEqual(1, copy[0]);
            Assert.AreEqual(2, copy[1]);
            Assert.AreEqual(3, copy[2]);
        }

        [TestMethod]
        public void TestInsert()
        {
            int[] ints = {1, 2, 3};
            ArrayList.ArrayList arrList = new ArrayList.ArrayList(ints);
            arrList.Insert(1, 4);
            Assert.AreEqual(4, (int) arrList[1]);
            Assert.AreEqual(4, arrList.Count);
        }
    }
}

