    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException")]
    [PexMethodUnderTest("System.Collections.ArrayList.CopyTo")]
    public partial class ArrayListCopyToContractTest
    {
        public void CopyToContract([PexAssumeValid]ArrayList arrList, int index, [PexAssumeValid] ArrayList array)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            AssumePrecondition.IsNotNull(array);
            AssumePrecondition.IsTrue(index + arrList.Count <= array.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrayCount = array.Count;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;
            int New_arrayCount = array.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_array_Count", Old_arrayCount);
            PexObserve.ValueForViewing("$new_array_Count", New_arrayCount);
            PexObserve.ValueForViewing("$index", index);

            int i;
	    // an assertion using "Debug.Assert\(.*?\);" 
            for(i = index ; i < index + Old_arrListCount ; i++)
            {
                AssumePrecondition.IsTrue(Object.ReferenceEquals(array[i], ((ArrayList)arrList)[i - index]));
            } 
	    // an assertion using "Debug.Assert\(.*?\);" 
            for (; i < New_arrayCount; i++)
	    {
                AssumePrecondition.IsTrue(((ArrayList)array)[i] == null);
            }

	    // Add more asserts here if needed.
        }
    }
}

