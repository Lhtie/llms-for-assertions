//Asserts/ArrayList/Test/ArrayListContractTest_Remove.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Assertions;
using PexTestFramework;
using System;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            object Old_obj = arrList[index];
            bool Old_arrListContainsOld_obj = arrList.Contains(Old_obj);

            object ret = arrList.Remove(index);

            bool New_arrListContainsOld_obj = arrList.Contains(Old_obj);
            int New_arrListCount = arrList.Count;

            // Assertions for Remove method
            Assert.AreEqual(Old_obj, ret);
            Assert.IsFalse(New_arrListContainsOld_obj);
            Assert.AreEqual(New_arrListCount, Old_arrListContainsOld_obj ? arrList.Count + 1 : arrList.Count);
            // An extra condition to check the Remove method is working properly
            Assert.AreEqual(New_arrListCount, arrList.Count);
            Assert.IsTrue(index >= 0 && index < New_arrListCount);

            PexObserve.ValueForViewing("$old_obj", Old_obj);
            PexObserve.ValueForViewing("$old_arrList_obj", Old_arrListContainsOld_obj);
            PexObserve.ValueForViewing("$ret", ret);
            PexObserve.ValueForViewing("$New_arrList_obj", New_arrListContainsOld_obj);
            PexObserve.ValueForViewing("$New_arrList_Count", New_arrListCount);
        }
    }
}

