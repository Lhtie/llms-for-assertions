//ArrayList.Test/ArrayListContractInvariants.cs
﻿// ReSharper disable InconsistentNaming
using System.Collections;
using Microsoft.Pex.Framework;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractInvariants
    {
        public void COUNT_Invariant([PexAssumeUnderTest]ArrayList arrList, object item)
        {
            AssumePrecondition.IsTrue(true); // the condition that makes the test run

            int Old_Count = arrList.Count;

            arrList.Add(item);     // test method under investigation

            int New_Count = arrList.Count;

            AssumePrecondition.IsFalse(Old_Count - New_Count < 0);
            AssumePrecondition.IsFalse(Old_Count - New_Count > 1);

            //invariant assertion:  @@@ [Old_Count] - [New_Count] == 0 OR [Old_Count] - [New_Count] == 1
            bool Assertion = (Old_Count - New_Count == 0 || Old_Count - New_Count == 1);
            AssumePrecondition.IsTrue(Assertion);
//@@@ End
        }
        public void CAPACITY_Invariant([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_Capacity = arrList.Capacity;

            arrList.TrimToSize();    // test method under investigation
            arrList.Add(null); 
            arrList.RemoveAt(0);

            int New_Capacity = arrList.Capacity;

            //invariant assertion: @@@ If Old_Capacity > New_capacity then New_capacity should not be < Old_Capacity - 1, else New_Capacity should be equal to Old_Capacity
            AssumePrecondition.IsFalse(New_Capacity < Old_Capacity - 1 && Old_Capacity > New_Capacity);
            AssumePrecondition.IsTrue(New_Capacity == Old_Capacity || New_Capacity == Old_Capacity - 1);
            AssumePrecondition.IsFalse(New_Capacity < 0);
//@@@ End
        }
    }
}

