----------------------------------------            Debug.Assert(
               New_Ret == true
                ? New_arrListLastIndexOfX >= Old_arrListLastIndexOfX
                : true);// @@@ an assertion for an error condition; the new list's last index of x will not exceed old list's last index of x.
----------------------------------------            // @@@ If the return value is true, new list's index of x is >= old list's index of x
	    // @@@ If the return value is false, new list's count is equal to old list's count
            Debug.Assert(New_Ret == true ? (New_arrListLastIndexOfX >= Old_arrListLastIndexOfX && New_arrListIndexOfX >= Old_arrListIndexOfX) : Old_arrListCount == New_arrListCount);
----------------------------------------	    // i.e. adding element x doesn't make ListIndexOf(x) decrease
            if (New_Ret)
            {
                if (New_arrListLastIndexOfX < Old_arrListLastIndexOfX)
                {
                    Debug.Assert(false);
----------------------------------------
           if (New_arrListCount > Old_arrListCount)
           {
               Debug.Assert(!New_Ret || New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
