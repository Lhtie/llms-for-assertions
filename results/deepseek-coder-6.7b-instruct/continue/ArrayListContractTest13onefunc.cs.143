            Assert.AreEqual(-1, New_arrListIndexOfX);
            // assertion to make sure that LastIndexOf x returns -1 when x is no longer in the list
            Assert.AreEqual(-1, New_arrListLastIndexOfX);
            // assertion to make sure that contains x returns false when x is no longer in the list
            Assert.IsFalse(New_arrListContainsX);
        }
    }
