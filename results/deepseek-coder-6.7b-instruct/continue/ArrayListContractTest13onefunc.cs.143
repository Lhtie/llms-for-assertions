        {
            _list = new ArrayList();
        }

        [Test]
        public void Add_IncrementsCount() 
        {
            _list.Add(1);

            Assert.AreEqual(1, _list.Count);
        }

        [Test]
        public void Remove_DecrementsCount() 
        {
            _list.Add(1);
            _list.Remove(1);

            Assert.AreEqual(0, _list.Count);
        }

        [Test]
        public void Clear_CountIsZero() 
        {
            _list.Add(1);
            _list.Clear();

            Assert.AreEqual(0, _list.Count);
        }
    }
}

