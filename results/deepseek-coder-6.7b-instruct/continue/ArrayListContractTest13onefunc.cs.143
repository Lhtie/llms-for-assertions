using System;
using System.Collections.Generic;
using System.IO;

public static class EnumToStringMapper
{
    static Dictionary<Type, Dictionary<Enum, string>> mapFromEnumToString =
        new Dictionary<Type, Dictionary<Enum, string>>();

    static Dictionary<Type, Dictionary<string, Enum>> mapFromStringToEnum =
        new Dictionary<Type, Dictionary<string, Enum>>();

    public static void Add<TEnum>(TEnum e, string s)
        where TEnum : struct, IConvertible
    {
        var enumType = typeof(TEnum);
        if (!enumType.IsEnum)
            throw new ArgumentException("TEnum must be an enumerated type");

        if (!mapFromEnumToString.ContainsKey(enumType))
            mapFromEnumToString.Add(enumType, new Dictionary<Enum, string>());
        if (!mapFromStringToEnum.ContainsKey(enumType))
            mapFromStringToEnum.Add(enumType, new Dictionary<string, Enum>());

        mapFromEnumToString[enumType][e] = s;
        mapFromStringToEnum[enumType][s] = e;
    }

    public static string ToString<TEnum>(TEnum e)
        where TEnum : struct, IConvertible
    {
        var enumType = typeof(TEnum);

        if (mapFromEnumToString.ContainsKey(enumType) &&
            mapFromEnumToString[enumType].ContainsKey(e))
            return mapFromEnumToString[enumType][e];

        return e.ToString();
    }

    public static TEnum ToEnum<TEnum>(string s)
        where TEnum : struct, IConvertible
    {
        var enumType = typeof(TEnum);

        if (mapFromStringToEnum.ContainsKey(enumType) &&
            mapFromStringToEnum[enumType].ContainsKey(s))
            return (TEnum)mapFromStringToEnum[enumType][s];

        Enum.TryParse(s, out TEnum result);
        return result;
    }
}// Copyright (c) Microsoft Corporation.// Licensed under the MIT license.

