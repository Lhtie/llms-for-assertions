A: In your PexChooseAttribute you are saying you consider the array of elements from 0 to 3, but in your Assert.AreEqual you only have 1 parameter available.
If you update your Assert like this you should be able to fix it:
Assert.AreEqual(Old_arrListIndexOfX != -1 ? Old_arrListLastIndexOfX : -1, New_arrListIndexOfX, "$old_arrList_LastIndexOf_x is not equal to $new_arrList_IndexOf_x");

On another note, the PexChoose construct seems a little strange, as the array size is defined in the declaration for this attribute and won't be changing based on any actual values. You might consider changing the values in your assertion to either specific element indices you know should never change, or some arbitrary elements from the array.
Hope this helps.

A: The main problem here is that the IndexOf and LastIndexOf methods might not return the correct result if you are trying to remove the last element of the list.
In the scenario where the list has only one element, IndexOf and LastIndexOf will return 0, and Remove will remove that element, leaving the Count at 0. At this point, if you call IndexOf again, it will return -1 because the element that you're asking for isn't found.
Here is the contract where Count, Element Existence and Index Values are tested.

void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    if (arrList.Count == 0) // Quick exit as Count check below will fail.
    {
        return;
    }

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    // Assorted checks
    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$old_arrList_x", Old_x);
    PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
    PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
    PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
    PexObserve.ValueForViewing("$new_arrList--------------------	    Debug.Assert(New_arrListCount <= Old_arrListCount);

	    // assertions for some other conditions that can be derived from observations/assumptions. 
	    Debug.Assert(New_arrListCount == (Old_arrListCount - 1) || 
                          (Old_arrListIndexOfX >= New_arrListCount && 
                           Old_arrListLastIndexOfX >= New_arrListCount && 
                            !New_arrListContainsX));
        }
    }
