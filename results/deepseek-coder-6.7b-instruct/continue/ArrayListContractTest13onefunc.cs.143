using System.Diagnostics;
using Microsoft.Pex.Framework;
using System.Collections;
using ArrayList.Test;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrIndex = index;
            int Old_arrListIndexOfIndex = arrList.IndexOf(index);
            object Old_arrListElement = index < arrList.Count ? arrList[index] : null;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfIndex = arrList.IndexOf(index);
            object New_arrListElement = index < arrList.Count ? arrList[index] : null;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_arrIndex);
            PexObserve.ValueForViewing("$old_arrList_Element", Old_arrListElement);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_index", Old_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_index", New_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_Element", New_arrListElement);

            Debug.Assert(New_arrListCount <= Old_arrListCount);
            Debug.Assert(New_arrListIndexOfIndex == -1);
            Debug.Assert(New_arrListElement == null || !arrList.Contains(New_arrListElement));
        }
    }
}

