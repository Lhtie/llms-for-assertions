# This is a sample code to use ArrayList
ArrayList myAL = new ArrayList();
myAL.Add(1);
myAL.Add(2);
myAL.Add(3);
myAL.Add(4); 

for (int i = 0; i < myAL.Count; i++)
{
    Console.Write(myAL[i] + " ");
}

myAL.Sort();

Console.WriteLine("After Sorting:");

foreach (int i in myAL)
{
    Console.Write(i + " ");
}

myAL.Remove(2); // Removes the first occurrence of 2

myAL.Insert(2, 2); // Inserts 2 at index 2

foreach (int i in myAL)
{
    Console.WriteLine(i + " ");
}
```
Output:
``` 
1 2 3 4 
After Sorting:
1 2 3 4 
1 2 2 3 4 
```

## ArrayList and Its DefaultCapacity

Now, let's talk about ArrayList and the underlying implementation that .NET creates for the data structure:

In .NET, "ArrayList" is a dynamic list that provides large-scale, array-based storage. It dynamically grows and shrinks as you add and remove items. In C#, it is declared by `System.Collection.ArrayList`. However, whenever you create a new instance of ArrayList, you can specify the "capacity". The--------------------