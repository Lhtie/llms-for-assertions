{
    public class MissingTypeAndMemberDiagnostics
    {
        [Fact]
        public void CheckParsedFilesDoNotContainMissingTypeAndMemberDiagnostics()
        {
            var syntaxTree = CSharpSyntaxTree.ParseText(@"
                class C {
                    A a; // CS0115: 'A' is a type or namespace name, which is not valid in the given context.
                    void M() {
                        b = 5; // CS0103: The name 'b' does not exist in the current context.
                    }
                }");

            var compilation = CSharpCompilation.Create("Temp", new[] { syntaxTree });
            var diagnostics = compilation.GetDiagnostics();

            var validDiagnostics = diagnostics.Where(d => d.Severity == DiagnosticSeverity.Error && (d.Id == (int)CSharpDiagnosticIds.CS0115 || d.Id == (int)CSharpDiagnosticIds.CS0103));
            Assert.Empty(validDiagnostics);
        }
    }
}
