using Microsoft.VisualStudio.TestTools.Pex.Samples.Generic;
using Microsoft.VisualStudio.TestTools.Pex.Targets;
using Microsoft.VisualStudio.TestTools.Pex.Common;





namespace ArrayList.Test
{
    [TargetContract]
    [TargetType(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(arrList != null);

            int Old_arrListCount = arrList.Count;

            arrList.Add(obj);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        }


        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, object obj)
        {
            AssumePrecondition.IsTrue(arrList != null && index >= 0 && index <= arrList.Count);

            int Old_arrListCount = arrList.Count;

            arrList.Insert(index, obj);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        }
    }
}

