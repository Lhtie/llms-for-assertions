using System.Linq;
using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Symbols;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Xunit;

namespace Microsoft.CodeAnalysis.CSharp.UnitTests.SyntaxTreeAnalysis
{
    public class BinaryExpressionAnalysis
    {
        [Fact]
        public void BinaryExpressionTypeAnalysis()
        {
            // The binary expression: `0 || 0`
            var syntaxTree = CSharpSyntaxTree.ParseText(@"0 || 0");
            var semanticModel = new CSharpCompilation(null, new[] { syntaxTree }).GetSemanticModel(syntaxTree);

            var binaryExpression = syntaxTree.GetRoot().DescendantNodes().OfType<BinaryExpressionSyntax>().First();
            var symbolInfo = semanticModel.GetSymbolInfo(binaryExpression);

            Assert.NotNull(symbolInfo.Symbol);
            Assert.True(symbolInfo.Symbol is IMethodSymbol);
            Assert.Equal(SpecialType.System_Boolean, ((IMethodSymbol)symbolInfo.Symbol).ReturnType.SpecialType);
        }
    }
}

//source/test/Xunit/Microsoft.CodeAnalysis.Sdk.Test/SyntaxTreeAnalysis/MethodGrouping.cs
﻿// Copyright (c) Microsoft.  All Rights Reserved.  Licensed under the Apache License, Version 2.0.  See License.txt in the project root for license information.

using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Xunit;

namespace Microsoft.CodeAnalysis.CSharp.UnitTests.SyntaxTreeAnalysis
{
    public class MethodGrouping
    {
        [Fact]
        public void CheckGrouping()
        {
            var methodSyntax = SyntaxFactory.MethodDeclaration(
                returnType: SyntaxFactory.IdentifierName("void"),
                identifier: SyntaxFactory.Identifier("M"))
                .WithLeadingTrivia(SyntaxFactory.Comment("leading"))
                .WithTrailingTrivia(SyntaxFactory.Comment("trailing"));

            var groupedNode = SyntaxFactory.Group(methodSyntax);
            Assert.Equal(methodSyntax, groupedNode.Child);
        }
    }
}

