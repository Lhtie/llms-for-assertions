    '''return area and perimeter of the shape with larger area and perimeter'''
    return compare_a(s1, s2), compare_p(s1, s2)

def compare_shapes(s1, s2):
    assert (s1.typ == s2.typ), "Comparison of different type of shapes is not possible"
    same_type_comparisons = {'Rectangle-Rectangle': compare_a_and_p, 'Circle-Circle':compare_a_and_p,
                            'Rectangle-Circle':compare_a_and_p}
    return same_type_comparisons["{}-{}".format(s1.typ, s2.typ)](s1, s2)


