﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ArrayList
{
    public class List : IEnumerable
    {
        private int[] array;
        private int currentCount;

        public List()
        {
            array = new int[10];
            currentCount = 0;
        }

        public int Count
        {
            get { return currentCount; }
        }

        public void Add(int item)
        {
            if (currentCount >= array.Length)
            {
                ResizeArray();
            }

            array[currentCount] = item;
            currentCount++;
        }

        private void ResizeArray()
        {
            int[] newArray = new int[array.Length * 2];
            for (int i = 0; i < array.Length; i++)
            {
                newArray[i] = array[i];
            }

            array = newArray;
        }

        public bool Remove(int item)
        {
            int itemIndex = IndexOf(item);

            if (itemIndex >= 0)
            {
                RemoveAt(itemIndex);
                return true;
            }

            return false;
        }

        public int IndexOf(int item)
        {
            for (int i = 0; i < currentCount; i++)
            {
                if (array[i] == item)
                    return--------------------	    // that can be used to test whether the setting of value actually changed in the ArrayList; 

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListCapacity = arrList.Capacity;

            arrList.Clear();

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = arrList.Capacity;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity);

            // An assertion checker in place to see if Clear method works as expected
            Assert.AreEqual(0, New_arrListCount, "The size of arrayList not zero after clear.");
            Assert.True(Old_arrListCapacity >= New_arrListCapacity, "ArrayList Capacity decreased after Clear, that is invalid.");
        }
    }
}

