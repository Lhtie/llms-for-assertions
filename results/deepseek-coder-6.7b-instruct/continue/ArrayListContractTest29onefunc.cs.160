//ReverseFactorialContractTest.cs
﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public int ReverseFactorial([PexAssumeValid] ArrayList list)
        {
            if (list.Count == 0)
            {
                throw new ArgumentException("Invalid input for list!");
            }
            int result = 1;
            list.Reverse();

            for (int i = 0; i < list.Count; i++)
            {
                int fact = (int)list[i];
                if (fact < 1)
                {
                    throw new ArgumentException("Invalid input inside list!");
                }   
                result *= fact;
            }

            return result;
        }
    }
}

//SortContractTest.cs
﻿/* 
 * This contract test the Insert method in ArrayList. 
 * It performs the following tests:
 * 1. Assert that if arrList is not null then after inserting x into index, count of arrList increases by one
 * 2. Assert that the x is inserted after index
 * 3. Assert that the item at index in arrList and the item at New_arrListIndexOf_x-1 in arrList are same after inserting x at index  
 */

using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void SortContract([PexAssumeValid] ArrayList list)
        {
            int Old_listCount = list.Count;

            list.Sort();

            int New_listCount = list.Count;

            // An assertion to test if post condition is preserved
            // i.e. if count of list decreases after calling Sort
            PexObserve.ValueForViewing("$old_list_count", Old_listCount);
            PexObserve.ValueForViewing("$new_list_count", New_listCount);

            Assert.AreEqual(Old_listCount, New_listCount);
        }
    }
}

//binarySearchContractTest.cs
﻿/* 
 * This contract test the BinarySearch method in ArrayList. 
 * It performs the following tests:
 * 1. Assert that if arrList is not null and x is in list then ArrayList.BinarySearch returns value greater than or equal to 0
 * 2. Assert that if arrList is not null and x is not in list then ArrayList.BinarySearch returns value less than 0
 */

using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public bool BinarySearchContract([PexAssumeValid] ArrayList list, int x)
        {
            if (list.Count == 0)
            {
                throw new ArgumentException("Invalid input for list!");
            }
        
            int pos = list.BinarySearch(x);
        
            if (pos >= 0)
            {
                return (list[(int)pos] == x);
            }
            else
            {
                int notfoundpos = ~pos;
                return (notfoundpos == list.Count || list[(int)notfoundpos] != x);
            }
        }
    }
}

//removeAtContractTest.cs
﻿/* 
 * This contract test the RemoveAt method in ArrayList. 
 * It performs the following tests:
 * 1. Assert that if index is valid then count of arrList decreases by one after removing the item at index
 * 2. Assert that if index is valid then arrList does not contain the item at removed index 
 */

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using ArrayList;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void RemoveAtContract([PexAssumeValid] ArrayList list, [PexAssumeValid--------------------            if (Old_arrListContainsX && Old_arrListIndexOfX <= Old_index && index <= New_arrListIndexOfX)
	    {
                int expected = (Old_arrListIndexOfX <= Old_index ? Old_arrListIndexOfX : Old_index) + 1;
		Debug.Assert(expected <= New_arrListIndexOfX,"Insertion did not push the elements correctly");
            }

            //an assertion that elements after the insertion index are pushed one to the right
            for (int i = Old_index; i >= (Old_arrListContainsX ? Old_arrListIndexOfX : 0); i--)
                Debug.Assert((int)arrList[i] == Old_x, "Elements after the insertion point have not been shifted to the right.");
        }
    }
}

public partial class ArrayListContractTest
{
    [PexMethod]
    [PexExploration]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        arrList.Insert(index, x);
    }
}

In the PUT_InsertContract test method, I assume the under test array list (arrList), and integers x and index and put a postcondition after the operation under test to insert x at index. 
I then observe the count of arrList before and after the operation, and indexes/contents of x before and after arrList.After the operation, x should have been inserted at index in arrList. Also, it should be noted that any elements following index in arrList, after the operation, should have been pushed towards higher indices in the array.

A: Here you go; this should work for you:
public partial class ArrayListContractTest
{
    [PexMethod]
    [PexExploration]
    public void PUT_InsertContract([PexAssumeUnderTest] ArrayList arrList, int x, int index)
    {
        // Assume
        Assume.True(index <= arrList.Count && index >= 0);

        // Observe
        int oldCount = arrList.Count;
        int oldIndexOfX = arrList.IndexOf(x);
        bool oldContainsX = arrList.Contains(x);

        // Operation
        arrList.Insert(index, x);

        // Observe
        int newCount = arrList.Count;
        int newIndexOfX = arrList.IndexOf(x);
        bool newContainsX = arrList.Contains(x);

        // Postcondition
        Assume.True(oldContainsX == newContainsX && newContainsX == (oldIndexOfX <= index));
        Assume.True(oldCount + 1 == newCount);
        Assume.True(index + 1 == newIndexOfX || (oldContainsX && oldIndexOfX + 1 == newIndexOfX));
        Assume.True(index == newIndexOfX || !arrList.Contains(x) || arrList.LastIndexOf(x) == index);

        // If x was in the list, it should have been pushed towards higher indices
        if (oldContainsX)
        {
            for (int i = oldIndexOfX; i >= (oldContainsX ? oldIndexOfX : 0); i--)
                Assume.True((int)arrList[i] == x);
        }

        // Postcondition
        Assume.True(oldContainsX == newContainsX && newContainsX == (oldIndexOfX <= index));
        Assume.True(oldCount + 1 == newCount);
        Assume.True(index + 1 == newIndexOfX || (oldContainsX && oldIndexOfX + 1 == newIndexOfX));
        Assume.True(index == newIndexOfX || !arrList.Contains(x) || arrList.LastIndexOf(x) == index);
    }
}

In this code, I've introduced four assumptions:


*

*The new count of arrList should be one more than the old count.

*The index of x in arrList should be either the insertion index plus one, or higher (because elements were pushed right), or the same, if x was in the list before, but not in the list now.

*The last index of x in arrList should be the index of x after insertion if x was in the list before the operation, or the index of insertion if not.


These assumptions should catch whether your index insert operation was successful. If x--------------------	    // and that all elements in new array list are equal to those in old array list except the position at which @@@ x is inserted 
	    // and all elements to right of @@@ x are to the left or equal to those in old array list.
        }
    }
}

This PEX test case checks that the Insert() function in the ArrayList class does not alter elements beyond the inserted element's position, not forgetting that ArrayList will also automatically grow if the provided index is out of bounds.

The assertion to be made could be:
```
Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX &&
              Enumerable.SequenceEqual(Enumerable.Range(0, Old_arrListCount),
                                      arrList.Cast<int>()
                                      .Zip(Enumerable.Range(0, Old_arrListCount), (x, i) => New_arrListIndexOfX < i ? i : i - 1))
              && New_arrListContainsX && 
	      arrList.Cast<int>().Take(New_arrListCount).SequenceEqual(arrList.Cast<int>().Take(Old_arrListCount).Concat(new[] { Old_x })));
``` 

Ensuring the index returned by the Insert function is indeed correct and that the elements in the array are in the correct order. We are using `Enumerable.SequenceEqual` to compare the arrays, and `Enumerable.Zip` to align elements based on their new position.

(Note: ArrayList does not use 'index' to determine order so I'm assuming List<T> in sample code here and using same 'index' as ArrayList Insert in contract test)

