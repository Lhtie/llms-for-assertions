    {
        ArrayList arrList = new ArrayList();
        arrList.Add(1);

        Assert.AreEqual(arrList.Count,--------------------	    Debug.Assert(Old_arrListIndexOfX >= -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old array is either geq x or eq minus 1
	    Debug.Assert(Old_arrListIndexOfX >= Old_x || Old_arrListIndexOfX == -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the value x is in the new array list 
	    Debug.Assert(New_arrListContainsX);
