//PexLib/Test/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using ArrayList;
using NUnit.Framework;

namespace PexLib.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void AddContract([PexAssumeUnderTest]ArrayList list, int x)
        {
            AssumePrecondition.IsTrue(true);

            int oldCount = list.Count;

            int ret = list.Add(x);

            AssumePostcondition.IsTrue(0 <= ret && ret <= list.Count);

            PexObserve.ValueForViewing("list.Count => "+list.Count+"; oldCount => "+oldCount);
            PexObserve.ValueForViewing("return value ret => " + ret + "; Value x => " + x);

        }

        [PexMethod]
        public void RemoveContract([PexAssumeUnderTest]ArrayList list, int x)
        {
            AssumePrecondition.IsTrue(true);

            int oldCount = list.Count;
            int oldIndex = list.IndexOf(x);
            bool oldContains = list.Contains(x);

            bool ret = list.Remove(x);

            AssumePostcondition.IsTrue((oldContains && ret) || (!oldContains && !ret));

            int newCount = list.Count;
            int newIndex = list.IndexOf(x);
            bool newContains = list.Contains(x);

            PexObserve.ValueForViewing("list.Count => " + list.Count + "; oldCount => " + oldCount);
            PexObserve.ValueForViewing("old x Index => " + oldIndex + "; new x Index => " + newIndex);
            PexObserve.ValueForViewing("old x Contains => " + oldContains + "; new x Contains => " + newContains);

            //Assert that Remove method works correctly
            Assert.AreEqual(ret, !newContains);
            Assert.AreEqual(newCount, oldCount - 1);
            Assert.AreEqual(newIndex, -1);
        }
    }
}

