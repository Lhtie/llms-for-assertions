    public partial class DataGrid
    {
        public DataGridListItem ListItem(string value)
        {
            var listItem = new DataGridListItem(this, value);
            return listItem;
        }
        
        public class DataGridListItem : AutomationWrapper
        {
            private readonly string value;
            private readonly AutomationElementWrapper elementWrapper;
            private readonly WpfWindow window;

            public DataGridListItem(DataGrid dataGrid, string value) : base(dataGrid.Element, dataGrid.WpfUiTest)
            {
                this.value = value;
                elementWrapper = new AutomationElementWrapper(this.Element, WpfUiTest);
                window = (WpfWindow)elementWrapper.Parent;
            }

            public override void AssertAreEqual(object expected)
            {
                Assert.AreEqual(expected, value);
            }

            public override object GetProperty(string propertyName)
            {
                switch (propertyName)
                {
                    case "value": return value;
                    case "window": return window;
                    default: return elementWrapper.GetProperty(propertyName);
                }
            }
        }
    }
