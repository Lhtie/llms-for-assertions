// Code contracts for the ArrayList class.
using Microsoft.Pex.Framework;
using System;
using System.Collections;
using System.Diagnostics.Contracts;

[ContractClass(typeof(ArrayListContractTest))]
public partial interface ArrayList : IList, ICollection, IEnumerable
{
    void Insert(int index, object value);
    object this[int index] { get; set; }
    int IndexOf(object value);
    void RemoveAt(int index);
}

//CodeCoverage/ArrayList/ArrayListTests/TestCases/InstrumentedCode/ArrayListContractTest.cs
// Contract tests for the ArrayList class.
using Microsoft.Pex.Framework;
using System.Collections;

public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
        int Old_arrListCount = arrList.Count;
        arrList.Insert(index, x);
        int New_arrListCount = arrList.Count;
        PexObserve.ValueForViewing("old_count", Old_arrListCount);
        PexObserve.ValueForViewing("new_count", New_arrListCount);
        PexAssert.IsTrue(New_arrListCount >= Old_arrListCount);
    }
}

