//CodeCoverage/CodeCoverage.Test/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.IndexOutOfRangeException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.OutOfMemoryException", typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        public void AddContract([PexAssumeValid]ArrayList arrList, [PexAssumeValid]object item)
        {
            int oldCount = arrList.Count;
            arrList.Add(item);
            ValidateAdd(arrList, oldCount, item);
        }

        [PexMethodUnderTest]
        void ValidateAdd(ArrayList list, int oldCount, object item)
        {
            if (list.Count == oldCount + 1) //if the number of elements in arraylist increased by 1
            {
                try
                {
                    list.Insert(oldCount + 2, item); //attempt to insert at index more than the current count
                    throw new ValidationException("Expected ArgumentOutOfRangeException: index is greater than the ArrayList's count.");
                }
                catch (ArgumentOutOfRangeException) { }
                catch (Exception e) { throw new ValidationException("Expected ArgumentOutOfRangeException, was: " + e); }
            }
        }
    }
}

