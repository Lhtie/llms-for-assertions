//ArrayList.Test/TestBase.cs
using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    public class TestBase
    {
        // Method: GetArrayList
        // Purpose: Returns ArrayList with the following conditions
        // 1. The ArrayList contains elements 0 to 4
        // 2. Element 4 at index 4
        public static ArrayList GetArrayList()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Add(4);
            return arrList;
        }

        // Method: CompareArrayLists
        // Purpose: Compares two ArrayList objects for equality
        public static void CompareArrayLists(ArrayList expected, ArrayList actual)
        {
            Assert.AreEqual(expected.Count, actual.Count);

            for (int i = 0; i < expected.Count; i++)
            {
                Assert.AreEqual(expected[i], actual[i]);
            }
        }
    }
}

//BubbleSort.Test/BubbleSortContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using BubbleSort;

namespace BubbleSort.Test
{
    [TestClass]
    public class BubbleSortContractTest
    {
        [TestMethod]
        [PexMethod(Action = PexMethodCategory.AllPublic, ExpressionVerifier = typeof(PexAdapter), MaxStates = 50)]
        public void BubbleSort_ContractTest(ArrayList input)
        {
            // Arrange
            ArrayList expected = new ArrayList(input);
            expected.Sort();
            
            // Act
            BubbleSortClass sorter = new BubbleSortClass();
            sorter.BubbleSort(input);
            
            // Assert
            TestBase.CompareArrayLists(expected, input);
        }
    }
}

