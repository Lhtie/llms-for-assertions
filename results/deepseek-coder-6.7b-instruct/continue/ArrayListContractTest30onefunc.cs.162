	    Debug.Assert(New_arrListIndexOfX >= 0);

            // assertion using "Xunit.InlineData\(" that New_arrListCount is old_arrListCount plus one @@@ 
            Assert.Equal(Old_arrListCount+1, New_arrListCount);
 
            // an assertion using Assert.Equal that @@@ for the same x, indexOf x is always larger than its lastIndexOf x and greater than or equal to index
	    Assert.True(New_arrListIndexOfX > New_arrListLastIndexOfX && New_arrListIndexOfX >= Old_index);
 
