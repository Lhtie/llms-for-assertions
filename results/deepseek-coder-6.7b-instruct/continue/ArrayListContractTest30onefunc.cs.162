namespace System.Reflection
{
    /// <summary>
    ///     Defines the methods for handling reflection operations on a type.
    /// </summary>
    public abstract class ReflectedType : DisposableObject, IReflectedType
    {
        private readonly Type _type;

        [NonSerialized]
        private Assembly _assembly;

        /// <summary>
        ///     Initializes a new instance of the <see cref="ReflectedType" /> class.
        /// </summary>
        /// <param name="type">The type to provide reflection.</param>
        protected ReflectedType(Type type)
        {
            _type = type;
        }

        /// <summary>
        ///     Gets the reflected type.
        /// </summary>
        /// <value>
        ///     The type.
        /// </value>
        public Type Type => _type;

        /// <summary>
        ///     Gets the reflected assembly.
        /// </summary>
        /// <value>
        ///     The assembly.
        /// </value>
        public Assembly Assembly
        {
            get
            {
                if (_assembly == null)
                    _assembly = ReflectedAssembly.Create(_type.Assembly);

                return _assembly;
            }
        }

        /// <summary>
        ///     Returns a string that represents the current object.
        /// </summary>
        /// <returns>
        ///     A string that represents the current object.
        /// </returns>
        public override string ToString()
        {
            return Type.ToString();
        }
    }
