        public void SET_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            bool Old_arrListContainsX = arrList.Contains(x);

            if (arrList.Contains(x) == false)
            {
                arrList.Add(x);
            }

            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ arraylist should contain the element if it has been added 
            Debug.Assert((arrList.Contains(x) == (Old_arrListContainsX || New_arrListContainsX)));
        }

        public void SET_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListItem_index = (int)arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_Item_index", Old_arrListItem_index);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ number of elements should have decreased by one after removing 
            Debug.Assert(arrList.Count + 1 == Old_arrListCount);
        }

        public void SET_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            bool Old_arrListContainsX = arrList.Contains(x);

            if (arrList.Contains(x) == false)
            {
                arrList.Add(x);
            }

            int New_arrListIndexOfX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve--------------------	    // and is less than arrList.Count + 1
            Debug.Assert((New_arrListIndexOfX >= 0) && (New_arrListIndexOfX < (Old_arrListCount + 1)));

	    // an assertion that the result of arrList.IndexOf(x) should be same after or one more than @@@ old index when insertion is at beginning.
            Debug.Assert((Old_index == 0) ? (New_arrListIndexOfX == Old_arrListIndexOfX) : (New_arrListIndexOfX == Old_arrListIndexOfX + 1));

	    // an assertion that x should be in arrList. after insertion
            Debug.Assert(New_arrListContainsX, string.Format("After performing {0} operation, List[{1}] does not contain the value [{2}]", "Insert", Old_index, x));

	    // an assertion that LastIndexOf(x) should after or one more than @@@ old index when insertion is at beginning.
            Debug.Assert((Old_index == 0) ? (New_arrListLastIndexOfX == Old_arrListLastIndexOfX) : (New_arrListLastIndexOfX == Old_arrListLastIndexOfX + 1));
        }
    }
}
```
### Properties
The `PUT_InsertContract` test method has an analysis contract enforced by PostSharp that ensures the program behaves as expected for an `ArrayList` `Insert` operation.

The test method assumes the following:
1. `index` is within the valid range for the `ArrayList` i.e. it cannot be less than 0 or more than the count.

The test method observes the following properties:
1. `arrList.Count` before and after the `Insert` operation.
2. `x` being inserted into the `arrList`.
3. `index` being used for insertion.
4. Previous `IndexOf(x)` and `LastIndexOf(x)` and `Contains(x)` results of `arrList`.
5. New `IndexOf(x)` and `LastIndexOf(x)` and `Contains(x)` results of `arrList`.

The test method asserts the following:
1. The position at which `x` was inserted is either within the valid range for the `arrList` counts, or `IndexOf(x)` is -1 if `x` was not inserted.
2. When `x` is inserted at the start of `arrList`, `IndexOf(x)` remains the same; otherwise, `IndexOf(x)` is one more than the old `IndexOf(x)`.
3. `x` is contained in the `arrList` after the insertion.
4. When `x` is inserted at the start of `arrList`, `LastIndexOf(x)` remains the same; otherwise, `LastIndexOf(x)` is one more than the old `LastIndexOf(x)`.
### Elements
### CodeBugs
These are the potential bugs as per the contract assertions in the `PUT_InsertContract` test method.

1. Assertion Fault: The assertion `(New_arrListIndexOfX >= 0) && (New_arrListIndexOfX < Old_arrListCount + 1)` fails if `index` is less than 0 or more than `arrList.Count`. 

2. Assertion Fault: The assertion `(Old_index == 0) ? (New_arrListIndexOfX == Old_arrListIndexOfX) : (New_arrListIndexOfX == Old_arrListIndexOfX + 1)` fails if `index` is more than `arrList.Count`.

3. Assertion Fault: The assertion `New_arrListContainsX` fails if `arrList` does not contain `x` after the insert operation.

4. Assertion Fault: The assertion `(Old_index == 0) ? (New_arrListLastIndexOfX == Old_arrListLastIndexOfX) : (New_arrListLastIndexOfX == Old_arrListLastIndexOfX + 1)` fails if `x` was not in `arrList` before the insertion operation and therefore cannot be found at any index in the array list starting from given index. 

These CodeBugs are potential defects which may appear in the application when `x` is inserted at `index` into `arrList`.
# Unit Test Cases

