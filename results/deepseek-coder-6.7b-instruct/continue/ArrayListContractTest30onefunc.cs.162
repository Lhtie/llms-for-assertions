            Assert.IsTrue(New_arrListIndexOfX >=0 && New_arrListIndexOfX<=arrList.Count);

	    //an assertion using "Debug.Assert\(.*?\);" that @@@ last index of x after insertion after insertion is more than or equal to 0 
	    // and less than or equal to arrList.Count
            Assert.IsTrue(New_arrListLastIndexOfX >=0 && New_arrListLastIndexOfX<=arrList.Count);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@count of arrList after insertion is more than or equal to
