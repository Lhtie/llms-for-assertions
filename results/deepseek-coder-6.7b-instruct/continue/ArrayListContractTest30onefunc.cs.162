	    Assert.True(New_arrListContainsX);
 
	    Assert.True(New_arrListIndexOfX==Old_index||New_arrListIndexOfX==Old_index+1);

            // assertion using Xunit.InlineData that for any x in arrList - there is a indexOf x @@@
	    Assert.NotEqual(-1, New_arrListIndexOfX);
