//PexExample/Stack.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace PexExample
{
    public class Stack
    {
        private List<int> _items = new List<int>();

        public int Count
        {
            get { return _items.Count; }
        }

        public void Push(int item)
        {
            _items.Add(item);
        }

        public int Pop()
        {
            if(_items.Count == 0)
                throw new Exception("Stack is empty");

            int item = _items[_items.Count - 1];
            _items.RemoveAt(_items.Count - 1);

            return item;
        }

        public int Peek()
        {
            if (_items.Count == 0)
                throw new Exception("Stack is empty");

            return _items[_items.Count - 1];
        }
    }
}

//PexExample/Tests/StackTests.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using NUnit.Framework;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using PexExample;

namespace PexExample.Tests
{
    [TestFixture]
    public class StackTests
    {
        [PexMethod]
        public void PushPopTest([PexAssumeUnderTest]Stack s, int x)
        {
            s.Push(x);
            
            Assert.AreEqual(x, s.Pop());
        }

        [PexMethod]
        public void PushPeekTest([PexAssumeUnderTest]Stack s, int x)
        {
            s.Push(x);

            Assert.AreEqual(x, s.Peek());
            Assert.AreEqual(1, s.Count);
        }

        [PexMethod]
        public void PopEmptyStackTest([PexAssumeUnderTest]Stack s)
        {
            AssumePrecondition.IsTrue(s.Count == 0);

            try
            {
                s.Pop();
                Assert.Fail("Expected exception");
            }
            catch (Exception ex)
            {
                Assert.AreEqual("Stack is empty", ex.Message);
            }
        }

        [PexMethod]
        public void PeekEmptyStackTest([PexAssumeUnderTest]Stack s)
        {
            AssumePrecondition.IsTrue(s.Count == 0);

            try
            {
                s.Peek();
                Assert.Fail("Expected exception");
            }
            catch (Exception ex)
            {
                Assert.AreEqual("Stack is empty", ex.Message);
            }
        }
    }
}

//PexExample/Tests/StackTestsPexAllBranches.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using NUnit.Framework;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using PexExample;

namespace PexExample.Tests
{
    [TestFixture]
    public class StackTestsPexAllBranches
    {
        [PexMethodUnderTest]
        public void PushTest([PexAssumeUnderTest]Stack s, int x)
        {
            s.Push(x);
        }

        [PexMethodUnderTest]
        public void PopTest([PexAssumeUnderTest]Stack s)
        {
            AssumePrecondition.IsTrue(s.Count > 0);

            s.Pop();
        }

        [PexMethodUnderTest]
        public void PeekTest([PexAssumeUnderTest]Stack s)
        {
            AssumePrecondition.IsTrue(s.Count > 0);

            s.Peek();
        }
    }

}

