            int ret = New_Ret;   // get ret in a new variable since NUnit 2.5 has limited support for debugging of variables in the message
            Assert.IsTrue(ret == -1 ? Old_arrListCount != -1 : true);


        }

        // ... test methods for other methods follow ...

