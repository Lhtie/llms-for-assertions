	    Debug.Assert (!(New_Ret == -1) ? Old_arrListCount != -1 : true );
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListXAtIndex = (int)(arrList[index]);
            bool Old_arrListContainsXAtIndex = arrList.Contains(Old_arrListXAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_containsOld_arrListXAtIndex = arrList.Contains(Old_arrListXAtIndex);
            int New_arrListLastIndexOfXAtIndex = arrList.LastIndexOf(Old_arrListXAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_x_at_index", Old_arrListXAtIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_x_at_index", Old_arrListContainsXAtIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_x_at_index", New_containsOld_arrListXAtIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x_at_index", New_arrListLastIndexOfXAtIndex);


        }

        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] arr, int index)
        {
            AssumePrecondition.IsNotNull(arr);
            AssumePrecondition.IsTrue(index>=0 && index <= arr.Length);
            AssumePrecondition.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            int Old_arrListLength = arr.Length;
            int Old_index = index;

            arrList.CopyTo(arr, index);

            for(int i=0; i<arr.Length;i++)
            {
            	AssumePrecondition.IsTrue(arr[i] == (int)(arrList[i]));
            }

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arr_Length", Old_arrListLength);
            PexObserve.ValueForViewing("$old_index", Old_index);

        }

        

    }
}

