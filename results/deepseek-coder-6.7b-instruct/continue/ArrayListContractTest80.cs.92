﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using NUnit.Framework;
using PexAPIWrapper;

namespace PexAPIWrapper.Tests
{
    [TestFixture]
    public class ArrayListSortContractTest
    {
        [Test]
        [PexMethod, PexFilePath(typeof(ArrayList))] // Point Pex at our implementation of ArrayList
        public void SortContract([PexAssumeUnderTest] ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count == 0);

            // Add some elements
            for (int i = 0; i < 5; i++)
            {
                arrList.Add(i);
            }

            // Sort the list
            arrList.Sort();

            for (int i = 0; i < arrList.Count - 1; i++)
            {
                // Ensure the list is sorted
                Assert.IsTrue((int)arrList[i] <= (int)arrList[i + 1]);
            }
        }
    }
}

