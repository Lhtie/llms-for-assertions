//PexBugInARow/State.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace PexBugInARow
{
    public class State
    {
        public enum GameResult
        {
            NONE,
            X_WIN,
            O_WIN,
            DRAW
        }

        public enum Player
        {
            X,
            O,
            NONE
        }

        public const int ROWS = 6;
        public const int COLS = 7;

        public Player[,] board;
        public Player currentPlayer;
        public int turnNumber;
        public GameResult result;

        public State()
        {
            this.board = new Player[ROWS, COLS];
            for (int i = 0; i < ROWS; i++)
                for (int j = 0; j < COLS; j++)
                    board[i, j] = Player.NONE;
            this.currentPlayer = Player.X;
            this.turnNumber = 0;
            this.result = GameResult.NONE;
        }

        public State(State state)
        {
            this.board = new Player[ROWS, COLS];
            for (int i = 0; i < ROWS; i++)
                for (int j = 0; j < COLS; j++)
                    this.board[i, j] = state.board[i, j];
            this.currentPlayer = state.currentPlayer;
            this.turnNumber = state.turnNumber;
            this.result = state.result;
        }

        public bool IsValidMove(int col)
        {
            return (col >= 0) && (col < COLS) && (board[0, col] == Player.NONE);
        }

        public int Play(int col)
        {
            if (!IsValidMove(col))
            {
                return -1;
            }

            int row;
            for (row = ROWS - 1; row >= 0; --row)
            {
                if (board[row, col] == Player.NONE)
                {
                    break;
                }
            }

            board[row, col] = currentPlayer == Player.X ? Player.X : Player.O;
            turnNumber++;
            currentPlayer = currentPlayer == Player.X ? Player.O : Player.X;

            GameResult res = CheckForWin(row, col);
            if (turnNumber == ROWS * COLS || res != GameResult.NONE)
            {
                result = res != GameResult.NONE ? res : GameResult.DRAW;
            }

            return row;
        }

        private GameResult CheckForWin(int row, int col)
        {
            for (int i = row - 1; i >= row - 3 && i >= 0; --i)
            {
                if (board[i, col] != currentPlayer)
                {
                    break;
                }
                if (i == row - 4)
                {
                    return currentPlayer == Player.X ? GameResult.X_WIN : GameResult.O_WIN;
                }
            }

            for (int i = col - 1; i >= col - 3 && i >= 0; --i)
            {
                if (board[row, i] != currentPlayer)
                {
                    break;
--------------------