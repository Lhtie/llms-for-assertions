﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayListTest
{
    [TestFixture]
    public partial class ArrayListTest
    {
        [PexMethod]
        public void Test(ArrayList arrList, int x)
        {
            PexAPI.PexAssume.IsNotNull(arrList);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

            //Asserts
            PexAPI.PexAssert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            PexAPI.PexAssert.AreEqual(Old_x, x);
            PexAPI.PexAssert.AreEqual(Old_arrListContainsX, !New_arrListContainsX);
        }

    }
}

