//Exercises/exercise_21/ArrayList/ArrayList.Test/ContractTest/ArrayListPropertiesTest.cs
﻿using NUnit.Framework;
using PexAPIWrapper;

namespace PexAPIWrapper.Tests
{
    [TestFixture]
    public class ArrayListPropertiesTest
    {
        [Test]
        [PexMethod]
        public void TestPropertiesAreCorrect([PexAssumeUnderTest] ArrayList arrList)
        {
            int oldCount = arrList.Count;
            int oldCapacity = arrList.Capacity;
            int oldVersion = arrList.Version;

            // Ensure properties are initialized properly
            Assert.AreEqual(0, arrList.Count);
            Assert.GreaterOrEqual(arrList.Capacity, 0);
            Assert.AreEqual(0, arrList.Version);

            // Add elements
            for (int i = 0; i < 10; i++)
            {
                arrList.Add(i);
            }

            // Ensure Count and Capacity increase
            Assert.AreEqual(10, arrList.Count);
            Assert.Greater(arrList.Capacity, oldCapacity);

            // Ensure Version is different
            Assert.AreNotEqual(oldVersion, arrList.Version);
        }
    }
}

