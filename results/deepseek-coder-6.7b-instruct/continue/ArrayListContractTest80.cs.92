//SpecFlowTest/StepDefinitions/SpecFlowFeature1Steps.cs
﻿using Microsoft.VisualStudio.TestTools.UnitTesting;
using NUnit.Framework;
using PexAPIWrapper;
using TechTalk.SpecFlow;

namespace SpecFlowTest.StepDefinitions
{
    [Binding]
    public class SpecFlowFeature1Steps
    {
        private readonly ScenarioContext _scenarioContext;
        private ArrayList _arrList;
        private int _x;

        public SpecFlowFeature1Steps(ScenarioContext scenarioContext)
        {
            _scenarioContext = scenarioContext;
            _arrList = new ArrayList();
        }

        [Given(@"I have a list")]
        public void GivenIHaveAList()
        {
            NUnit.Framework.Assert.IsNotNull(_arrList);
        }

        [Given(@"the list has an item '(.*)'")]
        public void GivenTheListHasAnItem(int p0)
        {
            _x = p0;
            _arrList.Add(_x);
        }

        [When(@"I add the item '(.*)' to the list")]
        public void WhenIAddTheItemToTheList(int p0)
        {
            _arrList.Add(p0);
        }

        [Then(@"the list should contain the item '(.*)'")]
        public void ThenTheListShouldContainTheItem(int p0)
        {
            Assert.IsTrue(_arrList.Contains(p0));
        }

        [When(@"I remove the item '(.*)' from the list")]
        public void WhenIRemoveTheItemFromTheList(int p0)
        {
            _arrList.Remove(p0);
        }

        [Then(@"the list should not contain the item '(.*)'")]
        public void ThenTheListShouldNotContainTheItem(int p0)
        {
            Assert.IsFalse(_arrList.Contains(p0));
        }

    }
}

//SpecFlowTest/StepDefinitions/SpecFlowFeature2Steps--------------------            PexObserve.ValueForViewing("$Assert", (New_Ret == -1 && Old_arrListCount != -1) ? "passed" : "failed");
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is not -1, it should be  equal to or grater than 0 
            PexObserve.ValueForViewing("$Assert2", (New_Ret >= 0) ? "passed" : "failed");
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >=0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(Old_arrListIndexOfX);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$after_remove, arrList[index]", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$after_remove_arrList_IndexOf_value", New_arrListIndexOfX);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }

        [PexMethod]
        public void PUT_ContainsInContract([PexAssumeUnderTest]ArrayList arrList, int[] values)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            foreach(int val in values)
                arrList.Add(val);

            int New_arrListCount = arrList.Count;

            foreach (int val in values)
                PexAssert.IsTrue(arrList.Contains(val), "Failed at value " + val.ToString());

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }
    }
