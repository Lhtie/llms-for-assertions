using System;

namespace assignment0
{
    class Program
    {
        static void Main(string[] args)
        {
            string plaintext;
            int shift;

            Console.WriteLine("Enter the plaintext to encrypt:");
            plaintext = Console.ReadLine().ToUpper();

            Console.WriteLine("Enter the shift amount (1-25):");
            shift = int.Parse(Console.ReadLine());

            string ciphertext = Encrypt(plaintext, shift);
            Console.WriteLine($"Encrypted message: {ciphertext}");

            string decryptedtext = Decrypt(ciphertext, shift);
            
            Console.WriteLine($"Decrypted message: {decryptedtext}");
            
        }

        static string Encrypt(string plaintext, int shift)
        {
            string ciphertext = "";
            foreach (char ch in plaintext)
            {
                if (Char.IsLetter(ch))
                {
                    char offset = Char.IsUpper(ch) ? 'A' : 'a';
                    ciphertext += (char)((ch + shift - offset) % 26 + offset);
                }
                else
                {
                    ciphertext += ch;
                }
            }
            return ciphertext;
        }

        static string Decrypt(string ciphertext, int shift)
        {
            string plaintext = "";
            foreach (char ch in ciphertext)
            {
                if (Char.IsLetter(ch))
                {
                    char offset = Char.IsUpper(ch) ? 'A' : 'a';
                    plaintext += (char)((ch - shift - offset + 26) % 26 + offset);
                }
                else
                {
                    plaintext += ch;
                }
            }
            return plaintext;
        }
    }
