namespace Moss.CustomFieldTypes.ContentTypeSelector
{
    /// <summary>
    /// Utility class for dealing with field data.
    /// </summary>
    public static class FieldDataUtility
    {
        #region Methods
        /// <summary>
        /// Extracts the content type name from the field value.
        /// </summary>
        /// <param name="fieldData">The field data.</param>
        /// <returns></returns>
        public static string ExtractContentTypeName(string fieldData)
        {
            try
            {
                string ctName = fieldData.Substring(fieldData.IndexOf("|") + 1);
                ctName = ctName.Substring(0, ctName.IndexOf("|"));
                return ctName;
            }
            catch
            {
                return null;
            }

        } 
        #endregion
    }
