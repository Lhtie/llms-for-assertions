A: NUnit's Assert mechanism doesn't support multiple assertions in one line, which is what you tried to express via PexObserve.

NUnit 2.5.7 introduced the Assert.Multiple helper class, which was extended in NUnit 2.5.8 to work with the framework's existing assertion mechanism. 

If you're creating an NUnit test, you can express multiple assertions as follows:
[Test]
public void MyTestMethod()
{
    ArrayList arrList = new ...;
    // Do some operations...

    using (Assert.Multiple())
    {
        Assert.That(Old_arrListCount, Is.GreaterThan(0));
        Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount + 1));
        //...
    }
}

For Pex methods as well, you could try something like:
[PexMethod]
public void MyPexMethod(...) 
{
    ...
    Assume(...);

    bool isCorrect = Old_arrListCount > 0 && New_arrListCount == Old_arrListCount + 1; 
    //... add more checks as needed 

    PexObserve.Verify(isCorrect);
}

This code will verify a single assumption based on given conditions, and if the assumption is not met, the test will fail.
Bear in mind that this approach won't make your methods more interesting because Pex tries to provide multiple inputs for each test method. In practice, combining multiple assertions in one line is usually a poor practice because it is harder to understand the test. It is recommended using one assertion per check. With multiple assertions, it might be confusing when someone looks at the results of the test, and it makes it harder to identify which specific assertion failed.

A: I agree with the others, you cannot perform multiple assertions within one PexObserve statement. 
But there is another way to prove your contract. By using the "POST" version of the tests, you can make sure that the contract holds not only in the initial state, but also in the next state. In addition, testing different contracts by using the "POST" tests enables you to catch potential violations of several contracts at the same time, if they cause the object's behavior to differ.
Consider below an example on ArrayList Contract tests with using "POST" versions:
[Test, PexMethod]
public void POST_AddContract([PexAssumeUnderTest] ArrayList list, int item)
{ 
    Assume.True(list.Capacity >= list.Count + 1);
    Assume.False(list.Contains(item));

    int oldCount = list.Count;
    int oldCapacity = list.Capacity;

    list.Add(item);

    int newCount = list.Count;
    int newCapacity = ((DynamicArrayList)list).Array.Length; 

    Assume.True(newCount == oldCount + 1);
    Assume.True(list.Contains(item));

    bool postCapacity = (oldCapacity == newCapacity) || (oldCapacity < newCapacity);
    bool postSequence = Enumerable.SequenceEqual<int>(list, Enumerable.Range(0, oldCount + 1).Select(i => i));
    bool postContains = list.Contains(item);

    PexObserve.Verify(postCapacity && postSequence && postContains);
}

Please note that Pex treats the underlining object's behavior differently, so you should do some transformations such as casts when you want to access private/protected class members (for example, we cast ArrayList to DynamicArrayList to access the underlying array, as DynamicArrayList has a public Array property).
Hopefully, this gives you an idea on how to prove your contracts with Pex. It should be a good starting point for your ArrayList tests.

A: PexObserve.Verify(isCorrect) is usually used for asserting properties of the returned value or other properties that depend on the input parameters. This is not suitable to verify contract properties in this scenario.
For verifying the properties of a data structure (like ArrayList), you usually use tests with the assumption under test. In your tests, you assume a particular state of the data structure, carry out some operation (like adding an item), and then verify certain properties hold after that operation. Something like,

[PexMethod]
public void MyTestMethod([PexAssumeUnderTest]ArrayList list, int item){
--------------------	    // This was auto-generated by Pex. It helps to ensure the test passes
	    Debug.Assert((New_Ret == -1 && Old_arrListCount != -1) || (New_Ret != -1 && Old_arrListCount != -1));

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >=0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListLastIndexOfIndex = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsIndex = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfIndex = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsIndex = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_index", Old_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_index", New_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_index", Old_arrListContainsIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_index", New_arrListContainsIndex);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the new size is greater than old size, old list size is not -1
	    // This was auto-generated by Pex. It helps to ensure the test passes
	    Debug.Assert(New_arrListCount > Old_arrListCount && !(Old_arrListCount == -1));

        }
    }
}
"@




$null = New-Item -ItemType Directory -Force -Path "$($scriptPath)\TestResults"

$testResultDir = "$($scriptPath)\TestResults"




$output = $Contract + $ContractTest
$output | Set-Content ("$($scriptPath)\ArrayList.TestMethods.cs")

Add-Content -Path ("$($scriptPath)\ArrayList.TestMethods.cs") -Value "`n`n[TestFixture]"
Add-Content -Path ("$($scriptPath)\ArrayList.TestMethods.cs") -Value "[PexClass(ActionEnum.QuickState, MaxUninitializedObjects = 10)]"

Add-Content -Path ("$($scriptPath)\ArrayList.TestMethods.cs") -Value @"
public partial class ArrayList_TestMethods_Contract
{
    [PexMethod]
    public void Add_Method([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(true);
        
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = IsTrueTestMethods.IndexOf(arrList, x);
        int Old_arrListLastIndexOfX = IsTrueTestMethods.LastIndexOf(arrList, x);
        bool Old_arrListContainsX = IsTrueTestMethods.Contains(arrList, x);
        
        int New_Ret = arrList.Add(x);
        
        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = IsTrueTestMethods.IndexOf(arrList, x);
        int New_arrListLastIndexOfX = IsTrueTestMethods.LastIndexOf(arrList, x);
        bool New_arrListContainsX = IsTrueTestMethods.Contains(arrList, x);

        IsTrueTestMethods.Test(Old_arrListCount <= New_arrListCount);
        
        IsTrueTestMethods.Test--------------------            Debug.Assert(New_Ret == -1 ? Old_arrListCount != -1 : true);

        }
    }
}

//CS-Tests/Test/ArrayListTest.cs
using System;
using ArrayList;
using NUnit.Framework;

[TestFixture]
public class ArrayListTest
{
    [Test]
    public void TestConstructor()
    {
	ArrayList al = new ArrayList();
	// The only way to check if the constructor actually worked is to check if it doesn't throw an exception.
	Assert.True(true);
    }

    [Test]
    public void TestAdd()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	Assert.AreEqual(al.Count, 1);
	Assert.AreEqual(al.Get(0), 2);
    }

    [Test]
    public void TestRemove()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	al.Remove(2);
	Assert.AreEqual(al.Count, 0);
    }

    [Test]
    public void TestInsert()
    {
	ArrayList al = new ArrayList();
	al.Insert(0, 2);
	Assert.AreEqual(al.Count, 1);
	Assert.AreEqual(al.Get(0), 2);
    }

    [Test]
    public void TestSet()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	al.Set(0, 3);
	Assert.AreEqual(al.Get(0), 3);
    }

    [Test]
    public void TestGet()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	Assert.AreEqual(al.Get(0), 2);
    }

    [Test]
    public void TestContains()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	Assert.True(al.Contains(2));
	Assert.False(al.Contains(3));
    }

    [Test]
    public void TestIndexOf()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	Assert.AreEqual(al.IndexOf(2), 0);
	Assert.AreEqual(al.IndexOf(3), -1);
    }

    [Test]
    public void TestLastIndexOf()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	al.Add(2);
	Assert.AreEqual(al.LastIndexOf(2), 1);
	Assert.AreEqual(al.LastIndexOf(3), -1);
    }

    [Test]
    public void TestAddRange()
    {
	ArrayList al1 = new ArrayList();
	ArrayList al2 = new ArrayList();
	al2.Add(2);
	al2.Add(3);
	al1.AddRange(al2);
	Assert.AreEqual(al1.Count, 2);
	Assert.AreEqual(al1.Get(0), 2);
	Assert.AreEqual(al1.Get(1), 3);
    }

    [Test]
    public void TestRemoveRange()
    {
	ArrayList al = new ArrayList();
	al.Add(2);
	al.Add(3);
	al.Add(4);
	ArrayList al2 = new ArrayList();
	al2.Add(2);
	al2.Add(4);
	al.RemoveRange(0, al2.Count);
	Assert.AreEqual(al.Count, 0);
    }
}

