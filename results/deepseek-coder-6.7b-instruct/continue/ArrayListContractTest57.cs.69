using System.Globalization;

public class Program
{
    public static void Main()
    {
        // 1. 变量声明
        int a = 1;
        float b = 2.2f;
        double c = 3.3;
        char d = 'A';
        string e = "Hello";

        Console.WriteLine($"a = {a} b = {b} c = {c} d = {d} e = {e}");

        // 2. 输出整数和浮点数的科学计数法
        double f = 123456.789;
        Console.WriteLine(f.ToString("G17", CultureInfo.CurrentCulture));

        // 3. 输出科学计数法
        float g = 0.00000078f;
        Console.WriteLine(g.ToString("G17", CultureInfo.CurrentCulture));

        // 4. 输入并输出
        Console.Write("Please enter your name: ");
        string name = Console.ReadLine();
        Console.WriteLine($"Hello, {name}!");
        
        // 5. 求和
        Console.Write("Please enter two numbers: ");
        a = int.Parse(Console.ReadLine());
        b = float.Parse(Console.ReadLine());
        Console.WriteLine($"The sum is: {a + b}");

        // 6. 使用BigInteger类型进行大数运算
        BigInteger h = BigInteger.Parse("123456789012345678901234567890");
        BigInteger i = BigInteger.Parse("987654321098765432109876543210");
        Console.WriteLine($"The product of h and i is: {BigInteger.Multiply(h, i)}");

        // 7. 使用变量进行数学运算
        a = 5;
        b = 3.5f;
        Console.WriteLine($"a + b = {a + (int)b}");
        Console.WriteLine($"a * b = {a * (int)b}");
        Console.WriteLine($"a / b = {(float)a / b}");

        // 8. 使用三元运算符
        int j = 10;
        Console.WriteLine(j > 0 ? "j is a positive number" : "j is not a positive number");

        // 9. 使用字--------------------