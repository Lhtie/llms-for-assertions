using System.Collections;
using ArrayList.Test;
using ArrayList;
using Microsoft.Pex.Framework;

namespace TestCases
{
    [TestFixture]
    public partial class ArrayListContractTest : IListContractTest
    {
        //  The instance of IList
        private IList myList;

        //  Initializes the IList instance using the created ArrayList
        [TestFixtureSetUp]
        public void Init()
        {
            ArrayList arrList = new ArrayList();
            myList = arrList;
        }

        //  Gets the instance of IList
        [PexMethod]
        public IList GetTheList()
        {
            return myList;
        }

        //  Add method of the IList
        [PexMethod]
        public void Add([PexAssumeUnderTest]IList list, object x)
        {
            list.Add(x);
        }

        //  Remove method of the IList
        [PexMethod]
        public void Remove([PexAssumeUnderTest]IList list, object x)
        {
            list.Remove(x);
        }

        //  Index of method of the IList
        [PexMethod]
        public int IndexOf([PexAssumeUnderTest]IList list, object x)
        {
            return list.IndexOf(x);
        }
