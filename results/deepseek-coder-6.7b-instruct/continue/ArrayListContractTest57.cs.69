//src/CodeContracts/ArrayList.Test/ArrayListPropertyTests.cs
﻿using System;
using Microsoft.Pex.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListPropertyTests
    {
        [TestMethod]
        [PropertyBasedTest]
        [MaxOut(MaxOut.All, 10)]
        public void CountProperty([NoAutoConversion]ArrayList arrList)
        {
            int initialCount = arrList.Count;
            for (int i = 0; i < initialCount; i++)
            {
                arrList.RemoveAt(0);
            }
            Microsoft.Pex.Framework.Assert.AreEqual<int>(initialCount, arrList.Count);

            for (int i = 0; i < initialCount; i++)
            {
                arrList.Add(i);
            }
            Microsoft.Pex.Framework.Assert.AreEqual<int>(initialCount * 2, arrList.Count);
        }
    }

}

