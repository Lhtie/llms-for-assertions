using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Audio;

public class AudioManager : MonoSingleton<AudioManager>
{
    public List<AudioSource> audioSourceList;

    public AudioMixer audioMixer;

    public void PlaySound(AudioClip clip)
    {
        //check if there are any available audiosource not playing
        for (int i = 0; i < audioSourceList.Count; i++)
        {
            if (!audioSourceList[i].isPlaying)
            {
                audioSourceList[i].clip = clip;
                audioSourceList[i].Play();
                return;
            }
        }
        //if not found, create a new one and play it
        AudioSource newAudio = gameObject.AddComponent<AudioSource>();
        newAudio.clip = clip;
        newAudio.Play();
        audioSourceList.Add(newAudio);
    }

    private void Update()
    {
        UpdateAudioSettings();
    }

    private void UpdateAudioSettings()
    {
        if (SettingsManager.Instance != null)
        {
            audioMixer.SetFloat("MasterVolume", Mathf.Log10(SettingsManager.Instance.audioSetting.masterVolume) * 20);
            audioMixer.SetFloat("MusicVolume", Mathf.Log10(SettingsManager.Instance.audioSetting.musicVolume) * 20);
            audioMixer.SetFloat("SFXVolume", Mathf.Log10(SettingsManager.Instance.audioSetting--------------------	    int IndexBefore = Old_arrListIndexOfX;
