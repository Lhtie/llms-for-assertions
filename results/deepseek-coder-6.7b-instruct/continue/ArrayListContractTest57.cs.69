namespace PexAPIWrapper
{
    public class ArrayList
    {
        public int Count { set; get; }

        public int Add(int x)
        {
            return this.Count++;
        }

        public bool Contains(int x)
        {
            return this.IndexOf(x) != -1;
        }

        public int IndexOf(int x)
        {
            return 0;
        }

        public int LastIndexOf(int x)
        {
            return 0;
        }

        public void Remove(int x)
        {
            this.Count--;
        }

        public void Insert(int index, int x)
        {
            
        }

        public int this[int index]
        {
            set { }
            get { return 0; }
        }

    }
}

//Tutorial - Writing Equivalence Classes/ArithmeticExercise/ArithmeticExercise.Test/ArithmeticContractTest.cs
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;

namespace ArithmeticExercise.Test
{
    [TestFixture]
    [PexClass(typeof(ArithmeticExercise.Arithmetic))]
    public partial class ArithmeticContractTest
    {
        [PexMethod]
        public void TestAdd([PexAssumeUnderTest] ArithmeticExercise.Arithmetic target,
                            int x,
                            int y)
        {
            int result = target.Add(x, y);

            Assert.AreEqual(x + y, result);
        }

        [PexMethod]
        public void TestSubtract([PexAssumeUnderTest] ArithmeticExercise.Arithmetic target,
                                 int x,
                                 int y)
        {
            int result = target.Subtract(x, y);

            Assert.AreEqual(x - y, result);
        }

        [PexMethod]
        public void TestMultiply([PexAssumeUnderTest] ArithmeticExercise.Arithmetic target,
                                 int x,
                                 int y)
        {
            int result = target.Multiply(x, y);

            Assert.AreEqual(x * y, result);
        }

        [PexMethod]
        public void TestDivide([PexAssumeUnderTest] ArithmeticExercise.Arithmetic target,
                               int x,
                               int y)
        {
            AssumePrecondition.IsTrue(y != 0); // No division by zero

            int result = target.Divide(x, y);

            Assert.AreEqual(x / y, result);
        }
    }
}

