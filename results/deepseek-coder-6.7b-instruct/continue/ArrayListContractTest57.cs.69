And the original code
using System;
using System.Collections;
using System.Text;

namespace ArrayList
{

    public class ArrayList
    {
        int[] array;
        int nElem;
        int size;

        public ArrayList()
        {
            array = new int[100];
            size = 100;
            nElem = 0;
        }

        public int Add(int item)
        {
        
            if (nElem == size)
            {
                Enlarge();
            }
            array[nElem] = item;
            nElem++;

            return nElem - 1;
        }

        private void Enlarge()
        {
            int newSize = size * 2;
            int[] newArray = new int[newSize];
            for (int i = 0; i < size; i++)
            {
                newArray[i] = array[i];
            }
            array = newArray;
            size = newSize;
        }

        public bool Remove(int item)
        {
            int index = IndexOf(item);
            if (index == -1)
                return false;
            RemoveAt(index);
            return true;
        }

        public void RemoveAt(int index)
        {

            CheckIndex(index);

            for (int i = index; i < nElem - 1; i++)
            {
                array[i] = array[i + 1];
            }
            nElem--;
        }

        private void CheckIndex(int index)
        {
            if (index < 0 || index >= nElem)
                throw new IndexOutOfRangeException();
        }

        public bool Contains(int item)
        {
            return IndexOf(item) != -1;
        }

        public int IndexOf(int item)
        {
            for (int i = 0; i < nElem; i++)
            {
                if (array[i] == item)
                {
                    return i;
                }
            }
            return -1;
        }

        public int LastIndexOf(int item)
        {
            for (int i = nElem - 1; i >= 0; i--)
            {
                if (array[i] == item)
                {
                    return i;
                }
            }
            return -1;
        }

        public void Clear()
        {
            nElem = 0;
        }

        public int this[int index]
        {
            get
            {
                CheckIndex(index);
                return array[index];
            }
            set
            {
                CheckIndex(index);
                array[index] = value;
            }
        }

        public int Count
        {
            get
            {
                return nElem;
            }
        }

    }
}

Thanks in advance for your help

A: I found the problem. In Pex, the IndexOf method may return -1, which might not be a good input for the property you want to verify. Also, there is no need to test the index, because when the property is requested, it always gives the current count. Hence the test case in the first place was redundant. So, you can just leave the test case about IndexOf while the property is Count, which already guarantees the property value to be within 0 and nElem-1.
Also, since Count is getting monotonically increase when Add method is invoked, you can leave the test about Count as well.
Finally, please also add these assertions in your tests:
Assert.IsFalse(arrList.IndexOf(x) < Old_arrListIndexOfX);
Assert.IsFalse(arrList.Contains(x) && !Old_arrListContainsX);
I hope this helps.
Edit: In addition to these, you can also do:
public void PUT_RemoveAllElement([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count>0);

            int Old_arrListCount = arrList.Count;

            for (int i = Old_arrListCount-1; i >=0 ; i--)
            {
                arrList.Remove--------------------	    if (New_Ret)
	    {
	        Assert.IsTrue((Old_arrListIndexOfX <= New_arrListIndexOfX) && (New_arrListIndexOfX <= Old_arrListLastIndexOfX), "If the return value is true, index of x before is less than or equal to after");
	    }
            
        }
    }
}

