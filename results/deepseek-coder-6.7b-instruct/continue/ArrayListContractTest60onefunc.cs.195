        private TipoCon--------------------	    // and index of x in new arrList <= last index of x in new arrList. In other case, if the return value is true index of x in old arrList equals last index of x in new arrList and the counts of arrList are increased
	    if((Old_arrListIndexOfX == New_arrListIndexOfX) || (Old_arrListLastIndexOfX == New_arrListLastIndexOfX)) {
	        Debug.Assert((Old_arrListCount <= New_arrListCount) && (New_arrListIndexOfX <= New_arrListLastIndexOfX));
