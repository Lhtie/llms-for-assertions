//Test/TestUtil/ArrayList/ArrayListContractTest.Remove.cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentOutOfRangeException))]
        [PexExpectedException(typeof(InvalidOperationException))]
        [PexExpectedException(typeof(NotSupportedException))]
        [PexArgumentSource(nameof(removeOutOfArrayRange))]
        public void Remove([PexAssumeUnderTest]ArrayList arrList, [PexArgType(typeof(int))]int index)
        {
            AssumePrecondition.IsNotNull(arrList);
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            arrList.Remove(index);
        }

        public IEnumerable<int> removeOutOfArrayRange([PexAssumeUnderTest]ArrayList arrList)
        {
            yield return -1;
            yield return arrList.Count;
            yield return arrList.Count + 1;
        }
    }
}

//Test/TestUtil/ArrayList/ArrayListContractTest.RemoveAt.cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentOutOfRangeException))]
        [PexExpectedException(typeof(InvalidOperationException))]
        [PexExpectedException(typeof(NotSupportedException))]
        public void RemoveAt([PexAssumeUnderTest]ArrayList arrList, [PexArgType(typeof(int))]int index)
        {
            AssumePrecondition.IsNotNull(arrList);
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            arrList.RemoveAt(index);
        }
    }
}

//Test/TestUtil/ArrayList/ArrayListContractTest.RemoveRange.cs


namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        [PexExpectedException(typeof(ArgumentOutOfRangeException))]
        [PexExpectedException(typeof(ArgumentException))]
        [PexExpectedException(typeof(InvalidOperationException))]
        [PexExpectedException(typeof(NotSupportedException))]
        [PexArgumentSource(nameof(removeRangeOutOfRange))]
        public void RemoveRange([PexAssumeUnderTest]ArrayList arrList, [PexArgType(typeof(int))]int index, [PexArgType(typeof(int))]int count)
        {
            AssumePrecondition.IsNotNull(arrList);
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);
            AssumePrecondition.IsTrue(count >= 0 && index + count <= arrList.Count);

            arrList.RemoveRange(index, count);
        }

        public IEnumerable<int> removeRangeOutOfRange([PexAssumeUnderTest]ArrayList arrList, int count)
        {
            yield return -1;
            yield return arrList.Count;
            yield return arrList.Count + count;
            yield return 0;
            yield return count;
        }
    }
}

//Test/TestUtil/ArrayList/ArrayListContractTest.SequenceEqual.--------------------             Assert.IsTrue(  ! New_Ret || Old_arrListLastIndexOfX <= New_arrListIndexOfX   )  ;
	     // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, count of old arrList is equal to count of new arrList 
             Assert.IsTrue(  ! New_Ret || Old_arrListCount == New_arrListCount   )  ;
	    // an assertion using "Assert.AreEqual\(.*?\);" that  @@@ If the Return value is true, IndexOf returns same value as last index of x in old arrList
             Assert.IsTrue( New_Ret && New_arrListIndexOfX == Old_arrListLastIndexOfX );
	    // another assertion using "Assert.AreEqual\(.*?\);" that  @@@ If the return value is true, LastIndexOf returns same value as IndexOf of x in new arrList
             Assert.IsTrue( New_Ret && New_arrListLastIndexOfX == New_arrListIndexOfX );
	    // another assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, Count of new list is greater and equal to old list count
             Assert.IsTrue( New_Ret && New_arrListCount >= Old_arrListCount );
        }
    }
}//AutoContractPexTestProjects/ArrayList/Test/AddContractTest.cs
﻿using System.Collections;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$x", x);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);

            // Add should always increase the count of ArrayList.
	    Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);
            
            // After adding x, it should be in the list.
	    Assert.IsTrue(New_arrListIndexOfX>=0 && New_arrListLastIndexOfX>=0);

	    // Assert.AreEqual should be true at least one of these conditions should be met 
            Assert.IsTrue(New_arrListIndexOfX == New_arrListLastIndexOfX);

	    // And if New_arrList_Count is greater than old_arrList_Count, New_arrList_LastIndexOf_X should be equal to old_arrList_Count 
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1 && New_arrListLastIndexOfX == Old_arrListCount);
        }
    }
}

//AutoContractPexTestProjects/Program.cs
﻿using ArrayList.Test;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System;

namespace AutoContractPexTestProjects
{
    class Program
    {
        /// <summary>
        /// The main entry point for the application.
        /// </summary>
        [STAThread]
        static void Main(string[] args)
        {
            var tests = new ArrayListContractTest();
            tests.PUT_AddContract(null, 5);
        }
    }
}
;using System;

namespace DIO.bank 
