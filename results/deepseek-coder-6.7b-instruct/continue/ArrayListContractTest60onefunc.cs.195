//Tests/ArrayList.Test/Tests/PexTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using Test;

namespace ArrayList.Test
{
    [TestClass]
    public class PexTest
    {
        [PexMethod]
        public void AddToArrayList(ArrayList inputList)
        {
            inputList.Add(default(int));

            Assert.IsNotNull(inputList);
        }

        [PexMethod]
        public void RemoveFromArrayList(ArrayList inputList)
        {
            inputList.Remove(default(int));

            Assert.IsNotNull(inputList);
        }

        [PexMethod]
        [PexExplorationBoundary(10, 10)]
        public void TestBoundary(int size)
        {
            ArrayList list = new ArrayList();
            for (int i = 0; i < size; i++)
            {
                list.Add(i);
            }

            Assert.AreEqual(size, list.Count);
        }
    } 
}

