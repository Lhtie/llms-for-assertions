using System;
using System.Diagnostics;
using System.Runtime.Serialization;

namespace Microsoft.Pex.Framework
{
    [Serializable]
    public class MethodRunsToCompletionException : Exception
    {
        public MethodRunsToCompletionException() { }
        public MethodRunsToCompletionException(string message) : base(message) { }
        public MethodRunsToCompletionException(string message, Exception inner) : base(message, inner) { }
        protected MethodRunsToCompletionException(SerializationInfo info, StreamingContext context) : base(info, context) { }
    }
}

