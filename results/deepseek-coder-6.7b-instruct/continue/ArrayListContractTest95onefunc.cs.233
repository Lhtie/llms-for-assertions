//TestProject1/TestProject1/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Instrumentation;
using System;
using System.Diagnostics;
using System.Collections;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest(nameof(ArrayList.LastIndexOf))]
    public class ArrayListContractTest
    {
        // The input to the LastIndexOf method is a ArrayList and an arbitrary object x
        [PexMethod(Action = PexMethodAction.None, ExcludePaths = new string[] { "x" })]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, [PexArbitrary("typeof(int)")]int x)
        {
            AssumePrecondition.IsFalse(arrList is null);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            int New_Ret = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is non-negative, index of x in new array is >= 0 
            Debug.Assert(New_Ret >= 0);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is non-negative, x is in new array  
            Debug.Assert(New_Ret < arrList.Count && arrList[New_Ret].Equals(x));

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If x has already existed in the ArrayList, LastIndexOf(x) will return number which is <= original count
            Debug.Assert(Old_arrListIndexOfX >= 0 && New_Ret <= Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If x has been removed from the ArrayList, LastIndexOf(x) will return -1
            Debug.Assert(New_Ret == -1 || arrList[New_Ret].Equals(x));
        }
    }
}

//TestProject1/TestProject1/ContractTest1.cs
﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Instrumentation;

namespace ArrayList.Test
{
     [PexClass(typeof(ArrayList))]
     [PexMethodUnderTest(nameof(ArrayList.LastIndexOf))]
     public class ContractTest1
     {
         [PexMethod(Action = PexMethodAction.None, ExcludePaths = new string[] { "x" } )]
         public void PUT_LastIndexOfContract([PexAssumeUnderTest] ArrayList arrList, [PexArbitrary("typeof(int)")] int x)
         {--------------------            if (Old_arrListContainsX == true) // Only if item exists in array
            {
                Console.WriteLine("IF: {0} -> {1}", Old_x, Old_arrListIndexOfX);
                Assert.IsTrue(New_Ret >= Old_arrListIndexOfX, "New LastIndex should be >= Old Index.");
            }

            // an assertion using "Debug.Assert\(.*?\);" that @@@  If the return value is negative, then the new array doesn't contain x
            if (Old_arrListContainsX == false) // Only if item does not exist in array
            {
                Assert.AreEqual(-1, New_Ret, "Item was added and not found. Return should be -1.");
                Assert.IsFalse(New_arrListContainsX, "Item was added and not found in array.");
            }

            // and finally another assertion using "Debug.Assert\(.*?\);" that @@@ Every time a new element is added to the array, its count increases by 1
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "New array count should increase every time a new element is added.");
        }
    }
}

//ArrayList.Test/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.InvalidOperationException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.IndexOutOfRangeException", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.Collections.ArrayList", typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.OverflowException", typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void AddAndRemoveTest([PexTyped]ArrayList arrList)
        {
            arrList.Add(1);
            arrList.Add(2);

            AssumePrecondition.IsTrue(arrList.Count == 0, "Array list must be empty.");
            Assert.AreEqual(arrList.Count, 0, "After adding 2 elements, count should be 0.");

            arrList.Remove(1);
            Assert.AreEqual(arrList.Count, 0, "After removing a non-existent element, count should stay 0.");
        }
    }
}

//ArrayList.Test/ArrayListEdgeCaseTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListEdgeCaseTest
    {
        [PexMethod]
        public void CapacityEdgeCaseTest([PexTyped]ArrayList arrList)
        {
            AssumePrecondition.IsFalse(arrList.IsReadOnly, "ArrayList must be read/write");
            AssumePrecondition.IsTrue(arrList.Capacity >= 0, "Capacity can't be less than 0");

            // The capacity property of the ArrayList must increase as we add more 
            // items until it hits the MaxCapacity
            const int maxCapacity = int.MaxValue;
            int oldCapacity = arrList.Capacity;

            for (int i = 0; i < maxCapacity; i++)
            {
                arrList.Add(i);

                PexObserve.ValueForViewing("Capacity after add " + i, arrList.Capacity);

                if (arrList.Capacity > oldCapacity)
                {
                    oldCapacity = arrList.Capacity;
                }
            }

            int difference = (arrList.Capacity - oldCapacity) % maxCapacity;

            Assert.IsTrue(difference == 0, "The capacity of the ArrayList increased by more than it should have done");
        }
    }
}

