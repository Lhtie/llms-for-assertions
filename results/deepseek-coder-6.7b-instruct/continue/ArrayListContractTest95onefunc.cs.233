}namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_AddRangeContract([PexAssumeUnderTest] ArrayList arrList1, [PexAssumeUnderTest] ArrayList arrList2)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrList1Count = arrList1.Count;
            int Old_arrList2Count = arrList2.Count;
            bool Old_arrList1ContainsSecond = arrList1.Count.ForAll(c => !arrList2.Contains(c));

            arrList1.AddRange(arrList2);

            int New_arrList1Count = arrList1.Count;
            int New_arrList2Count = arrList2.Count;
            bool New_arrList1ContainsSecond = arrList1.Count.ForAll(c => !arrList2.Contains(c));

            PexObserve.ValueForViewing("$old_arrList1_Count", Old_arrList1Count);
            PexObserve.ValueForViewing("$old_arrList2_Count", Old_arrList2Count);
            PexObserve.ValueForViewing("$new_arrList1_Count", New_arrList1Count);
            PexObserve.ValueForViewing("$new_arrList2_Count", New_arrList2Count);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ The count of arrList1 after addition of arrList2 is greater than count of arrList1 before addition
            Debug.Assert(New_arrList1Count > Old_arrList1Count);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ The elements in the arrList2 are not in the arrlist1 after addition
            Debug.Assert(New_arrList1ContainsSecond);
        }
    }
}using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_EnsureCapacityContract([PexAssumeUnderTest] ArrayList arrList, int capacity)
        {
            AssumePrecondition.IsTrue(capacity >= 0 );

            int Old_arrListCount = arrList.Count;
            int Old_arrListCapacity = arrList.Capacity;

            arrList.EnsureCapacity(capacity);

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = arrList.Capacity;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ The Capacity of ArrayList after ensuring given capacity is greater than or equal to the given capacity.
            Debug.Assert(New_arrListCapacity >= capacity);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the count of ArrayList after ensuring the capacity is not zero, the capacity should be greater than the old capacity
            Debug.Assert((New_arrListCount != 0) == (New_arrListCapacity > Old_arrListCapacity));
        }
    }
