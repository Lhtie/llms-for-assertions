using System;
using System.Collections.Generic;
using System.Text;

namespace PUC
{
    public class StdIOAction : Action
    {
        private Console.IOStreams ioStream;
        public StdIOAction(Console.IOStreams ioStream)
        {
            this.ioStream = ioStream;
        }
        public override void run(string[] parameters)
        {
            String operation = parameters[0];
            if (operation.Equals("write"))
            {
                string text = parameters[1];
                this.ioStream.write(text);
            }
            else if (operation.Equals("read"))
            {
                this.ioStream.read();
            }
            else
            {
                throw new PUCException("Unknown IO operation " + operation);
            }
        }
    }
}


