            if (New_Ret >= 0)
            {
                Debug.Assert(arrList.IndexOf(x) >= 0);
            }

            // an assertion using "Debug.Assert\(.*?\);" that new array count must be >= old array count
            Debug.Assert(arrList.Count >= Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" all instances of x in old array are also in new array
            if (Old_arrListContainsX)
            {
                Debug.Assert(New_arrListContainsX);
            }
        }
    }
}

