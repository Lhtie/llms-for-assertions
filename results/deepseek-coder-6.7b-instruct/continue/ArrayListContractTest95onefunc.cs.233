namespace ArrayList.Test
{
    [TestClass]
    public partial class ArrayListPropertyTest
    {
        [PexMethod]
        public void ArrayList_PropertyTest([PexAssumeValid]ArrayList arrList)
        {

            PexObserve.ValueForViewing("CountBeforeAdd", arrList.Count, "List Count Before Add");

            int countBeforeAdd = arrList.Count;

            int itemToAdd = 5;
            arrList.Add(itemToAdd);

            //[PexAssumeValid]
            Assert.AreEqual(countBeforeAdd + 1, arrList.Count);

            int countBeforeRemove = arrList.Count;

            arrList.Remove(itemToAdd);

            //[PexAssumeValid]
            Assert.AreEqual(countBeforeRemove - 1, arrList.Count);

            //[PexAssumeValid]
            Assert.IsTrue(arrList.Contains(itemToAdd));

            //[PexAssumeValid]
            Assert.IsFalse(arrList.Contains(42));

            //[PexAssumeValid]
            Assert.IsTrue(arrList.Count > 0 && arrList.Count <= 10);

        }
    }
}

