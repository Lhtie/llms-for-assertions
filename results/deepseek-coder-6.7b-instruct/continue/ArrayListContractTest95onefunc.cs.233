//ArrayList.CoverageTest/Test.cs
﻿using NUnit.Framework;
using System.Collections;
using ArrayListNamespace;

namespace ArrayList.CoverageTest
{
    [TestFixture]
    public class Test
    {
        ArrayList arrList;

        [SetUp]
        public void SetUp()
        {
            arrList = new ArrayList();  
        }

        [Test]
        public void TestCase1()
        {
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            Assert.AreEqual(arrList.Count, 3);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsTrue(arrList.Contains(3));
        }

        [Test]
        public void TestCase2()
        {
            int index = arrList.Add(10);
            Assert.AreEqual(index, 0);
            Assert.IsTrue(arrList.Contains(10));

            index = arrList.Add(20);
            Assert.AreEqual(index, 1);
            Assert.IsTrue(arrList.Contains(20));

            index = arrList.Add(30);
            Assert.AreEqual(index, 2);
            Assert.IsTrue(arrList.Contains(30));

            arrList.Remove(10);
            Assert.IsFalse(arrList.Contains(10));
        }

        [Test]
        public void TestCase3()
        {
            arrList.Add("first");
            arrList.Add("second");
            arrList.Add("third");
            Assert.AreEqual(arrList.IndexOf("second"), 1);
            Assert.AreEqual(arrList.LastIndexOf("second"), 1);
        }

        [Test]
        public void TestCase4()
        {
            arrList.Add(50);
            arrList.Add(40);
            arrList.Add(30);
            arrList.Add(20);
            arrList.Add(10);
            Assert.AreEqual(arrList.BinarySearch(30), 2);
        }
    }
}

