    assert any(account.money >= amnt for account in frm.accounts), 'Not enough money on accounts'
--------------------    assert any([acct.money >= amnt for acct in frm.accounts]), "No sufficient money for the transfer."
--------------------    assert(any([acc.money >= amnt for acc in frm.accounts])), \
           "Insufficient funds in '%s' account(s)" % sum(acc.money < amnt for acc in frm.accounts)

    # an assertion that the sum of the funds on all accounts of the "frm" persons is larger than the transferred amount
    assert (sum([acc.money for acc in frm.accounts]) >= amnt), \
--------------------    assert any([acc.money >= amnt for acc in frm.accounts]), "insufficient funds"
--------------------    assert any(acc.money >= amnt for acc in frm.accounts), f"None of {frm.name}'s accounts have enough money"
--------------------    # if it's false, an assertion error will be raised
    assert any(frm_acc.money >= amnt for frm_acc in frm.accounts), f"Not enough money in {frm.name}'s accounts"
--------------------    assert any(acc.money > amnt for acc in frm.accounts), \
--------------------    assert any(acc.money > amnt for acc in frm.accounts), f"Not enough money in {frm.name}'s accounts"
--------------------    assert any([acct.money >= amnt for acct in frm.accounts]), "insufficient funds!"
