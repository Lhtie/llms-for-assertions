//Tests/ArrayListContractTest/TrimToSizeContract.cs
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void TrimToSizeContract([PexAssumeUnderTest]ArrayList arrList)
        {

            int Old_arrListCount = arrList.Count;

            arrList.TrimToSize();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion using "Assert.AreEqual\(.*?\);" that  @@@ The count of the array list after the method call should be same as the count of original array list.
	    Assert.AreEqual(Old_arrListCount, New_arrListCount);
            
        }
    }
}

//Tests/ArrayListTest/AddTest.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;

namespace ArrayList.Test.ArrayListTest
{
    [TestClass]
    public class AddTest : BaseTest
    {
        [TestMethod]
        public void Add_FirstElement()
        {
            var list = GetArrayList();
            var originalCount = list.Count;
            var element = "test string";

            list.Add(element);

            Assert.AreEqual(originalCount + 1, list.Count);
            Assert.AreEqual(element, list[originalCount]);
        }

        [TestMethod]
        public void Add_MultipleElements()
        {
            var list = GetArrayList();
            var originalCount = list.Count;
            var elements = new object[] { "first", "second", "third" };

            foreach (var element in elements)
            {
                list.Add(element);
            }

            Assert.AreEqual(originalCount + elements.Length, list.Count);
            foreach (var element in elements)
            {
                Assert.IsTrue(list.Contains(element));
            }
        }

        private static IList GetArrayList()
        {
            return new ArrayList();
        }
    }
}

//Tests/ArrayListTest/BaseTest.cs
using System.Collections;

namespace ArrayList.Test.ArrayListTest
{
    public abstract class BaseTest
    {
        protected static IList GetArrayList()
        {
            return new ArrayList();
        }
    }
}

