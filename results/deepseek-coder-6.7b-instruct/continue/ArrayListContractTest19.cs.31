//TodoRestApi/Controllers/TodoController.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Web.Http;
using TodoRestApi.Models;

namespace TodoRestApi.Controllers
{
    public class TodoController : ApiController
    {
        todoModelContainer db = new todoModelContainer();

        //Get All Data
        public IEnumerable<Todo> Get()
        {
            return db.TodoItems.ToList();
        }

        //Get Data By Id
        public IHttpActionResult Get(int id)
        {
            var todo = db.TodoItems.Find(id);

            if (todo == null)
            {
                return NotFound();
            }

            return Ok(todo);
        }

        //Add new data to the context
        public IHttpActionResult Post(Todo todo)
        {
            if (!ModelState.IsValid)
                return BadRequest("Invalid data.");

            db.TodoItems.Add(todo);
            db.SaveChanges();

            return Ok(todo);
        }

        //update data
        public IHttpActionResult Put(Todo todo)
        {
            if (!ModelState.IsValid)
                return BadRequest("Invalid Data.");

            var existingTodo = db.TodoItems.Where(t => t.Id == todo.Id).FirstOrDefault();

            if (existingTodo != null)
            {
                existingTodo.Name = todo.Name;
                db.SaveChanges();
            }
            else
            {
                return NotFound();
            }

            return Ok(todo);
        }

        //delete data
        public IHttpActionResult Delete(int id)
        {
            var todo = db.TodoItems.Find(id);

            if (todo == null)
            {
                return NotFound();
            }

            db.TodoItems.Remove(todo);
            db.SaveChanges();

            return Ok(todo);
        }
    }
}

