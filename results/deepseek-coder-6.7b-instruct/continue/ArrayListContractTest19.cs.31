public class Boss_ScriptVictor : MonoBehaviour
{
    // Declare variables
    public float health = 100f;
    public float attack = 25f;
    public float defense = 20f;
    public float speed = .5f;
    public Rigidbody2D rb;
    public bool isInRange = false;
    GameObject Player;
    float PlayerXPosition;
    void Start()
    {
        //get reference to the player
        Player = GameObject.FindWithTag ("Player");
    }

    void Update()
    {
        if (isInRange)
        {
            EnemyMovement();
        }

    }

    //when any collider touches the boss collider
    void OnTriggerEnter2D(Collider2D other)
    {
        //if the other object has the player tag
        if (other.gameObject.tag == "Player")
        {
            isInRange = true;
        }
    }

    void OnTriggerExit2D(Collider2D other)
    {
        if (other.gameObject.tag == "Player")
        {
            isInRange = false;
        }
    }

    void EnemyMovement ()
    {
        PlayerXPosition = Player.transform.position.x;
        if (PlayerXPosition > transform.position.x) {
            transform.Translate(speed, 0f, 0f); //Boss moves right while still facing right
        }
        else 
        {
            transform.Translate(-speed, 0f, 0f); //Boss moves left while still facing left
        }
    }
