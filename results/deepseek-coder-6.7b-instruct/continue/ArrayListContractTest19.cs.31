	{
		static void Main(string[] args)
		{
			ArrayList arrList = new ArrayList();
			
			Console.WriteLine("Adding some elements...");
			arrList.Add(100);
			arrList.Add(200);
			arrList.Add(300);

			arrList.Print();

			Console.WriteLine("Removing the first occurrence of 200...");
			arrList.Remove(200);

			arrList.Print();
			
			Console.WriteLine("Inserting 400 at index 1...");
			arrList.Insert(1, 400);
			
			arrList.Print();

			Console.WriteLine("Press any key to exit...");
			Console.ReadKey();
		}
	}
