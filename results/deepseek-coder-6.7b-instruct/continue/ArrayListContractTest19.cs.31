namespace lab2_ex1
{
    class Program
    {

        static int[] InputArray(string s)
        {
            Console.Write(s);
            string[] strArray = Console.ReadLine().Split();
            int[] array = new int[strArray.Length];
            for (int i = 0; i < strArray.Length; ++i)
            {
                array[i] = int.Parse(strArray[i]);
            }
            return array;
        }

        static void Swap(ref int a, ref int b)
        {
            int temp = a;
            a = b;
            b = temp;
        }

        static void SortArray(int[] array, int from, int to, int n)
        {
            if (from == to)
            {
                return;
            }

            int pivot = array[to];
            int i = from;
            for (int j = from; j <= to - 1; ++j)
            {
                if (array[j] <= pivot)
                {
                    Swap(ref array[i], ref array[j]);
                    ++i;
                }
            }
            Swap(ref array[i], ref array[to]);

            Console.WriteLine($"Iter: {n},  Pivot: {pivot}, Array: {string.Join(" ", array)}");
            
            if (i > from + 1)
            {
                SortArray(array, from, i - 1, ++n);
            }
            if (to > i + 1)
            {
                SortArray(array, i + 1, to, ++n);
            }
        }

        static void Main(string[] args)
        {
            int[] array = InputArray("Enter array: ");
            SortArray(array, 0, array.Length - 1, 1);
        }
    }
