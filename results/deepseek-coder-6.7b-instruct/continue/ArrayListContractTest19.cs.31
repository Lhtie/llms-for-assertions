}//Testing/Source/MyStack/MyStack.cs
using System;
using System.Collections.Generic;

namespace MyStack
{
    public class Stack<T>
    {
        private List<T> elements;

        public Stack()
        {
            this.elements = new List<T>();
        }

        public void Push(T item)
        {
            this.elements.Add(item);
        }

        public T Pop()
        {
            if (this.elements.Count == 0) 
            {
                throw new InvalidOperationException("The stack is empty");
            }

            T item = this.elements[this.elements.Count - 1];
            this.elements.RemoveAt(this.elements.Count - 1);

            return item;
        }

        public bool IsEmpty()
        {
            return this.elements.Count == 0;
        }
    }
}

//Testing/Source/MyStack.Tests/StackTest.cs
using MyStack;
using NUnit.Framework;

public class StackTest
{
    [Test]
    public void NewStack_IsEmpty()
    {
        Stack<int> s = new Stack<int>();
        Assert.IsTrue(s.IsEmpty());
    }

    [Test]
    public void Stack_PushOneItem_ItemIsNotEmpty()
    {
        Stack<int> s = new Stack<int>();
        Assert.IsTrue(s.IsEmpty());
        s.Push(12);
        Assert.IsFalse(s.IsEmpty());
    }

    [Test]
    public void Stack_PushPopItem_ItemMatches()
    {
        Stack<string> s = new Stack<string>();
        s.Push("Hello");
        Assert.AreEqual("Hello", s.Pop());
    }

    [Test, ExpectedException(typeof(InvalidOperationException))]
    public void Stack_PopEmptyStack_ThrowsException()
    {
        Stack<int> s = new Stack<int>();
        s.Pop();
    }

    [Test]
    public void Stack_PushTwoItems_PopItemsInExpectedOrder()
    {
        Stack<int> s = new Stack<int>();
        s.Push(10);
        s.Push(20);

        Assert.AreEqual(20, s.Pop());
        Assert.AreEqual(10, s.Pop());
    }
}using System;

class MainClass {
  static Random rnd = new Random();

  static int Main(string[] args) {
    int n = rnd.Next(10) + 1;
    long factorial = 1;
    for(int i = 1; i <= n; i++) {
      factorial *= i;
    }

    Console.WriteLine($"{n} の階乗は {factorial} です。");

    return 0;
  }
