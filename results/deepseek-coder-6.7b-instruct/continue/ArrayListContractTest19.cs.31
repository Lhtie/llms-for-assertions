public class Inventory : MonoBehaviour
{

    #region InventorySlots
    public class InventorySlot : MonoBehaviour
    {
        public GameObject item;
        public int amount;
        public int maxStack;
    }
    #endregion

    private List<InventorySlot> inventorySlots = new List<InventorySlot>();
    public Transform inventoryPanel;
    public GameObject inventorySlotPrefab;

    public void Start()
    {
        AddItem(null, 5);
        AddItem(null, 8);
        AddItem(null, 7);
        AddItem(null, 6);
        AddItem(null, 9);
        AddItem(null, 4);
    }

    public void AddItem(GameObject itemPrefab, int amount)
    {
        //Check if there is already a stack of this item in our inventory
        foreach (InventorySlot slot in inventorySlots)
        {
            if (slot.item == itemPrefab)
            {
                //There is a stack in the inventory -> check if there is room
                if (slot.amount + amount <= slot.maxStack)
                {
                    //There is room in this stack -> increase the amount
                    slot.amount += amount;
                    return;
                }
            }
        }

        //There is no stack in the inventory or there is no room in the stack
        //-> create a new stack
        GameObject newSlotObject = Instantiate(inventorySlotPrefab, inventoryPanel);
        InventorySlot newSlot = newSlotObject.GetComponent<InventorySlot>();
        newSlot.item = itemPrefab;
