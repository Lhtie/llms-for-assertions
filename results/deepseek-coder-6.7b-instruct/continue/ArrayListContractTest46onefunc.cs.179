using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;

namespace PexDemo.Test
{
    public partial class StackContractTest
    {
        [PexMethod]
        public void PUSH_StackContractTest([PexAssumeUnderTest]Stack stk, int valueToPush)
        {
            int Old_StackCount = stk.Count;

            stk.Push(valueToPush);

            int New_StackCount = stk.Count;
            int New_Peek = (int)(stk.Peek());
            bool New_Conatins = stk.Contains(valueToPush);

            PexObserve.ValueForViewing("$old_stack_count", Old_StackCount);
            PexObserve.ValueForViewing("$new_stack_count", New_StackCount);
            PexObserve.ValueForViewing("$value_to_push", valueToPush);
            PexObserve.ValueForViewing("$new_peek", New_Peek);
            PexObserve.ValueForViewing("$new_contains", New_Conatins);

            Assert.AreEqual(Old_StackCount + 1, New_StackCount);
            Assert.AreEqual(valueToPush, New_Peek);
            Assert.IsTrue(New_Conatins);
        }

        [PexMethod]
        public void POP_StackContractTest([PexAssumeUnderTest]Stack stk)
        {
            int Old_StackCount = stk.Count;

            int Pop_Value = (int)(stk.Pop());

            int New_StackCount = stk.Count;
            bool New_Conatins = !stk.Contains(Pop_Value);

            Assert.AreEqual(Old_StackCount - 1, New_StackCount);
            Assert.IsTrue(New_Conatins);
        }
    }
}

