
            // an assertion using Assert.AreEqual(@@, arrList.Count, @@); where @@ indicates either the previous values or newly added values

            // an assertion using Assert.IsTrue(@@); where @@ indicates the element value exists in the updated ArrayList or not. 
        }
    }
}

