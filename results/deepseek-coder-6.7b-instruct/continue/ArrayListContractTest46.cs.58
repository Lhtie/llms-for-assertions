    {
        [PexMethod]
        public void PushShouldIncreaseStackCount(Stack stack, object item)
        {
            AssumePrecondition.IsTrue(stack.Count >= 0);
            int oldCount = stack.Count;
            stack.Push(item);
            PexAssert.AreEqual(oldCount + 1, stack.Count);
        }

        [PexMethod]
        public void PopNotEmptyStackShouldReduceCount(Stack stack)
        {
            AssumePrecondition.IsTrue(stack.Count > 0);
            int oldCount = stack.Count;
            object item = stack.Pop();
            PexAssert.AreEqual(oldCount - 1, stack.Count);
        }

        [PexMethod]
        public void PopNotEmptyStackShouldReturnTopElement(Stack stack)
        {
            AssumePrecondition.IsTrue(stack.Count > 0);
            object topElement = stack.Peek();
            object poppedElement = stack.Pop();
            PexAssert.AreEqual(topElement, poppedElement);
        }--------------------	    AssumePrecondition.OuterLoop(index >= 0);


