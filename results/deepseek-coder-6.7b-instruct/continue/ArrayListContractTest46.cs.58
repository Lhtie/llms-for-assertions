using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListTests
    {
        // A test to ensure the count of ArrayList is correctly updated after adding an element
        [PexMethod]
        public void AddShouldIncrementCount(ArrayList list, int value)
        {
            AssumePrecondition.IsTrue(list.Count >= 0);
            int oldCount = list.Count;
            list.Add(value);
            PexAssert.AreEqual(oldCount + 1, list.Count);
        }

        // A test to ensure ArrayList is not throwing any error when adding an element at a specified index
        [PexMethod]
        public void AddAtIndexShouldNotThrowError(ArrayList list, int value, int index)
        {
            AssumePrecondition.IsTrue(index >=0 && index <= list.Count);
            PexAssert.DoesNotThrow(() => list.Insert(index, value));
        }

        // Ensuring that inserting an element at a specific index shifts the element at that index and subsequent elements to the right
        [PexMethod]
        public void InsertShouldShiftElements(ArrayList list, int value, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= list.Count);
            AssumePrecondition.IsTrue(list.Count > 0);

            //Inserting the value at the index
            list.Insert(index, value);
            
            //Iterating through the list from the index to the end
            for (int i = index; i < list.Count; i++)
            {
                //Checking if the value is at the current index
                PexAssert.AreEqual(value, list[i]);
            }
        }
    }
}

