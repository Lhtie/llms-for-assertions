namespace TapTap.Shared {
    public static class Enums {
        public enum ServerType {
            Main,
            Fallback
        }
        public enum ServerStatus {
            Online,
            Offline
        }
    }

    public static class EnumExtensions {
        public static string GetDescription<T>(this T enumeration) where T : struct {
            if (!typeof(T).IsEnum) throw new ArgumentException("EnumerationValue must be of Enum type");
            FieldInfo f = enumeration.GetType().GetField(enumeration.ToString());
            var attributes = (DescriptionAttribute[])f.GetCustomAttributes(typeof(DescriptionAttribute), false);
            return attributes.Length > 0 ? attributes[0].Description : enumeration.ToString();
        }
    }
