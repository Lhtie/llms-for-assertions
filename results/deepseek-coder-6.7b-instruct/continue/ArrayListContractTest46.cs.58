	    // an invariant that "arrList[index] == New_Ret"
	    // and that "arrList should contain New_Ret after a get operation"
	    // need to be added in order to verify the contract.		
        }
    }
}

//CSharp/ArrayList/ArrayList/Test/ArrayListTest.cs
﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [TestCase(0)]
        [TestCase(1)]
        [TestCase(2)]
        [TestCase(10)]
        public void Test_AddingNumbers_ArrayList(int numbersToAdd)
        {
            ArrayList arrList = new ArrayList();

            Random rnd = new Random();
            for (int i = 0; i < numbersToAdd; i++)
            {
                arrList.Add(rnd.Next(int.MinValue, int.MaxValue));
            }

            Assert.AreEqual(numbersToAdd, arrList.Count);

            for (int i = 0; i < numbersToAdd; i++)
            {
                Assert.IsTrue(arrList.Contains(arrList[i]));

                int index = arrList.IndexOf(arrList[i]);
                Assert.AreEqual(i, index);

                arrList.Remove(arrList[i]);
                Assert.AreEqual(numbersToAdd - i - 1, arrList.Count);
                Assert.IsFalse(arrList.Contains(arrList[i]));

                arrList.Add(arrList[i]);
                Assert.AreEqual(numbersToAdd - i, arrList.Count);
            }
        }

        [Test]
        [TestCase(0)]
        [TestCase(1)]
        [TestCase(2)]
        [TestCase(10)]
        public void Test_InsertingNumbers_ArrayList(int numbersToInsert)
        {
            ArrayList arrList = new ArrayList();

            Random rnd = new Random();
            for (int i = 0; i < numbersToInsert; i++)
            {
                arrList.Insert(0, rnd.Next(int.MinValue, int.MaxValue));
                Assert.AreEqual(i + 1, arrList.Count);
            }

            for (int i = 0; i < numbersToInsert; i++)
            {
                Assert.IsTrue(arrList.Contains(arrList[i]));

                int index = arrList.IndexOf(arrList[i]);
                Assert.AreEqual(i, index);

                arrList.RemoveAt(0);
                Assert.AreEqual(numbersToInsert - i - 1, arrList.Count);
                Assert.IsFalse(arrList.Contains(arrList[i]));
            }
        }

        [Test]
        public void Test_OutOfRange_IndexOfAndRemoveAt_ArrayList()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);

            Assert.Throws<ArgumentOutOfRangeException>(() => arrList.IndexOf(2));
            Assert.Throws<ArgumentOutOfRangeException>(() => arrList.RemoveAt(1));
        }

        [Test]
        public void Test_LastIndexOfAndRemove_ArrayList()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(2);

            int lastIndexOf2 = arrList.LastIndexOf(2);
            Assert.AreEqual(2, lastIndexOf2);

            int removeIndexOf2 = arrList.Remove(2);
            Assert.AreEqual(1, removeIndexOf2);
            Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(0, arrList.IndexOf(2));
            Assert.AreEqual(1, arrList.LastIndexOf(2));
        }
    }
}

