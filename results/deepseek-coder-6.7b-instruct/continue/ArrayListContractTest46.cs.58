    public partial class ArrayListTest
    {
        private int Add_Test_Item1 = 1;
        private int Add_Test_Item2 = 1000;
        
        [PexMethod]
        public void Test_Add_Two_Objects_And_Verify_Count_Increased_By_One()
        {
            ArrayList arrList = new ArrayList();
            
            AssumePrecondition.IsTrue(true);

            int initCount = arrList.Count;
            
            arrList.Add(Add_Test_Item1);
            arrList.Add(Add_Test_Item2);

            int finalCount = arrList.Count;

            Assert.AreEqual(initCount + 2, finalCount, "Count property did not increment as expected");
        }
    }
}

//MyArrayList/MyArrayList.cs
﻿using System;
using System.Collections;

namespace MyArrayList
{
    public class MyArrayList : IEnumerable
    {
        private const int InitialCapacity = 4;
        private object[] array;
        public int Count { get; private set; }
        public int Capacity { get; private set; }

        public MyArrayList()
        {
            array = new object[InitialCapacity];
            Capacity = InitialCapacity;
            Count = 0;
        }

        public void Add(object obj)
        {
            if (Count == Capacity)
            {
                Capacity *= 2;
                object[] newArray = new object[Capacity];
                Array.Copy(array, newArray, Count);
                array = newArray;
            }

            array[Count] = obj;
            Count++;
        }

        public bool Remove(object obj)
        {
            for (int i = 0; i < Count; i++)
            {
                if (array[i].Equals(obj))
                {
                    return RemoveAt(i);
                }
            }

            return false;
        }

        public bool RemoveAt(int index)
        {
            if ((uint)index >= (uint)Count)
            {
                throw new IndexOutOfRangeException();
            }

            for (int i = index; i < Count - 1; i++)
            {
                array[i] = array[i + 1];
            }

            Count--;
            return true;
        }

        public object this[int index]
        {
            get
            {
                if ((uint)index >= (uint)Count)
                {
                    throw new IndexOutOfRangeException();
                }

                return array[index];
            }

            set
            {
                if ((uint)index >= (uint)Count--------------------	    Debug.Assert(New_Ret==arrList[index]);	

        }

