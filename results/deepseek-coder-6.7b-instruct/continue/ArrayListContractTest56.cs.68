﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
		[Test]
		public void TestAdd()
		{
			ArrayList arrList = new ArrayList();
			Assert.IsTrue(arrList.Add(1) == 0);
			Assert.IsTrue(arrList.Add(2) == 1);
		}

		[Test]
		public void TestRemove()
		{
			ArrayList arrList = new ArrayList();
			arrList.Add(1);
            Assert.IsTrue(arrList.Remove(1) == 1);
		}

        [Test]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Insert(0,2);
            Assert.IsTrue((int)arrList[0] == 2);
        }

        [Test]
        public void TestGet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.IsTrue((int)arrList[0] == 1);

        }
        [Test]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.IsTrue(arrList.Contains(1));
        }

        [Test]
        public void TestClear()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Clear();
            Assert.IsTrue(arrList.Count == 0);
        }

        [Test]
        public void TestRemoveAt()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.RemoveAt(0);
            Assert.IsTrue(arrList.Count == 1);
        }
    }


}

