//test/ArrayList.Test/RemoveNullItemsTest.cs
﻿using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public class RemoveNullItemsTest
    {
        [Test]
        public void RemoveNullObjectsTest()
        {
            ArrayList l = new ArrayList();
            // Populate l with 5 null objects;
            for (int i = 0; i < 5; i++)
            {
                l.Add(null);
            }

            // Before: 5 null objects
            Assert.AreEqual(5, l.Count);

            l.RemoveAll(delegate(object obj) { return obj == null; });

            // After: No null items, 0 count
            Assert.AreEqual(0, l.Count);
        }

        [Test]
        public void RemoveNonNullObjectTest()
        {
            ArrayList l = new ArrayList();
            // Populate l with 5 non-null objects
            for (int i = 0; i < 5; i++)
            {
                l.Add(new object());
            }

            // Before: 5 non-null objects
            Assert.AreEqual(5, l.Count);

            l.RemoveAll(delegate(object obj) { return obj != null; });

            // After: No non-null items, 0 count
            Assert.AreEqual(0, l.Count);
        }

        [Test]
        public void RemoveNullObjectsAndKeepNonNullTest()
        {
            ArrayList l = new ArrayList();
            // Populate l with 5 non-null objects and 5 null objects
            for (int i = 0; i < 5; i++)
            {
                l.Add(null);
                l.Add(new object());
            }

            // Before: 10 items with 5 null and 5 non-null
            Assert.AreEqual(10, l.Count);
            Assert.AreEqual(5, l.FindAll(delegate(object obj) { return obj == null; }).Count);
            Assert.AreEqual(5, l.FindAll(delegate(object obj) { return obj != null; }).Count);

            l.RemoveAll(delegate(object obj) { return obj == null; });

            // After: All items are non-null
            Assert.AreEqual(5, l.Count);
            Assert.AreEqual(0, l.FindAll(delegate(object obj) { return obj == null; }).Count);
            Assert.AreEqual(5, l.FindAll(delegate(object obj) { return obj != null; }).Count);
        }
    }
}

