//Tests/ArrayList.Test/ArrayList/ArrayListContractTest/RemoveContract.cs
 using Microsoft.Pex.Framework;
 using Microsoft.Pex.Framework.Rules;
 using System;
 using System.Collections;
 using ArrayList.Test;
 using System.Linq;

 namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeValid]ArrayList arrList, int oldArrListCount, [PexAllowNull]object x, [PexAssumeValid]ArrayList oldArrayList)
        {
            AssumePrecondition.IsTrue(oldArrListCount == arrList.Count);             AssumePrecondition.IsTrue(oldArrayList.Count == arrList.Count);             AssumePrecondition.IsTrue(oldArrayList.Contains(x));

            int Old_arrListCountBeforeRemove = arrList.Count;
            int Old_oldArrayListCountBeforeRemove = oldArrayList.Count;
            int Old_indexX = oldArrayList.IndexOf(x);

            oldArrayList.Remove(x); arrList.Remove(x);

            int New_arrListCountAfterRemove = arrList.Count;
            int New_oldArrayListCountAfterRemove = oldArrayList.Count;
            int New_indexX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count_Before_Remove", Old_arrListCountBeforeRemove);  PexObserve.ValueForViewing("$New_arrList_Count_After_Remove", New_arrListCountAfterRemove);
            PexObserve.ValueForViewing("$old_oldArrayList_Count_Before_Remove", Old_oldArrayListCountBeforeRemove);  PexObserve.ValueForViewing("$New_oldArrayList_Count_After_Remove", New_oldArrayListCountAfterRemove);
            PexObserve.ValueForViewing("$old_index_of_X_before", Old_indexX);  PexObserve.ValueForViewing("$new_index_of_X", New_indexX);

            Assert.Equal(New_arrListCountAfterRemove, New_oldArrayListCountAfterRemove); Assert.NotEqual(New_arrListCountAfterRemove, Old_arrListCountBeforeRemove);             Assert.True(New_indexX == -1 ||  (New_indexX >= Old_indexX && New_indexX-Old_indexX == 1) || (New_indexX <= Old_indexX && Old_indexX-New_indexX == 1), "Index of 'x' after Remove should be -1 or equal or 1 than before Remove");
        }
    }
}

