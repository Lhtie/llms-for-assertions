	    Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);
        }
    }
}

//test/Microsoft.Pex.Framework/Framework.Test/ContractTesting/List/ArrayList/ArrayListTest/ArrayListContractTest.cs
using ArrayList.Test;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.Pex.Framework;
using System;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest : PexClass<ArrayList>
    {
        [PexMethod]
        [PexExplorationEnabled]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, index of x in old array is less than or equal to that in new array
	    Debug.Assert((Old_arrListCount != 0) ? (Old_arrListIndexOfX <= New_arrListIndexOfX && New_arrListIndexOfX < Old_arrListCount) : New_arrListIndexOfX == 0);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If return value of contains method in new array is true  @@@, then, index of x in new array is less than or equal to count of new array
	    Debug.Assert(New_Ret ? (New_arrListIndexOfX <= New_arrListCount && New_arrListLastIndexOfX <= New_arrListCount) : true);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ For any List<T>, index of x is -1 if it is not contained in old List<T>; otherwise, index of x is equal to that in new array
	    Debug.Assert(New_arrListIndexOfX ==--------------------            AssertForTest(Old_arrListIndexOfX <= New_arrListIndexOfX || Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);			
        }
    }
}
```
When you run this test, QuickCheck will find a counterexample: an 'ArrayList' that initially includes the element 'x' at some index, but after 'x' is added again, it ends up not being present where it was initially. The counterexample thus demonstrates the lack of proper array resizing behavior.

In conclusion, QuickCheck can be a very handy tool for identifying and fixing bugs in your program. However, there are certain scenarios where it may not work perfectly. In such situations, manual exploratory testing may be needed, as QuickCheck might not be able to find a counterexample. In this case, be prepared with a robust testing strategy, taking the multiple perspectives of the data and programming logic into consideration.

*Thanks to [Dan](https://www.linkedin.com/in/ddubey/) for the review.*

