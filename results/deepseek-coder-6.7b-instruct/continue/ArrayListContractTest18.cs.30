namespace UserRegistration
{
    public class StoredProcedures
    {
        public static void InsertUserInformation(string firstName, string lastName, string middleInitial, string email, string contactNo, string birthDate, string street, string city, string state, string zip)
        {
            using (SqlConnection connection = new SqlConnection(Properties.Settings.Default.connStr))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand("proc_UserInformationInsert", connection))
                {
                    command.CommandType = CommandType.StoredProcedure;

                    var firstNameParameter = new SqlParameter("FirstName", SqlDbType.NVarChar);
                    firstNameParameter.Value = firstName;
                    command.Parameters.Add(firstNameParameter);

                    var lastNameParameter = new SqlParameter("LastName", SqlDbType.NVarChar);
                    lastNameParameter.Value = lastName;
                    command.Parameters.Add(lastNameParameter);

                    var middleInitialParameter = new SqlParameter("MiddleInitial", SqlDbType.NVarChar);
                    middleInitialParameter.Value = middleInitial;
                    command.Parameters.Add(middleInitialParameter);

                    var emailParameter = new SqlParameter("Email", SqlDbType.NVarChar);
                    emailParameter.Value = email;
                    command.Parameters.Add(emailParameter);

                    var contactNoParameter = new SqlParameter("ContactNo", SqlDbType.NVarChar);
                    contactNoParameter.Value = contactNo;
                    command.Parameters.Add(contactNoParameter);

                    var birthDateParameter = new SqlParameter("BirthDate", SqlDbType.Date);
                    birthDateParameter.Value = Convert.ToDateTime(birthDate);
                    command.Parameters.Add(birthDateParameter);

                    var streetParameter = new SqlParameter("Street", SqlDbType.NVarChar);
                    streetParameter.Value = street;
                    command.Parameters.Add(streetParameter);

                    var cityParameter = new SqlParameter("City", SqlDbType.NVarChar);
                    cityParameter.Value = city;
                    command.Parameters.Add(cityParameter);

                    var stateParameter = new SqlParameter("State", SqlDbType.NVarChar);
                    stateParameter.Value = state;
                    command.Parameters.Add(stateParameter);

                    var zipParameter = new SqlParameter("Zip", SqlDbType.NVarChar);
                    zipParameter.Value = zip;
                    command.Parameters.Add(zipParameter);

                    command.ExecuteNonQuery();
                }
            }
        }
    }
