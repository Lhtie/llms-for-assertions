namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListPropertyTest
    {
        [Test]
		[Random(10)]
        public void Add_ShouldIncreaseCount([Random(5,10)]int count)
        {
            // Assuming
            ArrayList arrList = new ArrayList();        
            for (int i=0; i< count; i++)
                arrList.Add(i);    

            // Act and Assert        
            Assert.AreEqual(count, arrList.Count);        
        }   


    	[Test]
    	[Random(10)]
    	public void Add_AddANullItem_CountShouldBeIncreased([Random(5,10)] int count)
    	{
    		// Assuming
    		ArrayList arrList = new ArrayList();
    		for (int i = 0; i < count; i++)
    			arrList.Add(i);

    		// Act
    		arrList.Add(null);

    		// Assert
    		Assert.AreEqual(count+1, arrList.Count);

    	}


        [Test]
    	[Random(10)]
    	public void Remove_RemoveAnItem_CountShouldBeDecreased([Random(5,10)] int count)
    	{
    		// Assuming
    		ArrayList arrList = new ArrayList();
    		for (int i = 0; i < count; i++)
    			arrList.Add(i);

    		// Act
    		arrList.Remove(0);

    		// Assert
    		Assert.AreEqual(count-1, arrList.Count);

    	}        

        [Test]
    	[Random(10)]
    	public void Remove_RemoveAnItem_ArrayContainsDecreasedItemShouldReturnFalse([Random(5,10)] int count)
    	{
    		// Assuming
    		ArrayList arrList = new ArrayList();
    		for (int i = 0; i < count; i++)
    			arrList.Add(i);

    		// Act
    		arrList.Remove(0);

    		// Assert
    		Assert.IsFalse(arrList.Contains(0));
    	}        

        [Test]
        [Random(10)]
        public void Clear_ArrayHasNoItems_CountShouldBeZero([Random(5,10)] int count)
        {
            ArrayList arrList = new ArrayList();
            for (int i = 0; i < count; i++)
                arrList.Add(i);

            arrList.Clear();

            Assert.AreEqual(0, arrList.Count);
        }            
    }
}

