﻿using System;
using NUnit.Framework;
using Nashe;
using System.Collections.Generic;

namespace Nashe.Tests
{
    [TestFixture]
    public class NasheTest
    {
        [Test]
        public void TestFindSingleClosest()
        {
            List<NasheData> items = new List<NasheData>
            {
                new NasheData { Code = "AAA", Lattitude = 40.0, Longitude = -80.0},
                new NasheData { Code = "BBB", Lattitude = 38.0, Longitude = -78.0},
                new NasheData { Code = "CCC", Lattitude = 36.0, Longitude = -76.0},
                new NasheData { Code = "DDD", Lattitude = 34.0, Longitude = -74.0},
            };
                        
            double myLat = 37.380564;
            double myLong = -77.300076;

            NasheImpl im = new NasheImpl();
            var answer = im.FindClosest(myLat, myLong, items);
            Assert.AreEqual("BBB", answer.Code);
        }

        [Test]
        public void TestFindClosest()
        {
            List<NasheData> items = new List<NasheData>
            {
                new NasheData { Code = "AAA", Lattitude = 40.0, Longitude = -80.0},
                new NasheData { Code = "BBB", Lattitude = 38.0, Longitude = -78.0},
                new NasheData { Code = "CCC", Lattitude = 36.0, Longitude = -76.0},
                new NasheData { Code = "DDD", Lattitude = 34.0, Longitude = -74.0},
            };
            double myLat = 37.380564;
            double myLong = -77.300076;

            NasheImpl im = new NasheImpl();
            var answer = im.FindClosest(myLat, myLong, items, 2);
            Assert.AreEqual(2, answer.Count);
            Assert.IsTrue(answer[0].Code == "BBB" || answer[1].Code == "BBB");
            Assert.IsTrue(answer[0].Code == "CCC" || answer[1].Code == "CCC");
        }
        
        [Test]
        public void TestDistance()
        {
            NasheImpl n = new NasheImpl();

            double lat1 = 40.712776;
            double lon1 = -74.005974;

            double lat2 = 34.052235;
            double lon2 = -118.243683;

            double distance = n.DistanceTo(lat1, lon1, lat2, lon2);

            Assert.AreEqual(5887.06, Math.Round(distance, 2));
        }
    }
}

