using Microsoft.ServiceBus.Messaging;

namespace EventHubReceiver
{
    class Program
    {
        static void Main(string[] args)
        {
            string eventHubName = "Your_Event_Hub_Name";
            string connectionString = "azure_event_hub_connection_string";
            
            EventHubClient client = EventHubClient.CreateFromConnectionString(connectionString, eventHubName);

            var d2cPartitions = client.GetRuntimeInformation().PartitionIds;

            Console.WriteLine("Receiving messages from Event Hub '{0}'", eventHubName);
            foreach (string partition in d2cPartitions)
            {
                ReceiveMessagesFromDeviceAsync(client, partition).Wait();
            }
            
            Console.WriteLine("Press any key to exit ...");
            Console.ReadLine();
            client.Close();
        }

        static async Task ReceiveMessagesFromDeviceAsync(EventHubClient client, string partition)
        {
            string offset = DateTime.UtcNow.ToString();

            EventHubReceiver receiver = client.GetDefaultConsumerGroup().CreateReceiver(partition, offset);

            Console.WriteLine("Creating receiver on partition {0}", partition);

            while (true)
            {
                EventData eventData = await receiver.ReceiveAsync();

                if (eventData == null) continue;

                string data = Encoding.UTF8.GetString(eventData.GetBytes());

                Console.WriteLine("Message received on partition {0}:", partition);
                Console.WriteLine("Data: '{0}'", data);
                Console.WriteLine("MessageId: '{0}'", eventData.MessageId);

                offset = eventData.Offset;
            }
        }
    }
