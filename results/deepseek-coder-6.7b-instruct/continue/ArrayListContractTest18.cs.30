    {
        private ArrayList arrayList;

        public ArrayListAPI()
        {
            arrayList = new ArrayList();
        }

        public void Add(object item)
        {
            arrayList.Add(item);
        }
        
        public void Remove(object item)
        {
            arrayList.Remove(item);
        }
   
        public int Count
        {
            get { return arrayList.Count; }
        }
        
        public int IndexOf(object item)
        {
            return arrayList.IndexOf(item);
        }

        public bool Contains(object item)
        {
            return arrayList.Contains(item);
        }
        
        public int LastIndexOf(object item)
        {
            return arrayList.LastIndexOf(item);
        }
    }
}

Can anyone help in pointing me in the right direction or debugging the issue? Thanks in advance for your time and patience.

A: After struggling for a long time, I found the problem and I am sharing it so that anyone who might be facing the same issue will see this.
The problem was that while debugging the test cases, in Visual Studio 2012, the debugger doesn't allow you to watch "value" of variable. However when you run the test through the Pex launcher, it doesn't show the "Value" but only the "Name" of the variable. Hence, You can't see the actual value of the variable in the test result like Old_arrListCount, New_arrListCount etc.
So I decided to use Console.WriteLine for printing the value during the Pex running and checking, which helped me to see the actual value of the variables. And yes, the reason it is not showing any input or output is because of the issue in Visual Studio debugger rather than Pex itself but that is another concern. 
I tried running with Pex version 11.0.6072.1 as you suggested but still getting the same result.
Also, I am not sure whether this is the correct way of doing contract testing on ArrayList in Pex, as it is not showing any input or output while running the tests. 
But I hope this workaround will be helpful for some one who is facing similar issues.

A: Have you considered using Microsoft's Visual Studio 2012 "Contracts as Code" feature? It has built-in support for integration with Pex and can help you write and verify contracts for your code like yours. It's not exactly a drop-in replacement for contract testing but it can be a very helpful tool for managing and automating testing for complex invariants. Here is the link for more details: http://msdn.microsoft.com/en-us/library/hh487196.aspx
If you decide to use this tool, remember that there is a learning curve involved so you will also need to modify your code to work with the new contracts-based model.
Hope this helps you.
​

A: When using Pex, keep in mind that you can only test certain aspects of your code. In fact, Pex is designed to help you write unit tests for your code. In terms of contracts, if your contract assertions have been written in terms of invariants then they may not be checked through Pex.
Pex works through exploring the control-flow graph of your code and executing it. It can generate a lot of tests, but as a tool it is designed to be very specific about exactly what it tests and what it does not test for coverage purpose etc.
Contracts assert that certain conditions are met at runtime, and these invariants are not being tested through Pex. So Pex has limited ability to test contract-based assertions. 
It's also worth noting that the Pex team has announced end of support for Pex 2012. They recommend that users move to Visual Studio 2012 Contracts as Code which provides powerful Code Contracts capabilities.
As a general advice: Pex is good for unit testing, but you will probably need a combination of Pex/Contracts and other testing tools for full coverage. Your--------------------            Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX, "The last occurrence of 'value' in the current instance is greater than or equal to the last occurrence of 'value' in current List." );
        }

            [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion to check the count of an ArrayList is 0 after calling Clear()
            Assert.IsTrue(New_arrListCount == 0, "The count of ArrayList is not 0 after calling Clear.");
        }

            [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, int x)
        {

        }
    }
