    {
        public string HtmlContent { get; set; }
        public override void Initialize()
        {
            base.Initialize();
            InitializeControl();
        }

        protected virtual void InitializeControl()
        {
            if (string.IsNullOrWhiteSpace(this.HtmlContent))
            {
                this.HtmlContent = GetItemHtmlContent();
            }
        }

        protected virtual string GetItemHtmlContent()
        {
            try
            {
                var librariesManager = ObjectFactory.Resolve<IContentLifecycleManager>();
                var mediaItem = ItemProvider.GetItem<MediaItem>(ItemId.ToString());
                if (mediaItem != null)
                {
                    var html = librariesManager.GetContent(mediaItem);
                    if (!string.IsNullOrEmpty(html))
                        return html.Replace("\"", "'");
                }
            }
            catch (Exception)
            {
                //Do nothing.
            }
            return string.Empty;
        }
    }
