using System;
using System.Collections.Generic;
using System.Linq;
using Newtonsoft.Json.Linq;

[AttributeUsage(AttributeTargets.Class)]
public class PexGenerateRandomDataAttribute : Attribute
{
    private readonly int _maxNumberOfTests;
    private readonly List<JObject> _excludedData;

    public PexGenerateRandomDataAttribute(int maxNumberOfTests = 100)
    {
        _maxNumberOfTests = maxNumberOfTests;
        _excludedData = new List<JObject>();
    }

    public int MaxNumberOfTests { get { return _maxNumberOfTests; } }
    
    public List<JObject> ExcludedData { get { return _excludedData; } }

    public PexGenerateRandomDataAttribute WithExcludedData(params JObject[] excluded)
    {
        _excludedData.AddRange(excluded);
        return this;
    }
}

[AttributeUsage(AttributeTargets.Class)]
public class PexSettingsAttribute : Attribute
{
    private readonly bool _allowNullValues;
    private readonly int _maxBadExamples;
    private readonly int _maxGoodExamples;
    private readonly bool _generateTestsBehavior;

    public PexSettingsAttribute(bool allowNullValues = true, int maxBadExamples = 20, int maxGoodExamples = 100, bool generateTestsBehavior = true)
    {
        _allowNullValues = allowNullValues;
        _maxBadExamples = maxBadExamples;
        _maxGoodExamples = maxGoodExamples;
        _generateTestsBehavior = generateTestsBehavior;
    }

    public bool AllowNullValues { get { return _allowNullValues; } }

    public int MaxBadExamples { get { return _maxBadExamples; } }

    public int MaxGoodExamples { get { return _maxGoodExamples; } }

    public bool GenerateTestsBehavior { get { return _generateTestsBehavior; } }
}

[AttributeUsage(AttributeTargets.Method)]
public class PexMethodAttribute : Attribute
{
    private readonly bool _allowNullValues;
    private readonly int _maxBadExamples;
    private readonly int _maxGoodExamples;
    private readonly int _numOfGoodInputs;
    private readonly bool _generateTestsBehavior;

    public PexMethodAttribute(bool allowNullValues = true, int maxBadExamples = 20, int maxGoodExamples = 100, int numOfGoodInputs = 100, bool generateTestsBehavior = true)
    {
        _allowNullValues = allowNullValues;
        _maxBadExamples = maxBadExamples;
        _maxGoodExamples = maxGoodExamples;
        _numOfGoodInputs = numOfGoodInputs;
        _generateTestsBehavior = generateTestsBehavior;
    }

