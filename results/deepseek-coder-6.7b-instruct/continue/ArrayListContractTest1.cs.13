using Microsoft.VisualStudio.TestTools.UnitTesting;
using PexAPIWrapper;
using System.Diagnostics;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListTest
    {
        [TestMethod]
        public void AddElementToArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            int result = arrayList.AddElement(10);
            Assert.AreEqual(1, result);
        }

        [TestMethod]
        public void AddElementTwiceToArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            arrayList.AddElement(10);
            int result = arrayList.AddElement(20);
            Assert.AreEqual(2, result);
        }

        [TestMethod]
        public void RemoveElementFromArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            arrayList.AddElement(10);
            arrayList.AddElement(20);
            bool result = arrayList.RemoveElement(10);
            Assert.IsTrue(result);
        }

        [TestMethod]
        public void RemoveNonExistingElementFromArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            arrayList.AddElement(10);
            bool result = arrayList.RemoveElement(20);
            Assert.IsFalse(result);
        }

        [TestMethod]
        public void CheckElementExistanceInArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            arrayList.AddElement(10);
            bool result = arrayList.CheckElementExistance(10);
            Assert.IsTrue(result);
        }

        [TestMethod]
        public void CheckNonExistingElementExistanceInArrayList()
        {
            ArrayLists arrayList = new ArrayLists();
            arrayList.AddElement(10);
            bool result = arrayList.CheckElementExistance(20);
            Assert.IsFalse(result);
        }

    }
}

