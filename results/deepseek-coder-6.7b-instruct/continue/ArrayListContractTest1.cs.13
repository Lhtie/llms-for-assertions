	    Assert.IsTrue(New_arrListContainsX == true, $"The arrylist '{arrList}' does not contain element '{x}'");

	    // an assertion using "Debug.Assert\(.*?\);" that new array count is old array count plus one 
	    Assert.IsTrue(New_arrListCount == Old_arrListCount + 1, $"Invalid ArrayList count after addition of element '{x}' : expected {Old_arrListCount + 1} but got {New_arrListCount}");

	    // an assertion using "Debug.Assert\(.*?\);" index of x now should be same as lastindex of x
	    Assert.IsTrue(New_arrListIndexOfX == New_arrListLastIndexOfX, $"ArrayList '{arrList}' the index of '{x}' should be the same as last index of '{x}'");
        }

    }
}

