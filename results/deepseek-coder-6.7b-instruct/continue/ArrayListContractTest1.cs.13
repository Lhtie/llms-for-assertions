﻿using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void Add_Method_Test()
        {
            ArrayList arrList = new ArrayList();
            int actualResult = arrList.Add(56);
            Assert.AreEqual(0, actualResult);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(56, arrList.Get(0));
        }

        [Test]
        public void Remove_Method_Test()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(56);
            Assert.AreEqual(true, arrList.Remove(56));
            Assert.AreEqual(0, arrList.Count);
            Assert.AreEqual(false, arrList.Remove(56));
        }

        [Test]
        public void IndexOf_Method_Test()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(56);
            Assert.AreEqual(0, arrList.IndexOf(56));
            Assert.AreEqual(-1, arrList.IndexOf(92));
        }

        [Test]
        public void Contains_Method_Test()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(56);
            Assert.AreEqual(true, arrList.Contains(56));
            Assert.AreEqual(false, arrList.Contains(92));
        }
    }
