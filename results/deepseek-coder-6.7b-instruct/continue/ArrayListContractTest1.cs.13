}using System.Text.RegularExpressions;
using NUnit.Framework;

namespace StringExtensions.Tests
{
    public class StringExtensionsTests
    {
        [Test]
        public void TestToSnakeCase()
        {
            Assert.AreEqual("camel_case", "CamelCase".ToSnakeCase());
            Assert.AreEqual("camel_case_example", "CamelCaseExample".ToSnakeCase());

            Assert.AreEqual("hello_world", "HelloWorld".ToSnakeCase());
            Assert.AreEqual("test123", "Test123".ToSnakeCase());

            Assert.AreEqual("already_snake_case", "already_snake_case".ToSnakeCase());

            Assert.AreEqual("another_example_with_numbers_123", "AnotherExampleWithNumbers123".ToSnakeCase());
            
            Assert.AreEqual("_starting_with_underscore", "_StartingWithUnderscore".ToSnakeCase());
        }
        
        [Test]
        public void TestToCamelCase()
        {
            Assert.AreEqual("camelCase", "camel_case".ToCamelCase());
            Assert.AreEqual("camelCaseExample", "camel_case_example".ToCamelCase());

            Assert.AreEqual("helloWorld", "hello_world".ToCamelCase());
            Assert.AreEqual("test123", "test123".ToCamelCase());

            Assert.AreEqual("alreadyCamelCase", "alreadyCamelCase".ToCamelCase());

            Assert.AreEqual("anotherExampleWithNumbers123", "another_example_with_numbers_123".ToCamelCase());
            
            Assert.AreEqual("startingWithUnderscore", "_starting_with_underscore".ToCamelCase());
        }
    }
}using System;
using System.Linq;
using System.Text.RegularExpressions;

public static class StringExtensions
{
    public static string ToSnakeCase(this string str)
    {
        return string.Concat(str.Select((x, i) => i > 0 && char.IsUpper(x) ? "_" + x.ToString() : x.ToString())).ToLower();
    }

    public static string ToCamelCase(this string str)
    {
        string result = Regex.Replace(
            str, "([a-z])([A-Z])", "$1_$2").ToLower();

        if (str[0] == '_')
        {
            result = result.Substring(1);
        }

        return result;
    }
