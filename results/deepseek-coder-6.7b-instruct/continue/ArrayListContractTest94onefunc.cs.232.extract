		    // and either the return value does not equal "Old_arrListIndexOfX" or "Old_arrListIndexOfX" is negative, then the behavior of this method is undefined.
            if (New_Ret >= 0)
            {
                Debug.Assert((Old_arrListContainsX && ((New_Ret == Old_arrListIndexOfX) || Old_arrListIndexOfX < 0)) == false);
----------------------------------------	    // at index LastIndexOf(x), else x is not in the list @@@.
            int expected = Old_arrListContainsX ? Old_arrListIndexOfX : -1;
            AssumePrecondition.AreEqual(expected, New_Ret);

            Assert.AreEqual(expected, New_Ret);
        } 
    }
}

