﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Signed;
using System.Collections;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentOutOfRangeException", Severity = ExceptionSeverity.High)]
    [PexAllowedExceptionFromTypeUnderTest("System.ArgumentNullException", Severity = ExceptionSeverity.High)]
    [PexGenericType(typeof(IList), typeof(ArrayList))]
    [PexMethodUnderTest(nameof(ArrayList.IndexOf))]
    public partial class ArrayListContractTest
    {
        [PexMethodUnderTest(typeof(ArrayList), nameof(ArrayList.Add))]
        public void AddContract([PexAssumeUnderTest]ArrayList arrList, object value)
        {
            AssumePrecondition.IsTrue(arrList.Count <= IntMaxValue.Value);
            AssumePrecondition.IsNotNull(value);

            int oldCount = arrList.Count;

            arrList.Add(value);

            Debug.Assert(arrList.Count == oldCount + 1);
------------------------------------------------------------            // and the last occurrence of x in the old array list is at index [New_arrListIndexOfX], then the return value is the last occurrence of x in the old array list minus its count.
            Debug.Assert(Old_arrListContainsX && New_arrListContainsX  && New_arrListIndexOfX >=0 && arrList.IndexOf(x) >=0 );
--------------------	    // and the returned value is greater or equal to the old index of x
            Debug.Assert(

                (New_Ret < 0 ||
                Old_arrListContainsX &&
                New_Ret >= Old_arrListIndexOfX));
