//Test/TestData/Program.cs
﻿using System;
using ArrayList;

namespace Test
{
    class Program
    {
        static void Main(string[] args)
        {
            ArrayList arr = new ArrayList(); 
  
            arr.Add(10); 
            arr.Add(20); 
            arr.Add(30); 
  
            Console.Write("Initial List: "); 
            foreach (int i in arr)
                Console.Write(i + " "); 
  
            arr[2] = 100; 
  
            Console.Write("\nUpdated List after Set operation: "); 
            foreach (int i in arr)
                Console.Write(i + " "); 
  
            arr.Remove(20); 
  
            Console.Write("\nUpdated List after Remove 20 operation: "); 
            foreach (int i in arr)
                Console.Write(i + " "); 
  
            arr.Insert(2, 70); 
  
            Console.Write("\nUpdated List after Insert 70 at position 2: "); 
            foreach (int i in arr)
                Console.Write(i + " "); 

            Console.Write("\nElement at index 0 is: " + arr[0]);

            Console.Read(); 
        }
    }
}

//Test/UnitTest1.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace Test
{
    [TestClass]
    public class UnitTest1
    {
        [TestMethod]
        public void TestAdd()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            Assert.AreEqual(10, arr[0]);
        }

        [TestMethod]
        public void TestRemove()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            arr.Add(20);
            arr.Remove(10);
            Assert.AreEqual(0, arr.Count);
        }

        [TestMethod]
        public void TestInsert()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            arr.Insert(0, 20);
            Assert.AreEqual(20, arr[0]);
            Assert.AreEqual(2, arr.Count);
        }

        [TestMethod]
        public void TestSet()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            arr[0] = 20;
            Assert.AreEqual(20, arr[0]);
        }

        [TestMethod]
        public void TestGet()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            Assert.AreEqual(10, arr[0]);
        }

        [TestMethod]
        public void TestContains()
        {            
            ArrayList arr = new ArrayList();

            arr.Add(10);
            Assert.IsTrue(arr.Contains(10));
            Assert.IsFalse(arr.Contains(20));
        }
    }
}

//arrays/TestArrayList.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace Test
{
    [TestClass]
    public class TestArrayList
    {
        [TestMethod]
        public void TestAdd()
        {
            ArrayList arr = new ArrayList();

            arr.Add(10);
            Assert.AreEqual(10, arr[0]);
        }

        [TestMethod]
        public void TestRemove()
        {
            ArrayList arr = new ArrayList();

            arr--------------------
	    if (!New_Ret) {
		    AssumePrecondition.IsTrue(Old_arrListLastIndexOfX <= New_arrListIndexOfX); 
	       }

        }


        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
	    PexObserve.ValueForViewing("$New_ret", New_Ret);

            // If x was not found in the old arraylist, then the return value should be -1.
	    if (!arrList.Contains(x)) {
		AssumePrecondition.IsTrue(New_Ret == -1);
	    }
	    else {
	    	// Assert that if x is in the array, then the returned index is either the last index of x in the old array list (if it was in the list to begin with) or is less than that index (if it was added after the old last index)
		AssumePrecondition.IsTrue(New_Ret == Old_arrListLastIndexOfX || New_Ret < Old_arrListLastIndexOfX);
	    }
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_x);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_Ret);
            PexObserve.ValueForViewing("$new_arrList_Contains_x", New_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);

            if (!arrList.Contains(x)) {
		AssumePrecondition.IsTrue(New_Ret == -1);
            }
	    else {
		AssumePrecondition.IsTrue(New_Ret == arrList.Count - 1 || New_Ret > arrList.Count - 1);
	    }

          //Assert.IsTrue(New_Ret == Old_arrListLastIndexOfX || New_Ret <= Old_arrListLast--------------------		// This assertion is used to test if the 'Contains' method returns false and thus 'arrList' will not add 'x' before the test.
        }  
        

}
  }
}

//Exercise 5/PexTests/ListInterfaceTests.cs
﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using PexAPIWrapper;

namespace PexTests
{
    [TestFixture, PexClass]
    public partial class ListInterfaceTests
    {
        [PexMethod]
        public void Ensure_IndexOf_Returns_Correct_Results(SByte value1, SByte value2)
        {
            ArrayList myList = new ArrayList();

            myList.Add(value1);
            myList.Add(value2);

            AssumePrecondition.IsTrue(myList.Contains(value1));
            AssumePrecondition.IsTrue(myList.Contains(value2));

            SByte toFind = value1;
            int indexOfValue1 = myList.IndexOf(toFind);

            toFind = value2;
            int indexOfValue2 = myList.IndexOf(toFind);

            PexObserve.ValueForViewing("$indexOfValue1", indexOfValue1);
            PexObserve.ValueForViewing("$indexOfValue2", indexOfValue2);

            AssumePrecondition.AreEqual(0, indexOfValue1);
            AssumePrecondition.AreEqual(1, indexOfValue2);
        }

        [PexMethod]
        public void Ensure_Add_Increases_Count(SByte value1, SByte value2)
        {
            ArrayList myList = new ArrayList();

            myList.Add(value1);
            int countBeforeAdd = myList.Count;

            myList.Add(value2);
            int countAfterAdd = myList.Count;

            PexObserve.ValueForViewing("$countBeforeAdd", countBeforeAdd);
            PexObserve.ValueForViewing("$countAfterAdd", countAfterAdd);

            AssumePrecondition.AreEqual(countBeforeAdd, countAfterAdd - 1);
        }

        [PexMethod]
        public void Ensure_Remove_Decreases_Count(SByte value1, SByte value2)
        {
            ArrayList myList = new ArrayList();

            myList.Add(value1);
            myList.Add(value2);
            int countBeforeRemove = myList.Count;

            myList.Remove(value1);
            int countAfterRemove = myList.Count;

            PexObserve.ValueForViewing("$countBeforeRemove", countBeforeRemove);
            PexObserve.ValueForViewing("$countAfterRemove", countAfterRemove);

            AssumePrecondition.AreEqual(countBeforeRemove, countAfterRemove + 1);
        }
    }
}

