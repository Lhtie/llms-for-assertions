using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace EvaluatorTest
{
    public static class Helper
    {
        public static Exception GetInnerException(this Exception exception)
        {
            return exception.InnerException == null ? exception : exception.InnerException.GetInnerException();
        }
    }
}﻿using System;
using System.Collections.Generic;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using Microsoft.Pex.Framework.Variables;
using Microsoft.Pex.Common;

namespace StringBuilderTest
{
    [PexClass(typeof(StringBuilder))]
    public partial class StringBuilderContractTest
    {
        [PexMethod]
        public void PUT_ToStringContract([PexAssumeUnderTest]StringBuilder sb)
        {
            string tmp = sb.ToString();
            PexObserve.ValueForViewing("tempString", tmp);

            if (sb.Length < PexSettings.MaxStringLengthForReporting - tmp.Length)
            {
                PexObserve.ValueForViewing(tmp.Substring(0, sb.Length), sb.ToString());
            }
        }

        [PexMethod]
        public void PUT_AppendFormatContract([PexAssumeUnderTest]StringBuilder sb, string format, params object[] args)
        {
            int oldlength = sb.Length;
            sb.AppendFormat(format, args);
            AssumePrecondition.IsTrue(sb.Length >= oldlength);
            PexObserve.ValueForViewing("formatString", format);
            PexObserve.ValueForViewing("args:", args);
        }

        [PexMethod]
        public void PUT_AppendContract([PexAssumeUnderTest]StringBuilder sb, string value)
        {
            int oldlength = sb.Length;
            sb.Append(value);
            AssumePrecondition.IsTrue(sb.Length >= oldlength);
            PexObserve.ValueForViewing("value", value);
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]StringBuilder sb, int index, string value)
        {
            AssumePrecondition.IsTrue(index <= sb.Length);
            int oldlength = sb.Length;
            sb.Insert(index, value);
            AssumePrecondition.IsTrue(sb.Length >= oldlength);
            PexObserve.ValueForViewing("index", index);
            PexObserve.ValueForViewing("value", value);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]StringBuilder sb, int startIndex, int length)
        {
            AssumePrecondition.IsTrue(startIndex <= sb.Length && startIndex >= 0 && length <= sb.Length - startIndex);
            int oldlength = sb.Length;
            sb.Remove(startIndex, length);
            AssumePrecondition.IsTrue(sb.Length <= oldlength);
            PexObserve.ValueForViewing("startIndex", startIndex);
            PexObserve.ValueForViewing("length", length);
        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]StringBuilder sb)
        {
            int oldlength = sb.Length;
            sb.Clear();
            PexObserve.ValueForViewing("oldLength", oldlength);
            AssumePrecondition.IsTrue(sb.Length == 0);
        }
    }
