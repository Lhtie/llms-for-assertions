        public List<string[]> Read(Stream fileStream)
        {
            List<string[]> records = new List<string[]>();

            if (fileStream != null)
            {
                StreamReader reader = new StreamReader(fileStream);

                while (!reader.EndOfStream)
                {
                    string line = reader.ReadLine();
                    records.Add(line.Split(','));
