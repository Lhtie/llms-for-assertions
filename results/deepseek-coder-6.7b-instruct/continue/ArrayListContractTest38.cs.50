}﻿using System;
using System.Globalization;

namespace FlightPlanner
{
  class Program
  {
    static void Main(string[] args)
    {
      Console.WriteLine("Please enter the desired flight duration in minutes.");
      int duration = Int32.Parse(Console.ReadLine());
      Console.WriteLine("Please enter the maximum amount of fuel in gallons.");
      int maxFuel = Int32.Parse(Console.ReadLine());
      Console.WriteLine("Please enter the fuel consumption rate in miles per gallon (MPG).");
      double fuelConsumptionRate = Double.Parse(Console.ReadLine(), CultureInfo.InvariantCulture.NumberFormat);

      FlightPlanner fp = new FlightPlanner(duration, maxFuel, fuelConsumptionRate);
      fp.Initialize();

      double fuelRequired = fp.CalculateFuelRequired();
      Console.WriteLine("Flight plan:\n"
                        + "Flight duration: {0} minutes\n"
                        + "Maximum amount of fuel: {1} gallons\n"
                        + "Fuel consumption rate: {2} MPG\n"
                        + "Fuel required: {3} gallons", fp.Duration, fp.MaxFuel, fp.FuelConsumptionRate, fuelRequired);
    }
  }
}namespace FlightPlanner
{
	class FlightPlanner
	{
		public int Duration;
		public int MaxFuel;
		public double FuelConsumptionRate;

		public FlightPlanner (int duration, int maxFuel, double fuelConsumptionRate) {
			Duration = duration;
			MaxFuel = maxFuel;
			FuelConsumptionRate = fuelConsumptionRate;
		}

		public void Initialize () {
			Duration = 60;
			MaxFuel = 500;
			FuelConsumptionRate = 15.0;
		}
		
		public double CalculateFuelRequired(){
			double fuelRequired = (Duration / 60.0) * FuelConsumptionRate;
			return fuelRequired;
		}
	}
}﻿using System;
