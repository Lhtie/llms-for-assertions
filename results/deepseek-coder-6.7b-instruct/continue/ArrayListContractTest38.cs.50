﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListTest
    {
        [TestMethod]
        public void TestAdd()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            Assert.AreEqual(3, arrList.Count);
        }

        [TestMethod]
        public void TestRemove()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Remove(2);
            Assert.AreEqual(2, arrList.Count);
            Assert.IsFalse(arrList.Contains(2));
        }

        [TestMethod]
        public void TestInsert()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Insert(1, 2);
            Assert.AreEqual(4, arrList.Count);
            Assert.AreEqual(2, arrList[1]);
            Assert.IsTrue(arrList.Contains(2));
        }

        [TestMethod]
        public void TestSet()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList[1] = 2;
            Assert.AreEqual(2, arrList[1]);
        }
    }
}

