//ArrayList/Program.cs
﻿using System;
using ArrayList;

namespace TestingArrayList
{
    class Program
    {
        static void Main(string[] args)
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(5);
            arrList.Add(6);
            arrList.Add(7);
            arrList.Add(8);

            System.Console.WriteLine("ArrayList:");
            foreach(int i in arrList)
            {
                System.Console.WriteLine(i);
            }

            arrList.Remove(6);

            System.Console.WriteLine("ArrayList after removing 6:");
            foreach(int i in arrList)
            {
                System.Console.WriteLine(i);
            }

            arrList.Insert(1, 6);

            System.Console.WriteLine("ArrayList after inserting 6 at index 1:");
            foreach(int i in arrList)
            {
                System.Console.WriteLine(i);
            }

            arrList[0] = 9;

            System.Console.WriteLine("ArrayList after setting index 0 to 9:");
            foreach(int i in arrList)
            {
                System.Console.WriteLine(i);
            }
        }
    }
}

