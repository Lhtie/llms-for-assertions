	    else { Assert.IsTrue((Old_arrListLastIndexOfX <= Old_arrListIndexOfX), $"Old_arrListLastIndexOfX '{Old_arrListLastIndexOfX}' should be <= Old_arrListIndexOfX '{Old_arrListIndexOfX}'"); }
