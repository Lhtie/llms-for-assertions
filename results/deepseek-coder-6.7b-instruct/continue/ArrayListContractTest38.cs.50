        {
            AssumePrecondition.--------------------	    Debug.Assert(Old_arrListIndexOfX <= Old_arrListLastIndexOfX );

          // an assertion using "if \(.*?\) Assert\.Fail\(.*?\);" that  @@@ if @@@ index of x is equal to last index of x, @@@ x is not contained in the array
	    if ((Old_arrListIndexOfX == Old_arrListLastIndexOfX) && (Old_arrListContainsX == true)) Assert.Fail("x is contained in the array");

           // an assertion using "if \(.*?\) Assert\.Fail\(.*?\);" that @@@ if @@@ index of x is not equal to last index of x, @@@ x is contained in the array
