namespace ArrayList.Test.Pex
{
    [TestFixture]
    public class ArrayListPexTest
    {
        [Test]
        [PexMethod(MaxConstraints = 4_000, Replay = ReplayMode.All, Exhaustive = true)]
        public void TestContracts(ArrayList list, int[] elementsToAdd, int[] indexesToInsert, int[] elementsToInsert, int[] elementsToRemove, int[] indexesToSet, int[] elementsToSet)
        {
#if DEBUG
            for (int i = 0; i < elementsToAdd.Length; i++)
                {
                    Assume.That(list.Count >= indexesToInsert[i]);
                    list.Insert(indexesToInsert[i], elementsToInsert[i]);
                }

            for (int i = 0; i < elementsToRemove.Length; i++)
            {
                int indexToRemove = list.IndexOf(elementsToRemove[i]);
                Assume.That(indexToRemove != -1);
                list.RemoveAt(indexToRemove);
            }

            for (int i = 0; i < indexesToSet.Length; i++)
            {
                Assume.That(indexesToSet[i] < list.Count);
                list[indexesToSet[i]] = elementsToSet[i];
            }

            Assert.IsTrue(true);
#endif
        }
    }
}




// This is the Pex method that calls our contracts
// To ensure our contracts hold, we need to make assumptions about the inputs
// Depending on what we assume, we might end up with a different program behavior when the function is actually running
// 
// To demonstrate, consider the following:
// PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
// The "$old_arrList_IndexOf_x" string is just the name of a variable in our viewer
// Old_arrListIndexOfX is the value that we are storing for that variable
// We do this so that Pex can display the values when it's running our test
// Now, if we assume that x is already in arrList when Add is called, then Old_arrListIndexOfX will be a valid index
// When we run the Pex test, if the Add method isn't working as expected, we can see the actual index of x in the list in our viewer
// This way, we can quickly figure out what is wrong if Add is not working as expected

// This approach can be used for other methods as well by modifying the parameters as needed
// The important thing is to make reasonable assumptions when running Pex tests so that you can catch potential issues early on

