﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {



        [Test]
        [PexMethod]
        public void PexMethod_Add([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            arrList.Add(x);

            Assert.IsTrue(arrList.Contains(x));

        }

        [Test]
        [PexMethod]
        public void PexMethod_Remove([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));

            arrList.Remove(x);

            Assert.IsFalse(arrList.Contains(x));
        }

        [Test]
        [PexMethod]
        public void PexMethod_Insert([PexAssumeUnderTest]ArrayList arrList, int x, [PexAssumeValid] int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >=0);

            arrList.Insert(index, x);

            Assert.AreEqual(x, arrList[index]);

        }

        [Test]
        [PexMethod]
        public void PexMethod_Set([PexAssumeUnderTest]ArrayList arrList, int x, [PexAssumeValid] int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            arrList[index] = x;

            Assert.AreEqual(x, arrList[index]);
        }

    }
}

