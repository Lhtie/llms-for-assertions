        [MaxLength(100, ErrorMessage = "The maximum length for the Name is 100 characters.")]
        public string Name { get; set; }

        [MaxLength(1500, ErrorMessage = "The maximul length for the Description is 1500 characters.")]
        public virtual string Description { get; set; }

        [Required(ErrorMessage = "You should provide an Author")]
        [MaxLength(50, ErrorMessage = "The maximum length for the Author is 50 characters.")]
        public string Author { get; set; }

        public string ImageUrl { get; set; }

        [Required(ErrorMessage = "You should provide a category.")]
        public Guid CategoryId { get; set; }

        public DateTime PublishedDate { get; set; }

        public DateTime CreatedDate { get; set; }
    }
}

