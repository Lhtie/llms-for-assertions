        {
            ArrayList list = new ArrayList();
            list.Insert(0, 10);
            Assert.AreEqual(1, list.Count);
            Assert.AreEqual(10, list[0]);
            list.Insert(0, 20);
            Assert.AreEqual(2, list.Count);
            Assert.AreEqual(20, list[0]);
            Assert.AreEqual(10, list[1]);
        }

