using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListInvariantTest
    {
        [PexMethod]
        public void Invariants_CheckAll_ArrayList(ArrayList arrList)
        {

            PexObserve.ValueForViewing("$arrListCount", arrList.Count);
            AssumePrecondition.IsTrue((arrList.Count == 0) || (arrList != null)); // Invariant:  ArrayList Count must be valid (if not null)
            AssumePrecondition.IsTrue(arrList.Count >= 0); // Invariant: ArrayList Count must not be negative 

        }
    }
}

