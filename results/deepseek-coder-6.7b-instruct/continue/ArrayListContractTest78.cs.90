	[PexMethod]
        public void ArrayListExceptionHandlingTest([PexAssumeUnderTest] ArrayList arr)
        {
	    AssumePrecondition.IsTrue(true);
            
            try
            {
                arr[arr.Count] = PexSettings.ValueRandomization.Next();
            }
            catch (IndexOutOfRangeException exception)
            {
                PexObserve.ValueForViewing("Caught IndexOutOfRangeException", exception.Message);
            }

            int Old_count = arr.Count;

            try
            {
                arr.Add(null);
            }
            catch (ArgumentNullException exception)
            {
                PexObserve.ValueForViewing("Caught ArgumentNullException", exception.Message);
            }

            int New_count = arr.Count;

            PexObserve.ValueForViewing("Old Count", Old_count);
            PexObserve.ValueForViewing("New Count", New_count);
        }
    }
}

