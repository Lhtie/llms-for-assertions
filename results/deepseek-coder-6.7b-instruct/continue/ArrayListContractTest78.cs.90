﻿using System;
using System.Collections;
using ArrayList;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void ArrayList_ConstructorTest()
        {
            ArrayList arrList = new ArrayList();
            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void ArrayList_AddTest()
        {
            ArrayList arrList = new ArrayList();

            arrList.Add(10);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(10, arrList[0]);

            arrList.Add(20);
            Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(20, arrList[1]);

            arrList.Add("abc");
            Assert.AreEqual(3, arrList.Count);
            Assert.AreEqual("abc", arrList[2]);
        }

        [Test]
        public void ArrayList_RemoveTest()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add("abc");

            Assert.AreEqual(3, arrList.--------------------	    // list and the last occurrence if x in the old ArrayList is at position "New_Ret".
	    bool condition = New_Ret >= 0 && arrList.Contains(x) && arrList.LastIndexOf(x) == arrList.Count - 1 - New_Ret;
	    Assert.IsTrue(condition,"\n" +"Return value must be non-negative if the element is present in the list. And the last occurrence of the element in the list should be at position 'New_Ret'." +
				     "Check your method's implementation." + "\n" + "Currently, New_Ret = " + New_Ret + " and LastIndexOf of " + x + " in the list = " + arrList.LastIndexOf(x));
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, x is in the old array 
	    // list and the last occurrence if x in the old ArrayList is at position "New_Ret".
	    bool condition = New_Ret >= 0 && arrList.Contains(x) && arrList.LastIndexOf(x) == New_Ret;
	    Assert.IsTrue(condition,"\n" +"Return value must be non-negative if the element is present in the list. And the last occurrence of the element in the list should be at position 'New_Ret'." +
				     "Check your method's implementation." + "\n" + "Currently, New_Ret = " + New_Ret + " and IndexOf of " + x + " in the list = " + arrList.IndexOf(x));

        }
    }
}


```


Apart from these method, for each action, we need a contract to ensure correctness, and this includes various parts such as preconditions, postconditions and invariants.
This code allows for easy identification of specific actions that may cause problems with the ArrayList object.

We should include contracts to ensure that all code paths have been executed and to ensure that all properties have been maintained throughout execution. 




## Conclusion

For the project requirement, the aim was to apply various software engineering principles, tools and techniques such as unit testing, code coverage, code inspections, and the use of code contracts and static analysis tools. 

The end result is a robust, secure and maintainable software system. It provides a comprehensive understanding of the process of software testing and automation. 

As part of a team, we learnt how to collaborate effectively, how to create and manage a project which required communication, delegation, problem solving and coordination skills.

Each of us contributed to the learning process by explaining different concepts and demonstrating their impact on the outcome. This was particularly useful for those who were learning about continuous integration, code contracts and automation tools.--------------------        }
    }
}

