﻿using System;
using System.Collections;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace Test
{
    class Program
    {
        static void Main(string[] args)
        {
		ArrayList testList = new ArrayList();
		ArrayListContractTest contractTest = new ArrayListContractTest();

		for (int i = 0; i < 10; i++)
		{
		    testList.Add(i);
		}

		//Contract test 1: Add()
		contractTest.PUT_AddContract(testList, 4);
		contractTest.PUT_RemoveContract(testList, 4);

		//Contract test 2: Remove()
		contractTest.PUT_AddContract(testList, 4);
		contractTest.PUT_RemoveContract(testList, 4);

		//Contract test 3: Insert()
		contractTest.PUT_InsertContract(testList, 3, 1);

		//Contract test 4: Set()
		contractTest.PUT_SetContract(testList, 3, 1);

		//Contract test 5: Get()
		contractTest.PUT_GetContract(testList, 0);

		//Contract test 6: Contains()
		contractTest.PUT_ContainsContract(testList, 0);

		//Contract test 7: IndexOf()
		contractTest.PUT_IndexOfContract(testList, 0);

		//Contract test 8: LastIndexOf()
		contractTest.PUT_LastIndexOfContract(testList, 0);	
        }
    }
