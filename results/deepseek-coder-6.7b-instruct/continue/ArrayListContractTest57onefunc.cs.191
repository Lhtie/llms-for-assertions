﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.States;
using System.Collections.Generic;

namespace MySortedList.Test
{
    public partial class MySortedListTest
    {

        [PexMethod]
        public void AddItems_AllInputsAreValid_ShouldIncreaseCount([PexAssumeUnderTest]MySortedList<int, string> list)
        {
            var key = Pex.Create<int>(0);
            var value = Pex.Create<string>("");

            int oldCount = list.Count;

            list.Add(key, value);

            Assume.That<int, string>(list.Comparer).IsNotNull();

             PexObserve.ValueForViewing("Old count", oldCount);
             PexObserve.ValueForViewing("New count", list.Count);

             // Assert
             PexAssert.AreEqual(oldCount + 1, list.Count);
        }
    }
}

//TestSourcesOfSolution/MySortedList.Test/MySortedListTest/Remove.cs
﻿using Microsoft.Pex.Framework;--------------------


            // Preconditions: 
            // arrList.Count > 0 implies arrList.IndexOf(x) != -1
            // arrList.Count == 0 implies arrList.IndexOf(x) == -1
            if (Old_arrListCount > 0)
            {
                AssumePrecondition.IsTrue(Old_arrListIndexOfX != -1);
            }
            else
            {
                AssumePrecondition.IsTrue(Old_arrListIndexOfX == -1);
            }

            // Postconditions: 
            // arrList.Count is static
            // arrList.IndexOf(x) is either static (value = -1) or increases
            // arrList.LastIndexOf(x) is either static (value = -1) or increases or remains same
            if (New_Ret)
            {
                Assert.AreEqual(Old_arrListCount, New_arrListCount);
                Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
                Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
            }
            else
            {
                Assert.AreEqual(Old_arrListCount, New_arrListCount - 1);
                Assert.IsTrue(New_arrListIndexOfX < Old_arrListIndexOfX || New_arrListIndexOfX == -1);
                Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
            }
        }
    }
}


As you see, the assertions in the contract test are using "Debug.Assert" which is not a good practice because the software under test will not abort when these conditions fail, instead it only adds a Debugger.Break (if in debug mode). And also, the conditions itself won't help understand the test case better as they are not self-explanatory.

In contrast, we write the assertions using NUnit framework. We give them a clear, understandable description of what is expected to happen to make the test cases self-explanatory.


For example, if the return value is false, we would write:


            Assert.True(New_arrListIndexOfX < Old_arrListIndexOfX, 
                         "If the return value is false, index of x before is less than or equal to after after adding value " + Old_x);


This way, your test cases become more readable and your failures will provide a description of exactly what you expect and what actually happened.
  [1]: https://msdn.microsoft.com/en-us/library/ms228965(v=vs.110).aspx
  [2]: https://www.nunit.org/


Hope that helps to clarify the difference between using Debug.Assert and NUnit Assertions.

