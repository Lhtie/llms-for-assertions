//TestSourcesOfSolution/ArrayList.Test/ArrayListContractTest/PutIndexOfContract.cs
﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.States;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);

            // An assertion using "Debug.Assert\(.*?\);" that @@@ Count after addition is greater than count before 
            // then @@@ Index of just added element must be equal to count before addition
        }
    }
}

//TestSourcesOfSolution/ArrayList.Test/ArrayListContractTest/PutRemoveContract.cs
﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.States;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            object Old_arrListIndexValue = arrList[index];

            object New_ret = arrList.Remove(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Index_Value", Old_arrListIndexValue);
            PexObserve.ValueForViewing("$new_ret", New_ret);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // Assertions using "Debug.Assert\(.*?\);"
            // @@@ Count after removal is less than count before 
            // @@@ Value at index of removed element must be equal to value of removed element
        }
    }
}

