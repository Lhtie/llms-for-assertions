        /// Displays a message box which asks user to confirm an action.
        /// </summary>
        /// <param name="message"></param>
        /// <returns></returns>
        public static DialogResult ShowConfirmation(string message)
        {
            return MessageBox.Show(message, "Confirmation", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
        }
    }
}using UnityEngine;

public class CameraFollow : MonoBehaviour
{
    public Transform target;
    public Vector3 offset;
    public float smoothSpeed = 0.125f;
    public bool hasEdgeScrollLimits = false;
    public Vector3 minLimit;
    public Vector3 maxLimit;

    void FixedUpdate()
    {
        Vector3 desiredPosition = target.position + offset;

        if (hasEdgeScrollLimits)
        {
            desiredPosition = new Vector3
            (
                Mathf.Clamp(desiredPosition.x, minLimit.x, maxLimit.x),
                Mathf.Clamp(desiredPosition.y, minLimit.y, maxLimit.y),
                Mathf.Clamp(desiredPosition.z, minLimit.z, maxLimit.z)
            );
        }

        Vector3 smoothPosition = Vector3.Lerp(transform.position, desiredPosition, smoothSpeed);
        transform.position = smoothPosition;
    }
}using System;
using UnityEngine;

public class EventManager : MonoBehaviour
{
    public static EventManager instance;

    private void Awake()
    {
        if (instance == null)
        {
            instance = this;
        }
        else
        {
            Destroy(gameObject);
            return;
        }

        DontDestroyOnLoad(gameObject);
    }

    public event Action<int> onEnemyKilled;
    public void EnemyKilled(int enemyID)
    {
        if (onEnemyKilled != null)
        {
            onEnemyKilled(enemyID);
        }
    }
}using UnityEngine;

