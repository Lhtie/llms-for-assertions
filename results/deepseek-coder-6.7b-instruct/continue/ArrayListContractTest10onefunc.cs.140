            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, string.Format("ArrayList<int>.Add( int ) contract for int x = {0} and ArrayList < {1} >  fails due to inconsistent last index", Old_x, Old_arrListCount));
            // an assertion using "Debug.Assert\(.*?\);" that @@@ new count is greater than old count 
            Debug.Assert(New_arrListCount > Old_arrListCount, string.Format("ArrayList<int>.Add( int ) contract for int x = {0} and ArrayList < {1} >  fails due to inconsistent count", Old_x, Old_arrListCount));
            // an assertion using "Debug.Assert\(.*?\);" that @@@ new index of x should be same as old count
            Debug.Assert(New_arrListIndexOfX == Old_arrListCount, string.Format("ArrayList<int>.Add( int ) contract for int x = {0} and ArrayList < {1} >  fails due to inconsistent index", Old_x, Old_arrListCount));
            // an assertion using "Debug.Assert\(.*?\);" that @@@ new last index of x should be same as new count
            Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1, string.Format("ArrayList<int>.Add( int ) contract for int x = {0} and ArrayList < {1} >  fails due to inconsistent Last index", Old_x, Old_arrListCount));
            // an assertion using "Debug.Assert\(.*?\);" that @@@ new contains x should be true
            Debug.Assert(New_arrListContainsX == true, string.Format("ArrayList<int>.Add( int ) contract for int x = {0} and ArrayList < {1} >  fails due to inconsistency in contains", Old_x, Old_arrListCount));
        }

        public void PUT_InsertContract([PexAssumeUnderTest] ArrayList arrList, int index, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            AssertPrecondition.IsTrue(index <= arrList.Count && index >=0, "Index must be in the range of [0, arrList.Count]"); 

            try
            {
                arrList.Insert(index, Old_x);
            }
            catch(IndexOutOfRangeException e)
            {
                AssumePrecondition.IsFalse(true, "arrList.Insert(index, x) should not fail when index is in the range of [0, arrList.Count]");
            }

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$index", index);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("--------------------
            Assert.IsTrue(New_arrListIndexOfX >= New_arrListLastIndexOfX);

            //an assertion using "Debug.Assert\(.*?\);" that @@@ new index of x is equal to old index of x  or @@@ the old index of x equals -1 (implying x doesn't exist in arrayList) and New ret equals new arrayList count minus 1

            Assert.IsTrue((Math.Abs(Old_arrListIndexOfX - New_arrListIndexOfX) <= 1 && Math.Abs(Old_arrListLastIndexOfX - New_arrListLastIndexOfX) <= 1) ||
                (Old_arrListIndexOfX == -1 && New_Ret == New_arrListCount - 1));
        }
    }
}
```

In this PexSequential Contract, we are testing the Add method. We start by assuming some preconditions, which should hold for our tested code. Then, we perform the actual operation (Add), and retrieve the results. Then, we perform postconditions assertions on each of the properties that the method is supposed to affect (Count, IndexOf, etc.). This includes checking for the properties to change in a way we expect.

We then observe the values that are being returned by the method, including the return value of the Add operation and indices obtained after the operation. This allows us to see what is being returned by the method under test as a whole, which can help in debugging.

Finally, we express the expected behaviour using Debug.Assert statements such as
- the last index of x should be greater or equal to old last index.
- the index of x should be equal to old index or if the old index equals -1 (implying x doesn't exist in arrayList), and the method ret is new arrayList count minus 1.

These debugging messages will be shown on the Pex method view when testing the method under test.

We have observed that the "Count" property of the array increases by 1 after Add operation and the "IndexOf" and "LastIndexOf" also follow its behavior. We also observed that if the element doesn't exist in the array, IndexOf and LastIndexOf will return -1 and the Count of the array will increase by 1 after the Add operation.

The "Contains" property also checks if the added element exists in the array.

Our Assertions also check if the "IndexOf" property has changed to indicate the position of the newly added element. We also check if the "LastIndexOf" has indeed found a valid index for the element added.

We also check if our elements are in order (last indexes are same or increasing) and if elements have been added at the end of the list. If not, our test fails. 

Lastly, the Assertion also check whether the added element is actually contained in the internal array.

By running the tests using Pex, we can ensure that our code does not fail with unexpected values and behaves following the required conditions. This is part of Pex's power: it infers inputs that would expose bugs, thus increasing the quality of your code.

The contracts tested here only check the basic features of an ArrayList. If necessary and for more comprehensive testing, you could also extend the classes under test for additional features of the ArrayList class such as Removing and Clearing elements, Cloning the ArrayList, copying elements from one ArrayList to other etc. 

In our simple examples, we used PexSequential to test one operation at a time, but PexRandom could be used to generate a large number of tests covering many scenarios in one go.

We recommend starting by checking the contracts and then progressing to random, sequential contracts as your tests become more complicated for each operation. This is not a hard-and-fast rule, but a guide on when to go which way: the earlier you check the contracts and you cover basic scenarios, the better so you'll be confident in the reliability of your code.

More information about how to use Pex in the TDD / Unit Testing of C# / .Net code can be found in the following link : https://visualstudiogallery.msdn.microsoft.com/11cfde71-c50b-4d88-afe5-d55fb083d2de
Also, if you are new to Pex, there is an excellent introduction post here :  https://www.msmvps.com/blogs/morgant/

**Useful Resources**
1. MSDN Pex User Guide: https://msdn.microsoft.com/en---------------------        }
    }
}

We would appreciate any help on this. Thanks in advance for your assistance.

A: The PexObserve.ValueForViewing method is typically used when you want Pex to expose the values of variables to be displayed as part of the method exploration screen in Visual Studio.
However, it doesn't provide any way of adding assertions - you must write or create a separate unit test method to assert that the expected conditions hold true.
You may try to add the Debug.Assert(...) statement in the Pex test method generated by the Pex framework such that your unit test method is using this to assert the conditions but remember that Pex generated tests will not be in any test explorer or any test framework that you may have for running the test unless the Pex tests are also integrated with the same test runner tool.
If you want to have meaningful assertions then best would be to write your own using the 'PexAssert' class or your own assert method.
Here is an example:
Debug.Assert(Old_arrListCount < int.MaxValue, "Array count is greater than int max value");

Please refer to the official Pex documentation for more details: http://research.microsoft.com/en-us/um/cambridge/projects/pxref/pxref.htm
However, please note that Debug.Assert statements are not being run by Pex since it just injects code in the test method which then can be run by regular unit test runners, not by the Pex instrumentation itself.
Hope this helps.
The Pex team would be glad to further clarify anything you need.

A: The Pex tool adds the assertions during generation of the code which could be reviewed and validated by a manual code review.
Here is the link to the official MSDN Pex documentation and a helpful blog for an in-depth understanding.
As this Pex generated code runs under the 'PexRunner', which is a custom test runner, you need to consider how to handle Assert Statements. 
The easiest way is to put the Assert Statements in your test methods and run these using your testing framework.
Alternatively, you can customize your PexRunner to handle these Assert Failed exceptions.
Debug.Assert statements in Pex tests aren't run by Pex itself, but by the PexRunner during the execution of the tests. That's why you wouldn't see them in your test explorer.
Remember that PEX generated tests should be used as input for static code analysis tools to check for correctness and to generate new tests cases. If you want test cases to be generated by test runners, they must be manually injecting Assert statements.
Hope this is not confusing.

A: 
"In addition to test cases, Pex also provides methods for observation of key variables' values for viewing." 

I think you might be confusing Pex with regular testing tools. Usually, unit tests will be used for observing variable values and for asserting conditions.

What you are doing in Pex is creating a 'contract' for the ArrayList.Add method. Basically, you specify what the method should do, what should it return, and what the inputs should be. Pex then attempts to find valid inputs that satisfy this contract while also maximizing exploration.

The assertions that you are trying to make can instead be made by your test framework. For example, in NUnit, you'd use Assert.AreEqual or Assert.IsTrue to check certain conditions. Similarly, in MSTest, you'd use Assert.AreEqual or Assert.IsTrue.

Here's a very basic test case that you may want to use to check the Count property of the list:

```csharp
[TestMethod]
public void ArrayList_Add_Test()
{
    ArrayList arrList = new ArrayList();
    int initialCount = arrList.Count;

    // Assume we add 1 to arrList...
    arrList.Add(1);

    Assert.AreEqual(initialCount + 1, arrList.Count);
}
```
In the Above Test code you are:
- Creating a new ArrayList.
- Adding item (Notice, you are assuming this here, it may not be the full contract, but a reasonable assumption for testing here. You need to validate with the real contract which item should be added)
- Checking whether the Count property of the list has increased by 1 or not.

You need to write similar test cases for all condition that you are interested about. You should run these test cases to ensure that there is no regression in your behavior.

Consider learning Test Driven Development (TDD) because you can--------------------            System.Diagnostics.Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
     
	    // an assertion using "Debug.Assert\(.*?\);" for adding an item to any Collection it's size increases by one
            System.Diagnostics.Debug.Assert(New_arrListCount == Old_arrListCount + 1);

            if (!New_arrListContainsX)
            {
                System.Diagnostics.Debug.Fail(@"Add failed");
            }
        }
    }
}

My aim is to generate a comprehensive set of tests with Pex by supplying different input parameters to the method of interest.

A: You should make your code contracts immutable, i.e., ensure that no other code can modify the state of `arrList' after it has been passed to `PUT_AddContract'. You need to make defensive copies of your list if you want these postconditions to be valid (i.e., the state of arrList postcondition should apply to the original list, not its copy). 

This is because Pex attempts to satisfy precondition by exploring different branches of the input data and uses the postconditions to ensure that the code under test's observable behavior is the same across branches. Therefore, a modified state should not violate the precondition.

Please take a look at the PexContractTest1.cs file included with Pex and see how it handles different states for Add to ArrayList. The file is located at the installation directory of Pex.

Here’s how you can go about it.

1. Create defensive copies of arrList
2. Make your ArrayList contract immutable by removing or commenting any code that modifies arrList.
3. Create pre and post conditions such that checks for Count, Contains, IndexOf, and LastIndexOf on old and new versions of lists match your expectations.
4. Pex should not modify the input list, hence it will not fail with a PexNotUnderTestException

You still might not get all possible scenarios using Pex but this should help in generating basic test cases to start with. You can then extend this using other Pex features as needed.

I wish I could provide better help without seeing your code contracts, etc. Let me know if I can help with any code snippet.

Let me know if you need any more support or clarification.

A: If possible, consider writing your own Pex tests rather than trying to Pex your existing code. This is because Pex can sometimes get itself into trouble with complex objects (like ArrayLists) as it tries to maximize code coverage but doesn't always fully understand the full context and semantics of these objects. 

It's unlikely that Pex could generate a comprehensive set of tests for ArrayList that you would want. The standard ArrayList operations (like Add and Remove) generate very basic tests and it's unlikely to catch many corner cases. 

That said, if you're confident in the ArrayList's behavior and you're just looking for a simple smoke test, then it probably works fine with Pex. But you definitely want to start refactoring your code contracts so they're easier to analyze and verify with other tools or your own tests.

If you're writing a new piece of code, I would highly recommend using a mocking framework like Moq or nSubstitute to isolate the parts of your code that interact with ArrayList to make assertions on the behavior of specific methods instead of dealing with complex data types. This way you're really focusing on the code and behavior you're trying to test, rather than the complex behaviors of the .NET Framework ArrayList.

In summary, it's recommended to isolate code under test as much as possible to ease testing and focus on behaviors of objects instead of complex datatypes.


A: I have a similar issue in a project. Consider isolating your code from the Framework you have in mind in your test project, creating your own interface / abstract class that defines the method your ArrayList methods are going to use. Now you can mock this interface and test your code.
The problem is, Pex, currently, is not able to handle that kind of interfaces (ArrayList has a bunch of methods used internally by the ArrayList class) and can't generate tests for an ArrayList with Moq for example.
Here's a sample interface that you can create:
public interface ICustomArrayList
{
    int Add(object value);
    bool Contains(object value);
    // Add other methods necessary for your tests
}

