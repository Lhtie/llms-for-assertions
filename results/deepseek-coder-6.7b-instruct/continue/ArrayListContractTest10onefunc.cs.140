            Debug.Assert(a >= b);

            // assertion that  @@@ return value of Add is old count of list and also equal to current count of list
            Debug.Assert(New_Ret == (Old_arrListCount + 1) && Old_arrListCount == New_arrListCount - 1);

            // assertion that  @@@ new arrayList contains x 
            Debug.Assert(New_arrListContainsX == true);
        }
