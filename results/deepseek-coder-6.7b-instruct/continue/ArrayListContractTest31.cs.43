﻿using EPiServer.Shell;
using EPiServer.Web;
using EPiServer.Web.Routing;
using System;
using System.Collections.Generic;
using System.Web.Http;

namespace AlloyTraining.Web.Business.Seo
{
    [InitializableModule]
    [ModuleDependency(typeof(EPiServer.Web.InitializationModule))]
    public class TinyMCEApiController : ApiController
    {
        private const string TinyMCEPluginFolderPath = "/Static/lib/tinymce/plugins/";
        private static readonly List<string> ExcludePlugins = new List<string> { "advlist", "advcode", "advtable", "autoresize", "checklist", "colorpicker", "contextmenu", "lists", "paste", "preview", "searchreplace", "table" };

        public IEnumerable<string> Get()
        {
            foreach (var plugin in UrlResolver.Current.GetUrlList("TinyMCEPlugins"))
            {
                var pluginName = System.IO.Path.GetFileName(plugin);
                if (ExcludePlugins.Contains(pluginName))
                    continue;

                yield return Globals.HostAppName + TinyMCEPluginFolderPath + pluginName;
            }
        }
    }
