namespace GHIElectronics.NETMF.Hardware
{
    public class ADC
    {
        private ADCChannel channel;

        public ADC(ADCChannel channel)
        {
            this.channel = channel;
        }

        public int ReadValue()
        {
            return Microsoft.SPOT.Hardware.AnalogRead((Microsoft.SPOT.Hardware.AnalogChannel)this.channel);
        }

        public double ReadRMSVoltage()
        {
            return (double)this.ReadValue() * 3.3 / 1023;
        }

        public double ReadMilliVolts()
        {
            return (double)this.ReadValue() / 1023 * 3300;
        }
    }
}using System;

