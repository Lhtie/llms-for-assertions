	    int Old_position = -1;
	    for (int i = 0; i < Old_arrListCount; i++) {
		if ((int)arrList[i] == x) {
		    Old_position = i;
		    break;
		}
	    }
	    Debug.Assert(Old_position >= Old_index);


	}
    }
}

//csharp/src/Arrays.Tests/ArraysTest.cs
﻿using System.Collections;

using NUnit.Framework;
using PexAPIWrapper;

namespace Arrays.Test
{
    [TestFixture]
    public class ArraysTest
    {
        [Test, PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]int[] array)
        {
            int[] originalArray = (int[])array.Clone();

            System.Array.Sort(array);

            for (int i = 0; i < originalArray.Length; i++)
            {
                Assert.True(array[i] >= originalArray[i]);
                if (i + 1 < originalArray.Length && array[i] == originalArray[i])
                {
                    Assert.True(array[i + 1] >= originalArray[i + 1]);
                }
            }
        }

        [Test, PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]int[] array)
        {
            int oldCount = array.Length;

            System.Array.Clear(array, 0, array.Length);

            Assert.AreEqual(0, array.Length);
            for (int i = 0; i < oldCount; i++)
            {
                Assert.AreEqual(default(int), array[i]);
            }
        }

        [Test, PexMethod]
        public void PUT_ReverseContract([PexAssumeUnderTest]int[] array)
        {
            int[] originalArray = (int[])array.Clone();

            System.Array.Reverse(array);

            for (int i = 0; i < originalArray.Length; i++)
            {
                Assert.AreEqual(originalArray[originalArray.Length - 1 - i], array[i]);
            }
        }
    }
}

