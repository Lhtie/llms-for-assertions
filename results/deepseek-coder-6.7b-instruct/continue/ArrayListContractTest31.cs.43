﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using System.Collections;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass(typeof(ArrayList))]
    public partial class ArrayListPropertiesTest
    {
        [PexMethod]
        public void Test_Capacity(int initialCapacity, int newCapacity)
        {
            AssumePrecondition.IsTrue(initialCapacity >= 0);
            AssumePrecondition.IsTrue(newCapacity >= 0);

            ArrayList arrList = new ArrayList(initialCapacity);
            int Old_Capacity = arrList.Capacity;
            arrList.Capacity = newCapacity;

            PexObserve.ValueForViewing("$old_capacity", Old_Capacity);
            PexObserve.ValueForViewing("$new_capacity", arrList.Capacity);

            Assert.IsTrue(arrList.Capacity >= Old_Capacity);
            Assert.IsTrue(arrList.Capacity >= initialCapacity);
        }

        [PexMethod]
        public void Test_Count(ArrayList arrList)
        {
            int Old_Count = arrList.Count;
            arrList.Add("Test");

            PexObserve.ValueForViewing("$old_count", Old_Count);
            PexObserve.ValueForViewing("$new_count", arrList.Count);

            Assert.AreEqual(Old_Count + 1, arrList.Count);
        }

        [PexMethod]
        public void Test_IsFixedSize(ArrayList arrList)
        {
            bool ret = arrList.IsFixedSize;

            PexObserve.ValueForViewing("$is_fixed_size", ret);

            Assert.IsInstanceOf<IList>(arrList);
            Assert.IsFalse(ret);
        }

        [PexMethod]
        public void Test_IsReadOnly(ArrayList arrList)
        {
            bool ret = arrList.IsReadOnly;

            PexObserve.ValueForViewing("$is_read_only", ret);

            Assert.IsInstanceOf<IList>(arrList);
            Assert.IsFalse(ret);
        }

        [PexMethod]
        public void Test_SyncRoot(ArrayList arrList)
        {
            object obj = arrList.SyncRoot;

            PexObserve.ValueForViewing("$sync_root", obj);

            Assert.IsNotNull(obj);
            Assert.IsInstanceOf<IList>(arrList);
        }

        [PexMethod]
        public void Test_Item([PexTypedList]ArrayList arrList)
        {
            int index = 0;
            object oldValue;
            if (arrList.Count > 0)
            {
                oldValue = arrList[0];
                arrList[0] = "Test";

                PexObserve.ValueForViewing("$old_value", oldValue);
                PexObserve.ValueForViewing("$new_value", arrList[0]);

                Assert.AreEqual("Test", arrList[0]);
                Assert.AreEqual(oldValue, arrList[0]);
            }
        }
    } 
}

