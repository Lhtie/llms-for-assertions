}using System.Text.RegularExpressions;

namespace AdventOfCode2022;

public class Day5 : AdventDay
{
    public override object FirstPuzzle()
    {
        var stacks = ParseStacks();
        List<List<char>> stacksFirst = new List<List<char>>(stacks);
        List<List<char>> stacksSecond = new List<List<char>>(stacks);

        foreach (var line in GetInputLines())
        {
            if (int.TryParse(line.Substring(5, 1), out int amount) && int.TryParse(line.Substring(12, 1), out int from) && int.TryParse(line.Substring(17, 1), out int to))
            {
                from--; //Adjust to c# 0-indexed array
                to--;

                for(int i=0; i<amount; i++)
                {
                    stacksFirst[to].Insert(0, stacksFirst[from][0]);
                    stacksFirst[from].RemoveAt(0);
                }
                
                stacksSecond[to].InsertRange(0, stacksSecond[from].GetRange(0, amount));
                stacksSecond[from].RemoveRange(0, amount);
            }
        }

        return new
        {
            FirstPuzzle = string.Join("", stacksFirst.Select(s => s[0])),
            SecondPuzzle = string.Join("", stacksSecond.Select(s => s[0]))
        };
    }

    private List<List<char>> ParseStacks()
    {
        var stackLines = new List<string>();
        foreach (var line in GetInputLines())
        {
            if (line.Contains('['))
                stackLines.Add(line);
            else if (line == string.Empty)
                break;
        }

        var stacks = Enumerable
            .Range(0, stackLines[0].Length / 4 + 1)
            .Select(x => new List<char>())
            .ToList();

        foreach (var line in stackLines.Reverse())
        {
            for (int i = 0; i < line.Length; i += 4)
            {
                if (line[i + 1] != ' ')
                    stacks[i / 4].Add(line[i + 1]);
            }
        }

        return stacks;
    }
}﻿using System.Drawing;

namespace AdventOfCode2022;

public interface IAdventDay
{
    public object FirstPuzzle();
    public object SecondPuzzle();
}

public class AdventDayAttribute : Attribute
{
    public int Day { get; set; }
    public string Title { get; set; }

    public AdventDayAttribute(int day, string title)
    {
        Day = day;
        Title = title;
    }
}

public abstract class AdventDay : IAdventDay
{
    [AdventDay(1, "Calorie Counting")]
    public abstract object FirstPuzzle();
    [AdventDay(1, "Calorie Counting")]
    public abstract object SecondPuzzle();

    protected string GetInput() => File.ReadAllText(Path.Combine("input", $"day{GetType().GetCustomAttribute<AdventDayAttribute>().Day}.txt"));
    protected List<string> GetInputLines() => File.ReadAllLines(Path.Combine("input", $"day{GetType().GetCustomAttribute<AdventDayAttribute>().Day}.txt")).ToList();
}namespace AdventOfCode2022;

