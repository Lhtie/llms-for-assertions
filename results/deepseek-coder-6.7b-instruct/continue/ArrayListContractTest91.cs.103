namespace Nekoyume.TableData
{
    using System;
    using BbsRssFetcher.Xml;
    using Nekoyume.Helper;

    [Serializable]
    public class StageRow : ItemBase
    {
        public string Stage { get; protected set; }

        public string Name { get; protected set; }

        public StageRow(Node node) : base(node)
        {
        }

        protected override void SetFieldAndProperty(Node node)
        {
            Stage = GetString(node, "stage");
            Name = GetString(node, "name");
        }

        public override string ToString()
        {
            return string.Format("[StageRow: Stage={0}, Name={1}]{2}", Stage, Name, base.ToString());
        }
    }
}

