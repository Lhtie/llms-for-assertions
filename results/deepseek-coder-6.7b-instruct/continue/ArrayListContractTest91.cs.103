### Test Harness Code



```java
import static java.lang.System.getProperty;
import java.io.File;

/**
 * Tests the compiled code using the test harness for the specified library and class name.
 * The library and class names are specified using VM system properties
 * (e.g. -DtestLibrary=Math -DtestClass=Mathematics).
 * The library and class names should be relative to the project directories.
 */
public class TestRunner {

    public static final String DEFAULT_LIB_PATH = "src" + File.separator + "test" + File.separator + "java" + File.separator;
    public static final String DEFAULT_TEST_CL_PATH_PREFIX = "PexGeneratedTests" + File.separator;
   
    public static void runTests() {
        String testLibraryName = getProperty("testLibrary");
        String testClassName = getProperty("testClass");

        if (testLibraryName == null || testClassName == null) {
            System.out.println("Specify the name of the library and test class using VM options (-DtestLibrary=Math -DtestClass=Mathematics).");
            return;
        }
        String className = testClassName.replace('.', File.separatorChar) + "." + testClassName;
        String classPath = DEFAULT_LIB_PATH + testLibraryName + File.separator + DEFAULT_TEST_CL_PATH_PREFIX + className;

        org.junit.runner.JUnitCore.main(classPath);
    }

    public static void main(String[] args) {
        runTests();
    }
}
```

