namespace ArrayList
{
    [TestFixture]
    public class ListTests
    {
        [Test]
        public void Test_Add()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            Assert.AreEqual(2, arrList.Count);
        }

        [Test]
        public void Test_Remove()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);
            Assert.AreEqual(1, arrList.Count);
        }

        [Test]
        public void Test_Insert()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Insert(1, 3);

            Assert.AreEqual(3, arrList[1]);
            Assert.AreEqual(3, arrList.Count);
        }

        [Test]
        public void Test_Set()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList[1] = 3;

            Assert.AreEqual(3, arrList[1]);
        }

        [Test]
        public void Test_Get()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(1, arrList[0]);
            Assert.AreEqual(2, arrList[1]);
        }

        [Test]
        public void Test_Contains()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsFalse(arrList.Contains(3));
        }

        [Test]
        public void Test_IndexOf()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));
            Assert.AreEqual(-1, arrList.IndexOf(3));
        }

        [Test]
        public void Test_LastIndexOf()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(2);

            Assert.AreEqual(0, arrList.LastIndexOf(1));
            Assert.AreEqual(2, arrList.LastIndexOf(2));
            Assert.AreEqual(-1, arrList.LastIndexOf(3));
        }
    }
}

