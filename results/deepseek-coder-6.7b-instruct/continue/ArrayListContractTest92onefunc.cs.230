//src/ArrayList/Test/ContractTest/InsertContractTest.cs
// Copyright (c) Microsoft. All rights reserved.
// Licensed under the MIT license. See LICENSE file in the project root for full license information.

using System;
using Microsoft.Pex.Framework;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, Object o)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count , typeof(ArgumentOutOfRangeException));

            int Old_arrListCount = arrList.Count;
            Object Old_arrListItem = index < arrList.Count ? (Object) arrList[index] : null;

            arrList.Insert(index, o); 

            int New_arrListCount = arrList.Count;
            Object New_arrListItem = index < arrList.Count ? (Object) arrList[index] : null;
            
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Item", Old_arrListItem);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Item", New_arrListItem);

            // an assertion that the count of list after inserting is increased by 1
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            
            // an assertion that an item just inserted is correctly retrieved
            Assert.AreEqual(o, New_arrListItem);
            
            // an assertion that other items are still correct in the list.
            for (int i = 0; i < Old_arrListCount; i++)
            {
                Object Old_item = (Object) arrList[i];
                Object New_item = i < index ? Old_item : (i == index ? o :  (Object) arrList[i-1]);
                Assert.AreEqual(Old_item, New_item);
            }           
        }
    }
}

