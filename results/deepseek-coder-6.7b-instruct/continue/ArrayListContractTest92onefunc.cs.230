            if ( Old_arrListContainsX )
                Assert.IsTrue( Old_arrListIndexOfX == New_Ret );
            else
                Assert.IsTrue( New_Ret < 0 ); // if x not exist in ArrayList, -1 should be returned

            // an assertion about New_arrList_Count and Old_arrList_Count
            Assert.IsTrue( Old_arrListCount <= New_arrListCount );
             
        }
