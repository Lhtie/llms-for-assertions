public class Program
{
    public static void Main()
    {
        string[] arrayString = new string[] { "aaa", "bbbb", "c", "ddddddddd", "eeeeee", "fffff", "gg", "hhhhhh", "iiiiiiiiii" };
        char symbol = 'i';
        int counter = 0;

        for(int i = 0; i < arrayString.Length; i++)
        {
            for(int j = 0 ; j < arrayString[i].Length; j++){
                if(arrayString[i][j] == symbol)
                {
                    counter++;
                }
            }
        }

        Console.WriteLine("The character " + symbol + " shows " + counter + " times in the entire strings");
    }

    
