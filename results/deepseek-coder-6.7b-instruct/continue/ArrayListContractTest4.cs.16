}namespace NDepend.PathFinder.Graphs.Edges
{
    public struct EdgeType
    {
        private readonly string name;

        public static readonly EdgeType Normal = new EdgeType("Normal");
        public static readonly EdgeType Instance = new EdgeType("Instance");
        public static readonly EdgeType Interface = new EdgeType("Interface");
        public static readonly EdgeType SubType = new EdgeType("SubType");

        public EdgeType(string name)
        {
            this.name = name;
        }

        public override string ToString()
        {
            return name;
        }
    }
}using System;
