using System.Linq;

namespace NDepend.PathFinder.Graphs.Edges
{
    /// <summary>
    /// A directed edge in a graph.
    /// </summary>
    [DebuggerDisplay("{FromNode} -> {ToNode}")]
    public class Edge
    {
        private static int indexer = 0;

        private readonly EdgeType type;
        private readonly int uniqueId;
        public EdgeType Type
        {
            get { return type; }
        }

        public Node FromNode { get; private set; }
        public Node ToNode { get; private set; }

        public Edge(Node fromNode, Node toNode, EdgeType type = EdgeType.Normal)
        {
            this.FromNode = fromNode;
            this.ToNode = toNode;
            this.type = type;
            this.uniqueId = indexer++;

            fromNode.OutboundEdges.Add(this);
            toNode.InboundEdges.Add(this);
        }

        public override bool Equals(object obj)
        {
            Edge other = obj as Edge;
            return other != null && this.uniqueId == other.uniqueId;
        }

        public override int GetHashCode()
        {
            return uniqueId;
        }
    }
