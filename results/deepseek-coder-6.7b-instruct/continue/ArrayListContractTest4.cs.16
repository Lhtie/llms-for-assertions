            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.IsTrue(New_Ret >= Old_arrListCount);
            Assert.IsTrue(New_arrListCount > Old_arrListCount);
            Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
            Assert.AreEqual(New_arrListContainsX, true);
        }
    }
