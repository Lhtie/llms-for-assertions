using KPMG_Test_Task.Models;
using KPMG_Test_Task.Services;

namespace KPMG_Test_Task
{
    class Program
    {
        static void Main(string[] args)
        {
            var database = new Database
            {
                Connection = "mongodb://localhost:27017",
                DatabaseName = "kpmg_db"
            };

            var mongoDBService = new MongoDBService(database);
            var jsonParseService = new JsonParseService();

            var filePath = "file.json";

            var usersList = jsonParseService.GetJsonFromFile(filePath);
            mongoDBService.CreateCollectionAndInsertData(usersList);

            Console.WriteLine("Data successfully stored to MongoDB!");
            Console.ReadKey();
        }
    }
