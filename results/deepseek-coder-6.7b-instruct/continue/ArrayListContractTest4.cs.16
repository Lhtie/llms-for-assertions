﻿using System;
using KPMG_Test_Task.Models;
using KPMG_Test_Task.Models.JsonClasses;
using MongoDB.Driver;

namespace KPMG_Test_Task.Services
{
    public class MongoDBService
    {
        private readonly IMongoDatabase _database;

        public MongoDBService(Database settings)
        {
            var client = new MongoClient(settings.Connection);
            _database = client.GetDatabase(settings.DatabaseName);
        }

        public void CreateCollectionAndInsertData(UsersList usersList)
        {
            var collection = _database.GetCollection<UsersList>("users");
            collection.InsertOne(usersList);
        }
    }
}

