}﻿class Program 
{
    static void Main() 
    {
        string[] names=new string[5];
        names[0] = "Micheal Jackson";
        names[1] = "Paul McCartney";
        names[2] = "John Lennon";
        names[3] = "George Harrison";
        names[4] = "Ringo Star";

        Bubblesort(names);

        Console.WriteLine("Sorted names: ");
        foreach(var name in names) 
        {
            Console.WriteLine(name);
        }
    }
    private static void Bubblesort(string[] arr) 
    {
        int n = arr.Length;
        for (int i = 0; i < n-1; i++)             
        {
            for (int j = 0; j < n-i-1; j++)
            {
                if (arr[j] > arr[j+1])
                {
                    // swap
                    string temp = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = temp;
                }
            }
        }
    }
}﻿using System;
public class Overloading
{
    public static int Add(int num1, int num2)
    {
        return num1 + num2;
    }
  
    public static double Add(double num1, double num2)
    {
        return num1 + num2;
    }
    
    public static int Add(int num1, int num2, int num3)
    {
        return num1 + num2 + num3;
    }
    public static void Main(String[] args)
    {
        int sum1 = Add(10, 20);
        Console.WriteLine("Intiger sum: " + sum1);
       
        double sum2 = Add(10.5, 20.5);
        Console.WriteLine("Double sum: " + sum2);
        
        int sum3 = Add(10, 20, 30);
        Console.WriteLine("Intiger sum with 3 parameters: " + sum3);
    }
}
//This is an example of method overloading in C#, multiple methods of the same name can be implemented such that their parameter list differs in type, length, or order. That's why they are known as Method Overloading. It's a concept of Polymorphism.

//In method overloading, we increase the flexibility of the code by allowing a class to have two or more methods with the same name, if we can differentiated them based on different parameters.

//Main advantage is if we ever need to change the implementation, we won't have to change the logic of our code (modifying the main program or the user interface). We can simply alter/expand the number of parameters or their data type.
//And it is also good practice to make methods overload with slight changes in parameters.﻿class Program
