using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace MileStone3_C_Sharp
{
    class Person
    {
        // declaring private member varibles
        private string name;
        private string address;
        private string email;
        private DateTime dateOfBirth;

        // declaring properties
        public string Name
        {
            get { return this.name; }
            set { this.name = value; }
        }
        public string Address
        {
            get { return this.address; }
            set { this.address = value; }
        }
        public string Email
        {
            get { return this.email; }
            set { this.email = value; }
        }
        public DateTime DateOfBirth
        {
            get { return this.dateOfBirth; }
            set { this.dateOfBirth = value; }
        }
        // Person class constructor
        public Person(string name, string address, string email, DateTime dateOfBirth)
        {
            this.name = name;
            this.address = address;
            this.email = email;
            this.dateOfBirth = dateOfBirth;
        }

        // overriding the toString() method to represent the object in human-friendly format
        public override string ToString()
        {
            return String.Format($"Name: {name} - Address: {address} - Email: {email} - Date of birth: {dateOfBirth}");
        }
    }
}﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace MileStone3_C_Sharp
{
    class PersonCollection : IEnumerable<Person>
    {
        // Initialize list of type Person.
        private List<Person> personList = new List<Person>();

        // indexer so we can access personList as an array
        public Person this[int index]
        {
            get { return personList[index]; }
            set { personList[index] = value; }
        }

        // Adds a person to the array list/
        public void AddPerson(Person p)
        {
            personList.Add(p);
        }

        // Remove a person from the array list
        public bool RemovePerson(Person p)
        {
            return personList.Remove(p);
        }

        // Returns the number of persons in the collection.
        public int Count
        {
            get { return personList.Count; }
        }

        // Clear all persons from the collection.
        public void ClearPersons()
        {
            personList.Clear();
        }
