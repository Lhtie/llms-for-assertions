﻿using Microsoft.Pex.Framework;
using System.Collections;
using System.Diagnostics.Contracts;

namespace NUnitTestProject1
{
    [PexClass(typeof(ArrayListContractTest))]
    public class ArrayListContractTest
    {
        public void AddContract([PexAssumeUnderTest]ArrayList arrayList, int x)
        {
            AssumePrecondition.IsTrue(arrayList.Count < 5);

            int oldCount = arrayList.Count;
            arrayList.Add(x);
            int newCount = arrayList.Count;

            Contract.Assert(newCount > oldCount);
        }
    }
}

//VisualStudio_Code_Fix_Projects/NUnitTestProject1/CtorTest.cs
﻿using Microsoft.Pex.Framework;
using System;
using System.Collections;

namespace NUnitTestProject1
{
    public class CtorTest
    {
        public void Test([PexAssumeUnderTest]int capacity)
        {
            try
            {
                Assume.IsTrue(capacity >= 0);

                var arr = new ArrayList(capacity);
                Assume.IsTrue(arr.Count == 0 && arr.Capacity == capacity);

            }
            catch (Exception ex)
            {
                Assume.IsTrue(capacity < 0);
            }
        }
    }
}

