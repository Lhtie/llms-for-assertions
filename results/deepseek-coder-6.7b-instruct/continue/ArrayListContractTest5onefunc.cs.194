
		    int expected_last_index_of_element = New_arrListCount - 1;
		    PexAssert.AreEqual(expected_last_index_of_element, New_arrListLastIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in new array is either -1 (if x is less than zero), equal to old array size, or is within range of old array.
		    if (Old_x >= 0) {
			    PexAssert.IsTrue(New_arrListIndexOfX == Old_arrListCount || (New_arrListIndexOfX >=0 && New_arrListIndexOfX <= Old_arrListCount));
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains of x in new array is true
			    PexAssert.IsTrue(New_arrListContainsX);
		    } else {
			    PexAssert.IsTrue(New_arrListIndexOfX == -1);
			    PexAssert.IsFalse(New_arrListContainsX);

		    }

            //TODO: Add additional asserts here
        }

        [PexMethod]
        public void PUT_AddContract_Test([PexAssumeValid]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Count < 100, "max list size reached");
            AssumePrecondition.IsTrue(x >= -1000 && x <= 1000, "x is to high or to low");
            PUT_AddContract(arrList, x);
        }
    }
}

