            [PexAssumeUnderTest] ArrayList list,
            [PexAssumeValid] int value)
        {
            Contract.Ensures(list.Count == Contract.OldValue(list.Count) + 1);
            list.Add(value);
        }

        [PexMethod]
        public void Insert_ArrayList_Int32_Int32(
            [PexAssumeUnderTest] ArrayList list,
            [PexAssumeValid] int index,
            [PexAssumeValid] int value)
        {
            Contract.EnsuresOnThrow<ArgumentOutOfRangeException>(index < 0 || index > list.Count);
            list.Insert(index, value);
        }

        [PexMethod]
        public void Remove_ArrayList_Int32(
            [PexAssumeUnderTest] ArrayList list,
            [PexAssumeValid] int index)
        {
            Contract.EnsuresOnThrow<ArgumentOutOfRangeException>(index < 0 || index >= list.Count);
            Contract.Ensures(list.Count == Contract.OldValue(list.Count) - 1);
        }

