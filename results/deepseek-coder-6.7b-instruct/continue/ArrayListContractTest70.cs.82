    class Program
    {
        static void Main(string[] args)
        {
            var arrList = new ArrayList();

            arrList.Add(5);
            arrList.Add(10);
            arrList.Add(15);

            Console.WriteLine("Before any operations:");
            PrintList(arrList);

            arrList.Insert(1, 7);

            Console.WriteLine("After inserting 7 at position 1:");
            PrintList(arrList);

            arrList.Remove(15);

            Console.WriteLine("After removing 15:");
            PrintList(arrList);

            arrList[0] = 42;

            Console.WriteLine("After setting the first element to 42:");
            PrintList(arrList);

            Console.WriteLine("First element: " + arrList[0]);
            Console.WriteLine("Contains 7: " + arrList.Contains(7));
            Console.WriteLine("7 is at index: " + arrList.IndexOf(7));
            Console.WriteLine("Last index of 7: " + arrList.LastIndexOf(7));
        }

        static void PrintList(ArrayList arrList)
        {
            foreach (var item in arrList)
            {
                Console.Write(item + " ");
            }
            Console.WriteLine();
        }
    }
}

