﻿using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListNunitTest
    {

        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            Assert.AreEqual(0, arrList.Count);
            int ret = arrList.Add(1);
            Assert.AreEqual(1, ret);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(true, arrList.Contains(1));
        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
            arrList.Remove(1);
            Assert.AreEqual(0, arrList.Count);
            Assert.AreEqual(false, arrList.Contains(1));
        }

        [Test]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            arrList.Insert(1, 10);
            Assert.AreEqual(4, arrList.Count);
            Assert.AreEqual(10, (int)arrList[1]);
            Assert.AreEqual(true, arrList.Contains(10));
            Assert.AreEqual(true, arrList.Contains(2));
        }

        [Test]
        public void TestSet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            arrList[1] = 10;
            Assert.AreEqual(10, (int)arrList[1]);
            Assert.AreEqual(true, arrList.Contains(10));
            Assert.AreEqual(true, arrList.Contains(2));
        }

        [Test]
        public void TestGet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            Assert.AreEqual(1, (int)arrList[0]);
            Assert.AreEqual(2, (int)arrList[1]);
            Assert.AreEqual(3, (int)arrList[2]);
        }

        [Test]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            Assert.AreEqual(true, arrList.Contains(1));
            Assert.AreEqual(true, arrList.Contains(2));
            Assert.AreEqual(true, arrList.Contains(3));
            Assert.AreEqual(false, arrList.Contains(4));
        }

        [Test]
        public void TestIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));
            Assert.AreEqual(2, arrList.IndexOf(3));
            Assert.AreEqual(-1, arrList.IndexOf(4));
        }
    }
