//Assignment 10/src/Assignment 10/Assignment 10/Program.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Assignment_10
{
    class Program
    {
        static void Main(string[] args)
        {
            string[] subjects = new string[] { "Mathematics", "Science", "English", "Social Studies", "Art",
                "History", "Geography", "Biology", "Chemistry", "Physics" };
            int[] marks = new int[10];
            int total = 0;

            for (int i = 0; i < 10; i++)
            {
                Console.Write("Enter marks for " + subjects[i] + ": ");
                marks[i] = Convert.ToInt32(Console.ReadLine());
                total += marks[i];
            }

            double average = total / 10.0;
            Console.WriteLine("Average marks: " + average);

            Console.WriteLine("Press any key to continue...");
            Console.ReadKey();
        }
    }
}

//Assignment 12/src/Assignment 12/Program.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Assignment_12
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Please enter a string");
            string userString = Console.ReadLine();

            int vowels = 0;
            int consonants = 0;
            int digits = 0;
            int specialCharacters = 0;

            foreach(char c in userString)
            {
                if("aeiouAEIOU".Contains(c))
                {
                    vowels++;
                }
                else if ("bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ".Contains(c))
                {
                    consonants++;
                }
                else if ("0123456789".Contains(c))
                {
                    digits++;
                }
                else
                {
                    specialCharacters++;
                }
            }

            Console.WriteLine("Vowels: " + vowels);
            Console.WriteLine("Consonants: " + consonants);
            Console.WriteLine("Digits: " + digits);
            Console.WriteLine("Special Characters: " + specialCharacters);

            Console.WriteLine("Press any key to continue...");
            Console.ReadKey();
        }
    }
}

//Assignment 13/src/Assignment 13/Program.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Assignment_13
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Please enter a string:");
            string userString = Console.ReadLine();

            bool isPalindrome = true;

            for (int i = 0; i < userString.Length / 2; i++)
            {
                if (userString[i] != userString[userString.Length - 1 - i])
                {
                    isPalindrome = false;
                    break;
                }
            }

            Console.WriteLine("Is the string a palindrome? " + (isPalindrome ? "Yes" : "No"));

            Console.WriteLine("Press any key to continue...");
            Console.ReadKey();
        }
    }
}

