//C#/Test/ArrayList.Test/ArrrayListUnitTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using PexAPIWrapper;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListUnitTest
    {
        [Test, PexMethod]
        public void Pex_Add_Test([PexAssumeUnderTest] ArrayList list, int val)
        {
            AssumePrecondition.IsNotNull(list);

            int oldCount = list.Count;

            list.Add(val);

            Assert.AreEqual(oldCount + 1, list.Count);
            Assert.AreEqual(val, list[oldCount]);
        }

        [Test, PexMethod]
        public void Pex_Insert_Test([PexAssumeUnderTest] ArrayList list, int index, int val)
        {
            AssumePrecondition.IsTrue(index <= list.Count && index >= 0);
            AssumePrecondition.IsNotNull(list);

            int oldCount = list.Count;

            list.Insert(index, val);

            Assert.AreEqual(oldCount + 1, list.Count);
            Assert.AreEqual(val, list[index]);
        }

        [Test, PexMethod]
        public void Pex_RemoveAt_Test([PexAssumeUnderTest] ArrayList list, int index)
        {
            AssumePrecondition.IsTrue(index < list.Count && index >= 0);
            AssumePrecondition.IsNotNull(list);

            int oldCount = list.Count;
            int oldValue = (int)list[index];

            list.RemoveAt(index);

            Assert.AreEqual(oldCount - 1, list.Count);
            Assert.IsFalse(list.Contains(oldValue));
        }

        [Test, PexMethod]
        public void Pex_Remove_Test([PexAssumeUnderTest] ArrayList list, int value)
        {
            AssumePrecondition.IsNotNull(list);

            int oldCount = list.Count;

            list.Remove(value);

            Assert.IsTrue(oldCount >= list.Count);
            Assert.IsFalse(list.Contains(value));
        }
    }
}

