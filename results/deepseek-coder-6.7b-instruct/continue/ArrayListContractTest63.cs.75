
        }
    }
}

//Tests/ArrayList/ArrayListTest/ArrayListTest_GetAndSet.cs
﻿using System;
using NUnit.Framework;
using ArrayList;
using Microsoft.Pex.Framework;

namespace ArrayListTest
{

    [TestFixture]
    public class ArrayListTest_GetAndSet
    {
        [Test]
        [PexMethod]
        public void Test_GetAndSet([PexAssumeUnderTest]ArrayList arrList, [PexAnyInt]int x, [PexArrayRange(typeof(int), 1, 10)]int[] indices)
        {
            arrList.Add(x);
            foreach (int index in indices)
            {
                try
                {
                    arrList[index] = x;
                    Assert.AreEqual(x, arrList[index]);
                    Assert.IsTrue(arrList.Contains(x));
                }
                catch (IndexOutOfRangeException e)
                {
                    Assert.Fail("Index out of range at " + index);
                }
            }
        }
    }
}

//Tests/ArrayList/ArrayListTest/ArrayListTest_Insert.cs
﻿using System;
using NUnit.Framework;
using ArrayList;
using Microsoft.Pex.Framework;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest_Insert
    {
        [Test]
        [PexMethod]
        public void Test_Insert([PexAssumeUnderTest]ArrayList arrList, [PexAnyInt]int x, [PexArrayRange(typeof(int), 1, 10)]int[] indices)
        {
            foreach (int index in indices)
            {
                arrList.Insert(index, x);
                Assert.AreEqual(x, arrList[index]);
                Assert.IsTrue(arrList.Contains(x));
                Assert.AreEqual(index + 1, arrList.IndexOf(x));
            }
        }
    }
}

//Tests/ArrayList/ArrayListTest/ArrayListTest_Remove.cs
﻿using System;
using NUnit.Framework;
using ArrayList;
using Microsoft.Pex.Framework;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest_Remove
    {
        [Test]
        [PexMethod]
        public void Test_Remove([PexAssumeUnderTest]ArrayList arrList, [PexAnyInt]int x)
        {
            arrList.Add(x);
            arrList.Remove(x);
            Assert.IsFalse(arrList.Contains(x));
            Assert.AreEqual(-1, arrList.IndexOf(x));
        }
    }
}

//Tests/BasicCalculation/Calculator/Calculator.cs
﻿using System;
using Microsoft.Pex.Framework;

namespace Calculator
{
    [PexClass(typeof(int))]
    public class Calculator
    {
        public int Add(int a, int b)
        {
            return a + b;
        }

        public int Subtract(int a, int b)
        {
            return a - b;
        }

        public int Multiply(int a, int b)
        {
            return a * b;
        }

        public int Divide(int a, int b)
        {
            if (b != 0)
                return a / b;
            else
                return 0;
        }
    }
}

