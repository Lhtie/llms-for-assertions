    # an assertion that width of r is positive
    assert(r.lin > 0)
    # an assertion that mat of r is a sum of heigth and width plus 2
    assert(r.mat == r.exp + r.lin + 2)

    print('Rectangle is:\n')
    for i in range(r.exp):
        if i == 0 or i == r.exp - 1:
            print(r.mat*'*')
        else:
            print('*'+(r.lin-2)*' '+'*')


