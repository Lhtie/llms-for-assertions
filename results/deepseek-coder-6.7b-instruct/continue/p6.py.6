# A function that checks the validity of a rectangle's parameters and returns an object with its parameters
class Rectangle():
    def __init__(n, m):
        self.exp = n  # this is how tall
        self.mat = n+m+2
        self.lin = m  # this is how wide

    def is_valid(self):
        return self.exp > 0 and self.lin > 0 and self.exp * self.lin == self.mat


def create_rectangle(n, m):
    r = Rectangle(n, m)
    if r.is_valid():
        return r
    else:
        raise ValueError("Invalid rectangle parameters")


