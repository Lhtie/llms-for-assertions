class InsufficientFundsError(Exception):
    pass

def transfer_new(frm, to, amnt):
    balance = sum([account.money for account in frm.accounts])
    if balance < amnt:
        raise InsufficientFundsError("insufficient balance, current balance is: {}".format(balance))
    # logic same as previous but using frm.accounts and to.accounts as indices instead of enumerate
    for i, fraccount in enumerate(frm.accounts):
        if fraccount.money >= amnt:
            fraccount.money -= amnt
            to.accounts[i].money += amnt
            return 
        else:
            amnt -= fraccount.money
            fraccount.money = 0
            to.accounts[i].money += amnt
            
try:
    transfer_new(p1, p2, 200)  # will fail
except InsufficientFundsError as e:
    print("Caught error: ", e)

try:
    transfer_new(p1, p2, 60)  # will succeed
except Exception as e:
    print("Caught error: ", e)
    # this will not executed because the function is called within a 'try' block
    print("But this won't execute") 

"""
Note that `try` and `except` will only catch exceptions that are raised "within" the `try` block. 
Here is how you would usually catch an exception that isn't necessarily caught within the `try` block. 
"""
try:
    transfer_new(p2, p1, 50)  # will fail because Alice has no money
except InsufficientFundsError as e:
    print("Caught error: ", e)
