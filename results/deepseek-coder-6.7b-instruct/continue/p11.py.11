    arr = list(map(int,sys.stdin.readline().split()))

    bit = BIT(n)
    for i in range(n): # O(nlogn) time
        bit.update(i,arr[i])

    ans = bit.range_query(0,n-1)
    print('Summation of elements:',ans)

    bit.update(0,1) # O(logn) time to update 0-indexed element
    ans = bit.range_query(0,n-1)
    print('Summation of elements after update:',ans)from collections import defaultdict
