def transfer(frm, to, amnt):
    if amnt > sum(acc.money for acc in frm):
        print("Not enough money in from-accounts to complete the transaction")
        return (frm, to)
    else:
        for acc_from in frm:
            acc_from.money -= amnt // len(frm)
            for acc_to in to:
                acc_to.money += amnt // len(frm)
        return (frm, to)

# This does not provide correct results in case of unequal distribution of amount, as amnt is divided equally among all accounts.
# Need to ensure equal distribution if balances in all accounts are less than amount to be transferred.


def transfer(frm, to, amnt):
    total_from = sum(acc.money for acc in frm)
    if amnt > total_from:
        print("Not enough money in from-accounts to complete the transaction")
        return (frm, to)
    else:
        left = amnt
        accounts = sorted(frm + to, key=lambda acc: acc.money)
        for acc in accounts:
            if left == 0:
                break
            transfer_amount = min(acc.money, left)
            acc.money -= transfer_amount
            left -= transfer_amount
        for acc in to:
            acc.money += amnt // len(to)
        return (frm, to)

# This handles unequal distribution as well as ensures correct amount gets transferred.
# This code sorts the accounts based on their balance and then tries to distribute the desired amount equally between the from and to accounts.
# If a certain account has more money than remaining need, it transfers all available amount; if not, it transfers its money amount.
# After all attempts, remaining amount gets distributed equally among to accounts.
# This assumes, from and to are list of accounts (Account)
# In a real banking use case we would need to add thread-safety and transaction management to ensure balance is never negative after transaction.
# Also it doesn't make sense to balance money on a different accounts unless it's transfer-wise fair.
