from typing import List


class Account(ABC):
    @abstractmethod
    def __init__(self, money):
        pass

    @abstractmethod
    def update(self, diff):
        pass

    @abstractmethod
    def balance(self):
        pass

class CheckingAccount(Account):
    def __init__(self, money):
        self.money = money

    def update(self, diff):
        self.money += diff

    def balance(self):
        return self.money

class SavingsAccount(Account):
    def __init__(self, money):
        self.money = money

    def update(self, diff):
        self.money += diff

    def balance(self):
        return self.money

class Person:
    def __init__(self, name: str, accounts: List[Account]):
        self.name = name
        self.accounts = accounts

    def total_balance(self):
        return sum(a.balance() for a in self.accounts)

    def change_balance(self, diff: int):
        for a in self.accounts:
            a.update(diff)


peter = Person("Peter", [CheckingAccount(200), CheckingAccount(-100), SavingsAccount(3000)])
print(peter.total_balance())  # 3100
peter.change_balance(50)
print(peter.total_balance())  # 3150

