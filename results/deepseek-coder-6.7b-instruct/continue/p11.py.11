                    account_to.money += amnt
                    total_amnt_to += amnt
                    amnt = 0
                if amnt == 0: 
                    break

    print(f"Transferred {amnt} from {frm.name} to {to.name}")

    # an assertion using "assert .*?" that @@@ total balance of all "to" accounts equals to total before transfer + "amnt"

    assert sum([a.money for a in to.accounts]) == total_amnt_to + amnt, f"Could not transfer all funds to {to.name}"

