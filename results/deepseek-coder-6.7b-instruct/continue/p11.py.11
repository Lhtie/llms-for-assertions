    assert not sum([acc.money for acc in frm.accounts]) < amnt

    for frm_acc in frm.accounts:
        if frm_acc.money >= amnt: 
            frm_acc.money -= amnt
            for to_acc in to.accounts:
                to_acc.money += amnt
            break

p1 = Person("Alice")
p2 = Person("Bob")

transfer(p1, p2, 20)

from itertools import chain

assert(sum(chain(*[acc.money for acc in p1.accounts])))
assert(sum(chain(*[acc.money for acc in p2.accounts])))

print("All clear.")

# The above code assumes that there are at least as many accounts in the 'from' Person as the amount you are trying to transfer.
# This might not always be the case, especially when we are dealing with multi-threaded code.
# Therefore, a better and thread-safe way would be to lock the accounts while making the transfer then unlock them:

import threading

def transfer_threadsafe(lock, frm, to, amnt):
    with lock:
        transfer(frm, to, amnt)

lock = threading.Lock()
transfer_threadsafe(lock, p1, p2, 20)
# then check the accounts again
assert(sum(chain(*[acc.money for acc in p1.accounts])))
assert(sum(chain(*[acc.money for acc in p2.accounts])))
print("All clear in a thread-safe way.")

# We do not use thread handling here, to keep this notebook simpler and more focus on concurrency control.

# For a multi-threaded case, you should not only take into account that several transfers might happen concurrently, but you should also take into account the order of transactions
# Depending on the order of events, we need to ensure a right order of the transactions (which is called 'strong consistency') or be able to recognize the situation when it's not possible.
# This requires a more advanced topic, and we don't cover it here simply for simplicity.
