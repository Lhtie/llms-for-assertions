class BIT: #O(n) space 
    def __init__(self,n):
        self.n = n
        self.tree = [0]*(n+1)
        self.arr = [0]*n

    def update(self,i,val):
        dif = val-self.arr[i]
        self.arr[i] = val
        i+=1
        while i<=self.n:
            self.tree[i]+=dif
            i+=i&(-i)

    def query(self,i):
        s = 0
        while i>0:
            s+=self.tree[i]
            i-=i&(-i)
        return s

    def range_query(self,i,j):
        return self.query(j)-self.query(i-1)

if __name__ == "__main__":
