    # an assertion using "assert .*?" that "frm" and "to" are not the same person

    assert frm != to, 'The "from" person and "to" person should not be the same.'

    from_total = sum([acc.money for acc in frm.accounts])

    # "frm" transfers money to "to" by reducing his total money by "amnt"
    for acc in frm.accounts:
        if acc.money <= from_total:
            from_total -= acc.money
            acc.money = 0
        else:
            acc.money -= (acc.money - from_total)
            from_total = 0
            break
    # "to" gets money by adding to his total money "amnt"
    to.accounts[0].money += amnt


