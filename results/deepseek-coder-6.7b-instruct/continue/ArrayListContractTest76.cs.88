using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace Monads.Tests
{
	[TestClass]
	public class Given_a_compose_function
	{
		private static Func<string, string> f1 = s => s + "1";
		private static Func<string, string> f2 = s => s + "2";
		private static Func<string, string> composed;

		[TestInitialize]
		public void Setup()
		{
			composed = f1.Compose(f2);
		}

		[TestMethod]
		public void It_should_compose_two_functions_together()
		{
			const string input = "Hello, ";
			const string output = input + "12";
			Assert.AreEqual(output, composed(input));
		}

		[TestMethod]
		public void It_should_support_chained_composition()
		{
			const string input = "Hello, ";
			const string output = input + "123";
			var composed2 = composed.Compose(s => s + "3");
			Assert.AreEqual(output, composed2(input));
		}
	}
}// Copyright 2009-2010 Joshua Blake
// 
