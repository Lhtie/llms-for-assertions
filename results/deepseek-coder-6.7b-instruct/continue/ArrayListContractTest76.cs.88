using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        ArrayList arrayList;

        [SetUp]
        public void Init()
        {
            arrayList = new ArrayList();
        }

        [Test]
        public void TestAdd()
        {
            arrayList.Add(1);
            Assert.AreEqual(1, arrayList.Count);
        }

        [Test]
        public void TestRemove()
        {
            arrayList.Add(1);
            arrayList.Remove(1);
            Assert.AreEqual(0, arrayList.Count);
        }

        [Test]
        public void TestIndexOf()
        {
            arrayList.Add(1);
            Assert.AreEqual(0, arrayList.IndexOf(1));
        }

        [Test]
        public void TestLastIndexOf()
        {
            arrayList.Add(1);
            arrayList.Add(1);
            Assert.AreEqual(1, arrayList.LastIndexOf(1));
        }

        [Test]
        public void TestInsert()
        {
            arrayList.Insert(0, 1);
            Assert.AreEqual(1, arrayList[0]);
        }

        [Test]
        public void TestSet()
        {
            arrayList.Add(1);
            arrayList[0] = 2;
            Assert.AreEqual(2, arrayList[0]);
        }

        [Test]
        public void TestGet()
        {
            arrayList.Add(1);
            Assert.AreEqual(1, arrayList.Get(0));
        }

        [Test]
        public void TestContains()
        {
            arrayList.Add(1);
            Assert.IsTrue(arrayList.Contains(1));
        }
    }
