//code/ReflectionSample/Program.cs
﻿using System;
using System.Reflection;

namespace ReflectionSample
{
    class Program
    {
        static void Main(string[] args)
        {
            Type t = typeof(Person);

            Console.WriteLine("FullName: " + t.FullName);
            Console.WriteLine("Namespace: " + t.Namespace);
            Console.WriteLine("Type: " + t.BaseType);

            Console.WriteLine("\nMethods of Person Class: ");
            MethodInfo[] methods = t.GetMethods();
            foreach (MethodInfo m in methods)
            {
                Console.WriteLine(m.Name);
            }
        }
    }

    public class Person{
        string name;
        int age;

        public Person(string name, int age){
            this.name = name;
            this.age = age;
            Console.WriteLine("A new person object is created");
        }

        public void Display(){
            Console.WriteLine("Name: "+name+" Age: "+ age);
        }

    }
}

//code/ReflectionWithAttributes/Person.cs
﻿using System;

namespace ReflectionWithAttributes
{
    public class Person{
        private string _name;

        [PropertyDescription("This is a simple description for the Age property")]
        public int Age { get; set; }

        public string Name {
            get{
                return _name;
            }

            set{
                _name = value;
                Console.WriteLine("Name is set to " + value);
            }
        }

        [Obsolete("This method is deprecated, use the DisplayNew method instead.")]
        public void Display(){
            Console.WriteLine("Name: "+_name+" Age: "+ Age);
        }

        public void DisplayNew(){
            Console.WriteLine("New Display Method: Name: "+_name+" Age: "+ Age);
        }
    }
}

