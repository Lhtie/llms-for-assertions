        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeRange(0, int.MaxValue)]int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexAtOldIndex = (int)arrList[index];
            bool Old_arrListContainsIndexOfOldIndex = arrList.Contains(Old_arrListIndexAtOldIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsIndexOfOldIndex = arrList.Contains(Old_arrListIndexAtOldIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
