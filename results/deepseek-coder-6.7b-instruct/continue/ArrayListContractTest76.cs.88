//UnitTests/ArrayList/ArrayListTests.cs
﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayListTests
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void TestInitialize()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            Assert.AreEqual(0, arrayListInt.Count);
        }
        
        [TestMethod]
        public void TestInsert()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(10);
            Assert.AreEqual(1, arrayListInt.Count);
            Assert.AreEqual(10, arrayListInt[0]);
        }

        [TestMethod]
        public void TestAdd()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            Assert.AreEqual(3, arrayListInt.Count);
            Assert.AreEqual(1, arrayListInt[0]);
            Assert.AreEqual(2, arrayListInt[1]);
            Assert.AreEqual(3, arrayListInt[2]);
        }

        [TestMethod]
        public void TestRemove()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(10);
            arrayListInt.Remove(10);
            Assert.AreEqual(0, arrayListInt.Count);
        }

        [TestMethod]
        public void TestInsertAtIndex()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            arrayListInt.Insert(1, 10);
            Assert.AreEqual(4, arrayListInt.Count);
            Assert.AreEqual(10, arrayListInt[1]);
        }

        [TestMethod]
        public void TestSetAtIndex()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            arrayListInt[1] = 10;
            Assert.AreEqual(10, arrayListInt[1]);
        }

        [TestMethod]
        public void TestContains()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            Assert.IsTrue(arrayListInt.Contains(2));
            Assert.IsFalse(arrayListInt.Contains(5));
        }

        [TestMethod]
        public void TestIndexOf()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            Assert.AreEqual(1, arrayListInt.IndexOf(2));
            Assert.AreEqual(-1, arrayListInt.IndexOf(5));
        }

        [TestMethod]
        public void TestLastIndexOf()
        {
            ArrayList<int> arrayListInt = new ArrayList<int>();
            arrayListInt.Add(1);
            arrayListInt.Add(2);
            arrayListInt.Add(2);
            arrayListInt.Add(3);
            Assert.AreEqual(2, arrayListInt.LastIndexOf(2));
            Assert.AreEqual(-1, arrayListInt.LastIndexOf(5));
        }
    }
}

