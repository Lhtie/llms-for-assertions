--------------------            Debug.Assert(New_Ret || Old_arrListIndexOfX >= New_arrListIndexOfX);
--------------------------------------------------------------------------------            Debug.Assert(New_Ret ? New_arrListIndexOfX >= 0 : Old_arrListIndexOfX == -1);
----------------------------------------            Debug.Assert( Old_arrListIndexOfX >=0 && ( (New_Ret == false && New_arrListIndexOfX < Old_arrListIndexOfX ) ||(New_Ret == true  && New_arrListIndexOfX >= Old_arrListIndexOfX )) );
