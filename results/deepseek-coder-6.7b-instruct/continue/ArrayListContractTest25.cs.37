//ArrayList/Test/ArrayListTest.cs
﻿using System;
using System.Collections;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [PexMethod]
        public void PUT_AddTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "After calling Add(), expected list count to increase by one");
            Assert.AreEqual(x, arrList[arrList.Count - 1], "After adding a value, expected it to be at the end of the list");
	    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX, "After adding a value, IndexOf() shouldn't affect position of the value");
	    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, "After adding a value, LastIndexOf() shouldn't affect position of the value");
	    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX, "After adding a value, Contains() should return true");

        }

        [Test]
        [PexMethod]
        public void PUT_RemoveTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount, "After calling Remove(), expected list count to decrease by one");
            Assert.AreEqual(-1, arrList.IndexOf(x), "After removing a value, expected IndexOf() to return -1");
	    Assert.AreEqual(-1, arrList.LastIndexOf(x), "After removing a value, expected LastIndexOf() to return -1, when value is not found");
	    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX, "After removing a value, Contains() should return false");
	}

