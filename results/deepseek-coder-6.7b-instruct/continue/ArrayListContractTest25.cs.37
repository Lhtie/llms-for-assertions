    public partial class Counter : ComponentBase
    {
        [Inject]
        IJSRuntime JSRuntime { get; set; }

        private string ResultText { get; set; } = "Result?";

        private async Task<bool> UpdateCount(int amount)
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/calculationEngineService.js");

            var resultValue = await module.InvokeAsync<string>("updateCount", amount, ResultText);

            ResultText = await module.InvokeAsync<string>("getDisplayText", resultValue);

            return true;
        }

        protected override void OnInitialized()
        {
            JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/calculationEngineService.js").Result.InvokeVoidAsync("initializeCounter");
        }
    }
