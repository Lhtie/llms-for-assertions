﻿using System;
using System.Text;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListsUnitTests
    {

        [Test]
        [PexMethod]
        public void PUT_AddUnitTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int oldCount = arrList.Count;
            arrList.Add(x);
            Assert.AreEqual(oldCount + 1, arrList.Count);
            Assert.IsTrue(arrList.Contains(x));
        }
    
        [Test]
        [PexMethod]
        public void PUT_RemoveUnitTest([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            arrList.Add(x);
            int oldCount = arrList.Count;
            arrList.Remove(x);
            Assert.AreEqual(oldCount - 1, arrList.Count);
            Assert.IsFalse(arrList.Contains(x));
        }

        [Test]
        [PexMethod]
        public void PUT_InsertUnitTest([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int oldCount = arrList.Count;
            arrList.Insert(index, x);
            Assert.AreEqual(oldCount + 1, arrList.Count);
            Assert.IsTrue(arrList.Contains(x));
            Assert.AreEqual(index, arrList.IndexOf(x));
        }
    }
}﻿using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Move : MonoBehaviour
{
    public float Speed;
    public float JumpForce;
    private Rigidbody2D rb;
    private bool isJumping = false;
    private bool grounded = true;
    public Transform GroundCheck;
    public float CheckRadius;
    public LayerMask WhatIsGround;

    private Animator anim;
    private SpriteRenderer sr;
    private static readonly int Speed_i = Animator.StringToHash("speed");

    // Start is called before the first frame update
    void Start()
    {
        rb = GetComponent<Rigidbody2D>();
        anim = GetComponent<Animator>();
        sr = GetComponent<SpriteRenderer>();
    }

    private void FixedUpdate()
    {
        grounded = Physics2D.OverlapCircle(GroundCheck.position, CheckRadius, WhatIsGround);
    }

    // Update is called once per frame
    void Update()
    {
        float moveX = Input.GetAxis("Horizontal");
        rb.velocity = new Vector2(moveX * Speed, rb.velocity.y);
        
        if (moveX < 0)
        {
            sr.flipX = true;
        } else if (moveX > 0)
        {
            sr.flipX = false;
        }

        anim.SetFloat(Speed_i, Math.Abs(moveX));
        
        if (Input.GetButtonDown("Jump") && grounded)
        {
            rb.velocity = new Vector2(rb.velocity.x, JumpForce*10f);
        }
    }
