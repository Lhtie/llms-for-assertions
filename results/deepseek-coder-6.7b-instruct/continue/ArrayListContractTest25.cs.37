    public partial class InstrumentedArrayList : List<object>
    {
        [PexInstrument] private new void Clear()
        {
            // Preconditions:
            PexAssert.IsNotNull(this);
            this.VerifyListState();

            // Code under test:
            base.Clear();

            // Postconditions:
            this.VerifyListState();
            PexAssert.AreEqual(0, this.Count);
        }
        
        [PexInstrument] private new int IndexOf(object item)
        {
            // Preconditions:
            PexAssert.IsNotNull(this);
            this.VerifyListState();
            if (item != null)
            {
                PexAssert.IsTrue(ObjectComparer.AreEqual(item, item));
            }

            // Code under test:
            int result = base.IndexOf(item);

            // Postconditions:
            if (item != null)
            {
                if (result >= 0 && result < this.Count)
                {
                    PexAssert.IsTrue(ObjectComparer.AreEqual(item, this[result]));
                }
                else
                {
                    PexAssert.IsTrue(this.IndexOf(item) != result);
                }
            }

            return result;
        }
        
        [PexInstrument] private new void Insert(int index, object item)
        {
            // Preconditions:
            PexAssert.IsNotNull(this);
            this.VerifyListState();
            if (item != null)
            {
                PexAssert.IsTrue(ObjectComparer.AreEqual(item, item));
            }
            PexAssert.IsTrue(index >= 0 && index <= this.Count);

            // Code under test:
            base.Insert(index, item);

            // Postconditions:
            this.VerifyListState();
            if (item != null)
            {
                PexAssert.IsTrue(ObjectComparer.AreEqual(item, this[index]));
                if (index < this.Count)
                {
                    PexAssert.IsTrue(ObjectComparer.AreEqual(item, this[index]));
                }
            }
            PexAssert.AreEqual(this.Count, this.Count);
        }
        
