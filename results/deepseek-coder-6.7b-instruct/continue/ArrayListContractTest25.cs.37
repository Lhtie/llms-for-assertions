﻿using Microsoft.VisualStudio.TestTools.UnitTesting;
using System;
using ArrayList;

namespace ProjectD.Test
{
    [TestClass]
    public class Tests
    {
        [TestMethod]
        public void TestArrayAdd()
        {
            ArrayList.ArrayList myArray = new ArrayList.ArrayList();
            myArray.Add(1);
            
            Assert.AreEqual(1, myArray.Count);
            Assert.AreEqual(1, myArray.Get(0));
        }

        [TestMethod]
        public void TestArrayRemove()
        {
            ArrayList.ArrayList myArray = new ArrayList.ArrayList();
            myArray.Add(1);
            myArray.Add(2);
            myArray.Add(3);
            myArray.Remove(2);

            Assert.AreEqual(2, myArray.Count);
            Assert.AreEqual(1, myArray.Get(0));
            Assert.AreEqual(3, myArray.Get(1));
        }

        [TestMethod]
        public void TestArrayInsert()
        {
            ArrayList.ArrayList myArray = new ArrayList.ArrayList();
            myArray.Add(1);
            myArray.Add(2);
            myArray.Add(4);
            myArray.Insert(1, 3);

            Assert.AreEqual(4, myArray.Count);
            Assert.AreEqual(1, myArray.Get(0));
            Assert.AreEqual(3, myArray.Get(1));
            Assert.AreEqual(2, myArray.Get(2));
            Assert.AreEqual(4, myArray.Get(3));
        }

        [TestMethod]
        public void TestArrayGet()
        {
            ArrayList.ArrayList myArray = new ArrayList.ArrayList();
            myArray.Add(1);
            myArray.Add(2);

            Assert.AreEqual(1, myArray.Get(0));
            Assert.AreEqual(2, myArray.Get(1));
        }
