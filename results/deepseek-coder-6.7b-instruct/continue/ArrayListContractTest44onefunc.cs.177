using System;

namespace Orleans.CodeGenerators.CSharp
{
    public static class Utils
    {
        public static string EscapeStringLiteral(string s)
        {
            if (string.IsNullOrWhiteSpace(s))
            {
                return $"\"{s}\"";
            }
            return $"\"{s.Replace("\"", "\\\"")}\"";
        }

        public static string DefaultValueExpression(Type t)
        {
            if (t.IsValueType)
            {
                return $"default({t.FullName})";
            }

            // For reference types, we just return null.
            return "null";
        }
    }
}

