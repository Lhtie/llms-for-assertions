	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index passed in is within the bounds of the array list
	    Debug.Assert(index >= 0 && index <= Old_arrListCount - 1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the new array size is equal to the old array size
	    Debug.Assert(New_arrListCount == Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the element at the given index in the array list is equal to the new returned value 
	    Debug.Assert(arrList[index].Equals(New_Ret));	
	}
    }
