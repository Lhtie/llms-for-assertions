    /// <summary>
    /// Manages grain activation lifecycle. 
    /// </summary>
    public interface IGrainActivationContext
    {
        /// <summary>
        /// Gets the grain identity key.
        /// </summary>
        Guid IdentityKey { get; }

        /// <summary>
        /// Gets the grain identity.
        /// </summary>
        IGrainIdentity Identity { get; }

        /// <summary>
        /// Gets the grain type.
        /// </summary>
        Type GrainType { get; }

        /// <summary>
        /// Gets the grain reference.
        /// </summary>
        IGrain Grain { get; }

        /// <summary>
        /// Gets the grain activation services.
        /// </summary>
        IServiceProvider GrainServices { get; }

        /// <summary>
        /// Gets a value indicating whether this instance isSiloInitializing.
        /// </summary>
        bool IsSiloInitializing { get; }

        /// <summary>
        /// Gets a value indicating whether this instance is grain initializing.
        /// </summary>
        bool IsGrainInitializing { get; }

        /// <summary>
        /// Gets the grain activation handle.
        /// </summary>
        GrainActivationHandle Handle { get; }

        /// <summary>
        /// Provides a way to notify the runtime when the grain activation is stopped.
        /// </summary>
        /// <param name="notification">The notification to send.</param>
        /// <returns>A Task which indicates the notification completion status.</returns>
        Task NotifyWhenActivationResumes(Func<Task> notification);
    }
