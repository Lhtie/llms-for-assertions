﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestAddingElements()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);

            Assert.AreEqual(3, arrList.Count);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
            Assert.IsTrue(arrList.Contains(3));
        }

        [Test]
        public void TestRemovingSpecificElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Remove(1);

            Assert.AreEqual(1, arrList.Count);
            Assert.IsFalse(arrList.Contains(1));
            Assert.IsTrue(arrList.Contains(2));
        }

        [Test]
        public void TestRemovingNonExistentElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Remove(1);

            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void TestInsertingElementAtSpecificIndex()
        {
            ArrayList arrList = new ArrayList();
            arrList.Insert(0, 1);
            arrList.Insert(1, 2);
            arrList.Insert(1, 3);

            Assert.AreEqual(3, arrList.Count);
            Assert.AreEqual(1, arrList[0]);
            Assert.AreEqual(3, arrList[1]);
            Assert.AreEqual(2, arrList[2]);
        }

        [Test]
        public void TestSettingElementAtIndex()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList[0] = 2;

            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(2, arrList[0]);
        }

        [Test]
        public void TestIndexOfElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);

            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));
        }

        [Test]
        public void TestLastIndexOfElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(2);

            Assert.AreEqual(0, arrList.LastIndexOf(1));
            Assert.AreEqual(2, arrList.LastIndexOf(2));
        }
    }
}﻿using System;

namespace ArrayList
{
    public class ArrayList
    {
        private object[] data;
        private int count;

        public ArrayList()
        {
            data = new object[16];
            count = 0;
        }

        public int Count
        {
            get { return count; }
        }

        public object this[int index]
        {
            get { return data[index]; }
            set { data[index] = value; }
        }

        public int Add(object obj)
        {
            if (count == data.Length)
            {
                IncreaseCapacity();
            }
            data[count] = obj;
            count++;
            return Count;
        }

        public void Insert(int index, object obj)
        {
            if (count == data.Length)
            {
                IncreaseCapacity();
            }
            Array.Copy(data, index, data, index + 1, count - index);
            data[index] = obj;
            count++;
        }

        public bool Contains(object obj)
        {
            return IndexOf(obj) != -1;--------------------        }

