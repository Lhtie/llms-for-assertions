using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestConstructor()
        {
            ArrayList arrList = new ArrayList();
            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void TestAddMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(true, arrList.Contains(1));
        }

        [Test]
        public void TestRemoveMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Remove(1);
            Assert.AreEqual(0, arrList.Count);
            Assert.AreEqual(false, arrList.Contains(1));
        }

        [Test]
        public void TestInsertMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Insert(0, 0);
            Assert.AreEqual(2, arrList.Count);
            Assert.AreEqual(0, arrList[0]);
            Assert.AreEqual(true, arrList.Contains(0));
        }

        [Test]
        public void TestSetMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList[0] = 0;
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(0, arrList[0]);
            Assert.AreEqual(true, arrList.Contains(0));
        }

        [Test]
        public void TestGetMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(1, arrList[0]);
        }

        [Test]
        public void TestContainsMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            Assert.AreEqual(true, arrList.Contains(1));
            Assert.AreEqual(false, arrList.Contains(0));
        }
    }
}

