}﻿using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;

public class GameController : MonoBehaviour
{
    // Start is called before the first frame update
    public void StartGame(int numberOfPlayers, Slider playerSpeed, Slider playerHealth, List<GameObject> playerPrefab)
    {
        // Save the player prefabs
        PlayerData.playerPrefab = playerPrefab;
        // Save number of players
        PlayerData.numberOfPlayers = numberOfPlayers;
        // Save player settings
        PlayerData.playerSpeed = playerSpeed.value;
        PlayerData.playerHealth = playerHealth.value;
        // Load the game scene
        UnityEngine.SceneManagement.SceneManager.LoadScene("Game");
    }
}﻿using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class PlayerData : MonoBehaviour
{
    public static int numberOfPlayers;
    public static float playerSpeed;
    public static float playerHealth;
    public static List<GameObject> playerPrefab;
}﻿using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Enemy : MonoBehaviour
{
    public float health;
    public float speed;
    public GameObject target;

    void Start()
    {
        // Set the Enemy's speed and health according to PlayerData values.
        speed = PlayerData.playerSpeed / 2;
        health = PlayerData.playerHealth / 2;
        // Set the target to be the first Player.
        target = GameObject.FindGameObjectsWithTag("Player")[0];
    }

    void Update()
    {
        // Move towards the target.
        Vector3 dir = (target.transform.position - transform.position).normalized;
        GetComponent<Rigidbody2D>().velocity = dir * speed;
    }

    public void TakeDamage(float damage)
    {
        // Take damage and destroy the enemy if they die.
        health -= damage;
        if (health <= 0)
            Destroy(gameObject);
    }
}﻿using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Spawner : MonoBehaviour
{
    public float spawnRate;
    public GameObject prefab;
    float nextSpawn = 0;

    void Update()
    {
        // Try to spawn at the designated spawn rate
        if (Time.time > nextSpawn)
        {
            nextSpawn = Time.time + spawnRate;
            Instantiate(prefab, transform.position, Quaternion.identity);
        }
    }
