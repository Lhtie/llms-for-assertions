A: I think you are missing the crucial part here. Your contract tests are not checking for a failing test case, they are checking for a valid test case. Hence, when you see the test case failing as per your contract tests, it would be expected as per the behaviour defined by your interface i.e., ArrayList.
If you are looking for test cases that are likely to not compile, you should use a combination of PexSetting(MaxConstraintSolutions=0) and a constraint where none of the parameters will be within the feasible range. 
The contract tests you wrote are looking for cases where the given inputs are expected to be valid, hence they will fail if the inputs are not.
If you want your test case to fail, you can put a constraint that will violate for an edge case, or maybe using null value as input etc. This will lead your tests to fail. 
Here is a part of code where you can customize it according to your need -
 [PexMethod]
    [PexSetting(MaxConstraintSolutions=0)] 
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(arrList !=null);

        int Old_arrListCount = arrList.Count;
        PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);

        if(arrList.Contains(x))
        {
            PexObserve.ValueForViewing("X is already in the List. Adding aborted",true);
        }
        else
        {
            int New_Ret = arrList.Add(x);
            PexObserve.ValueForViewing("X is added",true);
        }

    }--------------------        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue( index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            obj Old_obj = arrList[index];
            bool Old_arrListContainsOldObj = arrList.Contains(Old_obj);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsOldObj = arrList.Contains(Old_obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_obj", Old_obj);
            PexObserve.ValueForViewing("$old_arrList_contains_obj", Old_arrListContainsOldObj);
            PexObserve.ValueForViewing("$new_arrList_contains_obj", New_arrListContainsOldObj);

        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  index of removed element is still present in array
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  last index of removed element is still present in array
        }
    }
}

