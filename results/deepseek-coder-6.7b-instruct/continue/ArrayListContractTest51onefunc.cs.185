                                    Assert.IsTrue((New_Ret ? (New_arrListLastIndexOfX == arrList.Count) : (New_arrListLastIndexOfX == Old_arrListLastIndexOfX || New_arrListLastIndexOfX == -1)), "The last index of x in the new ArrayList should be the size of the old--------------------            try
            {
