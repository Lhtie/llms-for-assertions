```cs
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            Debug.Assert(New_Ret == true || New_arrListIndexOfX <= Old_arrListIndexOfX);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
        }
    }
}
```
In this code, the Debug.Assert statement is added after the calculation of 'Old_arrListIndexOfX' and 'New_arrListIndexOfX'. The assertion checks if the return value of the operation is true (i.e., the item 'x' is indeed in the list), or if the index of 'x' in the old list is less than or equal to that in the new list (i.e., 'x' has been added to the list). If this is not the case, an exception will be thrown indicating a bug in the code.
--------------------```cs
Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);

// @@@ If the return value is true, last index of x in old array is less than or equal to that in new array
Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);

// @@@ The count of the array list in the new state should be one more than in the old state if the element was added
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ If the return value is true, the new array list count is one less than the old array list count if the element was removed
if (New_Ret) {
    Debug.Assert(New_arrListCount == Old_arrListCount - 1);
}

// @@@ The IndexOf returned value in the new state should be nonnegative if the element was present in the old state
if (New_Ret) {
    Debug.Assert(New_arrListIndexOfX >= 0);
}

// @@@ The LastIndexOf returned value in the new state should be nonnegative if the element was present in the old state
if (New_Ret) {
    Debug.Assert(New_arrListLastIndexOfX >= 0);
}
```

