Debug.Assert(New_Ret == true && Old_arrListIndexOfX <= New_arrListIndexOfX);

// @@@ The count of the array list should be increased after inserting an element
Debug.Assert(Old_arrListCount < New_arrListCount);

// @@@ The index of x in the old array should be less than or equal to that in the new array
Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);

