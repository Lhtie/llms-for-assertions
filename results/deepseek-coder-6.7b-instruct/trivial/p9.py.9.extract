        assert acnt.money >= amnt, 'Some account of {} has more money than {}'.format(frm.name, amnt)--------------------    assert any(acnt.money >= amnt for acnt in frm.accounts), "@@@ some account of 'frm' has more money than 'amnt'"--------------------        assert (acnt.money >= amnt), "@@@ some account of " + frm.name + " has more money than " + str(amnt)--------------------        assert acnt.money <= 100, "Alice has more money than she initially has"--------------------    assert any(acnt.money >= amnt for acnt in frm.accounts), "@@@ Some account of 'frm' has more money than 'amnt'"--------------------        assert (acnt.money >= amnt), "@@@ some account of " + frm.name + " has more money than " + str(amnt)--------------------        assert (acnt.money >= amnt), f"Money in account ({acnt.money}) is less than the transfer amount ({amnt})"--------------------            assert all(x.money >= amnt for x in frm.accounts)--------------------        assert acnt.money >= amnt, "@@@ some account of 'frm' has more money than 'amnt'"--------------------        assert (acnt.money >= amnt), f"some account of {frm.name} has more money than {amnt}"--------------------