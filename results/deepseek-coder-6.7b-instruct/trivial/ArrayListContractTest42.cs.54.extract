Debug.Assert(New_Ret == Old_arrListCount + 1); // @@@ the array count increases after adding a new element--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------            Debug.Assert(New_containsNewRet, "The array does not contain the New_Ret value.");--------------------            Debug.Assert(arrList.Contains(New_Ret));--------------------Debug.Assert(New_Ret == arrList.Count); //@@@ the array contains New_Ret----------------------------------------Debug.Assert(New_Ret >= 0); // @@@ the array contains New_Ret--------------------Debug.Assert(New_containsNewRet); // @@@ the array contains New_Ret --------------------Debug.Assert(New_containsNewRet == true);  // @@@ the array contains New_Ret --------------------