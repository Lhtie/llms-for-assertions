Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "Count after adding element does not match");--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);  // @@@ Adding an item to the list increases the count--------------------Debug.Assert(Old_arrListCount < New_arrListCount); // @@@ last position of x in old and new lists are different--------------------            Debug.Assert(arrList != null);--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);  // @@@ last position of x in old and new lists are different--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX); // @@@ last position of x in old and new lists are different----------------------------------------            Debug.Assert(arrList != null);--------------------Debug.Assert(New_arrListCount > Old_arrListCount);--------------------Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX, "The last position of x in old and new lists should be different");--------------------