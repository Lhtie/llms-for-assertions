Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(New_Ret <= Old_arrListCount);--------------------Debug.Assert(New_Ret == -1 || Old_arrListCount >= New_Ret); // @@@ If the return value is non-negative, new array list's last index of x is <= old arrays count--------------------            Debug.Assert(New_Ret < 0 || New_arrListCount <= Old_arrListCount);------------------------------------------------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_Ret < 0 || New_arrListLastIndexOfX <= Old_arrListCount);----------------------------------------Debug.Assert(index >= 0 && index <= arrList.Count); // @@@ If the return value is non-negative, new array list's last index of x is <= old arrays count --------------------