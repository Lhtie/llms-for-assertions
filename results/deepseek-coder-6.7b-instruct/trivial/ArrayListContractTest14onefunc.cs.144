--------------------Here are the assert statements corresponding to the comments:

```cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;

            // Assert that the count of the array list is not the same as the last index of x in the old array list
            Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));

        }
    }
}

```
