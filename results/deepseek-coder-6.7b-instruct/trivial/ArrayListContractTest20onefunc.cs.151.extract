            Debug.Assert(Old_arrListIndexOfX >= -1, "The old index is not correct.");--------------------Debug.Assert(Old_arrListIndexOfX >= -1); // index of x in old array is geq minus 1--------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------            Debug.Assert(Old_arrListIndexOfX >= -1);--------------------Debug.Assert(Old_arrListIndexOfX < arrList.Count);--------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------Debug.Assert(Old_arrListIndexOfX >= -1, "The index of x in the old array is less than -1");--------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------Debug.Assert(Old_arrListIndexOfX >= -1); // index of x in old array is greater or equal to minus 1 --------------------