using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract_Assert()
        {
            // @@@ new array list has size at least as much as old array list plus one
            Assert.GreaterOrEqual(New_arrListCount, Old_arrListCount + 1);
        }

        [Test]
        public void PUT_RemoveContract_Assert()
        {
            // @@@ new array list has size at most as much as old array list 
            Assert.LessOrEqual(New_arrListCount, Old_arrListCount);
        }

        [Test]
        public void PUT_InsertContract_Assert()
        {
            // @@@ new array list has size at least as much as old array list plus one
            Assert.GreaterOrEqual(New_arrListCount, Old_arrListCount + 1);
            // @@@ new array list's first element is the element we inserted
            Assert.AreEqual(Old_x, New_arrListIndexOfX);
        }

        [Test]
        public void PUT_SetContract_Assert()
        {
            // @@@ new array list has size the same as old array list
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
            // @@@ array list contains the new value
            Assert.IsTrue(New_arrListContainsX);
        }

        [Test]
        public void PUT_GetContract_Assert()
        {
            // @@@ new array list contains the retrieved element
            Assert.IsTrue(New_containsNewRet);
        }

        [Test]
        public void PUT_ContainsContract_Assert()
        {
            // @@@ if old array list contained x, then new array list also contains x
            Assert.AreEqual(Old_arrListContainsX, New_Ret);
        }

        [Test]
        public void PUT_IndexOfContract_Assert()
        {
            // @@@ if x was in old array list, new array list's index of x should be at least as much as old index of x
            if (Old_arrListContainsX)
            {
                Assert.GreaterOrEqual(New_Ret, Old_arrListIndexOfX);
            }
            // @@@ if x was not in old array list, new array list's index of x should be -1
            else
            {
                Assert.AreEqual(-1, New_Ret);
            }
        }

        [Test]
        public void PUT_LastIndexOfContract_Assert()
        {
            // @@@ if x was in old array list, new array list's last index of x should be at least as much as old last index of x
            if (Old_arrListContainsX)
            {
                Assert.GreaterOrEqual(New_Ret, Old_arrListLastIndexOfX);
            }
            // @@@ if x was not in old array list, new array list's last index of x should be -1
            else
            {
                Assert.AreEqual(-1, New_Ret);
            }
        }

        [Test]
        public void PUT_CountContract_Assert()
        {
            // @@@ new count is the same as old count
            Assert.AreEqual(Old_arrListCount, New_Ret);
        }
    }
}
```
These assert statements are used to validate the behavior of the array list operations. They ensure that the array list behaves as expected. For example, the `PUT_AddContract_Assert` test ensures that the array list's count increases by at least one when an element is added.
The `PUT_RemoveContract_Assert` test ensures that the array list's count decreases by at most one when an element is removed. The assertions are typically based on the values you observe during your test.
