Debug.Assert(New_Ret < 0 && Old_arrListCount >= -1);--------------------Debug.Assert(New_Ret < 0 || New_arrListCount == Old_arrListCount - 1);--------------------Debug.Assert(New_Ret < 0, $"Error: If the return value is negative, old array's size is at least -1. But got {New_Ret} and Old_arrListCount is {Old_arrListCount}");--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount > New_Ret);--------------------            Debug.Assert((New_Ret < 0 && Old_arrListCount + 1 >= -New_Ret) || (New_Ret >= 0 && New_Ret < Old_arrListCount));--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount + 1 >= New_Ret);--------------------Debug.Assert(New_Ret < 0 || New_arrListCount >= -1);--------------------            Debug.Assert(New_Ret < 0 || Old_arrListCount + 1 >= New_Ret, $"If the return value is negative, old array's size must be at least -1, but old count is {Old_arrListCount} and new return value is {New_Ret}");--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount >= New_Ret - 1);--------------------        Debug.Assert(Old_arrListCount == New_arrListCount);--------------------