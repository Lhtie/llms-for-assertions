--------------------Here's the C# code that will output assert statements based on the comments:

```cs
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            Debug.Assert(New_Ret >= 0 || New_Ret == Old_arrListLastIndexOfX); // If the return value is non-negative, last index of x in old array is smaller than or equal to new array

            Debug.Assert(Old_arrListCount <= New_arrListCount); // Old array count should be less than or equal to new array count

            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX); // Last index of x in old array should be less than or equal to new array
        }
    }
}
```

This code uses `Debug.Assert()` statements to validate the conditions described in the comments. Note that the actual conditions may depend on the specifics of your code and data model. Please adjust accordingly.
