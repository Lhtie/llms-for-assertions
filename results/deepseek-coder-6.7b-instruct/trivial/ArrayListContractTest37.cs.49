        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            int New_Ret = (int)(arrList[index]);

            int New_arrListCount = arrList.Count;
            bool New_containsNewRet = arrList.Contains(New_Ret);

            Assert.AreEqual(Old_arrListCount, arrList.Count); // Confirm the count of arrList has not changed
            Assert.AreEqual(Old_index, index); // Confirm index is the same as in the original array
            Assert.IsTrue(New_containsNewRet); // Confirm New_Ret is in the arrList

        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList[index] = x;

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // Assert statements
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount); // In the new array, the count should be one more than the old count
            Assert.AreEqual(Old_x, x); // Check if the new value x is same as the original
            Assert.AreEqual(Old_index, index); // Check if the index is correct in the original array
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX); // The index of x in the new array should be same as in the old array
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX); // The last index of x in the new array should be same as in the old array
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX); // x should be in the new array

        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);

            // Assert statements
            Assert.IsTrue(New_arrListCount <= Old_arrListCount); // The new array list's count should not exceed old array list's count

        }
