alice = Person("Alice")
bob = Person("Bob")

# total balance of Alice's accounts
total_alice = sum([acnt.money for acnt in alice.accounts])

# assert that total Alice's account balances are greater than 0
assert(total_alice > 0)

# transfer 20 money from Alice to Bob's account
# this should fail since Alice's total balance is less than 20
assert(not transfer(alice, bob, 20))

# add more money to Alice's accounts
for acnt in alice.accounts:
    acnt.money += 50

# total balance of Alice's accounts after money addition
total_alice = sum([acnt.money for acnt in alice.accounts])

# assert that total Alice's account balances are greater than 20
assert(total_alice > 20)

# try to transfer 20 money from Alice to Bob's account
# this should pass since after money addition, Alice's total balance is now greater than 20
assert(transfer(alice, bob, 20))

# check if Bob's account has received money 
bob_money = sum([acnt.money for acnt in bob.accounts])
assert(bob_money > 0)
```
