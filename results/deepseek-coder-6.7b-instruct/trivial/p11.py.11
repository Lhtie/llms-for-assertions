```python
import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    total_money_from = sum([acnt.money for acnt in frm.accounts])
    assert total_money_from >= amnt, f"Total balance of all '{frm.name}' accounts is not greater than {amnt}."

    for acnt in frm.accounts:
        if acnt.money >= amnt:
            acnt.money -= amnt
            to.accounts[0].money += amnt
            total_money_to = sum([acnt.money for acnt in to.accounts])
            assert acnt.money < total_money_from - amnt, f"'{frm.name}' has enough money in their account but failed to transfer correct amount."
            assert total_money_to > total_money_from - amnt, f"No money was transferred to '{to.name}' account."
            return True

    return False

p1 = Person("Alice")
p2 = Person("Bob")

# attempt transfer of 50 from Alice to Bob 
assert transfer(p1, p2, 50), f"Transfer attempt from {p1.name} to {p2.name} failed."
```

