Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // Verifies that the size of the ArrayList increases by 1 after addition--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1); // Check if the size of the ArrayList increases by 1 after insertion--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1, "@@@ array list size increases by 1 after insertion");--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1, "ArrayList size does not increase by 1 after insertion");--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1, "ArrayList size should increase by 1 after Insertion");--------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1, "ArrayList size should increase by 1 after insertion");--------------------