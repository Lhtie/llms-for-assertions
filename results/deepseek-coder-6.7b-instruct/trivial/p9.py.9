def test_transfer():
    alice = Person("Alice")
    bob = Person("Bob")
    transfer(alice, bob, 50)

    # @@@ Alice has more money than what she initially has
    for acnt in alice.accounts:
        assert acnt.money <= 100, "Alice has more money than she initially has"

    # @@@ Bob has less money than what he initially has
    for acnt in bob.accounts:
        assert acnt.money >= 50, "Bob has less money than he initially has"

    # @@@ Trying to transfer more money than Alice has
    assert not transfer(alice, bob, 150), "Alice tried to transfer more money than she has"

    # @@@ Total money after transferring less than initial total
    initial_total = sum([acnt.money for acnt in alice.accounts + bob.accounts])
    assert initial_total == sum([acnt.money for acnt in alice.accounts + bob.accounts]), "Total money after transferring is not equal to initial total"

test_transfer()
