    assert r.exp > 0, "Height of r is not positive"--------------------assert r.exp > 0, "The height of the rectangle is not positive"--------------------    assert r.exp > 0, "height is not positive"--------------------    assert r.exp > 0, "Height of r is not positive"----------------------------------------    assert r.exp > 0, "Height of r is not positive"--------------------    assert r.exp > 0 # the height of r should be positive--------------------    assert r.exp > 0, 'height of r is not positive' # this assert checks if height is positive--------------------    assert r.exp > 0, "The height of r is not positive"--------------------    assert r.exp > 0, 'The height of the rectangle should be positive'--------------------