    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in for length and width"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid value passed in for radius"
        super().__init__("Circle")
        self.rad = r
        self.area = 3.14*r*r
        self.perimeter = 2*3.14*r

