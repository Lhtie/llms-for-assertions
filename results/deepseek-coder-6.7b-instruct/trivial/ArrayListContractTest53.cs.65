[Test]
public void Test_PUT_AddContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;

    // Act
    int result = arrList.Add(x);

    // Assert
    Debug.Assert(arrList.Count == Old_arrListCount + 1); // Check if count incremented by 1
    Debug.Assert(result == New_arrListCount); // Check if return value is the new count
    Debug.Assert(arrList.IndexOf(x) == Old_arrListCount); // Check if x is added at the end of the list
    Debug.Assert(arrList.LastIndexOf(x) == Old_arrListCount); // Check if x is added at the end of the list
    Debug.Assert(arrList.Contains(x)); // Check if x is in the list
}

[Test]
public void Test_PUT_RemoveContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;
    arrList.Add(x);

    // Act
    arrList.Remove(x);

    // Assert
    Debug.Assert(arrList.Count == Old_arrListCount - 1); // Check if count decremented by 1
    Debug.Assert(!arrList.Contains(x)); // Check if x is removed from the list
}

[Test]
public void Test_PUT_InsertContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;

    // Act
    arrList.Insert(0, x);

    // Assert
    Debug.Assert(arrList.Count == Old_arrListCount + 1); // Check if count incremented by 1
    Debug.Assert(arrList.IndexOf(x) == 0); // Check if x is inserted at the correct position
    Debug.Assert(arrList.LastIndexOf(x) == 0); // Check if x is inserted at the correct position
    Debug.Assert(arrList.Contains(x)); // Check if x is in the list
}

[Test]
public void Test_PUT_SetContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;
    int index = 0;

    // Act
    arrList[index] = x;

    // Assert
    Debug.Assert(arrList.Count == Old_arrListCount); // Check if count is unchanged
    Debug.Assert(arrList[index] == x); // Check if x is set at the correct position
    Debug.Assert(arrList.Contains(x)); // Check if x is in the list
}

[Test]
public void Test_PUT_GetContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int index = 0;

    // Act
    int result = (int)(arrList[index]);

    // Assert
    Debug.Assert(arrList.Count == Old_arrListCount); // Check if count is unchanged
    Debug.Assert(result == New_Ret); // Check if the correct value is returned
    Debug.Assert(arrList.Contains(New_Ret)); // Check if the returned value is in the list
}

[Test]
public void Test_PUT_ContainsContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
