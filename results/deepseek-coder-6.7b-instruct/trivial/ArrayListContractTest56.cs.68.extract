            Debug.Assert(arrList != null);--------------------            Debug.Assert(arrList != null);--------------------Debug.Assert(!New_Ret || Old_arrListCount == New_arrListCount);--------------------Debug.Assert(New_Ret == false, "If the return value is false, sizes of new and old array are same");--------------------Debug.Assert(!New_Ret || Old_arrListCount == New_arrListCount); --------------------Debug.Assert(!New_Ret || Old_arrListCount == New_arrListCount);--------------------            Debug.Assert(Old_arrListCount != 0 || New_Ret != -1); // @@@ If the return value is -1, sizes of new and old array are different--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "Count assertion failed.");--------------------Debug.Assert(Old_arrListCount >= 0); // @@@ Initial count of the array list should be a non-negative value--------------------Debug.Assert(Old_arrListCount == 1); // Check if count was increased after add operation--------------------