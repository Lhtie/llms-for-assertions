[Test]
public void Test_AddContract() 
{
    // @@@ Count of arrList before and after Adding x is same
    Debug.Assert(Old_arrListCount == New_arrListCount - 1); 
}

[Test]
public void Test_RemoveContract() 
{
    // @@@ Count of arrList before and after Removing x is 1 more than before
    Debug.Assert(Old_arrListCount == New_arrListCount + 1);
}

[Test]
public void Test_InsertContract() 
{
    // @@@ Count of arrList before and after Inserting x at index is 1 more than before
    Debug.Assert(Old_arrListCount == New_arrListCount);
}

[Test]
public void Test_SetContract() 
{
    // @@@ New arrList contains x at index
    Debug.Assert(New_arrListContainsX);

    // @@@ index passed in is less than or equal to last index of x in new array
    Debug.Assert(Old_arrListLastIndexOfX >= Old_index); 
}

[Test]
public void Test_GetContract() 
{
    // @@@ New array list contains the retrieved value
    Debug.Assert(New_containsNewRet); 
}

[Test]
public void Test_ContainsContract() 
{
    // @@@ New retrieved value is true if x was in array list
    Debug.Assert(New_Ret == Old_arrListContainsX);
}

[Test]
public void Test_IndexOfContract() 
{
    // @@@ If x was in array list, then New retrieved value is same as Old IndexOf x. Otherwise, -1.
    Debug.Assert(New_Ret == Old_arrListIndexOfX || !Old_arrListContainsX && New_Ret == -1);
}

[Test]
public void Test_LastIndexOfContract() 
{
    // @@@ If x was in array list, then New retrieved value is same as Old LastIndexOf x. Otherwise, -1.
    Debug.Assert(New_Ret == Old_arrListLastIndexOfX || !Old_arrListContainsX && New_Ret == -1);
}

[Test]
public void Test_CountContract() 
{
    // @@@ New Ret is the same as current count of arrList
    Debug.Assert(New_Ret == arrList.Count); 
}
