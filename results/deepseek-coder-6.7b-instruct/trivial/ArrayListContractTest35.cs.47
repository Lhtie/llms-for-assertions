--------------------```cs
using System;
using System.Collections.Generic;
using System.Diagnostics;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x)
        {
            int Old_arrListCount = arrList.Count;
            arrList.Add(x);
            int New_arrListCount = arrList.Count;
            Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        }

        [Test]
        public void PUT_RemoveContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x)
        {
            int Old_arrListCount = arrList.Count;
            arrList.Remove(x);
            int New_arrListCount = arrList.Count;
            Debug.Assert(New_arrListCount == Old_arrListCount - 1);
        }

        [Test]
        public void PUT_InsertContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x, [ValueSource("int32")]int index)
        {
            arrList.Insert(index, x);
            Debug.Assert(arrList.Contains(x));
            Debug.Assert(arrList.IndexOf(x) == index);
        }

        [Test]
        public void PUT_SetContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x, [ValueSource("int32")]int index)
        {
            arrList[index] = x;
            Debug.Assert(arrList.Contains(x));
            Debug.Assert(arrList.IndexOf(x) == index);
        }

        [Test]
        public void PUT_GetContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int index)
        {
            int x = (int)(arrList[index]);
            Debug.Assert(arrList.Contains(x));
        }

        [Test]
        public void PUT_ContainsContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x)
        {
            bool contains = arrList.Contains(x);
            Debug.Assert(contains);
        }

        [Test]
        public void PUT_IndexOfContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x)
        {
            int index = arrList.IndexOf(x);
            Debug.Assert(index >= 0);
        }

        [Test]
        public void PUT_LastIndexOfContract([ValueSource("arrList")]ArrayList arrList, [ValueSource("int32")]int x)
        {
            int index = arrList.LastIndexOf(x);
            Debug.Assert(index >= 0);
        }

        [Test]
        public void PUT_CountContract([ValueSource("arrList")]ArrayList arrList)
        {
            int count = arrList.Count;
            Debug.Assert(count >= 0);
        }
    }
}
```
This code is using NUnit's ValueSource to feed it different test data. It's using Debug.Assert to generate assert statements. The assertions are checking if certain operations are working correctly. For instance, the AddContract tests if the Count property is incremented after an item is added, etc. The [ValueSource("arrList")] and [ValueSource("int32")] annotations are telling the tests to use the 'arrList' and 'int32' methods generated by the NUnit's ValueSource to provide test data.
