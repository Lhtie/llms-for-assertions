PI = 3.14

class Shape:
    def __init__(self, typ):
        assert typ in ['Rectangle', 'Circle'], "Invalid shape type"
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        assert self.len > 0 and self.wid > 0, "Invalid rectangle dimensions"
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    assert isinstance(s1, Shape) and isinstance(s2, Shape), "Invalid shapes passed in"
    a1, a2 = s1.area, s2.area
    if a1>a2: return a1
    else: return a2
```

