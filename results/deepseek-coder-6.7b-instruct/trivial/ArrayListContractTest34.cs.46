--------------------```cs
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract([Values(1, 2, 3)]int x, [PexAssumeUnderTest] ArrayList arrList)
        {
            int oldCount = arrList.Count;
            arrList.Add(x);
            Assert.AreEqual(oldCount + 1, arrList.Count);
        }

        [Test]
        public void PUT_RemoveContract([Values(1, 2, 3)]int x, [PexAssumeUnderTest] ArrayList arrList)
        {
            int oldCount = arrList.Count;
            arrList.Remove(x);
            Assert.IsTrue(oldCount >= arrList.Count);
        }

        [Test]
        public void PUT_InsertContract([Values(1, 2, 3)]int x, int index = 0, [PexAssumeUnderTest] ArrayList arrList)
        {
            arrList.Insert(index, x);
            Assert.IsTrue(arrList.Contains(x));
        }

        [Test]
        public void PUT_SetContract([Values(1, 2, 3)]int x, int index = 0, [PexAssumeUnderTest] ArrayList arrList)
        {
            arrList[index] = x;
            Assert.IsTrue(arrList.Contains(x));
        }

        [Test]
        public void PUT_GetContract([Values(0, 1, 2)]int index, [PexAssumeUnderTest] ArrayList arrList)
        {
            int val = (int)arrList[index];
            Assert.IsTrue(arrList.Contains(val));
        }

        [Test]
        public void PUT_ContainsContract([Values(1, 2, 3)]int x, [PexAssumeUnderTest] ArrayList arrList)
        {
            bool contains = arrList.Contains(x);
            Assert.IsTrue(contains);
        }

        [Test]
        public void PUT_IndexOfContract([Values(1, 2, 3)]int x, [PexAssumeUnderTest] ArrayList arrList)
        {
            int index = arrList.IndexOf(x);
            Assert.IsTrue(index >= 0 && index < arrList.Count);
        }

        [Test]
        public void PUT_LastIndexOfContract([Values(1, 2, 3)]int x, [PexAssumeUnderTest] ArrayList arrList)
        {
            int index = arrList.LastIndexOf(x);
            Assert.IsTrue(index >= 0 && index < arrList.Count);
        }

        [Test]
        public void PUT_CountContract([PexAssumeUnderTest] ArrayList arrList)
        {
            int count = arrList.Count;
            Assert.IsTrue(count >= 0);
        }
    }
}
