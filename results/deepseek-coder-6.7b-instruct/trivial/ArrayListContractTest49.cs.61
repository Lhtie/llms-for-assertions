--------------------```cs
[TestMethod]
public void Test_AddContract()
{
    int oldCount = arrList.Count;
    int newRet = arrList.Add(x);
    int newCount = arrList.Count;
    Debug.Assert(newCount == oldCount + 1);
    Debug.Assert(newRet == oldCount);
}

[TestMethod]
public void Test_RemoveContract()
{
    int oldCount = arrList.Count;
    bool oldContainsX = arrList.Contains(x);
    arrList.Remove(x);
    int newCount = arrList.Count;
    bool newContainsX = arrList.Contains(x);
    Debug.Assert(newCount == oldCount - 1);
    Debug.Assert(oldContainsX == true);
    Debug.Assert(newContainsX == false);
}

[TestMethod]
public void Test_InsertContract()
{
    int oldCount = arrList.Count;
    arrList.Insert(index, x);
    int newCount = arrList.Count;
    Debug.Assert(newCount == oldCount + 1);
}

[TestMethod]
public void Test_SetContract()
{
    arrList[index] = x;
    int newIndexOfX = arrList.IndexOf(x);
    Debug.Assert(newIndexOfX == index);
}

[TestMethod]
public void Test_GetContract()
{
    int newRet = (int)arrList[index];
    bool newContainsRet = arrList.Contains(newRet);
    Debug.Assert(newContainsRet == true);
}

[TestMethod]
public void Test_ContainsContract()
{
    bool newRet = arrList.Contains(x);
    int oldIndexOfX = arrList.IndexOf(x);
    int newIndexOfX = arrList.IndexOf(x);
    Debug.Assert(newRet == true);
    Debug.Assert(newIndexOfX >= oldIndexOfX);
}

[TestMethod]
public void Test_IndexOfContract()
{
    int oldLastIndexOfX = arrList.LastIndexOf(x);
    int newRet = arrList.IndexOf(x);
    Debug.Assert(newRet >= oldLastIndexOfX);
}

[TestMethod]
public void Test_LastIndexOfContract()
{
    int oldIndexOfX = arrList.IndexOf(x);
    int newRet = arrList.LastIndexOf(x);
    Debug.Assert(newRet >= oldIndexOfX);
}

[TestMethod]
public void Test_CountContract()
{
    int newRet = arrList.Count;
    Debug.Assert(newRet >= 0);
}
```
--------------------Based on the provided code, you'll need to add the `Debug.Assert(...)` statements at the points where you want to validate the state of the array list. The comments that start with `@@@` indicate locations where the array list count and index/last index of the element should be checked. 

Here's the updated code with `Debug.Assert(...)` in place of the `@@@` comments:

```cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        // ...other test cases...

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            Debug.Assert(New_Ret == arrList.Contains(x));
            Debug.Assert(Old_arrListCount == New_arrListCount);

            // If the return value is true, index of x in old array is greater than or equal to that in new array
            Debug.Assert(New_Ret || (Old_arrListIndexOfX >= 0 && Old_arrListIndexOfX >= New_arrListIndexOfX));

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
        }

        // ...other test cases...

    }
}
```

Please note that the `Debug.Assert(...)` can be used for debugging purposes only and it will not impact the testing output due to the `#if !DEBUG` directive. In a release build, these assertions will be ignored.
