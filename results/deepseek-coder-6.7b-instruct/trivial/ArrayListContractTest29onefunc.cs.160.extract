            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX); //checks if the new index of x is greater or equal to the old index of x--------------------Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);--------------------            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);--------------------Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);--------------------Debug.Assert(Old_index <= arrList.Count); // Ensures index is within array bounds--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, "The last position of x in new array list is greater than or equal to that in old array.");--------------------Debug.Assert(Old_index <= New_arrListLastIndexOfX);--------------------        Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);--------------------Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, "The last position of x in new array list is greater than or equal to that in old array.");--------------------