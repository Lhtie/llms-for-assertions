Debug.Assert(New_Ret == false || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret == Old_arrListCount + 1); // Ensure that Count property has been incremented by 1 after Add operation--------------------Debug.Assert(New_Ret != false); // @@@ If the return value is false, old list's count is not -1--------------------Debug.Assert(New_Ret == false || Old_arrListCount != -1);--------------------Debug.Assert(!New_Ret || Old_arrListCount != -1);--------------------Debug.Assert(Old_arrListCount != -1 || New_arrListCount != Old_arrListCount + 1); // @@@ If the return value is false, old list's count is not -1--------------------            Debug.Assert(!New_Ret || Old_arrListCount != -1);--------------------Debug.Assert(!New_Ret || Old_arrListCount != -1);--------------------Debug.Assert(Old_arrListCount >= 0); // The old count should be greater than or equal to 0--------------------Debug.Assert(!(!New_Ret && Old_arrListCount != -1));--------------------