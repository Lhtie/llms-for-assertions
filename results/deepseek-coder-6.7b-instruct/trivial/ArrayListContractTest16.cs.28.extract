Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // assert the count after adding a new item--------------------Debug.Assert(Old_arrListCount <= New_arrListCount); // For @@@ last index of x in old array is smaller than or equal to new array size--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX, "Last index of x in old array is not smaller than or equal to new array size");--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListCount < New_arrListCount); // Checks if the count of the list increases after an item is added--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);----------------------------------------Debug.Assert((Old_arrListCount == New_arrListCount));--------------------