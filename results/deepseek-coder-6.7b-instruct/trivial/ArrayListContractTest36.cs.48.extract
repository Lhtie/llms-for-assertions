Debug.Assert(Old_arrListCount != New_arrListCount); // Comment: "@@@ new array count is not same as old array size"--------------------Debug.Assert(New_arrListCount != Old_arrListCount + 1); // @@@ array list count should increase by 1 after add operation--------------------Debug.Assert(Old_arrListCount == New_arrListCount); // @@@ old and new ArrayList counts should be same--------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "@@@ last index of x in new array is not same as old array size ");--------------------Debug.Assert(Old_arrListCount <= New_arrListCount); // Comment "old array list count is less than or equal to new array list count"--------------------        Debug.Assert(arrList != null);----------------------------------------Debug.Assert(Old_arrListCount < New_arrListCount, "The count of the array list should have increased after an add operation."); // @@@--------------------Debug.Assert(Old_arrListCount >= 0);--------------------