Debug.Assert(Old_arrListCount != New_arrListCount); // The initial count of the ArrayList is not the same as the new count after a remove operation.--------------------            Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != New_arrListCount, " ArrayList count is not same as last index of x in new array");--------------------Debug.Assert(Old_arrListCount != New_arrListCount); // This should assert that the old and new counts of the array list are not equal--------------------Debug.Assert(Old_arrListCount != New_arrListCount);--------------------Debug.Assert(Old_arrListCount != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListCount != New_arrListCount);--------------------Debug.Assert(New_arrListCount != Old_arrListLastIndexOfX); // The count of the ArrayList after the removal should not be the same as the last index of the removed element--------------------Debug.Assert(Old_arrListCount == New_arrListCount);  // Check if ArrayList count is same before and after Remove()--------------------Debug.Assert(Old_arrListCount != New_arrListLastIndexOfX);--------------------