    // Assert
    Assert.AreEqual(-1, ret); // LastIndexOf should return -1 if the item is not in the collection
}

[Test]
public void Test_PUT_CountContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();

    // Act
    int ret = arrList.Count;

    // Assert
    Assert.AreEqual(0, ret); // Count should be 0 for an empty collection
}
