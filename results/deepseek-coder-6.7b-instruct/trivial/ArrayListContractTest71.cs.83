// @@@ If the return value is negative, last index of x in new array is -1 too
Assert.AreEqual(Old_arrListLastIndexOfX, -1);

// @@@ The last index of any value in the nonempty array is 0 or greater than 0 
Assert.IsTrue(New_arrListLastIndexOfX >= 0);

// @@@ Removing an element from the array reduces its count
Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

// @@@ If the array contains an item, the index of the first appearance is not negative
Assert.IsTrue(Old_arrListIndexOfX >= 0);

// @@@ If the array does not contain an item, index of it is -1
Assert.AreEqual(Old_arrListIndexOfX, -1);

// @@@ The index returned by the index of method is less than or equal to count
Assert.IsTrue(New_arrListIndexOfX <= New_arrListCount);

// @@@ Insert method throws InvalidOperationException if index is equal to the array's capacity
Assert.Throws<InvalidOperationException>(() => arrList.Insert(arrList.Capacity, x));

// @@@ Removing an item not in the array does not alter the count
Assert.AreEqual(Old_arrListCount, New_arrListCount);

// @@@ Count property should not return -1 after a remove operation
Assert.AreNotEqual(New_arrListCount, -1);
```
