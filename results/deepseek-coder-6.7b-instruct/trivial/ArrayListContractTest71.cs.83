[Test]
public void Test_IndexOf_Negative()
{
    var arrList = new ArrayList();
    arrList.Add(1);
    arrList.Add(2);
    arrList.Add(3);

    int index = arrList.IndexOf(4); // Assume 4 is not in the list
    Assert.True(index == -1);

    index = arrList.LastIndexOf(4); // Assume 4 is not in the list
    Assert.True(index == -1);
}
