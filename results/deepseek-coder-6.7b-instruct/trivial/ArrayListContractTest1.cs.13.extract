Debug.Assert(Old_arrListContainsX == true, "The old list should contain the added element");--------------------            Debug.Assert(arrList.Contains(x) == New_arrListContainsX);--------------------Debug.Assert(Old_arrListCount == New_arrListCount + 1);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_arrListContainsX == Old_arrListContainsX);--------------------Debug.Assert(New_arrListContainsX == Old_arrListContainsX.Equals(x));  // @@@ new arry contains x--------------------Debug.Assert(New_Ret == Old_arrListCount + 1); // @@@ new count is old count plus one after add--------------------Debug.Assert(New_arrListContainsX); // "@@@ new arry contains x"--------------------Debug.Assert(New_Ret == Old_arrListCount + 1); // @@@ new arry contains x----------------------------------------