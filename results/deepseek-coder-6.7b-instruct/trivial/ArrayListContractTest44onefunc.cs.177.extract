            Debug.Assert(index != Old_arrListCount); // @@@ index passed in is not equal to the old array size --------------------Debug.Assert(Old_index != Old_arrListCount, "Index is not equal to the old count of array");--------------------Debug.Assert(Old_index != Old_arrListCount, "index passed in is not equal to the old array size");--------------------Debug.Assert((Old_arrListCount != index), "Index passed in is not equal to the old array size.");--------------------            Debug.Assert(index < arrList.Count && index >= 0, "Index is not within the range of the array");--------------------Debug.Assert(Old_arrListCount != index);--------------------Debug.Assert(Old_arrListCount != index); --------------------            Debug.Assert(index != Old_arrListCount, "index passed in is not equal to the old array size");--------------------            Debug.Assert(index != Old_arrListCount, "@@@ index passed in is not equal to the old array size");--------------------Debug.Assert(Old_arrListCount != index);--------------------