            Debug.Assert(New_Ret >= 0); // @@@ index of x in new array is valid ie >= 0 --------------------Debug.Assert(New_arrList_IndexOf_x >= 0);--------------------Debug.Assert(arrList.Count == 0);--------------------Debug.Assert(New_arrListIndexOfX >= 0);--------------------Debug.Assert(New_arrListCount >= 0); // Asserts that the count of the array list is valid--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);  // for 'PUT_AddContract'--------------------Debug.Assert(New_arrListIndexOfX >= 0);--------------------Debug.Assert(New_Ret >= 0);  // @@@ index of x in new array is valid ie >= 0 --------------------Debug.Assert(New_arrListIndexOfX >= 0);--------------------Debug.Assert(New_arrListIndexOfX >= 0, "@@@ index of x in new array is valid ie >= 0");--------------------