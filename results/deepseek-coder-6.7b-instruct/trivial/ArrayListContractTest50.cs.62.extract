Debug.Assert(New_Ret <= Old_arrListCount);--------------------Debug.Assert(Old_arrListCount >= 0); // Verifying that the count of the initial list is a non-negative integer--------------------Debug.Assert(New_arrList_Count >= Old_arrList_Count);--------------------Debug.Assert(Old_arrListCount >= 0); // @@@ Assert that the count of the old array is non-negative--------------------            Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------            Debug.Assert(New_Ret || New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount, "If the return value is true, last index of x in new array is <= size of old array");--------------------Debug.Assert(New_Ret <= Old_arrListCount); // @@@ If the return value is true, last index of x in new array is <= size of old array--------------------Debug.Assert(Old_arrListCount < New_arrListCount); // @@@ When adding an item to the list, count should increase--------------------Debug.Assert(New_Ret >= Old_arrListCount); //@@@ If the return value is >= old array count, it means the element has successfully added to the list--------------------