using System.Diagnostics;

[TestFixture, PexClass]
public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(arrList.Count >= 0);
        Debug.Assert(arrList.IndexOf(x) == -1 || arrList.IndexOf(x) == arrList.Count);
        Debug.Assert(arrList.LastIndexOf(x) == -1 || arrList.LastIndexOf(x) == arrList.Count - 1);
        Debug.Assert(arrList.Contains(x) == false);
    }

    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(arrList.Count >= 0);
        Debug.Assert(arrList.IndexOf(x) != -1);
        Debug.Assert(arrList.LastIndexOf(x) != -1);
        Debug.Assert(arrList.Contains(x) == true);
    }

    [PexMethod]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(index >= 0 && index <= arrList.Count);
        Debug.Assert(arrList.IndexOf(x) == -1 || arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == -1 || arrList.LastIndexOf(x) == index);
        Debug.Assert(arrList.Contains(x) == false);
    }

    [PexMethod]
    public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(index >= 0 && index < arrList.Count);
        Debug.Assert(arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == index);
        Debug.Assert(arrList.Contains(x) == true);
    }

    [PexMethod]
    public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(index >= 0 && index < arrList.Count);
    }

    [PexMethod]
    public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(arrList.Contains(x) == false || arrList.Contains(x) == true);
    }

    [PexMethod]
    public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(arrList.Contains(x) == false || arrList.IndexOf(x) >= 0);
    }

    [PexMethod]
    public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(x >= 0);
        Debug.Assert(arrList.Contains(x) == false || arrList.LastIndexOf(x) >= 0);
    }

    [PexMethod]
    public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(arrList.Count >= 0);
    }
}
