        // @@@ New array list's last index of x should always be greater than or equals to new returned index in the PUT_IndexOfContract
        Debug.Assert(New_arrListLastIndexOfX >= New_Ret);

        // @@@ Old array list's count should always be strictly greater than new array list's count if x is removed
        Debug.Assert(Old_arrListContainsX == true && New_arrListContainsX == false && Old_arrListCount > New_arrListCount);
