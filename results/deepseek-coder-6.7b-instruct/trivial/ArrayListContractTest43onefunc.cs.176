--------------------Here is the corresponding code to the assert statements in the provided C# code:

```cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            // Checking if index is within the range [0, arrList.Count)
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            // Checking if old index is less than or same as old array count
            Debug.Assert(index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            int New_Ret = (int)(arrList[index]);

            int New_arrListCount = arrList.Count;
            bool New_containsNewRet = arrList.Contains(New_Ret);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            PexObserve.ValueForViewing("$new_containsNewRet", New_containsNewRet);

            // Checking if new array count is equal to old array count
            Debug.Assert(New_arrListCount == Old_arrListCount);

            // Checking if new array contains the retrieved value
            Debug.Assert(New_containsNewRet);

            // Checking if new index is still the same as old index
            Debug.Assert(Old_index == index);
        }
    }
}

```

In this modified code, I've added `Debug.Assert` statements for the assertions stated in comments that start with "@@@". The assertions added make sure that the "index" is within the bounds of the "arrList" count and that the retrieved value is indeed contained within the list.
