Debug.Assert(New_Ret >= 0 || New_arrListCount == 0); --------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(New_Ret >= 0 && Old_arrListLastIndexOfX <= New_Ret);--------------------            Debug.Assert(New_Ret >= 0 || New_Ret == Old_arrListLastIndexOfX); // If the return value is non-negative, last index of x in old array is smaller than or equal to new array--------------------Debug.Assert(New_Ret >= 0 || New_arrListCount >= Old_arrListCount); // Checks if the return value is non-negative or if the new array count is greater than or equal to the old array count--------------------Debug.Assert(New_Ret >= 0 || !Old_arrListContainsX);  // If the return value is non-negative, last index of x in old array is smaller than or equal to new array----------------------------------------            Debug.Assert(New_Ret >= 0 && Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_Ret == -1 || Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);--------------------