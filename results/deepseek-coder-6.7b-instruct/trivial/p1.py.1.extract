    assert max(sums) <= 1----------------------------------------        assert (p43_coeffs[i+1] - p43_coeffs[i]) <= 1--------------------    assert sum_of_diffs <= 1, f"Invalid input: sum of abs diffs is {sum_of_diffs}, should be at most 1"------------------------------------------------------------        assert (p43_coeffs[i+1]-p43_coeffs[i]) <= 1, f"Array is not valid. The difference between {p43_coeffs[i+1]} and {p43_coeffs[i]} is more than 1."--------------------    assert sum_diff <= 1, f"Sum of differences is more than 1, but it's {sum_diff}"--------------------    assert sum_diffs <= 1, f"Sum of all pairs of differences is {sum_diffs}, which is more than 1"--------------------            assert abs(p43_coeffs[i] - p43_coeffs[j]) <= 1, f"The pair {p43_coeffs[i]}, {p43_coeffs[j]} is not valid"--------------------