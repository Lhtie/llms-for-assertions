[Test]
public void TestAddContract()
{
    Debug.Assert(Old_arrListCount + 1 == New_arrListCount);
    Debug.Assert(Old_arrListIndexOfX == -1 && New_arrListIndexOfX == -1);
    Debug.Assert(Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX == -1);
    Debug.Assert(New_arrListContainsX == true);
}

[Test]
public void TestRemoveContract()
{
    Debug.Assert(Old_arrListCount - 1 == New_arrListCount);
    Debug.Assert(Old_arrListIndexOfX == -1 && New_arrListIndexOfX == -1);
    Debug.Assert(Old_arrListLastIndexOfX != -1 && New_arrListLastIndexOfX != -1);
    Debug.Assert(Old_arrListContainsX == true && New_arrListContainsX == false);
}

