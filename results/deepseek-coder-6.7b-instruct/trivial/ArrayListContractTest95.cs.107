[Test]
public void TestContainsContract()
{
    Debug.Assert((Old_arrListContainsX == true && New_Ret == true) || 
                  (Old_arrListContainsX == false && New_Ret == false));
}

[Test]
public void TestIndexOfContract()
{
    Debug.Assert((Old_arrListContainsX == true && New_Ret >= 0) || 
                  (Old_arrListContainsX == false && New_Ret == -1));
}

[Test]
public void TestLastIndexOfContract()
{
    Debug.Assert((Old_arrListContainsX == true && New_Ret >= 0) || 
                  (Old_arrListContainsX == false && New_Ret == -1));
}

[Test]
public void TestCountContract()
{
    Debug.Assert(New_Ret == arrList.Count);
}
