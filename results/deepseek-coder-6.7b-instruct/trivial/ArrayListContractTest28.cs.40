These assertions have been added in the corresponding PUT_InsertContract and PUT_SetContract methods. Assertions are used to check if certain conditions are met. In this case, it's checked if the original last index of x in the old array list is smaller than the new one, implying that x has been inserted or set at a new position. This shows that the comment "@@@ last position of x in old and new lists are different" is correct.
--------------------```cs
using System.Diagnostics;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList != null);

            Debug.Assert(arrList.Count >= 0);

            // @@@ Old count before adding x is greater than or equal to 0 
            Debug.Assert(arrList.Count <= int.MaxValue);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList != null);

            Debug.Assert(arrList.Count >= 0);

            // @@@ Array list contains x before removal 
            Debug.Assert(arrList.Contains(x));

            // @@@ Array list does not contain x after removal 
            Debug.Assert(!arrList.Contains(x));
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList != null);

            Debug.Assert(index <= arrList.Count && index >= 0);

            // @@@ Old count before inserting x is greater than or equal to 0 
            Debug.Assert(arrList.Count <= int.MaxValue);
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList != null);

            Debug.Assert(index >= 0 && index < arrList.Count);
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(arrList != null);

            Debug.Assert(index < arrList.Count && index >= 0);

            // @@@ Array list contains item retrieved from index 
            Debug.Assert(arrList.Contains((int)(arrList[index])));
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList != null);

            // @@@ If arrList contains x, then x is in arrList 
            Debug.Assert((arrList.Contains(x)) == arrList.IndexOf(x) != -1);
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList != null);

            // @@@ If arrList contains x, then IndexOf returns index of x 
            Debug.Assert((arrList.Contains(x)) && arrList.IndexOf(x) == arrList.IndexOf(x));
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList != null);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            Debug.Assert(arrList != null);

            // @@@ Array list count is non-negative 
            Debug.Assert(arrList.Count >= 0);
        }
    }
}
```
