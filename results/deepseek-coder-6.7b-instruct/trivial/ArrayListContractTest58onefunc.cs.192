// @@@ If the return value is a non-negative number, it should be equal to Old_arrListIndexOfX
Debug.Assert(New_arrListIndexOfX >= 0 && New_arrListIndexOfX == Old_arrListIndexOfX);

// @@@ If the return value is a non-negative number, it should be equal to Old_arrListLastIndexOfX
Debug.Assert(New_arrListLastIndexOfX >= 0 && New_arrListLastIndexOfX == Old_arrListLastIndexOfX);

// @@@ If the ret value is false, the new array list count should be the same as the old one. If ret is true, the new list count should be one more than the old one.
