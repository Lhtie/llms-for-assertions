--------------------Here is the corresponding C# code using "Debug.Assert" for the comments with "@@@":

```cs
namespace ArrayList.Test
{
    using System.Diagnostics;

    public partial class ArrayListContractTest
    {
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // @@@ If the return value is negative, old array's size is at least -1
            Debug.Assert(New_Ret < 0 || Old_arrListCount + 1 >= New_Ret, $"If the return value is negative, old array's size must be at least -1, but old count is {Old_arrListCount} and new return value is {New_Ret}");
        }
    }
}
```

This code uses the "Debug.Assert" statement to check that if the return value of the "LastIndexOf" method is negative (meaning that the element is not found in the array), then the size of the array must be at least -1 (or it can be an empty array).
