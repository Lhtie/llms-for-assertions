Debug.Assert(Old_arrListCount >= 0); // @@@ The count of the old ArrayList should be a non-negative integer--------------------Debug.Assert(New_Ret >= 0, $"The return value is negative, which means that {x} is not in the list.");--------------------Debug.Assert(New_Ret >= Old_arrListIndexOfX);----------------------------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);----------------------------------------Debug.Assert(New_Ret >= Old_arrListIndexOfX, "If the return value is positive, return value is at least the index of x in old list");--------------------Debug.Assert(New_Ret >= Old_arrListCount); // The count of the list after insertion operation is greater or equal to the count before the operation.--------------------            Debug.Assert(Old_arrListCount >= 0);--------------------