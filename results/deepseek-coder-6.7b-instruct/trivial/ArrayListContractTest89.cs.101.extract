Debug.Assert(New_Ret >= Old_arrListIndexOfX); // @@@ If the return value is non-negative, return value is at least the index of x in old list --------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(New_Ret >= Old_arrListIndexOfX);--------------------Debug.Assert(Old_arrListCount >= 0); // @@@ Count of the list should be non-negative--------------------	Debug.Assert(New_Ret >= Old_arrListIndexOfX, "If the return value is non-negative, return value is at least the index of x in old list.");--------------------            Debug.Assert(New_Ret >= Old_arrListIndexOfX); // @@@ If the return value is non-negative, return value is at least the index of x in old list --------------------Debug.Assert(New_Ret >= Old_arrListIndexOfX); // @@@ If the return value is non-negative, return value is at least the index of x in old list----------------------------------------            Debug.Assert(Old_arrListCount >= 0);--------------------            Debug.Assert(New_Ret >= 0 && Old_arrListLastIndexOfX >= New_Ret, "The return value is not valid.");--------------------