        [Test]
        public void PUT_ContainsContract_ReturnsFalse_CheckIndex()
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = 42;
            int Old_arrListIndexOfX = arrList.IndexOf(Old_x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);

            bool New_Ret = arrList.Contains(Old_x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(Old_x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);

            Assert.IsFalse(New_Ret);
            Assert.IsTrue(Old_arrListLastIndexOfX <= New_arrListIndexOfX);
        }
```

