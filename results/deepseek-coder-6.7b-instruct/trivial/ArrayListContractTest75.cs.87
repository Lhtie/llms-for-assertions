```cs
[Test]
public void PUT_IndexOfContract_AssertCondition()
{
    ArrayList arrList = new ArrayList();
    int x = 0;

    Assume.True(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.IndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    if (New_Ret >= 0)
    {
        Assert.AreNotEqual(Old_arrListCount, New_arrListCount); 
    }
    else
    {
        Assert.AreEqual(Old_arrListCount, New_arrListCount); 
    }
}
```

This assert statement checks if the return value of IndexOf() is non-negative. If it is, it checks that the count of the list (before and after the operation) are not equal, meaning that a new element was added to the list. If it is negative, it checks that the count of the list (before and after the operation) are equal, meaning that the element was not found in the list.
