[TestMethod]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.IndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(New_Ret >= 0); // The return value is non-negative as specified in the comment
    Debug.Assert(New_arrListCount == Old_arrListCount + 1 || New_arrListCount == Old_arrListCount); // New count is either old count + 1 (item added) or same (item not added because it's already present)
    Debug.Assert(New_arrListLastIndexOfX != Old_arrListCount); // If the return value is non-negative, last index of x in new list != old list count
}

[TestMethod]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(New_Ret >= 0); // The return value is non-negative as specified in the comment
    Debug.Assert(New_arrListCount == Old_arrListCount || (New_arrListCount == Old_arrListCount + 1 && Old_arrListContainsX)); // New count is either old count (item removed) or old count + 1 (item added only if x was initially in the list)
    Debug.Assert(New_arrListIndexOfX == -1 || New_arrListIndexOfX == Old_arrListIndexOfX); // If the return value is non-negative, index of x in new list either -1 (item not in list after removal) or same as old index (item remained in list after removal)
}
```
Please note that this assumes that the Pex framework and the ArrayList class are behaving as expected. If there are any inconsistencies with these assumptions, the generated Debug.Assert statements may not cover all possible scenarios.
