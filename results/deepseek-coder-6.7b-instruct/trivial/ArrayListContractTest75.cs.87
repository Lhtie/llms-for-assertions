// @@@ For all methods, if the new list count is greater than old list count then it must be increased by 1
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ For all methods, if the new list count is less than old list count then it must be decreased by 1
Debug.Assert(New_arrListCount == Old_arrListCount - 1);

// @@@ If the return value from Insert/Set operation is the given index, new list count must not change
Debug.Assert(New_arrListCount == Old_arrListCount);

// @@@ If the return value from Insert/Set operation is not the given index, new list count must increase by 1
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ If a value is added to the list, new list contains the added value
Debug.Assert(New_arrListContainsX == true);

// @@@ If a value is removed from the list, new list does not contains the removed value
Debug.Assert(New_arrListContainsX == false);

// @@@ If the return value is non-negative, last index of x in new list != old list count 
if(New_Ret >= 0)
{
    Debug.Assert(New_arrListLastIndexOfX != Old_arrListCount);
}

// @@@ For all methods, if the index of x in new list is negative, it means x is not in the list anymore
Debug.Assert(New_arrListIndexOfX < 0);

// @@@ For all methods, if the index of x in new list is not negative, it means x is in the list
Debug.Assert(New_arrListIndexOfX >= 0);

// @@@ For Count method, if the return value is non-negative, it means that at least one object is in the list
Debug.Assert(New_Ret >= 0);

// @@@ For Count method, if the return value is negative, it means that no objects are in the list
Debug.Assert(New_Ret < 0);
```
Please note that the above assert statements are conditional based on the specific operation and its behavior. For example, for the `PUT_AddContract` method, if a value is added to the list (`New_arrListContainsX == true`), the count is increased by 1 (`New_arrListCount == Old_arrListCount + 1`). The first assert statement is not necessarily true, especially if you are adding an existing element to the list, as it will not increase the count. The same applies for remove operations in the other methods.
