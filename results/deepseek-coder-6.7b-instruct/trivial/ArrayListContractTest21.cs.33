[Test]
public void PUT_RemoveContractTest()
{
    int newCount = arrList.Count;
    ArrayList.Remove(x);
    int newCount2 = arrList.Count;
    Debug.Assert(newCount2 >= newCount - 1);
}

[Test]
public void PUT_InsertContractTest()
{
    int newCount = arrList.Count;
    ArrayList.Insert(index, x);
    int newCount2 = arrList.Count;
    Debug.Assert(newCount2 == newCount + 1);
}

[Test]
public void PUT_ContainsContractTest()
{
    bool oldContains = arrList.Contains(x);
    ArrayList.Add(x);
    bool newContains = arrList.Contains(x);
    Debug.Assert(oldContains == false && newContains == true);
}

[Test]
public void PUT_IndexOfContractTest()
{
    int oldIndexOf = arrList.IndexOf(x);
    ArrayList.Add(x);
    int newIndexOf = arrList.IndexOf(x);
    Debug.Assert(oldIndexOf == -1 && newIndexOf >= 0);
}

[Test]
public void PUT_LastIndexOfContractTest()
{
    int oldLastIndexOf = arrList.LastIndexOf(x);
    ArrayList.Add(x);
    int newLastIndexOf = arrList.LastIndexOf(x);
    Debug.Assert(oldLastIndexOf == -1 && newLastIndexOf >= 0);
}

[Test]
public void PUT_CountContractTest()
{
    int oldCount = arrList.Count;
    ArrayList.Add(x);
    int newCount = arrList.Count;
    Debug.Assert(newCount == oldCount + 1);
}
```
