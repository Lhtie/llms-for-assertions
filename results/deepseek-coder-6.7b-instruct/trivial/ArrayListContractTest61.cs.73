[Test]
public void TestAdd()
{
    int oldCount = arrList.Count;
    arrList.Add(x);
    int newCount = arrList.Count;
    Assert.AreEqual(oldCount + 1, newCount);
}

[Test]
public void TestRemove()
{
    arrList.Remove(x);
    Assert.IsFalse(arrList.Contains(x));
}

[Test]
public void TestInsert()
{
    arrList.Insert(index, x);
    Assert.AreEqual(x, arrList[index]);
}

[Test]
public void TestSet()
{
    arrList[index] = x;
    Assert.AreEqual(x, arrList[index]);
}

[Test]
public void TestGet()
{
    Assert.AreEqual(x, arrList[index]);
}

[Test]
public void TestContains()
{
    bool contains = arrList.Contains(x);
    Assert.AreEqual(true, contains);
}

[Test]
public void TestIndexOf()
{
    int index = arrList.IndexOf(x);
    Assert.IsTrue(index >= 0 && index < arrList.Count);
}

[Test]
public void TestLastIndexOf()
{
    int index = arrList.LastIndexOf(x);
    Assert.IsTrue(index >= 0 && index < arrList.Count);
}

[Test]
public void TestCount()
{
    int count = arrList.Count;
    Assert.GreaterOrEqual(count, -1);
}
