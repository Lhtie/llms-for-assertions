namespace Test
{
    [TestFixture]
    public class TestArrayList
    {
        [Test]
        [TestCase(1, 1)]
        [TestCase(2, 2)]
        [TestCase(3, 3)]
        public void TestAdd(int x, int expectedCount)
        {
            ArrayList list = new ArrayList();
            list.Add(x);
    
            // @@@ Assert that the count increased by 1 
            Assert.AreEqual(expectedCount, list.Count);
        }

        [Test]
        [TestCase(1)]
        [TestCase(2)]
        [TestCase(3)]
        public void TestRemove(int x)
        {
            ArrayList list = new ArrayList();
            list.Add(x);
            list.Remove(x);

            // @@@ Assert that the count decreased by 1 
            Assert.AreEqual(0, list.Count);
        }

        [Test]
        [TestCase(1, 1)]
        [TestCase(2, 0)]
        [TestCase(3, 1)]
        public void TestIndexOf(int x, int expectedIndex)
        {
            ArrayList list = new ArrayList();
            list.Add(x);

            // @@@ Assert that the index of x equals expectedIndex
            Assert.AreEqual(expectedIndex, list.IndexOf(x));
        }

        [Test]
        [TestCase(1, 0)]
        [TestCase(2, 1)]
        [TestCase(3, 1)]
        public void TestLastIndexOf(int x, int expectedIndex)
        {
            ArrayList list = new ArrayList();
            list.Add(x);
            list.Add(x);

            // @@@ Assert that the last index of x equals expectedIndex
            Assert.AreEqual(expectedIndex, list.LastIndexOf(x));
        }

        [Test]
        [TestCase(1)]
        [TestCase(2)]
        [TestCase(3)]
        public void TestContains(int x)
        {
            ArrayList list = new ArrayList();
            list.Add(x);

            // @@@ Assert contains x
            Assert.IsTrue(list.Contains(x));
        }
    }
}

