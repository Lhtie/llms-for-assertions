@Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, "@@@ new arrList last index of x remains the same");
@Assert.AreEqual(Old_arrListCount - 1, New_arrListCount, "@@@ new arrList count decreases by 1 after the item has been removed");
@Assert.AreEqual(New_Ret, Old_arrListCount, "@@@ new return value is equal to old arrList count");
@Assert.IsTrue(New_arrListContainsX, "@@@ new arrList contains the inserted element");
@Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "@@@ new arrList count has increased by 1 after the item has been inserted");
@Assert.AreEqual(New_Ret, Old_arrListIndexOfX + 1, "@@@ new return value is equal to old arrList index of x plus 1");
@Assert.IsTrue(New_arrListContainsX, "@@@ new arrList contains the set element");
@Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX, "@@@ new arrList index of x remains the same after the item has been set");
