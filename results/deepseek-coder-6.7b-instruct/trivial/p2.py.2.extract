    assert sum_squares == 1, f"The sum of squares of values in array is {sum_squares}, not 1."--------------------    assert sum_of_squares == 1, f"Sum of squares of the coefficients is not 1, it's {sum_of_squares}"--------------------    assert sum_of_squares == 1, "This is not 1"--------------------    assert sum_squares == 1, "The sum of the squares of the values in the array is not 1"--------------------assert sum([i ** 2 for i in p43_coeffs]) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum_of_squares == 1, f"The sum of squares is {sum_of_squares}, not 1"--------------------    assert sum_of_squares == 1, "Sum of squares of values in array is not 1"--------------------    assert p43_coeffs == [1], "sum of squares of values in array is not 1"--------------------    assert sum([i**2 for i in p43_coeffs]) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum_of_squares == 1, "Sum of squares of values in array is not 1."--------------------