            Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX, "The last position of x in old and new lists are different");--------------------Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX, "The last position of x in old and new lists are different");--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);--------------------            Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX);--------------------            Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX, "last position of x in old and new lists are equal");--------------------