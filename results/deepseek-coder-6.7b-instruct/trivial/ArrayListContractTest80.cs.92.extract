Debug.Assert(New_arrListCount == Old_arrListCount + 1); // @@@ arrList.Add(x) increases count by 1--------------------Debug.Assert(New_Ret != -1 || Old_arrListCount != -1, $"For the condition `New_Ret != -1 || Old_arrListCount != -1`, the returned value from the PUT_LastIndexOfContract method is invalid");--------------------      Debug.Assert((New_Ret != -1) || (Old_arrListCount == -1));--------------------Debug.Assert(Old_arrListCount != -1);--------------------            Debug.Assert(arrList.Count == arrList.Count);--------------------Debug.Assert(Old_arrListCount <= New_arrListCount); // @@@ Count should increase when adding an element--------------------Debug.Assert(New_Ret >= 0 || Old_arrListCount != -1, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(New_arrListCount != -1, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(Old_arrListCount != -1, "If the return value is negative, old list size should not be -1");--------------------Debug.Assert(New_Ret != -1);--------------------