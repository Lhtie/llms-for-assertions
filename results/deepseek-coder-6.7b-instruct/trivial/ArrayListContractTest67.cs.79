        Debug.Assert(arrList != null);
        Debug.Assert(index >= 0 && index < arrList.Count);

        int Old_arrListCount = arrList.Count;
        Debug.Assert(Old_arrListCount >= 0);

        arrList[index] = x;

        int New_arrListCount = arrList.Count;
        Debug.Assert(New_arrListCount >= 0);
        Debug.Assert(New_arrListCount == Old_arrListCount);
    }

