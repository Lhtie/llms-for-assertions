    [Test]
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid]int x)
    {
        Debug.Assert(arrList != null);
        int Old_arrListCount = arrList.Count;
        Debug.Assert(Old_arrListCount >= 0);

        arrList.Add(x);

        int New_arrListCount = arrList.Count;
        Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        Debug.Assert(New_arrListCount >= 0);
    }

    [Test]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid]int x)
    {
        Debug.Assert(arrList != null);
        int Old_arrListCount = arrList.Count;
        Debug.Assert(Old_arrListCount >= 0);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        Debug.Assert(New_arrListCount >= 0);
        Debug.Assert(New_arrListCount == Old_arrListCount - 1);
    }

    [Test]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeValid]int x, [PexAssumeValid]int index)
    {
        Debug.Assert(arrList != null);
        Debug.Assert(index <= arrList.Count && index >= 0);

        int Old_arrListCount = arrList.Count;
        Debug.Assert(Old_arrListCount >= 0);

        arrList.Insert(index, x);

        int New_arrListCount = arrList.Count;
        Debug.Assert(New_arrListCount >= 0);
        Debug.Assert(New_arrListCount == Old_arrListCount + 1);
    }

    [Test]
