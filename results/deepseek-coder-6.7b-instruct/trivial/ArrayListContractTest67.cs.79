```cs
// @@@ If the return value is negative, new list doesnt contain x 
Assert.IsFalse(New_Ret < 0);

// @@@ If the return value of Count is not one greater than before, the count is not incremented correctly
Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);

// @@@ If the return value of IndexOf is not the same as the old count, the item is not added at the end of the list
Assert.AreEqual(Old_arrListCount, New_arrListIndexOfX);

// @@@ If the return value of LastIndexOf is not the same as the old count, the item is not added at the end of the list
Assert.AreEqual(Old_arrListCount, New_arrListLastIndexOfX);

// @@@ If the return value of Contains is false, the item is not added to the list
Assert.IsTrue(New_arrListContainsX);

// @@@ If the return value of Count is not one less than before, the item is not removed correctly
Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

// @@@ If the return value of IndexOf is not negative, the item is not removed correctly
