Debug.Assert(Old_arrListCount >= New_arrListCount); // The count of the array list should remain the same or increase--------------------Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX == -1);----------------------------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(New_Ret < 0 && Old_arrListLastIndexOfX == -1);--------------------Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX == -1, "If the return value is negative, last index of x in old array should be -1");--------------------Debug.Assert(Old_arrListLastIndexOfX == -1 || New_Ret >= 0);--------------------Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX == -1);--------------------Debug.Assert(Old_arrListLastIndexOfX == -1 || New_Ret >= 0);--------------------            Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX == -1); // If the return value is negative, last index of x in old array is -1--------------------