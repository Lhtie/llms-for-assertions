Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);--------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1);----------------------------------------Debug.Assert(Old_arrListCount < New_arrListCount); // @@@ New count should be greater than old count for add operation--------------------    Debug.Assert(Old_arrListCount == New_arrListCount - 1); --------------------Debug.Assert(index <= New_Ret);--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListCount && New_arrListCount == Old_arrListCount + 1);----------------------------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount); // Indicates that count should increase by 1 after adding an element to the list----------------------------------------