        Debug.Assert(New_Ret >= 0 && New_arrListLastIndexOfX <= Old_arrListCount);--------------------            Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);--------------------            Debug.Assert(New_Ret >= 0 || Old_arrListContainsX == false);--------------------Debug.Assert(New_Ret >= 0 && New_Ret <= Old_arrListCount);--------------------Debug.Assert(New_Ret >= 0 && New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0 && New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_Ret >= 0 && New_arrListCount <= Old_arrListCount);--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, new array list's last index of x is <= old arrays count");--------------------            Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);--------------------