--------------------            Debug.Assert(arrList.Count >= 0);--------------------Debug.Assert(Old_arrListCount < New_arrListCount, "ArrayList count should increase after adding an element");--------------------Debug.Assert(Old_arrListIndexOfX >= 0);--------------------Debug.Assert(Old_arrListCount >= 0, "The count of the list should be nonnegative");------------------------------------------------------------            Debug.Assert(New_Ret >= 0, $"If the return value is non-negative, x is in the old array. Old_arrListCount = {Old_arrListCount}, Old_x = {Old_x}, Old_arrListLastIndexOfX = {Old_arrListLastIndexOfX}, Old_arrListContainsX = {Old_arrListContainsX}, New_Ret = {New_Ret}, New_arrListCount = {New_arrListCount}, New_arrListLastIndexOfX = {New_arrListLastIndexOfX}, New_arrListContainsX = {New_arrListContainsX}");--------------------Debug.Assert(New_Ret >= 0 || !Old_arrListContainsX); --------------------Debug.Assert(Old_arrListCount >= 0);--------------------