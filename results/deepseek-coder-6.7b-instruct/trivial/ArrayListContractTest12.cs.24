[Test]
public void Test_AddContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input

    // Act
    int oldCount = arrList.Count;
    int newRet = arrList.Add(x);
    int newCount = arrList.Count;

    // Assert
    Assert.That(oldCount, Is.LessThanOrEqualTo(newCount));
    Assert.That(newRet, Is.EqualTo(newCount - 1));
}

[Test]
public void Test_RemoveContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    arrList.Add(x); // ensure x is in the list before remove operation

    // Act
    int oldCount = arrList.Count;
    arrList.Remove(x);
    int newCount = arrList.Count;

    // Assert
    Assert.That(oldCount, Is.GreaterThan(newCount));
    Assert.That(!arrList.Contains(x));
}

[Test]
public void Test_InsertContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    int index = 0; // Assume any valid index as input

    // Act
    int oldCount = arrList.Count;
    arrList.Insert(index, x);
    int newCount = arrList.Count;

    // Assert
    Assert.That(oldCount, Is.LessThanOrEqualTo(newCount));
    Assert.That(arrList.Contains(x));
    Assert.That(arrList.IndexOf(x), Is.EqualTo(index));
}

[Test]
public void Test_SetContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    int index = 0; // Assume any valid index as input
    arrList.Add(0); // ensure there's an element at index to replace

    // Act
    arrList[index] = x;

    // Assert
    Assert.That(arrList.Contains(x));
    Assert.That(arrList.IndexOf(x), Is.EqualTo(index));
}

[Test]
public void Test_GetContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int index = 0; // Assume any valid index as input
    arrList.Add(0); // ensure there's an element at index to retrieve

    // Act
    int retrievedValue = (int)arrList[index];

    // Assert
    Assert.That(arrList.Contains(retrievedValue));
}

[Test]
public void Test_ContainsContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    arrList.Add(x); // ensure x is in the list

    // Act
    bool ret = arrList.Contains(x);

    // Assert
    Assert.IsTrue(ret);
}

[Test]
public void Test_IndexOfContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    arrList.Add(x); // ensure x is in the list

    // Act
    int index = arrList.IndexOf(x);

    // Assert
    Assert.That(index, Is.GreaterThanOrEqualTo(0));
    Assert.That(arrList[index], Is.EqualTo(x));
}

[Test]
public void Test_LastIndexOfContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 0; // Assume any integer as input
    arrList.Add(x); // ensure x is in the list

    // Act
    int index = arrList.LastIndexOf(x);

    // Assert
    Assert.That(index, Is.GreaterThanOrEqualTo(0));
    Assert.That(arrList[index], Is.EqualTo(x));
}

