--------------------Debug.Assert(New_arrList_IndexOf_x <= Old_arrList_IndexOf_x || New_arrList_IndexOf_x == Old_arrList_Count);  // @@@ If the return value is true, index of x before is less than or equal to after--------------------        Debug.Assert(arrList.Count >= 0); // @@@ Count should be greater than or equal to 0 after addition operation is performed--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(New_Ret >= Old_arrListIndexOfX);--------------------Debug.Assert(Old_arrListCount >= 0); // @@@ New array list count is always non-negative--------------------        Debug.Assert(New_Ret && (Old_arrListIndexOfX <= New_arrListIndexOfX)); // @@@ If the return value is true, index of x before is less than or equal to after --------------------        Debug.Assert(arrList != null);----------------------------------------Debug.Assert(Old_arrListCount >= 0);--------------------