```cs
[TestFixture, PexClass]
public partial class ArrayListContractTest
{
    [PexMethod, ExpectedException(typeof(ArgumentException))]
    public void PUT_AddContract_negativeIndex([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        // @@@ Inserting the element with a negative index should result in an exception
        arrList.Add(x);
    }

    [PexMethod]
    public void PUT_AddContract_nullElement([PexAssumeUnderTest] ArrayList arrList)
    {
        // @@@ Attempting to add null should return the null-value
        Assert.AreEqual(arrList.Add(null), 0);
    }

    [PexMethod]
    public void PUT_RemoveContract_emptyList([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        // @@@ Removing an element from an empty list should result in a non-negative return value
        Assert.GreaterOrEqual(arrList.Remove(x), 0);
    }

    [PexMethod]
    public void PUT_RemoveAtContract_emptyList([PexAssumeUnderTest] ArrayList arrList, int index)
    {
        // @@@ Removing the 0th element from an empty list should result in a non-negative return value
        Assert.GreaterOrEqual(arrList.RemoveAt(index), 0);
    }

    [PexMethod]
    public void PUT_InsertContract_overflow([PexAssumeUnderTest] ArrayList arrList, int x, int index)
    {
        // @@@ Inserting an element at the position just beyond the current count shouldn't throw an exception
        arrList.Insert(index, x);
    }

    [PexMethod]
    public void PUT_ContainsContract_duplicates([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        // @@@ Contains should return true if the list contains duplicates
        arrList.Add(x);
        Assert.IsTrue(arrList.Contains(x));
    }

    [PexMethod]
    public void PUT_LastIndexOfContract_duplicates([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        // @@@ LastIndexOf should return the index of the last occurrence even if the list contains duplicates
        arrList.Add(x);
        Assert.AreEqual(arrList.LastIndexOf(x), arrList.Count - 1);
    }
}
```
