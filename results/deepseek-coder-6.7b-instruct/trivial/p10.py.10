--------------------Here is the Python assert statements corresponding to the comments in the code:

```python
import random

class Account:
    def __init__(self, money):
        self.money = money
        assert money >= 0, "Initial account money should be positive or zero"

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]
        assert len(self.accounts) == 5, "A person should have 5 accounts by default"

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    # tranfter amount is not greater than 100 and is positive
    assert amnt > 0 and amnt <= 100, "Amount to be transferred should be between 1 to 100"

    for acnt in frm.accounts:
	if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
```

The assertions are used to check the conditions in the comments. If the conditions do not meet, the programs raises an AssertionError with an optional error message. If you want your program to proceed in case of an error, you should use try/except blocks.
--------------------The output assert statements based on the above code will be:

```python
def test_transfer():
    alice = Person("Alice")
    bob = Person("Bob")

    # Alice has 5 accounts, each with some amount of money between 0 and 100
    assert all(0 <= acnt.money <= 100 for acnt in alice.accounts)

    # Bob has 1 account with 0 money
    assert bob.accounts[0].money == 0

    # Alice attempts to transfer 50 money from one of her accounts to Bob's account
    assert transfer(alice, bob, 50)
    assert alice.accounts[0].money == 50  # Alice's account should now have less money
    assert bob.accounts[0].money == 50  # Bob's account should now have more money

    # Alice attempts to transfer 100 money from one of her accounts to Bob's account
    # However, Alice only has 50 money in one of her accounts so the transfer should fail
    assert not transfer(alice, bob, 100)
    assert alice.accounts[0].money == 50  # Alice's account should still have less money
    assert bob.accounts[0].money == 50  # Bob's account should still have more money

    # Alice attempts to transfer 50 money from all her accounts to Bob's account
    # She will have to go through each account to find one with enough money
    # However, she does have enough money in one of the accounts
    assert transfer(alice, bob, 50)
    assert alice.accounts[0].money == 0  # Alice's account should now have no money
    assert bob.accounts[0].money == 100  # Bob's account should now have more money
```
