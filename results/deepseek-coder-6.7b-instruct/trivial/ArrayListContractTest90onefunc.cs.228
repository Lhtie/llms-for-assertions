Debug.Assert(New_Ret >= 0 || (Old_arrListCount == New_arrListCount));

// @@@ If the return value is negative, size of old and new list should be same 
Debug.Assert(New_Ret < 0 || (Old_arrListCount == New_arrListCount));

// @@@ The 'IndexOf' of 'old' and 'new' list gives the same result 
Debug.Assert((Old_arrListIndexOfX == New_arrListIndexOfX));

// @@@ The 'Contains' of 'old' and 'new' list after the operation should remain same 
Debug.Assert((Old_arrListContainsX == New_arrListContainsX));

// @@@ The count of list should increase when we add a new item 
Debug.Assert((Old_arrListCount + 1 == New_arrListCount));

// @@@ The 'IndexOf' value should increase when we add a new item 
Debug.Assert((Old_arrListIndexOfX <= New_arrListIndexOfX));

// @@@ The value of 'new' list should be 'true' when we call 'Contains' 
Debug.Assert((New_arrListContainsX == true));

// @@@ The value of 'new' list should be 'false' when we call 'Contains' with an item not in the list 
Debug.Assert((arrList.Contains(int.MaxValue) == false));
```

Please note that this code assumes that the `Contains()` method correctly returns `true` if the item is present in the list, and `false` otherwise. This is a typical assumption in testing, but it's usually a good idea to be a bit more specific in your assertions, especially for more complex methods.
