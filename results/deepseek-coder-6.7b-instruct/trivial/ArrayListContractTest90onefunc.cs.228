--------------------```cs

using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // @@@ If the return value is non-negative, the size of the old and new list should be the same
            if (New_Ret >= 0) {
                Debug.Assert(Old_arrListCount == New_arrListCount);
            }

            // @@@ The index of the element in the old list should be equal to the returned value
            Debug.Assert(Old_arrListIndexOfX == New_Ret);

            // @@@ The element should be present in the new list
            Debug.Assert(New_arrListContainsX);
        }
    }
}

```
The assertions are commented to indicate what they are checking. The last one checks that the element is present in the new list (which would mean its last index is equal to the return value from LastIndexOf).
