    Debug.Assert(New_Ret >= -1); // @@@ If the return value is non-negative, index of x in new array is >= 0 --------------------Debug.Assert(New_Ret >= 0);--------------------    Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(New_arrListCount >= 0, "The new count of the ArrayList should be >= 0");--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0); --------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0); // @@@ If the return value is non-negative, index of x in new array is >= 0--------------------Debug.Assert(Old_arrListCount >= 0); // @@@ Initial count of list should be non-negative--------------------