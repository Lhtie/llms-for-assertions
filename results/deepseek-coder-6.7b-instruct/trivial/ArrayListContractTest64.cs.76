            Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX || New_arrListLastIndexOfX == Old_arrListCount); // @@@ If the last index of x is the same in both lists or if new last index is the count of new list, it could mean x has been added to the end of the list
