// @@@ An empty list has a count of 0
Debug.Assert(arrList.Count == 0);

// @@@ Newly created ArrayList should contain no elements
Debug.Assert(arrList.Count == 0);

// @@@ Adding an element to the list increases its count by 1
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ Add function should always return the index of the newly added element
Debug.Assert(New_Ret == New_arrListCount - 1);

// @@@ Adding an existing element again doesn't increase the count of the list
Debug.Assert(arrList.Count == Old_arrListCount);

// @@@ Removing an element from the list decreases its count by 1
Debug.Assert(New_arrListCount == Old_arrListCount - 1);

// @@@ Removing a non-existing element doesn't change the count of the list
Debug.Assert(New_arrListCount == Old_arrListCount);

// @@@ Inserting an element at the beginning increases the count by 1
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ Inserting an element at an invalid index throws an exception
Debug.Assert(index <= arrList.Count && index >= 0);

// @@@ Setting an element at a valid index changes the element
Debug.Assert(New_Ret != arrList[Old_index]);

// @@@ Getting an element at a valid index returns the element
Debug.Assert(New_Ret == arrList[New_arrListCount - 1]);

// @@@ Getting an element from an empty list throws an exception
Debug.Assert(New_arrListCount > 0);

// @@@ Checking the existence of an element in a list returns true if the element exists
Debug.Assert(New_Ret == Old_x);

// @@@ IndexOf function returns the index of the element if the element exists
Debug.Assert(New_Ret == New_arrListIndexOfX);

// @@@ LastIndexOf function returns the last index of the element if the element exists
