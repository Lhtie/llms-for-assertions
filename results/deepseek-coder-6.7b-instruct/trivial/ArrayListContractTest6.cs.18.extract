Debug.Assert(New_arrListCount >= Old_arrListCount); // The count of the list should not decrease after an addition.--------------------Debug.Assert(New_arrListCount >= Old_arrListCount, "@@@ last position of x in new array is lesser than or equal to old array size");--------------------Debug.Assert(New_arrListIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount); // The count of arrList has increased by at least 1 after the addition--------------------Debug.Assert(New_arrListCount <= Old_arrListCount);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount); // @@@ The count of the new list is greater or equal to the old count----------------------------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount); //@@@ arrList count should not decrease--------------------