```cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // Check if the return value is non-negative
            System.Diagnostics.Debug.Assert(New_Ret >= 0);

            // Check if new list contains x
            System.Diagnostics.Debug.Assert(New_arrListContainsX);
            
            // Check if count of old list and new list are equal or new count is greater
            System.Diagnostics.Debug.Assert(Old_arrListCount <= New_arrListCount);

            // Check if last index of x in old list and new list are equal or new last index is greater
            System.Diagnostics.Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);

            // Check if x is present in old list but not in new list
            System.Diagnostics.Debug.Assert(Old_arrListContainsX && !New_arrListContainsX);
        }
    }
}

```
