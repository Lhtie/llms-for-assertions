Debug.Assert(New_arrListCount == Old_arrListCount - 1); // The count of the array list is reduced by 1 after a remove operation--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != New_arrListCount); // Check if count of array list changed--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != New_arrListCount, "@@@ ArrayList count is not same as last index of x in old array ");--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount == New_arrListCount); // Checks if the count of the array list is not the same in the old and new state--------------------            Debug.Assert(Old_arrListCount == Old_arrListLastIndexOfX, "ArrayList count is not same as last index of x in old ArrayList");--------------------Debug.Assert(Old_arrListCount == Old_arrListLastIndexOfX, "array list count is not same as last index of x in old array");--------------------Debug.Assert(Old_arrListCount - 1 == New_arrListCount, "ArrayList count is not same as last index of x in old array");--------------------