Remember that `Assert` statements are for testing code during the development phase. In production code, you would need to handle these conditions gracefully instead of throwing exceptions.
--------------------```cs
using System.Diagnostics;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;

            // Add operation
            arrList.Add(x);

            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount >= Old_arrListCount, "@@@ index of x in new array is >= in old array");
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;

            // Remove operation
            arrList.Remove(x);

            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount <= Old_arrListCount, "Array count after remove should decrease or remain same");
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;

            // Insert operation
            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount == Old_arrListCount + 1, "Array count after insert should increase by 1");
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            // Set operation
            arrList[index] = x;

            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount == Old_arrListCount, "Array count after set should remain the same");
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            // Get operation
            int New_Ret = (int)(arrList[index]);

            Debug.Assert(New_Ret == arrList[index], "Obtained value should be the same as in the array");
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            bool New_Ret = arrList.Contains(x);

            Debug.Assert(New_Ret == arrList.Contains(x), "Contains operation should return true or false");
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int New_Ret = arrList.IndexOf(x);

            Debug.Assert(New_Ret == arrList.IndexOf(x), "IndexOf operation should return index of x if it exists else -1");
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int New_Ret = arrList.LastIndexOf(x);

            Debug.Assert(New_Ret == arrList.LastIndexOf(x), "LastIndexOf operation should return last index of x if it exists else -1");
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int New_Ret = arrList.Count;

            Debug.Assert(New_Ret == arrList.Count, "Count should return the number of elements in the array list");
        }
    }
}
```
