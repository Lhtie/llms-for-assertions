Debug.Assert(New_Ret != -1 || Old_arrListLastIndexOfX == -1); // @@@ If the return value is negative, last index of x in old array is -1----------------------------------------Debug.Assert(Old_arrListCount >= 0); // The initial count of arrList should be non-negative.--------------------Debug.Assert(Old_arrListContainsX || New_Ret == -1, "If x is not in the list, IndexOf should return -1");--------------------Debug.Assert(Old_arrListLastIndexOfX == -1, "If the return value is negative, last index of x in old array is -1");--------------------Debug.Assert(Old_arrListLastIndexOfX == -1 || (Old_arrListLastIndexOfX != -1 && New_Ret != -1 && New_Ret <= Old_arrListLastIndexOfX));----------------------------------------Debug.Assert(New_Ret < 0 ? Old_arrListLastIndexOfX == -1 : true);--------------------Debug.Assert(arrList.Count == 0);--------------------Debug.Assert(Old_arrListIndexOfX == -1); // @@@ If the return value is negative, last index of x in old array is -1 --------------------