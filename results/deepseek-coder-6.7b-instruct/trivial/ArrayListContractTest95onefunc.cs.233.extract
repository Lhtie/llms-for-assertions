            Debug.Assert(New_Ret >= 0); // Asserts that the return value from LastIndexOf is non-negative--------------------            Debug.Assert(New_Ret >= 0); // If the return value is non-negative, index of x in new array is >= 0--------------------            Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, index of x in new array should be >= 0");--------------------            Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, index of x in new array is >= 0.");--------------------            Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, index of x in new array is >= 0");--------------------