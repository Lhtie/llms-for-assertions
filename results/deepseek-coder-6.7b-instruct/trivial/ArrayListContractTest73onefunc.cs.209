```cs
// @@@ If the return value is non-negative, list counts of new and old array are equal
Debug.Assert(New_Ret >= 0 && Old_arrListCount == New_arrListCount);

// @@@ After operation, the count of array remains unchanged
Debug.Assert(Old_arrListCount == New_arrListCount);

// @@@ If the element was present in the array, the new array should contain the element
if (Old_arrListContainsX) {
    Debug.Assert(New_arrListContainsX);
}

// @@@ If the element was not present in the array, the new array should not contain the element
if (!Old_arrListContainsX) {
    Debug.Assert(!New_arrListContainsX);
}

// @@@ If the element was in the array, its index in the new array should be the same or greater than the previous index
if (Old_arrListLastIndexOfX >= 0) {
    Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
}
```

Please note that the assertions assume that your ArrayList implementation is capable of returning -1 in cases where the element is not present. If this is not the case, you may need to modify the conditions.
