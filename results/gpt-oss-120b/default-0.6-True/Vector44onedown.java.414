    \forall int i; i > index && i < \old(this.size()); 
        ( (\old(this.elementAt(i)) == null) => this.elementAt(i) == null )
        && ( (\old(this.elementAt(i)) != null) => this.elementAt(i).equals(\old(this.elementAt(i))) );
