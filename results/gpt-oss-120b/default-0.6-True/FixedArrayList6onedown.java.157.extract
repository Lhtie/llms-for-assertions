assert (i >= 0 && i < \old(this.realSize())) => (\forall int j; i < j && j < \old(this.realSize()) - 1; this.unsafeGet(j) == this.unsafeGet(j+1));
--------------------
assert (0 <= i && i < \old(this.realSize())) => \forall int j; i < j && j < \old(this.realSize()) - 1; (this.unsafeGet(j) == null && this.unsafeGet(j+1) == null) || (this.unsafeGet(j) != null && this.unsafeGet(j).equals(this.unsafeGet(j+1)));
