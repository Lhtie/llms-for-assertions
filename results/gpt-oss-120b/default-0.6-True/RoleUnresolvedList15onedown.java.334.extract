assert (0 <= index && index <= \old(this.size()) && role != null) => 
    \forall int i; index <= i && i < \old(this.size());
        ( (this.get(i+1) == null && \old(this.get(i)) == null) ||
          (this.get(i+1) != null && this.get(i+1).equals(\old(this.get(i)))) );
--------------------
assert (0 <= index && index <= \old(this.size()) && role != null) => 
       \forall int i; index <= i && i < \old(this.size()); 
           (\old(this.get(i)) == null ? this.get(i+1) == null 
                                      : this.get(i+1).equals(\old(this.get(i))));
--------------------
assert (index >= 0 && index <= \old(this.size()) && role != null) => 
    \forall int i; index <= i && i < \old(this.size()); 
        ( (this.get(i+1) == null && \old(this.get(i)) == null) ||
          (this.get(i+1) != null && this.get(i+1).equals(\old(this.get(i)))) );
--------------------
