assert !c.isEmpty() => \forall int i; 0<=i && i<c.size(); this.get(i).equals(c.get(i)));
--------------------
assert !Objects.isNull(c) => \forall int i; 0 <= i && i < this.size(); this.get(i).equals(c.toArray()[i]);
--------------------
assert !Objects.isNull(c) => \forall int i; 0 <= i && i < this.size(); this.get(i).equals(c.toArray()[(int)i]);
