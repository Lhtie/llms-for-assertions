assert !Objects.isNull(c) => this.size() == c.size() && \forall int i; 0 <= i && i < this.size(); this.get(i).equals(c.toArray()[i]);
--------------------
assert !Objects.isNull(c) => this.containsAll(c) && c.containsAll(this);
--------------------
assert !c.equals(null) => this.containsAll(c) && c.containsAll(this) && this.size() == c.size();
--------------------
