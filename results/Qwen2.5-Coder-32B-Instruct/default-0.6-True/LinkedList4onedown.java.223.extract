assert !Objects.isNull(c) => \forall int i; 0 <= i && i < this.size(); this.get(i).equals(c.toArray()[(int)i]);
--------------------
assert c != null && \forall int i; 0 <= i && i < this.size(); this.get(i).equals(c.toArray()[i]);
--------------------
assert !\old(c == null) => \forall int i; 0 <= i && i < \old(c.size()); this.get(i) == \old(c.get(i));
