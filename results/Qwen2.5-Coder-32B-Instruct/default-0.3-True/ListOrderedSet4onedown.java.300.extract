assert \forall int i; 0 <= i && i < this.size(); (object == null) => (this.get(i) == null || this.get(i).equals(object));
--------------------
assert \forall int index; 0 <= index && index < this.size(); (object == null => this.get(index) == null) && (object != null => this.get(index).equals(object));
--------------------
assert \forall int i; 0 <= i && i < this.size(); (object == null && this.get(i) == null) || (object != null && object.equals(this.get(i)));
