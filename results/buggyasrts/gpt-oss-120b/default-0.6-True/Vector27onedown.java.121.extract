assert \forall int i; 0 <= i && i < this.size(); this.get(i).equals(\result[i]);
--------------------
assert \forall int i; 0 <= i && i < this.size() - 1; \result[i+1].equals(this.elementAt(i));
--------------------
assert \result.length == this.size() && \forall int i; 0 <= i && i < \result.length; (i == 0 ? \result[i] == null : \result[i].equals(this.get(i-1)));
--------------------
assert \forall int i; 0 <= i && i+1 < \result.length; \result[i+1].equals(this.get(i));
--------------------
assert \forall int i; 0 <= i && i < this.size() - 1; \result[i + 1].equals(this.elementAt(i));
