assert \forall String p; this.startsWith(p) && !\old(this.startsWith(p)) => this.countPrefix(p) == \old(this.countPrefix(p)) + 1;
--------------------
assert \forall String prefix; this.startsWith(prefix) && !\old(this.startsWith(prefix)) => this.countPrefix(prefix) == \old(this.countPrefix(prefix)) + 1;
--------------------
assert \forall String p; this.startsWith(p) && !\old(this.startsWith(p)) => this.countPrefix(p) == \old(this.countPrefix(p)) + 1;
--------------------
assert \forall int j; 0 <= j && j <= word.length(); \old(this.countPrefix(word.substring(0, j))) + 1 == this.countPrefix(word.substring(0, j)) && !\old(this.contains(word)) && word != null;
--------------------
assert \forall String p; this.startsWith(p) && !\old(this.startsWith(p)) => this.countPrefix(p) == \old(this.countPrefix(p)) + 1;
