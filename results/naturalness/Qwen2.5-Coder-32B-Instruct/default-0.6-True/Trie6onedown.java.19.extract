assert this.add(word) => (\forall String p; this.startsWith(p) && word.startsWith(p); this.countPrefix(p) == \old(this.countPrefix(p)) + 1);
--------------------
assert \result => \forall int j; 0 <= j && j <= word.length(); this.countPrefix(word.substring(0, j)) == \old(this.countPrefix(word.substring(0, j))) + 1;
--------------------
assert \forall int j; 0<=j && j<=word.length(); this.countPrefix(word.substring(0, j)) == \old(this.countPrefix(word.substring(0, j))) + 1;
--------------------
assert \forall int j; 0<=j && j<=word.length(); this.countPrefix(word.substring(0, j)) == \old(this.countPrefix(word.substring(0, j))) + (\old(!this.contains(word)) ? 1 : 0);
--------------------
assert \forall int j; 0<=j && j<=word.length(); \old(this.countPrefix(word.substring(0, j))) + 1 == this.countPrefix(word.substring(0, j))
