assert \forall String prefix; this.startsWith(prefix) && prefix.length() <= word.length() && word.startsWith(prefix) => !this.keysWithPrefix(prefix).contains(word);
--------------------
assert \forall String p; word.startsWith(p) => !this.keysWithPrefix(p).contains(word);
--------------------
assert \forall String prefix; this.startsWith(prefix) && \old(this.keysWithPrefix(prefix)).contains(word) => !this.keysWithPrefix(prefix).contains(word);
--------------------
assert !this.contains(word) && (\forall String p; this.startsWith(p) && \old(this.keysWithPrefix(p)).contains(word) => !this.keysWithPrefix(p).contains(word));
--------------------
assert \forall String p; this.startsWith(p) && p.length() <= word.length() && word.substring(0, p.length()).equals(p) => !this.keysWithPrefix(p).contains(word);
