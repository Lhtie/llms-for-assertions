
Debug.Assert(OLD(x) + y == x);
--------------------
Debug.Assert(RET = Sum(x, y), "The value of x is not equal to x + y");
--------------------
Debug.Assert(OLD(_size) + y = _size);
--------------------
Debug.Assert(OLD(x) + y == x, "Value of x increases by y in the function");
--------------------
Debug.Assert(OLD(Count) = RET, "The ArrayList should have the same count before and after adding elements");
--------------------
Debug.Assert(RET - y == x); 
--------------------
Debug.Assert(OLD(_items.Length) == _size); // @@@ After increasing the capacity of _items, the length of _items should be the same as the _size of the list
--------------------
Debug.Assert(OLD(Count) < RET); // @@@ After adding an element to the ArrayList, its count should increase by 1
--------------------
Debug.Assert(RET.ToString() == OLD(x) + y.ToString());
--------------------
Debug.Assert(RET = OLD(x) + y);
--------------------