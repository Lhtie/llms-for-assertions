using System;

namespace ArrayList.Test
{
    public class AssertStatementGenerator
    {
        public static void GenerateAssertStatements(string code)
        {
            string[] lines = code.Split('\n');
            foreach (string line in lines)
            {
                if (line.Trim().StartsWith("@@@"))
                {
                    string comment = line.Trim().Substring(3);
                    Console.WriteLine($"Debug.Assert({comment});");
                }
            }
        }
    }
}

