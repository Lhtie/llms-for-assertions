public class AssertStatementsGenerator
{
    public static void GenerateAssertStatements(string csharpCode)
    {
        string[] lines = csharpCode.Split('\n');
        foreach (string line in lines)
        {
            if (line.Trim().StartsWith("@@@"))
            {
                string assertStatement = line.Trim().Replace("@@@", "Debug.Assert(");
                Console.WriteLine(assertStatement + ");");
            }
        }
    }
}

AssertStatementsGenerator.GenerateAssertStatements(csharpCode);
