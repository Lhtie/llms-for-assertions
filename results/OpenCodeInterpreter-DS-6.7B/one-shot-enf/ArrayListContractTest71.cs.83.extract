
Debug.Assert(New_Ret >= Old_arrListCount);
--------------------
Debug.Assert(arrList.Count >= 0);
--------------------
// @@@ Add: The method should return the current Count value before addition
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ Remove: IndexOf, LastIndexOf, and Contains should return -1 after remove
Debug.Assert(New_arrListIndexOfX == -1 && New_arrListLastIndexOfX == -1 && !New_arrListContainsX);

// @@@ Insert: The method should return the current Count value after insertion
Debug.Assert(New_arrListCount == Old_arrListCount + 1);
// @@@ Insert: The inserted item should be indexed correctly
Debug.Assert(arrList[Old_index] == Old_x);

// @@@ Set: The method should return the current Count value after set operation
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ Get: The indexed item should be correct
Debug.Assert(New_Ret == Old_x);

// @@@ Contains: If item is added, Contains should return true
Debug.Assert(New_Ret == Old_arrListContainsX && arrList.Contains(x));

// @@@ IndexOf: The method should return index of the first occurrence of an item
Debug.Assert(New_Ret == 0);

// @@@ LastIndexOf: If the item is added, LastIndexOf should return the index of the addition
Debug.Assert(New_Ret == New_arrListLastIndexOfX && arrList.IndexOf(x) != -1);

// @@@ Count: The method should return the number of elements in the array
Debug.Assert(New_Ret == arrList.Count);

// @@@ If the return value is negative, last index of x in new array is -1 too
Debug.Assert(New_Ret == -1);
--------------------
Debug.Assert(New_Ret >= 0 && New_Ret <= arrList.Count); // @@@ If the return value is greater or equal to 0 and less or equal to the old count of the arraylist (before adding new x), this assert will pass
--------------------
// @@@ If the return value is negative, last index of x in new array is -1 too 
Debug.Assert(New_Ret == -1 ? New_arrListLastIndexOfX == -1 : true);
--------------------
// @@@ The new array list count should always be greater or equal to the old array list count
Assert.IsTrue(New_arrListCount >= Old_arrListCount);

// @@@ If the return value is negative, last index of x in new array is -1 too
Assert.IsTrue((New_Ret < 0) == (New_arrListLastIndexOfX == -1));
--------------------
Debug.Assert(New_Ret >= 0);
--------------------
Debug.Assert(New_arrListCount - Old_arrListCount == 1 && New_arrListContainsX == true && Old_arrListContainsX == false);
--------------------
Debug.Assert(arrList[index] >= 0 && arrList[index] < arrList.Count);
--------------------
Debug.Assert(New_Ret >= Old_arrListCount);
