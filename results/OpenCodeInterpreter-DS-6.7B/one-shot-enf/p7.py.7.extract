
assert np.__version__ > '2'
--------------------
import numpy as np

# numpy version is greater than 2
assert np.__version__ > '2'

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

assert np.all(evalues > 0) and np.all(np.abs(evectors) <= 1)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert np.allclose(mtx @ vec, lambda * vec)
