# numpy version is greater than 2
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)

assert np.__version__ > '2.0'
