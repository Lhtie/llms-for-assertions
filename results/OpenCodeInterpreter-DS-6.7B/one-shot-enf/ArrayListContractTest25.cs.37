```python
assertions = []

with open('input.cs', 'r') as file:
    lines = file.readlines()

for line in lines:
    if line.strip().startswith('// @@@'):
        comment = line.strip().replace('// @@@', '').strip()
        assertions.append(f'System.Diagnostics.Debug.Assert({comment});')
        
