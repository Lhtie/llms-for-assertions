Debug.Assert(arrList.Count == Old_arrListCount + 1); // @@@ Adding element to ArrayList increments its count
Debug.Assert(arrList.Count == New_arrListCount); // @@@ Removing element from ArrayList results in a new count
Debug.Assert(arrList.IndexOf(x) == Old_arrListIndexOfX); // @@@ IndexOf() should always return the same value after insertion
Debug.Assert(arrList.LastIndexOf(x) == Old_arrListLastIndexOfX); // @@@ LastIndexOf() should always return the same value after insertion
Debug.Assert(arrList.Contains(x) == Old_arrListContainsX); // @@@ Contains() should always return the same value after insertion
Debug.Assert(arrList[index] == x); // @@@ Updating the value at a specific index should set the value correctly
Debug.Assert(arrList[index] == New_Ret); // @@@ Getting the value at a specific index should return the correctly set value
Debug.Assert(arrList.Count == New_arrListCount); // @@@ The count should be unchanged after a Get operation
Debug.Assert(arrList.IndexOf(x) == New_arrListIndexOfX); // @@@ IndexOf() should return the new index after an insertion
Debug.Assert(arrList.LastIndexOf(x) == New_arrListLastIndexOfX); // @@@ LastIndexOf() should return the new index after an insertion
Debug.Assert(arrList.Contains(x) == arrList.Contains(x)); // @@@ The Contains() should always return the same value after an insertion
Debug.Assert(arrList.Count == arrList.Count); // @@@ An ArrayList's count before and after a Get operation should be the same
</code>--------------------
