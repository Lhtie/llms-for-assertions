<code>
int Old_arrListCount = arrList.Count;  // @@@ Old count
PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);  // @@@ Assertion to check if the old count is non negative
arrList.Remove(x);  // @@@ Remove x from array

</code>
<code>
int New_arrListCount = arrList.Count;  // @@@ New count
PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);  // @@@ Assertion to check if the new count decreases or remains same
</code>
<code>
arrList.Insert(index, x);  // @@@ Insert x at index in array

</code>
<code>
arrList[index] = x;  // @@@ Set x at index in array
PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);  // @@@ check if old array already contains x 
PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);  // @@@ check if new array contains x

</code>
<code>
bool New_containsNewRet = arrList.Contains(New_Ret);  // @@@ Checking if new array still contains element New_Ret
PexObserve.ValueForViewing("$new_containsNewRet", New_containsNewRet);

</code>
<code>
bool New_Ret = arrList.Contains(x);  // @@@ Checking if array contains x
PexObserve.ValueForViewing("$New_ret", New_Ret);  // @@@ The 'Contains' method should return true if the array contains x

</code>
<code>
int New_Ret = arrList.IndexOf(x);  // @@@ Get the index of x in array
