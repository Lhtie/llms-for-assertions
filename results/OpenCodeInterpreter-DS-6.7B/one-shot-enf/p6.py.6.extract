class Rectangle():
    def __init__(n, m):
        assert n > 0, "height of Rectangle is positive"
        self.exp = n # this is how tall
        self.mat = n+m+2
        assert m > 0, "width of Rectangle is positive"
        self.lin = m # this is how wide

def func(n, m):
    r = Rectangle(n, m)
    assert r.exp > 0, "height of r is positive"
