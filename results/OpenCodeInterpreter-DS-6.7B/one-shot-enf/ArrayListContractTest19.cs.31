using System;

namespace ArrayList.Test
{
    public class AssertStatementGenerator
    {
        public static void GenerateAssertStatements(string code)
        {
            string[] lines = code.Split('\n');
            foreach (string line in lines)
            {
                if (line.Trim().StartsWith("@@@"))
                {
                    string comment = line.Trim().Substring(3);
                    Console.WriteLine($"Debug.Assert({comment});");
                }
            }
        }
    }
}

</code>

When you call `AssertStatementGenerator.GenerateAssertStatements(code)` with the given C# code, it will output the following assert statements corresponding to the comments that start with "@@@":
<code>
Debug.Assert(New last index of x is lesser than or equal to old last index of x );
</code>--------------------