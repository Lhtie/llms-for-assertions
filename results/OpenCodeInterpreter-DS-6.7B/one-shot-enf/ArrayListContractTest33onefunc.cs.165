```python
import re

# This would be your C# source code
csharp_source_code = """..."""

# All assert code lines
assert_lines = [l for l in csharp_source_code.split('\n') if l.strip().startswith("@@@")]

def convert_assert_to_code(assert_line):
    return "Debug.Assert(" + assert_line.replace("@@@", "").strip() + ");"

# Now we will get the assert statements
assert_statements = [convert_assert_to_code(l) for l in assert_lines]

for s in assert_statements:
    print(s)
