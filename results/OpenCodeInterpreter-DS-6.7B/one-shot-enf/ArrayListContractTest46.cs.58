PexMethod]
public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
AssumePrecondition.IsTrue(0 <= index && index < arrList.Count);

int Current_arrListCount = arrList.Count;
int Current_index = index;
arrList.RemoveAt(index);
int New_arrListCount = arrList.Count;
PexObserve.ValueForViewing("$Current_arrList_Count", Current_arrListCount);
PexObserve.ValueForViewing("$New_arrList_Count", New_arrListCount);
PexObserve.ValueForViewing("$Current_arrList_index", Current_index);

Debug.Assert(New_arrListCount == Current_arrListCount - 1);
}
