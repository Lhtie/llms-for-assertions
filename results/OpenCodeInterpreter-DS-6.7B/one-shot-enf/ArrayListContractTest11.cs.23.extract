
Debug.Assert(New_arrListCount > Old_arrListCount);
Debug.Assert(Old_arrListIndexOfX == Old_arrListLastIndexOfX);
Debug.Assert(New_arrListIndexOfX == New_arrListLastIndexOfX);
Debug.Assert(New_arrListContainsX == Old_arrListContainsX);
Debug.Assert(New_Ret == Old_arrListCount);
Debug.Assert((Old_x == New_arrListIndexOfX) && (Old_x == New_arrListLastIndexOfX));
Assert.AreNotSame(Old_x, New_Ret);
Debug.Assert(New_arrListIndexOfX == New_arrListCount - 1);
--------------------
Debug.Assert(New_Ret >= 0);
--------------------
Debug.Assert(New_arrListIndexOfX >= 0);
--------------------
Debug.Assert(New_Ret >= 0);
--------------------
Debug.Assert(New_arrListCount == Old_arrListCount + 1); // @@@ Arraylist count is incremented after an add operation
--------------------
Debug.Assert(New_arrListCount >= 0);
--------------------
     public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
     {
         AssumePrecondition.IsTrue(true);

         int Old_arrListCount = arrList.Count;
         int Old_x = x;
         int Old_arrListIndexOfX = arrList.IndexOf(x);
         int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
         bool Old_arrListContainsX = arrList.Contains(x);

         int New_Ret = arrList.Add(x);

         int New_arrListCount = arrList.Count;
         int New_arrListIndexOfX = arrList.IndexOf(x);
         int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

         bool New_arrListContainsX = arrList.Contains(x);

         Debug.Assert(New_arrListIndexOfX >= 0);
     }
 --------------------
Debug.Assert(arrList.IndexOf(x) >= 0); // @@@ index of x in new array is valid ie >= 0
--------------------
Debug.Assert(arrList.Count >= 0);
Debug.Assert(Old_arrListCount >= 0);
Debug.Assert(Old_arrListIndexOfX >= 0);
Debug.Assert(Old_arrListLastIndexOfX >= 0);
Debug.Assert(New_arrListIndexOfX >= 0);
Debug.Assert(New_arrListLastIndexOfX >= 0);
Debug.Assert(arrList.Contains(x) == Old_arrListContainsX);
Debug.Assert(arrList.Contains(x) == New_arrListContainsX);
Debug.Assert(New_Ret >= 0);
Debug.Assert(New_arrListCount >= arrList.Count);
--------------------
Debug.Assert(New_arrListCount >= Old_arrListCount);
--------------------