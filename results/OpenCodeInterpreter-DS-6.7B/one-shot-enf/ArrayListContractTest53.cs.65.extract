// Commented Asserts
Debug.Assert(New_arrList_Count == Old_arrList_Count + 1); // @@@ AddContract
Debug.Assert(arrList.Count == Old_arrListCount); // @@@ RemoveContract
Debug.Assert(arrList[index] == x); // @@@ InsertContract
Debug.Assert(arrList[index] == x); // @@@ SetContract
Debug.Assert(arrList[index] == x); // @@@ GetContract
Debug.Assert(New_arrList_LastIndexOf_x <= Old_arrList_LastIndexOf_x || !Old_arrListContainsX); // @@@ ContainsContract

// @@@ If the return value is true, new list's last index of x is <= old list's last index of x
Debug.Assert(New_arrList_LastIndexOf_x == -1 || New_arrList_LastIndexOf_x <= Old_arrList_LastIndexOf_x);
Debug.Assert(New_Ret != -1 || !New_arrList_contains_x); // @@@ IndexOfContract
Debug.Assert(New_Ret <= New_arrList_LastIndexOf_x || New_Ret == -1); // @@@ LastIndexOfContract
Debug.Assert(New_Ret == Old_arrListCount + 1 && New_arrListCount == Old_arrListCount); // @@@ CountContract
