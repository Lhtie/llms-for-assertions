public static bool AreSame(int[] array1, int[] array2)
{
    if (array1.Length != array2.Length)
    {
        return false; // @@@ If the arrays have different lengths, they are not equal
    }
    
    for (int i = 0; i < array1.Length; i++)
    {
        if (array1[i] != array2[i]) 
        {
            return false; // @@@ If any element in the same position in the two arrays is not equal, the arrays are not equal
        }
    }
    
    return true; // @@@ If we reach this point, the arrays are equal
}

