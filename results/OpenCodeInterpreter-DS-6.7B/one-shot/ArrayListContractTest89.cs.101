--------------------```python
def read_csharp_code_and_output_assert_statements(code):
    lines = code.split("\n")
    assert_statements = []
    
    for line in lines:
        if line.strip().startswith("@@@"):
            comment = line.strip().replace("@@@", "").strip()
            assert_statement = f"Debug.Assert({comment});"
            assert_statements.append(assert_statement)
    
    return assert_statements

csharp_code = '''
public static int Sum(int x, int y)
{
    sum = x + y;
    // @@@ sum is greater than or equal to x and y 
    return sum;
}
'''

assert_statements = read_csharp_code_and_output_assert_statements(csharp_code)
for statement in assert_statements:
    print(statement)

```

