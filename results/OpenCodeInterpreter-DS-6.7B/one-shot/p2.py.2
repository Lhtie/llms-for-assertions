import re

def extract_assert_statements(code):
    """
    This function extracts assert statements from code
    """
    comments = re.findall(r'# (.*?)$', code, re.MULTILINE)
    assert_statements = [comment for comment in comments if comment.startswith('sum of squares of values in array is ')]
    return assert_statements


code = """def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.push_back(inp)
    # sum of squares of values in array is 1"""

print(extract_assert_statements(code))
```

