```python
import re

code = """
class Rectangle():
    def __init__(n, m):
        self.exp = n # this is how tall
        self.mat = n+m+2
        self.lin = m # this is how wide

def func(n, m):
    r = Rectangle(n, m)
    # height of r is positive
"""

comments = re.findall(r'# (.+)', code)
assert_statements = [f'<code>assert {comment.split(" ")[-1]} > 0</code>' for comment in comments if 'positive' in comment]

print('\n'.join(assert_statements))
```

