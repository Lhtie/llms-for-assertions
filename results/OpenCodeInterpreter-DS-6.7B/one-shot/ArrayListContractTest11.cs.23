public static void Main()
{
    ArrayList arrList = new ArrayList();
    int x = 5;
    int index = 0;

    Debug.Assert(arrList.Add(x) >= 0);

    arrList.Remove(x);

    arrList.Insert(index, x);

    arrList[index] = x;

    Debug.Assert((int)arrList[index] == x);

    Debug.Assert(arrList.Contains(x), "x should be in the list");

    Debug.Assert(arrList.IndexOf(x) >= 0);

    Debug.Assert(arrList.LastIndexOf(x) >= 0);

    Debug.Assert(arrList.Count >= 0);
}
