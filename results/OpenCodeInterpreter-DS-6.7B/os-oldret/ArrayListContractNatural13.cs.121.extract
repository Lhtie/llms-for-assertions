    [TestMethod]
    public void TestArrayListAdd_IncrementCount()
    {
        ArrayList list = new ArrayList();
        int initialCount = list.Count;
        Object obj = new Object();
        list.Add(obj);
        Assert.AreEqual(initialCount + 1, list.Count);
    }
