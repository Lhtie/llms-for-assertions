//ArrayList/Program.cs
﻿using System;

namespace ArrayList
{
    class MainClass
    {
        public static void Main(string[] args)
        {
            ArrayList array = new ArrayList();

            array.Add(1);
            array.Add(2);
            array.Add(3);
            array.Add(4);

            display(array);

            array.Insert(1, 5);

            display(array);

            array.Remove(5);

            display(array);
        }

        public static void display(ArrayList array)
        {
            Console.Write("[ ");

            for(int i = 0; i < array.Count; i++)
            {
                Console.Write(array[i] + " ");
            }

            Console.WriteLine("]");
        }
    }
}//TicTacToe.Console/Models/Game.cs
﻿using System;
using System.ComponentModel;

namespace TicTacToe.Console.Models
{
    public class Game
    {

        private string[,] _board = new string[3, 3];
        public string[,] GameBoard => _board; // getter

        private string _currentPlayer = "X";
        public string CurrentPlayer => _currentPlayer;

        public bool GameOver => Winner != "";

        public string Winner { get; private set; } = "";

        public void Start()
        {
            Reset();
        }

        public void Reset()
        {
            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 3; j++)
                {
                    _board[i, j] = ""; // empty cell
                }
            }

            _currentPlayer = "X";
            Winner = "";
        }

        public void Update(int x, int y)
        {
            if(IsValidMove(x, y))
            {
                _board[x, y] = _currentPlayer; // make move

                if(CheckForWinner(x, y))
                {
                    Winner = _currentPlayer; // declare winner
                }

                _currentPlayer = _currentPlayer == "X" ? "O" : "X"; // switch players
            }
            else--------------------
        }

