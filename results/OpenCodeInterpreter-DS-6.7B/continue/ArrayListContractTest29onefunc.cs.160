    PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
    PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

// an assertion using "Debug.Assert\(.*?\);" that  @@@ last position of x in new array list is greater than or equal to that in old array 
    PexAssert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX); // this line is added by user and it should be corrected to correct check

    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, arrList.ToString());
    Assert.AreEqual(Old_arrListIndexOfX + 1, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListLastIndexOfX + 1, New_arrListLastIndexOfX);
    Assert.AreEqual(!Old_arrListContainsX, New_arrListContainsX);
}
