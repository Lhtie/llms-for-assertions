﻿using SQLite;
using System.Collections.Generic;
using System.Threading.Tasks;
using TestAssistantApp.Models;

namespace TestAssistantApp.Database
{
    public class DatabaseOperation
    {
        private SQLiteAsyncConnection _database;

        public DatabaseOperation(string dbPath)
        {
            _database = new SQLiteAsyncConnection(dbPath);
            _database.CreateTableAsync<TestDTO>().Wait();
        }

        public Task<List<TestDTO>> GetTestsAsync()
        {
            return _database.Table<TestDTO>().ToListAsync();
        }

        public Task<TestDTO> GetTestAsync(int id)
        {
            return _database.Table<TestDTO>()
                            .Where(x => x.Id == id)
                            .FirstOrDefaultAsync();
        }

        public Task<int> SaveTestAsync(TestDTO test)
        {
            return _database.InsertOrReplaceAsync(test);
        }

        public Task<int> DeleteTestAsync(TestDTO--------------------            

        }

