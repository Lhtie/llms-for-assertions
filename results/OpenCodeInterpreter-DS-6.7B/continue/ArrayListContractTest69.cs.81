﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace Test_Assistant.API.Models
{
    public class TestDTO
    {
        public int Id { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public string Requirements { get; set; }
        public string Solution { get; set; }
        public string Results { get; set; }
        public int Difficulty { get; set; }
    }
}

//Test-Assistant/Test_Assistant.API/Controllers/TestsController.cs
﻿using Microsoft.AspNetCore.Mvc;
using System.Collections.Generic;
using System.Net;
using Test_Assistant.API.Models;

namespace Test_Assistant.API.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class TestsController : ControllerBase
    {
        [HttpGet]
        public ActionResult<IEnumerable<TestDTO>> Get()
        {
            return new List<TestDTO>
            {
                new TestDTO { Id = 1, Title = "Software Testing" },
                new TestDTO { Id = 2, Title = "Requirement Analysis" }
            };
        }

        [HttpGet("{id}")]
        public ActionResult<TestDTO> Get(int id)
        {
            return new TestDTO { Id = id, Title = "Software Testing" };
        }
    }
