﻿using System;
using System.Collections.Generic;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTests
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void ConstructorTest()
        {
            var arrayList = new ArrayList();
            Assert.IsNotNull(arrayList);
            Assert.Zero(arrayList.Count);
        }

        [Test]
        public void CountTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);
            Assert.AreEqual(3, arrayList.Count);
        }

        [Test]
        public void AddTest()
        {
            var arrayList = new ArrayList();
            int idx = arrayList.Add(1);
            Assert.AreEqual(0, idx);
        }

        [Test]
        public void InsertTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Insert(1, 3);
            Assert.AreEqual(3, arrayList[1]);
        }

        [Test]
        public void RemoveTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Remove(2);
            Assert.AreEqual(1, arrayList.Count);
        }

        [Test]
        public void IndexOfTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            Assert.AreEqual(1, arrayList.IndexOf(2));
        }

        [Test]
        public void LastIndexOfTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            Assert.AreEqual(1, arrayList.LastIndexOf(2));
        }

        [Test]
        public void ContainsTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            Assert.IsTrue(arrayList.Contains(2));
        }

        [Test]
        public void ClearTest()
        {
            var arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Clear();
            Assert.Zero(arrayList.Count);
        }
    }
}

