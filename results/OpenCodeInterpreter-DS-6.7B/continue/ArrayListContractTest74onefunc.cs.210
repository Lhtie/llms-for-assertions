            else 
            {
                Assert.AreEqual(New_arrListLastIndexOfX, Old_arrListLastIndexOfX);
            }

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If New_ret >= 0, then x should be in the array list 
            if (New_Ret >= 0)
            {
                Assert.IsTrue(New_arrListContainsX);
