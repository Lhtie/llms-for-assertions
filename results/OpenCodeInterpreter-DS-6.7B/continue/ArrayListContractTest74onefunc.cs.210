	    Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);

	    // an assertion using "Debug.Assert\(.*?\);" that x was present in list before operation, i.e., old arrList contains x 
	    Debug.Assert(Old_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that new array list's x count is the same as old array list's x count, i.e., old arrays x count == new array list's x 
	    Debug.Assert(Old_arrListCount == New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that new array list's last index of x is <= old arrays count, i.e., new array list's last index of x <= old arrays count 
	    Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that new array list contains x 
	    Debug.Assert(New_arrListContainsX);
        }
    }
}

