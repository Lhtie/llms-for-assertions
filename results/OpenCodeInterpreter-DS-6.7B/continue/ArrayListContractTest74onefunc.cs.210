    {
        [TestMethod]
        [HostType("Moles")]
        public void PUT_AddContract()
        {
            // Assume preconditions
            Assume.Precondition(true);

            // Setup the arraylist
            var arrList = new ArrayList();
            int x = new int();
            
            // Remember the count before adding the element, last index of x and if it contains x
            int oldCount = arrList.Count;
            int oldLastIndex = arrList.LastIndexOf(x);
            bool oldContains = arrList.Contains(x);

            // Now we're actually adding x to the list
            arrList.Add(x); 

            // Now we know the count, last index of x and if it contains x
            int newCount = arrList.Count;
            int newLastIndex = arrList.LastIndexOf(x);
            bool newContains = arrList.Contains(x);

            // Assertion that count is greater by 1 before and after adding element
            Assert.AreEqual(oldCount + 1, newCount);

            // Last Index Of x should increase as x was added again, therefore should always increment by 1
            Assert.AreEqual(oldLastIndex + 1,--------------------            if (New_Ret >= 0)
            {
                Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListCount);
