	    Assert.AreEqual(true, New_arrListIndexOfX >= 0);
	    Assert.AreEqual(true, New_arrListLastIndexOfX >= 0);
	    Assert.AreEqual(New_arrListIndexOfX, New_arrListLastIndexOfX);
	    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
	    Assert.AreEqual(true, New_arrListContainsX);
        
        }
    }
}

//src/PexAPIWrapper.cs

using System;
using System.Collections;

namespace PexAPIWrapper
{
    public class ArrayList
    {
        private ArrayList innerList = new ArrayList();

        public int Count
        {
            get { return this.innerList.Count; }
        }

        public int Add(int item)
        {
            this.innerList.Add(item);
            return this.Count;
        }

        public int IndexOf(int item)
        {
            return this.innerList.IndexOf(item);
        }

        public int LastIndexOf(int item)
        {
            return this.innerList.LastIndexOf(item);
        }

        public bool Contains(int item)
        {
            return this.innerList.Contains(item);
        }
    }
}

