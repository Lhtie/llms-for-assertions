            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfI = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfI = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsI = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
