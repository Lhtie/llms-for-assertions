//Tests/TestUtilities.cs
using System;
using System.Collections.Generic;

public static class TestUtilities
{
    public static List<T> GetListWithRandomElements<T>(int numberOfElements, Func<T> elementGenerator)
    {
        var result = new List<T>();

        for (int i = 0; i < numberOfElements; i++)
        {
            result.Add(elementGenerator());
        }

        return result;
    }
    
    public static List<int> GetRandomIntegerList(int numberOfElements)
    {
        return GetListWithRandomElements<int>(numberOfElements, () => new Random().Next());
    }
}

