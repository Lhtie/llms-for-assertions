	void Start () {
		GetComponent<Rigidbody>().velocity = transform.forward * speed;
	}
}

// This script simply adds a velocity to the object so that it moves. This particular script moves the 
// object along the z-axis so you can tell that the object is moving without seeing any actual movement.
// If you want to move in a specific direction within world space you’d need to adjust the transform.forward
// component to point in that direction. To move along the x and/or y axis you’d adjust transform.right or 
// transform.up instead.
// speed can be adjusted in the inspector to alter how fast the object moves. It’s applied once upon start.
// note: This requires that the Rigidbody component is attached to the same game object. Use the Rigidbody
// component to control physics-based movements. It can be attached to the game object by clicking on the
