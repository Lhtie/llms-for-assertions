//Code/Scripts/TestRunner.cs
﻿using System;
using System.Diagnostics;
using System.IO;

namespace Code.Scripts
{
    public class TestRunner
    {
        // This variable determines whether we run the program in production mode (true) or in testing mode (false).
        private static bool _debugMode = false;

        public static void TestRun(string filePath)
        {
            if (_debugMode)
            {
                RunCodeAndWriteConsoleOutput(filePath);
            }
            else
            {
                RunCodeAndRedirectOutput(filePath);
            }
        }

        private static void RunCodeAndWriteConsoleOutput(string filePath)
        {
            string fileContents = File.ReadAllText(filePath);
            Console.WriteLine(fileContents);
        }

        private static void RunCodeAndRedirectOutput(string filePath)
        {
            Process process = new Process();
            process.StartInfo.FileName = "dotnet";
            process.StartInfo.Arguments = $"run --project {filePath} --no-build --no-restore";
            process.StartInfo.UseShellExecute = false;
            process.StartInfo.RedirectStandardOutput = true;
            process.StartInfo.RedirectStandardError = true;
            process.Start();

            string output = process.StandardOutput.ReadToEnd();
            string error = process.StandardError.ReadToEnd();

            process.WaitForExit();

            if (!string.IsNullOrEmpty(output))
            {
                Console.WriteLine("Output:");
                Console.WriteLine(output);
            }

            if (!string.IsNullOrEmpty(error))
            {
                Console.WriteLine("Error:");
                Console.WriteLine(error);
            }
        }
    }
}

