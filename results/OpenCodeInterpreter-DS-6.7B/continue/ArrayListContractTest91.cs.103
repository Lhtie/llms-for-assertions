[Serializable]
public class CustomMixerBehaviour : PlayableBehaviour
{
    public float totalTime = 0f;
    
    public override void OnGraphStart(Playable playable)
    {
        base.OnGraphStart(playable);
        Debug.Log("Graph started");
    }

    public override void OnGraphStop(Playable playable)
    {
        base.OnGraphStop(playable);
        Debug.Log("Graph stopped");
    }

    public override void OnPlayableCreate(Playable playable)
    {
        base.OnPlayableCreate(playable);
        Debug.Log("Playable created");
    }

    public override void OnBehaviourPause(Playable playable, FrameData info)
    {
        base.OnBehaviourPause(playable, info);
        Debug.Log("Playable paused");
    }

    public override void OnBehaviourResume(Playable playable, FrameData info)
    {
        base.OnBehaviourResume(playable, info);
        Debug.Log("Playable resumed");
    }

    public override void ProcessFrame(Playable playable, FrameData info, object playerData)
    {
        totalTime += info.deltaTime;
    }
