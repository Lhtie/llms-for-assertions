        public void PUT_GetRangeContract([PexAssumeUnderTest] ArrayList arrList, int index, int count) 
        {
            // ... Contract code ...
            // IMPORTANT NOTE: This method should be implemented according to testing requirements.
            // You may want to create new methods to test the specific features of your program.
            // ... Contract code ...
            // Method under test: arrList.GetRange(index, count)

            // Assuming preconditions:
            // 
            // 1. ArrayList 'arrList' is not null.
            // 2. Index is a valid index for a location within the bounds of 'arrList'.
            // 
            // The post conditions will be tested implicitly.

            // A preliminary precondition: index is a valid index for a location within the bounds of 'arrList'.
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            // Initialize and prepare for testing:
            // Save the state of the 'arrList' object before the test method is called.
            int oldCount = arrList.Count;
            object[] oldArrList = arrList.ToArray(); 

            // Call the test method: arrList.GetRange(index, count)
            object[] result = arrList.GetRange(index, count);

            // Test method results against expected results:
            if (count < 0 || index + count > arrList.Count) 
                Assert.AreEqual(arrList.Count - index, result.Length);
            else
                Assert.AreEqual(count, result.Length);
            for (int i = 0; (i < oldCount) && (i < result.Length); i++) 
            {
                // The ArrayList does not support null elements so we do not compare with null
                Assert.AreEqual(oldArrList[index + i], result[i]); 
            }
        }

    }
}

