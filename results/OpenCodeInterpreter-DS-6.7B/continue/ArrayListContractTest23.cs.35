using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    public class ArrayListTest
    {
        [Test]
        public void Add()
        {
            var arrlist = new ArrayList();
            arrlist.Add(1);
            Assert.IsTrue(arrlist.Contains(1));
        }

        [Test]
        public void Remove()
        {
            var arrlist = new ArrayList();
            arrlist.Add(1);
            arrlist.Remove(1);
            Assert.IsFalse(arrlist.Contains(1));            
        }

        [Test]
        public void Insert()
        {
            var arrlist = new ArrayList();
            arrlist.Insert(0, 1);
            Assert.IsTrue(arrlist.Contains(1));
        }

        [Test]
        public void Clear()
        {
            var arrlist = new ArrayList();
            arrlist.Add(1);
            arrlist.Clear();
            Assert.IsTrue(arrlist.Count == 0);
        }
    }
}

