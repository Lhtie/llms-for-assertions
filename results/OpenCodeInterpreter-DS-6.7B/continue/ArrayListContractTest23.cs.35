        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0 && index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            object Old_obj = arrList[index];
            int Old_arrListIndexOfObj = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfObj = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsObj = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            object New_obj = arrList[index];
            int New_arrListIndexOfObj = arrList.IndexOf(New_obj);
            int New_arrListLastIndexOfObj = arrList.LastIndexOf(New_obj);
            bool New_arrListContainsObj = arrList.Contains(New_obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
