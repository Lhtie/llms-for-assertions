public class Scp079_Chamber01_Sounds : MonlAI
{
    public AudioClip doorSound;
    public AudioClip securityCheckSound;
    public AudioClip itemSound_type1;
    public AudioClip itemSound_type2;
    public AudioClip securityAccessDeniedSound;
    public AudioClip securityAccessGrantedSound;
    public AudioClip enteringChamberSound;
    public AudioClip leavingChamberSound;
}using System.Collections;
using System.Collections.Generic;
using UnityEngine;
public class SoundManager07901 : MonoBehaviour
{
    public static AudioClip doorSound, securityCheckSound, itemSound, securityAccessDeniedSound, securityAccessGrantedSound, enteringChamberSound, leavingChamberSound;
    static AudioSource audioSrc;
    // Start is called before the first frame update
    void Start()
    {
        doorSound = Resources.Load<AudioClip>("doorSound");
        securityCheckSound = Resources.Load<AudioClip>("securityCheck");
        itemSound = Resources.Load<AudioClip>("item");
        securityAccessDeniedSound = Resources.Load<AudioClip>("securityAccessDenied");
        securityAccessGrantedSound = Resources.Load<AudioClip>("securityAccessGranted");
        enteringChamberSound = Resources.Load<AudioClip>("enteringChamber");
        leavingChamberSound = Resources.Load<AudioClip>("leavingChamber");

        audioSrc = GetComponent<AudioSource>();
    }
    // Update is called once per frame

    public static void PlaySound(string clip)
    {
        switch (clip)
        {
            case "doorSound":
                audioSrc.PlayOneShot(doorSound);
                break;
            case "securityCheck":
                audioSrc.PlayOneShot(securityCheckSound);
                break;
            case "itemSound":
                audioSrc.PlayOneShot(itemSound);
                break;
            case "securityAccessDenied":
                audioSrc.PlayOneShot(securityAccessDeniedSound);
                break;
            case "securityAccessGranted":
                audioSrc.PlayOneShot(securityAccessGrantedSound);
                break;
            case "enteringChamber":
                audioSrc.PlayOneShot(enteringChamberSound);
                break;
            case "leavingChamber":
                audioSrc.PlayOneShot(leavingChamberSound);
                break;

        }
    }
