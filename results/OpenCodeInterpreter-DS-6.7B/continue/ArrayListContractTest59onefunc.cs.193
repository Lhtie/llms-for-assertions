}//Tests/TestUtils/ReflectionUtils.cs
using System;
using System.Diagnostics;

namespace TestUtils
{
    // This class can be used for reflection-related tests
    // See test cases in ReflectionTest.cs
    public class ReflectionUtils
    {
        // Test Cases
        // 1. Try to access private field by reflection - should fail
        // 2. Try to set private field by reflection - should succeed
        // 3. Try to get non-existing field by reflection - should fail

        private string privateField = "Private Field Value";

        public void AccessPrivateField(object obj)
        {
            Debug.Assert(privateField.Equals("Private Field Value"));
            var type = obj.GetType();
            var fieldInfo = type.GetField("privateField", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            Debug.Assert(fieldInfo != null);
            Debug.Assert(fieldInfo.GetValue(obj).Equals(privateField));
        }

        public void SetPrivateField(object obj, string value)
        {
            var type = obj.GetType();
            var fieldInfo = type.GetField("privateField", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            Debug.Assert(fieldInfo != null);
            fieldInfo.SetValue(obj, value);
            Debug.Assert(fieldInfo.GetValue(obj).Equals(value));
        }

        public void NonExistingField(object obj)
        {
            var type = obj.GetType();
            var fieldInfo = type.GetField("nonExistingField", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            Debug.Assert(fieldInfo == null);
        }
    }
}

//Tests/TestUtils/ReflectionTest.cs
using System;
using TestUtils;

class ReflectionTest
{
    public static void Main(string[] args)
    {
        ReflectionUtils reflectionUtils = new ReflectionUtils();

        // Try to access private field by reflection
        try
        {
            reflectionUtils.AccessPrivateField(reflectionUtils);
        }
        catch (Exception e)
        {
            Console.WriteLine("Exception caught: " + e.Message);
        }

        // Try to set private field by reflection
        reflectionUtils.SetPrivateField(reflectionUtils, "New Private Field Value");
        reflectionUtils.AccessPrivateField(reflectionUtils);

        // Try to get non-existing field by reflection
        try
        {
            reflectionUtils.NonExistingField(reflectionUtils);
        }
        catch (Exception e)
        {
            Console.WriteLine("Exception caught: " + e.Message);
        }
    }
}

