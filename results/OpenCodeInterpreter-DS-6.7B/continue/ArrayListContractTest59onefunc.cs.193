            Assert.AreEqual(Old_arrListCount, New_arrListCount);

            // an assertion using "Debug.Assert(.*?new);" that  $old_arrList_IndexOf_x ==  $new_arrList_IndexOf_x 
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?new\);" that  $old_arrList_LastIndexOf_x ==  $new_arrList_LastIndexOf_x 
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);

 		    // an assertion using "Debug.Assert\(.*?\);" that  If the return value is true, new list's count is 1 more than the old list 
            Assert.IsTrue(New_Ret ? "True" : "False");
        }
    }
}
```

This test method conducts two types of tests:

- "Input dependency tests" to observe how the Count property changes before and after calling the Contains method.
- "State dependency tests" to validate if the IndexOf and LastIndexOf methods behave correctly and have the new expected values.

We can annotate the tests with `[PexExpectedException(typeof(InvalidCastException))]` to indicate that the operation should throw an expected exception. Here is an example with a Remove method:

```cs
public partial class ArrayListContractTest
{
    [PexMethod]
    [PexExpectedException(typeof(InvalidCastException))]
    public void DELETE_RemoveContract([PexAssumeUnderTest] ArrayList arrList, int index)
    {
        AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

        int Old_arrListCount = arrList.Count;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

        arrList.RemoveAt(index);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

        // omitted for brevity
    }
}
```

In this example, the test is annotated with a specific exception, `InvalidCastException`. This indicates that the RemoveAt method should throw an exception if the input index is not valid.

Pex generates thousands of tests automatically, but it can also be instructed to run a subset of these tests. It ensures that the tests are independent and do not depend on each other. Independent tests make it easier and faster to find the root cause of a test failure.

Pex can also take a test and generate many different 'good' and 'bad' inputs. For example, it might take an empty list and generate all kinds of index values that would throw an exception. This allows it to test edge-cases. Pex is an automated tool, designed to help developers write more effective, efficient, and less error-prone unit tests.

