using System.Diagnostics;
using TestUtils;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        private ReflectionUtils reflectionUtils = new ReflectionUtils();

        // Tests for reflection-related properties
        // 1. Try to access private field by reflection - should fail
        // 2. Try to set private field by reflection - should succeed
        // 3. Try to get non-existing field by reflection - should fail

        // Private field in ArrayList to test
        private string privateField = "Private Field Value";

        [PexMethod]
        public void AccessPrivateField()
        {
            try
            {
                reflectionUtils.AccessPrivateField(this);
            }
            catch (Exception e)
            {
                Debug.WriteLine("Exception caught: " + e.Message);
            }
        }

        [PexMethod]
        public void SetPrivateField()
        {
            reflectionUtils.SetPrivateField(this, "New Private Field Value");
            reflectionUtils.AccessPrivateField(this);
        }

