            Assert.IsTrue(!(New_arrListLastIndexOfX < -1) && !(New_arrListLastIndexOfX > arrList.Count) && !(New_arrListLastIndexOfX < -1));
	    // an assertion using "Debug.Assert\(.*?\);" that  @@  Contains x in new array is false 
