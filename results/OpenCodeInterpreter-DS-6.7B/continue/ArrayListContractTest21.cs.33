        private static PexAssumeRandom s_rand = new PexAssumeRandom((int)(DateTime.Now.Millisecond ^ DateTime.Now.Second));

        private static IEnumerable<int> Pex_GET_item(ArrayList arrList)
        {
            int index = s_rand.GetNext(0, arrList.Count);
            yield return (int)arrList[index];
        }

        private static IEnumerable<int> Pex_GET_Count(ArrayList arrList)
        {
            yield return arrList.Count;
        }

        private static IEnumerable<int> Pex_GET_IndexOf([PexAssumeUnderTest] ArrayList arrList, int item)
        {
            yield return arrList.IndexOf(item);
        }

        private static IEnumerable<int> Pex_GET_RemoveAt([PexAssumeUnderTest] ArrayList arrList, int index)
        {
            int item = (int)arrList[index];
            arrList.RemoveAt(index);
            yield return item;
        }

        private static IEnumerable<int> Pex_GET_LastIndexOf([PexAssumeUnderTest] ArrayList arrList, int item)
        {
            yield return arrList.LastIndexOf(item);
        }
    }
