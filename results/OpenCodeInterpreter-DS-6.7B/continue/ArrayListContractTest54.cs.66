﻿namespace Plex.NET.Models
{
    using Newtonsoft.Json;
    using System.Collections.Generic;

    public class RootObjectPlex
    {
        [JsonProperty("MediaContainer")]
        public MediaContainer MediaContainer { get; set; }
    }

    public class MediaContainer
    {
        [JsonProperty("size")]
        public int Size { get; set; }

        [JsonProperty("title1")]
        public string Title1 { get; set; }

        [JsonProperty("identifier")]
        public string Identifier { get; set; }

        [JsonProperty("machineIdentifier")]
        public string MachineIdentifier { get; set; }

        [JsonProperty("librarySectionID")]
        public string LibrarySectionID { get; set; }
        
        [JsonProperty("librarySections")]
        public List<LibrarySections> LibrarySections { get; set; }
    }
    public class LibrarySections
    {
        [JsonProperty("key")]
        public string Key { get; set; }

        [JsonProperty("type")]
        public string Type { get; set; }

        [JsonProperty("title")]
        public string Title { get; set; }
    }
}

//src/Plex.NET/Plex.NET/PlexClient.cs
﻿using System.Net.Http;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Plex.NET.Models;

namespace Plex.NET
{
    public class PlexClient
    {
        private readonly HttpClient _httpClient;
        private readonly string _baseUrl;

        public PlexClient(string baseUrl)
        {
            _baseUrl = baseUrl;
            _httpClient = new HttpClient { BaseAddress = new System.Uri(_baseUrl) };
        }

        public async Task<RootObjectPlex> GetServer()
        {
            HttpResponseMessage response = await _httpClient.GetAsync("/");
            string json = await response.Content.ReadAsStringAsync();
            return JsonConvert.DeserializeObject<RootObjectPlex>(json);
        }
    }
}

//src/Plex.NET/Plex.NET/Program.cs
﻿using System;

namespace Plex.NET
{
    class Program
    {
        static void Main(string[] args)
        {
            PlexClient plexclient = new PlexClient("https://plex.tv/api/servers");
            var server = plexclient.GetServer().Result;
            Console.WriteLine(server.MediaContainer.Title1);
            Console.ReadLine();
        }
    }
}

