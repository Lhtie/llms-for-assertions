//Framework/Pex.Framework.Analyzer/Pex/Pex/RefImpl/RefImplAnalysisResult.cs
﻿using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Linq;
using System.Text;

namespace Pex.RefImpl
{
    /// <summary>
    /// Encapsulates the result of an execution of a program under Pex, including the observed values and the derived invariants.
    /// </summary>
    public class RefImplAnalysisResult
    {
        private List<KeyValuePair<string, object>> m_observedValues = new List<KeyValuePair<string, object>>();

        public void AddObservedValue(string name, object value)
        {
            m_observedValues.Add(new KeyValuePair<string, object>(name, value));
        }

        public bool CheckInvariants(Action<string, object> invariantChecker)
        {
            bool result = true;
            foreach (var kv in m_observedValues)
            {
                result &= invariantChecker(kv.Key, kv.Value);
            }
            return result;
        }
    }
}

