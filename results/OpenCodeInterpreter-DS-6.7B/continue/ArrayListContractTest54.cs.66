namespace ArrayList.Test
{
    using NUnit.Framework;
    using ArrayList;

    [TestFixture]
    public class ArrayList_AddTest
    {
        ArrayList arrList;

        [SetUp]
        public void Init()
        {
            this.arrList = new ArrayList();
        }

        [Test]
        public void Add_Empty_ReturnsIndexOfAddedElement()
        {
            // arrange
            int expectedIndex = 0;
            int element = 1;

            // act
            int result = arrList.Add(element);

            // assert
            Assert.AreEqual(expectedIndex, result);
        }

        [Test]
        public void Add_NonEmpty_ReturnsIndexOfAddedElement()
        {
            // arrange
            int expectedIndex1 = 0;
            int expectedIndex2 = 1;
            int element1 = 1;
            int element2 = 2;
            arrList.Add(element1);

            // act
            int result = arrList.Add(element2);

            // assert
            Assert.AreEqual(expectedIndex1, result);
        }
    }
}

