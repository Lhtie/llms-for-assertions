            Assert.AreEqual(Old_arrListContainsX && New_arrListContainsX, arrList.Contains(x), "old list contains x == new list contains x");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of old array + 1 == count of new array 
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "Count of old list + 1 == Count of new list");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of new array should be > count of old array (because of Add function) 
            Assert.IsTrue(New_arrListCount > Old_arrListCount, "New count > Old count");

