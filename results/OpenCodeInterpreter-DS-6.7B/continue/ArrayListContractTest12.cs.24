using System.Collections.Generic;
using System.Threading.Tasks;
using SixPack.Incubator.Models;

namespace SixPack.Incubator.Providers
{
    public interface IIncubatorProvider
    {
        Task<IncubatorSettings> GetSettingsAsync(string serviceName);
        Task<RequestResult> SaveSettingsAsync(IncubatorSettings settings);
        Task<IEnumerable<string>> GetServiceNamesAsync();
    }
}

//src/SixPack.Incubator.Tests/IncubatorServiceTests.cs
using System.Threading.Tasks;
using SixPack.Incubator.Models;
using SixPack.Incubator.Providers;
using Xunit;

namespace SixPack.Incubator.Tests
{
    public class IncubatorServiceTests
    {
        [Fact]
        public async Task TestGetSettingsAsync()
        {
            var provider = new MockIncubatorProvider();
            var sut = new IncubatorService(provider);

            var result = await sut.GetSettingsAsync("TestService");

            Assert.NotNull(result);
            Assert.Equal("TestDescription", result.Description);
        }

        [Fact]
        public async Task TestSaveSettingsAsync()
        {
            var provider = new MockIncubatorProvider();
            var sut = new IncubatorService(provider);

            var settings = new IncubatorSettings
            {
                ServiceName = "TestService",
                Description = "TestDescription",
                Configuration = "TestConfig"
            };

            var result = await sut.SaveSettingsAsync(settings);

            Assert.True(result.Success);
        }
    }
}

//src/SixPack.Incubator/IncubatorService.cs
using System.Collections.Generic;
using System.Threading.Tasks;
using SixPack.Incubator.Models;
using SixPack.Incubator.Providers;

namespace SixPack.Incubator
{
    public class IncubatorService
    {
        private IIncubatorProvider _provider;

        public IncubatorService(IIncubatorProvider provider)
        {
            _provider = provider;
        }

        public async Task<IncubatorSettings> GetSettingsAsync(string serviceName)
        {
            return await _provider.GetSettingsAsync(serviceName);
        }

        public async Task<RequestResult> SaveSettingsAsync(IncubatorSettings settings)
        {
            return await _provider.SaveSettingsAsync(settings);
        }

        public async Task<IEnumerable<string>> GetServiceNamesAsync()
        {
            return await _provider.GetServiceNamesAsync();
        }
    }
}

