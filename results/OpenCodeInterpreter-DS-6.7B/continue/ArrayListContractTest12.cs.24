            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX, "index of x in old list is same as in new list ");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x in old array is >= -1 
            Assert.IsTrue(Old_arrListLastIndexOfX >= -1, "old list last index of x is >= -1");

