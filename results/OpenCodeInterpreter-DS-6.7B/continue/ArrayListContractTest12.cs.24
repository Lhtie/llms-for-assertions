	    // @@@ an assertion using "Assert\.IsTrue\(.*?\);" that  new array list contains x
            Assert.IsTrue(New_arrListContainsX);
	}
    }
}//src/SixPack.Incubator/Models/IncubatorModel.cs
namespace SixPack.Incubator.Models
{
    public class IncubatorSettings
    {
        public string ServiceName { get; set; }
        public string Description { get; set; }
        public string Configuration { get; set; }
    }

    public class RequestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; }
    }
}

