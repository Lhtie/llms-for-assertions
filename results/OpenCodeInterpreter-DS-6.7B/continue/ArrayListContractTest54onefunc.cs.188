public void ContainsTest(ArrayList list)
{
    // Arrange
    int indexToTest = list.Count / 2;
    int valueToTest = (int) list[indexToTest];
    //Act
    bool result = list.Contains(valueToTest);
    //Assert
    // Here in Pex post-condition specify that the result should be true if the list contains the valueToTest. Use PexAssert.IsTrue or PexAssert.IsFalse depending on the expected outcome.
    // Make sure to include the result and valueToTest as parameters if the method that contains this test method is a class method.
    // PexAssert.IsTrue(result--------------------	    // @@@ If the return value is true, The count of new list should equal to the old list @ [PexPostcondition(Method = "Contains", Arguments = new object[] { typeof(ArrayList), typeof(int) })]
            return;
        }
    }
}
```

