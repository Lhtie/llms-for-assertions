//roslyn/Suggestions/1_0_0/Microsoft.CodeAnalysis.Suggestions/Source/Symbols/SymbolExtensions.cs
#if !CodeAnalysis

using System;
using System.Diagnostics;
using Microsoft.CodeAnalysis.Symbols;

namespace Microsoft.CodeAnalysis
{
    internal static class SymbolExtensions
    {
        public static Type ParameterType(this IMethodSymbol methodSymbol, int index)
        {
#if !CodeAnalysis
            var internalSymbol = methodSymbol as IMethodSymbolInternal;
            Debug.Assert(internalSymbol != null);
            return internalSymbol.ParameterType(index);
#else
            throw new NotImplementedException();
#endif
        }

        public static Type ReturnType(this IMethodSymbol methodSymbol, out bool isByRef)
        {
#if !CodeAnalysis
            var internalSymbol = methodSymbol as IMethodSymbolInternal;
            Debug.Assert(internalSymbol != null);
            return internalSymbol.ReturnType(out isByRef);
#else
            throw new NotImplementedException();
#endif
        }
    }
}
#endif

