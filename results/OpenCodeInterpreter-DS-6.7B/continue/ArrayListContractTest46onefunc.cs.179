﻿using System;
using System.Net.Http;
using System.Threading.Tasks;

namespace RDNTracker.Business.Helpers
{
    internal static class ApiAccessor
    {
        internal static async Task<T> GetAsync<T>(string url, Action<HttpRequestMessage> configureRequest = null, Func<HttpResponseMessage, Task<T>> readResponseAs = null)
        {
            using (var client = new HttpClient())
            {
                var request = new HttpRequestMessage(HttpMethod.Get, url);
                configureRequest?.Invoke(request);

                using (var response = await client.SendAsync(request))
                {
                    return await readResponseAs != null ? readResponseAs(response) : await response.Content.ReadAsAsync<T>();
                }
            }
        }
    }
}

//src/RDNTracker.Business/Models/TransferEvent.cs
﻿using System;

namespace RDNTracker.Business.Models
{
    public class TransferEvent : IEquatable<TransferEvent>
    {
        public string BlockHash { get; set; }

        public uint BlockNumber { get; set; }

        public string From { get; set; }

        public string To { get; set; }

        public string Value { get; set; }

        public string Gas { get; set; }

        public string GasPrice { get; set; }

        public string IsError { get; set; }

        public string TxnHash { get; set; }

        public uint TxnIndex { get; set; }

        public uint ContractAddress { get; set; }

        public bool Equals(TransferEvent other)
        {
            if (other == null)
            {
                return false;
            }

            if (ReferenceEquals(this, other))
            {
                return true;
            }

            return From == other.From && To == other.To && Value == other.Value;
        }

        public override bool Equals(object obj)
        {
            return Equals(obj as TransferEvent);
        }

        public override int GetHashCode()
        {
            return From?.GetHashCode() ?? 0 ^ To?.GetHashCode() ?? 0 ^ Value?.GetHashCode() ?? 0;
        }
    }
}

