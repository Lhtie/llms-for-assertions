# Bob [55, 9, 93, 100, 95]import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    if(amnt < 1 or amnt > 100):
        return "Invalid transfer amount. Amount must be between 1 and 100"

    if(frm.money < amnt):
        return f"Insufficient balance in account {frm.owner.name}"

    frm.money -= amnt
    to.money += amnt

    return "Transfer successful"

def show(p):
    print(p.name, [acc.money for acc in p.accounts])


class transfer_details:
    def __init__(self, sender, receiver, amount):
        self.sender = sender
        self.receiver = receiver
        self.amount = amount
        self.status = False

def bank_transfer(sender_person, receiver_person, amount):
    for acc in sender_person.accounts:
        if acc.money > amount: 
            transfer(acc,receiver_person.accounts[0],amount) 
            return transfer_details(sender_person,receiver_person,amount)
        else:
            continue      
    return "Insufficient balance in the accounts of sender"

