    except Exception as e:
        print(f"An error occured: {e}")

    return True

def process_transfers(persons):
    """Process a series of transfers between persons."""
    
    transfers = [(random.choice(persons), random.choice(persons), random.randint(1,100)) for _ in range(10)]
    
    for frm, to, amnt in transfers:
        print(f'Attempt to transfer {amnt} from {frm} to {to}')
    
        # make sure frm and to are different
        if frm is to:
            continue
        
        success = transfer(frm.accounts[random.randint(0,4)], to.accounts[random.randint(0,4)], amnt)

        if success:
            print(f'Transfer of {amnt} from {frm} to {to} successful\n')
        else:
            print(f'Transfer of {amnt} from {frm} to {to} failed\n')


