Text_Analyserdef sum_array(array):
    """Return the sum of all items in the array"""
    return sum(array)

def fibonacci(n):
    """Return nth value in the Fibonacci sequence"""
    sequence=[0,1]
    while len(sequence)<n+1:
        sequence.append(sequence[-1]+sequence[-2])
    return sequence[n]

def factorial(n):
    """Return the factorial of n"""
    if n == 0:
        return 1
    else:
        return n * factorial(n-1)

def reverse(word):
    """Return the word reversed"""
    return word[::-1]

def find_max(array):
    """Find the maximum value in the array"""
    return max(array)

def find_min(array):
    """Find the minimum value in the array"""
    return min(array)

def sort_array(array):
    """Sort the array in ascending order"""
    array.sort()
    return array

def sort_array_desc(array):
    """Sort the array in descending order"""
    array.sort(reverse=True)
    return array

