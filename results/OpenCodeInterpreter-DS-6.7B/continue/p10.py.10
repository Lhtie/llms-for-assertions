def distribute_account_balances(persons):
    for person in persons:
        for account in person.accounts:
            distribute(person, account)

def distribute(person, account):
    total_balance = account.money
    num_accounts = len(person.accounts)
    
    for _ in range(num_accounts):
        part = total_balance // num_accounts
        transfer(account, account, part)
        total_balance -= part
        num_accounts -= 1
    
    print(f'Person: {person.name}, Account balance: {account.money}')
    
    
    
persons = [Person("Person " + str(i)) for i in range(7)]

for person in persons:
    for account in person.accounts:
        distribute_account_balances(persons)
        print(f"Person: {person.name}, Account balance: {account.money}")

