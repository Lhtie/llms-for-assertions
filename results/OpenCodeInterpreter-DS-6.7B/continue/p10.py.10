    assert isinstance(amnt, int) and 0 < amnt <= 100, "Amount to transfer must be a positive integer less than 100" 
    assert frm.accounts[0].money >= amnt, f"The person {frm.name} does not have enough money"
    
    frm.accounts[0].money -= amnt
    to.accounts[0].money += amnt

