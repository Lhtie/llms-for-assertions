def isIsomorphic(s, t):
    dict_s = dict()
    dict_t = dict()
    ret = True
    if len(s) != len(t):
        return False
    for i in range(len(s)):
        if s[i] in dict_s:
            if dict_s[s[i]] != t[i]:
                ret = False
                break
        else:
            dict_s[s[i]] = t[i]
        
        if t[i] in dict_t:
            if dict_t[t[i]] != s[i]:
                ret = False
                break
        else:
            dict_t[t[i]] = s[i]
    return ret

