import math


class Card:
    ranks = ['A'] + list(range(2, 11)) + ['J', 'Q', 'K' ]
    suits = ['Hearts', 'Diamonds', 'Clubs', 'Spades']

    def __init__(self, rank, suit):
        self.rank = rank
        self.suit = suit

    def __repr__(self):
        return f"{self.rank} of {self.suit}"


class Deck:
    def __init__(self):
        self.cards = [Card(rank, suit) for rank in Card.ranks for suit in Card.suits]
        shuffle(self.cards)

    def deal(self):
        return self.cards.pop()


class Player:
    def __init__(self, name, hand=[]):
        self.name = name
        self.hand = hand

    def add_card(self, card):
        self.hand.append(card)

    def discard(self, card):
        if card in self.hand:
            self.hand.remove(card)

    def __repr__(self):
        return f"Player {self.name}"


class CardGame:
    def __init__(self, players):
        self.players = players
        self.current_player = None

    def play(self):
        num_cards = math.floor(52/len(self.players))
        deck = Deck()
        for player in self.players:
            for _ in range(num_cards):
                player.add_card(deck.deal())
        self.current_player = self.players[0]
        while len(deck.cards) > 0:
            card_drawn = deck.deal()
            print(f"{self.current_player} draws a {card_drawn}")
            choice = input("Do you want to keep this card? (Y/N) =>")
            if choice.lower() == 'y':
                self.current_player.discard(card_drawn)
            self.current_player = self.players[(self.players.index(self.current_player) + 1) % len(self.players)]

players = [Player(name) for name in ['Alice', 'Bob', 'Charlie']]
game = CardGame(players)
game.play()class Solution:
    def largestAltitude(self, gain: List[int]) -> int:
        altitude = [0]
        max_altitude = 0
        for i in range(len(gain)):
            altitude.append(altitude[i] + gain[i])
            if altitude[i+1] > max_altitude:
                max_altitude = altitude[i+1]
        return max_altitude"""
This module implements the classic map-reduce pattern on an array of integers. 
For simplicity, it takes an array of integer and returns the sum of the elements.

"""

def map(array):
    """
    This function implements a simple map operation which, for each element x of the array,
    returns x*x in a new array.
    Args:
        array: A list of integers.
    Returns:
        A list where each element is the result of x*x
    """
    return [x*x for x in array]

