index_map = {v: k for k, v in enumerate(list_of_colors)}

class ColorException(Exception):
    pass

class Color:
    def __init__(self, color):
        if color.lower() not in index_map:
            raise ColorException('Invalid color name. ')
        self._color = color.lower()
        
    @property
    def color(self):
        return self._color
    
    def __lt__(self, other_color):
        return index_map[self._color] < index_map[other_color._color]
    
    def __le__(self, other_color):
        return index_map[self._color] <= index_map[other_color._color]
    
    def __gt__(self, other_color):
        return index_map[self._color] > index_map[other_color._color]
    
    def __ge__(self, other_color):
        return index_map[self._color] >= index_map[other_color._color]
    
    def __eq__(self, other_color):
        return index_map[self._color] == index_map[other_color._color]
    
    def __ne__(self, other_color):
        return index_map[self._color] != index_map[other_color._color]
    
    
    
if __name__=='__main__':
    
    c1 = Color('green')
    c2 = Color('purple')

    print(c1.color)
    print(c2.color)
    print(c1 < c2)
    print(c1 > c2)
    print(c1 == c2)
    print(c1 != c2)
    
    try:
        c3 = Color('fake color')
    except ColorException as ce:
        print(ce)
        
    try:
        c1 > 'not a color'
    except ColorException as ce:
        print(ce)

    
