--------------------np.testing.assert_almost_equal(lambdavec, lambda * vec)

# compute the norm of the error vector
error = np.linalg.norm(lambdavec - lambda * vec)

print("Error : ", error)

# an assertion that the error is close to zero. We must subtract 1e-15 from the bound_value because
# of the numerical instability of the very small negative value of error that numpy can return.

assert error <= 1e-15, "The error is too large"
