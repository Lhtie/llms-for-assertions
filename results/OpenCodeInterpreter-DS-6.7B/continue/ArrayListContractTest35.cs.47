using System;
using System.Collections;
using NUnit.Framework;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListExampleTest
    {
        [Test]
        public void ArrayListAdd()
        {
            {
              ArrayList myArrayList = new ArrayList();
              myArrayList.Add("Hello");
              myArrayList.Add(2);
              myArrayList.Add(new DateTime(1976, 7, 4));

              Assert.AreEqual("Hello", myArrayList[0]);
              Assert.AreEqual(2, myArrayList[1], "The second item should be a number.");
              Assert.AreEqual(new DateTime(1976, 7, 4), myArrayList[2]);
            }
        }
