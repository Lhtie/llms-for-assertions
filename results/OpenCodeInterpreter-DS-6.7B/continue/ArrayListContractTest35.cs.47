    public partial class ArrayListSampleTests
    {
        [PexMethod]
        public void PexSampleMethod([PexAssumeUnderTest]ArrayList arrList1, ArrayList arrList2, int x, [PexAssumeUnderTest]ArrayList arrList3)
        {
            AssumePrecondition.IsTrue(true);

            int count = arrList1.Add(x);
            bool contains = arrList1.Contains(x);

            arrList1.Remove(x);
            bool containsPostRemove = arrList1.Contains(x);

            PexAssume.IsTrue(contains);
            PexObserve.ValueForViewing("", count);
            PexObserve.ValueForViewing("", containsPostRemove);
        }
    }
}
