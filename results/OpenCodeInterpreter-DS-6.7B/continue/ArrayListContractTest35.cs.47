namespace SFA.DAS.CommitmentsV2.UnitTests.Application.Commands.AssignStudentCommandTests
{
    [TestFixture]
    public class WhenIWantToHandleNullStudentId : AssignStudentCommand_spec
    {
        [Test]
        public void ThenItShouldThrowAnArgumentNullException()
        {
            // Arrange
            var entityId = Guid.NewGuid();
            const string commitmentsV2ApiUrl = "http://localhost";
            var getApprenticeQuery = new Mock<IGetApprenticeQuery>();
            getApprenticeQuery.Setup(x => x.GetApprentice(It.IsAny<Guid>())).Returns(new Apprentice(entityId, "foo"));
            var apprenticeshipUpdateService = new Mock<IApprenticeshipUpdateService>();
            var commitmentsRepository = new Mock<ICommitmentsRepository>();

            var command = new AssignStudentCommand(commitmentsV2ApiUrl, getApprenticeQuery.Object, apprenticeshipUpdateService.Object, commitmentsRepository.Object);

            // Act & Assert
            Assert.Throws<ArgumentException>(() => command.Execute(null, entityId));
        }
    }
}
