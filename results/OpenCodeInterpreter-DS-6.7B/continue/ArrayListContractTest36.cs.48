using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Constants;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public class TestArrayList
    {
        [PexMethod]
        public void PexTestAdd([PexAssumeUnderTest]ArrayList<int> target)
        {
            int n = target.Add(1);
            
            Assert.AreEqual(1, n);            
            Assert.AreEqual(1, target.Count);            
            Assert.AreEqual(0, target.IndexOf(1));
        }

        [PexMethod]
        public void PexTestRemove([PexAssumeUnderTest]ArrayList<int> target)
        {
            target.Add(1);
            bool removed = target.Remove(1);

            Assert.IsTrue(removed);
            Assert.AreEqual(0, target.Count);
        }

        [Test, ExpectedException(typeof(PexInvalidOperationException))]
        public void PexTestInvalidRemove()
        {
            ArrayList<int> target = new ArrayList<int>();
            target.Remove(1);
        }

        [PexMethod]
        public void PexTestInsert([PexAssumeUnderTest]ArrayList<int> target)
        {
            target.Insert(0, 1);
       
            Assert.AreEqual(1, target.Count);
            Assert.AreEqual(0, target.IndexOf(1));
        }

        [Test, ExpectedException(typeof(PexInvalidOperationException))]
        public void PexTestInvalidInsert()
        {
            ArrayList<int> target = new ArrayList<int>();
            target.Insert(1, 1);
        }

        [PexMethod]
        public void PexTestSet([PexAssumeUnderTest]ArrayList<int> target)
        {
            target.Add(1);
            target[0] = 2;

            Assert.AreEqual(2, target[0]);
        }

        [Test, ExpectedException(typeof(PexInvalidOperationException))]
        public void PexTestInvalidSet()
        {
            ArrayList<int> target = new ArrayList<int>();
            target[0] = 1;
        }
    }
