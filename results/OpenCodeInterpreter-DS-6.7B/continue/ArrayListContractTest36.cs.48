using System;
using System.Threading.Tasks;
using Microsoft.Extensions.Logging;
using SFA.DAS.Apprenticeships.Services.Courses.Infrastructure;

namespace SFA.DAS.Apprenticeships.Services.Courses.Application
{
    public class CourseService : ICourseService
    {
        private readonly ICourseServiceClient _courseServiceClient;
        private readonly ILogger<CourseService> _logger;

        public CourseService(ICourseServiceClient courseServiceClient, ILogger<CourseService> logger)
        {
            _courseServiceClient = courseServiceClient ?? throw new ArgumentNullException(nameof(courseServiceClient));
            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
        }

        public async Task<Course> GetCourse(int courseId)
        {
            _logger.LogInformation($"Requesting course with Id={courseId}");
            var result = await _courseServiceClient.GetCourse(courseId);
            _logger.LogInformation($"Course with Id={courseId} received");
            return result;
        }

        public async Task<CourseSearchResult> SearchCourses(CourseSearchParameters parameters)
        {
            _logger.LogInformation($"Searching for courses with parameters='{parameters}'");
            var result = await _courseServiceClient.SearchCourses(parameters);
            _logger.LogInformation($"Courses found with parameters='{parameters}'");
            return result;
        }
    }
}

//src/SFA.DAS.Apprenticeships.Services.Courses/Application/ICourseService.cs
