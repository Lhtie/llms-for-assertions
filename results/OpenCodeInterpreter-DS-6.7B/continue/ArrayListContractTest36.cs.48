    [Test]
    public void Add_Element_CountIsUpdated()
    {
        ArrayList arrList = new ArrayList();
        int initialCount = arrList.Count;

        arrList.Add(123);

        Assert.AreEqual(initialCount + 1, arrList.Count);
    }

    [Test]
    public void Add_Element_ContainsElement()
    {
        ArrayList arrList = new ArrayList();

        arrList.Add(123);

        Assert.IsTrue(arrList.Contains(123));
    }

    // Tests for Remove method

    [Test]
    public void Remove_ExistingElement_CountIsUpdated()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(123);
        int initialCount = arrList.Count;

        arrList.Remove(123);

        Assert.AreEqual(initialCount - 1, arrList.Count);
    }

    [Test]
    public void Remove_ExistingElement_ItemIsRemoved()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(123);

        arrList.Remove(123);

        Assert.IsFalse(arrList.Contains(123));
    }

    // Tests for Insert method

    [Test]
    public void Insert_ValidIndex_ElementIsInserted()
    {
        ArrayList arrList = new ArrayList();

        arrList.Insert(0, 123);

        Assert.AreEqual(123, arrList[0]);
    }

    [Test]
    public void Insert_ValidIndex_CountIsUpdated()
    {
        ArrayList arrList = new ArrayList();
        int initialCount = arrList.Count;

        arrList.Insert(0, 123);

        Assert.AreEqual(initialCount + 1, arrList.Count);
    }

    // Tests for [] operator

    [Test]
    public void Indexer_ValidIndex_ReturnsCorrectElement()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(123);

        Assert.AreEqual(123, arrList[0]);
    }

