namespace Fruit
{
    public class FruitPurchase
    {
        public string Fruit { get; set; }
        public int Quantity { get; set; }
        public decimal Price { get; set; }
        public decimal Total => Quantity * Price;

        public FruitPurchase(string fruit, int quantity, decimal price)
        {
            Fruit = fruit;
            Quantity = quantity;
            Price = price;
        }
    }
}

//src/Program.cs
using System;
using System.Collections.Generic;
using Fruit;

namespace FruitStand
{
    class Program
    {
        static void Main(string[] args)
        {
            var purchases = new List<FruitPurchase>();

            Console.WriteLine("Welcome to our Fruit Stand!");

            while (true)
            {
                Console.WriteLine("What fruit would you like to purchase? (Enter 'banana', 'apple', or 'orange')");

                var fruitName = Console.ReadLine().ToLower();

                Console.WriteLine($"How many {fruitName}s would you like?");

                if (!int.TryParse(Console.ReadLine(), out var quantity))
                {
                    Console.WriteLine("Invalid quantity entered!");
                    return;
                }

                var fruitPrice = 0.0m;
                switch (fruitName)
                {
                    case "banana":
                        fruitPrice = 0.05m;
                        break;

                    case "apple":
                        fruitPrice = 0.1m;
                        break;

                    case "orange":
                        fruitPrice = 0.15m;
                        break;

                    default:
                        Console.WriteLine("Invalid fruit entered!");
                        return;
                }

                var purchase = new FruitPurchase(fruitName, quantity, fruitPrice);
                purchases.Add(purchase);

                Console.WriteLine($"Added {purchase.Quantity} {purchase.Fruit} to your cart at a price of {purchase.Price:C}, totaling {purchase.Total:C}");

                Console.WriteLine("Would you like to purchase another fruit? (Y/N)");

                if (Console.ReadLine().ToLower() == "n")
                    break;
            }

            var total = 0.0m;
            foreach (var purchase in purchases)
                total += purchase.Total;

            Console.WriteLine($"Your total spending is {total:C}");
        }
    }
