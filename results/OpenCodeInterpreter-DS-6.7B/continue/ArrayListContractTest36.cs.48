//PexFramework.Core.Dll, Version=1.0.0.0, Culture=neutral, PublicKeyToken=3c84c7caf9a323cb - PexAPIWrapper, Version=1.0.0.0, Culture=neutral, PublicKeyToken=nullpublic void PUT_AddContract([PexAssumeUnderTest](ArrayList)
