
    return f'Transfering from {frm.name} to {to.name} - amount : {amnt}'


p1 = Person('Orel')
p2 = Person('Eitan')

print(transfer(p1, p2, 50))
assert 0 < p1.accounts[0].money - 50 and p1.accounts[0].money != 0, 'transfer amount is not positive or bigger than account balance'
----------------------------------------    for i in range(len(to.accounts)):
        if to.accounts[i].money - amnt >= 0:
            frm.accounts[i].money -= amnt
            to.accounts[i].money += amnt
            return True
    return False


def total(persons):
    """ returns total money in all accounts """

    total = 0
    for p in persons:
        for a in p.accounts:
            total += a.money
    return total
    
# list of people
persons = [ Person('Person '+str(i)) for i in range(5) ]
    
print('Before transfers: ', total(persons))

s = True
c = 0
# attempt to make a very basic "simulation" of transfers
while s:
    c+=1
    a = random.choice(persons)
    b = random.choice(persons)
    while b == a:
        b = random.choice(persons)
    s = transfer(a, b, random.randint(1,50))
print('After transfers: ', total(persons))
print('attempted {} transfers'.format(c))

total_money = total(persons)
assert total_money == ( len(persons) * len(persons[0].accounts) * 100) , 'total money in accounts is not equal to initial amount'
