	        // Assert.AreEqual<int>(Old_arrListCount, New_arrListCount); //This line of code is to check that the number of elements in the list remains unchanged

	        // if the list not contains x, then the indexof(X) will be -1
	        // If the list contains x and has more than one duplicate x, the IndexOf(X) will return the first occurance of X

            if (!Old_arrListContainsX)
            {
                Assert.AreEqual<int>(-1, New_Ret);
            }
            else
            {
                if (Old_arrListLastIndexOfX != -1 && Old_arrListCount <= 1)
                {
                    Assert.AreEqual<int>(Old_arrListLastIndexOfX, New_Ret);
                }
                else
                {
                    Assert.IsTrue(New_Ret >= 0 && New_Ret < arrList.Count);
                }
            }
        }
    }
}
```
- N'â Assert that the list count remains unchanged: `Assert.AreEqual<int>(Old_arrListCount, New_arrListCount);`
- N'â Assertions that if the list doesn't contain x, IndexOf(X) returns -1: 
    ````
    if (!Old_arrListContainsX)
    {
        Assert.AreEqual<int>(-1, New_Ret);
    }
    ````
- N'â Assertions if the list contains x and has more than one duplicate x, the IndexOf(X) will return the first occurance of X:
    ````
    else
    {
        if (Old_arrListLastIndexOfX != -1 && Old_arrListCount <= 1)
        {
            Assert.AreEqual<int>(Old_arrListLastIndexOfX, New_Ret);
        }
        else
        {
            Assert.IsTrue(New_Ret >= 0 && New_Ret < arrList.Count);
        }
    }
    ````

---

Nguyên tắc cơ bản của một test contract:

1. State pre-condition: Là state trước khi test được thực thi.
   - ArrayList arrList = new ArrayList {10, 20, 30, 40 ,50}; // state pre-condition
   - int x = 20; // state pre-condition
   - ...

2. Phải thực hiện các hành động trên dữ liệu trước khi thực thi test.
   - int Old_arrListCount = arrList.Count;
   - int Old_x = x;
   - int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
   - bool Old_arrListContainsX = arrList.Contains(x);
  
   - ... Tên thao tác
   
   - int New_Ret = arrList.IndexOf(x);

3. Sau khi thực hiện các hành động, tạo lại state post-condition.
   - int New_arrListCount = arrList.Count;
   - int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
   - bool New_arrListContainsX = arrList.Contains(x);

4. Phải có ít nhất một assertion để kiểm tra điều kiện sau c�ng.

---
Reference:
- C# Testing Techniques Part 6: Code Contract Testing
  - https://docs.microsoft.com/en-us/dotnet/core/testing/unit-testing-code-contracts

- Automated Testing with Microsoft FxCop
  - https://docs.microsoft.com/en-us/visualstudio/test/getting-started-with-unit-testing?view=--------------------            Assert.AreEqual(Old_arrListLastIndexOfX, New_Ret);
            Assert.AreEqual(Old_arrListCount, New_arrListCount);

            if (Old_arrListContainsX)
                Assert.IsTrue(New_arrListContainsX);
            else
                Assert.AreEqual(New_arrListLastIndexOfX, -1);

            Assert.AreEqual(New_arrListCount, arrList.Count);
            Assert.AreEqual(Old_arrListContainsX, arrList.Contains(x));
	    }
    }
}
```

