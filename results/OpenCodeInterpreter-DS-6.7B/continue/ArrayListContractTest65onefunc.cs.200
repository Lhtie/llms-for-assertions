        [PexMethod, PexExploration, PexIgnoreException(typeof(ArgumentException)), TestCategory("IndexOf")]
        public void PUT_IndexOfContract_ArrListWithNonExistenceObject([Values(null, "")] string obj)
        {
            AssumePrecondition.IsFalse(string.IsNullOrEmpty(obj));

            ArrayList list = new ArrayList();
            list.Add(obj);

            int ret = list.IndexOf(obj);

            Assert.IsTrue(ret >= 0);
            Assert.AreEqual(0, ret);

            ret = list.IndexOf(obj, 1);

            Assert.IsTrue(ret < 0);
        }

        [PexMethod, PexActionUnderTest("System.Collections.ArrayList.Add"),PexIgnoreException(typeof(NotSupportedException)), TestCategory("IndexOf")]
        public void PUT_IndexOfContract_Add([Random(1, 10)] int times, [Random(1, 10)] int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= times);

            ArrayList list = new ArrayList();
            ArrayList tempList = new ArrayList();

            for (int i = 0; i < times; i++)
            {
                if (i == index)
                {
                    tempList.Add(i);
                }
                list.Add(i);
            }

            int ret = list.IndexOf(index);

            Assert.IsTrue(ret >= 0);
            Assert.AreEqual(index, (int)(list[ret]));

            tempList.Add(index);
            for (int i = 0; i < tempList.Count; i++)
            {
                ret = list.IndexOf((int)(tempList[i]));

                Assert.IsTrue(ret >= 0);
                Assert.AreEqual((int)(tempList[i]), (int)(list[ret]));
            }
        }
    }
}
