namespace Pex.Seq.Helpers
{
    using System;
    using System.Collections;
    using System.Collections.Generic;
    using System.Linq;
    using System.Text;

    public static class Helper
    {
        public static string RenderIndent(int indent)
        {
            return new string(' ', indent * 2);
        }

        public static string RenderIndent(int indent, string str)
        {
            return new string(' ', indent * 2) + str;
        }

        public static string ToCamelCase(this string s)
        {
            return char.ToLowerInvariant(s[0]) + s.Substring(1);
        }

        public static bool IsSimpleType(Type type)
        {
            return type.IsPrimitive || type == typeof(string) || type == typeof(decimal) ||
                   type.IsEnum || type.IsValueType || type.IsPrimitive || type == typeof(DateTime) || type == typeof(object);
        }

        public static bool IsComplexEnumerableType(Type type)
        {
            return (type.IsGenericType && type.GetGenericArguments().All(t => Helper.IsComplexType(t)));
        }

        public static bool IsPrimitiveOrString(Type type)
        {
            return type.IsPrimitive || type == typeof(string);
        }

        public static bool IsComplexType(Type type)
        {
            return type.IsClass && !type.IsPrimitive && type != typeof(string) && type.Namespace != "System";
        }

        public static string ToPascalCase(this string s)
        {
            return s[0].ToString().ToUpperInvariant() + s.Substring(1);
        }

        public static string RenderFullNameWithHandle(Type type)
        {
            // TODO: Handle nested classes with special cases.
            string fqdn = type.FullName;
            bool isNestedType = fqdn.Contains('+');
            if (isNestedType)
            {
                string[] parts = fqdn.Split(new[] { '+' }, StringSplitOptions.RemoveEmptyEntries);
                string nestedTypeSimpleName = parts[parts.Length - 1];
                return nestedTypeSimpleName;
            }
            else
            {
                return fqdn;
            }
        }

        public static IEnumerable<T> Flatten<T>(this IEnumerable<T> list)
        {
            foreach (var item in list)
            {
                yield return item;

                if (item is IEnumerable<T> sublist)
                {
                    foreach (var subitem in Flatten(sublist))
                    {
                        yield return subitem;
                    }
                }
            }
        }
    }
}

