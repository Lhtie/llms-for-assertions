    	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ x is in old array list 

    	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array list does not contain x 

        }
    }
}

//NUnit/ArrayList.Test/ContractTest-RemoveContract-Ranged.cs
﻿using System;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContractRanged()
        {
        // an input range (to be used later) 

        // an input array list to test, where all constraints are satisfied 

        // an input index i such that  @@@ i is within the range 

        // an input index j such that  @@@ j is within the range and @@@ j is greater than or equal to i 

        // an input object x such that  @@@ x is found in the array list and @@@ array list contains at least one occurrence of x 

        // an assumption that  @@@ the array list count is greater than one 

            // create an instance of TestObjects.TestArrayList and add the necessary elements to it 

            ArrayList arrList = new ArrayList();

            // add some elements 

            arrList.Add(1);

            arrList.Add(2);

            arrList.Add(3);


            // perform an action 

            arrList.RemoveRange(i, j);


            // an assertion that checks the Count property 

            arrList.Count.Should().Be(3);


            // an assertion that checks all elements that were not in the range 

            arrList[0].Should().Be(1);

            arrList[1].Should().Be(2);

            arrList[2].Should().Be(3);


            // an assertion that checks the Count property 

            arrList.Count.Should().Be(3);

        }
    }
}

//NUnit/ArrayList.Test/ContractTest.cs
﻿using System;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_RemoveContract()
        {
            // an input array list to test, where all constraints are satisfied 

            // an input index i such that  @@@ i is a valid index 

            // an input object x such that  @@@ x is found in the array list and @@@ array list contains at least one occurrence of x 

            // an assumption that  @@@ the array list count is greater than one 

            // create an instance of TestObjects.TestArrayList and add the necessary elements to it 

            ArrayList arrList = new ArrayList();

            // add some elements 

            arrList.Add(1);

            arrList.Add(2);

            arrList.Add(3);


            // perform an action 

            arrList.Remove(x);


            // an assertion that checks the Count property 

            arrList.Count.Should().Be(2);


            // an assertion that checks all elements that were not removed 

            arrList[0].Should().Be(1);

            arrList[1].Should().Be(3);


            // an assertion that checks the Count property 

            arrList.Count.Should().Be(2);

        }
    }
}

//NUnit/ArrayList.Test/ContractTest-RemoveContract-Specific.cs
﻿using System;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContractSpecific([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arr--------------------	    Debug.Assert(New_arrListCount <= Old_arrListCount);

	    // an assertion using ".*?\s*?\=\s*?\=\s*?\=\s*?\=" that @@@ if x not in old array list, then it is not in new array list, too
	    if (!Old_arrListContainsX)
	    {
		    Assert.IsFalse(New_arrListContainsX);
	    }

	    // an assertion using ".*?\s*?\>\s*?\=\s*?\=\s*?\=" that @@@ if x in old array list, then it is in new array list, too
	    if (Old_arrListContainsX)
	    {
		    Assert.IsTrue(New_arrListContainsX);
	    }

	    // an assertion using ".*?\s*?\<\s*?\<\s*?\=\s*?\=" that   @@@ index of x in old array list (if exist) is not greater than index of x in new array list
	    if (Old_arrListIndexOfX != -1)
	    {
		    Assert.IsTrue(Old_arrListIndexOfX == New_arrListIndexOfX || Old_arrListIndexOfX < New_arrListIndexOfX);
	    }

	    // an assertion using ".*?\s*?\>\s*?\>\s*?\=" that @@@ last index of x in old array list (if exist) is not greater than last index of x in new array list
	    if (Old_arrListLastIndexOfX != -1)
	    {
		    Assert.IsTrue(Old_arrListLastIndexOfX == New_arrListLastIndexOfX || Old_arrListLastIndexOfX < New_arrListLastIndexOfX);
	    }
        }
    }
}

The unit test checks the validity and consistency of List.Remove method.

We assume inputs x is a element of arrList. Before method is called, we record the count of arrList, the index of x in arrList, the last index of x in arrList, and whether arrList contains x; then the method is called. After the method is called, we record the new count of arrList, the index of x, the last index of x, and whether arrList contains x.

We use Debug.Assert to ensure the new count of arrList is at most as the old count. Then check the conditions described in Pex_PUT_RemoveContract: if x is not in the old list, then it is not in the new list, too; if x is in the old list, then it is in the new list, too; the index of x in the old list (if exists) is not greater than the index of x in the new list; the last index of x in the old list (if exists) is not greater than the last index of x in the new list.

Please change "ArrayList Contract Test" according to your test's name.
Remember to include using Microsoft.Pex.Framework; and using Microsoft.VisualStudio.TestTools.UnitTesting; in the test project.

Put the PexObserve.ValueForViewing around the values you want to check in the output window of the Visual Studio while your running test.
Ensure you have enough data to be tested. If not, consider using PexAssume.Precondition to assure enough data meets your needs.

This test may not be able to test whether the list is sorted after Remove(), because the Remove() method does not preserve the order of elements after .NET version 4.7.2. Prior to that, removing an element would just reduce the Count but leave the elements in their original order intact. From .NET 4.7.2, Remove() will firstly seek for the element in original order, and then if not found, it will do a reverse seeking.

The PexObserve.ValueForViewing part of the code allows you to view the values. If something does not behave as expected, you can see what those values are and may be able to see why the test is incorrect.

Note that Pex is a good tool for testing the part of the program that does not have the UI or external dependencies, not for testing UI element or external calls. 

Putting Pex attribute over methods will test all possible paths that methods has.
However, using Pex in this way will result in a huge number of test methods, which will significantly slow down your CI build or local build--------------------