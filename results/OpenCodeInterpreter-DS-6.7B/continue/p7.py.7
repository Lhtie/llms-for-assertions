def assert_sublist_not_in_order(big_list, little_list):
    assert len(big_list) >= len(little_list), 'big_list should be longer or the same length as little_list'
    sorted_list = sorted(big_list)
    for index, x in enumerate(little_list):
        assert sorted_list[index] == x, "Each element in the sublist should be in order in the big_list"
    return True

def test_assert_sub_list_not_in_order():
    big_list = [7,5,9,0,-3,8,4,2,6,1]
    little_list = [5,4,2]
    assert_sublist_not_in_order(big_list,little_list)
    big_list = [9,8]
    little_list = [8,9]
    assert_sublist_not_in_order(big_list,little_list) 
    big_list = [9,8]
    little_list = [8,9,2]
    try:
        assert_sublist_not_in_order(big_list,little_list) 
    except AssertionError as e:
        print(e)
        assert True
    return True

