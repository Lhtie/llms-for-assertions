def check_numpy_version():
    try:
        assert hasattr(np, '__version__') and np.__version__ > '2',\
        'NumPy version 2.0 or greater is required.'
        print('NumPy version:', np.__version__)
    except AssertionError as e:
        print(e) 
        return None
    return np

