    return matrix

#@title Function to subtract rows
def subtract_rows(matrix, row1_index, row2_index, scalar): 
    matrix[row1_index] = matrix[row1_index] - matrix[row2_index] * scalar
    return matrix
#@title Function to reduce matrix to reduced row echelon form
def rref(matrix):
    matrix = matrix.astype(float)
    n_rows, n_cols = matrix.shape
    col_index = 0
    row_index = 0
    while row_index < n_rows and col_index < n_cols:
        pivot_index = find_pivot(matrix, col_index) 
        if pivot_index == -1: 
            col_index += 1
            continue
        matrix = swap_rows(matrix, pivot_index, row_index)
        matrix = scale_row(matrix, row_index, 1/matrix[row_index, col_index])
        for i in range(n_rows): 
            if i == row_index: 
                continue
            matrix = subtract_rows(matrix, i, row_index, matrix[i, col_index])
        row_index += 1
        col_index += 1
    return matrix
