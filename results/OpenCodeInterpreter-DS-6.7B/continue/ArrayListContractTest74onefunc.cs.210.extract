	    Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);
----------------------------------------            // Assert.
            Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : New_arrListContainsX == Old_arrListContainsX);
--------------------------------------------------------------------------------            Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);
--------------------            // And @@@ If return value is -1, new array list's count is equal to old array list's count 
            // @@@ Also, old array list's contains x is true and new array list's contains x is false 
	    // For this assertion to pass, it is important that this is tested code.
	    // The code below should be tested manually or added to the [TestMethod] attribute for automatic testing. 

            Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : New_arrListCount == Old_arrListCount);
