        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, Array array, int index)
        {
            AssumePrecondition.IsTrue(
                 index >= 0 && 
                 index <= array.Length
              );

            int Old_arrListCount = arrList.Count;
            int old_index = index;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;
            // there is no new array count after copying to a smaller array or reallocate a bigger array
            int New_arrayCount = ((array.Length >= index + Old_arrListCount)? array.Length:index + Old_arrListCount);
            int New_arrayIndexOf_FirstElement = Array.IndexOf(array, arrList[0]);
            int New_arrayLastIndexOf_LastElement = Array.LastIndexOf(array, arrList[Old_arrListCount - 1]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_index", old_index);
            PexObserve.ValueForViewing("$new_arrayCount", New_arrayCount);
            PexObserve.ValueForViewing("$new_arrayIndexOf_FirstElement", New_arrayIndexOf_FirstElement);
            PexObserve.ValueForViewing("$new_arrayLastIndexOf_LastElement", New_arrayLastIndexOf_LastElement);

