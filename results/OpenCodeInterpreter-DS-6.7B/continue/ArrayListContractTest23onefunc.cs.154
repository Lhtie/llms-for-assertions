[3] Field-Specific Testing Practices in Industry, L.--------------------	    new ArrayList().Insert(x, index);
	    New_arrListIndexOfX <= Old_index;

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListLastIndexOfX is equal to Old_arrListLastIndexOfX
	    New_arrListLastIndexOfX == Old_arrListLastIndexOfX;

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListContainsX is true i.e., the list contains x.
	    New_arrListContainsX;

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListCount is equal to Old_arrListCount plus one.
	    New_arrListCount == Old_arrListCount + 1;
        }
