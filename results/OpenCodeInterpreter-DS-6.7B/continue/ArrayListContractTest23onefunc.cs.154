}

//source/ArrayList.Test/ArrayListContractTest/PUT_RemoveAtContract.cs
﻿// ReSharper disable InconsistentNaming
using PexLib;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_arrListItem = (int)arrList[index];
            bool Old_arrListContainsOldItem = arrList.Contains(Old_arrListItem);

            arrList.RemoveAt(index);
           
            int New_arrListCount = arrList.Count;
            bool New_arrListContainsOldItem = arrList.Contains(Old_arrListItem);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_item", Old_arrListItem);
            PexObserve.ValueForViewing("$old_arrList_Contains_item", Old_arrListContainsOldItem);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Contains_item", New_arrListContainsOldItem);

	    New_arrListCount == Old_arrListCount - 1;
	    arrList.RemoveAt(index);
        }
    }
}

//source/ArrayList.Test/ArrayListContractTest/PUT_RemoveContract.cs
﻿// ReSharper disable InconsistentNaming
using PexLib;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, object obj)
        {
            AssumePrecondition.IsTrue(arrList.Contains(obj));
            
            int Old_Count = arrList.Count;
            int Old_IndexOf = arrList.IndexOf(obj);
            bool Old_Contains = arrList.Contains(obj);
 
            arrList.Remove(obj);

            int New_Count = arrList.Count;
            int New_IndexOf = arrList.IndexOf(obj);
            bool New_Contains = arrList.Contains(obj);

            PexObserve.ValueForViewing("$old_Count", Old_Count);
            PexObserve.ValueForViewing("$old_IndexOf", Old_IndexOf);
            PexObserve.ValueForViewing("$old_Contains", Old_Contains);
            PexObserve.ValueForViewing("$new_Count", New_Count);
            PexObserve.ValueForViewing("$new_IndexOf", New_IndexOf);
            PexObserve.ValueForViewing("$new_Contains", New_Contains);
            
            New_Count == Old_Count - 1;
            New_IndexOf == -1;
            !New_Contains;
        }
    }
}

