def PUT_InsertContract():
    """
    This test method verifies that the insert method can insert an item at the given index in the array list.
    """
--------------------	    Assert.IsTrue(New_arrListIndexOfX <= Old_index, "The item has not been inserted in the right index.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListLastIndexOfX is equal to Old_arrListLastIndexOfX
	    Assert.IsTrue(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, "The item has not been inserted in the right index.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListContainsX is equal to Old_arrListContainsX
	    Assert.IsTrue(New_arrListContainsX == Old_arrListContainsX, "The item has not been inserted in the right index.");
