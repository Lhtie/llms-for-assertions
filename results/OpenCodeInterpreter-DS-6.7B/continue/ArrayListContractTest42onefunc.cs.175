using System;
using System.IO;
using StockApp.Helpers.Interfaces;
using Xamarin.Forms;

[assembly: Dependency(typeof(StockApp.Droid.Helpers.SettingsHelper))]

namespace StockApp.Droid.Helpers
{
    public class SettingsHelper : ISettingsHelper
    {
        public string GetDatabasePath()
        {
            string path = Environment.GetFolderPath(Environment.SpecialFolder.Personal);
            return Path.Combine(path, "stockapp.db3");
        }
    }
}

//src/StockApp/Models/Stock.cs
namespace StockApp.Models
{
    public class Stock
    {
        public string Symbol { get; set; }
        public string Name { get; set; }
    }
}

//src/StockApp/Data/StockDatabase.cs
using System.Collections.Generic;
using SQLite;
using Xamarin.Forms;
using System.Linq;
using StockApp.Models;

namespace StockApp.Data
{
    public class StockDatabase
    {
        private SQLiteConnection database;
        private static object locker = new object();

        public StockDatabase()
        {
            database = new SQLiteConnection(DependencyService.Get<StockApp.Helpers.Interfaces.ISettingsHelper>().GetDatabasePath(), false);
            database.CreateTable<Stock>();
        }

        public List<Stock> GetStocks()
        {
            lock (locker)
            {
                return (from s in database.Table<Stock>() select s).ToList();
            }
        }

        public Stock GetStock(string symbol)
        {
            lock (locker)
            {
                return database.Table<Stock>().FirstOrDefault(s => s.Symbol == symbol);
            }
        }

        public int SaveStock(Stock stock)
        {
            lock (locker)
            {
                if (stock.Symbol != null && GetStock(stock.Symbol) == null)
                {
                    return database.Insert(stock);
                }
                return 0;
            }
        }

        public int DeleteStock(Stock stock)
        {
            lock (locker)
            {
                return database.Delete<Stock>(stock.Symbol);
            }
        }
    }
}

//src/StockApp/StockDetailPage.xaml.cs
