using System.Diagnostics;
using Microsoft.Pex.Framework;

namespace System.Collections.Generic.Test
{
    public partial class SortedSetContractTest
    {
        [PexMethod(MaxExpectedExecutionsFromGenericTypeParameter = 30, MaxTestIterations = 30)]
        public void Exists_Remove(SortedSet<int> set, Stopwatch watch)
        {
            // Arrange
            int maxTestIterations = 20;
            if (watch != null)
            {
                maxTestIterations /= 2;
            }

            // Act
            for (int i = 0; i < maxTestIterations; i++)
            {
                // If the set is not empty, remove an element
                if (set.Count > 0)
                {
                    int item = set.FirstOrDefault(); // pick first element
                    set.Remove(item);
                }

                // If the set is not full, add an element
                if (set.Count < maxTestIterations)
                {
                    set.Add(i);
                }

                if (watch != null)
                {
                    watch.Start();

                    // Perform some operation (not related to the test)
                    bool exists = set.Contains(i);

                    watch.Stop();
                    // Pex will collect this observation
                    PexObserve.ValueForViewing("Contains() Latency (ms)", watch.ElapsedMilliseconds);
                }
            }
        }
    }
}// Copyright (c) Microsoft Corporation. All rights reserved.
// Licensed under the MIT License. See LICENSE in the project root for license information.

using System.Diagnostics;

namespace System.Collections.Generic.Test
{
    public partial class SortedSetTest
    {
        // [TestMethod]
        public void Add_Contains_Remove()
        {
            var set = new SortedSet<int>();

            // Adding
            set.Add(1);
            set.Add(2);
            set.Add(3);
            Debug.Assert(set.Count == 3);

            // Contains
            Debug.Assert(set.Contains(1));
            Debug.Assert(set.Contains(2));
            Debug.Assert(set.Contains(3));
            Debug.Assert(!set.Contains(4));

            // Removing
            set.Remove(1);
            Debug.Assert(!set.Contains(1));
            Debug.Assert(set.Contains(2));
            Debug.Assert(set.Contains(3));
            set.Remove(2);
            set.Remove(3);
            Debug.Assert(!set.Contains(2));
            Debug.Assert(!set.Contains(3));
            Debug.Assert(set.Count == 0);
        }
    }
}// Copyright (c) Microsoft Corporation. All rights reserved.
