}[MethodImpl(MethodImplOptions.NoInlining)]
public static void WriteToFile(string aMethod, string aMessage, TextWriter w)
{
    w.WriteLine(aMethod + "() : " + aMessage);
}

public void DoSomething()
{
    TextWriter w = new StreamWriter(File.Open("debug.txt", FileMode.Append));
    WriteToFile(methodBase.GetCurrentMethod().Name, "Calling DoSomething method", w);
    w.Close();
}

public void DoSomethingElse()
{
    TextWriter w = new StreamWriter(File.Open("debug.txt", FileMode.Append));
    WriteToFile(methodBase.GetCurrentMethod().Name, "Calling DoSomethingElse method", w);
    w.Close();
}

//... other methods ...

public class Foo
{
    public void Bar()
    {
        // write a log entry
        DoSomething();
        // do more stuff...
    }

    public void Baz()
    {
        // write a different log entry
        DoSomethingElse();
        // do more stuff...
    }
}

public static void Main(string[] args)
{
    Foo f = new Foo();
    f.Bar();
    f.Baz();
}

The above code will create a simple logging system. Each method calls WriteToFile to log what it is doing, and the log entries are written to a file named "debug.txt". The log entries include the name of the method that made the log call and a message describing what the method is doing.
A benefit of using GetCurrentMethod().Name is that you can use it to get the name of the method that called WriteToFile, which means you don't need to supply the method name as an argument each time you call WriteToFile. You simply call GetCurrentMethod().Name where the method name is required.
On the other hand, reflection is slower (because of the extra work) and not always required. If you know what your methods will be called as, then you can simply write method names as arguments. Of course, in many practical applications there is a trade-off between code readability and performance.
Sometimes, it is beneficial to have a logging library that does the reflection--------------------