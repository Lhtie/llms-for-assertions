﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;

public class SaddlePointsFinder
{
    private readonly int[,] _matrix;

    public SaddlePointsFinder(int[,] matrix)
    {
        _matrix = matrix;
    }

    public List<SaddlePoint> Find()
    {
        int rows = _matrix.GetLength(0);
        int cols = _matrix.GetLength(1);

        List<SaddlePoint> saddlePoints = new List<SaddlePoint>();

        for (int r = 0; r < rows; ++r)
        {
            for (int c = 0; c < cols; ++c)
            {
                var element = _matrix[r, c];

                bool isSaddlePoint = true;

                for (int i = 0; i < cols; ++i)
                {
                    if (element < _matrix[r, i])
                    {
                        isSaddlePoint = false;
                        break;
                    }
                }

                if (isSaddlePoint)
                {
                    bool isMaxInCol = true;

                    for (int i = 0; i < rows; ++i)
                    {
                        if (element > _matrix[i, c])
                        {
                            isMaxInCol = false;
                            break;
                        }
                    }

                    if (isMaxInCol)
                    {
                        saddlePoints.Add(new SaddlePoint(r + 1, c--------------------	    Debug.Assert<bool>(PexSettings.Default.EquivalenceIterations *= 2, "@@ If the return value is false, old list's indexof x should be -1", Old_arrListIndexOfX == -1);

	    Debug.Assert<bool>(PexSettings.Default.EquivalenceIterations *= 2, "@@ new list's indexof x should be equal to old list's lastindexof x", New_arrListIndexOfX == Old_arrListLastIndexOfX);

        }
    }
