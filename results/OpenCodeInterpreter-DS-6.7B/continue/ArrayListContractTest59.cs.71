﻿using System;
using System.Diagnostics.Contracts;
using System.Text;
using ArrayList;
using System.Collections.Generic;

namespace ArrayListTest
{
    public class ArrayListTest
    {
        private ArrayList<int> data;

        public void Run()
        {
            Init();
            TestAdd();
            TestRemove();
            TestInsert();
            TestSet();
            TestGet();
            TestContains();
            data.Clear();
        }

        private void Init()
        {
            data = new ArrayList<int>();
            Contract.Assert(data.Count == 0, "ArrayList should be empty upon creation but got " + data.Count + " element(s)");
        }

        private void TestAdd()
        {
            RunAdd(5);
            data.Clear();
        }

        private void RunAdd(int n)
        {
            data.Add(42); // Just to have an element in the list initially
            Contract.Assert(data.Count == 1, "ArrayList should have exactly 1 element but got " + data.Count);
            var l = new List<int>();
            for (int i = 0; i < n; i++)
            {
                l.Add(i);
                data.Add(i);
                Contract.Assert(data.Count == l.Count, "ArrayList count does not match the actual number of elements in the list");
            }
        }

        private void TestRemove()
        {
            RunRemove(5);
            data.Clear();
        }

        private void RunRemove(int n)
        {
            var l = new List<int>();
            for (int i = 0; i < n; i++)
            {
                l.Add(i);
                data.Add(i);
            }
            int itemRemoved = l[3];
            Contract.Assert(data.Remove(itemRemoved), "Failed to remove the item, it should have returned true");
            l.RemoveAt(l.Count - 1);
            Contract.Assert(data.Count == l.Count, "ArrayList count does not match the actual number of elements in the list");
        }

        private void TestInsert()
        {
            RunInsert(5);
            data.Clear();
        }

        private void RunInsert(int n)
        {
            var l = new List<int>();
            for (int i = 0; i < n*2; i++)
            {
                l.Insert(2, i);
                data.Insert(2, i);
                Contract.Assert(data.Count == l.Count, "ArrayList count does not match the actual number of elements in the list");
            }
        }

        private void TestSet()
        {
            RunSet(5);
            data.Clear();
        }

        private void RunSet(int n)
        {
            var l = new List<int>();
            for (int i = 0; i < n; i++)
            {
                l.Add(i);
                data.Add(i);
            }
            int index = l.Count - 3;
            int oldValue = l[index];
            l[index] = n + 666;
            data[index] = n + 666;
            Contract.Assert(data[index] == l[index], "Setting new value does not change value at specific index, data: " + data[index] + " list: " + l[index]);
        }

        private void TestGet()
        {
            RunGet(5);
            data.--------------------	    Assert.IsTrue( New_Ret ? Old_arrListCount != -1 : Old_arrListCount == -1 );
	
            // an assertion that NewList_index_of_x != -1 implies NewList contains x
            Assert.IsTrue(New_arrListIndexOfX != -1 ? New_arrListContainsX : !New_arrListContainsX);
        }
    }
}
