class AbstractView(abc.ABC):
    @abc.abstractmethod
    def render(self):
        pass


class Button(AbstractView):
    def __init__(self, command):
        self.__command = command

    def on_click(self, callback):
        self.__callback = callback

    @staticmethod
    def validate_event(event):
        pass

    def click(self, event):
        success = self.validate_event(event)
        if success and self.__callback:
            self.__callback(self.__command)

    def render(self):
        return '<button>Click</button>'


class InputBox(AbstractView):
    def __init__(self, validator=None):
        self.validator = validator

    def validate(self, value):
        return self.validator(value) if self.validator else True

    def render(self):
        return '<input type="text" />'


class Form:
    def __init__(self, views):
        self.views = views

    def render(self):
        return ''.join([view.render() for view in self.views])

    def add_view(self, view):
        self.views.append(view)


