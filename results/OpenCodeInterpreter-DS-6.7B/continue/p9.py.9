def pairWiseSwap(head): 
    if head is None or head.next is None: 
        return head  

    prev = None
    curr = head  
    next = None
    newHead = None

    while(curr is not None and curr.next is not None):  
        next = curr.next.next
        if newHead is None: 
            newHead = curr.next

        curr.next.next = curr
        if prev is not None: 
            prev.next = curr.next

        prev = curr
        curr = next  

    if curr is not None: 
        prev.next = curr  
      
    return newHead  

def printList(head):  
    curr = head  
    while(curr): 
        print(curr.data, end = ' ')
        curr = curr.next
    print()

