class UnionFind:
    def __init__(self, N):
        self.id = list(range(N))
        self.sz = [1]*N

    def root(self, i):
        while i != self.id[i]:
            self.id[i] = self.id[self.id[i]]  # path compression
            i = self.id[i]
        return i

    def connected(self, p, q):
        return self.root(p) == self.root(q)

