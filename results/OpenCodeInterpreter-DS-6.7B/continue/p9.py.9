    def insert(self,data):
        if not self.head:
            self.head=Node(data)
        else:
            temp=self.head
            while(temp.next):
                temp=temp.next
            temp.next=Node(data)

    def delete(self,data):
      if self.head is None:
          return
      
      if self.head.data==data:
          self.head=self.head.next
          return
      
      temp=self.head
      while(temp.next):
          if temp.next.data==data:
              temp.next=temp.next.next
              return
          temp=temp.next

    def search(self,data):
      temp=self.head
      while(temp):
          if temp.data==data:
              return True
          temp=temp.next
      return False

