import random

def is_prime(n):
    """
    If n is a prime number, return True.
    If n is divisible by any number up to the square root of n, return False.
    """
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    max_divisor = int(n**0.5) + 1
    for i in range(3, max_divisor, 2):
        if n % i == 0:
            return False
    return True

def get_next_prime(n):
    """
    Return the next prime number after n.
    """
    while True:
        n += 1
        if is_prime(n):
            return n

primes = [2,3,5,7,11,13]

def get_next_prime_efficient(primes):
    """
    Efficiently get the next prime number by using the last stored prime.
    """
    last_prime = primes[-1]
    candidate = last_prime + 1
    while True:
        if is_prime(candidate):
            return candidate
        candidate += 1

