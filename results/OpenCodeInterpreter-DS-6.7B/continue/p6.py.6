import asyncio
from .mongo_database import connect
from .utils import Utils
from motor.motor_asyncio import AsyncIOMotorClient
from bson.json_util import loads, dumps
import json

class Process:
    def __init__(self, queue):
        self.queue = queue
        self.db = None

    async def connect_db(self):
        self.db = await connect()

    async def process_stock_data(self, stock):
        print(f"Processing stock {stock}")
        raw_data = await self.queue.get()

        # convert the data from string to dictionary
        data = json.loads(raw_data)
        data_to_save = []

        # for each stock, we have date and price data, we process both into db compatible form
        for date, price in data.items():
            formatted_date = Utils.format_timestamp_for_db(datetime.datetime.strptime(date, "%Y-%m-%d"))
            data_to_save.append({'_id': formatted_date, 'stock': stock, 'price': price})

        # save the data to mongodb
        await self.db['stockData'].insert_many(data_to_save)
        
        # Calculate the standard deviation
        std_dev = Utils.standard_deviation(data.values())
        await self.db['stockStats'].update_one({'_id': stock}, {"$set": {"stdDev": std_dev}}, upsert=True)

