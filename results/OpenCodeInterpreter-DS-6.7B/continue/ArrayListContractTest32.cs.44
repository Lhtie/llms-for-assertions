//Tests/ArrayListTest.cs
﻿using System;
using NUnit.Framework;
using ArrayList;

namespace Tests
{
    [TestFixture]
    public class ArrayListTest
    {
        // Arrange
        private ArrayList<int> list;

        [SetUp]
        public void SetUp()
        {
            list = new ArrayList<int>();
        }

        [Test]
        public void Count_ReturnsZero_WhenListIsEmpty()
        {
            // Act
            int count = list.Count();

            // Assert
            Assert.AreEqual(0, count);
        }

        [Test]
        public void Count_ReturnsCorrectCount_WhenElementsAreAdded()
        {
            // Act
            list.Add(1);
            list.Add(2);
            list.Add(3);
            int count = list.Count();

            // Assert
            Assert.AreEqual(3, count);
        }

        [Test]
        public void Indexer_ReturnsCorrectElement_WhenIndexIsValid()
        {
            // Act
            list.Add(1);
            list.Add(2);
            list.Add(3);
            int element = list[1];

            // Assert
            Assert.AreEqual(2, element);
        }

        [Test]
        public void Indexer_ThrowsException_WhenIndexIsInvalid()
        {
            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => list[0]);
        }

        [Test]
        public void Add_IncreasesCount_WhenElementIsAdded()
        {
            // Act
            list.Add(1);
            int countBefore = list.Count();
            list.Add(2);
            int countAfter = list.Count();

            // Assert
            Assert.AreEqual(countBefore + 1, countAfter);
        }
    }
}

