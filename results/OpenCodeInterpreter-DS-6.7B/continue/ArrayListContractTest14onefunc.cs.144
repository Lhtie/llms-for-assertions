            //@@@ array list contains x is true in old array list but is false in new array list
 // or @@@ array list contains x is false in old array list but is true in new array list

        }
    }
}

//TPE/ArrayList.Test/ArrayListContractTest.cs
﻿using System;
using System.Text;
using System.Collections.Generic;
using System.Security;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void SETUP_GET_element()
        {
	    // TODO: Instance State
	    // Instance State
	    this.arrList = new ArrayList(5);
	    this.x = 0;

	    // Set the initial state of instance variables
	    this.arrList.Add(this.x);
	    AssumePrecondition.IsFalse(this.arrList.Count.Equals(0));
	    AssumePrecondition.IsTrue(this.arrList.Contains(this.x));

	    // Avoid the false positive bug with object equality and the Assert.AreNotEqual() method
	    AssumePrecondition.IsFalse(object.Equals(this.x, null));

	    // Initialize the state of any shared precondition variables
	}
    }
}

//TPE/ArrayList.Test/ArrayListTest.cs
﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListTest
    {
        private ArrayList array;

        [TestInitialize]
        public void Initialize()
        {
            this.array = new ArrayList();
        }

        [TestMethod]
        public void TestArrayConstructor()
        {
            int initialCapacity = 20;
            ArrayList array = new ArrayList(initialCapacity);

            Assert.AreEqual(array.Count, 0);
            Assert.AreEqual(array.Capacity, initialCapacity);
        }

        [TestMethod]
        public void TestArrayListAdd()
        {
            string value = "hello";
            array.Add(value);

            Assert.AreEqual(array.Count, 1);
            Assert.AreEqual(array[0], value);
        }

        [TestMethod]
        public void TestArrayListInsert()
        {
            for (int i = 0; i < 10; i++)
            {
                array.Add(i);
            }

            int index = 5;
            string value = "hello";
            array.Insert(index, value);

            Assert.AreEqual(array.Count, 11);
            Assert.AreEqual(array[index], value);
        }

        [TestMethod]
        [ExpectedException(typeof(ArgumentException))]
        public void TestArrayListInsertOutOfRange()
        {
            array.Insert(1, "hello");
        }

        [TestMethod]
        public void TestArrayListRemove()
        {
            for (int i = 0; i < 10; i++)
            {
                array.Add(i);
            }

            int value = 5;
            array.Remove(value);

            Assert.AreEqual(array.Count, 9);
            Assert.IsTrue(!array.Contains(value));
        }

        [TestMethod]
        public void TestArrayListContains()
        {
            string value = "hello";
            array.Add(value);

            Assert.IsTrue(array.Contains(value));
            Assert.IsTrue(!array.Contains("goodbye"));
        }

        [TestMethod]
        public void TestArrayListClear()
        {
            for (int i = 0; i < 10; i++)
            {
                array.Add(i);
            }

            array.Clear();

            Assert.AreEqual(array.Count, 0);
            Assert.AreEqual(array.Capacity, 10);
        }

        [TestMethod]
        public void TestArrayListIndexOf()
        {
