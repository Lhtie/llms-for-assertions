using SwipeProject.Entities;

namespace SwipeProject.Repositories
{
    public interface IUserRepository
    {
        Task<User> Get(string userId, string password);

        Task<User> CreateUser(User user);
    }

    public class UserRepository : Repository<User>, IUserRepository
    {
        public UserRepository(IDataContext context) : base(context)
        {
        }

        public async Task<User> Get(string userId, string password)
        {
            return await Entities.FirstOrDefaultAsync(user => user.UserId == userId && user.Password == password);
        }

        public async Task<User> CreateUser(User user)
        {
            Entities.Add(user);
            await Context.SaveChangesAsync();
            return user;
        }
    }
}using SwipeProject.Entities;

namespace SwipeProject.Repositories
{
    public interface IRepository<T> where T : EntityBase
    {
        IQueryable<T> GetAll();
    }

    public class Repository<T> : IRepository<T> where T : EntityBase
    {
        protected readonly IDataContext Context;

        public Repository(IDataContext context)
        {
            Context = context;
        }

        protected DbSet<T> Entities => Context.Set<T>();

        public IQueryable<T> GetAll()
        {
            return Entities;
        }
    }
