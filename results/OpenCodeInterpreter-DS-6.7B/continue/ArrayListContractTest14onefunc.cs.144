using SwipeProject.Entities;
using SwipeProject.Helpers;
using SwipeProject.Repositories;

namespace SwipeProject.Services
{
    public interface IAuthService
    {
        Task<User> Authenticate(string userId, string password);
        Task<User> Register(User user, string password);
    }

    public class AuthService : IAuthService
    {
        private IUserRepository _userRepository;

        public AuthService(IUserRepository userRepository)
        {
            _userRepository = userRepository;
        }

        public async Task<User> Authenticate(string userId, string password)
        {
            if (string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(password))
                return null;

            var user = await _userRepository.Get(userId, password);

            return user;
        }

        public async Task<User> Register(User user, string password)
        {
            if (string.IsNullOrWhiteSpace(password))
            {
                throw new AppException("Password is required");
            }

            if (await _userRepository.Get(user.UserId, password) != null)
            {
                throw new AppException("UserId \"" + user.UserId + "\" is already taken");
            }

            user.Password = password;
            return await _userRepository.CreateUser(user);
        }
    }
}

