## Rust

```rust
#[derive(Clone, Copy, Debug)]
struct Rectangle {
    width: f64,
    height: f64,
}

impl Rectangle {
    fn new(width: f64, height: f64) -> Self {
        Rectangle { width, height }
    }

    fn area(&self) -> f64 {
        self.width * self.height
    }

    fn perimeter(&self) -> f64 {
        2.0 * (self.width + self.height)
    }
}

#[derive(Clone, Copy, Debug)]
struct Circle {
    radius: f64,
}

impl Circle {
    fn new(radius: f64) -> Self {
        Circle { radius }
    }

    fn area(&self) -> f64 {
        std::f64::consts::PI * (self.radius * self.radius)
    }

    fn circumference(&self) -> f64 {
        2.0 * std::f64::consts::PI * self.radius
    }
}

fn main() {
    let rectangles: [Rectangle; 2] = [
        Rectangle::new(1.0, 2.0),
        Rectangle::new(3.0, 4.0),
    ];

    let circles: [Circle; 2] = [
        Circle::new(1.0),
        Circle::new(2.0),
    ];

    let max_rectangle_area = rectangles
        .iter()
        .max_by_key(|r| r.area())
        .unwrap();

    assert_eq_diff_f64(max_rectangle_area.area(), 30.0, 1.0e-14);

    let max_circle_circumference = circles
        .iter()
        .max_by_key(|c| c.circumference())
        .unwrap();

    assert_eq_diff_f64(max_circle_circumference.circumference(), 12.566370614359171, 1.0e-14);
}

fn assert_eq_diff_f64(got: f64, want: f64, eps: f64) {
    assert_eq_diff::check_close_f64(got, want, eps);
}
