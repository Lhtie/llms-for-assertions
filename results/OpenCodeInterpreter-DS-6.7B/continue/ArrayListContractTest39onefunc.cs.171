            // more verification using PexAssume

            // PexInvariant assertions can also be used to provide further proof of the correctness of the system under test 
            // which wouldn't be captured by F#'s type system.

            PexAssert.AreEqual(Old_arrListCount, New_arrListCount);
            PexAssert.AreNotEqual(Old_x, x);
            PexAssert.AreEqual(Old_index, index);
            PexAssert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            PexAssert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            PexAssert.IsTrue(New_arrListContainsX);
        }
