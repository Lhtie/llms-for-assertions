namespace Dfgi
{
  public static class DfgiWinForms
  {
    internal static MessageBoxButtons? button = null;

    public static bool ConfirmMessage(string message)
    {
      button = MessageBoxButtons.YesNo;
      DialogResult ret = MessageBox.Show(message, Application.ProductName, button.Value);
      return ret == DialogResult.Yes;
    }

    public static void InformMessage(string message)
    {
      button = MessageBoxButtons.OK;
      MessageBox.Show(message, Application.ProductName, button.Value);
    }

    public static void ErrorMessage(string message)
    {
      button = MessageBoxButtons.OK;
      MessageBox.Show(message, Application.ProductName, button.Value, MessageBoxIcon.Error);
    }
  }
}

