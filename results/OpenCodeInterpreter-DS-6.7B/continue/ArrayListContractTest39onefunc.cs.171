}﻿using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

public class GameManager : MonoBehaviour
{
    [Header("遊戲分數")]
    public int score;
    [Header("分數介面")]
    public Text Scoretext;
    [Header("最高分數")]
    public Text HighScore;
    [Header("遊戲時間")]
    public float time = 60;
    [Header("時間介面")]
    public Text timetext;
    [Header("遊戲開始介面")]
    public GameObject StartUI;
    [Header("遊戲結束介面")]
    public GameObject EndUI;
    [Header("玩家")]
    public GameObject player;

    public static GameManager instance;

    private void Awake()
    {
        instance = this;
    }

    private void Start()
    {
        score = 0;
        timetext.text = "時間：" + time;
        HighScore.text = "最高分數：" + PlayerPrefs.GetInt("HighScore", 0);
        Time.timeScale = 0;
    }

    private void Update()
    {
        if (time > 0)
        {
            time -= Time.deltaTime;
            timetext.text = "時間：" + Mathf.Round(time);
        }
        else
        {
            Time.timeScale = 0;
            EndUI.SetActive(true);
            Scoretext.text = "分數：" + score;

            if (score > PlayerPrefs.GetInt("HighScore", 0))
            {
                PlayerPrefs.SetInt("HighScore", score);
                HighScore.text = "最高分數：" + score;
            }
        }
    }

    public void GameStart()
    {
        Time.timeScale = 1;
        StartUI.SetActive(false);
        player.SetActive(true);
    }

    public void GameEnd()
    {
        SceneManager.LoadScene("遊戲場景");
    }
}﻿using UnityEngine;
using UnityEngine.UI;

public class Player : MonoBehaviour
{
    private Rigidbody rb;
    private bool isJumping;
    [Header("跳躍力")]
    public float jumpForce;
    [Header("分數介面")]
    public Text scoreText;

    private void Start()
    {
        rb = GetComponent<Rigidbody>();
        isJumping = false;
    }

    private void Update()
    {
        if (isJumping)
        {
            rb.AddForce(0, jumpForce, 0, ForceMode.Impulse);
            isJumping = false;
        }
        scoreText.text = "分數:" + GameManager.instance.score;
    }

    public void Jump()
    {
        if (!isJumping)
        {
            isJumping = true;
        }
    }

    private void OnCollisionEnter(Collision collision)
    {
        if (collision.gameObject.tag == "地板")
        {
            isJumping = false;
        }

        if (collision.gameObject.tag == "得分")
        {
            GameManager.instance.score++;
            Destroy(collision.gameObject);
        }
    }
