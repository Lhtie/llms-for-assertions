}

#endif

The problem is that I cannot simply add an assertion right after the assignment in order to check the properties of the new ArrayList due to the PexAssumeUnderTest attribute - the attribute causes the method to be run only with some random inputs where the index is invalid.
I can't simply add Assert.That() after the assignment because the index could be out of range for the current state of the ArrayList (it could be equal to Count), and ArrayList invariants might be different when the index is out of bounds.
How could I add such an assertion?

A: It sounds like you're encountering an issue where verification of the post-condition depends on an assumed input's validity. Since PexAssumeUnderTest may not generate inputs that break the invariants, it's hard to check properties such as LastIndexOf(), IndexOf(), and Contains() in such scenarios.
One possible solution might be to add a custom check after the assignment that specifically checks the properties you want, and only if the index is valid. This way, the properties are only checked in the assumptions where the index is within the valid range. Here's a sketch of how that might look like:

```csharp
if (index >= 0 && index < arrList.Count) {
    // Property checks that depend on a valid index in the array.
    Assert.AreEqual(Old_arrListIndexOfX, arrList.IndexOf(x));
    Assert.AreEqual(Old_arrListLastIndexOfX, arrList.LastIndexOf(x));
    Assert.IsTrue(arrList.Contains(x));
}
```

This is just a sketch and it might need some slight alterations depending on your exact use case, but it should provide you a direction to solve this issue. Basically, it tests the properties only if the underlying index assumptions hold. It keeps from false positives where the assumption doesn't hold but the properties still hold (it's unlikely but could possibly happen). 

Do let me know if you need help in anything else.



#endif



#if PEX_ENTERPRISE

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod(MaxRuns = 100)]
        [PexCustomAttribute(nameof(ArrayListTest), "SetCustomContract")]
        public void PUT_SetContract([PexAssumeValid]ArrayList arrList, int x, int index)
        {
            Assume.That(index >= 0 && index <= arrList.Count);
            
            int Old_arrListCount = arrList.Count;
            arrList[index] = x;
            int New_arrListCount = arrList.Count;
            
            if (index >= 0 && index <= arrList.Count)
            {
                int Old_arrListIndexOfX = arrList.IndexOf(x);
                int New_arrListIndexOfX = arrList.IndexOf(x);
                int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
                int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
                bool Old_arrListContainsX = arrList.Contains(x);
                bool New_arrListContainsX = arrList.Contains(x);

                Assert.AreEqual(Old_arrListCount, New_arrListCount);
                Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX && New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
                Assert.IsTrue(New_arrListContainsX && Old_arrListContainsX);
            }
        }
    }

    public class ArrayListTest
    {
        public static void SetCustomContract(ArrayList arrList, int x, int index)
        {
            Assume.That(index >= 0 && index <= arrList.Count);
        }
    }
}

#endif



