        {
            Assume.That(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            arrList[index] = x; 
            int New_arrListCount =--------------------            PexAssert.AreEqual(arrList.LastIndexOf(Old_x) <= arrList.LastIndexOf(New_x), true);

            int New_x = arrList[index];
            PexAssert.AreEqual(Old_x, New_x);
        }
