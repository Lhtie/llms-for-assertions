using namespace std;

#ifndef AI
#define AI 0
#endif

#define MAX_N 100
#define MAX_M 100
#define MAX_KI 100
#define MAX_HI 100
#define MAX_LI 100

// Function to check if the player can win the game
bool canWin(int n, int m, int k, int h, int l, vector<vector<int>>& dp) {
    // Check if the player is already in a winning position
    if (dp[n][m] != -1)
        return dp[n][m];

    // Check if the current configuration is winning
    if (n <= k && m <= h && n <= l) {
        dp[n][m] = 1;
        return true;
    }

    // Check all possible moves and see if any of them result in a winning position
    if (canWin(n - k, m, k, h, l, dp) || canWin(n, m - h, k, h, l, dp) || (n - l >= 0 && canWin(n - l, m, k, h, l, dp))) {
        dp[n][m] = 1;
        return true;
    }

    dp[n][m] = 0;
    return false;
}

int main() {
    int t;
    scanf("%d", &t);

    for (int tt = 1; tt <= t; tt++) {
        int n, m, k, h, l;
        scanf("%d %d %d %d %d", &n, &m, &k, &h, &l);

        vector<vector<int>> dp(MAX_N + 1, vector<int>(MAX_M + 1, -1));
        bool win = canWin(n, m, k, h, l, dp);

