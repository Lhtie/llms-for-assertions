using System;
using System.Diagnostics;
using System.Collections;
using System.Collections.Generic;
using Microsoft.Quantum.Testing;
using Xunit;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_SortContract([PexAssumeUnderTest] ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            arrList.Sort();

            // an assertion using "Debug.Assert\(.*?\);" that @@@ Sorted list should be in ascending order.
            for (int i=0; i<arrList.Count-1; i++)
            {
	        Assert.True((int) arrList[i] <= (int) arrList[i+1]);
            }
        }
    }
}

