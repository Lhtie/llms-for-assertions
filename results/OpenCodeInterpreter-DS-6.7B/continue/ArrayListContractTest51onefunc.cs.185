using UnityEngine;
using UnityEditor;
using System;
using System.Collections.Generic;

[CustomPropertyDrawer(typeof(FoldoutGroupAttribute))]
public class FoldoutGroupDrawer : PropertyDrawer
{
    public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
    {
        FoldoutGroupAttribute foldoutGroup = (FoldoutGroupAttribute)attribute;

        EditorGUI.BeginProperty(position, label, property);

        float totalHeight = 0;
        foreach (var prop in GetProperties(property))
        {
            EditorGUI.BeginChangeCheck();
            if (foldoutGroup.Foldout)
            {
                EditorGUI.indentLevel = 1;
                EditorGUI.PropertyField(new Rect(position.x, position.y + totalHeight, position.width, EditorGUIUtility.singleLineHeight), prop, true);
            }
            else
            {
                position.height = EditorGUIUtility.singleLineHeight;
                EditorGUI.PropertyField(position, prop, true);
            }

            if (EditorGUI.EndChangeCheck())
                property.serializedObject.ApplyModifiedProperties();

            totalHeight += EditorGUI.GetPropertyHeight(prop, true);
        }

        EditorGUI.EndProperty();
    }

    public override float GetPropertyHeight(SerializedProperty property, GUIContent label)
    {
        FoldoutGroupAttribute foldoutGroup = (FoldoutGroupAttribute)attribute;
        if (foldoutGroup.Foldout)
            return GetPropertyHeightInFoldout(property);
        else
            return GetPropertyHeightAsSingleLine(property);
    }

    private List<SerializedProperty> GetProperties(SerializedProperty property)
    {
        List<SerializedProperty> list = new List<SerializedProperty>();
        SerializedProperty prop = property.Copy();
        bool hasChildren = prop.NextVisible(true);
        while (hasChildren)
        {

            list.Add(prop);
            hasChildren = prop.NextVisible(false);
        }

        return list;
    }

    private float GetPropertyHeightInFoldout(SerializedProperty property)
    {
        float totalHeight = 0;
        float singleLineHeight = EditorGUIUtility.singleLineHeight;
        foreach (var prop in GetProperties(property))
            totalHeight += EditorGUI.GetPropertyHeight(prop, true);

        return singleLineHeight + totalHeight;
    }

    private float GetPropertyHeightAsSingleLine(SerializedProperty property)
    {
        float totalHeight = 0;
        foreach (var prop in GetProperties(property))
            totalHeight += EditorGUI.GetPropertyHeight(prop, true);

        return totalHeight;
    }
}

