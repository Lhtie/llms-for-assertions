namespace NUnit.Framework
{
    using System;

    public static class Asserts
    {
        public static void AreEqual<T>(T expected, T actual, string message)
        {
            Assert.AreEqual(expected, actual, message);
        }

        public static void AreEqual<T>(T expected, T actual)
        {
            Assert.AreEqual(expected, actual);
        }

        public static void IsNull(object actual, string message)
        {
            Assert.IsNull(actual, message);
        }

        public static void IsNotNull(object actual, string message)
        {
            Assert.IsNotNull(actual, message);
        }

        public static void IsTrue(bool condition, string message)
        {
            Assert.IsTrue(condition, message);
        }

        public static void IsFalse(bool condition, string message)
        {
            Assert.IsFalse(condition, message);
        }

        public static void IsInstanceOfType(Type expectedType, object actual, string message)
        {
            Assert.IsInstanceOfType(actual, expectedType, message);
        }
    }
}

