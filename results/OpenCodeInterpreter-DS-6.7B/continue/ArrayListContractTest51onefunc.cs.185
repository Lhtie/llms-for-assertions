namespace System.Collections
{
    using NUnit.Framework;
    using System;

    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void ArrayCopy_ValidateCorrectness()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.AddRange(new object[] { 1, 2, 3, 4, 5 });

            object[] array = new object[10];
            arrayList.CopyTo(array, 2);

            Asserts.AreEqual(1, array[2]);
            Asserts.AreEqual(2, array[3]);
            Asserts.AreEqual(3, array[4]);
            Asserts.AreEqual(4, array[5]);
            Asserts.AreEqual(5, array[6]);
        }

        [Test]
        public void Insert_ElementAtValidIndex()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.AddRange(new object[] { 1, 2 });
            arrayList.Insert(2, 3);
            Asserts.AreEqual(3, arrayList[2]);
        }

        [Test]
        public void Insert_ElementAtInvalidIndex()
        {
            ArrayList arrayList = new ArrayList();
            Assert.Throws<IndexOutOfRangeException>(() => arrayList.Insert(-1, 1));
        }

        [Test]
        public void Remove_RemovingExistingElement()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.AddRange(new object[] { 1, 2, 3 });
            arrayList.Remove(2);
            Asserts.IsFalse(arrayList.Contains(2));
        }

        [Test]
        public void RemoveAt_ValidIndex()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.AddRange(new object[] { 1, 2, 3 });
            arrayList.RemoveAt(1);
            Asserts.IsFalse(arrayList.Contains(2));
        }

        [Test]
        public void RemoveAt_InvalidIndex()
        {
            ArrayList arrayList = new ArrayList();
            Assert.Throws<IndexOutOfRangeException>(() => arrayList.RemoveAt(1));
        }

