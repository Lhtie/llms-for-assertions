```csharp
// ...

    private static Modifications ModifyList(ArrayList list, Modifications mods) {
        foreach (Modification mod in mods) {
            Assert.AreEqual(mod.ExpectedCount, list.Count);
            Assert.AreEqual(mod.ExpectedCapacity, list.Capacity);

            list.Add(mod.Value);
            Assert.AreEqual(mod.ExpectedCount + 1, list.Count);

            mods.Apply(list);
            Assert.AreEqual(mod.ExpectedCount, list.Count);

            Assert.IsTrue(mods.Check(list), "Verifying list modification did not result in the expected state.");
        }

        return mods;
    }
}
