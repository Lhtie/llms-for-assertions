            AssumePrecondition.IsTrue(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, "LastIndexOf");
            AssumePrecondition.IsTrue(New_arrListContainsX == Old_arrListContainsX, "Contains");
        }
    }
}

