[TestFixture]
public class ArrayListTest
{
    [Test]
    public void Construct_EmptyList_HasCountZero()
    {
        var list = new ArrayList();
        Assert.AreEqual(0, list.Count);
    }

    [Test]
    public void Add_Element_IncreasesCount()
    {
        var list = new ArrayList();
        list.Add(1);
        Assert.AreEqual(1, list.Count);
    }

    [Test]
    public void Remove_Element_DecreasesCount()
    {
        var list = new ArrayList();
        list.Add(1);
        list.Remove(1);
        Assert.AreEqual(0, list.Count);
    }

    [Test]
    public void Remove_NonExistingElement_DoesNotDecreaseCount()
    {
        var list = new ArrayList();
        list.Remove(1); // should not throw an exception
        Assert.AreEqual(0, list.Count);
    }

    [Test]
    public void IndexOf_Element_ReturnsCorrectIndex()
    {
        var list = new ArrayList();
        list.Add(1);
        list.Add(2);
        Assert.AreEqual(0, list.IndexOf(1));
        Assert.AreEqual(1, list.IndexOf(2));
    }

    [Test]
    public void IndexOf_NonExistingElement_ReturnsNegativeOne()
    {
        var list = new ArrayList();
        list.Add(1);
        Assert.AreEqual(-1, list.IndexOf(2));
    }
    
    // 其他测试...

}
```

在这几个测试用例中，我们根据 ArrayList 的方法和属性来验证它们是否正常工作。

### 总结

在本文中，我们对 ArrayList 做了简要的介绍。然后我们用 Visual Studio 编写了对该类的一些测试用例 - 使用了一种称为“测试套件”的方式来组织代码。我们的测试包括了对关键方法和属性的单元测试，如 `Add`，`Remove`，`IndexOf` 和 `Count`。还有一些针对边界条件和异常情况的测试。

由于 ArrayList 是内置类提供的，所以我们通常需要自行实现测试以对该类进行全面的测试。

此外，对于这个简单类的测试，使用 Microsoft 的 Pex 和 Moles 工具可能会很有益处。P--------------------            Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX, "@@@ new last index of x is lesser than or equal to old last index of x");

