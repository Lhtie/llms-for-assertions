﻿using System;
using System.Collections.Generic;
using System.Text;

namespace TechJobsConsole.classes
{
    class Job
    {
        public string Name { get; set; }
        public string Employer { get; set; }
        public string Location { get; set; }
        public string PositionType { get; set; }
        public string CoreCompetency { get; set; }

        public Job(string name, string employer, string location, string posType, string coreComp)
        {
            this.Name = name;
            this.Employer = employer;
            this.Location = location;
            this.PositionType = posType;
            this.CoreCompetency = coreComp;
        }

        // TODO: Add the two constructors here
        public Job()
        {

        }


        // TODO: Generate Equals() and GetHashCode() methods

        public override bool Equals(object obj)
        {
            return obj is Job job &&
                   Name == job.Name &&
                   Employer == job.Employer &&
                   Location == job.Location &&
                   PositionType == job.PositionType &&
                   CoreCompetency == job.CoreCompetency;
        }

        public override int GetHashCode()
        {
            return HashCode.Combine(Name, Employer, Location, PositionType, CoreCompetency);
        }

        // TODO: Override the ToString() method

        public override string ToString()
        {
            if (string.IsNullOrEmpty(this.Name) && string.IsNullOrEmpty(this.Employer) && string.IsNullOrEmpty(this.Location) && string.IsNullOrEmpty(this.PositionType) && string.IsNullOrEmpty(this.CoreCompetency))
            {
                return "Data not available";
            }

            return $"ID: {this.Name} | Employer: {this.Employer} | Location: {this.Location} | Position Type: {this.PositionType} | Core Competency: {this.CoreCompetency}";
        }
    }
}

