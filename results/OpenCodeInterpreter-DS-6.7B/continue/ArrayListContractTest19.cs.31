            Console.WriteLine(job2.ToString());
            Console.WriteLine(job3.ToString());

            if (job1.Equals(job2))
            {
                Console.WriteLine("job1 and job2 are equal!");
            }
            else
            {
                Console.WriteLine("job1 and job2 are not equal!");
            }
        }
    }
