//src/ALinq.Tests/ArrayList.Test/Contracts/ArrayListContracts/ArrayListContracts/ArrayListContractTest.cs
namespace ArrayList.Test
{
    using System;
    using System.Collections;
    using System.Text;
    using Microsoft.Pex.Framework;
    using Microsoft.Pex.Framework.Settings;
    using Microsoft.Pex.Framework.Exceptions;

    using NUnit.Framework;
    using ArrayList;
    using PexAPIWrapper;

    [TestFixture, PexClass(MaxRounds = 3)]
    public partial class ArrayListContractTest
    {

        public void CheckPreconditionArray(int[] testCase)
        {
            AssumePrecondition.IsNotEmpty(testCase);
        }

        public void CheckInvariantAdd(ArrayList aList, int newInt)
        {
            Invariant.Assert((aList.Count + 1) == (aList.Add(newInt)));
        }

        public void CheckInvariantRemove(ArrayList aList, int index)
        {
            Invariant.Assert((aList.Count - 1) == (aList.RemoveAt(index)));
        }

        public void CheckInvariantInsert(ArrayList aList, int index, int newInt)
        {
            Invariant.Assert((aList.Count + 1) == (aList.Insert(index, newInt)));
        }

        public void CheckInvariantSet(ArrayList aList, int index, int newInt)
        {
            aList[index] = newInt;
            Invariant.Assert((aList.Count) == (aList.Count));
        }

        public void CheckInvariantGet(ArrayList aList, int index)
        {
            Invariant.Assert(aList[index] == aList.Get(index));
        }

        public void CheckInvariantContains(ArrayList aList, int newInt)
        {
            Invariant.Assert(aList.Contains(newInt) == aList.Contains(newInt));
        }

        public void CheckInvariantCopyTo(ArrayList aList, int[] array, int arrayIndex)
        {
            aList.CopyTo(array, arrayIndex);
            Invariant.Assert(aList.Count == aList.Count);
        }

        public void CheckInvariantClear(ArrayList aList)
        {
            aList.Clear();
            Invariant.Assert(aList.Count == 0);
        }
    }
}

