            Debug.Assert(New_Ret == true && (New_arrListLastIndexOfX <= Old_arrListLastIndexOfX));

	    // an assertion using "Assert.*\(.*\);" that  @@@ The old list's contains x is equal to new list's contains x  
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);

	    // an assertion using "Assert.AreEqual\(.*\);" that  @@@ The new list's index of x is <= old list's index of x  
            Assert.IsTrue(New_arrListIndexOfX <= Old_arrListIndexOfX);

	    // an assertion using "Assert.AreEqual\(.*\);" that  @@@ The old list's last index of x is equal to new list's last index of x  
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, new list's index of x is < old list's index of x  
            Debug.Assert(New_Ret == false && (New_arrListIndexOfX < Old_arrListIndexOfX));

	    // an assertion using "Assert.*\(.*\);" that  @@@ The old list's count is equal to new list's count  
 	    Assert.AreEqual(Old_arrListCount, New_arrListCount);

        }
    } 
}

