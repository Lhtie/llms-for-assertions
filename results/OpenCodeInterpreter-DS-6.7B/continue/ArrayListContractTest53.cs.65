            // act
            arrayList.Add(elementToAdd);
            arrayList.Remove(elementToRemove);
            var actualCountAfterRemove = arrayList.Count;

            // assert
            Assert.AreEqual(expectedCountAfterRemove, actualCountAfterRemove);
        }

