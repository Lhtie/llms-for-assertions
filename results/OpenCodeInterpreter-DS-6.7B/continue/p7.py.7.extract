--------------------np.testing.assert_allclose(res_sine, sine_targets, atol=1e-5)
# an assertion for checking if the res_sine (result sine) is close enough to the sine_targets for a tolerance of 1e-5

# atol stands for absolute tolerance which is the maximum difference between the two arrays to still consider it a match.
# This is a simple, but powerful way of making sure your results are correct. If the result isn't close enough to the expected result even with a very small difference, the assertion will fail and throw an error.

# an assertion that checks if the lengths of the result and targets are the same
assert len(res_sine) == len(sine_targets)
