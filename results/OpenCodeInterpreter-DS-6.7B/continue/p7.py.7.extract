assert(100//10 == 10)
assert([3] < [4])
assert("abc" > "abb")
assert("abc" < "abc")
assert([1,2,3] < [1,2,4])
assert((1,2,3) < (1,2,4))
assert((1,2,3,) == (1,2,3))
assert(bytearray([1,2]) > bytearray([1,1]))

assert({'A':1, 'B':2}.get('A') == 1)
assert({'A':0}.pop('A', 'default') == [0, 'default'])
assert('a' in ['A', 'B'])
assert('b' not in ['A', 'B'])
assert([1,2].index(1) == 0)
assert(256<<1 == 512)
assert(0xf==15)
assert(0O10==8)

assert(np.__version__ > '1.2.0')

# an assertion using "assert .*?" that  numpy version is greater than 1.1
--------------------numpy_version = np.__version__
print("Numpy version : ",numpy_version)
assert int(numpy_version.split('.')[1]) > 1, "Numpy version not supported. Please update to the latest version."
--------------------assert np.__version__ > "1.1", "numpy version should be greater than 1.1"
--------------------# '1.1' can be replaced with the minimum required version
import re

import numpy as np

assert re.match(r".*?1\.1.*", np.__version__) is not None, "Requires numpy version 1.1 or higher"
--------------------assert np.__version__.split('.') > ('1', '1'), 'numpy version is greater than 1.1'
--------------------assert _.match('1.2.*') < _.version.releaselevel == _re.IGNORECASE
--------------------message = "numpy version assertion"
assert numpy.__version__ > 1.1, message
