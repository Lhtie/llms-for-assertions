using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        public void PUT_EnsureCapacity_NegativeIndexThrowArgumentException([PexAssumeUnderTest] ArrayList list, int capacity)
        {
            try
            {
                list.EnsureCapacity(capacity);
            }
            catch (ArgumentException ex)
            {
                Assert.Fail("Capacity should be equal to or greater than 0; actual is " + capacity);
            }
        }

        [Test]
        public void PUT_Add_NegativeIndexThrowArgumentException([PexAssumeUnderTest] ArrayList list, int index, object x)
        {
            try
            {
                list.Add(x);
            }
            catch (ArgumentException ex)
            {
                Assert.Fail("Index should be equal to or greater than 0; actual is " + index);
            }
        }

        [Test]
        public void PUT_Remove_Negative_Index_Throw_ArrayIndexOutOfRangeException([PexAssumeUnderTest] ArrayList list, int index)
        {
            try
            {
                list.RemoveAt(index);
            }
            catch (IndexOutOfRangeException ex)
            {
                Assert.Fail("Index should be in range; actual is " + index);
            }
        }
    }
}

