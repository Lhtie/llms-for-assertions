            Assert.IsTrue(New_arrListIndexOfX <= index);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ index of x in new array list is greater than or equal to position where it was set
            Assert.IsTrue(New_arrListLastIndexOfX >= index);
        }
    }
}
```

<a name="BKMK_TestMethodWithPexObserve"></a>

## <a name="test-method-with-pexobserve"></a>Méthode de test avec PexObserve

Il est possible d'utiliser `PexObserve` pour surveiller les modifications potentiellement non voulues d'un objet dans le test. `PexObserve` est une méthode de l'API de prise de devis exploratoire d'éléments de marque.

Prenons l'exemple de la méthode de test suivante, qui modifie des éléments d'une liste chaînée dans une classe ArrayList.

```
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >=0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList[index] = x;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_Contains_x", Old_arrListContainsX);

            // Further testing assertions...
        }
    }
}
```

Dans cette méthode de test, on fournit également des valeurs pour `PexObserve.ValueForViewing()` pour chaque valeur antérieure modifiée afin de faciliter la découverte des modifiant les valeurs non censées. Si un testeur a exécuté cette méthode de test et trouve une modification non attendue, il peut voir ces modifications de valeur dans les données de visualisation. Si aucune modification non attendue n'est observée, cela signifie probablement que le code d'origine fonctionne correctement.

Notez que `PexObserve.ValueForViewing()` surveille réellement les modifications apportées à un objet, même s'il n'y a aucun test d'assertion qui se termine incorrectement là-bas. Cependant, l'utilisation de `PexObserve.ValueForViewing()` est rare, parce qu'en moyenne, les modifications apportées à un objet ne sont pas observées par le test. Les modifications apportées ne devraient être observées que si elles ont un impact déterminé sur les résultats du test.

