using System;

namespace PlCore
{
    public class PLRef<T>
    {
        public T Value;

        public PLRef(T value)
        {
            Value = value;
        }

        public static implicit operator T(PLRef<T> refT)
        {
            if (refT == null)
                return default(T);
            return refT.Value;
        }

        public static implicit operator PLRef<T>(T value)
        {
            return new PLRef<T>(value);
        }
    }
