	    // using arrList.Count
	    PexObserve.Assert("@@@ old index is less than or same as old array count ", Old_index <= Old_arrListCount );

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array count is same as old array count 
	    // using arrList.Count
	    PexObserve.Assert("@@@ new array count is same as old array count ", New_arrListCount == Old_arrListCount );

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new contains new ret 
	    // using arrList.Contains(New_Ret)
	    PexObserve.Assert("@@@ new contains new ret ", New_containsNewRet );
        }
    }
}
```
