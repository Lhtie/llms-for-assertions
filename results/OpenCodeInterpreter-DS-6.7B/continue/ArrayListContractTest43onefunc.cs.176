namespace _5.String_Incrementer
{
    class Program
    {
        static void Main(string[] args)
        {
            string input = "foo123";
            string output = IncrementString(input);
            Console.WriteLine("Output: {0}", output);
            Console.ReadKey();
        }

        public static string IncrementString(string input)
        {
            string result = string.Empty;
            int number = 0;

            //Find the number that is at the end of the string
            for (int i = input.Length - 1; i >= 0; i--)
            {
                if (int.TryParse(input[i].ToString(), out number))
                {
                    result = input.Substring(0, i);
                    break;
                }
            }

            //If there is no number at the end of the string, add "1" at the end
            if (string.IsNullOrEmpty(result))
            {
                return input + "1";
            }

            //Increment the number we found
            number++;

            //Add the incremented number at the end of the string without the old number
            return result + number.ToString();
        }
    }
}//WebAPI/Models/Employee.cs
﻿using System;
