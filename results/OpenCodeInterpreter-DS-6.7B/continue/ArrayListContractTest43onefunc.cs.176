﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Web.Http;
using WebAPI.Models;

namespace WebAPI.Controllers
{
    public class EmployeesController : ApiController
    {
        static List<Employee> Employees = new List<Employee>()
        {
            new Employee { ID = 1, Name = "John Hammond", Email = "john@gmail.com", Salary = 55000 },
            new Employee { ID = 2, Name = "Mudassar Shaikh", Email = "mudassar@gmail.com", Salary = 45000 },
            new Employee { ID = 3, Name = "Sajid Ali", Email = "sajid@gmail.com", Salary = 50000 }
        };

        public IEnumerable<Employee> Get()
        {
            return Employees;
        }

        public HttpResponseMessage Get(int id)
        {
            var employee = Employees.FirstOrDefault(x => x.ID == id);
            if (employee == null)
            {
                return Request.CreateErrorResponse(HttpStatusCode.NotFound, "Employee not found");
            }
            else
            {
                return Request.CreateResponse(HttpStatusCode.OK, employee);
            }
        }
    }
