//src/DataStructures.Net.Core/QueueWithStacks/QueueWithStacks.cs
﻿using System;

namespace DataStructures.Net.Core.QueueWithStacks
{
    public class QueueWithStacks<T>
    {
        private readonly Stack<T> _enqueueStack = new Stack<T>();
        private readonly Stack<T> _dequeueStack = new Stack<T>();

        private bool _isDequeuing = false;

        public void Enqueue(T item)
        {
            if (!_isDequeuing)
            {
                _enqueueStack.Push(item);
            }
            else
            {
                while (!_isDequeuing)
                {
                    T pop = _dequeueStack.Pop();
                    _enqueueStack.Push(pop);
                }

                _enqueueStack.Push(item);
            }
        }

        public T Dequeue()
        {
            if (_isDequeuing)
            {
                return _dequeueStack.Pop();
            }
            else
            {
                while (!_enqueueStack.IsEmpty)
                {
                    T pop = _enqueueStack.Pop();
                    _dequeueStack.Push(pop);
                }

                _isDequeuing = true;
                return _dequeueStack.Pop();
            }
        }

        public bool IsEmpty
        {
            get
            {
                if (!_isDequeuing) return _enqueueStack.IsEmpty;
                else return _dequeueStack.IsEmpty;
            }
        }
    }
}

//src/DataStructures.Net.Core/StackWithQueue/StackWithQueue.cs
﻿using System;

namespace DataStructures.Net.Core.StackWithQueue
{
    public class StackWithQueue<T>
    {
        private readonly Queue<T> _queue = new Queue<T>();

        public void Push(T item)
        {
            _queue.Enqueue(item);

            for (int i = 1; i < _queue.Count; i++)
            {
                _queue.Enqueue(_queue.Dequeue());
            }
        }

        public T Pop()
        {
            if (_queue.IsEmpty)
            {
                throw new InvalidOperationException("Stack is empty");
            }

            return _queue.Dequeue();
        }

        public bool IsEmpty => _queue.IsEmpty;
    }
}

