}﻿using UnityEngine;

namespace Assets.Scripts
{
    public class CameraController : MonoBehaviour
    {
        public Transform targetTr;
        public float dist = 10.0f;
        public float height = 5.0f;
        public float smoothRotate = 5.0f;

        private Transform tr;

        void Start()
        {
            tr = GetComponent<Transform>();
        }

        void LateUpdate()
        {
            float currYAngle = Mathf.LerpAngle(tr.rotation.eulerAngles.y, targetTr.rotation.eulerAngles.y, smoothRotate * Time.deltaTime);

            Quaternion rot = Quaternion.Euler(height, currYAngle, 0);

            tr.position = targetTr.position - (rot * Vector3.forward * dist);

            tr.LookAt(targetTr);
        }
    }
}﻿using UnityEngine;

public class EnemyAttack : MonoBehaviour
{
    public float damage = 20;
    public float radius = 1;
    public LayerMask mask;

    private EnemyAI enemyAI;

    void Start()
    {
        enemyAI = GetComponent<EnemyAI>();
    }

    void Update()
    {
        if(enemyAI.canAttack)
            DetectPlayer();
    }

    void DetectPlayer()
    {
        Collider[] hits = Physics.OverlapSphere(transform.position, radius, mask);

        foreach (Collider hit in hits)
        {
            if(hit.GetComponent<PlayerHealth>() != null)
            {
                hit.GetComponent<PlayerHealth>().TakeDamage(damage);
                enemyAI.PlaySound(0);
            }
        }
    }
}﻿using UnityEngine;

public class EnemyAnimationEvent : MonoBehaviour
{
    private EnemyAI enemyAI;

    void Start ()
    {
        enemyAI = GetComponentInParent<EnemyAI>();
    }

    void OnAnimationAttackHit()
    {
        enemyAI.AttackHit();
    }

    void OnAnimationEndAttack()
    {
        enemyAI.EndAttack();
    }
   
    void OnAnimationStartChase()
    {
        enemyAI.StartChase();
    }
}﻿using UnityEngine;

public class EnemyHealth : MonoBehaviour
{
    public float health = 100;
    private EnemyAI enemyAI;

    void Start ()
    {
        enemyAI = GetComponent<EnemyAI>();
    }
	
    public void TakeDamage (float amount)
    {
        health -= amount;

        if (health <= 0)
        {
            Die();
        }
    }

    void Die ()
    {
        enemyAI.Die();
    }
}﻿using UnityEngine;

