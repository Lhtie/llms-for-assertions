//source/DotNetStandard/Harmony/Docker/DomainServices.Harmony.Docker/DockerHubClient.cs
using System;
using System.Net.Http;
using System.Threading.Tasks;
using DomainServices.Harmony.Docker;

namespace DomainServices.Harmony.Docker
{
    public class DockerHubClient
    {
        private readonly HttpClient _httpClient;

        public DockerHubClient()
        {
            _httpClient = new HttpClient();
            _httpClient.BaseAddress = new Uri("https://registry.hub.docker.com/v2/");
        }

        public async Task<DockerImage> GetImageAsync(string repo, string tag)
        {
            var response = await _httpClient.GetAsync($"repositories/{repo}/tags/{tag}");

            if(response.IsSuccessStatusCode)
            {
                return
            }
            return null;
        }

    }
}

