            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // An assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is true, the new index is equal to or greater than the old index.
            PexObserve.ComparisonForViewing(New_Ret, Old_x, "New_Ret >= Old_x");

         // An assertion using "Debug.Assert\(.*?\);" that @@@ If x does not exist in old array, new index is -1.
            if (!Old_arrListContainsX)
                PexObserve.ComparisonForViewing(New_Ret, -1, "New_Ret == -1");
        }
    }

}
PexExpectsException();
//---------------------------------------------------------------------------
//  EOF
//---------------------------------------------------------------------------
Pex--------------------
        }
    }
}



