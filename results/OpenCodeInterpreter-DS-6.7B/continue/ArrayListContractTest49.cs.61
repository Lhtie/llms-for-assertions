namespace DomainServices.Harmony.Tests
{
    public class DockerHubClientTest
    {
        [Test]
        public async Task GetDockerImage()
        {
            var client = new DockerHubClient();

            var image = await client.GetImageAsync("aspnet", "2.2-windowsservercore");

            Assert.IsNotNull(image);
            Assert.IsNotEmpty(image.id);
            Assert.IsNotEmpty(image.tags);

        }
    }
