	    // an action using action block containing @@@ That the index of new (after remove) x is less than or equal to old (after remove) index of x, and index of new x in new (after remove) arrList is same as old (after remove) x in old arrList 
	    //
	    // If the return value is true, index of x in new array is same as index of old x in old array
	    Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
	}

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;
            bool New_arrListIsEmpty = arrList.IsEmpty();

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_IsEmpty", New_arrListIsEmpty);

            Assert.AreEqual(0, New_arrListCount);
        }
}
}
}
