//We can see from the test output that the returned LastIndex is 1 but we expected it to be 2. This shows that the LastIndexOf method did not work correctly. Test failed. The last occurrence of the integer 1 is at the 2nd index in our list, but LastIndexOf returned 1, which is incorrect.

--------------------	    bool Condition_1 = New_Ret >= 0;
	    bool Condition_2 = Old_arrListCount == New_arrListCount;
            // @@@ The last index of an item in the list should be equal or less than the list's count
	    bool Condition_3 = New_Ret <= Old_arrListCount;
            // @@@ The index returned by LastIndexOf is equal to the index of the last occurrence of the item in the list when searched forwards
	    bool Condition_4 = New_Ret == Old_arrListIndexOfX;

           AssumePrecondition.IsTrue(Condition_1);
           AssumePrecondition.IsTrue(Condition_2);
           AssumePrecondition.IsTrue(Condition_3);
           AssumePrecondition.IsTrue(Condition_4);

            if (New_Ret >= 0)
            {
                if (New_arrListContainsX)
                {
                    int i = New_Ret;
                    bool found = false;
                    while (i < Old_arrListCount && !found)
                    {
                        found = arrList[i].Equals(Old_x);
                        i++;
                    }
                    Assume.True(found);
                }
            }
        }
    }
}
```

Il secondo test, `PUT_Remove_Contract`, assicura che durante l'eliminazione di un elemento, anche nell'array, l'indice dell'elemento viene aggiornato.

```csharp
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_Remove_Contract([PexAssumeUnderTest]ArrayList arrList, object x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsX = arrList.Contains(x);
            int Old_indexOfX = arrList.IndexOf(x);
            bool Pre_Condition = Old_arrListCount > 0 && Old_arrListContainsX && Old_indexOfX >= 0;

            Assume.True(Pre_Condition);

            bool New_arrListContainsX = arrList.Remove(x);
            int New_arrListCount = arrList.Count;
            int New_indexOfX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$old_FirstIndexOf_x", Old_indexOfX);

            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Contains_x", New_arrListContainsX);
            PexObserve.ValueForViewing("$new_FirstIndexOf_x", New_indexOfX);

            bool Post_Condition = New_arrListCount == Old_arrListCount - 1 && !New_arrListContainsX && New_indexOfX == -1;

            Assume.True(Post_Condition);
        }
    }
}
```

I test `PUT_RemoveAt_Contract` e `PUT_RemoveRange_Contract` assicurano che i metodi `RemoveAt` e `RemoveRange` mantengono aggiornati gli indici degli elementi e aggiornano correttamente la dimensione della raccolta quando vengono chiamati.

```csharp
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAt_Contract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Assume.True(IsValidIndex(index, arrList.Count));

            object x = arrList[index];

            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsX = arrList.Contains(x);
            int Old_indexOfX = arrList.IndexOf(x);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);
            int New_indexOfX = arrList.IndexOf--------------------            bool shouldFail = (New_Ret != -1) && (New_arrListCount == Old_arrListCount);
            Debug.Assert(!shouldFail);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is -1, last index of old x cannot be found in new list. 
            bool shouldPass = (New_Ret == -1) && !New_arrListContainsX;
            Debug.Assert(shouldPass);

            Debug.Assert(New_arrListIndexOfX == -1 || New_arrListIndexOfX == New_Ret);
            
        }
    }
}
