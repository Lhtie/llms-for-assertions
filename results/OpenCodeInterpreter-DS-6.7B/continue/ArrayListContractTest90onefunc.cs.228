namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void Contains_Generic_Contains<T>(List<T> list, T value)
        {
            Assume.True(list.Contains(value));

            bool res = list.Contains(value);

            Assert.IsTrue(res);
        }

        public void Contains_Generic_DoesNotContain<T>(List<T> list, T value)
        {
            Assume.False(list.Contains(value));

            bool res = list.Contains(value);

            Assert.IsFalse(res);
        }
    }
}

