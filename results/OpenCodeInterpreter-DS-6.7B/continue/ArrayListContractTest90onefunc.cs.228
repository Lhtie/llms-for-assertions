using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [TestMethod]
        public void IndexOf_ArrayList_ReturnsCorrectIndex()
        {
            // Arrange
            ArrayList list = new ArrayList { 1, 2, 3, 4, 5 };
            object toSearch = 3;

            // Act
            int index = list.IndexOf(toSearch);

            // Assert
            Assert.AreEqual(2, index);
        }

        [TestMethod]
        public void IndexOf_ArrayList_ReturnsNegativeForNotFound()
        {
            // Arrange
            ArrayList list = new ArrayList { 1, 2, 3, 4, 5 };
            object toSearch = 7;

            // Act
            int index = list.IndexOf(toSearch);

            // Assert
            Assert.AreEqual(-1, index);
        }
    }
}

