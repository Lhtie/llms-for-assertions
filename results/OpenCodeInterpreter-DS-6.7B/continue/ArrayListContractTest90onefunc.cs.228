using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;
using System.Collections.Generic;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [TestMethod]
        public void Contains_ArrayList_Contains()
        {
            // Arrange
            ArrayList list = new ArrayList { 1, 2, 3, 4, 5 };

            // Act
            bool res = list.Contains(3);

            // Assert
            Assert.IsTrue(res);
        }

        [TestMethod]
        public void Contains_ArrayList_DoesNotContain()
        {
            // Arrange
            ArrayList list = new ArrayList { 1, 2, 3, 4, 5 };

            // Act
            bool res = list.Contains(7);

            // Assert
            Assert.IsFalse(res);
        }
    }
}

