    ans = []
    for i in range(n):
        for j in range(n-1-i):
            if arr[j] > arr[j+1]:
                arr[j], arr[j+1] = arr[j+1], arr[j]
        ans.append(arr[:n-i-1] + arr[n-i:])
    return ans

