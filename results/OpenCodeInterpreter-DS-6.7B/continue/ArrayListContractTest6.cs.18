//FarmersEdge/Utils/HumanizeEnum.cs
﻿using System;
using System.ComponentModel;

namespace FarmersEdge.Utils
{
    public static class HumanizeEnum
    {
        public static string ToStringHumanize(this Enum value)
        {
            var attr = GetEnumAttribute<DescriptionAttribute>(value);
            return attr != null ? attr.Description : value.ToString();
        }

        private static T GetEnumAttribute<T>(Enum value) where T : Attribute
        {
            var field = value.GetType().GetField(value.ToString());
            return Attribute.GetCustomAttribute(field, typeof(T)) as T;
        }
    }
}

