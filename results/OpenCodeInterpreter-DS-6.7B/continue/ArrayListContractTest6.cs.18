    public class Money
    {
        private Decimal _value;

        public Decimal Value
        {
            get { return _value; }

            protected set
            {
                if (value < 0)
                    throw new ArgumentException("The value cannot be negative");

                _value = value;
            }
        }

        public Money(Decimal value)
        {
            Value = value;
        }

        public static explicit operator Decimal(Money money)
        {
            return money.Value;
