﻿using System.Collections.Generic;
using TravianAutoBattle.DataAccess;

namespace TravianAutoBattle
{
    public class AutoBattleTiles
    {
        // TODO: refactor this to dependency injection for testability
        private readonly TilesDataAccess _tilesDataAccess = new TilesDataAccess();

        public List<string> GetTilesToFight(int villageId)
        {
            var villageInfo = _tilesDataAccess.GetVillage(villageId);
            if (villageInfo.Troops.Contains(Troop.Archer))
                return _tilesDataAccess.GetTilesWithAttackableVillages(villageId);
            if (villageInfo.Troops.Contains(Troop.Gallop) || villageInfo.Troops.Contains(Troop.Swordsman) || villageInfo.Troops.Contains(Troop.HorseArcher))
                return _tilesDataAccess.GetTilesWithVillages(villageId);
            return new List<string>();
        }
    }
