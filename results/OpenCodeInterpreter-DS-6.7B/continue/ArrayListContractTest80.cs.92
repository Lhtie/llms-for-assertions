﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;


namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void Add_EmptyList_IncreasesCount()
        {
            ArrayList arrList = new ArrayList();
            int oldCount = arrList.Count;

            arrList.Add(5);

            Assert.AreEqual(oldCount + 1, arrList.Count);
        }

        [Test]
        public void Remove_ExistingElement_ReducesCount()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            int oldCount = arrList.Count;

            arrList.Remove(5);

            Assert.AreEqual(oldCount - 1, arrList.Count);
        }

        [Test]
        public void Remove_NonExistingElement_DoesNotChangeCount()
        {
            ArrayList arrList = new ArrayList();
            int oldCount = arrList.Count;

            arrList.Remove(5);

            Assert.AreEqual(oldCount, arrList.Count);
        }

        [Test]
        public void Insert_ValidIndexes_AddsElement()
        {
            ArrayList arrList = new ArrayList();
            int oldCount = arrList.Count;

            arrList.Insert(0, 5);

            Assert.AreEqual(oldCount + 1, arrList.Count);
        }

        [Test]
        public void Set_ValidIndexes_SetsElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);

            arrList[0] = 5;

            Assert.AreEqual(5, arrList[0]);
        }

        [Test]
        public void Get_ValidIndex_ReturnsElement()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);

            int element = (int)arrList[0];

            Assert.AreEqual(5, element);
        }


        [Test]
        public void Contains_ExistingElement_ReturnsTrue()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);

            bool contains = arrList.Contains(5);

            Assert.IsTrue(contains);
        }

        [Test]
        public void Contains_NonExistingElement_ReturnsFalse()
        {
            ArrayList arrList = new ArrayList();

            bool contains = arrList.Contains(5);

            Assert.IsFalse(contains);
        }

        [Test]
        public void IndexOf_ExistingElement_ReturnsIndex()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);

            int index = arrList.IndexOf(5);

            Assert.AreEqual(0, index);
        }

        [Test]
        public void IndexOf_NonExistingElement_ReturnsNegativeOne()
        {
            ArrayList arrList = new ArrayList();

            int index = arrList.IndexOf(5);

            Assert.AreEqual(-1, index);
        }

        [Test]
        public void LastIndexOf_ExistingElement_ReturnsIndex()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(5);
            arrList.Add(5);

            int index = arrList.LastIndexOf(5);

            Assert.AreEqual(1, index);
        }

        [Test]
        public void LastIndexOf_NonExistingElement_ReturnsNegativeOne()
        {
            ArrayList arrList = new ArrayList();

            int index = arrList.LastIndexOf(5);

            Assert.AreEqual(-1, index);
        }
    }
}

