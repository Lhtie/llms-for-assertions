}using UnityEngine;
using System.Collections;

public class SimpleNoiseFilter : INoiseFilter {

	private float m_noiseScale;
	private int m_octaves;
	
	public SimpleNoiseFilter(float noiseScale, int octaves) {
		m_noiseScale = noiseScale;
		m_octaves = octaves;
	}
	
	public float Evaluate(Vector3 point) {
		float noiseValue = 0;
		float frequency = 1;
		float amplitude = 1;
		float noiseValuePercentage;

		for (int i = 0; i < m_octaves; i++) {
			float v = (SimplexNoise.noise(point.x * frequency * m_noiseScale, point.y * frequency * m_noiseScale, point.z * frequency * m_noiseScale) + 1) * 0.5f;
			noiseValue += v * amplitude;
			frequency *= 2;
			amplitude *= 0.5f;
		}

		noiseValuePercentage = noiseValue * 100;
//		Debug.Log ("noiseValuePercentage : " + noiseValuePercentage);
		return noiseValuePercentage;
	}
