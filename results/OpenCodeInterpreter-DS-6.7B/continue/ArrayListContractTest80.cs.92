//UnitTest/ArrayListTest/ArrayListTest.cs
﻿using System;
using System.Collections;
using System.Collections.Generic;

using System.Text;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void AddTest()
        {
            ArrayList array = new ArrayList();

            array.Add(1);

            Assert.AreEqual(array[0], 1);
        }

        [Test]
        public void RemoveTest()
        {
            ArrayList array = new ArrayList();

            array.Add(1);
            array.Remove(1);

            Assert.AreEqual(array.Count, 0);
        }

        [Test]
        public void IndexOfTest()
        {
            ArrayList array = new ArrayList();

            array.Add(1);
            array.Add(2);
            array.Add(3);

            Assert.AreEqual(array.IndexOf(2), 1);
        }

        [Test]
        public void InsertTest()
        {
            ArrayList array = new ArrayList();

            array.Add(1);
            array.Add(2);

            array.Insert(1, 3);

            Assert.AreEqual(array[1], 3);
        }

        [Test]
        public void LastIndexOfTest()
        {
            ArrayList array = new ArrayList();

            array.Add(1);
            array.Add(2);
            array.Add(1);

            Assert.AreEqual(array.LastIndexOf(1), 2);
        }
    }
