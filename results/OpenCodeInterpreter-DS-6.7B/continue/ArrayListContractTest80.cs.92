using System;

namespace ArrayList
{
	public class ArrayList
	{
		private int[] arr;
		private int count;

		public ArrayList ()
		{
			arr = new int[2];
			count = 0;
		}

		public int Count {
			get {
				return count;
			}
		}

		public void Add(int item)
		{
			if (arr.Length == count) {
				Resize ();
			}
			arr [count] = item;
			count++;
		}

		public bool Contains(int item) {
			for (int i = 0; i < count; i++) {
				if (arr [i] == item) {
					return true;
				}
			}
			return false;
		}

		public int IndexOf(int item) {
			for (int i = 0; i < count; i++) {
				if (arr [i] == item) {
					return i;
				}
			}
			return -1;
		}

		public int LastIndexOf(int item) {
			for (int i = count; i > 0; i--) {
				if (arr [i] == item) {
					return i;
				}
			}
			return -1;
		}

		private void Resize() {
