        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfDeletedElement = arrList[index];
            int Old_arrListLastIndexOfDeletedElement = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsDeletedElement = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfDeletedElement = (arrList.Count >= Old_index) ? arrList[Old_index] : -1;
            int New_arrListLastIndexOfDeletedElement = arrList.LastIndexOf(New_arrListIndexOfDeletedElement);
            bool New_arrListContainsDeletedElement = arrList.Contains(New_arrListIndexOfDeletedElement);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_element_at_old_index", Old_arrListIndexOfDeletedElement);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_element_at_old_index", Old_arrListLastIndexOfDeletedElement);
            PexObserve.ValueForViewing("$old_arrList_contains_element_at_old_index", Old_arrListContainsDeletedElement);
            PexObserve.ValueForViewing("$new_arrList_element_at_old_index", New_arrListIndexOfDeletedElement);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_element_at_old_index", New_arrListLastIndexOfDeletedElement);
            PexObserve.ValueForViewing("$new_arrList_contains_element_at_old_index", New_arrListContainsDeletedElement);

        }
    }
}



































































































































































































































































































































