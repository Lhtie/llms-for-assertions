            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x--------------------            PexAssert.AreEqual(New_Ret, -1 ? (Old_arrListCount - 1) : -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, the x is in the list so, old list contains x 
            PexAssert.AreEqual(New_Ret >= 0, Old_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the New list contains x, the new index is >= old index 
            PexAssert.IsTrue(New_arrListContainsX ? New_Ret >= Old_arrListIndexOfX : true);
        }
