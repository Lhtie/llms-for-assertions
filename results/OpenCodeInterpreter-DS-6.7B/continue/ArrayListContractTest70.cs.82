//README.md
# ArrayList Contract Based Testing Project

Contract-based testing is a form of testing that focuses on the behavior of a system (in this case the ArrayList), and it does not consider the internal details of the system. Contract tests test the different operations that a data structure can perform, and the contracts define what the operations should do. We consider the operation Add, Remove, Contains, Get and Set to conduct our tests. 

# ArrayList Contract Tests
In this project, we test our ArrayList implementation under the ArrayList class framework. Pex (PexAPIWrapper) is used to generate different test data for each contract.

## Test Files
The test project files are located in the ArrayList\Test\ArrayList.Test.cs file.

## Pex Method for Testing
Two Pex methods are written. 
- PUT_AddContract: Tests the Add method of ArrayList.
- PUT_RemoveContract: Tests the Remove method of ArrayList.

We also have other Pex methods such as GetContract, SetContract, ContainsContract, IndexOfContract, LastIndexOfContract etc. for other ArrayList methods.

## Preconditions and Postconditions
The pre-condition is that the ArrayList is a valid instance of ArrayList class.

## Results 
The Pex tests generates a lot of combinations which include different edge cases. It provides comprehensive coverage and helps us find problems early in the development process. 

# Future Considerations
* Writing more Pex test methods for other ArrayList operations to achieve full-coverage.
* Using Pex Settings to provide different preconditions and constraints for each test method.
* Using PexObserve to display the state of the ArrayList before and after--------------------            if (New_Ret == -1)
               Assert.AreEqual(-1, Old_arrListLastIndexOfX);

        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // assertion that checks if Old_Last_index_of_X is <= New_Ret
            if (Old_arrListLastIndexOfX != -1){
               Assert.IsTrue(Old_arrListLastIndexOfX <= New_Ret);
            }
        }
    }
}

//2016-Pex-Sample/src/PexTest/ArrayList.Test/ArrayListTest.cs
using System;
using System.Collections;
using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [PexMethod(ActionUnderTest = "ArrayList.Add", ExpectedException = typeof(System.InvalidOperationException))]
        public void TestAddWithException()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(1);
             
            arrayList.Add(2);
            try
            {
                arrayList.Add(arrayList);
            }
            catch (System.InvalidOperationException ex)
            {
                Assert.AreEqual("Invalid operation", ex.Message);
            }
        }
    }
}

//2016-Pex-Sample/src/PexTest/PexAPIWrapper/ArrayList.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace PexAPIWrapper
{
    public class ArrayList
    {
        private IList<int> list;
  
        public ArrayList()
        {
            list = new List<int>();
        }

        public int Add(int num)
        {
            if (num < 0) throw new ArgumentException("Negative numbers not allowed");
            
            list.Add(num);
            return list.Count;
        }

    	public bool Contains(int num)
    	{
    		return list.Contains(num);
    	}

    	public int IndexOf(int num)
    	{
    		return list.IndexOf(num);
    	}

    	public int LastIndexOf(int num)
    	{
    		return list.LastIndexOf(num);
    	}
    }
}

