﻿using System;
using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using NUnit.Framework;

namespace PexTestRunnerExtend
{
    class Program
    {
        static void Main(string[] args)
        {
            PexSettings settings = new PexSettings();
            PexRunner runner = new PexRunner(settings);

            runner.Run();
            Console.WriteLine("Run test {0}", runner.LastRunResult);
            Console.ReadKey();
        }
    }
}

