//AssistLMS.Data/Models/AssistLMSContext.cs
﻿using System;
using System.Data.Entity;
using System.Data.Entity.ModelConfiguration.Conventions;
using System.Linq;

namespace AssistLMS.Data.Models
{
    public class AssistLMSContext : DbContext
    {
        public AssistLMSContext() : base("name=AssistLMSDB")
        {
            this.Configuration.ProxyCreationEnabled = false;
        }

        public virtual DbSet<User> Users { get; set; }
        public virtual DbSet<Course> Courses { get; set; }

        protected override void OnModelCreating(DbModelBuilder modelBuilder)
        {
            modelBuilder.Conventions.Remove<PluralizingTableNameConvention>();

            base.OnModelCreating(modelBuilder);
        }

        public override int SaveChanges()
        {
            return base.SaveChanges();
        }
    }
}

//AssistLMS.Data/Repositories/UserRepository.cs
﻿using AssistLMS.Data.Models;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace AssistLMS.Data.Repositories
{
    public class UserRepository
    {
        private AssistLMSContext _ctx;

        public UserRepository()
        {
            _ctx = new AssistLMSContext();
        }

        public User Get(int id)
        {
            return _ctx.Users.Find(id);
        }

        public List<User> GetAll()
        {
            return _ctx.Users.ToList();
        }

        public void Add(User user)
        {
            _ctx.Users.Add(user);
            _ctx.SaveChanges();
        }

        public void Update(User user)
        {
            var userInDb = _ctx.Users.Find(user.UserId);

            if (userInDb == null)
                throw new ArgumentNullException("userInDb");

            userInDb.FirstName = user.FirstName;
            userInDb.LastName = user.LastName;
            userInDb.Email = user.Email;
            userInDb.Role = user.Role;
            userInDb.Password = user.Password;

            _ctx.SaveChanges();
        }

