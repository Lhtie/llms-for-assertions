}public static string[] Split(string text, string separator)
{
    List<string> results = new List<string>();
    int index = 0;
    while(index < text.length)
    {
        // find end
        int end = text.indexOf(separator, index);
        // if not found, end is -1
        if(end == -1) 
            end = text.length;
        results.add(text.substring(index, end));
        index = end + separator.length;
    }
    return results.ToArray();
}

public static string Join(string[] arr, string separator)
{
    StringBuilder result = new StringBuilder();
    for(int i=0; i<arr.length;i++)
    {
        result.append(arr[i]);
        if(i != arr.length-1) 
            result.append(separator);
    }
    return result.toString();
}
static void Main()
{
 string test = "Hello world|Goodbye world";
   string separator = "|";
    string[] parts = Split(test, separator);

    Console.WriteLine("Parts after split: "+parts.Length);
    // Output Parts after split: 2

    foreach (string part in parts)
    {
        Console.WriteLine(part); 
        // Output Hello world
        // Output Goodbye world
    }

    string joined = Join(parts, separator);
    Console.WriteLine("Joined: "+joined);
   // Output Joined: Hello world|Goodbye world
