//src/PexTestRunnerExtend/PexTestRunnerExtend/Contracts/ArrayTest.cs
using System;
using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using NUnit.Framework;

namespace PexTestRunnerExtend.Contracts{
    
    public class ArrayTest
    {
        public static int[] CopyContent(int[] src, int number)
        {
            int[] dest = new int[src.Length];
            Array.Copy(src, dest, number);
            return dest;
        }
    
        [PexMethod]
        [PexExpectedException(typeof(ArgumentException))]
        public static void BadCopy()
        {
            int[] src = new int[4];
            int[] dest = new int[2];
            Array.Copy(src, 1, dest, 1, 3);
        }
    
        [PexMethod]
        [PexExpectedException(typeof(ArgumentException))]
        public static void BadCopy2()
        {
            int[] src = new int[4];
            int[] dest = new int[2];
            Array.Copy(src, 0, dest, 1, 3);
        }
    }
}

