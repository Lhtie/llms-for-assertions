﻿using System;
using System.Linq.Expressions;
using SharpEx.Model.Expressions;
using Xunit;

namespace SharpEx.Test.Model.Expressions
{
    public class TestObjectModelExpression
    {
        #region Nested type: TestObjectModel

        public class TestObjectModel
        {
            public string Property { get; set; }
        }

        #endregion

        [Fact]
        public void TestGetPropertyName()
        {
            Expression<Func<TestObjectModel, string>> expression = obj => obj.Property;

            string propertyName = ObjectModelExpression.GetPropertyName(expression);

            Assert.Equal("Property", propertyName);
        }
    }
}
