[TestFixture, PexClass]
public partial class ArrayListTest
{
    [Test]
    [PexMethod]
    public void TestAdd([PexAssumeUnderTest] IList<int> lst, int value)
    {
        lst.Add(value);

        Assert.AreEqual(lst.Count, 1);
        Assert.AreEqual(lst[lst.Count - 1], value);
    }

    [Test]
    [PexMethod]
    public void TestInsert([PexAssumeUnderTest] IList<int> lst, int index, int value)
    {
        Assume.Above(index, 0);
        Assume.Below(index, lst.Count + 1);

        lst.Insert(index, value);

        Assert.AreEqual(lst.Count, 1 + lst.Count);
        Assert.AreEqual(lst[index], value);
    }

    [Test]
    [PexMethod]
    public void TestRemove([PexAssumeUnderTest] IList<int> lst, int value)
    {
        int ind = lst.IndexOf(value);
        if (ind != -1)
        {
            lst.Remove(value);
            Assert.AreEqual(lst.Count, lst.Count - 1);
            Assert.AreNotEqual(lst.IndexOf(value), ind);
        }
        else
        {
            Assert.AreEqual(ind, -1);
        }
    }

    [Test]
    [PexMethod]
    public void TestIndexOf([PexAssumeUnderTest] IList<int> lst, int value)
    {
        int ind = lst.IndexOf(value);
        if (ind != -1)
        {
            Assert.IsTrue(ind >= 0);
            Assert.IsTrue(ind < lst.Count);
            Assert.AreEqual(lst[ind], value);
        }
        else
        {
            Assert.AreEqual(ind, -1);
        }
    }

