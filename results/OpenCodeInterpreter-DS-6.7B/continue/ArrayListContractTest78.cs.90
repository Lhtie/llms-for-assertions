            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
        }

        [Test]
        public void ArrayList_Insert()
        {
            ArrayList arrList = new ArrayList();

            // Test insert with multiple elements:
            // Insert an element at a given index in the ArrayList, check if the element has been added at the proper index
            arrList.Add(1);
            arrList.Add(2);
            arrList.Insert(1, 3);
            Assert.AreEqual(2, arrList.IndexOf(3));
        }

        [Test]
        public void ArrayList_Remove()
        {
            ArrayList arrList = new ArrayList();

            // Test remove with multiple elements:
            // Add multiple elements to the ArrayList, remove one of them and check if the element is removed and is no longer in the ArrayList
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Remove(2);
            Assert.AreEqual(-1, arrList.IndexOf(2));
