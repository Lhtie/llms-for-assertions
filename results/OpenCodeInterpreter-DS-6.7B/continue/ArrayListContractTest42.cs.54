        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] array, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count);
            AssumePrecondition.IsTrue(array.Length - index >= 0);

            int[] Old_array = array;
            int Old_Index = index;
            int Old_arrListCount = arrList.Count;
            bool Old_ContainsTrue = true;

            arrList.CopyTo(array, index);

            int[] New_Array = array;
            int[] New_arrayContainsOld = array;
            bool New_ContainsTrue = true;
            foreach (int item in arrList)
            {
                if (!New_arrayContainsOld.Contains(item))
                {
                    New_ContainsTrue = false;
                    break;
                }
            }

            PexObserve.ValueForViewing("$Old_array", Old_array);
            PexObserve.ValueForViewing("$New_Array", New_Array);
            PexObserve.ValueForViewing("$Old_Index", Old_Index);
            PexObserve.ValueForViewing("$Old_arrListCount", Old_arrListCount);
            PexObserve.ValueForViewing("$Old_ContainsTrue", Old_ContainsTrue);
            PexObserve.ValueForViewing("$New_ContainsTrue", New_ContainsTrue);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count != 0);

            arrList.Clear();

            bool New_ContainsTrue = true;
            foreach (int item in arrList)
            {
                if (!New_ContainsTrue)
                {
                    New_ContainsTrue = false;
                    break;
                }
            }

            PexObserve.ValueForViewing("$New_ContainsTrue", New_ContainsTrue);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the array is empty
            PexObserve.ValueForViewing("Assertion", (!New_ContainsTrue) ? "AssertionFailure" : "AssertionSuccess");
        }
    }
}

"ArrayListContractTest.cs" is a test class which contains methods for Pex to test the behaviours of the ArrayList by performing operations such as Add, Remove, Insert, Set, Get, CopyTo and Clear.

PexObserve.ValueForViewing is used to display the values being tested to aid in visualisation of the properties being met during the test.

However, executing these contracts does not seem to improve the test coverage as it's the same as running the tests individually.

I'm not sure where the problem lies, I had read that Pex could increase the coverage of unit tests by examining multiple program paths that would otherwise not be tested. But in my case, it doesn't seem to be working. Could you please help me with this?

Thanks."
