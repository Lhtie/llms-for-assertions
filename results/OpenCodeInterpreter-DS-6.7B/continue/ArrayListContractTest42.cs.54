
            if (!New_containsNewRet) throw new InvalidOperationException("Invalid index");
        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {

            AssumePrecondition.IsTrue(true); 

            arrList.Clear();

            int New_arrListCount = arrList.Count;
		int New_IndexOfOne = 1;

            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
	    // an assertion using "Debug.Assert\(.*?\);" that @@@ the array is empty

            if (New_arrListCount != 0) throw new InvalidOperationException("Invalid clear operation");

        }
    }
