A: ArrayList does not guarantee order when you insert or remove elements. It is an implementation of the IList interface, where the order of elements is determined by their insertion order, and it is important to keep that in mind when making assertions. 

A: When you use Pex and you want to test if the array list contains a particular element after a certain operation on it, you should assert that this element is present in the array list after the operation, regardless of its order.

The reason behind this assertion is that 'Contains' method can have different behavior when used with different types of collections. For instance, if you use 'Contains' on ArrayList it checks that the object exists anywhere in the list, not considering the order.

In your case, it’s best to make an assumption that an element is added to the ArrayList or it’s removed from the ArrayList, and then assert that the element is present in the ArrayList. It means that whatever operation was performed on the ArrayList, it should leave an element in it.

Assert.IsTrue(arrList.Contains(x), "ArrayList do not contain the element: " + x);

In the example code, if no exception is thrown, it means that the element was added to the ArrayList. 

Remember, you should do this for each PexMethod with the correct element that is being added or removed. 

And also consider making multiple assertions to check that the other elements that were not involved in the current operation remain in the list. For example, if you add an element, check that the ArrayList does contain all elements that were already in the list before the operation. Similarly, if you remove an element be sure to verify that all other elements remain in the list. 

Unfortunately, Pex does not support ordering in the collections as yet. If you want to maintain order, then consider using a different data structure, for example, List<T> in combination with the 'Contains' method. If an ArrayList is a must, then you will have to implement your own logic for testing its 'Contains' method for a proper order verification. I recommend to raise this as an issue on the Pex/Framework GitHub page. 
I hope this helps, let me know if you need more guidance--------------------            Assert.IsTrue(arrList.Contains(New_Ret));
        }
    }
}

//Test/ArrayListTest.cs
using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;
using PexAPIWrapper;

[TestClass]
public class ArrayListTest
{
    private PexAPIWrapper.ArrayList list;

    [TestInitialize]
    public void TestInitialize()
    {
        this.list = new PexAPIWrapper.ArrayList();
    }

    [TestMethod]
    public void Test_Add()
    {
        this.list.Add(10);
        Assert.AreEqual(1, this.list.Count);
    }

    [TestMethod]
    public void Test_Remove()
    {
        this.list.Add(10);
        this.list.Add(20);
        this.list.Remove(20);
        
        Assert.AreEqual(1, this.list.Count);
    }

    [TestMethod]
    public void Test_Insert()
    {
        this.list.Add(10);
        this.list.Insert(0, 20);

        Assert.AreEqual(20, (int)this.list[0]);
    }

    [TestMethod]
    [ExpectedException(typeof(ArgumentOutOfRangeException))]
    public void Test_Insert_Exception()
    {
        this.list.Insert(0, 20);
    }

    [TestMethod]
    public void Test_Set()
    {
        this.list.Insert(0, 10);
        this.list[0] = 20;

        Assert.AreEqual(20, (int)this.list[0]);
    }

    [TestMethod]
    [ExpectedException(typeof(ArgumentOutOfRangeException))]
    public void Test_Set_Exception()
    {
        this.list[0] = 10;
    }

    [TestMethod]
    public void Test_Get()
    {
        this.list.Add(10);

        Assert.AreEqual(10, (int)this.list[0]);
    }

    [TestMethod]
    [ExpectedException(typeof(ArgumentOutOfRangeException))]
    public void Test_Get_Exception()
    {
        int val = (int)this.list[0];
    }
}﻿using System;
using System.Collections.Generic;
using System.Text;

namespace ArrayList
{
    public class ArrayList
    {
        private List<object> _data;

        public ArrayList()
        {
            this._data = new List<object>();
        }

        public int Add(object item)
        {
            this._data.Add(item);
            return this._data.Count;
        }

        public void Remove(object item)
        {
            this._data.Remove(item);
        }

        public void Insert(int index, object item)
        {
            if (index < 0 || index > this._data.Count)
                throw new ArgumentOutOfRangeException();

            this._data.Insert(index, item);
        }

        public object this[int index]
        {
            get
            {
                if (index < 0 || index >= this._data.Count)
                    throw new ArgumentOutOfRangeException();

                return this._data[index];
            }
            set
            {
                if (index < 0 || index >= this._data.Count)
                    throw new ArgumentOutOfRangeException();

                this._data[index] = value;
            }
        }

        public int Count { get => this._data.Count; }

        public int IndexOf(object item)
        {
            return this._data.IndexOf(item);
        }

        public int LastIndexOf(object item)
        {
            return this._data.LastIndexOf(item);
        }

        public bool Contains(object item)
        {
            return this._data.Contains(item);
        }
    }
