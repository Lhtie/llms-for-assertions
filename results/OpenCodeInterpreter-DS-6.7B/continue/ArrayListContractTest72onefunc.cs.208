- 了解[代码完整性检查](https://blogs.msdn.microsoft.com/developmentfactor/2007/07/27/code-integrity-check/)的概念，这可以防止从源代码树生成的文件被修改。
- 了解如何在[Visual Studio](https://docs.microsoft.com/visualstudio/test/use-ui-automation-to-test-your-code?view=vs-2019)中使用UI自动化来进行UI测试。
- 使用[Moles](https://docs.microsoft.com/visualstudio/test/using-moles-to-isolate-code---------------------	    // If the return value is negative, it implies that item is not found so we don't have anything for the second part of the assertion.
	    if (New_Ret >= 0)
	    {
	        Assert.AreNotEqual(New_Ret, Old_arrListLastIndexOfX);
	    }

	    Assert.AreEqual(Old_arrListCount, New_arrListCount);
	    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
	    Assert.AreEqual(Old_x, x);		
	}
    }
}
