namespace Catel.Extensions.Test.Collections.Test
{
    using System.Collections;
    using Catel.Collections;
    using NUnit.Framework;

    public class ArrayListTest
    {
        #region Methods
        [Test]
        public void TestAddAt()
        {
            var arrayList = new ArrayListExtended();

            arrayList.Add(10);
            arrayList.Add(15);
            arrayList.Add(20);

            arrayList.AddAt(2, "test");
            Assert.AreEqual("test", arrayList[2]);

            arrayList.AddAt(0, "test2");
            Assert.AreEqual("test2", arrayList[0]);

            arrayList.AddAt(5, "test3");
            Assert.AreEqual("test3", arrayList[5]);

            // Add at with invalid position
            Assert.AreEqual(6, arrayList.Count);
            arrayList.AddAt(10, "test4");
            Assert.AreEqual("test4", arrayList[10]);
            Assert.AreEqual(7, arrayList.Count);
        }

        [Test]
        public void TestContains()
        {
            var arrayList = new ArrayListExtended();

            arrayList.Add(10);
            arrayList.Add("test");

            Assert.IsTrue(arrayList.Contains("test"));
            Assert.IsFalse(arrayList.Contains("Test"));
            Assert.IsFalse(arrayList.Contains(20));
        }

        [Test]
        public void TestRemove()
        {
            var arrayList = new ArrayListExtended();

            arrayList.Add(10);
            arrayList.Add("test");
            arrayList.Add(20);
            arrayList.Add(30);

            arrayList.Remove("test");
            Assert.AreEqual(20, arrayList[0]);
            Assert.AreEqual(30, arrayList[1]);

            arrayList.RemoveAt(0);
            Assert.AreEqual(30, arrayList[0]);
            Assert.AreEqual(2, arrayList.Count);

            arrayList.RemoveRange(0, 1);
            Assert.AreEqual(0, arrayList.Count);
        }

        [Test]
        public void TestSort()
        {
            var arrayList = new ArrayListExtended();

            arrayList.Add(10);
            arrayList.Add("test");
            arrayList.Add("hello");
            arrayList.Add(20);
            arrayList.Add(30);

            arrayList.Sort();

            Assert.AreEqual(10, arrayList[0]);
            Assert.AreEqual(20, arrayList[1]);
            Assert.AreEqual(30, arrayList[2]);
        }
        #endregion
    }
}

