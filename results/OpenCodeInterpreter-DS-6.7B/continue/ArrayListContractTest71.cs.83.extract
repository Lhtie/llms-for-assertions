	    // (this is correct because you can't have a valid last index of an element that doesn't exist in the array) 

	    Debug.Assert(New_Ret == -1 && New_arrListLastIndexOfX == -1 || New_Ret >= 0 && New_arrListLastIndexOfX >= 0);
------------------------------------------------------------	    Debug.Assert(New_Ret == - 1 && New_arrListLastIndexOfX == -1);}
--------------------------------------------------------------------------------        Debug.Assert(New_Ret == -1 && New_arrListLastIndexOfX == -1);
