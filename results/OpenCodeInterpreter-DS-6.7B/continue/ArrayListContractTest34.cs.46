        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_atIndex = (int)arrList[index];
            int Old_arrListIndexOfAtIndex = arrList.IndexOf(arrList[index]);
            bool Old_arrListContainsAtIndex = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfAtIndex = arrList.IndexOf(arrList[index]);
            bool New_arrListContainsAtIndex = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
