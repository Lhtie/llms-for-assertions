using System;
using System.Text;
using System.Collections.Generic;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayListTest
{
    [TestClass]
    public class ArrayListTest
    {
        [TestMethod]
        public void TestAdd()
        {
            ArrayList<int> arrList = new ArrayList<int>();
            arrList.Add(5);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(5, arrList[0]);
        }

        [TestMethod]
        public void TestAddObject()
        {
            ArrayList<string> arrList = new ArrayList<string>();
            arrList.Add("hello");
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual("hello", arrList[0]);
        }

        [TestMethod]
        public void TestInsertIntoEmpty()
        {
            ArrayList<string> arrList = new ArrayList<string>();
            arrList.Insert(0, "hello");
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual("hello", arrList[0]);
        }

        [TestMethod]
        public void TestInsert()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25 });
            arrList.Insert(2, 12);
            Assert.AreEqual(5, arrList.Count);
            Assert.AreEqual(12, arrList[2]);
        }

        [TestMethod]
        [ExpectedException(typeof(IndexOutOfRangeException))]
        public void TestInsertIndexOutOfBound()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25 });
            arrList.Insert(10, 12);
        }

        [TestMethod]
        public void TestRemove()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25 });
            arrList.Remove(20);
            Assert.AreEqual(3, arrList.Count);
            arrList.Remove(15);
            Assert.AreEqual(2, arrList.Count);
        }

        [TestMethod]
        public void TestRemoveFirst()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25 });
            arrList.RemoveAt(0);
            Assert.AreEqual(3, arrList.Count);
            Assert.AreEqual(15, arrList[0]);
        }

        [TestMethod]
        public void TestRemoveAllOccurences()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25, 15, 20 });
            arrList.Remove(20);
            Assert.AreEqual(4, arrList.Count);
        }

        [TestMethod]
        public void TestIndexOf()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 25 });
            Assert.AreEqual(2, arrList.IndexOf(20));
            Assert.AreEqual(-1, arrList.IndexOf(12));
        }

        [TestMethod]
        public void TestLastIndexOf()
        {
            ArrayList<int> arrList = new ArrayList<int>(new int[] { 10, 15, 20, 20, 25 });
            Assert.AreEqual(3, arrList.LastIndexOf(20));
            Assert.AreEqual(-1, arrList.LastIndexOf(12));
        }

