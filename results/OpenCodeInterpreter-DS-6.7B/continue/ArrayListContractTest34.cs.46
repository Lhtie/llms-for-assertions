        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
 
        }

        [PexMethod]
        public void PUT_TrimToSizeContract([PexAssumeUnderTest]ArrayList arrList)
        {
 	    AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;

            int Old_arrListCapacity = ((ArrayList) arrList).Capacity;

            arrList.TrimToSize();

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = ((ArrayList) arrList).Capacity;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ capacity of array list is equal to the count 
	    string assert_msg = "The capacity of the list is not equal to the count after TrimToSize method";
	    Debug.Assert(New_arrListCapacity == New_arrListCount, assert_msg);
        }
