    // Start is called before the first frame update
    void Start()
    {
        objects = new List<GameObject>();
    }

    // Updates the pool
    public void UpdatePool()
    {
       /*foreach (GameObject obj in objects)
        {
            if (obj == null)
            {
                objects.Remove(obj);
            }
        }*/
    }

    /**
     * Spawns an object and returns a reference to it.
     */
    public GameObject SpawnObject(GameObject obj, Vector3 position, Quaternion rotation)
    {
        GameObject spawnedObject = Instantiate(obj, position, rotation);
        objects.Add(spawnedObject);

        return spawnedObject;
    }
}using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using Photon.Pun;

public class PlayerStats : MonoBehaviour
{
    public int maxHealth = 100;
    private int currentHealth;
    public int healthRegenAmount = 1;
    public float healthRegenDelay = 1f;
    private float lastHealthRegenTime = 0f;

    private PhotonView PV;

    void Start()
    {
        currentHealth = maxHealth;
        PV = GetComponent<PhotonView>();
    }

    void Update()
    {
        if(Time.time - lastHealthRegenTime >= healthRegenDelay)
        {
            RegenerateHealth(healthRegenAmount);
            lastHealthRegenTime = Time.time;
        }
        
    }

    // Update player health and sends it to all clients
    void UpdateHealth()
    {
        PV.RPC("RPC_UpdateHealth", RpcTarget.All, currentHealth);
    }

    // Regenerates the player's health
    public void RegenerateHealth(int amount)
    {
        if (currentHealth < maxHealth)
        {
            currentHealth += amount;
            if (currentHealth > maxHealth)
            {
                currentHealth = maxHealth;
            }
            UpdateHealth();
        }
    }

    // Decreases the player's health and checks if they're dead
    [PunRPC]
    public void TakeDamage(int damage)
    {
        currentHealth -= damage;
        if (currentHealth <= 0)
        {
            currentHealth = 0;
            Die();
        }
        UpdateHealth();
    }

    // What to do when the player dies (currently just destroy the player object)
    void Die()
    {
        // TODO: Add death animation and effects
        Destroy(gameObject);
    }
}using System.Collections;
