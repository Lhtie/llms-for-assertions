            PexObserve.ValueForViewing("$old_arrList_IndexOf_atIndex", Old_arrListIndexOfAtIndex);
            PexObserve.ValueForViewing("$new_arrList_Contains_atIndex", New_arrListContainsAtIndex);

            if (Old_arrListCount > 0)
                PexObserve.ValueForViewing("$new_arrList_IndexOf_atIndex", New_arrListIndexOfAtIndex);
