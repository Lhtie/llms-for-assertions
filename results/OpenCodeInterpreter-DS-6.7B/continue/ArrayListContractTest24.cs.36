        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndex = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Index", Old_arrListIndex);

        }

        [PexMethod]
        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count - count && index + count >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_count = count;
            int Old_arrListIndexOf_removedItems = -1;
            if (count > 0)
            {
                object[] removedItems = arrList.GetRange(index, count);
                Old_arrListIndexOf_removedItems = arrList.IndexOf(removedItems[0]);
            }

            arrList.RemoveRange(index, count);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOf_removedItems = -1;
            if (count > 0)
            {
                object[] removedItems = arrList.GetRange(index, count);
                New_arrListIndexOf_removedItems = arrList.IndexOf(removedItems[0]);
            }

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$Old_index", Old_index);
            PexObserve.ValueForViewing("$Old_count", Old_count);
            PexObserve.ValueForViewing("$Old_arrListIndexOf_removedItems", Old_arrListIndexOf_removedItems);
            PexObserve.ValueForViewing("$New_arrListIndexOf_removedItems", New_arrListIndexOf_removedItems);
        }
    }
}

