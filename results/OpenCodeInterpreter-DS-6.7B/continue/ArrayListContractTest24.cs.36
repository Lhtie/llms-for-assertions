//UnitTesting/ArrayListProject/PexAPIWraper/PexAPIWrapper/PexApi.cs
﻿using System;
using System.Collections;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;
using List.Test;


namespace PexAPIWrapper
{
    public class PexApi
    {
        public static void testAdd(ArrayList obj, string str)
        {
            ArrayList oldArrayList = new ArrayList(obj);
            obj.Add(str);
            Assert.AreEqual(oldArrayList.Count + 1, obj.Count);
            PexObserve.ValueForViewing("addedString", str);
            
        }


        public static void testRemove(ArrayList obj, string str)
        {
            ArrayList oldArrayList = new ArrayList(obj);
            obj.Remove(str);
            Assert.AreEqual(oldArrayList.Count - 1, obj.Count);
            PexObserve.ValueForViewing("removedString", str);
           
        }


        public static void testInsert(ArrayList obj, string str, int index)
        {
            ArrayList oldArrayList = new ArrayList(obj);
            obj.Insert(index, str);
            Assert.AreEqual(str, obj[index]);
            PexObserve.ValueForViewing("insertedString", str);
            PexObserve.ValueForViewing("index", index);
           
        }

    }
}

