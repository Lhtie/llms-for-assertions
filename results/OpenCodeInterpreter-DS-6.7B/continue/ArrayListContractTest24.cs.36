<?php
final class PUT_ClearContract extends PHPUnit_Framework_TestCase
{
    public static function providerClearContract()
    {
        return array(
            array(array(1)),
            array(array(1, 2)),
            array(array(1, 2, 3)),
--------------------        }

        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeUnderTest]ArrayList addRangeList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.AddRange(addRangeList);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of the new array list is equal to sum of count of old arrayList and addRangeList  
        }

        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            arrList.Sort();

            // Ensuring that the list is sorted. 
            for (int i = 0; i < arrList.Count - 1; i++)
            {
                Assume.That((int)arrList[i] <= (int)arrList[i + 1]);
            }

	    // Ensures that sorting an already sorted list does not affect the list.
	    AssumePrecondition.IsTrue(arrList.ToArray().SequenceEqual(arrList.ToArray().OrderBy(x => x)));
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(0 <= index && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_Index = index;
            bool Old_arrListContainsIndexData = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsIndexData = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_Index);
            PexObserve.ValueForViewing("$old_arrList_containsIndexData", Old_arrListContainsIndexData);
            PexObserve.ValueForViewing("$new_arrList_containsIndexData", New_arrListContainsIndexData);

        }

        public void PUT_ExistsContract([PexAssumeUnderTest]ArrayList arrList, int itemToCheck)
        {
        // Test Exists (boolean method)

            AssumePrecondition.IsTrue(itemToCheck >=0);

            bool ExistsMethodTrue = arrList.Exists(x => (int)x == itemToCheck);

            bool ExistsMethodFalse = arrList.Exists(x => (int)x == itemToCheck + 1);

            PexObserve.ValueForViewing("$ExistsMethodTrue", ExistsMethodTrue);
            PexObserve.ValueForViewing("$ExistsMethodFalse", ExistsMethodFalse);
		   
        }

    }
}


		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
	
  }
}


		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
		    
	
