internal class MsbuildPexProjectCreator
{
    internal static ParseOutput Parse(string code)
    {
        var parser = new Parser();
        var parseOutput = new ParseOutput
        {
            Text = code
        };

        try
        {
            parser.Parse(parseOutput);
        }
        catch (Exception ex)
        {
            parseOutput.ExceptionText = ex.ToString();
            var stackTrace = new StackTrace(ex, true);
            foreach (var frame in stackTrace.GetFrames())
            {
                parseOutput.ExceptionStackTrace.Add(frame.ToString());
            }
        }

        return parseOutput;
    }
}

internal class ParseOutput
{
    internal string Text { get; set; }
    internal string ExceptionText { get; set; }
    internal List<string> ExceptionStackTrace { get; } = new List<string>();
    internal Assembly Assembly { get; set; }
}
