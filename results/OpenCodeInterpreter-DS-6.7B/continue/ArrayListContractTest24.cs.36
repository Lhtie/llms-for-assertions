```};
```csharp
public class Tip {
    public string Text { get; private set; }

    public Tip(string text)
    {
        this.Text = text;
    }
}
```};
```csharp
public interface ITipProvider {
    Tip GetTip();
    string[] GetSuggestedTags();
}
```};
```csharp
public static class TipService {
    private static List<ITipProvider> tipProviders = new List<ITipProvider>();

    public static void RegisterTipProvider(ITipProvider provider)
    {
        tipProviders.Add(provider);
    }

    public static Tip GetRandomTip()
    {
        if (tipProviders.Count == 0) {
            throw new InvalidOperationException("No tip providers have been registered.");
        }

        return tipProviders[Random.Range(0, tipProviders.Count)].GetTip();
    }
}
```};
public class Program
{
    static void Main()
    {
        PocketOutliner.Register();
        Tip tip = TipService.GetRandomTip();
        Console.WriteLine(tip.Text);
    }
}
