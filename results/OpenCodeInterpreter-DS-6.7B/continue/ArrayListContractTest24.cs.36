            Assert.IsTrue(string.IsNullOrWhiteSpace(parserOutput.ExceptionText), parserOutput.ExceptionText);
            Assert.AreEqual(0, parserOutput.ExceptionStackTrace.Count);
            Assert.IsNotNull(parserOutput.Assembly);
