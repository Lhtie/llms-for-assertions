﻿using System;
using NUnit.Framework;
using ArrayList;

[TestFixture]
public class TestList
{
    [Test]
    public void AddTest()
    {
        // Create a new ArrayList object
        ArrayList al = new ArrayList();

        // Add some elements
        al.Add("A");
        al.Add("B");
        al.Add("C");

        // Verify count
        Assert.AreEqual(3, al.Count, "Failed in AddTest");
    }

    [Test]
    public void RemoveTest()
    {
        // Create a new ArrayList object
        ArrayList al = new ArrayList();

        // Add some elements
        al.Add("A");
        al.Add("B");
        al.Add("C");

        // Remove "B"
        al.Remove("B");

        // Verify count
        Assert.AreEqual(2, al.Count, "Failed in RemoveTest");
    }
}

