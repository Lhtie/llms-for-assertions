  #include <stdlib.h>
  #include <string.h>

  int assert_value_is_greater_or_equal_than(char* str1, char* str2)
  {
    char *min_str, *max_str;
    int num1 = atoi(str1);
    int num2 = atoi(str2);

    if (num1 > num2)
    {
      min_str = str2;
      max_str = str1;
    }
    else
    {
      min_str = str1;
      max_str = str2;
    }

    if(strcmp(max_str, min_str) < 0)
    {
      fprintf(stderr, "Assertion failed: expected number is less than actual number\n");
      return 1;
    }

    if(strcmp(max_str, min_str) == 0)
    {
      fprintf(stderr, "Assertion failed: expected number (%d) is equals (%d)\n", num1, num2);
      return 1;
    }
    return 0;
  }

  int assert_true(int b)
  {
    if (!b)
    {
      fprintf(stderr, "Assertion failed: expected true, but got false\n");
      return 1;
    }
    return 0;
  }
