            lstIntegers.Add(3);
            lstIntegers.Add(6);
            lstIntegers.Add(9);
        }

        [Test]
        public void TestAddAndIndexer()
        {
            lstIntegers[1] = 2;
            Assert.AreEqual(4, lstIntegers.Count);
        }

        [Test]
        public void TestAdd()
        {
            lstIntegers.Add(5);
            Assert.AreEqual(4, lstIntegers.Count);
        }

        [Test]
        public void TestRemove()
        {
            lstIntegers.Remove(6);
            Assert.AreEqual(2, lstIntegers.Count);
            Assert.AreEqual(2, lstIntegers[1]);

        }

        [Test]
        public void TestInsert()
        {
            lstIntegers.Insert(0, 1);
            lstIntegers.Insert(2, 99);
            Assert.AreEqual(4, lstIntegers.Count);
            Assert.AreEqual(0, lstIntegers[0]);
            Assert.AreEqual(99, lstIntegers[2]);

        }
    }
}

