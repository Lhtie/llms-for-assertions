using PexAPIWrapper;

namespace System.Diagnostics 
{
    [TestFixture]
    public class ArrayTest
    {
        [PexMethod]
        public void CopyTo()
        {
            int[]--------------------	    AssumePrecondition.IsTrue(New_Ret || Old_arrListLastIndexOfX >= -1); // an assertion
        // using "... = arrList.LastIndexOf(x);"

        /* Note: To assert whether last position of x in old list is >= -1, it's incorrect to compare Old_arrListLastIndexOfX with -1. Correct assertion should be AssumePrecondition.IsTrue(New_Ret || Old_arrListLastIndexOfX >= -1);, assuming that Old_arrListLastIndexOfX is correct after execution of the method, it should always be >= -1. */

            /* 
	     * For the assertion  @@@ If the return value is false, last position of x in old list is >= -1, the correct Pex input for this assertion would be no input to the method. i.e., arrList is empty and x does not exist in arrList. In this case, even if we call Contains method with x, it will always return false and arrList.LastIndexOf(x) is -1.
	     */
        }
    }

    [TestFixture]
    public class ArrayListPexTest
    {
        // For testing
        [Test]
        public void Test()
        {
            var list = new ArrayList();
            list.Add(10);
            list.Add(20);
            list.Add(30);
            list.Add(40);
            list.Add(50);
            list.Add(60);
            list.Add(70);

            Console.WriteLine(list.Contains(10));
            Console.WriteLine(list.IndexOf(10));
            Console.WriteLine(list.LastIndexOf(10));

            //list.RemoveAt(1);
        }
    }
}

