﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace Demo
{
    public class Program
    {
        static void Main(string[] args)
        {
            // Demonstration of how to test with Pex
            ArrayList al = new ArrayList();
            // The 'Add' function adds a new item.
            // It returns the index of the added item.
            int addedItemIndex = al.Add(5);
            // The 'Remove' function removes the specified item.
            // It returns true if the item was found and removed; otherwise, false.
            bool didRemove = al.Remove(5);
            // The 'Contains' function determines whether an item is in the list.
            // It returns true if the item is in the list; otherwise, false.
            bool containsFive = al.Contains(5);

            // Demonstration of how to test with NUnit (Unit Testing Framework)
            var p = new Program();
            p.TestAddAndRemove();
        }

        public class ArrayList
        {
            List<int> items = new List<int>();
            public int Add(int item)
            {
                items.Add(item);
                return items.IndexOf(item);
            }

            public bool Remove(int item)
            {
                return items.Remove(item);
            }

            public bool Contains(int item)
            {--------------------            AssumeHelper.ForCondition<int>(New_arrListCount == Old_arrListCount && ((New_arrListLastIndexOfX == -1) || (New_arrListLastIndexOfX == Old_arrListLastIndexOfX)), new Exception("The value of this exception is 'The value of this exception is "));
        }

        [PexMethod]
        public void PUT_ToArrayContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            int[] New_Array = arrList.ToArray();

            int New_arrListCount = arrList.Count;

            int New_ArrayLength = New_Array.Length;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$New_array_length", New_ArrayLength);

        }

        [PexMethod]
        public void PUT_ToArrayIndexedContract([PexAssumeUnderTest]ArrayList arrList, int startIndex, int count)
        {
            AssumePrecondition.IsTrue(startIndex >= 0 && startIndex + count <= arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_startIndex = startIndex;
            int Old_count = count;

            int[] New_array = arrList.ToArray(startIndex, count);

            int New_arrListCount = arrList.Count;

            int New_arrayLength = New_array.Length;

            bool New_containsAll = true;
            for (int i = 0; i < New_array.Length && New_containsAll; i++)
                New_containsAll = arrList.Contains(New_array[i]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$New_array_length", New_arrayLength);
            PexObserve.ValueForViewing("$New_containsAll", New_containsAll);

        }
    }
}

