        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            // an assertion using "Debug.Assert\(.*?\);" that  If return value is -1 then x should not be in the list.
            Debug.Assert(New_Ret != -1 ? arrList.Contains(x) : true);
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

           // an assertion using "Debug.Assert\(.*?\);" that If return value is -1 then x should not be in the list.
            Debug.Assert(New_Ret != -1 ? arrList.Contains(x) : true);
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_elementAtIndex = (int)(arrList[index]);
            int Old_arrListIndexOfElement = arrList.IndexOf(Old_elementAtIndex);
            int Old_arrListLastIndexOfElement = arrList.LastIndexOf(Old_elementAtIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfElement = arrList.IndexOf(Old_elementAtIndex);
            int New_arrListLastIndexOfElement = arrList.LastIndexOf(Old_elementAtIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_elementAtIndex", Old_elementAtIndex);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_element", Old_arrListIndexOfElement);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_element", New_arrListIndexOfElement);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_element", Old_arrListLastIndexOfElement);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_element", New_arrListLastIndexOfElement);

        }

        [PexMethod]
        public void PUT--------------------	    // This is a comment.
	    //if (New_Ret == false && Old_arrListLastIndexOfX >= -1) {}

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, index of x in old list is <= last possible index of x in new list
	    // This is a comment.
	    //if (New_Ret == true && Old_arrListIndexOfX <= New_arrListLastIndexOfX) {}

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new list count is same as old
	    // This is a comment.
	    //Debug.Assert(New_arrListCount == Old_arrListCount);
				
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ In new list, index of x is <= new possible index of x in old list
	    Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX && Old_arrListLastIndexOfX >= -1);
        }
