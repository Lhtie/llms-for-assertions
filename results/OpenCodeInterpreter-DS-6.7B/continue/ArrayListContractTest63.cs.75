//source/test/Coverage/ArrayList.Test/ArrayTestCov.cs
using PexAPIWrapper;

public class ArrayTestCov
{
    [PexMethod]
    public void Add(int x, ArrayList arrList)
    {
        arrList.Add(x);
        Assert.IsTrue(arrList.Contains(x));
    }


    [PexMethod]
    public void Remove(int x, ArrayList arrList)
    {
         arrList.Remove(x);
         Assert.IsFalse(arrList.Contains(x));
    }

    [PexMethod]
    public void Insert(int index, int x, ArrayList arrList)
    {
         arrList.Insert(index,x);
         Assert.AreEqual(x,arrList[index]);
    }

    [PexMethod]
    public void Get(int index, ArrayList arrList)
    {
         int x = arrList[index];
         Assert.AreEqual(x, arrList[index]);
    }

    [PexMethod]
    public void Set(int index, int x, ArrayList arrList)
    {
         arrList[index]=x;
         Assert.AreEqual(x, arrList[index]);
    }
   

    [PexMethod]
    public void Contains(int x, ArrayList arrList)
    {
        bool contains = arrList.Contains(x);
        if (contains)
            Assert.IsTrue(arrList.Contains(x));
        else
            Assert.IsFalse(arrList.Contains(x));    
    }
}

//source/test/Coverage/ArrayList.Test/CoverageTest.cs
﻿using Microsoft.Pex.Framework;
using NUnit.Framework;
using PexAPIWrapper;


namespace CoverageTest
{
    [TestFixture]
    public class CoverageTest
    {
        
        [PexMethod]
        public void AddPex(ArrayList arrlist, int x)
        {
            arrlist.Add(x);
            Assert.IsTrue(arrlist.Contains(x));
        }

        [PexMethod]
        public void RemovePex(ArrayList arrlist, int x)
        {
            if(arrlist.Contains(x)) {
                arrlist.Remove(x);
                Assert.IsFalse(arrlist.Contains(x));
            }
        }

        [PexMethod]
        public void InsertPex(ArrayList arrlist, int index, int x)
        {
        	arrlist.Insert(index, x);
            Assert.AreEqual(x, (int)arrlist[index]);
        }

        [PexMethod]
        public void GetPex(ArrayList arrlist, int index)
        {
        	int x = (int)arrlist[index];
            Assert.AreEqual(x, (int)arrlist[index]);
        }

        [PexMethod]
        public void SetPex(ArrayList arrlist, int index, int x)
        {
        	arrlist[index] = x; 
            Assert.AreEqual(x, (int)arrlist[index]);
         }


        [PexMethod]
        public void ContainsPex(ArrayList arrlist, int x)
        {
            bool contains = arrlist.Contains(x);
            if (contains)
                Assert.IsTrue(arrlist.Contains(x));
            else
                Assert.IsFalse(arrlist.Contains(x));
        }

    }
}

