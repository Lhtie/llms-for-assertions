﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListPexTest
    {
        [Test]
        public void TestArrayList()
        {
            ArrayList arrayList = new ArrayList();

            // Adding elements in ArrayList.
            arrayList.Add('A');
            arrayList.Add('B');
            arrayList.Add('C');

            // Testing Count Property 
            Console.WriteLine("Count: {0}", arrayList.Count);

            // Testing IndexOf Method 
            Console.WriteLine("IndexOf 'A': {0}", arrayList.IndexOf('A'));

            // Testing Contains Method
            Console.WriteLine("Contains 'A': {0}", arrayList.Contains('A') ? "Yes" : "No");

            // Testing Last IndexOf Method
            Console.WriteLine("Last IndexOf 'A': {0}", arrayList.LastIndexOf('A'));

            // Inserting an Element
            arrayList.Insert(3, 'D');

            // Testing new Count after insertion
            Console.WriteLine("New Count: {0}", arrayList.Count);

            // Testing get Property 
            Console.WriteLine("Get 3: {0}", arrayList[3]);

            // Removing an Element
            arrayList.Remove('B');

            // Testing new Count after removal
            Console.WriteLine("New Count after removal: {0}", arrayList.Count);

            // Testing Contains Method after removal
            Console.WriteLine("Contains 'B': {0}", arrayList.Contains('B') ? "Yes" : "No");
        }
    }
}

