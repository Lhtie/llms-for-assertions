            Debug.Assert(New_Ret >= 0 && New_Ret <= Old_arrListIndexOfX, string.Format(\"The return value {0} is out of bounds{1}", New_Ret));
------------------------------------------------------------	    Debug.Assert(New_Ret  >= Old_arrListIndexOfX);
----------------------------------------            Debug.Assert(((New_Ret >= 0) && (New_Ret <= Old_arrListIndexOfX)));
