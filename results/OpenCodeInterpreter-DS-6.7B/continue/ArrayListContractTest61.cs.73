//Project1/NUnitTest/ArrayList.Test/ArrayListTest.cs
﻿using NUnit.Framework;
using PexAPIWrapper;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [Order(1)]
        [Category("Add")]
        public void TestAdd()
        {
            ArrayList al = new ArrayList();
            al.Add(10);
            Assert.AreEqual(1, al.Count);
            Assert.That(al.Contains(10));
        }

        [Test]
        [Order(2)]
        [Category("Remove")]
        public void TestRemove()
        {
            ArrayList al = new ArrayList();
            al.Add(20);
            al.Remove(20);
            Assert.AreEqual(0, al.Count);
            Assert.That(!al.Contains(20));
        }

        [Test]
        [Order(3)]
        [Category("Insert")]
        public void TestInsert()
        {
            ArrayList al = new ArrayList();
            al.Add(30);
            al.Insert(0, 30);
            Assert.AreEqual(2, al.Count);
            Assert.That(al.Contains(30));
        }

        [Test]
        [Order(4)]
        [Category("Set")]
        public void TestSet()
        {
            ArrayList al = new ArrayList();
            al.Add(40);
            al[0] = 40;
            Assert.AreEqual(40, al[0]);
        }

        [Test]
        [Order(5)]
        [Category("Get")]
        public void TestGet()
        {
            ArrayList al = new ArrayList();
            al.Add(50);
            int val = (int)al[0];
            Assert.AreEqual(50, val);
        }

        [Test]
        [Order(6)]
        [Category("Contains")]
        public void TestContains()
        {
            ArrayList al = new ArrayList();
            al.Add(60);
            Assert.That(al.Contains(60));
            Assert.That(!al.Contains(70));
        }
    }
}

