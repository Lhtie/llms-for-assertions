namespace PexAPIWrapper
{
    //This is a wrapper class for the ArrayList class. The purpose of this class is to encapsulate the ArrayList class and provide a
    // set of methods that will be used in the Pex testing for the ArrayList.
    public class ArrayListTest
    {
        private ArrayList arrList = new ArrayList();

        //Method to add a value to the ArrayList using 
        //the Add method
        public void AddValue(int x)
        {
            arrList.Add(x);
        }

        //Method to remove a specified value from the ArrayList 
        //using the Remove method
        public void RemoveValue(int x)
        {
            arrList.Remove(x);
        }


        //Method to insert a specified value at a specified index 
        //inside the ArrayList using the Insert method
        public void InsertValAtIndex(int x, int index)
        {
            arrList.Insert(index, x);
        }


        //Method to set a value at a specified index inside the ArrayList
        //using the SetValue method.
        public void SetValueAtIndex(int x, int index)
        {
            arrList[index]=x;
        }


        //Method to get a value at a specified index inside the ArrayList
        //using the GetValue method.
        public int GetValueAtIndex(int index)
        {
            return (int)arrList[index];
        }


        //Method to check if a specified value is present in the ArrayList
        //using the Contains method.
        public bool ContainsValue(int x)
        {
            return arrList.Contains(x);
        }
    }
}

