using System;
using UnityEngine;

namespace UnityStandardAssets.ImageEffects
{
    [ExecuteInEditMode]
    [RequireComponent (typeof (Camera))]
    public class Vortex : ImageEffectBase
    {
        public Vector2 radius = new Vector2(0.4F,0.4F);
        public float angle = 50;
        public Vector2 center = new Vector2(0.5F, 0.5F);
        public ImageEffectBase.InterpolationBlendMode blendMode;
        
        // Vortex distortion requires a central axis of symmetry, and a radius to define its extent. 
        // The radius and center can be adjusted in the inspector to change the distortion.
    
        // This script should be attached to a camera to override the rendering of the camera.
        void OnRenderImage (RenderTexture source, RenderTexture destination)
        {
            ImageEffects.RenderDistortion (material, source, destination, angle, center, radius, blendMode, false);
        }
    }
}

