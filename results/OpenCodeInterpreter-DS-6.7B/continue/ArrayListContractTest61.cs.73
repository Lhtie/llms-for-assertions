using System;
using System.Text;
using System.Collections.Generic;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTesting
{
    [TestFixture]
    public class ArrayListTest
    {
        private ArrayList arrList;

        [SetUp]
        public void Init()
        {
            arrList = new ArrayList();
        }

        [Test]
        public void TestAdd()
        {
            arrList.Add(1);
            Assert.AreEqual(1, arrList.Count);
            Assert.IsTrue(arrList.Contains(1));
            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(0, arrList.LastIndexOf(1));
        }

        [Test]
        public void TestRemove()
        {
            arrList.Add(1);
            arrList.Remove(1);
            Assert.AreEqual(0, arrList.Count);
            Assert.IsFalse(arrList.Contains(1));
        }

        [Test]
        public void TestInsert()
        {
            arrList.Add(1);
            arrList.Insert(0, 2);
            Assert.AreEqual(2, arrList[0]);
            Assert.AreEqual(1, arrList[1]);
        }

        [Test]
        public void TestSet()
        {
            arrList.Add(1);
            arrList[0] = 2;
            Assert.AreEqual(2, arrList[0]);
        }

        [Test]
        public void TestGet()
        {
            arrList.Add(1);
            Assert.AreEqual(1, arrList[0]);
        }

        [Test]
        public void TestContains()
        {
            arrList.Add(1);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsFalse(arrList.Contains(2));
        }
    }
}

