}using System;
namespace PexAPIWrapper
{
    public class AssumePrecondition
    {
        public static void IsTrue(bool condition)
        {
            if (!condition)
            {
                throw new InvalidOperationException("Assume condition failed");
            }
        }
    }
}using System;

namespace PexAPIWrapper
{
    public class PexObserve
    {
        public static void ValueForViewing(string name, object value)
        {
            Console.WriteLine("{0}: {1}", name, value);
        }
    }
}﻿using System;
class Solution
{
    static void Main()
    {
        int n = int.Parse(Console.ReadLine());
        int[] arr = new int[n];
        for (int arr_i = 0; arr_i < n; arr_i++)
        {
            arr[arr_i] = int.Parse(Console.ReadLine());
        }
        int sum = 0;
        foreach (int num in arr)
        {
            sum += num;
        }
        Console.WriteLine(sum);
    }
}﻿using System;
class Solution
{
    static void Main()
    {
        int[][] arr = new int[6][];
        for (int arr_i = 0; arr_i < 6; arr_i++)
        {
            string[] arr_temp = Console.ReadLine().Split(' ');
            arr[arr_i] = Array.ConvertAll(arr_temp, Int32.Parse);
        }
        int maxSum = Int32.MinValue;
        for (int i = 0; i < 4; i++)
        {
            for (int j = 0; j < 4; j++)
            {
                int sum = arr[i][j] + arr[i][j + 1] + arr[i][j + 2]
                + arr[i + 1][j + 1]
                + arr[i + 2][j] + arr[i + 2][j + 1] + arr[i + 2][j + 2];
                if (sum > maxSum)
                {
                    maxSum = sum;
                }
            }
        }
        Console.WriteLine(maxSum);
    }
