            AssumePrecondition.IsTrue(Old_arrListCount - New_arrListCount == 1 && (New_arrListIndexOfY == -1 || New_arrListLastIndexOfY == -1));


        }

    }
}//Fibonacci/IFibonacciRepository.cs
﻿namespace Fibonacci
{
    public interface IFibonacciRepository
    {
        int[] GetFibonacciSeries(int n);
    }
}

//Fibonacci/FibonacciRepository.cs
﻿using Fibonacci;

public class FibonacciRepository : IFibonacciRepository
{
    public int[] GetFibonacciSeries(int n)
    {
        int[] fibArray = new int[n];
        fibArray[0] = 0;
        fibArray[1] = 1;
        for (int i = 2; i < n; i++)
        {
            fibArray[i] = fibArray[i - 1] + fibArray[i - 2];
        }
        return fibArray;
    }
}

