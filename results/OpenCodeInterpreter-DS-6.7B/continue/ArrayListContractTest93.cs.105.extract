----------------------------------------	    Debug.Assert(New_Ret >= 0 && New_arrListContainsX);
----------------------------------------            AssumePrecondition.IsTrue(New_Ret >= 0 || !New_arrListContainsX);         
        }

        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_IndexSum = 0;
            foreach (int x in arrList)
            {
                Old_IndexSum += arrList.IndexOf(x);
            }
            bool Old_arrListEqualsToList = arrList.SequenceEqual(arrList.ToList());

            arrList.Sort();

            int New_arrListCount = arrList.Count;
            int New_IndexSum = 0;
            foreach (int x in arrList)
            {
                New_IndexSum += arrList.IndexOf(x);
            }
            bool New_arrListEqualsToList = arrList.SequenceEqual(arrList.ToList());

            PexObserve.ValueForViewing("$Old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$New_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$Old_IndexSum", Old_IndexSum);
            PexObserve.ValueForViewing("$New_IndexSum", New_IndexSum);
            PexObserve.ValueForViewing("$Old_arrList_equals_to_List", Old_arrListEqualsToList);
            PexObserve.ValueForViewing("$New_arrList_equals_to_List", New_arrListEqualsToList);

            //Assert.IsFalse(Old_IndexSum - New_IndexSum < 0);
        }
    }	
}

