﻿using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;

/*
 * This script allows for more dynamic character controls. It can be attached to any object (preferably the player character) and provides methods to move and rotate the character.
 * A CharacterController component is required on the attached object. 
 * It can also be used to add jumping and other character behaviors, if necessary.
 */

[RequireComponent(typeof(CharacterController))]
public class CharacterBehaviour : MonoBehaviour
{
    // Movement Speed
    public float speed = 3.0f;
    // Rotation Speed
    public float rotateSpeed = 3.0f;
    // Jumping Speed
    public float jumpSpeed = 2.0f;
    // Gravity
    public float gravity = -9.8f;

    // Character Controller
    private CharacterController _characterController;

    // Movement Direction
    private Vector3 _moveDirection = Vector3.zero;

    // Start is called before the first frame update
    void Start()
    {
        _characterController = GetComponent<CharacterController>();
    }

    // Update is called once per frame
    void Update()
    {
        if (_characterController.isGrounded)
        {
            // We are grounded, so can jump
            if (Input.GetButton("Jump"))
            {
                _moveDirection.y = jumpSpeed;
            }
            else
            {
                _moveDirection.y = 0;
            }
        }
        else
        {
            // Add gravity
            _moveDirection.y += gravity * Time.deltaTime;
        }

        // Move the controller
        _characterController.Move(_moveDirection * Time.deltaTime);

        // Rotate around Y - Horizontal Rotation
        transform.Rotate(0, Input.GetAxis("Horizontal") * rotateSpeed, 0);

        // Move the character frame-by-frame
        _characterController.SimpleMove(transform.forward * Input.GetAxis("Vertical") * speed);
    }
}

