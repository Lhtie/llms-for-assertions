class Solution:
    def toHex(self, num: int) -> str:
        if num == 0:
            return '0'
        n = 0
        res = ''
        while n < 8 and num:
            res = hex(num&15).replace("x", "") + res
            num = num >> 4
            n += 1
        return res.strip("0")
