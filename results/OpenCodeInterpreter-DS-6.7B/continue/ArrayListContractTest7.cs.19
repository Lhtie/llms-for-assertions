            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListIndexOfX);
    
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x is geq an index of x in new array list 
            Assert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);
    
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x is geq zero
            Assert.GreaterOrEqual(New_arrListLastIndexOfX, 0);
    
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old array list should be less than zero
            Assert.IsTrue(Old_arrListIndexOfX < 0);
    
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in new array list should be less than zero
            Assert.IsTrue(New_arrListIndexOfX < 0);
    
	    // an assertion using "Debug.Assert\(.*?\);" that contains does not increase in old array list
            Assert.IsTrue(Old_arrListContainsX && !New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that contains does not decrease in new array list
            Assert.IsTrue(New_arrListContainsX && !Old_arrListContainsX);
        }
    }
}

