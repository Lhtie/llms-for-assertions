//Assets/Scripts/GameManager.cs
using UnityEngine;
using Makoto4;

public class GameManager : MonoBehaviour
{
    public Vars vars;
    
    private const string SaveFilePath = "/save.dat";
    
    public void SaveGame()
    {
        BinarySerialization.SerializeBinaryFile(Application.persistentDataPath + SaveFilePath, vars);
    }

    public void LoadGame()
    {
        vars = BinarySerialization.DeserializeBinaryFile<Vars>(Application.persistentDataPath + SaveFilePath);
    }
}

//Assets/Scripts/UI/Scores.cs
using UnityEngine;
using UnityEngine.UI;
using Makoto4;

public class Scores : MonoBehaviour
{
    public Text scoreText;
    public Text highScoreText;

    private const string HighScoreKey = "HighScore";
    
    private int score;
    public int Score
    {
        get => score;
        set
        {
            score = value;
            scoreText.text = "SCORE: " + score;
        }
    }

    public int HighScore
    {
        get => PlayerPrefs.GetInt(HighScoreKey, 0);
        private set
        {
            PlayerPrefs.SetInt(HighScoreKey, value);
            highScoreText.text = "HIGH SCORE: " + value;
        }
    }

    public void UpdateHighScore()
    {
        if (score > HighScore)
            HighScore = score;
    }
