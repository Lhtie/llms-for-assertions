            // and it's before the index
            Debug.Assert(Old_arrListLastIndexOfX <= Old_index && Old_arrListLastIndexOfX != index - 1 &&
            New_arrListIndexOfX == index && New_arrListContainsX == true);
        }
    }
}
```

