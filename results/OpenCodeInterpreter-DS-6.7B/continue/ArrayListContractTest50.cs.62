  arrList.Remove(x);

  // Store post-conditions
  var New_arrListCount = arrList.Count;
  var New_arrListIndexOfX = arrList.IndexOf(x);
  var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
  bool New_arrListContainsX = arrList.Contains(x);

  // Check contracts
  Assert.IsTrue(Old_arrListCount >= New_arrListCount);
  Assert.IsTrue(New_arrListCount >= 0 && New_arrListCount <= Old_arrListCount);

  Assert.AreEqual(New_arrListIndexOfX, -1);
  Assert.IsTrue(New_arrListIndexOfX < Old_arrListCount);

  Assert.AreEqual(New_arrListLastIndexOfX, -1);
  Assert.IsTrue(New_arrListLastIndexOfX < Old_arrListCount);

  Assert.IsFalse(New_arrListContainsX);
  Assert.IsTrue(Old_arrListContainsX);
}

