//Pex/PexTest/ArrayListTest/ArrayListTest.cs
﻿
using System;
using System.Collections;
using NUnit.Framework;
using ArrayList;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        

        [Test]
        public void TestAdd()
        {
            ArrayList array = new ArrayList();
            int ret = array.Add(10);
            Assert.AreEqual(ret, 1);
            Assert.AreEqual(array[0], 10);
        }

        [Test]
        public void TestInsert()
        {
            ArrayList array = new ArrayList();
            array.Add(10);
            array.Add(20);
            array.Insert(1, 15);
            Assert.AreEqual(array[1], 15);
            Assert.AreEqual(array[2], 20);
        }

        [Test]
        public void TestRemove()
        {
            ArrayList array = new ArrayList();
            array.Add(10);
            array.Add(20);
            array.Remove(10);
            Assert.AreEqual(array.Count, 1);
            Assert.AreEqual(array[0], 20);
        }
        
