// PUT_AddContractTest
// Input
// - Instance Fields
//   * "arrList" ArrayList
//   * "x" int
//
// Precondition
// - True
//
// Method Call
// - arrList.Add(x);
//
// Post
// - 

void PUT_AddContract(ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    // Store pre-conditions
    var Old_arrListCount = arrList.Count;
    var Old_x = x;
    var Old_arrListIndexOfX = arrList.IndexOf(x);
    var Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Add(x);

    // Store post-conditions
    var New_arrListCount = arrList.Count;
    var New_arrListIndexOfX = arrList.IndexOf(x);
    var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    // Check contracts
    Assert.IsTrue(Old_arrListCount <= New_arrListCount);
    Assert.AreEqual(New_arrListCount, Old_arrListCount + 1);

    Assert.AreEqual(New_arrListIndexOfX, Old_arrListCount);

    Assert.IsTrue(New_arrListIndexOfX >= 0);
    Assert.IsTrue(Old_arrListIndexOfX == -1);

    Assert.AreEqual(New_arrListLastIndexOfX, Old_arrListCount);
    Assert.IsTrue(New_arrListLastIndexOfX >= 0);
    Assert.IsTrue(Old_arrListLastIndexOfX == -1);

    Assert.IsTrue(New_arrListContainsX);
    Assert.IsTrue(Old_arrListContainsX);
}

