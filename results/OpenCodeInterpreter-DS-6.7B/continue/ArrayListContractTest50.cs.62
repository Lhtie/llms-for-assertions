//ContractTest.cs
using NUnit.Framework;
using ArrayList;

[TestFixture]
public class ContractTest
{
    [Test]
    public void AddTest()
    {
        ArrayList<int> arrList = new ArrayList<int>();
        int x = 5;

        int Old_arrListCount = arrList.Count;
        int New_Ret = arrList.Add(x);
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
        Assert.AreEqual(x, New_Ret);
    }

    [Test]
    public void RemoveTest()
    {
        ArrayList<int> arrList = new ArrayList<int> { 1, 2, 3, 4, 5 };
        int x = 3;

        int Old_arrListCount = arrList.Count;
        arrList.Remove(x);
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
    }

    [Test]
    public void InsertTest()
    {
        ArrayList<int> arrList = new ArrayList<int> { 1, 2, 3, 4, 5 };
        int x = 3;
        int index = 2;

        int Old_arrListCount = arrList.Count;
        arrList.Insert(index, x);
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    }

    [Test]
    public void SetTest()
    {
        ArrayList<int> arrList = new ArrayList<int> { 1, 2, 3, 4, 5 };
        int x = 3;
        int index = 2;

        int Old_arrListCount = arrList.Count;
        arrList[index] = x;
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount, New_arrListCount);
    }

    [Test]
    public void GetTest()
    {
        ArrayList<int> arrList = new ArrayList<int> { 1, 2, 3, 4, 5 };
        int index = 2;

        int Old_arrListCount = arrList.Count;
        int New_Ret = arrList[index];
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount, New_arrListCount);
    }

    [Test]
    public void ContainsTest()
    {
        ArrayList<int> arrList = new ArrayList<int> { 1, 2, 3, 4, 5 };
        int x = 3;

        int Old_arrListCount = arrList.Count;
        bool New_Ret = arrList.Contains(x);
        int New_arrListCount = arrList.Count;

        Assert.AreEqual(Old_arrListCount, New_arrListCount);
    }
}
