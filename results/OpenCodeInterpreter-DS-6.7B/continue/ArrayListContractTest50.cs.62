﻿using System.Net;
using System.Threading.Tasks;

namespace PactNet.Specification.Tests.SampleHttp
{
    public interface ISampleHttpService
    {
        Task<HttpStatusCode> SendGetRequestAsync(string url);

        HttpStatusCode SendGetRequest(string url);
    }

    public class SampleHttpService : ISampleHttpService
    {
        public async Task<HttpStatusCode> SendGetRequestAsync(string url)
        {
            using (var client = new HttpClient())
            {
                var response = await client.GetAsync(url);
                return response.StatusCode;
            }
        }

        public HttpStatusCode SendGetRequest(string url)
        {
            using (var client = new HttpClient())
            {
                var response = client.GetAsync(url).Result;
                return response.StatusCode;
            }
        }
    }
}

