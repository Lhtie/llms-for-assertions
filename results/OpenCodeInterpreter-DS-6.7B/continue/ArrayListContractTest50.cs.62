//ArrayList.Test/ArrayListTest.cs
﻿using System;
using MathLibrary.Test;
using PexAPIWrapper;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    internal class ArrayListTest
    {
        // This method provides an array to Pex to use as input.
        [DataInput]
        public static int[] GetArray(int length)
        {
            int[] retval = new int[length];
            for (int i = 0; i < length; i++)
            {
                // initialize values 0, 2, 4, ... to the list
                retval[i] = (i * 2);
            }
            return retval;
        }

        [PexMethod]
        public void Test(int[] arr, int i)
        {
            int oldLength = arr.Length;
            int oldItemCount = 0;
            foreach (int item in arr)
            {
                oldItemCount += item;
            }

            // Call the Add method
            arr[i] = i * 2;

            // Get the new length and item count
            int newLength = arr.Length;
            int newItemCount = 0;
            foreach (int item in arr)
            {
                newItemCount += item;
            }

            //Check that the length preserved
            Assert.AreEqual(oldLength, newLength);

            //Check that the item count increased
            Assert.AreEqual(newItemCount, oldItemCount + i);

            //Check that the item count increased
            Assert.AreEqual(newItemCount, oldItemCount + i);
        }
    }
}

