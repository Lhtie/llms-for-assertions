    [TestFixture, PexClass(typeof(PexAPIWrapper.PexAPIWrapper))]
    public partial class ArrayList_EmptyCollectionTest
    {
        [PexMethod]
  public void Add_Empty()
  {
    ArrayList alist = new ArrayList();
    // Add some elements to the list
    int result = alist.Add(5);
    Assert.AreEqual(1, result);
    Assert.AreEqual(1, alist.Count);
    Assert.AreEqual(5, alist[0]);
    
    // Add to the empty list
    result = alist.Add(6);
    Assert.AreEqual(2, result);
    Assert.AreEqual(2, alist.Count);
    Assert.AreEqual(6, alist[1]);
    
    // Verify empty
    Assert.AreEqual(0, alist.IndexOf(4));  
  }
    }
}

