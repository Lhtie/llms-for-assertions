            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_value_at_index", Old_arrListValueAtIndex);
            PexObserve.ValueForViewing("$old_arrList_Contains", Old_arrListContainsValueAtIndex);
            PexObserve.ValueForViewing("$new_arrList_Contains", New_arrListContainsValueAtIndex);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear--------------------	    // and the last occurrence of x is at position New_Ret. If the return value is negative, x is not in list. 

	    int[] oldArray = new int[arrList.Count];
	    for (int i = 0; i < arrList.Count; i++)
	    {
		oldArray[i] = (int)arrList[i];
	    }

	    if (New_Ret >= 0)
	    {
		Assert.That(arrList.Contains(x));
		Assert.True(New_Ret == Old_arrListLastIndexOfX);
	    }
	    else
	    {
		 Assert.IsFalse(arrList.Contains(x));
	    }
		
        }
    }

}

//ListaDeExercicio05/12.ListaGenerica/Tests/ArrayList.Test/ArrayListTest.cs
using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListTest
    {
        private ArrayList arrList;

        
        [SetUp]
        public void Setup()
        {
            arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(15);
            arrList.Add(20);
            arrList.Add(25);
        }

        [Test]
        public void Add()
        {
            int ret = arrList.Add(30);

            Assert.AreEqual(4, ret);
            Assert.AreEqual(30, arrList[3]);
        }

        [Test]
        public void Remove()
        {
            arrList.Remove(20);

            Assert.IsFalse(arrList.Contains(20));
            Assert.AreEqual(-1, arrList.IndexOf(20));
        }

        [Test]
        public void Insert()
        {
            arrList.Insert(1, 30);

            Assert.AreEqual(30, arrList[1]);
        }

        [Test]
        public void Set()
        {
            arrList[1] = 40;

            Assert.AreEqual(40, arrList[1]);
        }

        [Test]
        public void Get()
        {
            int val = (int)arrList[1];

            Assert.AreEqual(15, val);
        }

        [Test]
        public void Contains()
        {
            bool ret = arrList.Contains(20);

            Assert.IsTrue(ret);
        }

        [Test]
        public void IndexOf()
        {
            int ret = arrList.IndexOf(20);

            Assert.AreEqual(2, ret);
        }

        [Test]
        public void LastIndexOf()
        {
            int ret = arrList.LastIndexOf(20);

            Assert.AreEqual(2, ret);
        }
    }
}

