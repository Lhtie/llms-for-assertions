        {
            var list = new ArrayList<int>();
            Assert.AreEqual(0, list.Add(1));
            Assert.AreEqual(1, list[0]);
        }

        [Test]
        public void TestRemove()
        {
            var list = new ArrayList<int>();
            list.Add(1);
            list.Remove(1);
            Assert.AreEqual(0, list.Count);
        }

        [Test]
        public void TestInsert()
        {
            var list = new ArrayList<int>();
            list.Add(1);
            list.Insert(0, 2);
            Assert.AreEqual(2, list[0]);
        }

        [Test]
        public void TestSet()
        {
            var list = new ArrayList<int>();
            list.Add(1);
            list[0] = 2;
            Assert.AreEqual(2, list[0]);
        }--------------------