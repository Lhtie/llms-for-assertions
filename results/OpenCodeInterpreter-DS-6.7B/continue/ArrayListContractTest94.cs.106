            // and it is located at New_arrListIndexOf_x
            // and x is the same as the item at Array[New_arrListLastIndexOf_x]
            // and if the return value is -1, x is not in the old arraylist
            int i = New_arrListIndexOfX; // new index value

            while (i >= 0)
            {
                System.Diagnostics.Debug.Assert(x == (int)(arrList[i]), "x is not the item at Array[New_arrListLastIndexOf_x]");
                i = arrList.LastIndexOf(x, i - 1);
            }

        }
    }
}

