```csharp
namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        [TestMethod]
        [HostType("Moles")]
        [PexMethod(Action = PexMethodCategory.AllMembers, ExpectedException = typeof(ArgumentException))]
        [PexAllowedException(typeof(InvalidOperationException), "EnsureCapacity can fail in an InvalidOperationException.")]
        public void System_Object_EnsureCapacity_ArgContract([PexAssumeNotNull] TestClass test, [PexInSource("1, 2, 3, 'one', 'two', 'three'")] int value1)
        {
            System.Collections.ArrayList list = new System.Collections.ArrayList();
            list.Add(value1.ToString());
            list.TrimToSize();
            list.EnsureCapacity(test);
            list.EnsureCapacity(-10); // expected to throw ArgumentException
            list.EnsureCapacity(int.MaxValue); // expected to throw ArgumentException
            // etc.
        }

        [TestMethod]
        [HostType("Moles")]
        [PexMethod(Action = PexAction.NoOp, ExpectedException = typeof(ArgumentOutOfRangeException))]
        [PexAll--------------------	    try
            {
		Debug.Assert(New_Ret == 0 || New_Ret >= 1);
	    }
            catch (Exception ex)
            {
		throw new Fail("Failure with the array list count value : " + ex.Message);
	    }
        }
    }
}
