public class Calculator
{
    internal static bool IsUserAuthenticated(User user)
    {
        // This is a stub
        throw new NotImplementedException("IsUserAuthenticated feature not implemented yet!");
    }

    public static double calculate(int num1, int num2, char operand)
    {
        double result = 0;
        switch (operand)
        {
            case '+':
                result = num1 + num2;
                break;
            case '-':
                result = num1 - num2;
                break;
            case '*':
                result = num1 * num2;
                break;
            case '/':
                if (num2 != 0)
                    result = (double) num1 / num2;
                else
                    throw new DivideByZeroException("Division by 0 is not allowed!");
                break;
            default:
                throw new ArgumentException("Invalid operand!");
        }
        return result;
    }
}

