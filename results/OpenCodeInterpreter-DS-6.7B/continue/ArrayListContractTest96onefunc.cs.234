#region CodeContracts_Manual_UnitTest_Example.cs 


#region CodeContracts Contract Test Example


namespace CodeContracts.Test
{
    [TestClass]
    public class ArrayListTests
    {
        [TestMethod]
        public void CountPropertyContractTest()
        {
            // Arrange
            ArrayList arrList = new ArrayList();

            // Act
            int New_Ret = arrList.Count;

            // Assert
            Assert.IsTrue(New_Ret >= 0, "@@@ count value cannot be less than zero");

            int count = arrList.Count;
            Assert.AreEqual(New_Ret, count, "@@@ count value of array is either 0 or greater than or equal to one");
        }
    }
}

#endregion

#endregion

#region NakedObjects_Contract_Example_Test.cs

#region Naked Test Object Contract Example


using NakedFunctions.Test.Models;

namespace NakedFunctions.Test
{
    [TestClass]
    public class OrderLineTests
    {
        [TestMethod]
        public void VoidMethodContractTest()
        {
            // Arrange
            Order order = new Order();
            OrderLine orderLine = new OrderLine();

            // Assume precondition
            Assume.True(0 != order.Id);

            // Act
            order.AddOrderLine(orderLine);

            // Assert
            Assert.AreSame(order, orderLine.Order); // Invariants specified in contract
            Assert.IsTrue(order.GetOrderLines().Contains(orderLine)); // Invariants specified in contract
        }
    }
}

#endregion

