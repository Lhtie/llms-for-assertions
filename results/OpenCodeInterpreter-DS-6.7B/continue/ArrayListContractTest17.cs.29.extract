------------------------------------------------------------	    // Note: 
	    //
	    // This is a contract condition that requires the ArrayList class to maintain the 
	    // “order” of objects as they were added, and not change the order of objects that 
	    // have been removed. The class must "preserve" the order of objects in the array. 
	    // In other words the last position of an object x in the old arraylist should be 
	    // the same or greater than the last position of object x in the new arraylist. 
	    //
	    Debug.Assert(Old_arrListLastIndexOfX >= New_arrListLastIndexOfX);
----------------------------------------            Debug.Assert((Old_arrListLastIndexOfX >= New_arrListLastIndexOfX) == true);
--------------------            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListIndexOfX);
----------------------------------------            Debug.Assert(Old_arrListLastIndexOfX >= New_arrListLastIndexOfX);
