So I am giving you that test as an example:

```csharp
[TestMethod]
[TestCategory("ArrayList Tests")]
public void ArrayList_Remove_Test()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    arrList.Add(1);
    arrList.Add(2);
    arrList.Add(3);
    int initialCount = arrList.Count;

    // Act
    bool result = arrList.Remove(2);

    // Assert
    Assert.IsTrue(result);
    Assert.AreEqual(initialCount - 1, arrList.Count);
    Assert.IsFalse(arrList.Contains(2));
}
```

