        private static bool HaveSameElements(ArrayList x, ArrayList y)
        {
            if (x == y) return true; // reference-equality optimization
            if (x.Count != y.Count) return false;
            for (int i = 0; i < x.Count; i++)
            {
                if (!x[i].Equals(y[i])) return false;
            }
            return true;
        }
    }
}
