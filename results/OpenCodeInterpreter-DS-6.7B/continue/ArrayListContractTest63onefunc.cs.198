using System.Collections.Generic;
using TileData;

public class Map
{
    private TileData[,] tiles;

    public Map(List<TileData> tileDataList)
    {
        this.tiles = new TileData[10, 10];

        foreach (var tile in tileDataList)
        {
            this.tiles[tile.getX(), tile.getY()] = tile;
        }
    }

    public TileData getTileAt(int x, int y)
    {
        if(x < 0 || x >= 10 || y < 0 || y >= 10)
        {
            return null;
        }
        
        return this.tiles[x, y];
    }
}

