            // this will fail if last position of x in old list is < -1
            if(New_Ret == false) { AssumePrecondition.IsNotNull(arrList.ToArray()); AssumePrecondition.IsTrue(Old_arrListLastIndexOfX >= -1); }
            else
            {
                AssumePrecondition.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
                AssumePrecondition.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            }
        }

        [PexMethod(Exclude=Exclusions.ActiveIssues)]
        public bool ContainsContract([PexAssumeUnderTest]ArrayList arrList, object x)
        {
            AssumePrecondition.IsNotNull(arrList);

            // save the old state of the ArrayList
            ArrayList oldList = new ArrayList(arrList);

            // invoke the method under test
            bool result = arrList.Contains(x);

            // check if the list has changed
            if (arrList != oldList)
            {
                // verify that ArrayList.Contains does not modify its argument
                AssumePrecondition.AreEqual(arrList, oldList);
            }

            // return the result
            return result;
        }

        static public void Main()
        {
            PexRunner.Run(typeof(ArrayListContractTest));
        }
    }
}

//Test/ArrayListContractTest.cs
﻿//-----------------------------------------------------------------------
// <copyright file="ArrayListContractTest.cs" company="Microsoft">
