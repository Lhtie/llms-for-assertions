//-----------------------------------------------------------------------

namespace ArrayList.Test
{
    using System;
    using System.Collections;
    using Microsoft.Pex.Framework;
    using ArrayList = System.Collections.ArrayList;

    public partial class ArrayListContractTest
    {
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, last position of x in old list is >= -1
            // this will fail if last position of x in old list is < -1
            if(New_Ret == false) { AssumePrecondition.IsNotNull(arrList.ToArray()); AssumePrecondition.IsTrue(Old_arrListLastIndexOfX >= -1); }
            else
            {
                AssumePrecondition.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
                AssumePrecondition.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            }
        }

        [PexMethod(Exclude=Exclusions.ActiveIssues)]
        public bool Cont--------------------	    Debug.Assert(Old_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, index of x in old list is >= -1
	    Debug.Assert(Old_arrListIndexOfX == -1 || New_arrListIndexOfX == -1 || New_arrListIndexOfX <= Old_arrListIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, last position of x in new list is <= new list count
	    Debug.Assert(New_Ret == false || New_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX <= New_arrListCount);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, index of x in new list is <= new list count
	    Debug.Assert(New_Ret == false || New_arrListIndexOfX == -1 || New_arrListIndexOfX <= New_arrListCount);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, count of new list >= count of old list -1
	    Debug.Assert(New_Ret == false || New_arrListCount >= (Old_arrListCount - 1));
        }
    }
}

```

The PexAssumeUnderTest attribute is used to indicate that an ArrayList represents the ArrayList with the under-testing method, and the integer represents a test value for the operation to be conducted.

The PexObserve.ValueForViewing method is used to output the values of the list counts and indices during the operation execution, which assists in troubleshooting.

Assertions are used to validate the behaviour of the operation after its execution. The first line asserts that if the return value is false, then the position of the last occurrence of "x" in the old list is -1 (indicating "x" does not exist in the list), or that position in the old list is less than or equal than the in the new list (-1, if "x" does not exist in the new list); similarly for other assertions. 

In conclusion, the above Pex code contributes to conducting rigorous testing on ArrayList class by examining the behaviour of the Contains method after its execution. The test utilises arrays as a medium to assert and examine the ArrayList class and its operation in more efficient way. ArrayList (List of T) is an alternative to the standard List class provided in the .NET Framework. It performs like an array, but allows objects to be dynamically added and removed. When needing to create a List, you can use either an ArrayList or List. However, ArrayList class can be more performant and is a good choice when you need to change List, especially when frequent insertions and deletions are needed. 

