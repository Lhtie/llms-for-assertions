            }
            else
            {
                PexObserve.ValueForViewing("$New_Ret", New_Ret);
                PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            }

	    // an assertion using "Debug.Assert(.*?);" that @@@ if the return value is true, the list count should be equal to old list's count, and the index of x in new list is greater than old index of x.
            AssumeProperty.For(arrList, o => o.Count, Old_arrListCount);
            AssumeProperty.For(arrList, o => o.IndexOf(x), Old_arrListIndexOfX);
            AssumeProperty.For(arrList, o => o.LastIndexOf(x), Old_arrListLastIndexOfX);
            AssumeProperty.For(arrList, o => o.Contains(x), New_Ret);
        }
    }
}
```

### <a name="dealing-with-multiple-return-values-from-methods"></a>在方法中处理多个返回值

测试方法中的一些方法返回多个值时，通常可以通过使用结构体将多个值进行分组来处理这种情况。 使用这种方法时，在测试方法的参数部分只需要一个参数，并使用一个数组或列表来传入多个值。

**先决条件**

[X, Y] = Func(a, b)。 我们需要测试对 Func 的每种可能的组合

如果存在依赖顺序的话，则无法重写这个属性

假设你有一个方法 ```DivMod(int a, int b, out int result, out int remainder)```，你希望测试这个方法的所有可能的除法和模数的组合。

下面是可能的测试方法：

```csharp
[PexMethod]
[PexArgumentGenerator("ValueInt32", "value")]
public void TestDivMod_All(
    [PexAssumeUnderTest] MyMath math,
    [PexArgValue(1)] int a,
    [PexArgValue(1)] int b,
    [PexArgValue(0)] int expectedResult,
    [PexArgValue(0)] int expectedRemainder)
{
    // Arrange
    int result, remainder;

    // Act
    math.DivMod(a, b, out result, out remainder);

    // Assert
    PexObserve.ValueForViewing("result", result);
    PexObserve.ValueForViewing("remainder", remainder);
    Assert.AreEqual(expectedResult, result);
    Assert.AreEqual(expectedRemainder, remainder);
}
```

在这里，```PexArgValue``` 是我们用于提供参数值的特性。 对于 ```int``` 类型的参数，可以使用这个特性，并对每个参数指定一个值。 这将自动生成测试方法的所有可能排列组合。

如果你的方法返回多个结构体实例或类似，根据你使用的编程语言，可以将多个返回值拆分或结构化到单个测试方法参数中，或者使用一个数组列表返回值。

**注意** 对于具有多个参数的方法，Pex将尝试将每个参数组合为测试方法的单个实例。 根据此组合的数量，测试方法的总数可能非常大。

## <a name="in-summary"></a>总结

为了使你的自动化测试尽可能健壮，你应该尽可能全面地测试代码，并确保任何测试方法中的预条件和假设都是基于尽可能少的假设。 对代码的行为进行假设可能会引入复杂性，并使测试变得不那么强大。 始终避免测试代码的任何部分（特定情况、错误处理路径等），除非你明确知道这一点。

请记住，测试应该是白盒（关注内部的），如果你正在测试黑盒�--------------------            if (New_Ret == false)
            {
                // the code path has been reported as an error
                Debug.AssertIf(New_arrListLastIndexOfX >= -1, "The If condition was not met: If the return value is false, last position of x in old list is >= -1");
                return;
            }
        }
    }
}
```

### <a name="parameterized-unit-tests"></a>Paraméteres unit tests

Az paraméteres unit tests lehetővé teszik, hogy a tesztelni kívánt rendellenes kódokat megváltoztassák k�l�n paraméterekkel. A Visual Studio paraméteres unit testing szolgáltatásai lehetővé teszik a tesztelési adatok paraméterezését. Egyes tesztkészletekben elérhető tesztfel�letek olyan paramétereket tartalmaznak, amelyek a MSTest által támogatott [DataRow](https://docs.microsoft.com/visualstudio/test/using-the-mstest-framework-with-unit-tests?view=vs-2019#data-row-attribute) attrib�tummal bírálódnak le a [DataTestMethod](https://docs.microsoft.com/visualstudio/test/using-the-mstest-framework-with-unit-tests?view=vs-2019#datatestmethod-attribute) attrib�tummal.

Az ArrayList Contract Testek paraméteres verziói a k�vetkezőképpen nézhetnek kinézni:

```csharp
using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Collections;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        [DataTestMethod]
        [DataRow(1)]
        [DataRow(2)]
        [DataRow(3)]
        public void PUT_ContainsContract(int x)
        {
            // Arrange
            ArrayList arrList = new ArrayList {1, 2, 3};

            // Act
            bool result = arrList.Contains(x);

            // Assert
            Assert.IsTrue(result);
        }
    }
}
```

Jelen esetben az adatok paramétereként vannak megadva a teszt metódusának átmegadásával, és az ArrayList elemét tesztelj�k. A teszt kimeneti értéke ellenőrzhető a megadott korai tesztben.

