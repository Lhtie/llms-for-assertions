}public struct PexAssumeUnderTest
{
    public Type UnderTestType { get; internal set; }
    public object UnderTestInstance { get; internal set; }

    public PexAssumeUnderTest(Type underTestType, object underTestInstance)
    {
        UnderTestType = underTestType;
        UnderTestInstance = underTestInstance;
    }

    public static PexAssumeUnderTest Create<T>(T underTestInstance) where T : class
    {
        return new PexAssumeUnderTest(typeof(T), underTestInstance);
    }
}public enum PexCombinatorialTestBoundaryType
{
    None,
    Inclusive,
    Exclusive
}//ContractTest/TestHelper/Program.cs
﻿using System;

namespace TestHelper
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Hello World!");
        }
    }
}

//ContractTest/ContractTest/Product.cs
﻿using System;
using System.Diagnostics.Contracts;
using TestHelper;

public class Product
{
    public int Multiply(int x, int y)
    {
        Contract.Requires<ArgumentNullException>(x != 0);
        Contract.Requires<ArgumentNullException>(y != 0);
        Contract.Ensures(Contract.Result<int>() == x * y);

        return x * y;
    }

    static void Main(string[] args)
    {
        var p = new Product();
        Console.WriteLine(p.Multiply(3, 5));
    }
}

//ContractTest/ContractTest/ProductTest.cs
using Microsoft.VisualStudio.TestTools.UnitTesting;
using TestHelper;

namespace TestProduct
{
    [TestClass]
    public class ProductTest
    {
        [TestMethod]
        public void TestMethod1()
        {
            Product product = new Product();
            int result = product.Multiply(5, 4);
            Assert.AreEqual(20, result);
        }
    }
