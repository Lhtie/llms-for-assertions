```csharp
{
    public void Remove([PexAssumeUnderTest] ArrayList al, object obj)
    {
        int oldCount = al.Count;
        al.Remove(obj);
        bool removed = oldCount > al.Count;

        Assume.True(removed); // Contract condition
    }
}
