	    // if it can find the integer 2, it will also check if the last occurrence of 2 is equal to or smaller than the return value of the IndexOf method.
            Debug.Assert((New_Ret >= 0) ? Old_arrListLastIndexOfX <= New_Ret : New_Ret == 0, "The last index of x in the old array is smaller than or equal to the new array.");
            Debug.Assert(New_arrListContainsX, "The new array contains the value x.");
            Debug.Assert(Old_arrListContainsX, "The old array contains the value x.");
            Debug.Assert(Old_arrListCount == New_arrListCount, "The count of the old and new array is the same.");
        }
