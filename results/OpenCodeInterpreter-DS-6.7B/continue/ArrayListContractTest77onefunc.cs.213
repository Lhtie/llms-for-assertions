using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListIndexerTest 
    {
        // A test for indexer get
        [TestMethod]
        public void GetIndexTest()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add("two");
            arrayList.Add(3.0);

            object test1 = arrayList[0];
            Assert.AreEqual(1, test1);

            string test2 = (string)arrayList[1];
            Assert.AreEqual("two", test2);

            double test3 = (double)arrayList[2];
            Assert.AreEqual(3.0, test3);
        }

        // A test for indexer set
        [TestMethod]
        public void SetIndexTest()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(1);
            arrayList.Add("two");
            arrayList.Add(3.0);

            arrayList[0] = 2;
            Assert.AreEqual(2, arrayList[0]);

            arrayList[1] = "test";
            Assert.AreEqual("test", arrayList[1]);

            arrayList[2] = 4.0;
            Assert.AreEqual(4.0, arrayList[2]);
        }

        // A test for indexer get with invalid index
        [TestMethod]
        [ExpectedException(typeof(ArgumentOutOfRangeException))]
        public void GetInvalidIndexTest()
        {
            ArrayList arrayList = new ArrayList();
            arrayList[0] = 1;
        }

        // A test for indexer set with invalid index
        [TestMethod]
        [ExpectedException(typeof(ArgumentOutOfRangeException))]
        public void SetInvalidIndexTest()
        {
            ArrayList arrayList = new ArrayList();
            ArrayList arrayList1 = arrayList;
            arrayList1[0] = 1;
        }
    }
}

