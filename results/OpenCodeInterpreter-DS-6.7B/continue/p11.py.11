```python
def transfer(frm, to, amnt):
    assert sum(account.money for account in frm.accounts) >= amnt , \
        f"Total amount in accounts of {frm.name} is less than {amnt}"
    
    for account in frm.accounts:
        if account.money >= amnt:
            account.money -= amnt
            to.accounts[0].money += amnt
            break
    return f"{amnt} money has been transfered from {frm.name} to {to.name}"

def sum_accounts(person):
