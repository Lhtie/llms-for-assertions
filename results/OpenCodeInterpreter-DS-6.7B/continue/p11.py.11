print(person1.accounts[0].money, person2.accounts[0].money)

transfer(person1, person2, 150)
print(person1.accounts[0].money, person2.accounts[0].money)
# should print assertion error because total balance of person1's accounts is less than 150
transfer(person2, person1, 50)
print(person1.accounts[0].money, person2.accounts[0].money)
