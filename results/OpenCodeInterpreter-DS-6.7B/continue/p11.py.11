import math
import numpy as np

def find_square_root(num): 
    if num < 0:
        return "Invalid input"
    
    # Use binary search to find the square root
    low = 0
    high = num
    while low <= high:
        mid = (low + high) // 2
        if mid * mid == num:
            return mid
        if mid * mid < num:
            low = mid + 1
        else:
            high = mid - 1
    return high

def is_prime(num):
    if num <= 1:
        return False
    for i in range(2, int(math.sqrt(num)) + 1):
        if num % i == 0:
            return False
    return True

# Get the user inputs
input_num = int(input("Enter a number: "))

# Get the square root of the input number
result = find_square_root(input_num)

# Check if the result is a valid square root
if type(result) == str:
    print(f"The input {input_num} is not a valid square root number")
else:
    print(f"The square root of {input_num} is {result}")
    
# Check if the input number is a prime number
if is_prime(input_num):
    print(f"{input_num} is a prime number")
else:
    print(f"{input_num} is not a prime number")

