```python
# Solution

def transfer(frm, to, amnt):
    """ attempts to transfer "amnt" money from "frm" to "to" """
    
    # an assertion that  total balance of all "frm" accounts is not less than "amnt"
    assert sum(acc.money for acc in frm.accounts) >= amnt

    # TODO replace this with your solution

    # check if the account from which money is supposed to be transferred has enough balance
    if sum(acc.money for acc in frm.accounts) >= amnt:
        # iterate through frm's accounts
        for acc in frm.accounts:
            # if we have enough money, deduct it and break
            if acc.money >= amnt:
                acc.money -= amnt
                # add to to's accounts
                for to_acc in to.accounts:
                    to_acc.money += amnt
                print('Transfered ' + str(amnt) + ' from ' + frm.name + ' to ' + to.name)
                break
        
    else:
        print('Transaction Failed. Insufficient balance.')

