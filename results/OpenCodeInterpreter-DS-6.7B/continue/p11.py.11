print(f"Random Matrix:\n{matrix}")

# Calculate the sum of the elements in the matrix
mat_sum = np.sum(matrix)
print(f"Sum of the elements in the matrix: {mat_sum}")

# Calculate the average of the elements in the matrix
mat_mean = np.mean(matrix)
print(f"Average of the elements in the matrix: {mat_mean}")

# Calculate the standard deviation of the elements in the matrix
mat_std_dev = np.std(matrix)
print(f"Standard deviation of the elements in the matrix: {mat_std_dev}")

# Sort the matrix in ascending order
sorted_matrix = np.sort(matrix, axis=None)
print(f"Sorted Matrix:\n{sorted_matrix.reshape(rows, cols)}")

# Calculate the sum of the rows in the matrix
row_sum = np.sum(matrix, axis=1)
print(f"Sum of the rows in the matrix: {row_sum}")--------------------    if sum(account.money for account in frm.accounts) >= amnt:

