    transfer(peter, susan, 150)
except AssertionError as e:
    print(e)

# It should print the account balances (Peter's and Susan's) after each successful and unsuccessful attempt to transfer. If the transfer succeeded, it should be Peter's and Susan's account balance after the transfer
# If the transfer failed, it should not change the accounts' balances.
# in both scenarios (successful and unsuccessful), the funds in each account should be printed. if transfer succeeded, it means the amount was subtracted from Peter and added to Susan, and vis-versa.
# if unsuccessful, it means the amount was not subtracted or added, and the balance in Peter and Susan's account remains same as initial.import random

class Account:
    def __init__(self, money):
        self.money = money


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]


def transfer(frm, to, amnt):
    from_total = sum([acc.money for acc in frm.accounts])
    assert (
        from_total - amnt > 0
    ), f"{frm.name}'s total balance is too low to transfer {amnt}."
 --------------------
    # here's where you could add your code...
    total_balance_from = sum(account.money for account in frm.accounts)
    assert total_balance_from >= amnt, "Total balance of sender's accounts is less than the amount to be transferred"

    for acc in frm.accounts:
        if acc.money >= amnt:
            acc.money -= amnt
            to.accounts[0].money += amnt # transfer money to the first "to" account
            return True
    return False


