def transfer(frm, to, amnt):
    """ attempts to transfer "amnt" money from "frm" to "to" """
    
    # an assertion that  total balance of all "frm" accounts is not less than "amnt"
    assert sum(acc.money for acc in frm.accounts) >= amnt

    # sorting the accounts based on the balance in ascending order
    frm.accounts.sort(key = lambda x: x.money)
    to.accounts.sort(key = lambda x: x.money)
    
    # transfer the money from least balance account in from's accounts to the least balance account in to's accounts
    for from_acc in frm.accounts:
        for to_acc in to.accounts:
           --------------------    assert sum([a.money for a in frm.accounts]) >= amnt

    # an if we need to check if both "frm" and "to" is same person
    if frm is not to:
        # an assertion that total balance of all "to" accounts is not less than "amnt" 
        assert sum([a.money for a in to.accounts]) >= amnt

    for af, at in zip(frm.accounts, to.accounts):
        af.money -= amnt
        at.money += amnt


