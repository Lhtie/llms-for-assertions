print('Sam account total:', sum(a.money for a in sam.accounts))import math

class Coordinate:
    def __init__(self, x, y, z):
        self.x = x
        self.y = y
        self.z = z

class Vector:
    def __init__(self, coord):
        self.coord = coord

    def get_coord(self):
        return f"x : {self.coord.x}, y : {self.coord.y}, z : {self.coord.z}" 

class Transform:
    def __init__(self, vec):
        self.vec = vec

    def translate(self, deltas):
        new_x = self.vec.coord.x + deltas.x
        new_y = self.vec.coord.y + deltas.y
        new_z = self.vec.coord.z + deltas.z
        new_coord = Coordinate(new_x, new_y, new_z)
        new_Vector = Vector(new_coord)

        self.vec = new_Vector

        return self.vec.get_coord()

    def rotate_x(self, rad):
        new_y = self.vec.coord.y * math.cos(rad) - self.vec.coord.z * math.sin(rad)
        new_z = self.vec.coord.y * math.sin(rad) + self.vec.coord.z * math.cos(rad)
        new_coord = Coordinate(self.vec.coord.x, new_y, new_z)
        new_Vector = Vector(new_coord)
        
        self.vec = new_Vector
        
        return self.vec.get_coord()

