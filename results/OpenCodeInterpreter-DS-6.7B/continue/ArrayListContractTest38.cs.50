public class Factorial
{
    public static int Calculate(int n)
    {
        int sum = 0;
        
        for (int i = 1; i <= n; i++)
        {
            int fact = 1;
            for (int j = 1; j <= i; j++)
            {
                fact *= j;
            }
            sum += fact;
        }
        
        return sum;
    }
}public class Program
{
    private static double[][] Map;
    private static double[][] Answer;

    private static void Input()
    {
        var rowCol = Console.ReadLine().Split().Select(int.Parse).ToArray();
        Map = new double[rowCol[0]][];
        Answer = new double[rowCol[0]][];
        for (int i = 0; i < rowCol[0]; i++)
        {
            Map[i] = Console.ReadLine().Split().Select(double.Parse).Take(rowCol[1]).ToArray();
            Answer[i] = new double[rowCol[1]];
        }
    }

    private static void SwapColumns(int idxA, int idxB)
    {
        for (int i = 0; i < Map.Length; i++)
        {
            var temp = Map[i][idxA];
            Map[i][idxA] = Map[i][idxB];
            Map[i][idxB] = temp;
        }
    }

    private static void MultiplyColumn(int idx, double factor)
    {
        for (int i = 0; i < Map.Length; i++)
        {
            Map[i][idx] *= factor;
        }
    }

    private static void AddColumns(int idxA, int idxB)
    {
        for (int i = 0; i < Map.Length; i++)
        {
            Map[i][idxA] += Map[i][idxB];
        }
    }

    private static void GaussianElimination(int n, int m)
    {
        for (int i = 0; i < n; i++)
        {
            for (int j = i + 1; j < n; j++)
            {
                var f = Map[j][i] / Map[i][i];
                for (int k = i; k < m; k++)
                {
                    Map[j][k] -= f * Map[i][k];
                    Answer[j][k] -= f * Answer[i][k];
                }
            }
        }
    }

    private static void BackSubstitution(int n, int m)
    {
        for (int i = n - 1; i >= 0; i--)
        {
            for (int j = i - 1; j >= 0; j--)
            {
                Map[j][m - 1] -= Map[i][m - 1] * Map[j][m - n - 1];
                Answer[j][m - 1] -= Answer[i][m - 1] * Map[j][m - n - 1];
            }
        }
    }

    private static bool Solve()
    {
        int n = Map.Length;
        int m = Map[0].Length;

        var rref = true;

        for (int i = 0; i < n; i++)
        {
            if (Map[i][i] == 0)
            {
                rref = false;
                break;
            }

            var factor = 1 / Map[i][i];
            MultiplyColumn(i, factor);
            Answer[i] = Map[i].Select--------------------        }

    }
}

