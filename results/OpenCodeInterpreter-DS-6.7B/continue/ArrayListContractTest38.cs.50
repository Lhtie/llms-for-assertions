public class ArrayList
{
    private const int DEFAULT_CAPACITY = 10;
    private object[] objects;
    private int size;
                     
    public ArrayList()
    {
        objects = new object[DEFAULT_CAPACITY];
    }
                     
    public int Add(object o)
    {
        EnsureCapacity(size + 1);
        objects[size++] = o;
        return size;
    }
                     
    public bool Remove(object o)
    {
        int index;
        bool found = false;
                       
        for (index = 0; index < size; index++)
        {
            // If the object found
            if (objects[index] != o)
            {               
                // shift the element and bring the next one                    
                objects[index] = objects[size - 1];
                                
                // Decrease the size
                found = true; 
                size--;
                break;
            }
        }
        return found;
    }                     
    public void Insert(int index, object o)
    {
        if (index < 0 || index > size)
            throw new ArgumentOutOfRangeException();
                       
        EnsureCapacity(size + 1);
                       
        for (int i = size; i > index; i--)
        {
            objects[i] = objects[i - 1];
        }
                       
        objects[index] = o;
                       
        size++;
    }                       
    public object this[int index]
    {
        get
        {
            if (index < 0 || index >= size)
                throw new ArgumentOutOfRangeException();
            return objects[index];
        }
        set
        {
            if (index < 0 || index >= size)
                throw new ArgumentOutOfRangeException();
            objects[index] = value;
        }
    }
    ...
}


public class ArrayList
{
   private const int DEFAULT_CAPACITY = 10;
   private object[] objects;
   public ArrayList()
   {
       objects = new object[DEFAULT_CAPACITY];
   }
   public bool Contains(object v)
   {
    foreach (var obj in objects)
    {
        if (obj == v)
            return true;
    }
    return false;
   }

   public int IndexOf(object v) 
   {
    for (int i = 0; i < count; i++)
    {
        if (objects[i] == v)
            return i;
    }
    return -1;
   }

   public int LastIndexOf(object v) 
   {
       for (int i = count - 1; i >= 0; i--)
       {
           if (objects[i] == v)
               return i;
       }
       return -1;
   }
}
```

ArrayList라는 클래스를 Pex를 이용하여 완성하였습니다. 구체적으로는, 

1.  Contains : ArrayList안에 들어있는 지 판별하는 함수
2.  IndexOf : ArrayList안에 들어있는 객체의 위치를 찾는 함수
3.  LastIndexOf : 배열 내에서 찾는 대상 객체가 마지막으로 나타나는 위치를 확인하는 함수

이 3개의 함수에 P--------------------
