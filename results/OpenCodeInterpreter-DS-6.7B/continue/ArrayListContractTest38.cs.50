//ArrayList.Test/ArrayListTest.cs
﻿using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void ArrayListTest_Add()
        {
            ArrayList list = new ArrayList();

            Assert.AreEqual(0, list.Count);

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            Assert.AreEqual(5, list.Count);
        }

        [Test]
        public void ArrayListTest_Remove()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            list.Remove(2);

            Assert.AreEqual(4, list.Count);
        }

        [Test]
        public void ArrayListTest_IndexOf()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            Assert.AreEqual(2, list.IndexOf(2));
        }

        [Test]
        public void ArrayListTest_LastIndexOf()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            Assert.AreEqual(2, list.LastIndexOf(2));
        }

        [Test]
        public void ArrayListTest_Contains()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            Assert.IsTrue(list.Contains(2));
        }

        [Test]
        public void ArrayListTest_Insert()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            list.Insert(2, 22);

            Assert.AreEqual(22, list[2]);
        }

        [Test]
        public void ArrayListTest_SetItem()
        {
            ArrayList list = new ArrayList();

            for (int i = 0; i < 5; i++)
            {
                list.Add(i);
            }

            list[2] = 22;

            Assert.AreEqual(22, list[2]);
        }
    }
}

