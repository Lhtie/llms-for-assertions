namespace Microsoft.Azure.Management.ResourceManager.Fluent.Authentication
{
    using System.Net;
    using Models;
    using Rest;
    using static AzureEnvironment;

    public class AzureTokenCredentials : IAzureTokenCredentials
    {
        private readonly ITokenProvider tokenProvider;

        public AzureTokenCredentials(ITokenProvider tokenProvider)
        {
            this.tokenProvider = tokenProvider;
        }

        IAzureTokenCredentials IAzureTokenCredentials.Init(AzureEnvironments environments)
        {
            AzureEnvironment env = environments.GetByName(environments.ActiveDirectoryServiceEndpointResourceId);
            return Init(env, environments.TokenAudience);
        }

        private IAzureTokenCredentials Init(AzureEnvironment env, string tokenAudience)
        {
            ActiveDirectoryServiceSettings settings = new ActiveDirectoryServiceSettings
            {
                AuthenticationEndpoint = env.ActiveDirectoryEndpoint,
                TokenAudience = new Uri(tokenAudience),
                TokenEndpoint = env.TokenEndpoint
            };
            ServiceClientCredentials credentials = new TokenCredentials(tokenProvider, settings);
            return new AzureTokenCredentials(credentials)
            {
                TokenProvider = tokenProvider
            };
        }

        public IAzureTokenCredentials WithAuthority(Uri authority)
        {
            return new AzureTokenCredentials(new TokenCredentials(tokenProvider, new ActiveDirectoryServiceSettings { AuthenticationEndpoint = authority, TokenAudience = AuthorityHost }));
        }
    }
