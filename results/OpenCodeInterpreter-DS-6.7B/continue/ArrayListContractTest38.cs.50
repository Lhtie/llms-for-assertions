namespace Microsoft.Azure.Management.ResourceManager.Fluent.Authentication
{
    using AzureAuthorizationManagementCli = Azure.Management.Authorization.Fluent.AzureAuthorizationManagementCli;
    using AzureSubscriptionAuthentication = Azure.Management.Authorization.Fluent.AzureSubscriptionAuthentication;

    public class ApplicationTokenProvider : ITokenProvider
    {
        private TokenCredentials _credentials;

        public ApplicationTokenProvider(string tenantId, string clientId, string clientSecret, string authBaseUrl)
        {
            try
            {
                AzureAuthorizationManagementCli authClient = AzureAuthorizationManagementCli.Configure()
                    .WithBaseUrl(new Uri(authBaseUrl).GetLeftPart(UriPartial.Authority))
                    .WithTenantId(tenantId)
                    .WithClientId(clientId)
                    .WithClientSecret(clientSecret)
                    .Authenticate();

                List<AzureSubscriptionAuthentication> allSubscriptions = authClient.Subscription.List().ToList();

                _credentials = new TokenCredentials(allSubscriptions[0].Token, allSubscriptions[0].TokenType);
            }
            catch (Exception e)
            {
                Debug.LogError("Failed to setup Azure SDK for authentication. Exception: " + e.Message);
            }
        }

        public AccessToken GetAccessToken(string resource, bool isAsync)
        {
            AccessToken accessToken = _credentials.GetToken(resource);
            return accessToken;
        }
    }
