namespace Castle.ActiveRecord
{
	using System;
	using System.Data;
	using System.Collections;

	/// <summary>
	/// Represents a page of results
	/// </summary>
	public class Page
	{
		private IList items;
		private int totalItems;
		private int pageSize;

		internal Page(ArrayList items, int totalItems, int pageSize)
		{
			this.items = new ArrayList();
			this.totalItems = totalItems;
			this.pageSize = pageSize;
			this.items.AddRange(items);
		}

		/// <summary>
		/// Gets a value representing the items of the page.
		/// </summary>
		public IList Items
		{
			get { return items; }
		}

		/// <summary>
		/// Gets a value representing the total item count.
		/// </summary>
		public int TotalItems
		{
			get { return totalItems; }
		}

		/// <summary>
		/// Gets a value representing the total page count.
		/// </summary>
		public int TotalPages
		{
			get
			{
				if(pageSize == 0) return 0;

				return (int) Math.Ceiling((double)totalItems / (double)pageSize);
			}
		}

		/// <summary>
		/// Gets a value representing the size of the page.
		/// </summary>
		public int PageSize
		{
			get { return pageSize; }
		}
	}
