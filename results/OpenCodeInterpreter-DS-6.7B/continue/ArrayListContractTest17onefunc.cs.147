	    AssumePrecondition.IsTrue(Old_arrListLastIndexOfX >= 0);

            // the new list should have one less element than the old one
            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
            // the item 'x' should not exist anymore in the array list
            Assert.IsTrue(!New_arrListContainsX);
            // if 'x' existed in the list, the last index of its occurrence in the new list should be less than the old last index of 'x'
            Assert.IsTrue(New_arrListLastIndexOfX < Old_arrListLastIndexOfX);
        }
    }
}using System.Collections;

public class ArrayListContractTest
{
    [TestMethod]
    public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index, object x)
    {
        AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count); // Index is legal.

        object oldItemAtIndex = arrList[index];

        arrList.RemoveAt(index);

        // Verify that the correct item was removed.
        Assert.AreEqual(oldItemAtIndex, x);

        // Verify that the Count decremented.
        Assert.AreEqual(arrList.Count + 1, oldCount);

        // Verify that the other items remain in the list in their correct position.
        for (int i = 0; i < index; i++)
            Assert.AreEqual(arrList[i], oldList[i]);
        for (int i = index + 1; i < arrList.Count; i++)
            Assert.AreEqual(arrList[i], oldList[i - 1]);
    }
}

}
}
}
