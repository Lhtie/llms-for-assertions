                !Old_arrListContainsX || 
                New_arrListIndexOfX == -1 && 
                New_arrListLastIndexOfX == -1 && 
                !New_arrListContainsX);

            // This assumes that the .Remove() method reduces the count by 1 each time it is called with a parameter that exists in the list. 
            // If this is not the case, then we should adjust the assertion accordingly.
            PexAssert.IsTrue(result);

            arrList.Add(Old_x); // Restoring the state
        }
    }
