    // Test case that demonstrates "partial implementation" as a workaround for the "incomplete contract" warning under certain circumstances.
    [TestFixture, PexClass]
    public partial class ArrayListPartialTest
    {
        [PexMethod]
        public void PUT_AddAndRemove([PexAssumeUnderTest]ArrayList list, int x)
        {
            AssumePrecondition.IsTrue(list.Add(x) >= 0);

            AssumePrecondition.IsTrue(list.Remove(x));

            Assert.IsFalse(list.Contains(x));
        }
    }
}

    // A test case to demonstrate state boundaries & contract analysis with List.IndexOf().
    // The "IndexOf()" method should only return the index of the first occurrence of item, not any 
    // occurrence "passed" the initial find operation's position.
    [TestFixture, PexClass]
    public partial class ArrayListIndexingTest
    {
        [PexMethod]
        public void PUT_IndexOf_Consistent([PexAssumeUnderTest]ArrayList list, int x)
        {
            int firstIndex = list.IndexOf(x);

            AssumePrecondition.IsTrue(firstIndex >= 0);

            int secondIndex = list.IndexOf(x, firstIndex + 1);

            AssumePrecondition.IsTrue(secondIndex >= 0);

            AssumePostcondition.AreEqual(firstIndex, secondIndex);
        }
    }
}

    // A test case illustrating that IndexOf() is not suitable for finding "end" position for removal,
    // unlike in a traditional array's method.
    [TestFixture, PexClass]
    public partial class ArrayListEndIndexTest
    {
        [PexMethod]
        public void PUT_IndexOf_EndIndex_Issue([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Index = arrList.IndexOf(x);

            AssumePrecondition.IsTrue(Index >= 0);

            arrList.RemoveAt(Index);

            int OldCount = arrList.Count;

            bool Exists = arrList.Contains(x);

            AssumePostcondition.IsFalse(Exists);
        }
    }
}

    // A test case illustrating that the LastIndexOf() method is also not suitable for finding the 
    // "end" position for the removal.
    [TestFixture, PexClass]
    public partial class ArrayListEndIndexTestWithLastIndexOf
    {
        [PexMethod]
        public void PUT_LastIndexOf_EndIndex_Issue([PexAssumeUnderTest]ArrayList arrList, int x, int y)
        {
            ArrayList copy = new ArrayList(arrList);

            AssumePrecondition.IsTrue(copy.Add(x) >= 0);
            AssumePrecondition.IsTrue(copy.Add(y) >= 0);

            arrList.Remove(x);

            int Count = arrList.Count;

            bool Exists_x = arrList.Contains(x);

            AssumePostcondition.IsFalse(Exists_x);

        }
    }
}

    // Test case demonstrating that RemoveAt() & RemoveRange() methods handle parameters 
    // incorrectly (negative index) and throw.
    [TestFixture, PexClass]
    public partial class ArrayListRemoveRangeTest
    {
        [PexMethod]
        public void PUT_RemoveRange_Exception_Test([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Add(x) >= 0);

            AssumePostcondition.ExpectException<ArgumentOutOfRangeException>(() => arrList.RemoveRange(-1, 1));
        }
    }
}

