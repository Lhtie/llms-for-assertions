# ArrayList.Test File

[PexMethod]
[PexEntryPoint]
public void PutString(string name)
{
    // A stubbed out instance of the SystemUnderTest
    // This is what the PEX tool will use to find the correct inputs.
    MyComponent sut = new MyComponent();
        
    // A method on the system under test
    sut.Put(name);
}

[PexMethod]
public string GetString()
{
    MyComponent sut = new MyComponent();

    // The output from the Get is a string, so Pex can infer that.
    return sut.Get();
}

// The actual implementation of the MyComponent
public class MyComponent
{
    public void Put(string name)
    {
        _storage.Put(name);
    }

    public string Get()
    {
        return _storage.Get();
    }
    private MyStorage _storage;
}

public interface MyStorage
{
    void Put(string name);
    string Get();
}

