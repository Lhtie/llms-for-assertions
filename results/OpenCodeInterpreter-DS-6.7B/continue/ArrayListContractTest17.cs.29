using UnityEngine;

public class AmmoCounter : MonoBehaviour
{
    public RPB_BulletCounter bulletCounter;

    private int ammoCount;
    private int ammoCapacity = 20;
    private int tempAmmoCapacity;
    private int tempAmmoCount;

    private void Start()
    {
        ammoCount = ammoCapacity;
    }

    public void PickUpAmmo(int ammoValue, bool isPickedUp)
    {
        if(isPickedUp)
        {
            tempAmmoCount += ammoValue;

            if (tempAmmoCount >= ammoCapacity)
            {
               ammoCount = ammoCapacity;
               tempAmmoCount -= (tempAmmoCount - ammoCapacity);
           }
           else
           {
                ammoCount += ammoValue;
           }
        }
        else
        {
            tempAmmoCount = tempAmmoCapacity;

            if(tempAmmoCount < 0)
            {
                ammoCount += tempAmmoCount;
                tempAmmoCount = 0;
            }
            else
            {
                ammoCount = ammoCapacity;
            }
        }
        bulletCounter.SetCount(ammoCount, tempAmmoCount);
    }

    public void ShootBullet(int cost)
    {
        StartCoroutine(ShootBulletCo(cost));
    }

    IEnumerator ShootBulletCo(int cost)
    {
        tempAmmoCount -= cost;
        bulletCounter.SetCount(ammoCount, tempAmmoCount);
        yield return null;
    }
