            if (New_Ret < 0)
                {
	               AssumePrecondition.IsTrue(New_arrListContainsX == false);
	               AssumePrecondition.IsTrue(arrList.Count == Old_arrListCount);
	               AssumePrecondition.IsTrue(arrList.LastIndexOf(Old_x) == Old_arrListLastIndexOfX);
                }
            else
                {
	               AssumePrecondition.IsTrue(New_arrListContainsX == true);
	               AssumePrecondition.IsTrue(arrList.Count == Old_arrListCount);
	               AssumePrecondition.IsTrue(arrList.LastIndexOf(Old_x) == Old_arrListLastIndexOfX);
                }
        }

    }
}

