[PexMethod]
public virtual int IndexOf(T item)
{
    Contract.Ensures(Contract.Result<int>() >= 0 || Contract.Result<int>() == Count);
    return GetArray().IndexOf(item);
}
```csharp
// This might not be correct in some circumstances, because 'item' could be an array instead of a single item.
// For instance, if 'item' is a List<T>, then this method will find that List<T> occurs at index 0 in the 'GetArray()'.
// To avoid this misunderstanding, you should implement a method that takes a collection as an argument in stead of a single item.
```csharp
[PexMethod]
public virtual int LastIndexOf(T item)
{
    Contract.Ensures(Contract.Result<int>() >= -1 || Contract.Result<int>() == Count - 1);
    return GetArray().LastIndexOf(item);
}
```csharp
[PexMethod]
public virtual bool Contains(T item)
{
    bool result = GetArray().Contains(item);
    Contract.Ensures(Contract.ValueAtReturn(out result) == GetArray().Contains(item));
    return result;
}
```

