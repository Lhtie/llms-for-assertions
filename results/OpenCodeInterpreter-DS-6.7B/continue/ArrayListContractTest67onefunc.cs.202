ArrayList的Add和Update方法
```csharp
[PexMethod]
public virtual void Add(T item)
{
    Contract.Ensures(Count == Contract.OldValue<int>(Count) + 1);
    GetArray().Add(item);
}
```csharp
// If the collection does not allow duplicate values and you attempt to add a value that already exists, this method does not throw.
public virtual void Insert(int index, T item)
{
    Contract.Requires(index >= 0 && index <= Count);
    Contract.Ensures(Count == Contract.OldValue<int>(Count) + 1);
    GetArray().Insert(index, item);
}
```csharp
// This might not be correct in some circumstances, because 'item' could be a list instead of a single item.
// This method does not throw if the item is already present in the collection, even in a non-duplicate-allowed collection.
// So, for a non-duplicate-allowed collection, before calling 'Remove', you should call 'Contains' to check the existence of that item.
public virtual void Remove(T item)
{
    Contract.Requires(Count > 0);
    Contract.Requires(Contains(item));
    Contract.Ensures(Count == Contract.OldValue<int>(Count) - 1);
    GetArray().Remove(item);
}
```csharp
public virtual void RemoveAt(int index)
{
    Contract.Requires(index >= 0 && index < Count);
    Contract.Ensures(Count == Contract.OldValue<int>(Count) - 1);
    GetArray().RemoveAt(index);
}
```

