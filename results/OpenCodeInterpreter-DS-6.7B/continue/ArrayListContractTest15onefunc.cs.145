            bitArray.Set(1, true);

            Assert.IsTrue(bitArray.Get(0), "bitArray[0] should be true");
            Assert.IsTrue(bitArray.Get(1), "bitArray[1] should be true");

            bitArray.Set(0, false);

            Assert.IsFalse(bitArray.Get(0), "bitArray[0] should be false after Set(0, false)");
            Assert.IsTrue(bitArray.Get(1), "bitArray[1] should still be true");
        }
    }
