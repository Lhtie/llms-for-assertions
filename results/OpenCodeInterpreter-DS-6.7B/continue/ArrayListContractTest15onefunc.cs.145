            arrayList.Add(1);
            arrayList.Add(2);
            arrayList.Add(3);

            Assert.AreEqual(3, arrayList.Count, "The initial count should be 3");

            arrayList.Remove(2);

            Assert.AreEqual(2, arrayList.Count, "After removing an item, the count should be 2");

            arrayList.Clear();

            Assert.AreEqual(0, arrayList.Count, "After clearing the list, the count should be 0");
        }
    }
}

