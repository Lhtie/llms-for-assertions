﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using PexLib;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_Set_RangeContract([PexAssumeUnderTest("List", typeof(ArrayList))]ArrayList arrList, [PexAssumeUnderTest("Index", typeof(int)), PexRange(0, 10)]int index, [PexAssumeUnderTest("newList", typeof(ArrayList))]ArrayList newList)
        {
            AssumePrecondition.IsTrue(0 <= index);
            AssumePrecondition.IsTrue(index <= arrList.Count);

            int OldCount = arrList.Count;

            arrList.SetRange(index, newList);

            int NewCount = arrList.Count;

            // Assert
            Assert.AreEqual(OldCount, newList.Count, "The count of the oldList should not be modified.");
            for (int i = 0; i < newList.Count; i++)
            {
                Assert.AreEqual(newList[i], arrList[index + i], "Elements in the newList should have been inserted at the correct position in the list.");
            }
        }        
    }
}

