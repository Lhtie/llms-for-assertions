using System;
using System.Diagnostics;
using System.Globalization;
using JsErrorAndException;
using Microsoft.Pex.Framework.Settings;

namespace Pex.JavaScript.Plugins.TestFramework
{
    /// <summary>
    /// Utility class for assorted assertions
    /// </summary>
    internal static class AssertionUtilities
    {
        [Conditional("DEBUG")]
        [DebuggerHidden()]
        internal static void Assert(bool condition, string message)
        {
#if NORMAL_BUILD
            if (!condition)
#endif
                throw new JavaScriptPexException(message);
        }

        internal static string FormatMessage(string format, params object[] args)
        {
            return string.Format(CultureInfo.CurrentCulture, format, args);
        }
    }
}

