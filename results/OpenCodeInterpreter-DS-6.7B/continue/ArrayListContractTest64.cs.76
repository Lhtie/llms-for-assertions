﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;
using ArrayList;

using NUnit.Framework;
using Array;

namespace PexAPIWrapper
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        [Random(10)]
        public void TestAdd([Greedy]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Add(x) >= 0);
            Assert.IsTrue(arrList.Contains(x));
        }
        
        [Test]
        [Random(10)]
        public void TestRemove([Greedy]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));
            arrList.Remove(x);
            Assert.IsFalse(arrList.Contains(x));
        }

        [Test]
        [Random(10)]
        public void TestInsert([Greedy]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
            AssumePrecondition.IsTrue(arrList.Count + 1 >= arrList.IndexOf(x))
            arrList.Insert(index, x);
            int lastIndex = arrList.LastIndexOf(x);
            Assert.IsTrue(index == lastIndex);
        }

        [Test]
        [Random(10)]
        public void TestSet ([Greedy]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            AssumePrecondition.IsTrue(arrList[index] != x);
            arrList[index] = x;
            Assert.IsTrue(arrList[index] == x);
        }

        [Test]
        [Random(10)]
        public void TestGet ([Greedy]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            int x = arrList[index];
            Assert.AreEqual(x, arrList.Get(index));
        }

        [Test]
        [Random(10)]
        public void TestContains ([Greedy]ArrayList arrList, int x)
        {
            Assert.IsTrue(arrList.Contains(x) || !arrList.Contains(x));
        }
    }
}

