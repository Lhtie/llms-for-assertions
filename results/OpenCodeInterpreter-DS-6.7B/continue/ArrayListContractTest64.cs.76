using Microsoft.VisualStudio.TestTools.UnitTesting;
using PexAPIWrapper;
using ArrayList;

namespace PST.Tests
{
    [TestClass]
    public class ArrayListTest
    {
        [TestMethod]
        public void TestArrayList()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Add(4);

            int count = arrList.Count;

            arrList.Insert(2, 5);
            int indexOf5 = arrList.IndexOf(5);
            int lastIndexOf5 = arrList.LastIndexOf(5);
            arrList.Remove(5);

            Assert.AreEqual(count, arrList.Count);
            Assert.AreEqual(2, indexOf5);
            Assert.AreEqual(2, lastIndexOf5);

            // now add the value back and check that everything is fine
            arrList.Add(5);
            indexOf5 = arrList.IndexOf(5);
            lastIndexOf5 = arrList.LastIndexOf(5);
            Assert.AreEqual(count+1, arrList.Count);
            Assert.AreEqual(count-1, indexOf5);
            Assert.AreEqual(count-1, lastIndexOf5);
        }
    }
}

