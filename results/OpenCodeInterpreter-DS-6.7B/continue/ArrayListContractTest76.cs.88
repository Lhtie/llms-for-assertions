public ArrayList GetRange(int index, int count)
{
    RangeCheck(index, count);
    ArrayList clone = new ArrayList(count);
    for (int i = 0; i < count; i++)
    {
        clone.Add(m_Array[index + i]);
    }
    return clone;
}
