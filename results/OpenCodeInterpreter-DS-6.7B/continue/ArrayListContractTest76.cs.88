        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfRemoved = arrList[index];
            bool Old_arrListContainsRemoved = arrList.Contains(Old_arrListIndexOfRemoved);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsRemoved = arrList.Contains(Old_arrListIndexOfRemoved);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_indexOfRemoved", Old_arrListIndexOfRemoved);
            PexObserve.ValueForViewing("$old_arrList_containsRemoved", Old_arrListContainsRemoved);
            PexObserve.ValueForViewing("$new_arrList_containsRemoved", New_arrListContainsRemoved);

        }
