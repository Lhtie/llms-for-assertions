           --------------------
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

        }
    }
}

This script verifies the constraints for each of the contract methods. Here are the contract methods based on Pex:

- AddContract: the count before and after adding an element to a list should be increased by one, and the index of the element should be the same as the last index.
- RemoveContract: the count should be decreased by one and the index of element should be removed.
- InsertContract: the count should be increased by one and the index of the element should be the same as the input index.
- SetContract: after setting the element at a certain index, the element should be at the same index.
- GetContract: get item at index of the list.
- ContainsContract: the element should be in the list when it is contained and should be removed when it is not contained,
- IndexOfContract: IndexOf should not change when element is in the list, IndexOf should be positive until element is removed from the list.
- LastIndexOfContract: IndexOf should not change when element is in the list, LastIndexOf should be positive until element is removed from the list.

Remember, the above constraints are not necessarily valid or correct, but they are assumptions that the Pex tool can reason about during testing. The Pex tool's capabilities extend not only to code contracts but also to complex system behavior in the presence asynchronous calls, partial mocks, and state transition. 

The constraints generated by the Pex tool can also be used to guide testing at a higher level, for instance, to generate test sequences for specific scenario like removing elements from the list. The Pex tool also gives users a toolkit to reason about the execution behavior of their programs, allowing users to generate and analyze test cases based on their program's control flow and data flows. 

The above script gives you a good way to use the Pex API in your automated testing for ArrayList, and you can use it as a base and modify/update or add more methods according to what it is that you want to test.

