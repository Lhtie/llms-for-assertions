```csharp


List<T>.Sort(Comparison<T> comp)
{
    if (comp == null)
    {
        throw new ArgumentNullException("comparer");
    }
    // sort the sequence
    Sort((IComparer<T>)comp);
}
List<T>.Sort(int index, int count, Comparer<T> comparer)
{
    if (index < 0)
    {
        throw new ArgumentOutOfRangeException("index", index, "Index should be non-negative");
    }
    if (count < 0)
    {
        throw new ArgumentOutOfRangeException("count", count, "Count should be non-negative");
    }
    if (index + count > Count)
    {
        throw new ArgumentException("Out of range");
    }
    if (comparer == null)
    {
        throw new ArgumentNullException("comparer");
    }
    Sort(index, count, comparer);
}
