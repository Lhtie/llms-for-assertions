//Src/Client.Tests/ArrayListContractTest.cs
using System;
using System.Collections;
using NUnit.Framework;
using PexAPIWrapper;


[TestFixture]
public class ArrayListContractTest
{
    [Test]
    public void ArrayListContracts()
    {
        TestList(new ArrayList());
    }

    [Test]
    public void ArrayListContracts_Slow()
    {
        TestListSlow(new ArrayList());
    }

    private void TestList(ArrayList list)
    {
        int count = 0;
        Assert.AreEqual(count, list.Count);
        list.Add(1);
        count++;
        Assert.AreEqual(count, list.Count);
        
        list.RemoveAt(0);
        count--;
        Assert.AreEqual(count, list.Count);
    }

    private void TestListSlow(ArrayList list)
    {
        int count = 0;

        // This test takes very long to run and is not very precise for this particular test.
        // The goal is to exercise various points of the test subject.

        for (int i = 0; i < 1000000; i++)
        {
            list.Add(i);
            count++;
            Assert.AreEqual(count, list.Count);

            if (i % 10000 == 0)
                list.RemoveAt(0);
            count--;
            Assert.AreEqual(count, list.Count);

            list.Insert(0, i);
            count++;
            Assert.AreEqual(count, list.Count);
        }
    }
}

//Src/Client/ArrayList.cs
public class ArrayList
{
    public int Count { get; private set; }

    public void Add(int item)
    {
        this.Count++;
    }

    public void RemoveAt(int index)
    {
        this.Count--;
    }

    public void Insert(int index, int item)
    {
        this.Count++;
    }
}

