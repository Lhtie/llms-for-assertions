```csharp


[System.Diagnostics.DebuggerStepThrough]
public int IndexOf(object value)
{
    // Repeat through the items in the ArrayList, checking for the object specified in parameter ‘value’ (if it is found at the current index location, return the current index).
    for (int i = 0; i < m_Size; i++)
    {
        if ((m_Array[i] == value) || ((value != null) && (m_Array[i] != null) && value.Equals(m_Array[i])))
        {
            return i;
        }
    }
    // If the object is not found in the ArrayList, return -1.
    return -1;
}
