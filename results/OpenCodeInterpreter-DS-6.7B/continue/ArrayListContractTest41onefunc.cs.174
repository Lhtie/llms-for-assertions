﻿// ReSharper disable All
namespace ArrayList.Test
{
    using System;
    using System.Collections;
    using System.Collections.Generic;
    using System.Diagnostics;
    using System.Linq;
    using Pex.Framework;
    using Pex.Framework.Settings;
    using Pex.Persistence;

    public static class AssumePrecondition
    {
        public static void IsTrue(bool p)
        {
        }
    }

    public class ArrayList: IList, ICollection, IEnumerable
    {
        public object this[int index]  { get {return default(object);} set {} }

        public int Count {get { return default(int);} }

        public bool IsSynchronized { get { return default(bool);} }

        public object SyncRoot { get { return default(object);} }

        public void CopyTo(Array array, int index) {}

        public void CopyTo(object[] array, int index) {}

        public IEnumerator GetEnumerator() { 
            return null;
        }

        public int Add(object value) { return default(int);}

        public bool Contains(object value) { return default(bool);}

        public void Clear() {  }

        public int IndexOf(object value) { return default(int);}

        public void Insert(int index, object value) {  }

        public void Remove(object value) {  }

        public void RemoveAt(int index) {  }
        
        public void Lock() {  }

        public void Unlock() {  }

        public int LastIndexOf(object value) { return default(int);}

        public void RemoveRange(int index, int count) {  }

        public void Resize(int newSize) {  }
    }

    public class ArrayListTests
    {
        public void CopyToNullArrayIndex([PexAssumeUnderTest] ArrayList arrList, int[] arrIndices)
        {
            arrList.CopyTo(null, arrIndices[0]);
        }

        [PexMethod]
        public void CopyToNullArrayNullIndex([PexAssumeUnderTest] ArrayList arrList)
        {
            arrList.CopyTo((object[])null, 0);
        }

        public void RemoveAtInvalidIndex([PexAssumeUnderTest] ArrayList arlList, int index)
        {
                arlList.RemoveAt(-1);
        }
    }

    public class PexObserve
    {
        public static void ValueForViewing(string name, int value) {}
    }


