```csharp

namespace ArrayList.Test
{
    [PexMethod]
    public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

        int Old_arrListCount = arrList.Count;
        int Old_index = index;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList[index] = x;

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        // Assertion that check the count of array list before and after modification
        Assert.AreEqual(Old_arrListCount, New_arrListCount);

        // Assertion that ensures that index of x in old array list is same or more than index of x in new arrayList
        Assert.IsTrue(Old_arrListIndexOfX >= index);

        // Assertion that ensures that new index of x in new array list is same as index of x
        Assert.IsTrue(New_arrListIndexOfX >= index);

        //Assertion that ensures that lastIndex of x in old array list is same or more than lastIndex of x in new arrayList
        Assert.IsTrue(Old_arrListLastIndexOfX >= index);

        // Assert that the New LastIndex of X is more than the Old
        Assert.IsTrue(New_arrListLastIndexOfX >= index);

        // Assertion that ensures that new array list contains x after modification
        Assert.IsTrue(New_arrListContainsX);

        Assert.IsFalse(Old_arrListContainsX);
    }
}

