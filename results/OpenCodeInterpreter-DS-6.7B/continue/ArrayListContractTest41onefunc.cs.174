}//src/FiscalYear.cs
namespace ATS
{
    public class FiscalYear
    {
        public const int START_YEAR = 2018;

        public int Year { get; private set; }

        public FiscalYear(int year)
        {
            if (year < START_YEAR)
            {
                throw new ArgumentException("Invalid year. Must be greater or equal to " + START_YEAR);
            }
            this.Year = year;
        }

        public bool IsInCurrentFiscalYear(DateTime date)
        {
            return IsInFiscalYear(date, DateTime.Today);
        }

        public bool IsInFiscalYear(DateTime date, DateTime referenceDate)
        {
            if (date.Year == referenceDate.Year)
            {
                return true;
            }
            else if (date.Year == referenceDate.Year - 1)
            {
                return true;
            }
            else if (date.Year == referenceDate.Year - 2 && referenceDate.Month >= 7)
            {
                return true;
            }
            else
            {
                return false;
            }
        }
    }
}

//test/unit/FiscalYearTest.cs
using System;
using ATS;
using NUnit.Framework;

[TestFixture]
public class FiscalYearTest
{
    [Test]
    public void TestInvalidYear()
    {
        try
        {
            // ReSharper disable ObjectCreationAsStatement
            new FiscalYear(FiscalYear.START_YEAR - 1);
            // ReSharper restore ObjectCreationAsStatement
            Assert.Fail("Expected exception not thrown");
        }
        catch (ArgumentException e)
        {
            Assert.AreEqual("Invalid year. Must be greater or equal to " + FiscalYear.START_YEAR, e.Message);
        }
    }

    [Test]
    public void TestIsInFiscalYear()
    {
        var jan2018 = new DateTime(2018, 1, 1);
        var currentFiscalYear = new FiscalYear(FiscalYear.START_YEAR);
        Assert.IsTrue(currentFiscalYear.IsInFiscalYear(jan2018, DateTime.Today));
    }
