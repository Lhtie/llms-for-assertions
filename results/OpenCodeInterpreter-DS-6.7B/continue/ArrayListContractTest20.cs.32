        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int old_Count = arrList.Count;

            arrList.Clear();

            int new_Count = arrList.Count;

            // here we can use our previous assertion framework 
            Assert.IsTrue(new_Count == 0);
        }
         
        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int old_Count = arrList.Count;
            int old_IndexOfX = arrList.IndexOf(x);
            int old_LastIndex = arrList.LastIndexOf(x);
            bool old_arrList_ContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int new_Count = arrList.Count;
            int new_IndexOfX = arrList.IndexOf(x);
            int new_LastIndex = arrList.LastIndexOf(x);

            bool new_arrList_ContainsX = arrList.Contains(x);

            // here we can use our previous assertion framework 
            Assert.IsTrue(new_Count == old_Count + 1);
            if (new_arrList_ContainsX) {
                Assert.IsTrue(new_IndexOfX == index);
                Assert.IsTrue(new_LastIndex >= index);
            }
        }
         
        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            int old_Count = arrList.Count;
            int old_x = (int)arrList[index];
            int old_IndexOfX = arrList.IndexOf(old_x);
            int old_LastIndexOfX = arrList.LastIndexOf(old_x);
            bool old_arrList_ContainsX = arrList.Contains(old_x);

            // do removeAt operation
            arrList.RemoveAt(index);

            int new_Count = arrList.Count;
            bool new_arrList_ContainsX = arrList.Contains(old_x);

            // here we can use our previous assertion framework 
            Assert.IsTrue(new_Count == old_Count - 1);
            if (!new_arrList_ContainsX) {
                Assert.IsTrue(arrList.IndexOf(old_x) < 0);
                Assert.IsTrue(arrList.LastIndexOf(old_x) < 0);
            } 
        }
    }       
}

