﻿using System;
using ArrayList;

namespace ArrayList.Test
{
    class Program
    {
        static void Main(string[] args)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            arrList.Add(30);
            arrList.Add(40);

            //  Displaying elements
            Console.WriteLine("Initial elements in the Array list:");
            foreach(int i in arrList)
            {
                Console.WriteLine(i);
            }

            // Adding elements
            arrList.Add(50);
            arrList.Add(60);

            // Deletion of elements
            arrList.Remove(60);
            arrList.Remove(50);

            Console.WriteLine("Elements after addition and deletion");
            foreach(int i in arrList)
            {
                Console.WriteLine(i);
            }
            
            Console.ReadKey();
        }
    }
}

