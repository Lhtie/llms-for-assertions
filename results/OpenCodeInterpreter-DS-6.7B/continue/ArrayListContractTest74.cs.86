using NUnit.Framework;
using ArrayList;

namespace Tests
{
    public class ArrayListTests
    {
        [SetUp]
        public void Setup()
        {
        }

        [Test]
        public void TestAdd()
        {
            var arrList = new ArrayList.ArrayList();
            Assert.AreEqual(true, arrList.Add(5) >= 0);  // should succeed
            Assert.AreEqual(false, arrList.Add(15) >= 0);  // should fail due to capacity overflow
            
            Assert.AreEqual(5, arrList.Count);  // should be 5
        }

        [Test]
        public void TestRemove()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(5);
            arrList.Add(6);
            arrList.Add(7);

            Assert.AreEqual(true, arrList.Remove(6));  // should succeed
            Assert.AreEqual(false, arrList.Remove(15));  // should fail since 15 is not present
            
            Assert.AreEqual(2, arrList.Count);  // should be 2
        }

        [Test]
        public void TestIndexOf()
        {
            var arrList = new ArrayList.ArrayList();
            arrList.Add(5);
            arrList.Add(6);
            arrList.Add(7);

            Assert.AreEqual(1, arrList.IndexOf(6));  // should be 1
            Assert.AreEqual(-1, arrList.IndexOf(15));  // should be -1 since 15 is not present
        }

