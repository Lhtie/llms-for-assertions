    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void TestMethod()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Add(4);
            arrList.Add(5);

            arrList.Remove(1);
            arrList.Remove(3);
            arrList.Remove(5);

            arrList.Insert(1, 2);
            arrList.Insert(3, 4);
            arrList.Insert(5, 6);

            arrList[1] = 22;
            arrList.Set(3, 44);

            Assert.AreEqual(22, arrList[1]);
            Assert.AreEqual(44, arrList[3]);

            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }
    }
}

