//Program.cs
﻿using System.Collections;
using ArrayList;

class Program
{
    static void Main(string[] args)
    {
        ArrayList arrList = new ArrayList();
        int x = ((4 % 10) + 3*5); // mod and multiplication

        arrList.Add(x); // should not add x > 9
        arrList.Remove(x); // should not remove non-existing item
        
        arrList.IndexOf(7); // non-existing item
        arrList.LastIndexOf(10); // non-existing item

        arrList[0] = 10; // trying to set non-existing item
        int y = arrList[0]; // trying to get non-existing item

        arrList.Contains(7); // non-existing item
    }
}

