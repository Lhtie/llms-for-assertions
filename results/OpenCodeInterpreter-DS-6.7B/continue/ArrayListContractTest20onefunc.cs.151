}


/*
 * ArrayList Contract Test
 * 
 * PUT_RemoveContract: 
 * This test verifies that the ArrayList contract correctly describes the behavior of the Remove method. 
 * The test focuses on various aspects of the ArrayList, including ensuring that the array has the correct count after a Remove operation, 
 * the values in the array after a Remove operation, and the behavior of contains and IndexOf methods as per the Remove operation. 
 * The test also verifies that the array count reduces by 1 if the array was non-empty before the Remove operation. 
 * It uses PexAssumeUnderTest attribute to specify the under test ArrayList class.
 * 
 */

//Examples/ArrayList.Test/ContractTesting/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        // PUT_AddContract: Test the contract of the Add method (input: int, output: void)

        [TestMethod]
        public void PUT_AddContract()
        {
            AssumePrecondition.IsTrue(true, "This test requires a true precondition.");
            ArrayList arrList = new ArrayList();
            int x = PexObserve.ValueForViewing<int>("New value to add").Observe(1);

            int Old_arrListCount = arrList.Count;

            arrList.Add(x);

            int New_arrListCount = arrList.Count;

            // Postconditions
            // The count of the array list should increase by one after adding a value.
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1);
        }
    }
}

//Examples/ArrayList.Test/ContractTesting/ArrayListContractTest.cs
