### RemoveAll (remove all instances of the specified object from the ArrayList)

進行測試的代碼接口如下：

```csharp
[PexMethod]
public void PUT_RemoveAllContract([PexAssumeUnderTest]ArrayList arrList, object obj)
{
    AssumePrecondition.IsNotNull(obj);

    int Old_arrListCount = arrList.Count;
    bool Old_arrListContainsObj = arrList.Contains(obj);

    arrList.RemoveAll(obj);

    int New_arrListCount = arrList.Count;
    bool New_arrListContainsObj = arrList.Contains(obj);

    // an assertion using "Debug.Assert\(.*?\);" that @@@ count of old ArrayList equals new ArrayList count minus the number of instance of obj to be removed 
    Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

    // an assertion using "Debug.Assert\(.*?\);" that @@@ contains obj returns false
    Assert.IsFalse(New_arrListContainsObj);
}
```

Test Parameters:

- _arrList_: ArrayList, 非空的
- _obj_: object

假設條件：
- obj 存在於 arrList 中

將全部的指定對象從 ArrayList 中移除後，我們進行了下列檢查：
1. 舊的 ArrayList 中的元素個數應該與新的 ArrayList 中的元素個數減去 obj 被移除的次數相同。
2. 新的 ArrayList 中不再包含 obj。

我們使用 Assert 來檢查這些條件，這些條件通過表示 RemoveAll 方法的執行符合 ArrayList 的規範。
___

### Clear (remove all elements from the ArrayList)

進行測試的代碼接口如下：

```csharp
[PexMethod]
public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
{
    int Old_arrListCount = arrList.Count;
    arrList.Clear();
    int New_arrListCount = arrList.Count;

    // an assertion using "Debug.Assert\(.*?\);" that @@@ count of old ArrayList equals 0
    Assert.AreEqual(0, Old_arrListCount);

    // an assertion using "Debug.Assert\(.*?--------------------            Assert.IsTrue(Old_arrListIndexOfX >= 0);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x in old array is geq index of x in old array 
            Assert.IsTrue(Old_arrListLastIndexOfX >= Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ is less or eq minus 1 
            Assert.IsTrue(New_arrListIndexOfX <= -1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ is less or eq index of x in old array 
            Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count in old array minus one eq count in new array 
            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ not contains x in new array 
            Assert.IsFalse(New_arrListContainsX);

	}
    }
}
```

