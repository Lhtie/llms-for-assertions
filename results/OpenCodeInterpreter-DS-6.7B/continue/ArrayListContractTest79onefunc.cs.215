using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Rewriting;
using Microsoft.Pex.Framework.Rewriting.Rules;
using System.Linq;

namespace System
{
    public class DateTimePexRule : PexRewritingRule
    {
        public override void VisitMethodCall(RewriterContext context)
        {
            if (IsMethodOfType(context, typeof(DateTime)))
            {
                context.RewriteArguments(this.DateTimeArgumentRule);
            }
        }

        [PexRewrite]
        private void DateTimeArgumentRule(RewriterContext context)
        {
            if (context.CurrentArgument.Type == typeof(DateTime))
            {
                var argument = (PexGeneratedArgument)context.CurrentArgument;
                context.CurrentArgument = new PexGeneratedArgument(DateTime.MinValue, typeof(DateTime));
            }
        }
    }
}// Copyright (c) Microsoft Research 2016
// License: MIT. See LICENSE.txt in the project root for details.

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Rewriting;
using Microsoft.Pex.Framework.Rewriting.Rules;
using System.Linq;

namespace System
{
    public class GuidPexRule : PexRewritingRule
    {
        public override void VisitMethodCall(RewriterContext context)
        {
            if (IsMethodOfType(context, typeof(Guid)))
            {
                context.RewriteArguments(this.GuidArgumentRule);
            }
        }

        [PexRewrite]
        private void GuidArgumentRule(RewriterContext context)
        {
            if (context.CurrentArgument.Type == typeof(Guid))
            {
                var argument = (PexGeneratedArgument)context.CurrentArgument;
                context.CurrentArgument = new PexGeneratedArgument(Guid.Empty, typeof(Guid));
            }
        }
    }
