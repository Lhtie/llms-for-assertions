//ArrayList/ArrayList.cs
﻿using System;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList
{
    public class ArrayList : IList<object>
    {
        private object[] _items;
        private int _count;

        public ArrayList()
        {
            _items = new object[4];
            _count = 0;
        }

        public object this[int index]
        {
            get
            {
                return _items[index];
            }
            set
            {
                _items[index] = value;
            }
        }

        public object this[object value]
        {
            get
            {
                return _items[IndexOf(value)];
            }
            set
            {
                _items[IndexOf(value)] = value;
            }
        }

        public int Count
        {
            get
            {
                return _count;
            }
        }

        public bool IsReadOnly
        {
            get { return false; }
        }

        public bool IsFixedSize
        {
            get { return false; }
        }

        public bool IsSynchronized
        {
            get
            {
                return false;
            }
        }

        public void Add(object item)
        {
            if (_count == _items.Length)
            {
                IncreaseSize();
            }
            _items[_count] = item;
            _count++;
        }

        public void Clear()
        {
            _items = new object[4];
            _count = 0;
        }

        public bool Contains(object item)
        {
            return IndexOf(item) != -1;
        }

        public void CopyTo(object[] array, int arrayIndex)
        {
            CheckArgumentOutOfRange(arrayIndex);
            _items.CopyTo(array, arrayIndex);
        }

        public IEnumerator<object> GetEnumerator()
        {
            return new ArrayListEnumerator(this);
        }

        public int IndexOf(object item)
        {
            for (int i = 0; i < _count; i++)
            {
                if (Object.Equals(_items[i], item))
                {
                    return i;
                }
            }
            return -1;
        }

        public void Insert(int index, object item)
        {
            index = NormalizeIndex(index);
            if (index == _count)
            {
                Add(item);
                return;
            }
            EnsureSpace(index);
            Array.Copy(_items, index, _items, index + 1, _count - index);
            _items[index] = item;
            _count++;
        }

        public bool Remove(object item)
        {
            int index = IndexOf(item);
            if (index == -1)
            {
                return false;
            }
            RemoveAt(index);
            return true;
        }

        public void RemoveAt(int index)
        {
            index = NormalizeIndex(index);
            Array.Copy(_items, index + 1, _items, index, _count - index - 1);
            _count--;
            _items[_count] = null;
        }

        public object SyncRoot
        {
            get
            {
                return this;
            }
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return GetEnumerator();
        }

        private int NormalizeIndex(int index)
        {
            if (index < 0)
            {
                index = 0;
            }
            if (index > _count)
            {
                index = _count;
            }
            return index;
        }

        private void IncreaseSize()
        {
            object[] newArray = new object[_count * 2];
            Array.Copy(_items, newArray, _count);
            _items = newArray;
        }

        private void CheckArgumentOutOfRange(int index)
        {
            if (index < 0)
            {
                throw new ArgumentOutOfRangeException--------------------            {   Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX && Old_arrListLastIndexOfX != New_arrListLastIndexOfX);}
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_obj = (int)arrList[index];
            int Old_arrListIndexOfObj = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfObj = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsObj = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfObj = arrList.IndexOf(arrList[index]);
            int New_arrListLastIndexOfObj = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsObj = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_obj", Old_obj);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_obj", Old_arrListIndexOfObj);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_obj", New_arrListIndexOfObj);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_obj", Old_arrListLastIndexOfObj);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_obj", New_arrListLastIndexOfObj);
            PexObserve.ValueForViewing("$old_arrList_contains_obj", Old_arrListContainsObj);
            PexObserve.ValueForViewing("$new_arrList_contains_obj", New_arrListContainsObj);
        }
    }
