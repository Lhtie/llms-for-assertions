    public class LiquidRenderAssertionFailedException : Exception {

        #region Constructors

        /// <summary>
        /// Initializes a new instance of the LiquidRenderAssertionFailedException class.
        /// </summary>
        public LiquidRenderAssertionFailedException() {
        }

        /// <summary>
