using System;
using System.Collections.Generic;

namespace Liquid.CSharp {

    /// <summary>
    /// A set of extensions for an object.
    /// </summary>
    public static class ObjectExtensions {

        #region Instance Methods

        /// <summary>
        /// Returns a string representation of an object.
        /// </summary>
        /// <param name="obj">The object to be turned into a string.</param>
        /// <returns>A string representation of the object.</returns>
        public static string ToLiquidString(this object obj) {
            if (obj == null) {
                return "null";
            }

            if (obj is IFormattable || obj is IComparable || obj is IConvertible || obj is IEnumerable<string>) {
                return obj.ToString();
            }

            else {
                throw new ArgumentException(
                    LiquidCSharpStrings.CannotConvertNonCollectionToString
                );
            }
        }

        #endregion

    }

