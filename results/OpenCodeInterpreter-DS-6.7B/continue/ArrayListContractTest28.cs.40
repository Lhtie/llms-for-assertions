using MisOfertas.Model;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using Xamarin.Forms;

namespace MisOfertas
{
    public partial class MainPage : ContentPage
    {
        private ListView listView;
        private ListaOferta listaOferta = new ListaOferta();

        public MainPage()
        {
            InitializeComponent();

            listView = new ListView();
            listView.ItemsSource = listaOferta;
            listView.ItemTemplate = new DataTemplate(typeof(TextCell));
            listView.ItemTemplate.SetValue(TextCell.TextProperty, "{Titulo} - {Fecha}");
            
            Content = listView;
        }

        protected async override void OnAppearing()
        {
            base.OnAppearing();
            
            if (DateTime.Now.Subtract(listaOferta.UltimaActualizacion).TotalMinutes > 10)
            {
                await ActualizarOfertas();
            }
        }

        private async Task ActualizarOfertas()
        {
            var nuevoLista = await ServicioOfertas.ObtenerOfertas();
            listaOferta.Clear();
            listaOferta.AddRange(nuevoLista);
            listaOferta.UltimaActualizacion = DateTime.Now;
            listView.ItemsSource = listaOferta;
        }--------------------
        }

