class Rectangle():
    def __init__(self, n, m):
        self.exp = n # this is how tall
        self.mat = n+m+2
        self.lin = m # this is how wide

def func(n, m):
    r = Rectangle(n, m)
    # Assert that the height of the rectangle is positive
	assert r.exp > 0, "height of rectangle is zero"
