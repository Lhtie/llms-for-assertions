    assert r.exp == n, "The instance r does not have the expected shape."
--------------------    assert(r.exp>0), "height is zero"
    # an assertion that  width the r is positive
    assert(r.lin>0), "width is zero"
    # an assertion this is a rectangle
    assert(n > 0 and m > 0), "not a rectangle"
    # an assertion that  there is at least one perimeter
    assert(r.exp*2 + r.mat*2 + r.lin*.5>min(r.exp, r.lin)), "not a perimeter"
    # an assertion this is a rectanglar
    assert(r.mat == max(r.exp, r.lin) or r.mat == min(r.exp, r.lin)), "not a rectangle"
    # an assertion that this is a rectangle
    assert(r.exp*2 + r.mat*2 + r.lin*2 == max(r.exp*4, r.mat*4, r.lin*4)), "not a rectangle"

def main():
    func(3,4)

