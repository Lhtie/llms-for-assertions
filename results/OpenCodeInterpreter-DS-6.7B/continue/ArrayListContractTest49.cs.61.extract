	    Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX);
--------------------	    // This should be done to ensure that the list maintains its correctness order after each operation
	    PexObserve.ValueForViewing("Old Index of x", Old_arrListIndexOfX);
	    PexObserve.ValueForViewing("New Index of x", New_arrListIndexOfX);
	    System.Diagnostics.Debug.Assert(New_Ret == true && New_arrListIndexOfX >= Old_arrListIndexOfX);
----------------------------------------------------------------------------------------------------------------------------------------------------------------	    Debug.Assert(New_Ret == Old_arrListIndexOfX);
--------------------