--------------------	    Debug.Assert(Old_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
----------------------------------------            if (!New_Ret)
            {
                Debug.Assert(New_arrListLastIndexOfX >= -1, "If the return value is false, last position of x in old list is >= -1");
--------------------------------------------------------------------------------            // and the new list has not contained x, @@@ If the return value is true, the list count should be equal to old list's count, and the index of x in new list is greater than old index of x.
            if (New_Ret == false)
            {
                PexObserve.ValueForViewing("$New_Ret", New_Ret);
            }
            else
            {
                PexObserve.ValueForViewing("$New_Ret", New_Ret);
                PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
