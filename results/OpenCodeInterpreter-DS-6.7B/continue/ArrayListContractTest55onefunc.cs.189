public ArrayListContract(ArrayList arrList, int index, object o)
{
    AssumePrecondition.IsNotNull(arrList);

    int Old_arrListCount = arrList.Count;

    bool New_Ret;

    arrList.Insert(index, o);
    New_Ret = arrList.Contains(o);

    int New_arrListCount = arrList.Count;

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$New_ret", New_Ret);

    PexAssert.IsTrue(New_arrListCount.Equals(Old_arrListCount + 1), "POST-CONTRACT: The Count property of the List<T> class must return a valid count value.");
    PexAssert.IsTrue(New_Ret, "POST: The Contains method for Insert returns false for the instance 'arrList' and the passed argument 'o'");
}
