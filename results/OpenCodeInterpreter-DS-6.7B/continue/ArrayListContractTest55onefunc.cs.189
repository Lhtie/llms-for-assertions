public ArrayListContract(ArrayList arrList, object o1, object o2)
{
    AssumePrecondition.IsNotNull(arrList);

    int Old_arrListCount = arrList.Count;

    bool New_Ret;

    if (o2 is int)
        arrList.Add(unchecked((int)o2));
    else
    {
        if (o2 is IEnumerable)
            foreach (object item in (IEnumerable)o2)
                arrList.Add(item);
        else
            arrList.Add(o2);
    }

    New_Ret = arrList.Contains(o1);

    int New_arrListCount = arrList.Count;

    int[] items = arrList.ToArray();

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$New_ret", New_Ret);

    PexAssert.IsTrue(New_arrListCount.Equals(Old_arrListCount + 1) || New_arrListCount.Equals(Old_arrListCount), "POST: The Count property of the List<T> class must return a valid count value.");
    PexAssert.IsTrue(New_Ret, "POST: The Contains method returns false for the instance 'arrList' and the passed argument 'o1'");
}
