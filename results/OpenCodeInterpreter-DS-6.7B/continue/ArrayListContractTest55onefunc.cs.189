}using Microsoft.CodeAnalysis.CSharp.Syntax;
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

namespace Roslyn_SyntaxWalker
{
    class Program
    {
        static void Main(string[] args)
        {
            string code = File.ReadAllText("test.cs");

            var parser = new CSharpSyntaxWalker();
            parser.Walk(code);

            Console.WriteLine("Hello Syntax Walker!");
            Console.ReadLine();
        }
    }

    public class CSharpSyntaxWalker
    {
        public void Walk(string code)
        {
            var tree = CSharpSyntaxTree.ParseText(code);
            var root = tree.GetRoot();

            var walker = new SyntaxWalker();
            walker.Visit(root);
        }
    }

    public class SyntaxWalker : CSharpSyntaxWalker
    {
        public override void VisitIdentifierName(IdentifierNameSyntax node)
        {
            Console.WriteLine($"Identifier: {node.Identifier}");
            base.VisitIdentifierName(node);
        }

        public override void VisitMethodDeclaration(MethodDeclarationSyntax node)
        {
            Console.WriteLine($"Method Name: {node.Identifier}");
            base.VisitMethodDeclaration(node);
        }
    }
}using System;

namespace Roslyn_SyntaxWalker
{
    public class Test
    {
        public static void Main()
        {
            Console.WriteLine("Hello Roslyn Walker!");
        }

        public void Hello()
        {
            Console.WriteLine("Hello World!");
        }
    }
