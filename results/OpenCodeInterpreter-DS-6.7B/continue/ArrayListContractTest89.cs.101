        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount  = arrList.Count;
            int Old_index = index;
            int Old_indexValue = (int)arrList[index];

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_value_at_index", Old_indexValue);

            // Assertion: New list count should be one less than old list count
            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);

            // Assertion: Old value at index in old array list is not in the new array list
            Assert.IsFalse(arrList.Contains(Old_indexValue));

            // Assertion: Index of old value at index in old array list is -1 in new array list
	    Assert.AreEqual(-1, arrList.IndexOf(Old_indexValue));

            // Assertion: LastIndexOfOld value at index in old array list in new array list is -1
	    Assert.AreEqual(-1, arrList.LastIndexOf(Old_indexValue));

	}

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // Assertion to check if New_arrList_Count is 0
            Assert.AreEqual(0, New_arrListCount);

            // Post-condtion: All elements removed in the old ArrayList should not exist in new
            foreach (int element in arrList)
            {
                Assert.IsFalse(Old_arrListCount.Contains(element));
            }

        }

