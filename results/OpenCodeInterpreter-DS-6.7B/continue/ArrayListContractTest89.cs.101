namespace PexAPIWrapper.Contract.PexAPI
{
    // Interface that holds the public methods for dealing with a PexAPI.

   
    // This interface is implemented by the PexTuple class,
    // which represents a tuple of objects for Pex testing.
    public interface IPexTuple
    {
        // Returns the number of elements in the tuple
        int Size
        {
            get;
        }

        // The element at specified index in the tuple
        object this[int index]
        {
            get;
            set;
        }
    }
