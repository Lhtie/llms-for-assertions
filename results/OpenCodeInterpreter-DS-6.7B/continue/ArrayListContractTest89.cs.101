//CQRS/CQRS.ApplicationService/CQRS.Core/Service/CqrsService.cs
﻿using CQRS.Core.Commands;
using CQRS.Core.Events;
using CQRS.Core.Queries;
using System;

namespace CQRS.Core.Service
{
    public class CqrsService : ICqrsService
    {
        private readonly IServiceProvider _provider;

        public CqrsService(IServiceProvider provider)
        {
            _provider = provider;
        }

        public void Send<TCommand>(TCommand command) where TCommand : ICommand
        {
            var handler = (ICommandHandler<TCommand>)_provider.GetService(typeof(ICommandHandler<TCommand>));
            handler.Handle(command);
        }

        public void Publish<TEvent>(TEvent @event) where TEvent : IEvent
        {
            var handlers = (IEventHandler<TEvent>[])_provider.GetServices(typeof(IEventHandler<TEvent>));
            foreach (var handler in handlers)
            {
                handler.Handle(@event);
            }
        }

        public TResult Query<TQuery, TResult>(TQuery query) where TQuery : IQuery<TResult>
        {
            var handler = (IQueryHandler<TQuery, TResult>)_provider.GetService(typeof(IQueryHandler<TQuery, TResult>));
            return handler.Handle(query);
        }
    }
}

//CQRS/CQRS.ApplicationService/CQRS.Core/Service/ICqrsService.cs
﻿using CQRS.Core.Commands;
using CQRS.Core.Events;
using CQRS.Core.Queries;

namespace CQRS.Core.Service
{
    public interface ICqrsService
    {
        void Send<TCommand>(TCommand command) where TCommand : ICommand;
        void Publish<TEvent>(TEvent @event) where TEvent : IEvent;
        TResult Query<TQuery, TResult>(TQuery query) where TQuery : IQuery<TResult>;
    }
}

//CQRS/CQRS.ApplicationService/DependencyRegistrations/CommandHandlerInstaller.cs
﻿using CQRS.Core.Commands;
using Castle.MicroKernel.Registration;
using Castle.MicroKernel.SubSystems.Configuration;
using Castle.Windsor;

namespace DependencyRegistrations
{
    public class CommandHandlerInstaller : IWindsorInstaller
    {
        public void Install(IWindsorContainer container, IConfigurationStore store)
        {
            // Register all the command handlers
            container.Register(Classes.FromThisAssembly()
                .BasedOn(typeof(ICommandHandler<>))
                .WithServiceAllInterfaces());
        }
    }
}

