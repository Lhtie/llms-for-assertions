    {
        public static void AreEqual(IEnumerable a, IEnumerable b)
        {
            if (a == null)
                throw new ArgumentNullException(nameof(a));

            if (b == null)
                throw new ArgumentNullException(nameof(b));

            var enA = a.GetEnumerator();
            var enB = b.GetEnumerator();
            while (enA.MoveNext())
            {
                enB.MoveNext();
                object obA = enA.Current;
                object obB = enB.Current;
                // compare obA and obB
            }
        }
    }
}

