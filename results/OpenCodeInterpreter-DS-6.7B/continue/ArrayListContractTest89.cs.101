        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            Assert.AreEqual(0, New_arrListCount);
        }

        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, Object[] objArray, int index)
        {
            AssumePrecondition.IsTrue(arrList.Count <= objArray.Length - index);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.CopyTo(objArray, index);

            int New_arrListCount = arrList.Count;
            int New_index = objArray[index] as ArrayList;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$new_index", New_index);

