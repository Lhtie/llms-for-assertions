﻿// Copyright (c) Microsoft Research 2016
// License: MIT. See LICENSE.txt

using System;

namespace Microsoft.Pex.Framework
{
    internal class TestTypeImpl : TestType
    {
        public override bool Equals(object obj)
        {
            if (this == obj)
            {
                return true;
            }
            return obj is TestTypeImpl && this.Equals((TestTypeImpl)obj);
        }

        public bool Equals(TestTypeImpl obj)
        {
            return base.Equals((TestType)obj) && this.TestField == obj.TestField;
        }

        public override int GetHashCode()
        {
            return base.GetHashCode() ^ this.TestField.GetHashCode();
        }

        public int TestField
        {
            get;
            private set;
        }

        public TestTypeImpl(int testField)
        {
            TestField = testField;
        }
    }
}

