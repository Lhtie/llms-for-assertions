```python
# Import the necessary libraries
import re
import pandas as pd
from selenium import webdriver
from bs4 import BeautifulSoup
import requests

def get_review(driver, product_url):
    driver.get(product_url)
    html = driver.page_source
    soup = BeautifulSoup(html, 'html.parser')
    reviews = soup.find_all('div', {'class': 'a-section'})
    review_texts = []
    for review in reviews:
        text = review.find('span', {'class': 'a-size-base'}).get_text()
        review_texts.append(text)
    return review_texts

url = 'https://www.amazon.com/product-reviews/B07WGJ2HJR/ref=acr_dgw_brws_hist_1?ie=UTF8&showViewpoints=1&sortBy=helpful'
driver = webdriver.Chrome('C:/Path/to/chromedriver.exe') # enter the path where you have installed the chrome driver
