            Debug.Assert(New_arrListIndexOfX <= Old_arrListCount && New_arrListLastIndexOfX <= Old_arrListCount);
----------------------------------------			Debug.Assert(New_arrListIndexOfX == Old_arrListCount, "@@@ last position of x after insertion is less than or equal to original array count");
----------------------------------------            Debug.Assert(New_arrListCount >= Old_arrListCount && New_arrListContainsX);
--------------------    	    Debug.Assert(arrList.IndexOf(x) <= arrList.Count); 
------------------------------------------------------------            // an assertion using "Debug.Assert\(.*?\);" is equal value to old array at this position
            Debug.Assert(New_arrListIndexOfX == Old_index);
