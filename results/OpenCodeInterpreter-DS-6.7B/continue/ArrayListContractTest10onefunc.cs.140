[Theory]
[PexClass(typeof(ArrayList))]
public class ArrayListTests
{
    [PexAssumeUnderTest]
    public ArrayList arrayList;

    [PexMethod]
    public void AddTest(int x)
    {
        int oldCount = arrayList.Count;
        arrayList.Add(x);
        PexObserve.ValueForViewing("Old Array List Count", oldCount);
    }
}
