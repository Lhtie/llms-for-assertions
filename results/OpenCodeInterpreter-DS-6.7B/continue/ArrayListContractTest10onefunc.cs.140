namespace SOLID.LiskovSubstitution.Problem
{
    class Program
    {
        static void Main(string[] args)
        {
            Rectangle rectangle = new Rectangle(2, 3);
            Console.WriteLine(rectangle.Area());  // output: 6

            Square square = new Square(4);
            Console.WriteLine(square.Area());  // output: 16

            square = new Rectangle(4, 2); // Compiler error
            Console.WriteLine(square.Area());
        }
    }

    public class Rectangle
    {
        public Rectangle(int width, int height)
        {
            Width = width;
            Height = height;
        }

        public int Width { get; set; }
        public int Height { get; set; }

        public int Area()
        {
            return Width * Height;
        }
    }

    public class Square : Rectangle
    {
        public Square(int side) : base(side, side)
        {
        }
    }
}
// End of class definition. Liskov's Substitution Principle (LSP) violated here. The subclass
// "Square" is substitutable for the superclass "Rectangle" which might not always give the expected output.

// In a Square, the width and height can't be different, but in Rectangle, they can, and that's what allows
// for an instance of Rectangle to be substituted for a Square. According to LSP, the instance of Rectangle
// shouldn't be substituted for a Square and it actually will cause problem when a square tries to substitute
// rectangle causing inconsistent and unexpected behavior.

// Hence, this violation breaks the principle of Liskov substitution. This would mean we--------------------        }

        [PexMethod]
        public void PUT_Add(ArrayList arrList, int x)
        {
            int index = arrList.Count;
            arrList.Add(x);
            Assert.AreEqual(index + 1, arrList.Count);
            Assert.AreEqual(x, arrList[index]);
            Assert.AreEqual(index, arrList.IndexOf(x));
            Assert.AreEqual(index, arrList.LastIndexOf(x));
        } 
    }
}
