[TestFixture]
public class PexAPIWrapper_Example_Test {

    [Test]
    [PexMethod]
    public void PexAPIExampleTest( [PexAssumeUnderTest] SimpleClass sc ) {

         int resultBefore = sc.Property1; 
         sc.IncrementProperty1();
         int resultAfter = sc.Property1;

         Assert.AreEqual( resultBefore + 1, resultAfter );
    }
