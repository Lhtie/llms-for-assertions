	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is not found, index of x in new array is == -1
		}

        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, Array array, int index)
        {
            AssumePrecondition.IsTrue(index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$", arrList);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If we copy 0 items from old array to new array, new array equals old array
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If we copy x items from old array to new array, new array ends with the same items as old array
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If we copy x items from old array into non-existing positions, new array equals old array
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If we copy x items from old array to new array, new array's first item equals old array's xth item
		}
    }
}

//tests/Pex/Tests/ArrayListTest/ArrayListTest.cs
﻿using System;
using System.Collections;
using System.Diagnostics;
// include other namespaces as necessary

using System.Text;

// the class to test
using ArrayList;

using NUnit.Framework;

namespace ArrayListTest
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void Test1()
        {
            // arrange
            ArrayList myArrayList = new ArrayList();

            // act
            int x = 10;
            int expectedIndex = myArrayList.Add(x);

            // assert
            Assert.Contains(x, myArrayList);
            Assert.AreEqual(expectedIndex, myArrayList.IndexOf(x));
            Assert.AreEqual(expectedIndex, myArrayList.LastIndexOf(x));
            Assert.IsTrue((bool)myArrayList.Contains(x));
            Assert.AreEqual(1, myArrayList.Count);
        }

        [Test]
        public void Test2()
        {
            // arrange
            ArrayList myArrayList = new ArrayList();
            int x = 10;
            myArrayList.Add(x);

            // act
            myArrayList.Remove(x);

            // assert
            Assert.IsFalse(myArrayList.Contains(x));
            Assert.AreEqual(0, myArrayList.Count);
        }
    }
}

