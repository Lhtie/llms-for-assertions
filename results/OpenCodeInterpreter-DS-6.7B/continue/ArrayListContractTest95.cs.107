    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void ArrayList_AddContractTest()
        {
            // The following test does not have an [PexMethod] attribute because it directly calls Contract
            // method tests that the code meets the contract defined by [PexMethod] attributes.
            // Since Assert.AreEqual is not covered by Pex, Pex is not feasible here.
            // 
            // The purpose of this test is to cover a small subset of contract methods to make sure
            // the code doesn't break the contract upon adding a new element.
            var arrList = new ArrayList();
            Assert.AreEqual(0, arrList.Add(1));
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(0, arrList.LastIndexOf(1));
            Assert.IsTrue(arrList.Contains(1));
        }
    }
}

