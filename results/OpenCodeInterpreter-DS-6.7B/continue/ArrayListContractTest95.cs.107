//source/Pex/SampleTests/FibonacciContractTest.cs
using System;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;

using NUnit.Framework;

namespace Fibonacci
{
    [TestFixture]
    [PexClass(MaxInclusiveLength = 1000)]
    [PexAllowedException(typeof(System.StackOverflowException))]
    public partial class FibonacciContractTest
    {
        [PexMethod]
        public void Fibonacci_EdgeCasesAndInvariants_RegularBehaviorTest(int n)
        {
            Assume.That(n >= 0);

            int result = Fibonacci(n);

            if (n <= 1)
            {
                Assert.AreEqual(n, result);
            }
            else
            {
                Assert.AreEqual(Fibonacci(n - 1) + Fibonacci(n - 2), result);
            }
        }

        private int Fibonacci(int n)
        {
            if (n <= 1)
            {
                return n;
            }
            else
            {
                return Fibonacci(n - 1) + Fibonacci(n - 2);
            }
        }
    }
}

//source/Utilities/Microsoft.Pex.Framework.TestHarness/Microsoft.Pex.Framework.TestHarness/TestRunner.cs
/// <summary>
/// A simple TestRunner class that runs PexTests.
/// </summary>
/// <remarks>
/// <para>
/// Copyright (c) 2019 Microsoft Corporation. All rights reserved.
/// Licensed under the MIT License.
/// </para>
/// <para>
/// The general idea here is that the runner will be responsible for finding the test 
/// cases that Pex needs to run and running them.  It'll manage the output so that the user
/// can see the results of Pex testing without additional configuration.
/// </para>
/// </remarks>

namespace Microsoft.Pex.Framework.TestHarness
{
    using System;
    using System.Collections.Generic;
    using System.Diagnostics;
    using System.IO;
    using System.Linq;
    using System.Text;
    using System.Threading.Tasks;
    using Microsoft.Pex.Common;
    using Microsoft.Pex.Framework.Contracts;
    using Microsoft.Pex.Framework.Instrumentation;
    using Microsoft.Pex.Framework.TestHarness.TestFramework;
    using Microsoft.Pex.Framework.TestSource;
    using Microsoft.Pex.Interfaces;

    public class TestRunner
    {
        public TestRunOutput RunPexTests(string testAssemblyName, AssemblyTestAssemblySettings settings)
        {
            var output = new TestRunOutput();

            try
            {
                var pexAssembly = AssemblyPathResolver.Resolve(typeof(PexRunner).Assembly.GetName());
                var resultsDirectory = Path.GetDirectoryName(testAssemblyName);
                var resultsFilename = Path.Combine(resultsDirectory, "PexResults");
                var test = new RunnerTest(resultsFilename, settings, pexAssembly);
                test.InitializeResultsDirectory();
                var instrumentationManager = new InstrumentationManager(test--------------------	    //  @@@ If the return value is non-negative, Lastindex of x in new array is >= 0 
	    //  @@@ If the return value is non-negative, new array contains x
        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfIndex = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfIndex = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsIndex = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfIndex = arrList.IndexOf(arrList[index]);
            int New_arrListLastIndexOfIndex = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsIndex = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_index", Old_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_index", New_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_index", Old_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_index", New_arrListLastIndexOfIndex);
            PexObserve.ValueForViewing("$old_arrList_contains_index", Old_arrListContainsIndex);
            PexObserve.ValueForViewing("$new_arrList_contains_index", New_arrListContainsIndex);
        }

        ///
        /// Testing Copy To
        ///
        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, Array[] destination, int index)
        {
            AssumePrecondition.IsTrue(destination != null && index <= destination.Length && index >= 0 && arrList.Count + destination.Length - 1 - index >= 0);

            Array oldDestination = destination.DeepCopy();
            int Old_arrListCount = arrList.Count;

            arrList.CopyTo(destination, index);

            int New_arrListCount = arrList.Count;

            int[] array = new int[destination.Length];
            for (int i = 0; i < destination.Length; i++)
            {
                array[i] = (int)destination[i];
            }

            bool allCorrect = true;
            for (int i = 0; i < Old_arrListCount; i++)
            {
                if ((i >= index && i - index < Old_arrListCount) && arrList[i - index] != array[i])
                {
                    allCorrect = false;
                    break;
                }

                if ((i < index || i - index >= Old_arrListCount))
                {
                    if ((int)destination[i] != oldDestination[i])
                    {
                        allCorrect = false;
                        break;
                    }
                }
            }

            PexObserve.ValueForViewing("$allCorrect", allCorrect);
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            for (int i = 0; i < destination.Length; i++)
            {
                PexObserve.ValueForViewing("destination["+i+"]", array[i]);
           --------------------	    // PexFrameworkHelpers.AssertIsTrue(New_Ret >= 0, "test failed");	
        }
    }
}

//FoCs/FoCs/FoCs/Core/CodeContracts/ArrayList/ArrayListContract.cs
// NRefactory Copyright (c) 2001-2008 Rodrigo B. de Oliveira

using System;
using System.Diagnostics;
using System.Text;

using NRefactory.Ast;
using NRefactory.PrettyPrinter;

namespace NRefactory.CodeContracts.CSharp
{
    [CodeContractProvider]
    public class ArrayListCodeContractProvider : AbstractCodeContractProvider
    {
        public override CodeContract[] GetContracts(AstNode node)
        {
            ArrayListCodeGenerator generator = new ArrayListCodeGenerator();
            switch (node.GetType().Name) {
                case "AddMethod":
                    return new[] { generator.AddContract(node) };
                case "RemoveMethod":
                    return new[] { generator.RemoveContract(node) };
                case "InsertMethod":
                    return new[] { generator.InsertContract(node) };
                case "SetMethod":
                    return new[] { generator.SetContract(node) };
                case "GetIndexer":
                    return new[] { generator.GetContract(node) };
                case "ContainsMethod":
                    return new[] { generator.ContainsContract(node) };
                case "IndexOfMethod":
                    return new[] { generator.IndexOfContract(node) };
                case "LastIndexOfMethod":
                    return new[] { generator.LastIndexOfContract(node) };
                default:
                    return new CodeContract[0];
            }
        }
    }
}

//FoCs/FoCs/FoCs/Core/CodeContracts/ArrayList/CodeGeneratorTemplates/InsertContractCodeTemplate.cs
// NRefactory Copyright (c) 2001-2008 Rodrigo B. de Oliveira

using System;
using System.Diagnostics;
using System.Text;

using NRefactory.Ast;

namespace NRefactory.CodeContracts.CSharp
{
    [CodeGeneratorTemplate]
    public class InsertContractTemplate : AbstractCodeGeneratorTemplate
    {
        public override CodeContractCode Generate(AstNode node)
        {
            MethodDeclaration m = (MethodDeclaration)node;
            SimpleTypeExpression elemTypeExpr = m.ReturnType as SimpleTypeExpression;

            return TemplateHelper.GenerateContract(node,
                "    AssumePrecondition.IsTrue(New_arrList_Count == Old_arrList_Count + 1);",
                "    [PexPostCondition] public void Postcondition() { "
                + "Debug.Assert(New_arrList_LastIndexOf_x != Old_arrList_LastIndexOf_x); }"
                + "    [PexMethodRepresentation] private void Rep() { "
                + "// TODO: write your code here }"
                + "    [PexExplorationBoundary] private void Boundary() { "
                + "// TODO: write your code here }"
                + "    [PexProperty] private int Old_arrListCount, Old_arrListCount_AfterAdd, New_arrListCount;",

                "    PexObserve.ValueForViewing(" + TemplateHelper.Wrap("$old_arrList_Count") + ", Old_arrListCount);",
                "    PexObserve.ValueForViewing(" + TemplateHelper.Wrap("$new_arrList_Count") + ", New_arrListCount);"
                + "    PexObserve.ValueForViewing(" + TemplateHelper.Wrap("$old_arrList_LastIndexOf_x") + ", Old_arrListLastIndexOfX);"
                + "    PexObserve.ValueForViewing(" + TemplateHelper.Wrap("$new_arrList_LastIndexOf_x") + ", New_arrListLastIndexOfX);"

				);
        }
    }
}

