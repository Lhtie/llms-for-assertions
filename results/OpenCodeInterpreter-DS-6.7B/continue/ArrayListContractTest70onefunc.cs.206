[TestMethod]
public void IndexOfNull_Test()
{
    // Arrange
    ArrayList arrList = new ArrayList() {null, 3, 5, 6, 3}; // {null, 3, 5, 6, 3}
    
    // Act
    int index = arrList.IndexOf(null);
    
    // Assert
