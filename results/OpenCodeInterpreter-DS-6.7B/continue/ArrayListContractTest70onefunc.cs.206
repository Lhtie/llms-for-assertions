## <a name="example-property-contract-test"></a>示例：属性合约测试

```csharp
using System.Diagnostics;
using Microsoft.Pex.Framework;

namespace SampleNamespace
{
    [TestClass]
    public partial class SampleTestClass
    {
        [PexMethod]
        public void PropertyContractTest([PexAssumeNotNull] SampleClass instance)
        {
            // This is a property test for the 'MyProperty' property of the 'SampleClass'.
            int OldValue = instance.MyProperty; // Get the value before the action
            instance.MyProperty = instance.MyProperty; // Action: Set the property to its current value
            int NewValue = instance.MyProperty; // Get the value after the action

            // Postcondition: The property should always return the same value it was set with.
            Debug.Assert(OldValue == NewValue);
        }
    }    
}
```
