def min_jumps(arr: List[int]) -> int:
    n = len(arr)
    jumps = [0 for _ in range(n)]
    if n == 0 or arr[0] == 0:
        return float('inf')
    jumps[0] = 0
    
    for i in range(1, n):
        temp = float('inf')
        for j in range(i):
            if i <= j + arr[j] and jumps[j] != float('inf'):
                temp = min(temp, jumps[j] + 1)
                break
        if temp != float('inf'):
            jumps[i] = temp
    
    return jumps[n - 1] if jumps[n - 1] != float('inf') else -1

