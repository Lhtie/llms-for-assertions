    assert a1>=0 and a2>=0, "Invalid values passed in"
--------------------    assert (a1 >= 0 and a2 >= 0), "Area hasn't been calculated yet"
--------------------    assert (a1==a1 and a2==a2), "Incorrect values"
--------------------    assert (a1>=0 and a2>=0 ), "Area isn't defined"
--------------------    assert (a1>=0 and a2>=0), "Error in calculating area"
--------------------    assert a1>=0 and a2>=0, "Area not initialized correctly"
--------------------    assert (a1>=0 and a2>=0), "Areas haven't been calculated"
--------------------    assert (a1>0 and a2>0), "Error in finding area"    
--------------------    assert(a1>=0 and a2>=0), "Not initialized"
    return max(a1, a2)

def compare_p(s1, s2):
    '''returns perimeter of shape with larger perimeter'''
    p1, p2 = s1.perimeter, s2.perimeter
    # an assertion that p1 and p2 holds the correct value of perimeter
    assert(p1>=0 and p2>=0), "Not initialized"
    return max(p1, p2)


if __name__ == '__main__':

    r = Rectangle(5,7)
    # an object r of class Rectangle
    assert r.len == 5 and r.wid == 7 and r.area == 35 and r.perimeter == 24, "Incorrect Rectangle initialization"
