﻿using UnityEngine;
using UnityEngine.Tilemaps;

namespace Platformer.Core
{
    public class PlayerController : MonoBehaviour
    {
        public float Speed = 5.0f;
        public float JumpForce = 250.0f;
        bool _jumping = false;
        private Animator _animator;
        bool _isFacingRight = false;
        public Tilemap tilemap;
        Player player;
        bool wasGrounded;

        private void Start()
        {
            _animator = GetComponent<Animator>();
            player = GetComponent<Player>();
            player.OnPlayerMove += Player_OnPlayerMove;
            player.OnPlayerJump += Player_OnPlayerJump;
        }

        private void Update()
        {
            var movement = Input.GetAxis("Horizontal");
            _animator.SetFloat("Speed", Mathf.Abs(movement));

            if (movement > 0 && !_isFacingRight)
                Flip();
            else if (movement < 0 && _isFacingRight)
                Flip();
            if (!wasGrounded && player.IsGrounded)
            {
                _animator.SetBool("Jumping", false);
            }
            if (player.IsGrounded)
                _jumping = false;
            wasGrounded = player.IsGrounded;
        }

        private void Player_OnPlayerJump()
        {
            _animator.SetBool("Jumping", true);
        }

        private void Player_OnPlayerMove(float obj)
        {
            transform.Translate(new Vector3(obj * Speed * Time.deltaTime, 0, 0));
        }

        private void Flip()
        {
            _isFacingRight = !_isFacingRight;
            Vector3 theScale = transform.localScale;
            theScale.x *= -1;
            transform.localScale = theScale;
        }
    } 
}

