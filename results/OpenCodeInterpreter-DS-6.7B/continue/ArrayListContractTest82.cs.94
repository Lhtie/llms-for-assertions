        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, int[] array)
        {
            AssumePrecondition.IsTrue(array != null && array.Length > 0);

            int Old_arrListCount = arrList.Count;
            int Old_Count_array = array.Length;
            bool Old_arrListContains_arrayAll = array.All(arrList.Contains);

            arrList.AddRange(array);

            int New_arrListCount = arrList.Count;
            bool New_arrListContains_arrayAll = array.All(arrList.Contains);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_Count_array", Old_Count_array);
            PexObserve.ValueForViewing("$old_arrList_Contains_arrayAll", Old_arrListContains_arrayAll);
            PexObserve.ValueForViewing("$new_arrList_Contains_arrayAll", New_arrListContains_arrayAll);

        }

        [PexMethod]
        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, int startIndex, int count)
        {
            AssumePrecondition.IsTrue(startIndex >= 0 && startIndex < arrList.Count && count <= arrList.Count - startIndex && count > 0);

            int Old_arrListCount = arrList.Count;
            int Old_startIndex = startIndex;
            int Old_count = count;
            bool Old_arrListContainsAll = arrList.Skip(startIndex).Take(count).All(arrList.Contains);

            arrList.RemoveRange(startIndex, count);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsAll = arrList.Take(New_arrListCount - Old_count).All(arrList.Contains);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_startIndex", Old_startIndex);
