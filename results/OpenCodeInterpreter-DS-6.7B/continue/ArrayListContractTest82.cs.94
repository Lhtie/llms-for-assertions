﻿using NUnit.Framework;
using PexAPIWrapper;

namespace TestStackOverFlow
{
    [TestFixture]
    public class TestClass
    {
        [Test]
        public void TestMethod()
        {
            var q = new Questions();

            PexAPIWrapper.User u1 = new PexAPIWrapper.User()
            {
                Id = 1,
                Name = "User1"
            };

            PexAPIWrapper.User u2 = new PexAPIWrapper.User()
            {
                Id = 2,
                Name = "User2"
            };

            q.AcceptAnswer(u1, 1);
            q.AcceptAnswer(u2, 2);

            Assert.That(q.GetAcceptedAnswer() == "The question is not accepted yet");

            q.AcceptAnswer(u1, 1);
            Assert.That(q.GetAcceptedAnswer() == "The question is accepted by User1");
        }
    }
}

