```python
class ArrayList:
    def __init__(self):
        self.arr = []

    def Add(self, x):
        self.arr.append(x)
        return len(self.arr)

    def Remove(self, x):
        if x in self.arr:
            self.arr.remove(x)

    def Insert(self, index, x):
        self.arr.insert(index, x)

    def Contains(self, x):
        return x in self.arr

    def IndexOf(self, x):
        return self.arr.index(x) if x in self.arr else -1

    def LastIndexOf(self, x):
        return self.arr.index(x) if x in self.arr else -1

    def Get(self, index):
        return self.arr[index]

# Test cases

# Test case 1: Adding an element to an empty array list
arrList = ArrayList()
assert arrList.Add(5) == 1

