using System.Linq;
using ArrayList;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public class SortTest
    {
        [Test]
        public void TestSort()
        {
            var arrList = new ArrayList(new[]{12, 23, 34, 45, 56, 67, 43, 108, 154, 201});
            arrList.Sort();
            CollectionAssert.AreEqual(new[]{12, 23, 34, 43, 45, 56, 67, 108, 154, 201}, arrList.ToArray());

            arrList = new ArrayList(new[]{12, 23, 34, 45, 56, 67, 43, 108, 154, 201}.Reverse());
            arrList.Sort();
            CollectionAssert.AreEqual(new[]{12, 23, 34, 43, 45, 56, 67, 108, 154, 201}, arrList.ToArray());
        }
    }
}

