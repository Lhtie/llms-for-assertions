// PUT_AddContract_Test.cs
public class PUT_AddContract_Test
{
  [Test]
  public void TestCase()
  {
    var test = new ArrayList();
    var ret = test.Add(2);
    Assert.AreEqual(1, test.Count);
    Assert.AreEqual(0, test.IndexOf(2));
    Assert.AreEqual(0, test.LastIndexOf(2));
    Assert.IsTrue(test.Contains(2));
   }
}

// PUT_RemoveContract_Test.cs
public class PUT_RemoveContract_Test
{
  [Test]
  public void TestCase()
  {
  var test = new ArrayList();
  test.Add(2);
  var ret = test.Remove(2);
  Assert.AreEqual(0, test.Count);
  Assert.AreEqual(-1, test.IndexOf(2));
  Assert.AreEqual(-1, test.LastIndexOf(2));
  Assert.IsFalse(test.Contains(2));
 }
}

// PUT_InsertContract_Test.cs
public class PUT_InsertContract_Test
{
  [Test]
  public void TestCase()
  {
    var test = new ArrayList();
    var ret = test.Insert(0, 2);
    Assert.AreEqual(1, test.Count);
    Assert.AreEqual(0, test.IndexOf(2));
    Assert.AreEqual(0, test.LastIndexOf(2));
    Assert.IsTrue(test.Contains(2));
 }
}
