        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, int[] xArray)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfFirstXArray = arrList.IndexOf(xArray[0]);
            int Old_arrListLastIndexOfFirstXArray = arrList.LastIndexOf(xArray[0]);

            arrList.AddRange(xArray);
            int New_arrListCount = arrList.Count;

            int New_arrListIndexOfFirstXArray = arrList.IndexOf(xArray[0]);
            int New_arrListLastIndexOfFirstXArray = arrList.LastIndexOf(xArray[0]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_First_XArray", Old_arrListIndexOfFirstXArray);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_First_XArray", New_arrListIndexOfFirstXArray);
