//Services/IUserService.cs
﻿using ConsoleApp1.DTOs;
using ConsoleApp1.Models;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApp1.Services
{
    public interface IUserService
    {
        UserDto GetUser(int id);

        User RegisterUser(User user);
    }
}

//Services/UserService.cs
﻿using AutoMapper;
using ConsoleApp1.DTOs;
using ConsoleApp1.Models;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApp1.Services
{
    public class UserService : IUserService
    {
        private readonly IMapper mapper;

        public UserService(IMapper mapper)
        {
            this.mapper = mapper;
        }

        public UserDto GetUser(int id)
        {
            var user = new User { Id = id, Name = "Test", Email = "test@test.com" };
            var userDto = mapper.Map<UserDto>(user);
            return userDto;
        }

        public User RegisterUser(User user)
        {
            throw new NotImplementedException();
        }
    }
}

//Program.cs
﻿using AutoMapper;
using ConsoleApp1.DTOs;
using ConsoleApp1.Models;
using ConsoleApp1.Services;
using System;

namespace ConsoleApp1
{
    class Program
    {
        static void Main(string[] args)
        {
            var config = new MapperConfiguration(cfg =>
            {
                cfg.CreateMap<User, UserDto>()
                .ForMember(dest => dest.UserId, opt => opt.MapFrom(src => src.Id));
            });

            IMapper mapper = config.CreateMapper();
            IUserService userService = new UserService(mapper);
            var userDto = userService.GetUser(1);
            Console.WriteLine(userDto.UserId);
        }
    }
}//RPG_Assist/Models/Player.cs
