            var services = new ServiceCollection();

            services.AddSingleton(configuration);
            services.AddHttpClient();
            services.AddHttpContextAccessor();
            services.AddLogging(_ => _.AddNLog());

            services.AddSingleton<StorylineHttpClient>();
            services.AddSingleton<StorylineWriter>();

            var provider = services.BuildServiceProvider();

            var logger = provider.GetService<ILoggerFactory>().CreateLogger<Storyline>();
            logger.LogInformation("Storyline initializing");

            InitializeLogger(configuration);

            var client = provider.GetService<StorylineHttpClient>();
            client?.Initialize();

            logger.LogInformation("Storyline initialized");
