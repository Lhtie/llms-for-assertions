--------------------------------------------------------------------------------
        }

        [PexMethod]
        public void PUT_RemoveAtIndex1999_Contract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            bool AssumePrecondition_IsTrue = (index >= 0) && (index < Old_arrListCount);
            AssumePrecondition.IsTrue(AssumePrecondition_IsTrue);

            int Old_arrListIndexOf = arrList.IndexOf(arrList[0]);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOf = arrList.IndexOf(arrList[0]);
            bool New_arrList_contains_zeroindex = arrList.Contains(arrList[0]);

            arrList.RemoveAt(index);

            int Final_arrListCount = arrList.Count;

            int Final_arrListIndexOf = arrList.IndexOf(arrList[0]);
            bool Final_arrList_contains_zeroindex = arrList.Contains(arrList[0]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$old_arrListIndexOf", Old_arrListIndexOf);
            PexObserve.ValueForViewing("$new_arrListIndexOf", New_arrListIndexOf);
            PexObserve.ValueForViewing("$new_arrList_contains_zeroindex", New_arrList_contains_zeroindex);
            PexObserve.ValueForViewing("$final_arrListCount", Final_arrListCount);
            PexObserve.ValueForViewing("$final_arrListIndexOf", Final_arrListIndexOf);
            PexObserve.ValueForViewing("$final_arrList_contains_zeroindex", Final_arrList_contains_zeroindex);

        }
    }
}

    
    
    
    
    
 
