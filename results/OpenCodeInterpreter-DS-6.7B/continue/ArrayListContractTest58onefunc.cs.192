//AutoTest/NUnitAssert/NUnitResult.cs
﻿using System;

namespace NUnitAssert
{
    public class NUnitResult
    {
        private string methodName;
        private ResultType resultType;
        private string errorMessage;
        private string errorStackTrace;

        public enum ResultType
        {
            Success,
            Error
        }

        public NUnitResult(string methodName, ResultType resultType, string errorMessage = "", string errorStackTrace = "")
        {
            this.methodName = methodName;
            this.resultType = resultType;
            this.errorMessage = errorMessage;
            this.errorStackTrace = errorStackTrace;
        }

        public string GetResult()
        {
            if (resultType == ResultType.Success)
                return $"Method {methodName} passed successfully.";
            else
                return $"Method {methodName} failed with error: {errorMessage}\nStack Trace:\n{errorStackTrace}";
        }
    }
}

