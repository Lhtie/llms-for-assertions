```csharp
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        private static bool containsTestImpl(bool condition, int oldCount, int oldIndex, int newCount, int newIndex)
        {
            if (condition)
            {
                Assert.AreEqual(oldCount, newCount);
                Assert.IsTrue(oldIndex == -1 || newIndex >= oldIndex);
            }
            else
            {
                PexObserve.ValueForViewing("oldIndex", oldIndex);
                PexObserve.ValueForViewing("newIndex", newIndex);
                 Assert.IsTrue(oldIndex == -1 || oldIndex < newIndex);
            }
            return condition;
        }
    }
}
```

