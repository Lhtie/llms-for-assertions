namespace Viper.Compiler
{
    public class ViperAstError
    {
        public ViperAstError(string message, string fileName, int line, int column, int errorNumber)
        {
            if (string.IsNullOrWhiteSpace(message))
            {
                throw new ArgumentNullException(nameof(message));
            }

            if (string.IsNullOrWhiteSpace(fileName))
            {
                throw new ArgumentNullException(nameof(fileName));
            }

            if (line < 0)
            {
                throw new ArgumentOutOfRangeException(nameof(line), "Line number must be non-negative");
            }

            if (column < 0)
            {
                throw new ArgumentOutOfRangeException(nameof(column), "Column number must be non-negative");
            }

            if (errorNumber <= 0)
            {
                throw new ArgumentOutOfRangeException(nameof(errorNumber), "Error number must be positive");
            }

            Message = message;
            FileName = fileName;
            Line = line;
            Column = column;
            ErrorNumber = errorNumber;
        }

        public string Message { get; }

        public string FileName { get; }

        public int Line { get; }

        public int Column { get; }

        public int ErrorNumber { get; }
    }
}// Copyright (c) Microsoft Research 2016
