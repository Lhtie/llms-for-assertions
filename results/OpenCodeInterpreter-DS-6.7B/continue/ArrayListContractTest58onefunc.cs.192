{
    AssumePrecondition.IsTrue(true);

    // Remember the initial state of the ArrayList
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

    // Call the method we are testing
    bool New_Ret = arrList--------------------            if (!New_Ret) {
                Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
                PexAssume.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
            }
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, last index of x before is more than or equal to after
            if (!New_Ret) {
                Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
                PexAssume.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
            }
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, x before is not in the arrayList after
            if (!New_Ret) {
                Debug.Assert(arrList.Contains(Old_x));
                PexAssume.IsTrue(arrList.Contains(Old_x));
            }
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, x still exists in the arrayList after
            if (!New_Ret) {
                Debug.Assert(arrList.Contains(Old_x) == (New_arrListIndexOfX >= 0 && New_arrListIndexOfX < arrList.Count));
                PexAssume.IsTrue(arrList.Contains(Old_x) == (New_arrListIndexOfX >= 0 && New_arrListIndexOfX < arrList.Count));
            }

		    Debug.Assert(arrList.Count == Old_arrListCount);
        }
    }
}

