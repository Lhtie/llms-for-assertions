using ArrayList.Test;
using NUnit.Framework;
using NUnitAssert;
using System;
using System.Collections;

public partial class ArrayListContractTest
{
    [Test]
    public void Index_Of_ContractTest(ArrayList arrList, int x, int y)
    {
        Assume.True(x != y);

        // Setup
        arrList.Add(x);
        arrList.Add(y);

        // Execute
        int oldIndex1 = arrList.IndexOf(x);
        arrList.RemoveAt(0);
        int newIndex1 = arrList.IndexOf(x);
        int newIndex2 = arrList.IndexOf(y);

        Assert.AreEqual(oldIndex1, newIndex1);
        Assert.AreEqual(newIndex2, arrList.Count - 1);
    }
}

