using System.ComponentModel;

namespace ArrayList.Test
{

    public class ArrayListContractTest
    {
    }
    public partial class ArrayListContractTest
    {
        public partial class PUT_RemoveAtContract
        {
            public void Test(int count, int old_count, int index, int new_count)
            {
                AssumePrecondition.IsTrue(true);
                AssumePrecondition.InRange(index, 0, old_count, "Index");
                AssumePrecondition.IsTrue(new_count == old_count - 1, "Old count should be one less than new count");

                arrList.RemoveAt(index);

                Assert.IsTrue(arrList.Count == new_count, "New count should be equal to old count minus one");

                return;
            }
        }
    }
