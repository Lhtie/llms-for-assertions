using System.ComponentModel;

namespace ArrayList.Test
{

    public class ArrayListContractTest
    {
    }
    internal class PUT_GetSetContract
    {
        [EditorBrowsable(EditorBrowsableState.Never)]
        public virtual void Test([PexAssumeUnderTest]ArrayList arrList, int index, object newItem)
        {
            AssumePrecondition.IsFalse(arrList.IsReadOnly, "The list is read-only.");
            Assert.IsTrue(index >= 0 && index < arrList.Count, "Index is out of bounds.");

            int oldCount = arrList.Count;
            arrList[index] = newItem;
            Assert.AreEqual(oldCount, arrList.Count, "The count of the list should not have changed.");
            Assert.AreEqual(newItem, arrList[index], "The element at the given index should have been set to the newly specified value.");
        }
    }
