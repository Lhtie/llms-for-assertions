            if (!New_Ret)
            {
                Debug.Assert(Old_arrListIndexOfX >= 0 && New_arrListIndexOfX < 0 || (Old_arrListIndexOfX == New_arrListIndexOfX && Old_arrListIndexOfX >= 0));
                // an assertion that @@@ If the return value is false, lastIndex of x before is more than or equal to after
                Debug.Assert(Old_arrListLastIndexOfX >= 0 && New_arrListLastIndexOfX < 0 || (Old_arrListLastIndexOfX == New_arrListLastIndexOfX && Old_arrListLastIndexOfX >= 0));
            }
        }
    }
}
```

[Test] 
public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, [PexPositiveValue] int x)
{
	var arrListCopy = new ArrayList(arrList);
	var hasXBefore = arrList.Contains(x);
	arrList.Add(x);
	var hasXAfter = arrList.Contains(x);
	PexObserve.ValueForViewing("arrListHasXBefore", hasXBefore);
	PexObserve.ValueForViewing("arrListHasXAfter", hasXAfter);

	Assert.AreEqual(hasXBefore, arrListCopy.Contains(x));
}

You can also add the following attributes to the test method to make it a "boundary" test:
- PexPathBoundaryAttribute (test the upper bound of a method argument)
- PexBoundaryAttribute (test the boundary of a method argument)
- [PexAllPathsAttribute](attribute to run all paths in the program where the method is invoked, regardless of other test method settings)

#### Run PEX Tests

To run PEX tests, choose “PEX Test” from the main menu or from the context menu of the code you want to test. 

Alternatively, right-click your test method name in the Test Explorer window, point to “Run Tests”, and select “PEX Test”. The PEX test runs as an ordinary test and shows up in the Test Explorer.

