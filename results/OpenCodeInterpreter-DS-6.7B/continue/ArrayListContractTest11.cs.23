using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Tests
{
    [TestFixture]
    public class ArrayListTests
    {
        [SetUp]
        public void Setup()
        {
        }

        [Test]
        public void TestAdd()
        {
            var arrList = new ArrayList();
            var x = 5;
            var expected = arrList.Count;
            arrList.Add(x);
            Assert.AreEqual(expected + 1, arrList.Count);
            Assert.AreEqual(expected, arrList.IndexOf(x));
            Assert.AreEqual(expected, arrList.LastIndexOf(x));
        }

        [Test]
        public void TestClear()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void TestContains()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            Assert.IsTrue(arrList.Contains(1));
            Assert.IsFalse(arrList.Contains(2));
        }

        [Test]
        public void TestInsert()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.Insert(1, 3);
            Assert.AreEqual(3, arrList[1]);
        }

        [Test]
        public void TestRemove()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Remove(1);
            Assert.AreEqual(0, arrList.Count);
        }

        [Test]
        public void TestRemoveAt()
        {
            var arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add(2);
            arrList.RemoveAt(0);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(2, arrList[0]);
        }
    }
}

