namespace ConsoleApp1
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Enter the length and width of the rectangle:");
            double length = Convert.ToDouble(Console.ReadLine());
            double width = Convert.ToDouble(Console.ReadLine());

            Rectangle rectangle = new Rectangle(length, width);


            Console.WriteLine("Area of Rectangle : " + rectangle.GetArea());
            Console.WriteLine("Perimeter of Rectangle : " + rectangle.GetPerimeter());

            Console.ReadKey();
        }
    }
    class Rectangle
    {
        double length;
        double width;

        public Rectangle(double length, double width)
        {
            this.length = length;
            this.width = width;
        }

        public double GetArea()
        {
            return length * width;
        }

        public double GetPerimeter()
        {
            return 2 * (length + width);
        }
    }
}using System;
using System.Diagnostics;
using System.Linq;
using System.Reflection;

public static class AppInfo
{
    static Lazy<string> executingAssemblyName = new Lazy<string>(() =>
    {
        var entryAssembly = Assembly.GetEntryAssembly();
        if (entryAssembly != null)
        {
            return entryAssembly.FullName;
        }
        else
        {
            // This will work if the assembly is not running but a referenced library.
            // The main program will be the one running the tests or the program to run.
            var thisAssembly = Assembly.GetExecutingAssembly();
            return thisAssembly.FullName;
        }
    });

    public static string AssemblyName
    {
        get
        {
            var name = executingAssemblyName.Value;
            return name.Split(',').First();
        }
    }

    public static string AssemblyVersion
    {
        get
        {
            var version = FileVersionInfo.GetVersionInfo(Assembly.GetExecutingAssembly().Location).FileVersion;
            return version;
        }
    }
