}namespace TestingLab2016
{
    public class QuadraticEquation
    {
        private double _a;
        private double _b;
        private double _c;

        public QuadraticEquation(double a, double b, double c)
        {
            _a = a;
            _b = b;
            _c = c;
        }

        public double Discriminator()
        {
            return _b * _b - 4 * _a * _c;
        }

        public double[] Roots()
        {
            double disc = Discriminator();
            if (disc < 0)
                return new double[0]; //no roots
            else if (disc == 0)
            {
                double x = -_b / (2 * _a);
                return new[] {x};
            }
            else
            {
                double sqrtDisc = System.Math.Sqrt(disc);
                double x1 = (-_b + sqrtDisc) / (2 * _a);
                double x2 = (-_b - sqrtDisc) / (2 * _a);
                return new[] {x1, x2};
            }
        }

        public static void Main()
        {
            var qe = new QuadraticEquation(1, -3, 2);
            double[] roots = qe.Roots();
            System.Console.WriteLine(string.Join(", ", roots));
        }
    }
