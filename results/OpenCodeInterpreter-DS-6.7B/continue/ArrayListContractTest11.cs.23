//FruitShop.Application/Features/FruitFeatures/Queries/GetFruitByIdQuery.cs
using MediatR;
using FruitShop.Application.DTOs.FruitDTOs;
using FruitShop.Application.Interfaces;
using Microsoft.EntityFrameworkCore;
using System.Threading;
using System.Threading.Tasks;

namespace FruitShop.Application.Features.FruitFeatures.Queries
{
    public class GetFruitByIdQuery : IRequest<FruitDTO>
    {
        public int Id { get; set; }
        public class GetFruitByIdQueryHandler : IRequestHandler<GetFruitByIdQuery, FruitDTO>
        {
            private readonly IApplicationDbContext _context;
            public GetFruitByIdQueryHandler(IApplicationDbContext context)
            {
                _context = context;
            }
            public async Task<FruitDTO> Handle(GetFruitByIdQuery query, CancellationToken cancellationToken)
            {
                var fruit = await _context.Set<Domain.Entities.Fruit>().Where(f => f.Id == query.Id).FirstOrDefaultAsync();
                if (fruit == null) return null;
                return new FruitDTO
                {
                    Id = fruit.Id,
                    Name = fruit.Name,
                    Price = fruit.Price
                };
            }
        }
    }
}

