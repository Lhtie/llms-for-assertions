﻿using System;
using System.ComponentModel.DataAnnotations;

namespace Model.DataAccess
{
    public class Book
    {
        [Key]
        public int Id { get; set; }
        public string Title { get; set; }
        public string Author { get; set; }
        public DateTime ReleaseDate { get; set; }
    }
}

//Model/CustomValidation/BookValidationAttribute.cs
﻿using System.ComponentModel.DataAnnotations;
using Model.DataAccess;

namespace Model.CustomValidation
{
    public class BookValidationAttribute : ValidationAttribute
    {
        public override bool IsValid(object value)
        {
            if (value != null && value is Book book)
            {
                return !string.IsNullOrWhiteSpace(book.Title) && !string.IsNullOrWhiteSpace(book.Author) &&
                       book.ReleaseDate.Year >= 1400;
            }
            return false;
        }
    }
}

