﻿using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using ConsoleApplication2.Interfaces;
using ConsoleApplication2.Classes;
using System.IO;

namespace ConsoleApplication2Test
{
    [TestClass]
    public class UnitTest1
    {
        [TestMethod]
        public void ConsoleWriterTest()
        {
            IWritable target = new ConsoleWriter();
            using (StringWriter sw = new StringWriter())
            {
                Console.SetOut(sw);
                target.Write("Hello World");
                string result = sw.ToString();
                Assert.AreEqual("Hello World\r\n", result);
            }
        }

        [TestMethod]
        public void FileWriterTest()
        {
            IWritable target = new FileWriter("test.txt");
            target.Write("Hello World");
            Assert.IsTrue(File.Exists("test.txt"));
            string result = File.ReadAllText("test.txt");
            File.Delete("test.txt");
            Assert.AreEqual("Hello World\r\n", result);
        }
    }
