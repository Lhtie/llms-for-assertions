﻿using NUnit.Framework;

namespace Lab1.Tests
{
    [TestFixture]
    public class Test
    {
        private Calculator calculator;

        [SetUp]
        public void Init()
        {
            calculator = new Calculator();
        }

        [Test]
        public void TestAdd()
        {
            Assert.AreEqual(3, calculator.Add(1, 2));
        }

        [Test]
        public void TestDivide()
        {
            Assert.AreEqual(2, calculator.Divide(4, 2));
        }
        
        [Test]
        public void TestMultiply()
        {
            Assert.AreEqual(2, calculator.Multiply(1, 2));
        }
        
        [Test]
        public void TestSubstract()
        {
            Assert.AreEqual(1, calculator.Subtract(2, 1));
        }
    }
}

//Lab1/Calculator.cs
﻿using System;
using Lab1.Tests;

namespace Lab1
{
    public class Calculator
    {
        public int Add(int a, int b)
        {
            return a + b;
        }

        public int Subtract(int a, int b)
        {
            return a - b;
        }

        public int Multiply(int a, int b)
        {
            return a * b;
        }

        public int Divide(int a, int b)
        {
            if (b == 0) throw new DivideByZeroException("Division by zero");
            return a / b;
        }
        
        public static void Main()
        {
            var calculator = new Calculator();
            Console.WriteLine(calculator.Add(2, 2));
            Console.WriteLine(calculator.Subtract(2, 1));
            Console.WriteLine(calculator.Multiply(2, 2));
            Console.WriteLine(calculator.Divide(4, 2));
        }
    }
}

