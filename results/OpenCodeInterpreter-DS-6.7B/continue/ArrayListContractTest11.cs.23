public partial class ArrayListContractTest
{
    [PexMethod]
    public void ADD_IndexAddContract([PexAssumeUnderTest("$list")]ArrayList arrList, [PexAssumeUnderTest("$item")]Item item, [PexAssumeUnderTest("AddIndexContractHelper($list, $item)")]int addIndex)
    {
       // Assume some precondition here

       Assume.That(0<= addIndex && addIndex <= arrList.Count);

       // Code snippet under test
