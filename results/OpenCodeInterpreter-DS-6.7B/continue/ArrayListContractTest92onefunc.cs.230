using Microsoft.Pex.Framework;
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index< arrList.Count);

            object Old_arrListItemAtIndex = arrList[index];
            bool Old_arrListContainsOld_arrListItem = arrList.Contains(Old_arrListItemAtIndex);
            int Old_arrListCount = arrList.Count;

            object x = arrList.Remove(index);

            object New_arrListItemAtIndex = -1; // arrList[index];
            bool New_arrListContainsOld_arrListItem = arrList.Contains(Old_arrListItemAtIndex);
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_ItemAtIndex", Old_arrListItemAtIndex);
            PexObserve.ValueForViewing("$old_arrList_ContainsOld_arrListItem", Old_arrListContainsOld_arrListItem);
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_ItemAtIndex", New_arrListItemAtIndex);
            PexObserve.ValueForViewing("$new_arrList_ContainsOld_arrListItem", New_arrListContainsOld_arrListItem);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$x", x);

	    // an assertion using "Debug.Assert\(.*?\);" that if return is not null, removed item should be equal to Old arrList Item At Index 
	    Debug.Assert(Obj.Ref.AreEqual(x, Old_arrListItemAtIndex));
        }
    }
}

