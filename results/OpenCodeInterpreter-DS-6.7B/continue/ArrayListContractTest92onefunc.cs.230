
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, Contains(x) in old array is same as Contains(x) in new array 
        }
    }
}//Test_Driven_Development/TDD_Project/CustomerValidator.cs
﻿using System;
using System.ComponentModel.DataAnnotations;

namespace TDD_Project
{
    public class CustomerValidator
    {
        public bool Validate(Customer customer)
        {
            if (string.IsNullOrWhiteSpace(customer.FirstName) || string.IsNullOrWhiteSpace(customer.LastName))
            {
                return false;
            }

            if (customer.Age < 0 || customer.Age > 150)
            {
                return false;
            }

            if (customer.EmailAddress.Length > 100 || !IsValidEmail(customer.EmailAddress))
            {
                return false;
            }

            return true;
        }
        private bool IsValidEmail(string email)
        {
            try
            {
                var addr = new System.Net.Mail.MailAddress(email);
                return addr.Address == email;
            }
            catch
            {
                return false;
            }
        }
    }
}

