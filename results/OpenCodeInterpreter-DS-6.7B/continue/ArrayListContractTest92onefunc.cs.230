using System;
using System.Collections.Specialized;
using System.Collections.ObjectModel;

namespace Microsoft.VisualStudio.TestTools.Web.DynamicDataLoading
{
    [AttributeUsage(AttributeTargets.Method, AllowMultiple = false)]
    public class DataSourceAttribute : Attribute
    {
        private string _baseUrl;
        private string _dataSourceKey;
        private int _timeoutInterval;

        // Parameters representing the data source's URL and data source key, along with a timeout interval
        // This constructor requires that you specify a base URL for your data source, a unique key under which your data is stored, and a timeout duration for the request
        public DataSourceAttribute(string baseUrl, string dataSourceKey, int timeoutInterval)
        {
            _baseUrl = baseUrl;
            _dataSourceKey = dataSourceKey;
            _timeoutInterval = timeoutInterval;
        }

        public string BaseUrl
        {
            get { return _baseUrl; }
            set { _baseUrl = value; }
        }

        public string DataSourceKey
        {
            get { return _dataSourceKey; }
            set { _dataSourceKey = value; }
        }

        public int TimeoutInterval
        {
            get { return _timeoutInterval; }
            set { _timeoutInterval = value; }
        }
    }
