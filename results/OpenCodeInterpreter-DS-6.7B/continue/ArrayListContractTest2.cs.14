//PexRocksSampleSolution/ALO_Test/ALO_ContractTest_Put.cs

using System;
using System.Text;
using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_Add([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // Get the old state
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            // Put
            int New_Ret = arrList.Add(x);

            // Get the new state
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            Assert.IsTrue(New_arrListContainsX);
            Assert.AreEqual(Old_x, New_Ret);
        }


        [Test]
        public void PUT_AddRange([PexAssumeUnderTest]ArrayList arrList, ArrayList arrListRange)
        {
        // Get the old state
            int Old_arrListCount = arrList.Count;
            int Old_arrListCountRange = arrListRange.Count;
            ArrayList Old_arrListRange = new ArrayList(arrListRange);

            // Put
            arrList.AddRange(arrListRange);

            // Get the new state
            int New_arrListCount = arrList.Count;
            ArrayList New_arrListRange = new ArrayList(arrList.GetRange(Old_arrListCount, Old_arrListCountRange));

            Assert.IsTrue(New_arrListRange.TrueForAll(x => Old_arrListRange.Contains(x)));
            Assert.AreEqual(Old_arrListCount + Old_arrListCountRange, New_arrListCount);
        }
    }
}

