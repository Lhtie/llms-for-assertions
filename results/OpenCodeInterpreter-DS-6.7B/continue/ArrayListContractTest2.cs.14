//src/ArrayLists/ArrayList/ArrayList.cs
namespace ArrayList
{
    public class ArrayList
    {
        private object[] _array;
        private int _count;

        public ArrayList()
        {
            _array = new object[4];
        }

        public int Count {
            get { return _count; }
        }

        public void Add(object item)
        {
            if(_count == _array.Length)
            {
                IncreaseArraySize();
            }
            _array[_count] = item;
            _count++;
        }

        private void IncreaseArraySize()
        {
            var newArray = new object[_count * 2];
            for(int i = 0; i < _count; i++)
            {
                newArray[i] = _array[i];
            }
            _array = newArray;
        }

        public object this[int i]
        {
            get { return _array[i]; }
        }
    }
}

