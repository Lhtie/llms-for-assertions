```csharp
[PexMethod]
[PexData(PexDataAttribute.Regex, ".*")]
[PexData(PexDataAttribute.Regex, ".*")]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, [PexParams("^.*$|^.*$")]int x, [PexParams("^.*$|^.*$")]int index, [PexParams("^.*$|^.*$")]string temp)
{
  AssumePrecondition.IsTrue(true);

  int Old_ArrayListCount = arrList.Count;
  int Old_x = x;
  int Old_ArrayListLastIndexOfX = arrList.LastIndexOf(x);
  bool Old_ArrayListContainsX = arrList.Contains(x);

  int New_Ret = arrList.IndexOf(x);

  int New_ArrayListCount = arrList.Count;
  int New_ArrayListLastIndexOfX = arrList.LastIndexOf(x);
  bool New_ArrayListContainsX = arrList.Contains(x);

  PexObserve.ValueForViewing("$old_ArrayList_Count", Old_ArrayListCount);
  PexObserve.ValueForViewing("$new_ArrayList_Count", New_ArrayListCount);
  PexObserve.ValueForViewing("$old_ArrayList_x", Old_x);
  PexObserve.ValueForViewing("$old_ArrayList_LastIndexOf_x", Old_ArrayListLastIndexOfX);
  PexObserve.ValueForViewing("$new_ArrayList_LastIndexOf_x", New_ArrayListLastIndexOfX);
  PexObserve.ValueForViewing("$New_Ret", New_Ret);
  PexObserve.ValueForViewing("$old_ArrayList_Contains_x", Old_ArrayListContainsX);
  PexObserve.ValueForViewing("$new_ArrayList_Contains_x", New_ArrayListContainsX);

  Debug.Assert(New_Ret >=0);
}
```
```csharp
[PexEntryPoint]
public void PUT_Contains_IndexOf_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, [PexParams("^.*$|^.*$")]int x)
{
  AssumePrecondition.IsTrue(true);

  int Old_ArrayListCount = arrList.Count;
  int Old_x = x;
  int Old_ArrayListLastIndexOfX = arrList.LastIndexOf(x);
  bool Old_ArrayListContainsX = arrList.Contains(x);

  bool New_Ret = arrList.Contains(x);

  int New_ArrayListCount = arrList.Count;
  int New_ArrayListLastIndexOfX = arrList.LastIndexOf(x);
  bool New_ArrayListContainsX = arrList.Contains(x);

  PexObserve.ValueForViewing("$old_ArrayList_Count", Old_ArrayListCount);
  PexObserve.ValueForViewing("$new_ArrayList_Count", New_ArrayListCount);
  PexObserve.ValueForViewing("$old_ArrayList_x", Old_x);
  PexObserve.ValueForViewing("$old_ArrayList_LastIndexOf_x", Old_ArrayListLastIndexOfX);
  PexObserve.ValueForViewing("$new_ArrayList_LastIndexOf_x", New_ArrayListLastIndexOfX);
  PexObserve.ValueForViewing("$New_Ret", New_Ret);
  PexObserve.ValueForViewing("$old_ArrayList_Contains_x", Old_ArrayListContainsX);
  PexObserve.ValueForViewing("$new_ArrayList_Contains_x", New_ArrayListContainsX);

  Debug.Assert(New_Ret == Old_ArrayListContainsX);
}
```
