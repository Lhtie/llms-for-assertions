}﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Bank
{
    public class Account
    {
        public int accountNumber { get; private set; }
        public AccountHolder accountHolder { get; private set; }
        public double balance { get; private set; }

        // Constructor (to initialize account details)
        public Account(int accountNumber, AccountHolder accountHolder, double balance)
        {
            this.accountNumber = accountNumber;
            this.accountHolder = accountHolder;
            this.balance = balance;
        }

        //Method to deposit money
        public void Deposit(double amount)
        {
            if (amount <= 0)
            {
                throw new ArgumentException("Deposit amount must be greater than zero");
            }

            this.balance += amount;
        }

        //method to withdraw money
        public void Withdrawal(double amount)
        {
            if (amount <= 0)
            {
                throw new ArgumentException("Withdrawal amount must be greater than zero");
            }

            if (amount > this.balance)
            {
                throw new InvalidOperationException("Insufficient balance");
            }

            this.balance -= amount;
        }
    }
}//Bank/Bank/Bank/Program.cs
﻿using System;

namespace Bank
{
    class Program
    {
        static void Main(string[] args)
        {
            // Creating a new account holder
            AccountHolder accountHolder = new AccountHolder("John", "Doe", "123 Main St", "johndoe@gmail.com", "555-555-5555");

            // Opening a new account
            Account account = new Account(12345, accountHolder, 100.0);

            // Depositing money into the account
            account.Deposit(50.0);
            Console.WriteLine("New Balance: " + account.balance);

            // Withdrawing money from the account
            account.Withdrawal(20.0);
            Console.WriteLine("New Balance: " + account.balance);
        }
    }
}

