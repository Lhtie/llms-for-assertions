﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void AddContractTest()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;
            int index = arrList.Add(x);
            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(x, arrList[0]);
            Assert.AreEqual(0, arrList.LastIndexOf(x));
            Assert.AreEqual(0, arrList.IndexOf(x));
            Assert.IsTrue(arrList.Contains(x));
        }

