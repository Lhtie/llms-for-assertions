//ArrayList.Test/ArrayListTests.cs
﻿using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void Test_Add_Element_Is_Present()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;

            arrList.Add(x);

            Assert.AreEqual(1, arrList.Count);
            Assert.AreEqual(x, arrList[0]);
            Assert.IsTrue(arrList.Contains(x));
        }

        [Test]
        public void Test_Remove_Element_IsNot_Present()
        {
            ArrayList arrList = new ArrayList();
            int x = 5;

            arrList.Remove(x);

            Assert.AreEqual(0, arrList.Count);
            Assert.IsFalse(arrList.Contains(x));
        }
    }
}

