using System;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Reflection;

namespace TestRunner
{
    internal class Program
    {
        private static void Main()
        {
            var testDataDir = Path.Combine(Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location), "../../../../TestData");

            var testDllFiles = Directory.EnumerateFiles(testDataDir, "*.dll");

            foreach (var testDllFile in testDllFiles)
            {
                RunTest(testDllFile);
            }

            Console.WriteLine("All tests have done.");
            Console.ReadLine();
        }

        private static void RunTest(string testDllFile)
        {
            var process = new Process
            {
                StartInfo = new ProcessStartInfo
                {
                    FileName = "dotnet",
                    Arguments = $"exec {testDllFile}",
                    UseShellExecute = false,
                    CreateNoWindow = true,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                }
            };

            process.Start();

            process.WaitForExit();

            var output = process.StandardOutput.ReadToEnd();
            var error = process.StandardError.ReadToEnd();

            if (string.IsNullOrWhiteSpace(error))
            {
                Console.WriteLine($"Test {Path.GetFileName(testDllFile)} has passed.");
            }
            else
            {
                Console.WriteLine($"Test {Path.GetFileName(testDllFile)} has failed.");
                Console.WriteLine(error);
            }
        }
    }
}

