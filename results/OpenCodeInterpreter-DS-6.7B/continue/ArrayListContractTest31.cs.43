public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

    int Old_arrListCount = arrList.Count;
    int Old_arrList_indexValue = (int)arrList[index];
    int Old_arrList_indexOf_indexValue = arrList.IndexOf(arrList[index]);
    bool Old_arrList_contains_indexValue = arrList.Contains(arrList[index]);

    arrList.RemoveAt(index);

    int New_arrListCount = arrList.Count;
    bool New_arrList_contains_Old_indexValue = arrList.Contains(Old_arrList_indexValue);

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$old_arrList_indexValue", Old_arrList_indexValue);
    PexObserve.ValueForViewing("$old_arrList_indexOf_indexValue", Old_arrList_indexOf_indexValue);
    PexObserve.ValueForViewing("$old_arrList_contains_indexValue", Old_arrList_contains_indexValue);
    PexObserve.ValueForViewing("$new_arrList_contains_Old_indexValue", New_arrList_contains_Old_indexValue);

    // we are not checking for $new_arrList_count because it should just decrease when we remove element at index
    if (arrList.Count > Old_arrListCount) {
	Assert.Fail("RemoveAt - array should have decreased in size or remained same as there is no element at the given index.");
    }
}
