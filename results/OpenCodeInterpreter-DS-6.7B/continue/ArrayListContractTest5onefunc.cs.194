        /// </summary>
        public Mesh mesh;

        /// <summary>
        ///     The matBase.
        /// </summary>
        public Material matBase;

        /// <summary>
        ///     The bodyType.
        /// </summary>
        public BodyType bodyType;

        /// <summary>
        ///     The hasDrawableShader.
        /// </summary>
        public bool hasDrawableShader;

        /// <summary>
        ///     Initializes a new instance of the PawnDrawable class.
        /// </summary>
        /// <param name="def">The def<see cref="ThingDef"/>.</param>
        public PawnDrawable(ThingDef def)
        {
            this.def = def;
            mesh = SolidUtility.GetSolidMesh(def.size.x, def.size.y);
            matBase = MaterialPool.MatFrom(def.graphicData.texPath, ShaderDatabase.CutoutComplex, MatPropBlockCache.MatFromDef(def.graphicData));
            bodyType = def.race.bodyType;
            hasDrawableShader = def.graphicData.shaderType == ShaderTypeDefOf.Cutout;
        }
    }
