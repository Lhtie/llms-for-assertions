            // an assertion using "Debug.Assert\(.*?\);" that last position of x in new array equals old array size
	    Debug.Assert(Old_arrListCount == New_arrListCount - 1);

            // an assertion using "Debug.Assert\(.*?\);" that index of x in new array equals old array size
	    Debug.Assert(Old_arrListIndexOfX == New_arrListCount - 1);

            // an assertion using "Debug.Assert\(.*?\);" that last index of x in new array equals old array size
	    Debug.Assert(Old_arrListLastIndexOfX == New_arrListCount - 1);

            // an assertion using "Debug.Assert\(.*?\);" that new array contains x
	    Debug.Assert(New_arrListContainsX == true);

            // an assertion using "Debug.Assert\(.*?\);" that add method return is equivalent to old array size - 1
	    Debug.Assert(New_Ret == (Old_arrListCount - 1));
