//test/ArrayList.Test/ArrayListContractTest/PUT_IndexOfContract.cs
﻿using Microsoft.Pex.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod, PexExploration]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x, bool condition)
        {
            // Arrange
            int indexOfX = arrList.IndexOf(x);

            // Act
            arrList.Insert(0, x);
            int newIndexOfX = arrList.IndexOf(x);

            // Assert
            
            if(condition == true)
            {
                PexAssert.IsTrue("condition is true, ensure that the index of item after insert is not the same as before", newIndexOfX != indexOfX);
            }

            if (condition == false){
                PexAssert.IsTrue("condition is false, ensure that the index of item after insert is the same as before", newIndexOfX == indexOfX);
            }
        }
    }
}

//test/ArrayList.Test/ArrayListContractTest/PUT_RemoveContract.cs
﻿using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int itemIndex)
        {
            // Arrange
            object item = arrList[itemIndex];

            // Act
            arrList.Remove(itemIndex);

            // Assert
            PexAssert.IsTrue("The item should be removed from the ArrayList", !arrList.Contains(item));
        }
    }
}

//test/ArrayList.Test/ArrayListContractTest/PUT_SetItemContract.cs
﻿using System;
using System.Collections;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_SetItemContract([PexAssumeUnderTest]ArrayList arrList, int index, int item)
        {
            // Store current state
            int oldCount = arrList.Count;
            object oldItem = arrList[index];

            // Act
            arrList[index] = item;

            // Assert
            PexAssert.AreEqual("The item should be updated in the ArrayList.", item, arrList[index]);
            PexAssert.AreEqual("The count of the ArrayList should not change.", oldCount, arrList.Count);
            PexAssert.AreNotEqual("The old item should be different from the new item.", oldItem, item);
        }
    }
}﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace ArrayList.Test
{
    partial class ArrayListContractTest
    {
        public void PUT_ContainsContract(object obj)
        {
            AssumePrecondition.IsTrue(obj != null);

            List<object> list = new List<object> { obj };
            IList<object> arrayList = new ArrayList(list);

            bool containsBefore = arrayList.Contains(obj);
            arrayList.Add(obj);
            bool containsAfter = arrayList.Contains(obj);

            // Assert
            PexAssert.IsTrue("The list should contain the object after adding it.", containsAfter);
            PexAssert.IsTrue("The list should already contain the object before adding it.", containsBefore);
        }
    }
}﻿using Microsoft.Pex.Framework;
