﻿using System;
using System.Web;
using System.Web.Mvc;
using System.Web.Routing;

namespace Skeleton.Infrastructure.Web
{
    public class SkeletonWebFactory : DefaultRouteFactory
    {
        public override RouteValueDictionary Parse(RouteValueDictionary value)
        {
            // This method will be called before the DefaultRouteHandler.GetRouteData is called
            // here you could for example strip out the trailing slash

            // this is just the same as the base class
            return base.Parse(value);
        }
    }
}

