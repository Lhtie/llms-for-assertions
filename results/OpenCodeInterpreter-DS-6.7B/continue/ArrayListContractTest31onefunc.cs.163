	    Assert.IsTrue(Old_arrListLastIndexOfX == Old_arrListIndexOfX, "Old last index is different from index.");
            Assert.IsTrue(New_arrListCount == Old_arrListCount + 1, "New array count is not added by 1.");
            Assert.IsTrue(New_arrListContainsX, "New array doesn't contains the inserted value.");
            Assert.IsTrue(New_arrListLastIndexOfX >= 0, "New array index or less is not valid.");
            Assert.IsTrue(New_arrListLastIndexOfX == New_arrListIndexOfX, "New array last index is different from index.");
