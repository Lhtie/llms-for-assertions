--------------------	    // If the return value is false, new list's last index of x is <= old list's last index of x or -1  
	    if (New_Ret) Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX );
--------------------------------------------------------------------------------	    System.Diagnostics.Debug.Assert(New_Ret == true ? New_arrListLastIndexOfX <= Old_arrListLastIndexOfX : "this is ignored");
