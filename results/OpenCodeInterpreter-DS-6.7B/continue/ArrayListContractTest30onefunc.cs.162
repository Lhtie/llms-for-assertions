	    Debug.Assert(New_arrListIndexOfX >=0);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x after insertion is equal to/more than index 
	    Debug.Assert(New_arrListLastIndexOfX >= Old_index);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of list after insertion is more than before insertion by 1 
	    Debug.Assert(New_arrListCount == Old_arrListCount + 1);

	    // an assertion using "Debug.Assert\(.*?\);" that  if x is part of the list after insertion, it is contained in the list
	    Debug.Assert(New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  if x is part of the list before insertion, it was contained in the list
	    Debug.Assert(Old_arrListContainsX || New_arrListIndexOfX == Old_index); // !!!!
        }
    }
}
```

Notice that you should have some test code that verifies if an element was inserted at a specific index. You should also verify that other elements do not get shifted out of place.

### Testing Removing Items
You're also responsible for writing tests to verify that items can be removed from the ArrayList. 

```
namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));

            int Old_arrListCount = arrList.Count;
	    int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
	    int New_arrListIndexOfX = arrList.IndexOf(x);
	    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of list after removal is less than count before removal by 1 
	    Debug.Assert(New_arrListCount==Old_arrListCount - 1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x after removal either equals -1 or is greater than Old_arrListIndexOfX
	    Debug.Assert(New_arrListIndexOfX==-1 || New_arrListIndexOfX > Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x after removal either equals -1 or is greater than Old_arrListLastIndexOfX
	    Debug.Assert(New_arrListLastIndexOfX==-1 || New_arrListLastIndexOfX > Old_arrListLastIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ x is not contained in list after removal
	    Debug--------------------            ArrayList this_x = (ArrayList)arrList[index];
            Assert.AreEqual(x, this_x);
        }
    }
}
```

TestContract属性指定了一组测试属性，可以运行自动化测试，同时也包含了一个假设条件：index的值应小于或等于arrList.Count且大于或等于0。然后，对各种属性进行断言，以确保插入操作后各个属性的值都保持正确。最后，我们还进行了实际的调用，并使用断言确保插入的元素在正确的索引位置上。

### 测试用例的自动化生成

对于有特定约束的数据集，我们可以使用PexSettings来自动生成测试用例：

```csharp
[PexMethod]
public void InsertTest([PexAssumeValid]ArrayList arrList, [PexRange(0, 10)]int x, [PexRange(0, 100)]int index)
{
	arrList.Insert(index, x);
}
```

## 测试覆盖率衡量

Code Contracts通过提供预和后条件以及确保指定的属性为真的方式来衡量测试的覆盖率。如果程序员违反了这些条件，将抛出一个运行时异常。这有助于测试器确保测试覆盖了所有关键的代码部分。

然而，对于自动化生成的测试用例，可能无法对他们的覆盖率提供详尽的衡量。在这种情况下，可能需要依赖静态分析工具和/或手动检查来确定测试的覆盖率。

