            // PostConditionObserver is not supported.
            Assume.That(Old_arrListCount == arrList.Count);
            Assume.That(Old_x == arrList[Old_index]);
            Assume.That(Old_index == arrList.IndexOf(Old_x));
            Assume.That(Old_arrListIndexOfX <= index && index <= arrList.Count);
            Assume.That(Old_arrListLastIndexOfX == arrList.LastIndexOf(Old_x));
            Assume.That(Old_arrListContainsX);
            Assume.That(index == arrList.IndexOf(x));
            Assume.That(arrList.Contains(x));
            Assume.That(index == arrList.LastIndexOf(x));
            Assume.That(arrList.Count == Old_arrListCount + 1);
            Assume.That(New_arrListIndexOfX == (Old_arrListLastIndexOfX < index ? Old_arrListIndexOfX : Old_arrListIndexOfX + 1));
            Assume.That(New_arrListLastIndexOfX == New_arrListIndexOfX + 1);

