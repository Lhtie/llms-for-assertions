}public class Employee : User, IComparable<Employee>
{
    public string Position { get; set; }
    public int Level { get; set; }

    public int CompareTo(Employee other)
    {
        return this.Level.CompareTo(other.Level);
    }

    public Employee(string name, string position, int level) : base(name)
    {
        this.Position = position;
        this.Level = level;
    }
}

public class Department
{
    public List<Employee> EmployeeList { get; set; }

    public Department()
    {
        EmployeeList = new List<Employee>();
    }

    public void AddEmployee(Employee employee)
    {
        EmployeeList.Add(employee);
    }

    public void SortEmployees()
    {
        EmployeeList.Sort();
    }

    public void PrintEmployees()
    {
        foreach (var employee in EmployeeList)
        {
            Console.WriteLine($"Name: {employee.Name}, Position: {employee.Position}, Level: {employee.Level}");
        }
    }
}

public class User
{
    public string Name { get; set; }

    public User(string name)
    {
        Name = name;
    }
}

public class Program
{
    static void Main()
    {
        Employee emp1 = new Employee("John Smith", "Manager", 3);
        Employee emp2 = new Employee("Mike Johnson", "Developer", 1);
        Employee emp3 = new Employee("Sara Davis", "Analyst", 2);

        Department tech = new Department();
        tech.AddEmployee(emp1);
        tech.AddEmployee(emp2);
        tech.AddEmployee(emp3);

        tech.SortEmployees();
        tech.PrintEmployees();
    }
}

