Bubble Sort Bubble sorting repeatedly steps through the list, compares adjacent elements and swaps they are in the wrong order. The pass through the list is repeated until the list is sorted.
<jupyter_code>
def bubbleSort(arr):
    n = len(arr)
    
    for i in range(n):
        for j in range(0, n-i-1):
            if arr[j] > arr[j+1]:
                arr[j], arr[j+1] = arr[j+1], arr[j]
                
    return arr
                
start_time = time.time()
sorted_arr = bubbleSort(arr)
execution_time = time.time() - start_time

print("Bubble sort array: ", sorted_arr)
print("Execution time of Bubble sort: ", str(execution_time), "s")
