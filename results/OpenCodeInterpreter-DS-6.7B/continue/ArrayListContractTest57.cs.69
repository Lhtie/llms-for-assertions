﻿using System;
using System.Threading.Tasks;

namespace DotnetCore.Infra.Data.UnitOfWork
{
    public interface IUnitOfWork : IDisposable
    {
        Task<bool> Commit();
    }
}

//DotnetCore.Domain/Commands/Handlers/Handler.cs
﻿using DotnetCore.Infra.Data.UnitOfWork;
using MediatR;
using System;

namespace DotnetCore.Domain.Commands.Handlers
{
    public class Handler
    {
        private readonly IUnitOfWork _uow;
        public Handler(IUnitOfWork uow)
        {
            _uow = uow;
        }

        public bool Commit()
        {
            return _uow.Commit().Result;
        }
    }
}

//DotnetCore/Controllers/MainController.cs
﻿using DotnetCore.Domain.Core.Notifications;
using MediatR;
using Microsoft.AspNetCore.Mvc;

namespace DotnetCore.Controllers
{
    public class MainController : Controller
    {
        private readonly IMediator _mediator;
        public MainController(IMediator mediator)
        {
            _mediator = mediator;
        }

        protected void NotifyError(string message)
        {
            _mediator.Publish(new DomainNotification("", message));
        }
    }
}

//DotnetCore/Startup.cs
﻿using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using DotnetCore.Infra.CrossCutting.IoC;
using MediatR;
using AutoMapper;
using DotnetCore.Domain.Core.Notifications;

namespace DotnetCore
{
    public class Startup
    {
        public Startup(IConfiguration configuration)
        {
            Configuration = configuration;
        }

        public IConfiguration Configuration { get; }

        public void ConfigureServices(IServiceCollection services)
        {
            services.AddMvc();

            services.AddAutoMapper();
            services.AddMediatR(typeof(DomainNotification));
            
            RegisterServices(services);
        }

        public void Configure(IApplicationBuilder app, IHostingEnvironment env)
        {
            if (env.IsDevelopment())
            {
                app.UseDeveloperExceptionPage();
                app.UseDatabaseErrorPage();
            }
            else
            {
                app.UseExceptionHandler("/Home/Error");
                app.UseHsts();
            }

            app.UseHttpsRedirection();
            app.UseStaticFiles();
            app.UseCookiePolicy();

            app.UseMvc(routes =>
            {
                routes.MapRoute(
                    name: "default",
                    template: "{controller=Home}/{action=Index}/{id?}");
            });
        }

        private static void RegisterServices(IServiceCollection services)
        {
            BootStrapper.RegisterServices(services);
        }
    }
}

//DotnetCore/ViewModels/ErrorViewModel.cs
using System;

namespace DotnetCore.ViewModels
{
    public class ErrorViewModel
    {
        public string RequestId { get; set; }

        public bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    }
}

