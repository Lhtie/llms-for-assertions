namespace Plugins.Framework.ServiceBus.AzureServiceBus.Sample.Pizza.Domain.OrderAggregate
{
    public class Order
    {
        public string Id { get; set; }
        public string Status { get; private set; }

        public void ChangeOrderStatus(string newStatus)
        {
            if (newStatus == this.Status)
            {
                throw new InvalidOperationException($"The order status is already {newStatus}");
            }

            this.Status = newStatus;

            // Publish event
            var orderStatusChangedTo = new OrderStatusChangedTo
            {
                OrderId = this.Id,
                NewStatus = this.Status
            };

            //TODO: publish this event to Azure Service Bus
        }
    }
}

