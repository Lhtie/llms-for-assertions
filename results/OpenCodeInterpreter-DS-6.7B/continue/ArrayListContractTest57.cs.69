```python
def generate_contracts(source_file: str, output_file: str):
    # Read the source file
    with open(source_file, 'r') as file:
        content = file.read()
    
    # Create a new file for the contracts
    with open(output_file, 'w') as file:
        file.write("// Generated contracts\n")
        
        # Find all method declarations and generate contracts for them
        methods = re.findall(r'public\s+[^(]*\(([^)]*)\)', content)
        for method in methods:
            contract = generate_contract(method)
            file.write(contract + "\n")
        
    print(f"Contracts generated and saved to {output_file}.")

def generate_contract(method: str):
    contract = f"[PexMethod]\npublic void {method}() {\n    // Contract code goes here\n}"
    return contract

# Test the generate_contracts function
source_file = "ArrayList.cs"
output_file = "ArrayList_PexContracts.cs"
generate_contracts(source_file, output_file)
