//test/ArrayList.Test/ContractTest/TestCase1.cs
﻿// This is the test case file. This checks the count of the array after adding an element

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase1
    {
        [Test]
        public void TestAddContract()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            int oldCount = arrList.Count;
            arrList.Add(20);
            int newCount = arrList.Count;
            Assert.AreEqual(oldCount + 1, newCount);
        }
    }
}

//test/ArrayList.Test/ContractTest/TestCase2.cs
﻿// This is the test case file. This checks the count of the array after removing an element

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase2
    {
        [Test]
        public void TestRemoveContract()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            arrList.Add(20);
            int oldCount = arrList.Count;
            arrList.Remove(20);
            int newCount = arrList.Count;
            Assert.AreEqual(oldCount - 1, newCount);
        }
    }
}

//test/ArrayList.Test/ContractTest/TestCase3.cs
﻿// This is the test case file. This checks the count of the array after inserting an element at a specific index

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase3
    {
        [Test]
        public void TestInsertContract()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            int oldCount = arrList.Count;
            arrList.Insert(0, 20);
            int newCount = arrList.Count;
            Assert.AreEqual(oldCount + 1, newCount);
        }
    }
}

//test/ArrayList.Test/ContractTest/TestCase4.cs
﻿// This is the test case file. This checks the return value after adding an element. If the list is not empty, the return value should be the index of the newly added element.

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase4
    {
        [Test]
        public void TestAddContract()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            arrList.Add(30);
            int ret = arrList.Add(20);
            Assert.AreEqual(arrList.Count - 1, ret);
        }
    }
}

//test/ArrayList.Test/ContractTest/TestCase5.cs
// This is the test case file. This checks if the item is removed or not when removing with a specific index

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase5
    {
        [Test]
        public void TestRemoveAtIndex()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            arrList.Add(20);
            arrList.Add(30);

            bool before = arrList.Contains(30);
            arrList.RemoveAt(1);
            bool after = arrList.Contains(30);

            Assert.AreEqual(before, after);
        }
    }
}

//test/ArrayList.Test/ContractTest/TestCase6.cs
// This is the test case file. This test checks if the function Clear correctly removes all elements from the list

using System;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class TestCase6
    {
        [Test]
        public void TestClear()
        {
            ArrayList arrList = new ArrayList.ArrayList();
            arrList.Add(20);
            arrList.Add(30);
            
            arrList.Clear();

            Assert.AreEqual(0, arrList.Count);
        }
    }
}
