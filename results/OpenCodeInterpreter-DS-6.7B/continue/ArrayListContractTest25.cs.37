using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Targets;
using Microsoft.Pex.Framework.Statistics;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListTest
    {
        [PexMethod]
        public void InitializeTest()
        {
            ArrayList arrayList = new ArrayList();

            Assert.IsNotNull(arrayList, "The ArrayList instance is null");
        }

        [PexMethod]
        public void AddTest([PexPositiveValue] int value)
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(value);
            
            Assert.AreEqual(1, arrayList.Count, "ArrayList count is not 1 after adding an element");
        }

        [PexMethod]
        public void RemoveTest([PexPositiveValue] int value)
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(value);
            arrayList.Remove(value);

            Assert.AreEqual(0, arrayList.Count, "ArrayList count is not 0 after removing an element");
        }

        [PexMethod]
        public void IndexOfTest([PexPositiveValue] int value1, [PexPositiveValue] int value2)
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(value1);
            arrayList.Add(value2);

            Assert.AreEqual(0, arrayList.IndexOf(value1), "IndexOf method returned wrong index");
            Assert.AreEqual(1, arrayList.IndexOf(value2), "IndexOf method returned wrong index");
        }

        [PexMethod]
        public void ContainsTest([PexPositiveValue] int value)
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(value);

            Assert.IsTrue(arrayList.Contains(value), "Contains method returned false");
            arrayList.Remove(value);
            Assert.IsFalse(arrayList.Contains(value), "Contains method returned true after Remove");
        }
    }
}

