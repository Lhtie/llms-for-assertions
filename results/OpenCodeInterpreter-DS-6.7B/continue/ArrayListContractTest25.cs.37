namespace EmployeeNamespace
{
    public class Employee
    {
        public string Name;
        public string Position;
        protected double Salary;

        public Employee(string name, string position, double salary)
        {
            Name = name;
            Position = position;
            Salary = salary;
        }

        public virtual double GetSalary()
        {
            return Salary;
        }
    }
}

//Manager/Manager.cs
using EmployeeNamespace;

namespace ManagerNamespace
{
    public class Manager : Employee
    {
        private double Bonus;

        public Manager(string name, string position, double salary, double bonus) : base(name, position, salary)
        {
            Bonus = bonus;
        }

        public override double GetSalary()
        {
            return base.GetSalary() + Bonus;
        }
    }
}

//EmployeeProgram.cs
﻿using System;
using ManagerNamespace;
using EmployeeNamespace;

namespace EmployeeProgramNamespace
{
    class Program
    {
        static void Main(string[] args)
        {
            // Creating an instance of the employee
            Employee employee = new Employee("John Doe", "Developer", 50000);
            Console.WriteLine($"Employee Name: {employee.Name}");
            Console.WriteLine($"Employee Position: {employee.Position}");
            Console.WriteLine($"Employee Salary: {employee.GetSalary()}");

            // Creating an instance of the manager
            Manager manager = new Manager("Jane Doe", "Manager", 100000, 5000);
            Console.WriteLine($"Manager Name: {manager.Name}");
            Console.WriteLine($"Manager Position: {manager.Position}");
            Console.WriteLine($"Manager Salary: {manager.GetSalary()}");
        }
    }
