}using System;

namespace TicTacToe
{
    class Program
    {
        static void Main(string[] args)
        {
            TicTacToe game = new TicTacToe();
            Console.WriteLine(game.GameBoard);

            while (!game.GameIsOver)
            {
                // Read the move from user input
                Console.WriteLine("Please input your move (row,column): ");
                string input = Console.ReadLine();

                // Parse the input into row and column
                int row, column;
                if (ParseMoveInput(input, out row, out column))
                {
                    // Make the move
                    if (game.MakeMove(row,column))
                    {
                        // Print the updated gameboard
                        Console.WriteLine(game.GameBoard);
                    }
                    else
                    {
                        Console.WriteLine("Invalid move. Please try again.");
                    }
                }
                else
                {
                    Console.WriteLine("Invalid input. Please input your move (row,column): ");
                }
            }
            Console.WriteLine("Game Over");
            
        }

        private static bool ParseMoveInput(string input, out int row, out int column)
        {
            string[] parts = input.Split(',');
            if (parts.Length == 2 && int.TryParse(parts[0], out row) && int.TryParse(parts[1], out column))
            {
                // Convert to 0 based index
                row--;
                column--;
                return true;
            }
            row = -1;
            column = -1;
            return false;
        }
    }
}public class TicTacToe
{
    public string GameBoard { get; private set; }
    public int[,] Board => StringToBoard(GameBoard);

    public bool GameIsOver => CheckGameIsOver();

    public TicTacToe()
    {
        GameBoard = "        |\n        |\n        |\n";
    }

    private int[,] StringToBoard(string gameBoard)
    {
        int[,] board = new int[3, 3];
        string[] rows = gameBoard.Split('\n');

        for (int i = 0; i < 3; i++)
        {
            string[] cells = rows[i].Split('|')[1..];
            for (int j = 0; j < 3; j++)
            {
                if (cells[j] == " X ")
                {
                    board[i, j] = 1;
                }
                else if (cells[j] == " O ")
                {
                    board[i, j] = 2;
                }
            }
        }

        return board;
    }

    private bool CheckGameIsOver()
    {
        for (int i = 0; i < 3; i++)
        {
            if (Board[i, 0] != 0 && Board[i, 0] == Board[i, 1] && Board[i, 1] == Board[i, 2])
            {
                return true;
            }
            if (Board[0, i] != 0 && Board[0, i] == Board[1, i] && Board[1, i] == Board[2, i])
            {
                return true;
            }
        }
        if (Board[0, 0] != 0 && Board[0, 0] == Board[1, 1] && Board[1, 1] == Board[2, 2])
        {
            return true;
        }
        if (Board[0, 2] != 0 && Board[0, 2] == Board[1, 1] && Board[1, 1] == Board[2, 0])
        {
            return true;
        }
        return false;
    }
