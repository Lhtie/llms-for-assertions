//src/PexAdapter/PexAdapter/Messages/PexObserveMessageComposer.cs
﻿using PexAdapter.Models;

namespace PexAdapter.Messages
{
    public static class PexObserveMessageComposer
    {
        private const string Start = "PexObserve.Start($";
        private const string End = ");";
        private const string OpenString = "@\"";
        private const string CloseString = "\\\"";

        public static string Compose(string key, object value)
        {
            return $"{Start}{key}{End} {OpenString}{value}{CloseString}";
        }

        public static string Compose(string key, PexObserveModel value)
        {
            return $"{Start}{key}{End} {OpenString}{value.Name}{CloseString} {OpenString}{value.Size}{CloseString}";
        }
    }
}

//src/PexAdapter/PexAdapter/PexFrameworkExtensions.cs
﻿using PexAdapter.Models;
using PexAdapter.Messages;

namespace PexAdapter
{
    public static class PexFrameworkExtensions
    {
        public static void StartObserve(this PexFramework framework, string key, object value)
        {
            framework.SendMessage(PexObserveMessageComposer.Compose(key, value));
        }

        public static void StartObserve(this PexFramework framework, string key, string name, int size)
        {
            framework.SendMessage(PexObserveMessageComposer.Compose(key, new PexObserveModel(name, size)));
        }
    }
}

