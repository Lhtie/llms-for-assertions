//Assets/Scripts/PerlinNoiseGenerator.cs
using System;
using Model;
using UnityEngine;

public class PerlinNoiseGenerator : MonoBehaviour
{
    private Configuration _config;

    private float[,] _noiseData;
    private float _noiseScale;
    private Vector2 _offset;

    private void Start()
    {
        var renderer = GetComponent<MeshRenderer>();
        _config = ConfigurationManager.GetConfiguration();
        _offset = new Vector2(10000, 10000); // Offset for generating different noise areas
        _noiseScale = _config.NoiseScale;

        // Render the perlin noise texture
        Texture2D texture = new Texture2D(_config.TextureSize, _config.TextureSize);
        _noiseData = new float[_config.TextureSize, _config.TextureSize];

        for (int x = 0; x < _config.TextureSize; x++)
        {
            for (int y = 0; y < _config.TextureSize; y++)
            {
                var xCoord = (float)x / _config.TextureSize * _noiseScale + _offset.x;
                var yCoord = (float)y / _config.TextureSize * _noiseScale + _offset.y;
                
                _noiseData[x, y] = Mathf.PerlinNoise(xCoord, yCoord);
                
                texture.SetPixel(x, y, new Color(_noiseData[x, y], _noiseData[x, y], _noiseData[x, y]));
            }
        }
        
        texture.Apply();
        renderer.sharedMaterial.mainTexture = texture;
    }
}

