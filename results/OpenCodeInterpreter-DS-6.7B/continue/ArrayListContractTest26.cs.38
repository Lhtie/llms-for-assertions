//ALgorithmicToolBox/Topics/BinarySearch/BinarySearch.cs
﻿using System;

namespace ALgorithmicToolBox.Topics.BinarySearch
{
    class BinarySearch
    {
        static int BinarySearchIndex(int[] array, int target)
        {
            int low = 0;
            int high = array.Length - 1;

            while (high >= low)
            {
                int mid = (high + low) / 2; // To avoid int overflow

                if (array[mid] == target)
                    return mid;
                else if (target > array[mid])
                    low = mid + 1;
                else
                    high = mid - 1;
            }
            return -1;
        }

        static void Main(string[] args)
        {
            int[] array = {2, 3, 4, 10, 40};
            int target = 10;
            int result = BinarySearchIndex(array, target);

            if (result == -1)
                Console.WriteLine("Element is not present in array");
            else
                Console.WriteLine("Element is present at index: " + result);
        }
    }
}

//ALgorithmicToolBox/Algorithm/Sorting/QuickSort.cs
﻿using System;
using System.Diagnostics;

namespace ALgorithmicToolBox.Algorithm.Sorting
{
    class QuickSort
    {
        private static void Swap(ref int a, ref int b)
        {
            int temp = a;
            a = b;
            b = temp;
        }

        private static int Partition(int[] array, int low, int high)
        {
            int pivot = array[high];
            int i = low - 1;

            for (int j = low; j < high; j++)
            {
                if (array[j] <= pivot)
                {
                    i++;
                    Swap(ref array[i], ref array[j]);
                }
            }
            Swap(ref array[i + 1], ref array[high]);

            return i + 1;
        }

        private static void QuickSortRecursive(int[] array, int low, int high)
        {
            if (low < high)
            {
                int pivot = Partition(array, low, high);
                QuickSortRecursive(array, low, pivot - 1);
                QuickSortRecursive(array, pivot + 1, high);
            }
        }

        public static void QuickSortRun(int[] array)
        {
            Stopwatch sw = new Stopwatch();
            sw.Start();
            QuickSortRecursive(array, 0, array.Length - 1);
            sw.Stop();
            Console.WriteLine("\n QuickSort Execution Time: " + sw.Elapsed);
        }

        public static void Main()
        {
            int[] array = {10, 7, 8, 9, 1, 5};
            QuickSortRun(array);
            Console.Write("Sorted Array: ");
            foreach (int i in array)
                Console.Write(i + " ");
        }
    }
}

//ALgorithmicToolBox/Algorithm/Sorting/SelectionSort.cs
﻿using System;
using System.Diagnostics;

namespace ALgorithmicToolBox.Algorithm.Sorting
{
    class SelectionSort
    {
        private static void Swap(ref int a, ref int b)
        {
            int temp = a;
            a = b;
            b = temp;
        }

        public static void SelectionSortRun(int[] array)
        {
