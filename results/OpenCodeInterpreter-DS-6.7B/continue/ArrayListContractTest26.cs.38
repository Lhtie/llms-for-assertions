        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX_beforeRemoval = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfX_beforeRemoval = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsX_beforeRemoval = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX_afterRemoval = arrList.IndexOf(arrList[index]);
            int New_arrListLastIndexOfX_afterRemoval = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsX_afterRemoval = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x_beforeRemoval", Old_arrListIndexOfX_beforeRemoval);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x_afterRemoval", New_arrListIndexOfX_afterRemoval);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x_beforeRemoval", Old_arrListLastIndexOfX_beforeRemoval);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x_afterRemoval", New_arrListLastIndexOfX_afterRemoval);
            PexObserve.ValueForViewing("$old_arrList_contains_x_beforeRemoval", Old_arrListContainsX_beforeRemoval);
            PexObserve.ValueForViewing("$new_arrList_contains_x_afterRemoval", New_arrListContainsX_afterRemoval);

        }


        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            arrList.Clear();

            Assert.IsTrue(arrList.Count == 0);
            Assert.AreEqual(false, arrList.Contains(5));

        }

    } // End of Contract Test Class
