using System.Collections.Generic;
using System.Linq;
using Zoo.Data.Models;

namespace Zoo.Data
{
    public static class ZooSeed
    {
        public static void PopulateData(ZooDbContext context)
        {
            if (!context.Animals.Any())
            {
                var animals = new List<Animal>
                {
                    new Animal { Name = "Lion", ImageUrl = "http://placekitten.com/400/300", Habitat = "Savannah", Species = "Cat" },
                    new Animal { Name = "Elephant", ImageUrl = "http://placekitten.com/400/300", Habitat = "Forest", Species = "Mammal" },
                    new Animal { Name = "Monkey", ImageUrl = "http://placekitten.com/400/300", Habitat = "Jungle", Species = "Primates" },
                };

                context.Animals.AddRange(animals);
                context.SaveChanges();
            }
        }
    }
}

