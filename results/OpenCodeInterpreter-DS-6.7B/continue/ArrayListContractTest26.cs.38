//ArrayList.Test/ArrayListTests.cs
﻿using NUnit.Framework;
using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using ArrayList;

namespace ArrayList.Test
{
    public class ArrayListTests
    {
        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            int x = arrList.Add(10);
            Assert.AreEqual(x, 0);
            Assert.AreEqual(arrList.Count, 1);
            Assert.AreEqual(arrList.IndexOf(10), 0);
            Assert.AreEqual(arrList.LastIndexOf(10), 0);
            Assert.IsTrue(arrList.Contains(10));
        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Remove(10);
            Assert.AreEqual(arrList.Count, 0);
            Assert.AreEqual(arrList.IndexOf(10), -1);
            Assert.AreEqual(arrList.LastIndexOf(10), -1);
            Assert.IsFalse(arrList.Contains(10));
        }

        [Test]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            arrList.Insert(0, 10);
            Assert.AreEqual(arrList.Count, 1);
            Assert.AreEqual(arrList.IndexOf(10), 0);
            Assert.AreEqual(arrList.LastIndexOf(10), 0);
            Assert.IsTrue(arrList.Contains(10));
        }
    }
