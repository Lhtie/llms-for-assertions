//ArrayList.Test/ArrayListState.cs
using System;
using System.Collections.Generic;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.InstrumentedCode;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{

    // This class represents the state of the ArrayList. Used by the state transition framework.
    public class ArrayListState
    {
        // The list being testd.
        public ArrayList ArrayList;

        // The current count of the list.
        public int Count;

        // The last value that was added to the list.
        //public int LastItemAddedToList;

        // The copy constructor to make a copy of the current state.
        public ArrayListState(ArrayListState other)
        {
            this.ArrayList = other.ArrayList.Copy();
            //this.LastItemAddedToList = other.LastItemAddedToList;
            this.Count = other.Count;
        }

        // The default constructor.
        public ArrayListState()
        {
            this.ArrayList = new ArrayList();
            //this.LastItemAddedToList = 0;
            this.Count = 0;
        }

        // The ToString method returns the list count.
        public override string ToString()
        {
            return this.Count.ToString();
        }
    }
}

