            if(New_Ret == -1 && New_arrListCount != -1) throw new AssertFailedException("if the return value is negative, old list size is not -1");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If return value is positive, it is indeed within bounds (0,old list size) 
            if(New_Ret >= 0 && (New_Ret < 0 || New_Ret >= Old_arrListCount)) throw new AssertFailedException("If return value is positive, it is indeed within bounds (0, old list size)");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ Return value is not out of range (0, new list size) 
            if(New_Ret < 0 || New_Ret >= New_arrListCount) throw new AssertFailedException("Return value is not out of range (0, new list size)");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ Value is found in arraylist before it is removed 
            if(Old_arrListContainsX && !New_arrListContainsX) throw new AssertFailedException("Value is found in arraylist before it is removed");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ Value is not found in list after it is removed 
            if(!Old_arrListContainsX && New_arrListContainsX) throw new AssertFailedException("Value is not found in list after it is removed");

        }    
    }
}

