            if (New_arrListContainsX) {
                PexAssert.AreEqual(New_arrListIndexOfX, New_Ret);
            }

            if (Old_arrListContainsX) {
                PexAssert.AreNotEqual(Old_arrListIndexOfX, New_Ret);
            }
        }
    }
}​
