    private float current_time = 0;
    private Vector2 offset;
    private Vector2 scale;
    public Camera cam;
    Vortex vortex;

    private void Start()
    {
        cam = GetComponent<Camera>();
        vortex = GetComponent<Vortex>();
        StartCoroutine(FadeIn());
        StartCoroutine(ScreenOverlay());
    }

    public IEnumerator FadeIn()
    {
        while (current_time < transition_time)
        {
            current_time += Time.deltaTime;
            screenOverlay.intensity = Mathf.Lerp(1, 0, current_time / transition_time);
            yield return null;
        }
    }

    public IEnumerator ScreenOverlay()
    {
        while (current_time < transition_time)
        {
            current_time += Time.deltaTime;
            screenOverlay.color = new Color(color.r, color.g, color.b, Mathf.Lerp(0, 1, current_time / transition_time));
            yield return null;
        }
    }

    IEnumerator CameraShake(float duration, float magnitude)
    {
        float elapsed = 0.0f;

        while (elapsed < duration)
        {
            float x = Random.Range(-1f, 1f) * magnitude;
            float y = Random.Range(-1f, 1f) * magnitude;

            cam.transform.localPosition = new Vector3(x, y, -10);

            elapsed += Time.deltaTime;

            yield return null;
        }

        cam.transform.localPosition = Vector3.zero;--------------------            Debug.Assert(index <= New_arrListLastIndexOfX);
        }
    }
}
```
```csharp
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
// ......
Debug.Assert(index <= New_arrListLastIndexOfX);
}
```
ArrayList类的索引属性在索引大于或等于新数组中最后出现`x`的索引时返回`x`。

此断言将确保在赋值操作后的数组`arrList`中，属性`index`大于或等于`New_arrListLastIndexOfX`。

如果`index`小于`New_arrListLastIndexOfX`，这意味着`x`在赋值后的`arrList`中最后出现的位置在`index`之后，将发生数据不一致的情况。

根据ArrayList类的索引属性，如果您尝试将值赋给不存在的位置，它将引发`IndexOutOfRangeException`异常。

在代码片段中，使用`ArrayList arrList = new ArrayList();`初始化了一个新的ArrayList对象。将值`5`插入到不存在的位置`10`，这将引发`IndexOutOfRangeException`异常。Assert断言检查了插入不存在的位置。如果引发了断言异常，`Pex`将在失败状态下运行测试。

根据此断言，没有理由认为测试失败，因为插入不存在的位置是正确的且合法的。

如果您想要将值`20`插入到存在的位置`1`（即覆盖位置`1`上的元素值为`5`），您可以使用以下表达式进行测试：

```csharp
[PexMethod]
[PexExpectedException(typeof(IndexOutOfRangeException))]
public void TestExceptionOnAddToNonEmptyList(int index)  // 为简单起见，这里的索引没有被使用 - 添加一个值，覆盖索引上的值
{
    ArrayList arrList = new ArrayList();
    arrList.Add(5);
    arrList[index] = 20;
}
```
此测试验证了异常是否按预期抛出。如果`index`大于`arrList`中元素的数量（在我们的情况下为1）那么当我们尝试将`20`赋给不存在的位置时，将抛出`IndexOutOfRangeException`异常。如果此测试通过，这意味着插入不存在的位置将引发异常。测试通过或未通过与预期一致，根据是否会抛出异常。

Pex的基本思想是：如果将来为您的对象添加新功能，您将在其他地方期望此行为 - 您的单元测试将捕捉到此异常。如果您不需要此行为（例如，List中的索引设置），您将发现此未通过测试。

现在，在您的代码中编写一些测试，并观察测试运行器是否捕捉到您期望的异常。

[PexClass]
public class ArrayListTests
{
    [PexMethod]
    [PexExpectedException(typeof(IndexOutOfRangeException))]
    public void TestExceptionOnAddToNonEmptyList(int index)  // 为简单起见，这里的索引没有被使用 - 添加一个值，覆盖索引上的值
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(5);
        arrList[index] = 20;  // 索引大于arrList中的元素数
    }
}
```

## 测试方法解析
此测试方法 `[PexMethod] public void TestExceptionOnAddToNonEmptyList(int index)` 使用Pex进行测试驱动。`TestExceptionOnAddToNonEmptyList` 方法被标记为公共可测试方法，`[PexMethod]` 指定了测试框架此方法是可测试的。

方法 `TestExceptionOnAddToNonEmptyList(int index)` 是一个参数化测试方法，并且用 `[PexExpectedException]` 属性标记，以确保测试运行时引发了预期的异常。

在此方法中，我们首先创建一个新的ArrayList 对象 `arrList`，然后向其添加元素(`5`)。如果我们尝试通过索引为不存在的位置插入元素(`20`)，即如果 `index > 1`，它将抛出 `IndexOutOfRangeException--------------------