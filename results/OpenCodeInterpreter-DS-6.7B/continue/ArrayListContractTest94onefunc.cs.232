using System;

namespace NetCore.AutoRegister.Attributes
{
    [AttributeUsage(AttributeTargets.Class, AllowMultiple = false)]
    public class AutoRegisterAttribute : Attribute
    {
        public Type Service { get; set; }
        public ServiceLifetime Lifetime { get; set; }
    }
}

//src/NetCore.AutoRegister/Extensions/ServiceCollectionExtensions.cs
using System;
using System.Linq;
using System.Reflection;
using Microsoft.Extensions.DependencyInjection;
using NetCore.AutoRegister.Attributes;

namespace NetCore.AutoRegister
{
    public static class ServiceCollectionExtensions
    {
        public static IServiceCollection AddAutoRegisteredServices(this IServiceCollection serviceCollection)
        {
            var assembly = Assembly.GetCallingAssembly();
            var types = assembly.GetTypes();

            foreach (var type in types)
            {
                var autoRegisterAttributes = type.GetCustomAttributes<AutoRegisterAttribute>();
                foreach (var attribute in autoRegisterAttributes)
                {
                    if (attribute.Service.IsAssignableFrom(type))
                    {
                        switch (attribute.Lifetime)
                        {
                            case ServiceLifetime.Singleton:
                                serviceCollection.AddSingleton(attribute.Service, type);
                                break;
                            case ServiceLifetime.Scoped:
                                serviceCollection.AddScoped(attribute.Service, type);
                                break;
                            case ServiceLifetime.Transient:
                                serviceCollection.AddTransient(attribute.Service, type);
                                break;
                        }
                    }
                }
            }

            return serviceCollection;
        }
    }
}

//src/NetCore.AutoRegister/ServiceLifetime.cs
namespace NetCore.AutoRegister
{
    public enum ServiceLifetime
    {
        Singleton,
        Scoped,
        Transient
    }
}

//test/NetCore.AutoRegister.Test/FooService.cs
