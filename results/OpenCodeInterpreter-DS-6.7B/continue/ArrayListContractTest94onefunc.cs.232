namespace NetCore.AutoRegister.Test
{
    [AutoRegister(Service = typeof(IFoo), Lifetime = ServiceLifetime.Singleton)]
    public class FooService : IFoo
    {
        public string Bar()
        {
            return "Bar";
        }
    }
}

