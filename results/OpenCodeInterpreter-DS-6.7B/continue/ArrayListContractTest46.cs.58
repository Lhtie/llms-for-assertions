        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeUnderTest]ArrayList toAdd, Type type, bool duplicate)
        {
            if (duplicate)
            {
                AssumePrecondition.IsTrue(true);

                int Old_arrListCount = arrList.Count;
                int Old_toAddCount = toAdd.Count;
                bool Old_arrListContainsToAdd = arrList.Contains(toAdd);

