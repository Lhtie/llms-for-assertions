﻿using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;

namespace FarfetchTest.Models
{
    public class User
    {
        [Required]
        public string Id { get; set; }
        [Required]
        public string Name { get; set; }
        public List<ClothingItem> ClothingItems { get; set; }
    }
}

//FarfetchTest/FarfetchTest/Data/FarfetchContext.cs
﻿using FarfetchTest.Models;
using Microsoft.EntityFrameworkCore;

namespace FarfetchTest.Data
{
    public class FarfetchContext : DbContext
    {
        public FarfetchContext(DbContextOptions<FarfetchContext> options)
            : base(options)
        {
        }

        public DbSet<ClothingItem> ClothingItems { get; set; }
        public DbSet<User> Users { get; set; }

        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            modelBuilder.Entity<User>().ToTable("User");
            modelBuilder.Entity<ClothingItem>().ToTable("ClothingItem");
        }
    }
}

