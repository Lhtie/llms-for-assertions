}//Src/FluentTestKit/Constraints/PropertySpecification.cs
﻿using System;

namespace FluentTestKit.Constraints
{
    internal class PropertySpecification<TResult> : ExpressionSpecification<TResult>
    {
        private readonly object _entity;
        private readonly string _propertyName;

        public PropertySpecification(object entity, string propertyName, Func<object, TResult> function)
            : base((Func<object, TResult>) function)
        {
            if (entity == null)
                throw new ArgumentNullException("entity");

            _entity = entity;
            _propertyName = propertyName;
        }

        protected override string Context
        {
            get { return string.Format("{0}.{1}", _entity.GetType().Name, _propertyName); }
        }

        public override bool Equals(object obj)
        {
            if (ReferenceEquals(null, obj)) return false;
            if (ReferenceEquals(this, obj)) return true;
            if (obj.GetType() != typeof (PropertySpecification<TResult>)) return false;
            var other = (PropertySpecification<TResult>) obj;
            return other._entity.Equals(_entity) && other._propertyName == _propertyName;
        }

        public override int GetHashCode()
        {
            return _entity.GetHashCode() ^ _propertyName.GetHashCode();
        }
    }
}

//Src/FluentTestKit/SpecificationExtensions.cs
using System;
using FluentTestKit.Constraints;

namespace FluentTestKit
{
    public static class SpecificationExtensions
    {
        public static PropertySpecification<TResult> Have<TResult>(this object entity, string propertyName)
        {
            return new PropertySpecification<TResult>(entity, propertyName, obj => (TResult) obj.GetType().GetProperty(propertyName).GetValue(obj, null));
        }

        public static PropertySpecification<TResult> Have<TResult>(this object entity, string propertyName, Func<object, TResult> fn)
        {
            return new PropertySpecification<TResult>(entity, propertyName, fn);
        }
    }
}

