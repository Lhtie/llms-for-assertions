namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListCustomContractTest
    {
        [Test]
        [CustomContract("(arrList:ArrayList, x:int)=>( arrList.Count = old(arrList.Count)+1 && arrList.Contains(x) && arrList.LastIndexOf(x)>=0 && arrList.LastIndexOf(x)==old(arrList.Count)-1)", "arrList.Add(x) should increment Count by 1 and add x to the end of the list")]
        public void ArrayListAddContractTest([Random(30)]ArrayList arrList, [Random(30)] int x)
        {
            var oldCount = arrList.Count;
            arrList.Add(x);
            Assert.IsTrue(arrList.Contains(x));
            Assert.IsTrue(arrList.LastIndexOf(x) >=0 && arrList.LastIndexOf(x) == oldCount);
        }

        [Test]
        [CustomContract("(arrList: ArrayList, x: int)=> (arrList.Count = old(arrList.Count)-1 && !arrList.Contains(x) && arrList.LastIndexOf(x) == -1)", "arrList.Remove(x) should decrease Count by 1 and remove x from the list")]
        public void ArrayListRemoveContractTest([Random(30)]ArrayList arrList, [Random(30)] int x)
        {
            var oldCount = arrList.Count;
            arrList.Remove(x);
            Assert.IsFalse(arrList.Contains(x));
            Assert.IsTrue(arrList.LastIndexOf(x) == -1);
        }
    }
}

