(defvar nunit-assert-list
  '(
    ;; assertions
    "Assert.IsTrue(.*?);"
    "Assert.IsFalse(.*?);"
    "Assert.AreEqual(.*?);"
    "Assert.AreNotEqual(.*?);"
    "Assert.IsNull(.*?);"
    "Assert.IsNotNull (.*?);"
    "Assert.Fail(.*?);"
    )) ;; ...

(defun nunit-find-tests ()
  (interactive)
  (progn
    (setq current-frame (selected-frame))
    (switch-to-buffer "*NUnit-Tests*")
    (erase-buffer)
    (if (boundp 'current-frame)
        (select-frame current-frame))))

(defun nunit-test-from-buffer (bufname)
  (interactive)
  (progn
    (setq current-frame (selected-frame))
    (switch-to-buffer bufname)
    (nunit-test-from--------------------        Debug.Assert(New_Ret ? (New_arrListIndexOfX >= 0) : (New_arrListIndexOfX < 0));

        }
    }
}


