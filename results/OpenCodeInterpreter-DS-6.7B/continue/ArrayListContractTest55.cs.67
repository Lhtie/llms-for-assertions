namespace ArrayList
{
    public class ArrayList
    {
        public int Count { get; set; }

        public int Add(int a) { return Count; }
        public void Remove(int a) { }
        public int IndexOf(int a) { return Count; }
        public int LastIndexOf(int a) { return Count; }
        public bool Contains(int a) { return Count > 0; }
        public void Insert(int i, int a) { }
    }
}

//PexProgram.cs

using NUnit.Framework;
using ArrayList;

public class PexProgram
{
    [Test]
    public void TestAdd()
    {
        ArrayList arrList = new ArrayList();
        int ret = arrList.Add(1);
        Assert.AreEqual(1, ret);
    }

    [Test]
    public void TestRemove()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(1);
        arrList.Remove(1);
        Assert.AreEqual(0, arrList.Count);
    }

    [Test]
    public void TestIndexOf()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(1);
        Assert.AreEqual(0, arrList.IndexOf(1));
    }

    [Test]
    public void TestLastIndexOf()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(1);
        Assert.AreEqual(0, arrList.LastIndexOf(1));
    }

    [Test]
    public void TestContains()
    {
        ArrayList arrList = new ArrayList();
        arrList.Add(1);
        Assert.IsTrue(arrList.Contains(1));
    }

    [Test]
    public void TestInsert()
    {
        ArrayList arrList = new ArrayList();
        arrList.Insert(0, 1);
        Assert.AreEqual(1, arrList.Count);
    }
}
    }
