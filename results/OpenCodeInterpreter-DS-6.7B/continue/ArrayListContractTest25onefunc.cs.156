using System;
using System.Collections;
using System.Collections.Generic;

namespace ArrayListLib
{
    public class ArrayListType : IEnumerable<object>
    {
        private object[] elements;
        private int count;

        public ArrayListType()
        {
            this.elements = new object[4];
        }

        public int Count { get { return count; } }

        public void Add(object value)
        {
            if (count == elements.Length)
            {
                ResizeArray(elements.Length * 2);
            }

            elements[count] = value;
            count++;
        }

        public object Get(int index)
        {
            if (index > count || index < 0)
            {
                throw new IndexOutOfRangeException();
            }
            return elements[index];
        }

        public void ResizeArray(int newSize)
        {
            Array.Resize(ref this.elements, newSize);
        }

        public IEnumerator<object> GetEnumerator()
        {
            for (int i = 0; i < this.count; i++)
            {
                yield return this.elements[i];
            }
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return this.GetEnumerator();
        }
    }
}

//CSharp/Src/TestArrayListLib/ResizeArrayTest.cs
