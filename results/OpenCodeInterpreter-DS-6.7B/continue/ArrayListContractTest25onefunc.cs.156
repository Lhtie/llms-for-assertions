        public void PUT_RemoveAtContract([PexAssumeUnderTest] ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndex = index;
            int Old_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            bool Old_arrListContainsX = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            bool New_arrListContainsX = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_arrListIndex);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list size decreases by 1 after remove
            List<int> oldList = new List<int>(arrList);
            arrList.RemoveAt(index);
            List<int> newList = new List<int>(arrList);
            Debug.Assert(newList.Count == oldList.Count - 1);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ "IndexOf" of the removed item is -1 in new array list
            Debug.Assert(New_arrListIndexOfX == -1);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ "Contains" of the removed item is false in new array list
            Debug.Assert(!New_arrListContainsX);
        }

