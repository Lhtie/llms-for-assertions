            Debug.Assert(New_arrListCount == Old_arrListCount + 1);

	    // an assertion using "Debug..\.Assert\(.*?\);" that @@@ new inserted element is at the 'index' position in the array list 
            Debug.Assert(New_arrListContainsX == Old_arrListContainsX && !arrList.Contains(Old_x));

	    // an assertion using "Debug..\.Assert\(.*?\);" that @@@ the array list size remains the same after the insertion 
            Debug.Assert(arrList[Old_index].Equals(Old_x) && New_arrListCount == Old_arrListCount);
        }
    }
}

public partial class ArrayListContractTest
{
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        // Assume Preconditions
        AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

        // Store initial state
        int initialCount = arrList.Count;

        // Modify state
        arrList.Insert(index, x);

        // Observe state after insertion
        int afterInsertCount = arrList.Count;

        // Assert postconditions
        Assert.IsTrue(afterInsertCount == initialCount + 1);
        Assert.IsTrue(arrList.Contains(x));
    }
}
``` 

### 3. Testing with Arrange-Act-Assert:  

```csharp
[Test]
public void Sort_SortsListInAscendingOrder()
{
    // Arrange
    var numbers = new List<int> { 4, 2, 3, 1, 5 };

    // Act
    numbers.Sort();

    // Assert
    CollectionAssert.AreEqual(numbers, new List<int> { 1, 2, 3, 4, 5 });
}
``` 

### 4. Testing Mocking:  

```csharp
[Test]
public void GetOrderDetails_OrdersFound_ReturnListOfOrders()
{
    // Arrange
    var mockRepo = new Mock<IOrderRepository>();
    mockRepo.Setup(repo => repo.GetOrders()).Returns(GetTestOrders());
    var controller = new OrderController(mockRepo.Object);

    // Act
    var result = controller.GetOrderDetails();

    // Assert
    Assert.IsInstanceOf<List<OrderModel>>(result);
    mockRepo.Verify(repo => repo.GetOrders(), Times.Once);
}

private List<Order> GetTestOrders()
{
    var orders = new List<Order>
    {
        new Order { OrderId = 1, CustomerName = "Test1"},
        new Order { OrderId = 2, CustomerName = "Test2"},
        new Order { OrderId = 3, CustomerName = "Test3"}
    };

    return orders;
}
