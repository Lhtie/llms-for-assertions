            PexObserve.ValueForViewing("$new_arrList_Contains_obj", New_arrListContainsOldObj);

            // An assertion using "Debug.Assert\(.*?\);" that 
            // The count property of the old list has decremented by one
            Debug.Assert(Old_arrListCount == New_arrListCount + 1);

