            }
            else
            {
                AssumePrecondition.IsTrue(New_arrListCount == Old_arrListCount);
                AssumePrecondition.IsTrue(Old_arrListLastIndexOfX >= New_Ret);
                AssumePrecondition.IsTrue(New_arrListContainsX == Old_arrListContainsX);
            }
            PexObserve.ValueForViewing("IndexOf.Contract");
        }
