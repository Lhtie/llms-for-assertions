﻿// Copyright (c) Microsoft.  All Rights Reserved.  Licensed under the Apache License, Version 2.0.  See License.txt in the project root for license information.

using System;
using System.Collections.Generic;
using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp;

namespace Roslyn.Compilers.CSharp.Common
{
    public static class SyntaxTreeExtensions
    {
        public static IEnumerable<SyntaxTrivia> GetLeadingTrivia(this SyntaxTree tree)
        {
            foreach (var t in tree.GetRoot().GetLeadingTrivia())
            {
                yield return t;
            }
        }

        public static IEnumerable<SyntaxTrivia> GetTrailingTrivia(this SyntaxTree tree)
        {
            foreach (var t in tree.GetRoot().GetTrailingTrivia())
            {
                yield return t;
            }
        }
    }
}

//Source/Roslyn.Compilers.CSharp.BuildTasks/AddCompilerOutputs.cs
﻿// Copyright (c) Microsoft.  All Rights Reserved.  Licensed under the Apache License, Version 2.0.  See License.txt in the project root for license information.

using System;
using System.Collections.Generic;
using System.IO;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

using Roslyn.Compilers.CSharp.Common;

public class AddCompilerOutputs : Task
{
    public string[] SourceFiles { get; set; }

    [Required]
    public string CompilerOutputFiles { get; set; }

    public bool IncludeSourceFiles { get; set; }

    [Output]
    public string[] CompilerOutputFilesList { get; set; }

    public override bool Execute()
    {
        var sourceFiles = new List<string>(this.SourceFiles);
        var outputFiles = new List<string>(CompilerOutputFiles.Split(';'));

        if (IncludeSourceFiles)
        {
            foreach (var sourceFile in sourceFiles)
            {
                var file = Path.GetFileName(CompilerOutputFiles.Replace("*", Path.GetFileNameWithoutExtension(sourceFile)));
                outputFiles.Add(Path.Combine(Path.GetDirectoryName(sourceFile), file));
            }
        }

        CompilerOutputFilesList = outputFiles.ToArray();
        return true;
    }
}// Copyright (c) Microsoft.  All Rights Reserved.  Licensed under the Apache License, Version 2.0.  See License.txt in the project root for license--------------------        }
    }
