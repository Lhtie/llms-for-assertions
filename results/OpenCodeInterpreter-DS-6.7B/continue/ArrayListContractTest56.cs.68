//src/examples/CSharp/TestGenericList/GenericList.Test/GenericListContractTest.cs
﻿using System;
using System.Text;
using System.Collections.Generic;

using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using PexAPIWrapper;

using GenericList;

namespace GenericList.Test
{
    [TestFixture]
    public class GenericListContractTest
    {
        [PexMethod]
        public void PUT_AddContract<T>(GenericList<T> genList, T item)
        {
            AssumePrecondition.IsTrue(true);

            int oldCount = genList.Count;
            genList.Add(item);

            int newCount = genList.Count;

            AssumePostcondition.IsTrue(newCount - oldCount == 1);
            AssumePostcondition.IsTrue(genList.Contains(item));
        }

        [PexMethod]
        public void PUT_RemoveContract<T>(GenericList<T> genList, T item)
        {
            AssumePrecondition.IsTrue(genList.Count > 0);

            int oldCount = genList.Count;
            genList.Remove(item);

            int newCount = genList.Count;

            AssumePostcondition.IsTrue(oldCount - newCount == 1);
            AssumePostcondition.IsTrue(!genList.Contains(item));
        }
    }
}

