using NUnit.Framework;
using ArrayList;

namespace ArrayListTests
{
    [TestFixture]
    public class TestRemove
    {
        [Test]
        public void TestRemove_ItemPresent_CountDecreased()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            const int ItemToAdd = 5;
            const int ItemToRemove = 3;
            arrList.Add(ItemToAdd);
            arrList.Add(ItemToRemove);

            // Act
            arrList.Remove(ItemToRemove);

            // Assert 
            Assert.AreEqual(1, arrList.Count);
            Assert.IsFalse(arrList.Contains(ItemToRemove));
        }

        [Test]
        public void TestRemove_ItemAbsent_NoChange()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            const int ItemToAdd = 5;
            const int ItemToRemove = 3;
            arrList.Add(ItemToAdd);

            // Act
            arrList.Remove(ItemToRemove);

            // Assert 
            Assert.AreEqual(1, arrList.Count);
            Assert.IsTrue(arrList.Contains(ItemToAdd));
        }
    }
}

