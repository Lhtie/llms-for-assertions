import unittest
from ArrayList import ArrayList

class ArrayListTest(unittest.TestCase):
    def test_add(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        arrList2 = arrList[:]
        arrList.add(2, 4)
        self.assertListEqual(arrList, [1, 2, 4, 3])
        self.assertListEqual(arrList2, [1, 2, 3])

    def test_remove(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        arrList2 = arrList[:]
        arrList.remove(2)
        self.assertListEqual(arrList, [1, 3])
        self.assertListEqual(arrList2, [1, 2, 3])

    def test_insert(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        arrList2 = arrList[:]
        arrList.insert(1, 4)
        self.assertListEqual(arrList, [1, 4, 2, 3])
        self.assertListEqual(arrList2, [1, 2, 3])

    def test_set(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        arrList2 = arrList[:]
        arrList[1] = 4
        self.assertListEqual(arrList, [1, 4, 3])
        self.assertListEqual(arrList2, [1, 2, 3])

    def test_get(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        self.assertEqual(arrList[1], 2)

    def test_contains(self):
        arrList = ArrayList()
        arrList.append(1)
        arrList.append(2)
        arrList.append(3)
        self.assertTrue(arrList.contains(2))
        self.assertFalse(arrList.contains(4))

if __name__ == '__main__':
    unittest.main()
