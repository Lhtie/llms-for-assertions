using System;
using System.Diagnostics;
using ArrayList;

namespace ArrayListTest
{
    class Test
    {
        public static int Main()
        {
            // Create a new ArrayList
            ArrayList al = new ArrayList();

            // Verify the Count property
            Debug.Assert(al.Count == 0, "ArrayList Count");

            // Add an item
            al.Add(10);
            Debug.Assert(al.Count == 1, "ArrayList Add");

            // Add a negative integer
            al.Add(-1);
            Debug.Assert(al.Count == 2, "ArrayList Add - Negative Integer");

            // Add a zero
            al.Add(0);
            Debug.Assert(al.Count == 3, "ArrayList Add - Zero");

            // Test the IndexOf method
            Debug.Assert(al.IndexOf(10) == 0, "ArrayList IndexOf - Integer");
            Debug.Assert(al.IndexOf(-1) == 1, "ArrayList IndexOf - Negative Integer");
            Debug.Assert(al.IndexOf(0) == 2, "ArrayList IndexOf - Zero");
            Debug.Assert(al.IndexOf(11) == -1, "ArrayList IndexOf - Non-Existent Integer");

            // Test the LastIndexOf method
            al.Add(10);
            Debug.Assert(al.LastIndexOf(10) == 3, "ArrayList LastIndexOf - Integer");
            Debug.Assert(al.LastIndexOf(-1) == 1, "ArrayList LastIndexOf - Negative Integer");
            Debug.Assert(al.LastIndexOf(0) == 2, "ArrayList LastIndexOf - Zero");
            Debug.Assert(al.LastIndexOf(11) == -1, "ArrayList LastIndexOf - Non-Existent Integer");

            // Test the Contains method
            Debug.Assert(al.Contains(10), "ArrayList Contains - Integer");
            Debug.Assert(al.Contains(-1), "ArrayList Contains - Negative Integer");
            Debug.Assert(al.Contains(0), "ArrayList Contains - Zero");
            Debug.Assert(!al.Contains(11), "ArrayList Contains - Non-Existent Integer");

            // Test the Add method again
            Debug.Assert(al.Add(2) == al.Count, "ArrayList Add - Valid Value");
            try
            {
                bool caughtException = false;
                al.Add(null);
            }
            catch (System.NullReferenceException)
            {
                Debug.Assert(true, "ArrayList Add - Invalid (null) Value");
            }

            return 0;
        }
    }
}

