    using NUnit.Framework;
    using static Program;

    public class AssignmentSolverTest
    {
        private AssignmentSolver solver;
        
        [SetUp]
        public void Setup()
        {
            this.solver = new AssignmentSolver();
        }

        [Test]
        public void TestWordCount()
        {
            string[] text = { "hello world" };
            string[] word = { "hello" };
            Assert.AreEqual(1, this.solver.WordCount(text, word));
        }

        [Test]
        public void TestWordCountMultipleMatch()
        {
            string[] text = { "hello world", "hello there" };
            string[] word = { "hello" };
            Assert.AreEqual(2, this.solver.WordCount(text, word));
        }

        [Test]
        public void TestWordCountNoMatch()
        {
            string[] text = { "hello world", "goodbye there" };
            string[] word = { "hello" };
            Assert.AreEqual(0, this.solver.WordCount(text, word));
        }

        [Test]
        public void TestFindWordWithMostMatches()
        {
            string[] text = { "hello world", "hello there", "hello" };
            Assert.AreEqual("hello", this.solver.FindWordWithMostMatches(text));
        }

        [Test]
        public void TestFindWordWithMostMatchesTie()
        {
            string[] text = { "hello world", "hello there", "world" };
            Assert.IsNull(this.solver.FindWordWithMostMatches(text));
        }
    }
}namespace Assignment1
