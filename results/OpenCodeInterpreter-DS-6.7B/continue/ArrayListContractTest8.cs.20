        // The test target method for the ArrayList.Add() method.
        public int TestAdd(int x)
        {
            return arrList.Add(x);
        }

        // The test target method for the ArrayList.Contains() method.
        public bool TestContains(int x)
        {
            return arrList.Contains(x);
        }

        // The test target method for the ArrayList.IndexOf() method.
        public int TestIndexOf(int x)
        {
            return arrList.IndexOf(x);
        }

        // The test target method for the ArrayList.LastIndexOf() method.
        public int TestLastIndexOf(int x)
        {
            return arrList.LastIndexOf(x);
        }

        // The test target method for the ArrayList.Remove() method.
        public void TestRemove(int x)
        {
            arrList.Remove(x);
        }
    }
}

