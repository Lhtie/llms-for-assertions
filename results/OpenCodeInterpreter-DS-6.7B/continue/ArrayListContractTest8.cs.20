using System.Collections.Generic;
using PexAPIWrapper;

namespace ArrayList.Test
{
    public class ArrayListContractTest
    {
        // The ArrayList class to be tested.
        private static ArrayList arrList = new ArrayList();

        // The test target method for the ArrayList.Add() method.
        public int TestAdd(int x)
        {
            return arrList.Add(x);
