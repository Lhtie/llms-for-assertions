    using System;
    using System.IO;
    using System.Text.RegularExpressions;

    public class Program
    {
        public static void Main()
        {
            AssignmentSolver solver = new AssignmentSolver();

            // Read text from a file. Replace "text.txt" with your filename.
            string[] text = File.ReadAllLines("text.txt");

            // Your word list. Replace "words.txt" with your filename.
            string[] words = File.ReadAllLines("words.txt");

            foreach (string word in words)
            {
                int count = solver.WordCount(text, new string[] { word });
                Console.WriteLine($"The word '{word}' appears {count} time(s) in the text.");
            }

            string mostCommonWord = solver.FindWordWithMostMatches(text);
            if (mostCommonWord == null)
            {
                Console.WriteLine("There is no most common word.");
            }
            else
            {
                Console.WriteLine($"'{mostCommonWord}' is the most common word.");
            }
        }
    }

    public class AssignmentSolver
    {
        public int WordCount(string[] text, string[] words)
        {
            int count = 0;
            foreach (string word in words)
            {
                foreach (string line in text)
                {
                    if (line.Contains(word))
                    {
                        count++;
                    }
                }
            }

            return count;
        }

        public string FindWordWithMostMatches(string[] text)
