//Pizzeria/Pizzeria/PizzaService.cs
﻿using Pizzeria.Models;
using Realms;
using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Linq;
using System.Text;

namespace Pizzeria
{
    public class PizzaService
    {
        private Realm Realm;

        public PizzaService(Realm realm)
        {
            Realm = realm;
        }

        public void AddPizza(Pizza pizza)
        {
            using (var trans = Realm.BeginWrite())
            {
                Realm.Add(pizza);
                trans.Commit();
            }
        }

        public void RemovePizza(Pizza pizza)
        {
            using (var trans = Realm.BeginWrite())
            {
                Realm.Remove(pizza);
                trans.Commit();
            }
        }

        public ObservableCollection<Pizza> GetPizzas()
        {
            var pizzas = Realm.All<Pizza>().ToList();
            return new ObservableCollection<Pizza>(pizzas);
        }
    }
}

