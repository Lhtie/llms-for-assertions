//Code/Source/ArrayList/ArrayList.cs
using System;
using System.Collections.Generic;

namespace ArrayList
{
    public class ArrayList: IList
    {
    #region fields
        private object[] objects;
    #endregion

    #region constructors
        public ArrayList()
        {
            objects = new object[0];
        }

        public ArrayList(params object[] objs)
        {
            objects = objs;
        }
    #endregion

    #region methods
        public int Count
        {
            get { return this.objects.Length; }
        }

        public object this[int index]
        {
            get { return this.objects[index]; }
            set { this.objects[index] = value; }
        }

        public void Add(object obj)
        {
            Array.Resize(ref this.objects, this.Count + 1);
            this.objects[Count - 1] = obj;
        }

        public void AddRange(params object[] objs)
        {
            Array.Resize(ref this.objects, this.Count + objs.Length);
            objs.CopyTo(this.objects, this.Count - objs.Length);
        }

        public void Remove(object obj)
        {
            int indexOfObj = Array.IndexOf<object>(this.objects, obj);
            if (indexOfObj >= 0)
            {
                this.objects = this.objects.RemoveAtIndex(indexOfObj);
            }
        }

        public bool Contains(object obj)
        {
            return Array.IndexOf<object>(this.objects, obj) != -1;
        }

        public int IndexOf(object obj)
        {
            return Array.IndexOf<object>(this.objects, obj);
        }

        public int LastIndexOf(object obj)
        {
            return Array.LastIndexOf<object>(this.objects, obj);
        }
    #endregion
    }

    public static class Extensions
    {
        public static T[] RemoveAtIndex<T>(this T[] array, int index)
        {
            T[] newArray = new T[array.Length - 1];
            if (index > 0)
            {
                Array.Copy(array, 0, newArray, 0, index);
            }

            if (index < array.Length - 1)
            {
                Array.Copy(array, index + 1, newArray, index, array.Length - index - 1);
            }

            return newArray;
        }
    }
}

