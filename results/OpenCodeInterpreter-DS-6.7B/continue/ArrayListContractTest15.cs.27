using System;

namespace System.Reactive.Internal
{
    internal static class DisposableExtensions
    {
        public static bool TryGetDisposable(this object source, out IDisposable disposable)
        {
            if (source is IDisposable)
            {
                disposable = (IDisposable)source;
                return true;
            }
            else
            {
                disposable = null;
                return false;
            }
        }
    }
}// Copyright (c) Microsoft Corporation. All rights reserved. See License.txt in the project root for license information.

using System;
using System.Reactive.Concurrency;

namespace System.Reactive.Internal
{
    internal sealed class SubjectSubscription<T> : ISubscription, IDisposable
    {
        private readonly ISubject<T> _subject;
        private ISubscription _upstream;

        public SubjectSubscription(ISubject<T> subject)
        {
            _subject = subject;
        }

        public void Dispose()
        {
            var upstream = _upstream;
            if (upstream != null)
            {
                _upstream = null;
                _subject.OnUnsubscribe(upstream);
            }

            Subjects.Dispose(_subject--------------------	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list count is not same as last index of x in old array 
        }

