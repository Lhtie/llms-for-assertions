            Assert.That(New_arrListContainsX == true, "New array list contains " + "'" + Old_x.ToString() + "'.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of old array contains x
            Assert.That(New_arrListLastIndexOfX == Old_arrListCount - 1, "The last index of the array list contains " + "'" + Old_x.ToString() + "'.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of old array contains x
            Assert.That(New_arrListIndexOfX == Old_arrListCount, "The index of the array list contains " + "'" + Old_x.ToString() + "'.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ count of old array plus one equals count of new array
            Assert.That(New_arrListCount == Old_arrListCount + 1, "Count of the array list is " + (Old_arrListCount + 1).ToString() + ".");
        }

    }
}

//ArrayList/ArrayList.Test/ArrayListTest.cs
﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListTest
    {
        [PexMethod]
        public void Test1()
        {
            // The method should add an item to the end of the list and return the position where 
            // the item has been added. The position of the first item added to the ArrayList should be 0

            ArrayList arrList = new ArrayList();

            arrList.Add(1);

            Assert.AreEqual(0, arrList.IndexOf(1));

            arrList.Add(2);

            Assert.AreEqual(0, arrList.IndexOf(1));
            Assert.AreEqual(1, arrList.IndexOf(2));

            arrList.Add(3);

            // The third item added should be at position 2 or greater. This is because the list is dynamic
            Assert.GreaterOrEqual(arrList.IndexOf(3), 2);

            // Test addition on full size
            while (arrList.Size >= 100)
            {
                arrList.Add(42);
            }

            Assert.AreEqual(arrList.Size, 100);
            Assert.AreEqual(99, arrList.IndexOf(3));
            Assert.AreEqual(100, arrList.IndexOf(42));
        }

        [PexMethod]
        public void Test2()
        {
            // The method should throw an ArgumentOutOfRangeException if you try to add an item 
            // beyond the bounds (index > Count) of the ArrayList

            ArrayList arrList = new ArrayList();

            arrList.Add(1);

            Assert.Throws<ArgumentOutOfRangeException>(() => arrList.Add(2, 1));
        }

        [PexMethod]
        public void Test3()
        {
            // The method should throw an ArgumentOutOfRangeException if you try to access an item's 
            // position index > Count

            ArrayList arrList = new ArrayList();

            arrList.Add(1);

            Assert.Throws<ArgumentOutOfRangeException>(() => arrList[1]);
        }
    }
}

