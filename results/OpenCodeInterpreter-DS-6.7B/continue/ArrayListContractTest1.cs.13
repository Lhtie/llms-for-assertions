using System.Linq;
using System.Collections.Generic;

namespace ExtCore.Infrastructure.Actions
{
  public abstract class ActionBase
  {
    private static List<ActionBase> Actions { get; } = new List<ActionBase>();
    
    protected ActionBase()
    {
      Actions.Add(this);
    }
    
    public static IEnumerable<ActionBase> GetActions()
    {
      return Actions;
    }
    
    public static TAction GetAction<TAction>() where TAction : ActionBase
    {
      return Actions.OfType<TAction>().FirstOrDefault();
    }
  }
