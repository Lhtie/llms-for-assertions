namespace NUnit.Framework.Constraints
{
    using System;
    using System.Collections;

    /// <summary>
    /// The EmptyConstraint is used when an argument is expected to be null or empty collection.
    /// </summary>
    public class EmptyConstraint : Constraint
    {
        public override bool Matches(object actual)
        {
            return actual == null || IsEmptyCollection(actual);
        }

        private static bool IsEmptyCollection(object actual)
        {
            var collection = actual as ICollection;
            return collection != null && collection.Count == 0;
        }

        public override void WriteDescription(MessageWriter writer)
        {
            writer.Write("empty");
        }

        public override void WriteActualValueTo(MessageWriter writer)
        {
            writer.WriteActualValue(TestDelegate);
        }
    }
}
