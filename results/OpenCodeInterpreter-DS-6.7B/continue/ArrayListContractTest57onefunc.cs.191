using System;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_GetEnumeratorContract([PexAssumeUnderTest]ArrayList arrList)
        {
            IEnumerator New_enum = arrList.GetEnumerator();

            Assume.That(New_enum != null);

            int cnt = 0;
            while (New_enum.MoveNext())
            {
                cnt++;
            }

            Assume.That(cnt == arrList.Count);
        }
    }
}

