﻿using Contracts.Dtos;
using Contracts.Services;
using System;

namespace Test
{
    class Program
    {
        static void Main(string[] args)
        {
            ICustomerService customerService = new CustomerService.CustomerService();
            var response = customerService.GetAllCustomers();

            if (response.Successful)
            {
                Console.WriteLine("All customers:");
                foreach (var customer in response.Result)
                {
                    Console.WriteLine($"Id: {customer.Id}, Name: {customer.Name}, Email: {customer.Email}");
                }
            }
            else
            {
                Console.WriteLine("An error occurred: " + response.Exception.Message);
            }
        }
