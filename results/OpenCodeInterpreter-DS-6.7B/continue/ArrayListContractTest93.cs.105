﻿using System;
using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList.Test
{
    class Program
    {
        static void Main(string[] args)
        {
            TestArray();
            Console.ReadLine();
        }

        static void TestArray()
        {
            CustomArrayList array = new CustomArrayList();

            array.Add(5);
            array.Add(3);
            array.Add(4);
            array.Add(2);
            array.Add(1);

            Console.WriteLine("Array: ");
            Debug.Assert(array.ToString() == "5 3 4 2 1 ");

            array.Sort();

            Console.WriteLine("Sorted array: ");
            Debug.Assert(array.ToString() == "1 2 3 4 5 ");

            Debug.Assert(array.Contains(3));
            Debug.Assert(array.IndexOf(4) == 2);
            Debug.Assert(array.LastIndexOf(2) == 1);

            array.Remove(2);
            Debug.Assert(array.ToString() == "1 3 4 5 ");

            array.Insert(2, 6);
            Debug.Assert(array.ToString() == "1 3 6 4 5 ");

            array[1] = 8;
            Debug.Assert(array.ToString() == "1 8 6 4 5 ");
        }
    }
}

