}﻿namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_Add_contract([PexAssumeUnderTest]ArrayList a, int element)
        {
            AssumePrecondition.IsTrue(a.Count < a.MaxCapacity);

            int old_count = a.Count;
            int old_element = element;

            a.Add(element);

            int new_count = a.Count;
            bool new_contains_element = a.Contains(element);

            PexObserve.ValueForViewing("$old_count", old_count);
            PexObserve.ValueForViewing("$new_count", new_count);
            PexObserve.ValueForViewing("$old_element", old_element);
            PexObserve.ValueForViewing("$new_contains_element", new_contains_element);

            // assert that new count is old count + 1
            Assert.AreEqual(old_count + 1, new_count);

            // assert that new ArrayList contains old element
            Assert.IsTrue(new_contains_element);
        }
    }
