```
using System.Diagnostics;

namespace ArrayList.Tests
{
    [TestClass]
    public class ArrayListTest
    {
        // Test method for PUT_InsertContract()
        [TestMethod]
        public void PUT_InsertContract_Test()
        {
            PexSession session = PexMethod.DefaultSession;
            session.Settings.AutoFlush = true;
            session.ForEach<TestData>(td =>
            {
                ArrayListContractTest test = new ArrayListContractTest();
                test.PUT_InsertContract(td.arrList,td.x, td.index);
            });
        }

        // test data class
        public class TestData
        {
            [PexFactory]
            public static TestData CreateData()
            {
                TestData data = new TestData();
		// Initialization of data
		data.arrList = new ArrayList();
		data.x = data.arrList.Add(...);

                // Adding values to ArrayList
                data.arrList.Add(...);

                data.index = 0; // or some other value
                return data;
            }

            public ArrayList arrList;
            public int x;
            public int index;
        }
    }
}
```

### Verify the Precondition of your Test Data
```csharp
using Microsoft.Pex.Framework;

//...

[TestMethod]
public void PUT_InsertContract_Test()
{ 
    PexSession session = PexMethod.DefaultSession;
    session.Settings.AutoFlush = true;
    session.ForEach<TestData>(td =>
    {
        Assume.True(td.index <= td.arrList.Count && td.index >= 0); // verify preconditions

        ArrayListContractTest test = new ArrayListContractTest();
        test.PUT_InsertContract(td.arrList,td.x, td.index);
    });
}
```

