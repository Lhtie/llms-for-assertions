// This file is heavily based on the original code provided by Microsoft Research Cambridge

using System;
using System.Diagnostics;

namespace Microsoft.Research.BiPrint.Contracts
{
    /// <summary>
    /// The BiPrintSettings class provides a flexible means of controlling BiPrint behaviors.  
    /// </summary>
    [DebuggerStepThrough]
    public class BiPrintSettings
    {
        public const int MaxOutputSize = 2000;
        private int maxQueueSize = 1000000;
        private Verifier defaultVerifier = null;
        private int defaultPageSize = -1;

        /// <summary>
        /// The maximum queue size for a particular printer.  Default is 1,000,000.
        /// </summary>
        public int MaxQueueSize
        {
            get { return maxQueueSize; }
            set
            {
                if (value <= 0) throw new ArgumentException(Resources.ArgumentMustBePositive, "value");
                maxQueueSize = value;
            }
        }

        /// <summary>
        /// The default verifier for a printer.  If not set explicitly, then a printer should use a predefined verifier.
        /// </summary>
        public Verifier DefaultVerifier
        {
            get { return defaultVerifier; }
            set { defaultVerifier = value; }
        }

        /// <summary>
        /// The default page size for a printer.  A value of -1 indicates that the page size should not be changed.
        /// </summary>
        public int DefaultPageSize
        {
            get { return defaultPageSize; }
            set
            {
                if (value < -1) throw new ArgumentException(Resources.ArgumentMustNotBeLessThanMinusOne, "value");
                defaultPageSize = value;
            }
        }
    }
