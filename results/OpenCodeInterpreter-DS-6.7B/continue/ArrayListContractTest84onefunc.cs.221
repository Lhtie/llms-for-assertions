        Assert.IsTrue(primeCollection.IsPrime(last), "The last number is not a prime.");

        // Postcondition: The last number is now a prime number.
        Assert.IsTrue(primeCollection.IsPrime(number), "The number is--------------------            Assert.IsTrue(New_arrListCount >= -1);

