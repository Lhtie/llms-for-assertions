//tests/DotNet/Core/Collections/ArrayList.Test/ContractTests/ArrayListContractTest.PUT_RemoveAtContract.cs
using System.Collections;
using Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index, object expectedItem)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count, "index is within the valid range.");
            AssumePrecondition.IsNotNull(arrList, "arrList is not null.");

            object OldItem = arrList[index];

            bool New_arrListRemoveAt_success = arrList.Remove(index) == expectedItem;
            PexObserve.ValueForViewing("$oldItem", OldItem);

            bool New_arrListIndexOf_oldItem = !arrList.Contains(OldItem);
            PexObserve.ValueForViewing("$new_arrListRemoveAt_success", New_arrListRemoveAt_success);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_oldItem", New_arrListIndexOf_oldItem);

            // @@@ If the method returns true, the specified item was in the list, the list contains no references to the specified items.
            // @@@ If the method returns false, the specified item was not in the list, the list unchanged.
        }
    }
}

//tests/DotNet/Core/Collections/ArrayList.Test/ContractTests/ArrayListContractTest.PUT_SortContract.cs
using System.Collections;
using Pex.Framework;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList a, IComparer c)
        {
            AssumePrecondition.IsNotNull(a, "a is not null.");
            AssumePrecondition.IsNotNull(c, "c is not null.");

            ArrayList OriginalList = new ArrayList(a);

            a.Sort(c);

            // Contract assertion that the 'a' list is a valid sorted list as per the 'c' comparer 
            PexAssert.TrueForAll(i => c.Compare(a[i], a[i+1]) <= 0, "All elements in sorted list are in the right order.");
            // Contract assertion that all the original elements are still in the list after sorting.
            PexAssert.TrueForAll(i => OriginalList.Contains(a[i]));
            // Contract assertion that the length of the original list and sorted list is the same.
            PexAssert.AreEqual(OriginalList.Count, a.Count);
        }
    }
}

