﻿using NGenerics.Patterns.Contracts;
using NGenerics.Tests.DataStructures.ArrayList.Test;
using NGenerics.Tests.TestObjects;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveAll_ArrayList(ArrayList<TestObject> arrList, TestObject item)
        {
            Require.That(item).IsNotNull();

            arrList.RemoveAll(delegate(TestObject obj) {
                return obj.Id == item.Id;
            });

            foreach(TestObject obj in arrList) {
                Require.That(obj).IsNotNull();
                Assert.IsFalse(obj.Id == item.Id, "The item was removed from the ArrayList.");
            }
        }
    }
}

