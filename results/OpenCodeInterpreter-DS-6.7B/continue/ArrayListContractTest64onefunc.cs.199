            bool Assert_IndexOf_x = New_Ret ? Old_arrListIndexOfX == New_arrListIndexOfX : (New_arrListIndexOfX == -1);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ In any case if the original value was false, the new value also should be false and should be exactly the old value
            bool Assert_newVal = (Old_arrListCount == New_arrListCount) && (Old_arrListIndexOfX < New_arrListIndexOfX || New_arrListIndexOfX == -1) && (Old_arrListLastIndexOfX < New_arrListLastIndexOfX || New_arrListLastIndexOfX == -1);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ In the case where the return value was true, the arraylist count would remain same and index and last index location of the value x in the arraylist should be same in the old list and new list
            bool Assert_retVal = New_Ret ? (Old_arrListCount == New_arrListCount && Old_arrListIndexOfX == New_arrListIndexOfX && Old_arrListLastIndexOfX == New_arrListLastIndexOfX) : true;

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is true, count of the list should be less by either 1 or 0
            bool Assert_Count_retVal = New_Ret ? Math.Abs(Old_arrListCount - New_arrListCount) <= 1 : true;
        } 

        public void PUT_ContainsContract([PexInvariant]ArrayList arrList, int x)
        {
            AssumePostcondition.ForAll(i => !arrList.Contains(i));
        }
