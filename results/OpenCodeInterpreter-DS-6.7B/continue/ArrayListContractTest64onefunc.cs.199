﻿using NGenerics.Tests.DataStructures.ArrayList.Test;
using NGenerics.Tests.TestObjects;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void RemoveRange_ArrayList(ArrayList<TestObject> arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(index >= 0, "index >= 0");
            AssumePrecondition.IsTrue(count >= 0, "count >= 0");
            AssumePrecondition.IsTrue(index + count <= arrList.Count, "index + count <= arrList.Count");

            int oldCount = arrList.Count;

            arrList.RemoveRange(index, count);

            Assert.AreEqual(oldCount - count, arrList.Count);

            for (int i = index; i < index + count; i++)
            {
                Assert.IsFalse(arrList.Contains(arrList[i]));
            }
        }
    }
}

