﻿namespace MoneyTransfer.Models
{
    public class TransferMoneyResponse
    {
        public bool Success { get; set; }
        public string ErrorMessage { get; set; }
    }
}

//MoneyTransfer/MoneyTransfer/Services/BankService.cs
﻿using Bank;
using MoneyTransfer.Models;

namespace MoneyTransfer.Services
{
    public interface IBankService
    {
        void FundAccount(string accountId, decimal amount);
        void TransferMoney(string fromAccountId, string toAccountId, decimal amount);
    }

    public class BankService : IBankService
    {
        private Bank.Bank _bank;

        public BankService()
        {
            _bank = new Bank.Bank();
        }

        public void FundAccount(string accountId, decimal amount)
        {
            var account = _bank.GetAccount(accountId);
            if (account != null)
            {
                account.Deposit(amount);
            }
        }

        public void TransferMoney(string fromAccountId, string toAccountId, decimal amount)
        {
            var fromAccount = _bank.GetAccount(fromAccountId);
            var toAccount = _bank.GetAccount(toAccountId);

            if (fromAccount != null && toAccount != null)
            {
                if (fromAccount.Withdraw(amount))
                {
                    toAccount.Deposit(amount);
                }
            }
        }
    }
}

//MoneyTransfer/MoneyTransfer/Controllers/TransferMoneyController.cs
﻿using Microsoft.AspNetCore.Mvc;
using MoneyTransfer.Models;
using MoneyTransfer.Services;

namespace MoneyTransfer.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class TransferMoneyController : ControllerBase
    {
        private readonly IBankService _bankService;

        public TransferMoneyController(IBankService bankService)
        {
            _bankService = bankService;
        }

        [HttpPost]
        public ActionResult<TransferMoneyResponse> Post(TransferMoneyRequest request)
        {
            var response = new TransferMoneyResponse();

            try
            {
                _bankService.TransferMoney(request.FromAccountId, request.ToAccountId, request.Amount);
                response.Success = true;
            }
            catch
            {
                response.Success = false;
                response.ErrorMessage = "An error occurred during money transfer.";
            }

            return response;
        }
    }
}

