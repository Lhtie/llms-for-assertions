            int maxArrayIndex = arrList.Count - 1; 
            Assert.IsTrue(New_arrListLastIndexOfX <= maxArrayIndex, "Assertion failed: New_arrListLastIndexOfX should be less than or equal to " + maxArrayIndex);
	    // a sanity check for some value to ensure that the above sanity check does not cause any exceptions 
            Assert.AreEqual(3, arrList[0]);
            PexAssume.Fail("");

        }
    }
}

