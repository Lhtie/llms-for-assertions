            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfRemovedElement = arrList.IndexOf(Old_arrListElementAtIndex);
            bool New_arrListContainsRemovedElement = arrList.Contains(Old_arrListElementAtIndex);

