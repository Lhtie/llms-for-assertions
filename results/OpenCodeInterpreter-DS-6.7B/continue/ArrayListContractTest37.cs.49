//Test/ArrayListCustomAssertionExampleTest.cs
using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Exceptions;
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public class ArrayListCustomAssertionExampleTest
    {
        private static ArrayList ArrayListCustomAssertionExample(ArrayList arrList, int index)
        {
            // Assert the index is a valid one
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            // The size before the operation
            int oldSize = arrList.Count;

            // Perform the custom assertion
            CustomAssert.GreaterThanOrEqualTo(oldSize - 1, arrList.Count);

            // The operation
            arrList.RemoveAt(index);

            // Perform the custom assertion
            CustomAssert.LessThanOrEqualTo(oldSize, arrList.Count);

            return arrList;
        }

        [PexMethod]
        public void ArrayListCustomAssertionExampleTest()
        {
            PexAssume.ForAll(typeof(PexMembersForList<>))
                .Constructor(typeof(int)) // A dummy constructor
                .Invoke("AddRange", new Type[] { typeof(int[]) }); // Dummy AddRange method call

            PexObserve.ValueForViewing("arrList", arrList);
            PexObserve.ValueForViewing("Index", index);
        }
    }

    // Implement the custom assertions
    public static class CustomAssert
    {
        public static void GreaterThanOrEqualTo(int expected, int actual)
        {
            Assert.LessOrEqual(expected, actual, "{0} was not greater or equal to {1}.", actual, expected);
        }

        public static void LessThanOrEqualTo(int expected, int actual)
        {
            Assert.GreaterOrEqual(expected, actual, "{0} was not less or equal to {1}.", actual, expected);
        }
    }
}

