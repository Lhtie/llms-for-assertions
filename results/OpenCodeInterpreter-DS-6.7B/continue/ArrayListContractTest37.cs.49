        [PexMethod]
        public void PUT_AddRangeContract<T>([PexAssumeUnderTest]ArrayList arrList, T[] arr)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrCount = arr.Length;
            T Old_arrListFirstElement = arrList.Count > 0 ? (T)arrList[0] : default(T);

