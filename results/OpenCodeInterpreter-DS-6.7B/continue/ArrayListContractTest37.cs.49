            T New_arrListFirstElement = arrList.Count > 0 ? (T)arrList[0] : default(T);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arr_Count", Old_arrCount);
            PexObserve.ValueForViewing("$old_arrList_FirstElement", Old_arrListFirstElement);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_FirstElement", New_arrListFirstElement);

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
