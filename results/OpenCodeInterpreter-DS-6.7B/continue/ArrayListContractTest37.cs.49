﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace HeroesAndVillains.Models
{
    public class Hero
    {
        public string Name { get; set; }
        public string PhotoUrl { get; set; }
        public List<string> Powers { get; set; }
        public int Age { get; set; }
    }
}

//HeroesAndVillains/Repositories/HeroRepository.cs
﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using HeroesAndVillains.Models;

namespace HeroesAndVillains.Repositories
{
    public class HeroRepository : IHeroRepository
    {
        static List<Hero> _heroes = new List<Hero>
        {
            new Hero { Name = "Superman", Age = 30, PhotoUrl = "https://upload.wikimedia.org/wikipedia/en/3/35/Supermanflying.png", Powers = new List<string> { "Flying", "Laser Eyes", "Invulnerability" } },
            new Hero { Name = "Batman", Age = 40, PhotoUrl = "https://upload.wikimedia.org/wikipedia/en/9/9b/Batman_DC_Comics.png", Powers = new List<string> { "Intelligence", "Rich", "Technology" } },
            new Hero { Name = "Wonder Woman", Age = 20, PhotoUrl = "https://upload.wikimedia.org/wikipedia/en/e/ed/Wonder_Woman_1984_Jim_Henson.png", Powers = new List<string> { "Super human Strength", "Invulnerability", "Speed" } }
        };

        public IEnumerable<Hero> GetAll() => _heroes;
    }
}

