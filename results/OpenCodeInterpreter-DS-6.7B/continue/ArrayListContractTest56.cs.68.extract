------------------------------------------------------------            // but if the return value is true then new size will be greater than the old one
	    Debug.Assert(New_Ret == PexAPIWrapper.PexObserve.TrueReturnValue<bool>() || New_arrListCount == Old_arrListCount + 1);
------------------------------------------------------------	    System.Diagnostics.Debug.Assert((New_Ret != false) || (Old_arrListCount == New_arrListCount));
