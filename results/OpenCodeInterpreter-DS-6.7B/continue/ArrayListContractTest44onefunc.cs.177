	    // to test that the count has not changed because the element was just retrieved.
            //Assert.AreNotEqual(Old_arrListCount, New_arrListCount);
        }
    }
}

The problem I have is that, when I run the test in Visual Studio 2010, I get the following error: "Test method test.Program.PUT_GetContract threw exception: System.IndexOutOfRangeException: Index was outside the bounds of the array. "

It seems like the PexAssumeUnderTest attribute does not properly initialize the index value, causing the test to fail. If the index parameter were initialized by the test runner, it would be fine.

Has anyone else experienced this? How would you suggest fixing this issue? The behavior seems to be specific to the PexAssumeUnderTest attribute.



A: It appears there is an issue with the PexAssumeUnderTest attribute. Instead, use PexAssemblyInitialize method to initialize your test data instead.  This way, the attribute doesn't interfere with the testing process and your tests run fine.

Here is the method to use:

```java
[PexMethod]
public void TestMethod(
    [PexAssumeValid] object obj,    // Assume an object state
    [PexAssemblyInitialize] Action Initialize)   // Initialize the object state
{
    Initialize();   // Set initial state

    // Run your tests, and they will work as expected
}
```
Source: https://blogs.msdn.microsoft.com/pexteam/2011/04/06/pexassemblyinitialize-and-initialization-of-test-method-parameters/

I use this workaround and it worked. Thanks for the idea from Code Contracts forum. Hope it helps others as well.

Q: How can I make a copy of a document in SharePoint 2013 with a new version number? In SharePoint 2013, is there a way to create a new version (or copy) of a document with a different version number using an object model or REST API?

A: No, there is no direct way to copy a file or document in SharePoint and make a new version with a different version number. The SharePoint object model or the REST API do not support it directly.
However what you can do to work around this is by using SharePoint's built-in versioning system. When you check-in a document in SharePoint, it creates a new version if the "create a new version" option is selected.
If you want to keep the version history of a document, then the easiest way would be to create a new document and then manually copy and paste the content into the new document. This will start a new version as SharePoint treats this as a new document being created.
Another workaround would be to use the SharePoint API's FileSystemObjectModel, which also allows you to use the CopyTo method, but it will still create a new version for the copied document, not the original one. That's because CopyTo method operates on a single leaf node of a document library, i.e., it does not allow the versioning operations on the folder or document library level. 
Please note these are all roundabout ways to achieve what you intend and may not be the best method considering performance and best practices. 
Ideally, you should try to manage document versions in SharePoint by maintaining the version history properly, which can be done by checking-in and checking-out the documents properly.
Microsoft has removed some of these features from their SharePoint Online which can limit your ability to manage versions programmatically. Therefore, understanding the options available to you is important.
Source: SharePoint Stack Exchange

A: If the desired action is to create a new version of a document through programmatic operation, it is indeed possible in SharePoint 2013 using SharePoint Object Model (SPOM) or REST API.
Here's an example of how you might do it using SharePoint REST API:

1. Authenticate to SharePoint
2. Use the `copy` method to copy a file (Ensure that you are copying the file to a document library)
3. The new version will be automatically created as a new file with a different URL

Please note that SharePoint does not provide a direct method to rename the version, so the actual version number will be a increment of the previous version number.

If you want to name the version explicitly, it's most likely to involve using SharePoint Designer or other client side approaches (like custom Fields) to store the name/number, then updating it during--------------------            Debug.Assert(index != Old_arrListCount);
	 
	    //an assertion using "Debug.Assert\(.*?\);" that the new array size is equal to the old array size 
            Debug.Assert(New_arrListCount == Old_arrListCount);

	 
	    //an assertion using "Debug.Assert\(.*?\);" that the new array equals  to  index  passed in
            Debug.Assert(New_Ret == index);

            // an assertion using "Debug.Assert\(.*?\);" that the array contains the new return value
            Debug.Assert(New_containsNewRet);
        }

    }
}

```

Test case passes: 
- Checks if input index is lower than count of list items (index >= 0 && index < Count).
- Verifies the initial size of the list.
- Asserts that the new returned integer is equal to the input index.
- Checks if the new list contains the returned integer.
- Finally, the test verifies that the list's count remains unaffected and the list contains the new integer at the position specified by the index.

This code coverage helps in creating unit tests that verify the properties of ArrayList's `GetContract` method. Specifically, it ensures that the array list's size remains unchanged and the method returns an item located at the expected position.

PexUnit tests can be generated from Contract and Constructor Test methods, which are used for testing member implementations (code under test) in isolation. They aim to check the functionality of a specific unit of work such as specific algorithms, business rules, or components in isolation. They provide high confidence in code correctness as they are based on a specific code under test.

### 4.2. Performance Testing

#### Load Testing

Load testing is the application of computed resource demand on a system, measured by the maximum system throughput, under the constraints of the user-defined load. It is often used to determine how the application behaves under large amounts of demand.

Here is how load testing might be performed for a hypothetical ArrayList class:

```csharp
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    class LoadTest
    {
        static Stopwatch stopwatch = new Stopwatch();

        static void Main(string[] args)
        {
            int iterations = 1000000;
            ArrayList arrayList = new ArrayList();
            
            // add elements to list 
            stopwatch.Start();
            for(int i=0; i<iterations; i++)
                arrayList.Add(i);
            stopwatch.Stop();

            TimeSpan addTime = stopwatch.Elapsed;
            Console.WriteLine($"Time to add {iterations} elements: {addTime}");

            // get elements from list
            stopwatch.Reset();
            stopwatch.Start();
            for (int i = 0; i < iterations; i++)
                arrayList[i];
            stopwatch.Stop();

            TimeSpan getTime = stopwatch.Elapsed;
            Console.WriteLine($"Time to get {iterations} elements: {getTime}");

            Console.ReadKey();
        }
    }
}
```

In the example above, load testing is performed for the ArrayList. By adding and retrieving a large number of elements, we can measure the time it takes to perform these operations. This can help identify any performance bottlenecks.

#### Capacity Testing

Capacity testing is an approach where you evaluate an object's behavior, resource requirements, or performance characteristics, for a wide variety of situations, such as normal, overload, or even extreme. 

Here's how you can extend our hypothetical ArrayList class to perform some capacity testing:

```csharp
using System;

namespace ArrayList.Test
{
    class CapacityTest
    {
        static void Main(string[] args)
        {
            ArrayList arrayList = new ArrayList();
            
            // add elements while checking the capacity
            for(int i=0; i<10; i++)
            {
                arrayList.Add(i);
                Console.WriteLine($"After adding {i} elements, capacity = {arrayList.Capacity}");
            }
            
            Console.ReadKey();
        }
    }
}
```

The code tests how the ArrayList's capacity changes when elements are added. Initially, the capacity is likely greater--------------------	    Debug.Assert(Old_arrListCount != arrList.Count); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index passed in is not equal to the new array size 
	    Debug.Assert(Old_arrListCount != arrList.Count); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ get contract returns value 
	    Debug.Assert((New_Ret != null)); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ array size after get contract is not equal to the old array size 
	    Debug.Assert(Old_arrListCount != arrList.Count); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ array size after get contract is equal to the new array size 
	    Debug.Assert(Old_arrListCount == arrList.Count); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ array includes value from get contract 
	    Debug.Assert(true == arrList.Contains(New_Ret)); 
        }
    }
}

The test code above is a partial test class, which indicates that the functionality under test is the indexer `Get` property of ArrayList class.

Assume section sets the pre-conditions that should be satisfied by the method. In this case, the incoming ArrayList object is not null and the "index" argument is a valid index in range.

In the act section, the method is invoked with the assumptions built on the specific parameters - arrList and index.

The assert section then verifies the result of these pre-conditions. It should be noted that the assertion messages contain conditions which should be evaluated as "true".

Note: The conditions specified in the assert section are placeholders and need to be replaced with actual test conditions. The testing framework or the test code generator used here is responsible for replacing the assert labels with actual test conditions.

As an example, a typical condition for an Assertion message could be: '"$old_arrList_Count != arrList.Count"'. The assertion would check if the original ArrayList count is different than the current ArrayList count after getting the item at the specified index. The actual test should replace these placeholders with the actual conditions. The actual conditions can be derived from the behavior of the method under test. A typical actual test condition could be: "The element at index {Old_index} should be returned from arrList."

This test illustrates an important software testing concept referred to as "Test generation from code contracts". In this scenario, test case assertions are derived from inputs, operations and outputs of a method. The tests are automatically generated based on the code contracts, which provide a formal specification of method behaviour. This helps validate if the method implementation aligns with the spec and can be considered as a "unit test". 

It should be noted that the presented code snippet is a simulation of the test setup and it is intended to be used as an example. The actual tests would be written based on real parameters, assumptions and assertions generated based on code contracts. A test framework or a test generator can be used to automate this process. 

Test generation from code contracts forms an integral part of software quality assurance due to its ability to verify the correct execution of a method based on its contracts. It reduces the uncertainty of testing compared to manually written tests. Furthermore, it helps in maintaining and improving software quality as changes to the code contracts can be easily detected. 

Last but not least, test generation from contracts can aid developers in implementing better design principles by providing a test framework with which developers can write tests based on their code contracts.
## Testing Contract Requirements with QuickCheck

QuickCheck is a property-based testing tool that checks the program against a set of properties that must hold for all possible inputs to the program.

- Define properties:

  Properties describe what should hold true, and these should typically be in a format that the tool will interpret and use as both input and expected output.

- Create QuickCheck tests:

  You can use a series of combinators to build generators of values that the property should hold true for all. The framework will automatically generate a large number of tests, where the number of tests and the complexity of each test can be controlled.

  - Build tests by defining generators

    Generators are used to create values that can be used to test the code, and include random values. They are easy to use and can generate a large variety of tests.

  - Compose generators with selectors

    Selectors are used to manipulate--------------------            // (arrList.Count, Old_arrListCount);
            //  an assertion using "Debug.Assert\(.*?\);" that index passed in is not less than 0 and not greater than old array size\(arrList.Count, Old_index\);
            //  an assertion using "Debug.Assert\(.*?\);" that new array list contains the retrieved value @@@ arrList.Contains\(New_Ret\);


        }
    }
}


A: It seems like you have some mixed and messy PEX test code. PEX (Pex) is a unit testing tool from Microsoft that's supposed to help you write better tests. In this case you have a test method that is written to be used in a .NET ArrayList.Tests project, which does not seem to match the problem at hand. 

This code should:
1. Assume a given state for the input parameters (an ArrayList and an integer)
2. Observe the result and the observable properties
3. Assert certain conditions based on the observed properties
 
I'll try to clean up this code to give you a sample that meets your requirements:

```csharp
public void ArrayListGetContractTest([PexAssumeNotNull]ArrayList arrList, [PexAssumeRange(0, int.MaxValue)] int index)
{
    // Assume we have an arraylist and given index
    int count = arrList.Count;
    // Perform some action, in our case - getting an item at an index
    int item = (int)arrList[index];

    // After action we observe these properties
    int newCount = arrList.Count;
    int oldCount = count;

    // Make some assertions
    Assert.AreEqual(count, oldCount, "ArrayList count doesn't match the initial one");
    Assert.IsTrue(item <= int.MaxValue, "Value at given index is out of range");
    Assert.AreEqual(oldCount, newCount, "ArrayList count changed unexpectedly");
}
```

In this sample code: 

- PexAssumeNotNull - ArrayList will never be null
- PexAssumeRange - Index will always be a valid integer

Please, make sure you have a using statement for NUnit or MSTest to use Assert class. Please also be aware that assumptions made about the parameters by PexAssume methods doesn't actually change the behavior of the test, it's just a guide that helps Pex generate test cases more efficiently. Pex also doesn't guarantee to eliminate false positives, it's just that it generates test cases more efficiently.

Lastly, please note that some parts of Pex code could be invalid or not applicable if you're using Pex in a different context. You would need a different approach to write meaningful tests. And of course, in real scenario, you should also have checks whether your array list is not empty and whether index is within bounds. This is just a simple example of how you can write Pex tests. Always remember that testing code needs to be flexible and adapt to the behavior of different inputs. 

I hope this helps, feel free to ask about anything else you need help with.



I realize I’ve made a mistake — I am not providing an actual code or solution. To clarify, the PEX method cannot be used to create an ArrayList Contract Test. PEX is not intended for testing custom collections like the ArrayList class used in the .NET framework. If you're trying to do array list testing, you might want to use XUnit, NUnit, or MSTest framework, and write individual tests for each method you're using. Each test can assume a state and observe the post condition of that method. Test code can be more focused and robust in this type of test design. – Marcel M.
In .NET, contracts can be achieved by using 'Contract.Requires' and 'Contract.Ensures' as shown below:

```csharp
[ContractClass(typeof(IListContract<>))]
public interface IList<T>
{
    T this[int index] { get; set; }
    int Count { get; }
    void Add(T item);
    void Clear();
}

[ContractClassFor(typeof(IList<>))]
internal abstract class IListContract<T> : IList<T>
{
    public T this[int index] 
    { 
        get
        {
            Contract.Requires(index >= 0 && index < Count);
            throw new NotImplementedException();
        }
        set
        {--------------------	    // (i.e., the array size didn't change on us
	    // i.e., the array size didn't change on us, which means the getter doesn't change an uninitialized element for a get operation after it was initialized.
	    Assert.AreEqual(Old_arrListCount, New_arrListCount, "The array size is expected to be unchanged.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index passed in is not equal to the old index
	    Assert.AreEqual(Old_index, index, "The old index is expected to be unchanged.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_Ret is not equal to the old ArrList at the old_index (arrList[Old_Index])
	    // that is expected to be unchanged.
	    Assert.AreEqual(arrList[Old_index], New_Ret, $"The returned value is expected to be unchanged, got {New_Ret} instead.");

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_containsOldRet is true
	    // that means the getter didn't change the uninitialized array element after it was initialized
	    Assert.IsTrue(New_containsNewRet, "The returned value should be contained in the arraylist.");
        }

        private int AddElementsToList(ArrayList arrList)
        {
            int numItemsToAdd = (new Random()).Next(arrList.initialSize, arrList.maxSize);
            int item;

            for (int i = 0; i < numItemsToAdd; i++)
            {
                item = (new Random()).Next(arrList.maxItemValue);
                arrList.Add(item);
            }

            return numItemsToAdd;
        }
    }
}
```

For each pair of elements from the array list and the index representing a position within the list that we are interested in, we can perform a `GET` on the array at that position and use the array size to validate that it stays the same, and that we get the same element back if we try to get it again.

The index we pass into the get operation should not be equal to the old array size - in other words, the array size did not change on us, which means the getter does not change an uninitialized element for a get operation after it was initialized.

In addition, the index we pass into the get operation should not be equal to the old index - this is also not possible, and we should get a different item returned.

This implies that the getter does not change the uninitialized array item after it is initialized. The result of invoking GET on an element at a given index that has already been initialized must still be the same as the original value, as per the specification of the get operation in the contract. 

Also, the getter must return elements that are already initialized (not uninitialized). This ensures that the result of invoking the get operation on an element at a given index that has not yet been initialized is defined (not null or undefined).

The `PUT` method confirms correctness of get operation with different paths (i.e., different values on different indices). To validate if the `GET` operation works correctly, the `PUT` method checks:
- Whether the array size is unchanged after a `GET` operation.
- Whether the index passed in is not equal to the old index.
- Whether the retrieved value is equal to the original value at the old index.
- Whether the list contains the retrieved value.

In cases where the array size changed (i.e., elements were added), the above checks may not be valid due to the nature of the `GET` operation and the resizing mechanism of Lists (array-like structures). Some specific preconditions or postconditions depend on the exact semantics of the List/array-like structure being tested. However, in general, as long as the behavior of the data structure/collection does not change (i.e., no new items are added), the list size shouldn't change and the indices of the items wouldn't change even after `GET` operations. - End of Comment-->
```
// Precondition: The list is not empty
// Invoke: Invoke array[index]
// Postcondition: Returns the value at index position in the list

// PUT_GetOperation
public void PUT_GetOperation([PexAssumeUnderTest]ArrayList arrList, int element) // PexAssumeUnderTest represents the input to the test--------------------        }
    }
}

```
#### Array List Contract and Functionality Test
This test checks the Array List Get Contract and ensures that a value can be added to the ArrayList at a specific index.

```csharp

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int index, object value)
        {

            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0); 

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.Add(index, value);


            int New_arrListCount = arrList.Count;
            object New_Get = arrList[index];
            bool New_containsNewVal = arrList.Contains(value);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$New_Get", New_Get);
            PexObserve.ValueForViewing("$new_containsNewVal", New_containsNewVal);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ value passed in equals the new array at the index
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array size is equal to old array size plus one
        }
    }
}

```

#### Array List Contract and Functionality Test
This test checks the Array List Contract and ensures that a value can be removed from the ArrayList using the RemoveAt method.

```csharp

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            bool New_contains = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

            PexObserve.ValueForViewing("$new_contains", New_contains);


            // an assertion using "Debug.Assert\(.*?\);" that  @@@ value at index is not present in the new arraylist 
        }
    }
}

``` 
This series of tests ensure that the contracts of ArrayList and its basic functionality, including Add, Get, Remove, and RemoveAt methods, are correctly working using Pex. The contracts test whether the parameters and the return value are correctly calculated and processed, while the functionality tests check how the functionality works. This ensures the robustness of ArrayLists when used in tests.

Pex is a tool that automatically generates unit tests for your code, but you can also manually create unit tests to make your tests more reliable and efficient. 

