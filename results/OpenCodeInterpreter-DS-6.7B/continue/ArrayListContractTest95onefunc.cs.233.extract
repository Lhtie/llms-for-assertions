    {
        public void DELETE_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            bool Old_arrListContainsX = arrList.Contains(x);

            bool New_ret = arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            bool New_arrListContainsX = arrList.Contains(x);

	    AssumePrecondition.IsTrue(New_Ret == Old_arrListCount - 1);

            // an assertion using "Debug.Assert(*...*);" that  @@@ If the removed element is present in the list it should be False.
--------------------            Debug.Assert(
                    (New_Ret >= -1 && New_Ret <= New_arrListCount - 1) ||
                    New_arrListCount == 0
                );
--------------------		Debug.Assert(New_Ret >= -1);
----------------------------------------            if (New_Ret >= 0) Debug.Assert(New_Ret >= 0, "If the return value is non-negative, index of x in new array is >= 0");
----------------------------------------