	    Debug.Assert(New_arrListIndexOfX <= Old_index, "IndexOf(x) is larger than index.");
----------------------------------------	    Debug.Assert(New_arrListIndexOfX >= Old_index);
--------------------	    Debug.Assert(New_arrListIndexOfX <= Old_index);
--------------------            Debug.Assert(New_arrListIndexOfX <= Old_index);
----------------------------------------------------------------------------------------------------	    // and the array list count increased by one, contains the element x and its index is correct
	    // and the last IndexOf does the same.
	    Debug.Assert(New_arrListIndexOfX <= Old_index);
