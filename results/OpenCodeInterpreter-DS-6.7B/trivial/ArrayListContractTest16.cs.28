using System;
using System.Diagnostics; // Required for using the Debug class

...

[PexMethod]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    // ...

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    // ...

    // Output assert statement
    Debug.Assert(Old_arrListCount - 1 <= New_arrListCount); // @@@ last index of x in old array is smaller than or equal to new array size
}

...
```
The above C# code inserts a debug assert statement "Debug.Assert(Old_arrListCount - 1 <= New_arrListCount);" at the line where the code removes the element "x" from "arrList". This assert statement ensures that the last index of "x" in the old array is less than or equal to the count of elements after removing "x", which is the new array size.

Kindly note that the test results of these assert statements will be displayed in the test runner's interface, not the terminal/command prompt.--------------------```cs
[Test]
public void PUT_RemoveContract()
{
    Assume.True(true);
    var arrList = new ArrayList();
    int x = 0; // replace with actual value
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(Old_x, Old_x);
    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
}
```
