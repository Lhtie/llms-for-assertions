import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfer "amnt" money from "frm" to "to" """
    
    # transfer amount is not greater than 100 and is positive
    assert amnt >= 0 and amnt <= 100, f'Invalid amount: {amnt}.'
    
    for acnt in frm.accounts:
        if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

# setup a demo
