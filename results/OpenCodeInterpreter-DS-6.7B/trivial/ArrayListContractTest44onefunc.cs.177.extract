            Debug.Assert(index == Old_arrListCount);--------------------Debug.Assert(index == Old_arrListCount, "index passed in is not equal to the old array size");--------------------            Debug.Assert(index != Old_arrListCount);--------------------Debug.Assert(index == Old_arrListCount);--------------------Debug.Assert(index == Old_arrListCount);--------------------Debug.Assert(Old_arrListCount != index);--------------------Debug.Assert(Old_arrListCount != index);--------------------            Debug.Assert(index != Old_arrListCount);--------------------Debug.Assert(Old_index != Old_arrListCount);--------------------Debug.Assert(index != Old_arrListCount);--------------------