Debug.Assert(New_arrListIndexOfX >= 0); // Index of x in new array should be >= 0
Debug.Assert(Old_arrListIndexOfX == -1 || Old_arrListIndexOfX <= New_arrListIndexOfX); // Index of x in old array should >= -1 and <= the new index
Debug.Assert(New_arrListLastIndexOfX >= -1); // Last index of x in new array should >= -1
Debug.Assert(Old_arrListContainsX == false || New_arrListContainsX == true); // If old array contained x then new array must contain x
