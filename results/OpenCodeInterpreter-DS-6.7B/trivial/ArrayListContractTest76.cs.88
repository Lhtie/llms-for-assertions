[Test]
public void TestIndexOf()
{
    // Setup
    ArrayList arrList = new ArrayList();
    int x = 5;
    arrList.Add(x);

    // Execute
    int newIndexOfX = arrList.IndexOf(x);

    // Confirm
    Assert.AreEqual(0, newIndexOfX);
}
```

