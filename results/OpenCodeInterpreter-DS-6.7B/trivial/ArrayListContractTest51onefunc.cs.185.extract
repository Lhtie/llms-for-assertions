Debug.Assert(New_arrListCount != Old_arrListCount, "If the return value is true, last position of x in new array is not the size of old array");--------------------Debug.Assert(New_Ret == true && New_arrListLastIndexOfX != Old_arrListCount);--------------------Debug.Assert(New_Ret == true && New_arrListCount > Old_arrListCount && New_arrListIndexOfX == Old_arrListIndexOfX && New_arrListLastIndexOfX == Old_arrListLastIndexOfX);--------------------Debug.Assert(New_arrListCount != Old_arrListCount || New_arrListIndexOfX != Old_arrListIndexOfX || New_arrListLastIndexOfX != Old_arrListLastIndexOfX || New_Ret == true);--------------------Debug.Assert(New_Ret == true && New_arrListLastIndexOfX != Old_arrListCount, "If the return value is true, last position of x in new array is not the size of old array");--------------------Debug.Assert(New_Ret == true && New_arrListLastIndexOfX == Old_arrListCount);--------------------Debug.Assert(New_Ret == true);--------------------Debug.Assert(New_Ret == (Old_arrListIndexOfX == Old_arrListLastIndexOfX && New_arrListLastIndexOfX == Old_arrListCount));--------------------Debug.Assert(New_Ret || New_arrListLastIndexOfX == Old_arrListCount);--------------------Debug.Assert(New_Ret == true && New_arrListLastIndexOfX == (Old_arrListCount - 1));--------------------