--------------------    assert diff_sum <= 1, f"Sum of all pairs of differences is {diff_sum}, which is more than 1"----------------------------------------    assert sum([abs(p43_coeffs[i] - p43_coeffs[j]) for i in range(len(p43_coeffs)) --------------------    assert sum([p43_coeffs[j] - p43_coeffs[j+1] for j in range(len(p43_coeffs)-1)]) <= 1--------------------    assert total <= 1, "Sum of all pairs of differences between terms in the array is atmost 1"--------------------    assert all(abs(p43_coeffs[i] - p43_coeffs[j]) <= 1 for i in range(len(p43_coeffs)) for j in range(i+1, len(p43_coeffs)))--------------------------------------------------------------------------------