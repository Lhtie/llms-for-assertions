            Debug.Assert(arrList.Count >= 0);--------------------            Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_arrListCount >= 0, "Old_arrListCount should be non-negative");--------------------Debug.Assert(New_arrListLastIndexOfX != Old_arrListCount);--------------------Debug.Assert(New_Ret == (Old_arrListCount + 1));--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "Old count and new count should be equal");--------------------------------------------------------------------------------Debug.Assert(Old_arrListCount >= 0);--------------------