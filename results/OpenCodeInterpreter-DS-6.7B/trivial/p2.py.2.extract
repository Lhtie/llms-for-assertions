    assert sum([x**2 for x in p43_coeffs]) == 1----------------------------------------assert sum([i**2 for i in p43_coeffs]) == 1--------------------    assert sum([x**2 for x in p43_coeffs]) == 1, "Sum of squares of values in array is not 1."--------------------    assert sum([i**2 for i in p43_coeffs]) == 1--------------------    assert len(p43_coeffs) == n, f"Expected {n} values, got {len(p43_coeffs)}"--------------------    assert sum([i**2 for i in p43_coeffs]) == 1--------------------assert sum([i**2 for i in p43_coeffs]) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum([i**2 for i in p43_coeffs]) == 1--------------------    assert sum([i**2 for i in p43_coeffs]) == 1--------------------