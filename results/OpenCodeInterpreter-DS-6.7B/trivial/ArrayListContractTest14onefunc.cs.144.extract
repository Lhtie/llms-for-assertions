Debug.Assert(Old_arrListCount != New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListCount == New_arrListCount); // This asserts that the count of the array list is the same before and after the Remove operation.--------------------Debug.Assert(arrList.Count != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != New_arrListLastIndexOfX); // @@@ array list count is not same as last index of x in new array--------------------Debug.Assert(New_arrListCount == arrList.LastIndexOf(x));--------------------Debug.Assert(New_arrListCount == arrList.LastIndexOf(x));--------------------Debug.Assert(New_arrListCount == Old_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListCount != New_arrListCount);--------------------Debug.Assert(New_arrListCount == Old_arrListLastIndexOfX); // "$old_arrList_LastIndexOf_x"----------------------------------------