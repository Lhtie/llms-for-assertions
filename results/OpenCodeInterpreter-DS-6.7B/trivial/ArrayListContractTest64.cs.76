```--------------------```cs
Debug.Assert(Old_arrListCount >= 0);
Debug.Assert(New_arrListCount == Old_arrListCount + 1);
Debug.Assert(Old_x == New_Ret);
Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);
Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);
Debug.Assert(New_arrListContainsX);

// @@@ If the old list contained the given item x, then the new list should also contain the item x.
Debug.Assert(Old_arrListContainsX || !New_arrListContainsX);

// @@@ If the new list doesn't contain the item x, then the old list should also not contain the item x.
Debug.Assert(Old_arrListContainsX && New_arrListContainsX || !(Old_arrListContainsX && !New_arrListContainsX));

// @@@ Assert the new list contains the old item x and new item x.
Debug.Assert(New_arrListContainsX && !arrList.Contains(x));

// @@@ If the old list contained the item x in the given index, then the item x should not be in the new list's index of item x and last index of item x.
if (Old_arrListIndexOfX == index)
{
    Debug.Assert(New_arrListIndexOfX == -1 && New_arrListLastIndexOfX == -1);
}

// @@@ Assert that the new list contains the given item x in the given index.
if (Old_arrListIndexOfX != index)
{
    Debug.Assert(New_arrListIndexOfX < Old_arrListCount && New_arrListIndexOfX >= 0);
}
else
{
    Debug.Assert(New_arrListIndexOfX == index);
}

// @@@ Assert that the index of the given item x in the new list is at least its old index in the old list.
if (Old_arrListIndexOfX != -1)
{
    Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
}

// @@@ If the old list does not contain the item x or old list does not contain the index of item x, the new list's last index of the item x should be -1.
if (!Old_arrListContainsX || Old_arrListIndexOfX == -1)
{
    Debug.Assert(New_arrListLastIndexOfX == -1);
}

// @@@ If the item x was not in the old list, it should not be in the new list.
if (!Old_arrListContainsX)
{
    Debug.Assert(!New_arrListContainsX);
}

// @@@ If the old list does not contain the item x and the new list contains the item x, the index of new list for this item in old list should be -1.
if (!Old_arrListContainsX && New_arrListContainsX)
{
    Debug.Assert(New_arrListIndexOfX == -1);
}

// @@@ If the old list does not contain the item x and the new list contains the item x, old list's last index of this item should be -1.
if (!Old_arrListContainsX && New_arrListContainsX)
{
    Debug.Assert(Old_arrListLastIndexOfX == -1);
}

// @@@ Assert the count of the list remains the same.
Debug.Assert(Old_arrListCount);

// @@@ If the new list's count is greater than or equals to the old list's count - 1 and the old list contains the item x, then the new count should be equal to the old count - 1.
if (arrList.Count > Old_arrListCount - 1 && Old_arrListContainsX)
{
    Debug.Assert(New_arrListCount == Old_arrListCount - 1);
}

// @@@ If the new list's count is greater than or equals to the old list's count + 1 and the old list doesn't contain the item x, then the new count should be equal to the old count + 1.
if (arrList.Count >= Old_arrListCount + 1 && !Old_arrListContainsX)
{
    Debug.Assert(New_arrListCount == Old_arrListCount + 1);
}

