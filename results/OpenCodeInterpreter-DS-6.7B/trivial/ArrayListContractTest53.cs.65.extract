Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert((Old_arrListLastIndexOfX <= New_arrListLastIndexOfX) || !(New_Ret));--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX, "If the return value is true, new list's last index of x is <= old list's last index of x");--------------------            Debug.Assert(Old_arrListCount >= New_arrListCount);----------------------------------------Debug.Assert(New_arrListCount - Old_arrListCount == 1); // This asserts that adding an element to the list increases the list's count by 1.--------------------------------------------------------------------------------