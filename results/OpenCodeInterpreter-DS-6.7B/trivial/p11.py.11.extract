    assert total_balance >= amnt, 'Total balance of accounts is less than the transfer amount'--------------------------------------------------------------------------------assert sum(acnt.money for acnt in alice.accounts) >= 0, 'Transaction failed'----------------------------------------    assert total_balance >= amnt, "Insufficient balance in the account"--------------------    assert total_balance >= amnt, f"Total balance of 'from' accounts is less than {amnt}"--------------------    assert total_money_from >= amnt, "Not enough money in the accounts to make the transfer"--------------------    assert total_balance >= amnt, "Total balance of all 'frm' accounts is not less than 'amnt'"--------------------