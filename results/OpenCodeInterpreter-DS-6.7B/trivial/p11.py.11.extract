    assert total_balance_frm >= amnt, "Total balance of the sender's accounts is less than the amount to be transferred."--------------------    assert total_balance >= amnt, "Total balance of all 'frm' accounts is less than 'amnt'"--------------------assert (sum([acnt.money for account in frm.accounts]) >= amnt)--------------------    assert frm.total_balance >= amnt, f"Insufficient balance in {frm.name}'s account"--------------------assert sum(acnt.money for acnt in frm.accounts) >= amnt, 'total balance of all "frm" accounts is less than "amnt"'--------------------    assert total_balance >= amnt, f"Total balance is {total_balance}, but the transfer amount is {amnt}"--------------------    assert total_balance >= amnt, 'Total balance is less than the transfer amount.'--------------------assert total_balance(frm) >= amnt, f"total_balance of all 'frm' accounts is not less than 'amnt'"--------------------    assert total_balance_frm >= amnt, "Total balance of 'from' accounts is less than the transfer amount"--------------------assert sum([acnt.money for acnt in frm.accounts]) >= amnt, 'total balance of all "frm" accounts is not less than "amnt"'--------------------