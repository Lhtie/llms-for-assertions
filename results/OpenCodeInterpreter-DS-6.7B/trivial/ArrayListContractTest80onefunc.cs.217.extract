            Debug.Assert(New_Ret < 0, $"If the return value is negative, old list size is not -1. Actual size is {Old_arrListCount}");--------------------Debug.Assert(New_Ret == -1 || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount != -1, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(Old_arrListCount != -1);--------------------	    Debug.Assert(New_Ret < 0 ? Old_arrListCount != -1 : true);--------------------Debug.Assert(New_Ret == -1 || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret < 0, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(Old_arrListCount != -1);--------------------Debug.Assert(New_Ret < 0 || Old_arrListCount != -1);--------------------