            Debug.Assert(Old_arrListCount < New_arrListCount); // After adding an element, the count should increase----------------------------------------Debug.Assert(Old_arrListCount < New_arrListCount); // "$old_arrList_Count should be less than $new_arrList_Count after adding x"--------------------Debug.Assert(Old_arrListCount >= 0);----------------------------------------Debug.Assert(Old_arrListCount >= 0);----------------------------------------    Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(arrList.Count >= 0);----------------------------------------