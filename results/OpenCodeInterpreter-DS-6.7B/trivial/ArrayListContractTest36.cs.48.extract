--------------------            Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(arrList.Count == Old_arrListCount + 1); // This is the count before adding x--------------------Debug.Assert(LastIndexOf_x == arrList.LastIndexOf(x)); //@@@ Last index of x in new array is the same as old array  --------------------Debug.Assert(New_arrListCount > Old_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX != Old_arrListCount);--------------------Debug.Assert(Old_arrListCount == New_arrListCount); // This asserts that the count of the ArrayList remains the same before and after the operation--------------------                Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "Last index of x in new array is not same as old array size");----------------------------------------