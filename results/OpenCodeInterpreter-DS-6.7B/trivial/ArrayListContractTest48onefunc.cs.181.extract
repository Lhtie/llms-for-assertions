            Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX); // If the return value is true, index of x in old array is less than or equal to that in new array--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount);--------------------Debug.Assert(New_Ret == (Old_arrListIndexOfX <= Old_arrListLastIndexOfX));--------------------            Debug.Assert(New_Ret == true, "If the return value is true, index of x in old array is less than or equal to that in new array");--------------------        Debug.Assert(condition1);--------------------