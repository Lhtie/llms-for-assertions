    Debug.Assert(arrList.Count >= 0);--------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(Old_arrListCount >= 0);--------------------Debug.Assert(Old_arrListCount >= 0);------------------------------------------------------------Debug.Assert(Old_arrListCount == New_arrListCount, "Old arrList count does not equal New arrList count");----------------------------------------Debug.Assert(New_Ret >= 0, "The return value of the Add method should be non-negative.");--------------------Debug.Assert(Old_arrListCount >= 0);--------------------