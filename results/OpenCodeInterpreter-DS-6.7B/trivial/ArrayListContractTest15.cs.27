```--------------------```cs
using System;
using NUnit.Framework;
using System.Diagnostics;

[TestFixture]
public partial class ArrayListContractTest
{
    [Test]
    public void PUT_AddContract()
    {
        ArrayList arrList = new ArrayList();
        int x = 1;

        // Assume precondition
        Assume.That(true);

        // Observe old values
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        // Perform the operation
        arrList.Add(x);

        // Observe new values
        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        // Assert statements
        Debug.Assert(Old_arrListCount < New_arrListCount);
        Debug.Assert(New_arrListContainsX);
        Debug.Assert(New_arrListIndexOfX == New_arrListCount - 1);
        Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1);
        Debug.Assert(New_arrListCount == arrList.Count);
    }

    [Test]
    public void PUT_RemoveContract()
    {
        ArrayList arrList = new ArrayList();
        int x = 1;

        // Assume precondition
        Assume.That(true);

        // Observe old values
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        // Perform the operation
        arrList.Remove(x);

        // Observe new values
        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        // Assert statements
        Debug.Assert(Old_arrListCount > New_arrListCount);
        Debug.Assert(!New_arrListContainsX);
        Debug.Assert(New_arrListIndexOfX == -1);
        Debug.Assert(New_arrListLastIndexOfX == -1);
        Debug.Assert(New_arrListCount == arrList.Count);
    }
}
```
