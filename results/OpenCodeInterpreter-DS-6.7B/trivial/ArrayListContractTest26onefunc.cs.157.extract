            Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_arrListIndexOfX > Old_arrListLastIndexOfX, "The last position of x after insertion is less than or equal to original array count");--------------------Debug.Assert(New_arrListIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_arrListIndexOfX >= 0);--------------------Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX, "@@@ last position of x after insertion is less than or equal to original array count");--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(Old_arrListCount + 1 <= New_arrListCount);--------------------