using Microsoft.VisualStudio.TestTools.UnitTesting;

[TestClass]
public class ArrayListContractTest
{
    [TestMethod]
    public void PUT_AddContract()
    {
        // Obtain the initial state
        ArrayList arrList = new ArrayList();
        int x = arrList.Add(1);
        int oldCount = arrList.Count;
        int oldIndexOfX = arrList.IndexOf(1);
        int oldLastIndexOfX = arrList.LastIndexOf(1);
        bool oldContainsX = arrList.Contains(1);

        // Add a new item
        int newCount = arrList.Add(1);
        int newIndexOfX = arrList.IndexOf(1);
        int newLastIndexOfX = arrList.LastIndexOf(1);
        bool newContainsX = arrList.Contains(1);

        // Assert statements
        Assert.AreEqual(oldCount + 1, newCount);
        Assert.AreEqual(1, newIndexOfX);
        Assert.AreEqual(1, newLastIndexOfX);
        Assert.IsTrue(newContainsX);
    }

    // Other test methods...
}
```
