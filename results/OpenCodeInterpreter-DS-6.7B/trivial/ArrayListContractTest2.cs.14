```cs
[Test]
public void PUT_AddContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;

    // Act
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.Add(x);

    // Assert
    Assert.AreEqual(Old_arrListCount + 1, arrList.Count);
    Assert.AreEqual(x, arrList[arrList.Count - 1]);  // Check the item was added at the end
    Assert.AreEqual(Old_arrListIndexOfX, arrList.IndexOf(x));
    Assert.AreEqual(Old_arrListLastIndexOfX, arrList.LastIndexOf(x));
    Assert.AreEqual(true, arrList.Contains(x));
}

[Test]
public void PUT_RemoveContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 1;

    // Act
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    // Assert
    Assert.AreEqual(Old_arrListCount - 1, arrList.Count);
    Assert.AreEqual(-1, arrList.IndexOf(x));  // Check item got removed
    Assert.AreEqual(-1, arrList.LastIndexOf(x));
    Assert.AreEqual(false, arrList.Contains(x));
}

// Other test methods ...

