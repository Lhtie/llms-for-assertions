using System.Diagnostics;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(Old_arrListCount <= New_arrListCount); // The count of arrList should be greater after adding a new element
            Debug.Assert(Old_arrListIndexOfX >= 0 && Old_arrListIndexOfX < New_arrListCount); // The Index of the new element should be valid
            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListCount); // The Last Index of the new element should be the current count
            Debug.Assert(New_arrListContainsX); // The element should be contained in the array after adding
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_arrListCount <= Old_arrListCount); // The count of arrList should be less after removing an existing element
            Debug.Assert(New_arrListIndexOfX < 0); // The removed element should not be found within the array
            Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX); // The Last Index of the removed element should not be less than its new index
            Debug.Assert(!New_arrListContainsX); // The removed element should not be contained in the array anymore
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(Old_arrListCount <= New_arrListCount); // The count of arrList should be greater after inserting a new element
            Debug.Assert(New_arrListIndexOfX == 0 || index < New_arrListIndexOfX); // The Index of the inserted element should be valid
            Debug.Assert(New_arrListLastIndexOfX == index); // The Last Index of the inserted element should match its desired index
            Debug.Assert(New_arrListContainsX); // The element should be contained in the array after inserting
        }

