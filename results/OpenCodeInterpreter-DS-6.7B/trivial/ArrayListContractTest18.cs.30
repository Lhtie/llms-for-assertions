        [Test]
        public void Test_PUT_AddContract()
        {
            var arrList = new ArrayList();
            int x = 5;
            int oldCount = arrList.Count;
            int oldIndexOfX = arrList.IndexOf(x);
            int oldLastIndexOfX = arrList.LastIndexOf(x);
            bool oldContainsX = arrList.Contains(x);

            int newRet = arrList.Add(x);

            int newCount = arrList.Count;
            int newIndexOfX = arrList.IndexOf(x);
            int newLastIndexOfX = arrList.LastIndexOf(x);
            bool newContainsX = arrList.Contains(x);

            Assert.AreEqual(oldCount + 1, newCount);
            Assert.AreEqual(x, arrList[oldCount]);
            Assert.AreEqual(oldIndexOfX, oldLastIndexOfX);
            Assert.AreEqual(newIndexOfX, newLastIndexOfX);
            Assert.AreEqual(oldContainsX, newContainsX);
        }

        [Test]
        public void Test_PUT_RemoveContract()
        {
            var arrList = new ArrayList();
            int x = 5;
            arrList.Add(x);
            int oldCount = arrList.Count;
            int oldIndexOfX = arrList.IndexOf(x);
            int oldLastIndexOfX = arrList.LastIndexOf(x);
            bool oldContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int newCount = arrList.Count;
            int newIndexOfX = arrList.IndexOf(x);
            int newLastIndexOfX = arrList.LastIndexOf(x);
            bool newContainsX = arrList.Contains(x);

            Assert.AreEqual(oldCount - 1, newCount);
            Assert.AreEqual(-1, oldIndexOfX);
            Assert.AreEqual(-1, newIndexOfX);
            Assert.AreEqual(-1, oldLastIndexOfX);
            Assert.AreEqual(-1, newLastIndexOfX);
            Assert.AreEqual(!oldContainsX, newContainsX);
        }

        [Test]
        public void Test_PUT_InsertContract()
        {
            var arrList = new ArrayList();
            int x = 5;
            int index = 0;
            int oldCount = arrList.Count;
            int oldIndexOfX = arrList.IndexOf(x);
            int oldLastIndexOfX = arrList.LastIndexOf(x);
            bool oldContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int newCount = arrList.Count;
            int newIndexOfX = arrList.IndexOf(x);
            int newLastIndexOfX = arrList.LastIndexOf(x);
            bool newContainsX = arrList.Contains(x);

            Assert.AreEqual(oldCount + 1, newCount);
            Assert.AreEqual(x, arrList[index]);
            Assert.AreEqual(oldIndexOfX, oldLastIndexOfX);
            Assert.AreEqual(newIndexOfX, newLastIndexOfX);
            Assert.AreEqual(oldContainsX, newContainsX);
        }

