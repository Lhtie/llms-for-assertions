[Test]
public void PUT_IndexOfContract()
{
    Assume.True(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.IndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(Old_x, x);
    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
    Assert.AreEqual(New_Ret, arrList.IndexOf(x));
}

[Test]
public void PUT_LastIndexOfContract()
{
    Assume.True(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(Old_x, x);
    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
    Assert.AreEqual(New_Ret, arrList.LastIndexOf(x));
}

[Test]
public void PUT_CountContract()
{
    Assume.True(true);

    int New_Ret = arrList.Count;

    Assert.AreEqual(New_Ret, arrList.Count);
}
