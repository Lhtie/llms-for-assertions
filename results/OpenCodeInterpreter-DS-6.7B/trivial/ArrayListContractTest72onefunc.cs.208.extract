        Debug.Assert(New_Ret <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret >= 0, "The return value is negative");--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, new ret <= last index of x in new list");--------------------            Debug.Assert(New_Ret >= 0 ? New_Ret <= New_arrListLastIndexOfX : true);----------------------------------------Debug.Assert(New_Ret >= 0 && New_Ret <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(New_Ret <= arrList.LastIndexOf(x), "If the return value is non-negative, new ret should be <= last index of x in new list");--------------------Debug.Assert(New_Ret <= Old_arrListLastIndexOfX);--------------------