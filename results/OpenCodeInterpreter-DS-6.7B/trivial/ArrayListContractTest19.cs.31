using System;
using System.Diagnostics;
using NUnit.Framework;

namespace ArrayList.Test
{
    public class ArrayListContractTest
    {
        [Test]
        public void PUT_RemoveContract()
        {
            // Arrange
            ArrayList arrList = new ArrayList();
            int x = 1;
            arrList.Add(x);

            // Act
            arrList.Remove(x);

            // Assert
            Assert.IsTrue(arrList.Count >= 0, "@@@ new last index of x is lesser than or equal to old last index of x");
        }
    }
}

```

