            Debug.Assert(Old_arrListCount == New_arrListCount); // Assuming the count remains the same--------------------Debug.Assert(New_Ret == false || Old_arrListIndexOfX >= New_arrListIndexOfX);----------------------------------------Debug.Assert(Old_arrListIndexOfX >= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX >= 0);--------------------Debug.Assert(Old_arrListIndexOfX >= New_arrListIndexOfX);--------------------            Debug.Assert(Old_arrListIndexOfX >= Old_arrListLastIndexOfX);----------------------------------------Debug.Assert(Old_arrListIndexOfX >= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListIndexOfX == -1 || Old_arrListIndexOfX >= New_arrListIndexOfX);--------------------