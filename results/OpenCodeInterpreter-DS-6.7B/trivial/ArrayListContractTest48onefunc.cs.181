// @@@ If the return value is false, the new array does not contain the old value, so its index of the old value should be -1
Debug.Assert(New_arrListIndexOfX != -1);

// @@@ The count of the array does not decrease when a new value is added
Debug.Assert(New_arrListCount > Old_arrListCount);

// @@@ If the lastIndexOf x in the new array is greater than or equal to that in the old array, 
// it means that the old index of x is not the last index in the array after adding a new element
Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);

// @@@ If the return value is true, the new array's count should be one more than the old array's count
Debug.Assert(New_arrListCount == Old_arrListCount + 1);

// @@@ The index of the new value in the new array should be the old count because we add a new value at the end of the array
Debug.Assert(New_arrListIndexOfX == Old_arrListCount);

// @@@ The lastIndexOf value in the new array should be the same as the new count 
// because we add the new value at the end of the array
Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1);

// @@@ The return value of Contains method should be true when adding a new value which is not in the original array
Debug.Assert(New_Ret == true);
