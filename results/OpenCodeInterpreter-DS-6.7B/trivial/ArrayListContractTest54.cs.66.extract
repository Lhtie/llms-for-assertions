            Debug.Assert(arrList != null);----------------------------------------Debug.Assert(Old_arrListCount >= 0);----------------------------------------Debug.Assert(New_arrListCount >= Old_arrListCount); // Asserts that the count of the new ArrayList is greater or equal to the old ArrayList count--------------------Debug.Assert(New_Ret == Old_arrListCount + 1); // After adding new element, the count should increase by 1--------------------Debug.Assert((arrList.Count - Old_arrListCount) == 1); // Check if the count increase after adding an element to the arraylist--------------------Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);----------------------------------------    Debug.Assert(New_Ret >= Old_arrListCount);--------------------