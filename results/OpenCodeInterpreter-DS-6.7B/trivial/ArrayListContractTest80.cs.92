```--------------------```cs
[Test, PexMethod]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(Old_arrListCount != -1 || New_arrListCount == -1, "If the return value is -1, old list size is not -1");
}
```--------------------```cs
// If the return value is -1, old count is not -1 
Debug.Assert(New_Ret != -1 || Old_arrListCount != -1);

// After AddContract, new count is one greater than old count
Debug.Assert(New_arrListCount == (Old_arrListCount + 1));

// After RemoveContract, old count is one less than new count
Debug.Assert(New_arrListCount == (Old_arrListCount - 1));

// After InsertContract, new count is still old count
Debug.Assert(New_arrListCount == Old_arrListCount);

// After SetContract, new count is still old count
Debug.Assert(New_arrListCount == Old_arrListCount);

// After GetContract, old count is still old count
Debug.Assert(Old_arrListCount == Old_arrListCount);

// If the element is in the list, new index is not -1
Debug.Assert(New_arrListIndexOfX != -1);

// If the element is in the list, new last index is not -1
Debug.Assert(New_arrListLastIndexOfX != -1);

// If the element is in the list, new contains is true
Debug.Assert(New_arrListContainsX);

// After ContainsContract, old count is still old count
Debug.Assert(Old_arrListCount == Old_arrListCount);

// If the element is in the list, new index is not -1
Debug.Assert(New_arrListIndexOfX != -1);

// If the element is in the list, new last index is not -1
Debug.Assert(New_arrListLastIndexOfX != -1);

// If the element is in the list, new contains is true
Debug.Assert(New_arrListContainsX);

// After CountContract, new count is still old count
Debug.Assert(New_Ret == Old_arrListCount);
