using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Text;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 0;

            // When
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            // Then
            Debug.Assert(Old_arrListCount == arrList.Count);
            Debug.Assert(arrList[arrList.Count - 1] == x);
            Debug.Assert(arrList.IndexOf(x) == arrList.Count - 1);
            Debug.Assert(arrList.LastIndexOf(x) == arrList.Count - 1);
            Debug.Assert(arrList.Contains(x) == true);
            Debug.Assert(arrList.Count == Old_arrListCount + 1);
        }

        [Test]
        public void PUT_RemoveContract()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 0;
            arrList.Add(x);

            // When
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            // Then
            Debug.Assert(Old_arrListCount == arrList.Count + 1);
            Debug.Assert(arrList.IndexOf(x) == -1);
            Debug.Assert(arrList.LastIndexOf(x) == -1);
            Debug.Assert(arrList.Contains(x) == false);
        }

        [Test]
        public void PUT_InsertContract()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 0;
            int index = 0;

            // When
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            // Then
            Debug.Assert(Old_arrListCount == arrList.Count);
            Debug.Assert(arrList.IndexOf(x) == index);
        }

        [Test]
        public void PUT_SetContract()
        {
            // Given
            ArrayList arrList = new ArrayList();
            int x = 0;
            int index = 0;
            arrList.Add(0);

            // When
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList[index] = x;

            // Then
            Debug.Assert(arrList[index] == x);
        }

