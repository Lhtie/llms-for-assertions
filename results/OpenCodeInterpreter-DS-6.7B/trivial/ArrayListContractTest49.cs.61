            arrList.Add(x);

            Debug.Assert(arrList.Count == 1);
            Debug.Assert(arrList.IndexOf(x) == 0);
            Debug.Assert(arrList.LastIndexOf(x) == 0);
            Debug.Assert(arrList.Contains(x));

            arrList[index] = x;

            Debug.Assert(arrList.Count == 1);
            Debug.Assert(arrList.IndexOf(x) == 0);
            Debug.Assert(arrList.LastIndexOf(x) == 0);
            Debug.Assert(arrList.Contains(x));
        }

