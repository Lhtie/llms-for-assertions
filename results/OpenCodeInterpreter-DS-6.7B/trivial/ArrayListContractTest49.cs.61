// @@@ When adding a new item, the count should increase by 1 and the new item should be at the last index
Debug.Assert(New_arrListCount == Old_arrListCount + 1);
Debug.Assert(arrList[New_arrListCount - 1] == x);

// @@@ When removing an item, the count should decrease by 1 and removed item should no longer be in the array
Debug.Assert(New_arrListCount == Old_arrListCount - 1);
Debug.Assert(arrList.IndexOf(x) == -1);

// @@@ If the index is valid, inserting should have no effect on the count
Debug.Assert(index >= 0 && index <= arrList.Count);
Debug.Assert(New_arrListCount == Old_arrListCount);

// @@@ After setting a new item at a specific index, the count should remain the same
Debug.Assert(New_arrListCount == Old_arrListCount);

// @@@ After getting an item at a specific index, the count should remain the same
Debug.Assert(Old_arrListCount == arrList.Count);

// @@@ If the return value is true, index of x in old array is greater than or equal to that in new array
Debug.Assert(New_Ret == false || Old_arrListIndexOfX <= arrList.IndexOf(x));

// @@@ The IndexOf return value should be -1 when the item is not found
Debug.Assert(arrList.Contains(x) == false || arrList.IndexOf(x) >= 0);

// @@@ The LastIndexOf return value should always be equal to or greater than IndexOf
Debug.Assert(arrList.LastIndexOf(x) >= arrList.IndexOf(x));
