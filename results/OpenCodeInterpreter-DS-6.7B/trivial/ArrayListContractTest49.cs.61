using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        
        [Test]
        public void PUT_AddContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 1;

            Debug.Assert(arrList.Count == 0);
            Debug.Assert(arrList.IndexOf(x) == -1);
            Debug.Assert(arrList.LastIndexOf(x) == -1);
            Debug.Assert(!arrList.Contains(x));

            int New_Ret = arrList.Add(x);

            Debug.Assert(arrList.Count == 1);
            Debug.Assert(arrList.IndexOf(x) == 0);
            Debug.Assert(arrList.LastIndexOf(x) == 0);
            Debug.Assert(arrList.Contains(x));
        }

        [Test]
        public void PUT_RemoveContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 1;
            arrList.Add(x);

            Debug.Assert(arrList.Count == 1);
            Debug.Assert(arrList.IndexOf(x) == 0);
            Debug.Assert(arrList.LastIndexOf(x) == 0);
            Debug.Assert(arrList.Contains(x));

            arrList.Remove(x);

            Debug.Assert(arrList.Count == 0);
            Debug.Assert(arrList.IndexOf(x) == -1);
            Debug.Assert(arrList.LastIndexOf(x) == -1);
            Debug.Assert(!arrList.Contains(x));
        }

        [Test]
        public void PUT_InsertContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 1;
            int index = 0;

            Debug.Assert(arrList.Count == 0);
            Debug.Assert(arrList.IndexOf(x) == -1);
            Debug.Assert(arrList.LastIndexOf(x) == -1);
            Debug.Assert(!arrList.Contains(x));

            arrList.Insert(index, x);

            Debug.Assert(arrList.Count == 1);
            Debug.Assert(arrList.IndexOf(x) == 0);
            Debug.Assert(arrList.LastIndexOf(x) == 0);
            Debug.Assert(arrList.Contains(x));
        }

