        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.IsTrue(New_Ret >= 0 && New_arrListCount >= Old_arrListCount);
            Assert.IsTrue(New_Ret >= 0 && New_arrListLastIndexOfX <= Old_arrListCount);
        }
```
Note that the first Assert statement checks if `IndexOf(x)` returns a non-negative value and if the array list's count is greater than or equal to the old count. The second Assert statement checks if the new array list's last index of `x` is less than or equal to the old array list's count.

The next pair of related assert statements checks that `arrList.Contains(x)` returns true when `arrList` contains `x`, and false when `arrList` does not contain `x`.

Similarly, the final pair of assert statements checks that `arrList.LastIndexOf(x)` returns a non-negative value when `arrList` contains `x` and -1 when `arrList` does not contain `x`.

