[Test]
public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

    int Old_arrListCount = arrList.Count;
    int Old_index = index;

    int New_Ret = (int)(arrList[index]);

    int New_arrListCount = arrList.Count;
    bool New_containsNewRet = arrList.Contains(New_Ret);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(Old_index, New_Ret);
    Assert.AreEqual(Old_index, arrList[index]);
    Assert.IsTrue(New_containsNewRet);
}

[Test]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.IndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(New_Ret >=0, New_arrListContainsX );
}

[Test]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.AreEqual(New_Ret, New_arrListLastIndexOfX);
    Assert.AreEqual(New_Ret >=0, New_arrListContainsX );
}
```

These assert statements are placed in the PUT_GetContract, PUT_IndexOfContract, and PUT_LastIndexOfContract methods. They compare the expected values with the actual values and asserts that they are equal. In the PUT_GetContract method, the value at a specific index of the array is compared with the original index in the assumption. Similarly, in the PUT_IndexOfContract and PUT_LastIndexOfContract methods, the index of x and its presence in the array is compared with the original values. For the PUT_IndexOfContract and PUT_LastIndexOfContract methods, it is assumed that the IndexOf method will return a value that is greater than or equal to 0.--------------------Based on the provided C# code, you can see the assert statements corresponding to the comments that start with "@@@". Here are the corresponding assert statements:

- In the `PUT_GetContract` method, an assert statement is used to check if the index value is greater than or equal to 0. The assert statement is `Assert.IsTrue(index >= 0)`.
- In the `PUT_IndexOfContract` method, an assert statement is used to check if the `New_Ret` value is not equal to -1, indicating that the element `x` is present in the `arrList`. The assert statement is `Assert.IsNotEqual(-1, New_Ret)`.


