Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x)); // array list count is not same as last index of x in old array--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount == New_arrListCount);  // The array list count should be the same before and after the operation--------------------Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_arrListCount == arrList.LastIndexOf(x));--------------------Debug.Assert(New_arrListCount != Old_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListCount == arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount != arrList.LastIndexOf(x));--------------------Debug.Assert(Old_arrListCount == arrList.LastIndexOf(x));--------------------