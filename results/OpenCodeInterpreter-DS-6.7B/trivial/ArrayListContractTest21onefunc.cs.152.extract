            Debug.Assert(New_arrListIndexOfX >= -1);--------------------Debug.Assert(New_arrListIndexOfX >= -1);--------------------Debug.Assert(New_arrListIndexOfX >= -1);--------------------Debug.Assert(New_arrListIndexOfX >= -1);--------------------            Debug.Assert(New_arrListIndexOfX >= -1);----------------------------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------            Debug.Assert(New_arrListIndexOfX >= -1); // index of x in new array is geq minus 1--------------------Debug.Assert(New_arrListIndexOfX >= -1);--------------------Debug.Assert(New_arrListIndexOfX >= -1);--------------------