assert amount_to_transfer > 0, 'Amount to transfer is not greater than 0'--------------------    assert amnt <= 100 and amnt > 0, "transfer amount is not greater than 100 and is positive"--------------------    assert amnt <= 100, "Transfer amount must be less than or equal to 100"--------------------assert len(frm.accounts) > 0, 'From account cannot be empty'----------------------------------------assert (amnt > 0 and amnt <= 100), "Transfer amount should be between 0 and 100"--------------------    assert acnt.money >= amnt, "transfer amount is not greater than 100 or is not positive"--------------------assert 100 > amnt > 0, "Transfer amount must be greater than 0 and less than 100"--------------------assert any(acnt.money >= 100 for acnt in frm.accounts), "Transfer amount is not greater than 100"----------------------------------------