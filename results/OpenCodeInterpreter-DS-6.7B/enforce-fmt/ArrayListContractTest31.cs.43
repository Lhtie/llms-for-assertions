assert PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{

  // Assertions related to the addition of a new element in the ArrayList

  // Assert that the count of the ArrayList before adding an element is one less than the count after adding the element
  Assert.AreEqual(arrList.Count - 1, arrList.IndexOf(x));

  // Assert that the index of the new element in the ArrayList is the current count of the ArrayList
  Assert.AreEqual(arrList.Count, arrList.IndexOf(x));

  // Assert that the last index of the new element in the ArrayList is the current count of the ArrayList minus one
  Assert.AreEqual(arrList.Count - 1, arrList.LastIndexOf(x));

  // Assert that the ArrayList contains the new element after adding it
  Assert.IsTrue(arrList.Contains(x));

}

assert PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{

  // Assertions related to the removal of an element from the ArrayList

  // Assert that the count of the ArrayList before removing an element is one more than the count after removing the element
  Assert.AreEqual(arrList.Count + 1, arrList.IndexOf(x));

  // Assert that the index of the element in the ArrayList is -1 after being removed
  Assert.AreEqual(-1, arrList.IndexOf(x));

  // Assert that the last index of the element in the ArrayList is -1 after being removed
  Assert.AreEqual(-1, arrList.LastIndexOf(x));

  // Assert that the ArrayList doesn't contain the removed element after removal
  Assert.IsFalse(arrList.Contains(x));

}

assert PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{

  // Assertions related to the insertion of a new element at a specific position in the ArrayList

  // Assert that the position of the new element in the ArrayList is the specified index
  Assert.AreEqual(index, arrList.IndexOf(x));

  // Assert that the last index of the new element in the ArrayList is the specified index minus one
  Assert.AreEqual(index - 1, arrList.LastIndexOf(x));

  // Assert that the ArrayList contains the new element after insertion
  Assert.IsTrue(arrList.Contains(x));

}

assert PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{

  // Assertions related to the modification of a specific element in the ArrayList

  // Assert that the position of the modified element in the ArrayList is the specified index
  Assert.AreEqual(index, arrList.IndexOf(x));

  // Assert that the last index of the modified element in the ArrayList is the specified index
  Assert.AreEqual(index, arrList.LastIndexOf(x));

  // Assert that the ArrayList contains the modified element
  Assert.IsTrue(arrList.Contains(x));

}

assert PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{

  // Assertions related to the retrieval of a specific element from the ArrayList

  // Assert that the retrieved element is not -1
  Assert.IsNotEqual(-1, arrList[index]);

}

assert PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
{

  // Assertions related to the checking of the existence of an element in the ArrayList

  // Assert that the ArrayList contains the element after calling Contains method
  Assert.IsTrue(arrList.Contains(x));

}

