/// <summary>
/// Test case: PUT_AddContract
/// This test case verifies the Add method of the ArrayList class.
/// </summary>
[Test]
public void TestPUT_AddContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 5;

    // Act
    int OldCount = arrList.Count;
    int NewCount = arrList.Add(x);

    // Assert
    Assert.AreEqual(OldCount + 1, NewCount);
    Assert.AreEqual(true, arrList.Contains(x));
    Assert.AreEqual(OldCount, arrList.LastIndexOf(x));
    Assert.AreEqual(OldCount + 1, arrList.LastIndexOf(x));
}

/// <summary>
/// Test case: PUT_RemoveContract
/// This test case verifies the Remove method of the ArrayList class.
/// </summary>
[Test]
public void TestPUT_RemoveContract()
{
    // Arrange
    ArrayList arrList = new ArrayList();
    int x = 5;
    arrList.Add(x);

    // Act
    int OldCount = arrList.Count;
    arrList.Remove(x);
    int NewCount = arrList.Count;

    // Assert
    Assert.AreEqual(OldCount - 1, NewCount);
    Assert.AreEqual(false, arrList.Contains(x));
}

