```python
import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    for acnt in frm.accounts:
        if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True
    return False

# Test Cases
person1 = Person('Person1')
person2 = Person('Person2')

assert(transfer(person1, person2, 50))

# Check the balance after transfer
assert(person1.accounts[0].money == 50)
assert(person2.accounts[0].money == 50)
