```python
import random

class Account:
    def __init__(self, money):
        self.money = money


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]

    def total_balance(self):
        return sum([account.money for account in self.accounts])


def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    # @@@ total balance of all "frm" accounts is not less than "amnt"
    assert frm.total_balance() >= amnt, f"Total balance of {frm.name}'s accounts is less than {amnt}"

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
```
