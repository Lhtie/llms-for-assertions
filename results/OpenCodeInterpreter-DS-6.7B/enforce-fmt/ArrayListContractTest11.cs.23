<code>
[Test]
void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListContainsX = arrList.Contains(x);

    int arrList_OldCount = arrList.Count;
    int arrList_Add = arrList.Add(x);
    int arrList_NewCount = arrList.Count;
    int arrList_LastIndexOfX = arrList.LastIndexOf(x);

    Assert.AreEqual(arrList_OldCount+1, arrList_NewCount);
    Assert.AreEqual(arrList_NewCount, arrList.Count);
    Assert.AreEqual(true, arrList.Contains(x));
}
</code>
```
```
<code>
[Test]
void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    int Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    int New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount-1, New_arrListCount);
    Assert.AreEqual(false, New_arrListContainsX);
}
</code>
```
```
<code>
[Test]
void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListContainsX = arrList.Contains(x);

    arrList.Insert(index, x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount+1, New_arrListCount);
    Assert.IsTrue(New_arrListIndexOfX >= 0);
    Assert.AreEqual(true, New_arrListContainsX);
}
</code>
```
```
<code>
[Test]
void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListContainsX = arrList.Contains(x);

    arrList[index] = x;

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount, New_arrListCount);
    Assert.IsTrue(New_arrListIndexOfX >=0);
    Assert.AreEqual(true, New_arrListContainsX);
}
</code>
```
