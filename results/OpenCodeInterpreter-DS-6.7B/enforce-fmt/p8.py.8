import numpy as np

def check_eigen():
    mtx = np.random.random((10,10))

    evalues, evectors = np.linalg.eig(mtx)

    lambda_ = evalues[0]
    vec = evectors[:, 0]

    lambdavec = mtx @ vec

    # lambdavec is close to lambda times vec

    assert np.allclose(lambdavec, lambda_ * vec), "lambdavec is not close to lambda times vec"
    
    return evalues, evectors

print(check_eigen())
```

