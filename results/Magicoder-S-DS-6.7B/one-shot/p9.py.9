def get_assert_statements(code):
    statements = []
    current_block = ''
    
    for line in code.split('\n'):
        line = line.strip()
        if line.startswith('# @@@'):
            assert_statement = line[6:].strip()
            statements.append(f'assert {assert_statement}')
        elif line.startswith('def') or line.startswith('class'):
            current_block = line.split(' ')[1] 
        elif line.startswith('    ') and line.strip()[-1] != ':':
            if current_block and assert_statement in line:
                indent = line.index('(')
                statement = f'    {assert_statement}'
                statements.append(statement[indent:])
                
    return statements

