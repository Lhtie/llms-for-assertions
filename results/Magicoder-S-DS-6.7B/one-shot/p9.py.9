def analyze(code_str):
    lines = code_str.split('\n')
    assert_conditions = []
    is_in_docstring = False
    for line in lines:
        if '"""' in line:
            is_in_docstring = not is_in_docstring 
        elif is_in_docstring:
            assert_conditions.append('    ' + line.lstrip().rstrip('"""'))
    assert_str = '\n'.join(assert_conditions)
    return f"<code>\n{assert_str}\n</code>"

