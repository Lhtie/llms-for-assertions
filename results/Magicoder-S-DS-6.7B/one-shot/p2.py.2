```py
def get_asserts(code):
    lines = code.split("\n")
    
    function = lines[0].split("(")[0]
    assert_list = []
    
    for line in lines[1:]:
        if "assert" in line:
            assert_condition = line[line.index(" ")+1:].strip()
            print(f"    <code>{assert_condition}</code>")
            assert_list.append(assert_condition)
        elif "comment" in line:
            comment = line[line.index("#")+1:].strip()
            comment = comment.replace("is", "==")
            assert_list.append(f"{function}{comment}")
            
    return assert_list

