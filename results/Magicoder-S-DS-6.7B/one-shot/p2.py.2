def convert_code_comments_to_asserts(code_str):
    lines = code_str.split('\n')
    for line in lines:
        if line.strip().startswith('###'):
            assert_str = line.split('###')[1].strip()
            comment = assert_str.split('###')[0]
            assert_str = assert_str.split(comment)[1].strip()
            if '=' in assert_str:
                assert_str = '{}'.format(assert_str)
            yield comment, assert_str

code_str = """
