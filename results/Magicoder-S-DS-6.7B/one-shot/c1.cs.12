```cs
using System;
using System.IO;

namespace ConsoleApp
{
    class Program
    {
        static void Main(string[] args)
        {
            string[] codeBlock = {
                "    public static int Sum(int x, int y)",
                "    {",
                "        int sum = x + y;",
                "        // @@@ sum is greater than or equal to x and y",
                "        return sum;",
                "    }",
                "",
                "    void LoadTemplates(string fileName)",
                "    {",
                "        bool templatesFileExist = File.Exists(fileName);",
                "        // @@@ the template file exists",
                "    }"
            };

            string output = "";

            foreach(string line in codeBlock)
            {
                if(line.TrimStart().StartsWith("// @@@"))
                    output += $"\nDebug.Assert({line.Replace("// @@@ ", "").Replace("\r\n", " ").Replace(";", ";")});\n";
                else if(line.StartsWith("public static"))
                    output += $"\n{line}\n{{\n";
                else if(line.StartsWith("void"))
                    output += $"\n{line}\n{{\n";
                else if(line.Trim() == "}")
                    output += $"{line}\n",

                else if(string.IsNullOrWhiteSpace(line))
                    output += "// " + line.Trim();
                else
                    output += line.Trim();
            }

            Console.WriteLine(output);
        }
    }
}
```

