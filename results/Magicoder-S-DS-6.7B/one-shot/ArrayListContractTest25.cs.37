import re

def generate_assert_code(code):
    lines = code.split("\n")
    assert_lines = [line for line in lines if re.match(r'// @@@\s+', line)]
    assert_code = "\n".join(assert_lines)
    return assert_code

def read_csharp_code(file_name):
    with open(file_name, "r") as f:
        return f.read()

def write_assert_code(file_name, code):
    with open(file_name, "w") as f:
        f.write(code)

if __name__ == '__main__':
    csharp_code = read_csharp_code("your_csharp_file.cs")
    assert_code = generate_assert_code(csharp_code)
    write_assert_code("assert_file.txt", assert_code)
```

