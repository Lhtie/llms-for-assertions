import re

def convert_csharp_code(code):
    # split code by '// @@@' or '// //' or '//'
    parts = re.split('// @@@ |// //|//', code)
    # filter non-empty parts
    parts = [part for part in parts if part.strip()]
    # return joined parts
    return '\n'.join(parts)

