import re

def read_assert(code):
    pattern = re.compile(r'// @@@ (.*)')
    comments = pattern.findall(code)
    return comments


def convert_to_assert(comments):
    for comment in comments:
        comment = comment.replace(' and ', ' && ').replace(' or ', ' || ')
        if ' ' not in comment:
            print(f'Debug.Assert({comment});')
        else:
            operator, condition1, condition2 = comment.split(' ', 2)
            if operator.lower() == 'equal' or operator.lower() == 'equivalent' or operator.lower() == 'same':
                operator = '=='
            elif operator == 'greater than' or operator == 'more than':
                operator = '>'
            elif operator == 'less than':
                operator = '<'
            print(f'Debug.Assert({condition1} {operator} {condition2});')


code = "... your csharp code ..."
comments = read_assert(code)
convert_to_assert(comments)
```

