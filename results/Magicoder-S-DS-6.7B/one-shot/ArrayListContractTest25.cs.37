```python
import ast
import re

def transform_code(code):
    tree = ast.parse(code)
    for node in ast.iter_child_nodes(tree):
        for child in node.body:
            if isinstance(child, ast.Expr):
                if isinstance(child.value, ast.Str) and re.match(r'^\s*@@@', child.value.s):
                    comment = child.value.s
                    new_statement = f'print("{comment.strip()}")'
                    new_node = ast.parse(new_statement).body[0]
                    child.value = ast.Str(s='')
                    child.value.s = new_statement
                    node.body.remove(child)
                    node.body.append(new_node)
    return ast.unparse(tree)

code = '''
public static void Main(string[] args)
{
    int x = 5;
    int y = 10;
    int sum = x + y;
    // @@@ sum is greater than or equal to x and y
    Console.WriteLine(sum);
}
'''
transformed_code = transform_code(code)
print(transformed_code)
```

This script will search through the code for comment lines starting with `@@@`, remove them, and replace them with a call to `Console.WriteLine` with the comment as an argument to print it when the code is run.

