```csharp
using System;
using NUnit.Framework;

namespace ArrayList.Test
{
    public class ArrayListContractTest
    {
        [Test]
        public void Test([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int oldCount = arrList.Count;
            int oldIndexOfX = arrList.IndexOf(x);
            int oldLastIndexOfX = arrList.LastIndexOf(x);
            bool oldContainsX = arrList.Contains(x);

            arrList.Add(x);

            int newCount = arrList.Count;
            int newIndexOfX = arrList.IndexOf(x);
            int newLastIndexOfX = arrList.LastIndexOf(x);
            bool newContainsX = arrList.Contains(x);

            Assert.IsTrue(oldCount+1 == newCount, "ArrayList size not increased by 1 after Adding");
            Assert.IsTrue(newIndexOfX >= 0, "New Element not added properly");
            Assert.IsTrue(newLastIndexOfX >= 0, "New Element not added properly");
            Assert.IsTrue(newContainsX, "New Element not added properly");

            arrList.Remove(x);

            newCount = arrList.Count;
            newIndexOfX = arrList.IndexOf(x);
            newLastIndexOfX = arrList.LastIndexOf(x);
            newContainsX = arrList.Contains(x);

            Assert.IsTrue(oldCount == newCount, "ArrayList size not reduced by 1 after Removing");
            Assert.IsTrue(newIndexOfX == -1, "Element not removed properly");
            Assert.IsTrue(newLastIndexOfX == -1, "Element not removed properly");
            Assert.IsTrue(!newContainsX, "Element not removed properly");

            arrList.Insert(index, x);

            newCount = arrList.Count;
            newIndexOfX = arrList.IndexOf(x);
            newLastIndexOfX = arrList.LastIndexOf(x);
            newContainsX = arrList.Contains(x);

            Assert.IsTrue(oldCount+1 == newCount, "ArrayList size not increased by 1 after Inserting");
            Assert.IsTrue(newIndexOfX >= 0, "New Element not added properly");
            Assert.IsTrue(newLastIndexOfX > oldLastIndexOfX, "Element not inserted properly");
            Assert.IsTrue(newContainsX, "New Element not added properly");

            arrList[index] = x;

            newCount = arrList.Count;
            newIndexOfX = arrList.IndexOf(x);
            newLastIndexOfX = arrList.LastIndexOf(x);
            newContainsX = arrList.Contains(x);

            Assert.IsTrue(oldCount == newCount, "ArrayList size not reduced by 1 after Setting");
            Assert.IsTrue(newIndexOfX >= 0, "Element not set properly");
            Assert.IsTrue(newLastIndexOfX > oldLastIndexOfX, "Element not set properly");
            Assert.IsTrue(newContainsX, "New Element not added properly");

            int getResult = (int)arrList[index];

            newContainsX = arrList.Contains(getResult);
            Assert.IsTrue(getResult == x, "Element not Get properly");
            Assert.IsTrue(newContainsX, "Element not Get properly");

            bool containsResult = arrList.Contains(x);
            Assert.IsTrue(containsResult, "Contains function not working properly");

            int indexOfResult = arrList.IndexOf(x);
            Assert.IsTrue(indexOfResult >= 0, "IndexOf function not working properly");

            int lastIndexOfResult = arrList.LastIndexOf(x);
            Assert.IsTrue(lastIndexOfResult >=0, "LastIndexOf function not working properly");
        }
    }
}
```
Remember to replace `[PexAssumeUnderTest]` in the arguments and `[Test]` in the `[Test]` attribute with the actual method name from your code. Also, adjust the test method--------------------