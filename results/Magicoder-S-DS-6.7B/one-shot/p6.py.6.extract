--------------------------------------------------------------------------------
class Rectangle():
    def __init__(n, m):
        self.exp = n # this is how tall
        self.mat = n+m+2
        self.lin = m # this is how wide

def func(n, m):
    r = Rectangle(n,m)
    assert r.exp > 0 # height of r is positive
    assert r.lin > 0 # width of r is positive

# For Rectangle object initialisation
r = Rectangle(3, 4)
assert r.exp > 0 # height of r is positive
assert r.lin > 0 # width of r is positive------------------------------------------------------------------------------------------------------------------------