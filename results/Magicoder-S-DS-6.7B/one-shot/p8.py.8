import numpy as np
import re

def process_code(code):
    lines = code.split('\n')
    for i, line in enumerate(lines):
        match = re.match(r'\s*# @@@ (.*)', line)
        if match:
            comment = match.group(1)

            # Assuming 'mtx' and 'vec' are already defined in scope
            assert_statement = "np.allclose(lambdavec, lambda0 * vec)"
            
            # Format the assert statement with the comment as a comment block
            formatted_statement = f"# {comment}\nassert {assert_statement}\n"
            
            # Insert the formatted statement before the matching line
            lines.insert(i, formatted_statement)

    return '\n'.join(lines)


