import re

def get_assert_statement(code):
    match_objs = re.finditer(r'# @@@ (.+)', code)
    comment_to_assert = {m.group(1):m.start() for m in match_objs}

    assert_statements = []
    for k, v in comment_to_assert.items():
        comment = 'assert ' + k
        assert_statements.append((v, comment))

    assert_statements.sort()
    return [s[1] for s in assert_statements]


