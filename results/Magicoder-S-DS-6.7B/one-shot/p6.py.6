def read_code(code_lines):
    assertions = [] # List to store assert statements
    for line in code_lines:
        if line.strip().startswith('assert'): # If line is an assert statement
            assertions.append(line)
        elif line.startswith('def') or line.startswith('class'): # If line is a function or class definition
            assertions = [] # Clear assert statements
        elif ':' in line: # If line is executable
            assertions = [] # Clear assert statements
        else: # If line is a comment
            if '@@@' in line: # If comment starts with '@@@'
                assertions.append(f'    def test_assert({line.replace("@", "").replace("@", "").replace(" ", "")}):') # Add assert statement as a function definition
                assertions.append(f'        assert {line.split("###").pop(0).replace("@", "").replace("@", "").replace(" ", "").replace(")",")} ')
    return assertions

