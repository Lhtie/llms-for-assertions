def main(code_content):
    lines = code_content.split("\n")
    assert_statements = []

    for line in lines:
        line = line.strip()
        if '#' in line:
            comment = line.split("#")[1].strip()
            assert_statements.append("assert " + comment)

    return "\n".join(assert_statements)

