import re

def assert_converter(py_code):
    # Split the file into lines.
    lines = py_code.split('\n')
    new_lines = [] 

    for line_number, line in enumerate(lines):
        if '@@@' in line:
            start_index = line.index('@@@') + len('@@@')
            comment = line[start_index:].strip()

            # Construct the assert statement.
            assert_statement = f'assert {comment}'
            
            # Keep the existing line to use in the output.
            existing_line = lines[line_number-1]
            
            # Replace the comment with the `assert` statement.
            line = line.replace(comment, assert_statement)

        new_lines.append(line)
    return '\n'.join(new_lines)

