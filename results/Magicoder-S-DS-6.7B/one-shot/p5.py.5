def read_and_print_asserts(code):
    for line in code.splitlines():
        if line.strip().startswith('@@@'):
            assert_statement = line.lstrip('@').strip().replace('  ', ' ').replace('$', 'sum')
            print(f'<code>\nassert {assert_statement}\n</code>')
    
read_and_print_asserts("""
    def sum(x, y):
        sum = x + y
        # @@@ sum is greater than or equal to x and y 
        return sum

    class Rectangle():
        def __init__(n, m):
            self.exp = n  # this is how wide
            self.mat = n+m+2
            self.lin = m  # this is how tall


    def func(n, m):
        r = Rectangle(n, m)
        # @@@ height of r is positive
""")
```
