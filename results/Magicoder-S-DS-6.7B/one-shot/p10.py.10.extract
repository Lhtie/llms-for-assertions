import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        # an account has been created for each person with a random amount of money
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    for acnt in frm.accounts:
        if(acnt.money >= amnt):
            assert amnt > 0 and amnt <= 100, "Transfer amount not valid!"
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    assert False, "Cannot perform the transfer due to insufficient balance!"
    return False
