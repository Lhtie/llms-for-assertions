```python
import re
from typing import List

def get_comments(code: str) -> List[str]:
    return re.findall(r'# @@@ (.+)', code)

def create_assert_lines(comments: List[str]) -> List[str]:
    return [f"assert {comment}" for comment in comments]

def read_and_output(code: str):
    comments = get_comments(code)
    assert_lines = create_assert_lines(comments)
    return '\n'.join(assert_lines)

