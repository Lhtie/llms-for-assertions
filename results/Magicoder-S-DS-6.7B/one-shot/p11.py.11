import re

def extract_asserts(code):
    # define a regular expression that matches comment lines starting with '@@@'
    pattern = re.compile(r'\s*# @@@ (.+)', re.MULTILINE)

    # find the matches in the code
    matches = re.finditer(pattern, code)

    # extract assert statements corresponding to the comments in <code> block
    for match in matches:
        print(f"<code>assert {match.group(1)}</code>")


