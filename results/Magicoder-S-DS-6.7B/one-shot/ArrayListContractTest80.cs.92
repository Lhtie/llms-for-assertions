        {
            int index = arrList.LastIndexOf(x);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int count = arrList.Count;
            Debug.Assert(count > 0);
        }
    }

