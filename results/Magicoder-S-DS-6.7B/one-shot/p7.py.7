import ast

def find_comments(code):
    lines = code.split("\n")
    comments = []
    ignore_indent = False
    for line in lines:
        if "import numpy as np" in line or "np.linalg.eig" in line: 
            continue  # Ignoring these lines since those are not part of the comments
        if "import" in line: 
            continue # Ignoring import statements
        if "np.random.random" in line: 
            continue # Ignoring numpy.random line
        if len(line) == 0: 
            continue  # Ignoring empty lines
        if line.strip().startswith("#"):
            comments.append(line[1:])
        else:
            ignore_indent = True
            comments.append(line)
        if ignore_indent and line.strip().startswith("#"):
            comments.append(line[1:])
    return comments

