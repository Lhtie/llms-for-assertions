```python
import re
import tokenize
from io import StringIO
from tokenize import generate_tokens
from collections import deque


def match_expr_with_comment(expr_str, comment_str):
    if not isinstance(expr_str, str) or not isinstance(comment_str, str):
        raise TypeError("Expected string arguments")

    expr_tokens = r'(\s*#.*?)(\s*)'+ '(\s*".*?")*\s*'.join(expr_str.split()) + '$'
    match = re.search(expr_tokens, comment_str)
    if match:
        group = match.group(0).strip()
        if group.startswith("# @@@"):
            return group[5:]
    return False

def convert_python_code_to_asserts(code):
    tokens = generate_tokens(StringIO(code).readline)
    comment_queue = deque([], maxlen=1)
    output = []
    for token in tokens:
        # Detect and ignore single line comments
        if token.type == tokenize.COMMENT:
            comment_queue.append(token.string[2:])
        elif token.type == tokenize.OP and token.string == '#':
            comment_queue.append(next(tokens).string[1:])
        # Detect and output assert statement
        elif token.type == tokenize.NAME and token.string == 'assert':
            expr = next(tokens).string
            comment = comment_queue[0].strip()
            result = match_expr_with_comment(expr, comment)
            if result:
                output.append(('assert ' + expr).strip() + '  # @@@ ' + result)
    return output

