public static void Insert(ArrayList s, int x)
{
    for (int i = 0; i < x; i++){
        int inp = Input();
        s.Add(inp);
    }
    // @@@ Size of array does not change after the operation 
    Debug.Assert(OLD(s.Count) == RET);
}
