public static void Add() 
{
    if (_version != OLD(_version)) throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");

    if (_size == _items.Length) EnsureCapacity(_size + 1);
    _items[_size] = value;
    _version++;
 
  // @@@ Size of list increases by 1 after operation
}
