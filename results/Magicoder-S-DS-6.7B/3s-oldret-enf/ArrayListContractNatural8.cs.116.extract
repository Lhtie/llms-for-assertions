using System.Diagnostics;

public static void Insert(Stack s, int x)
{
    int oldSize = s.Count;
    for (int i = 0; i < x; i++){
        int inp = Input();
        s.push(inp);
    }
    Debug.Assert(oldSize + x == s.Count); // @@@ Size of stack increases by x in the function
}
