[Debug.Assert] private object _items => OLD(Array.Empty<object>());
[Debug.Assert] private int _size => OLD(s.Count);
[Debug.Assert] private int _version => OLD(0);
[Debug.Assert] private object _syncRoot => OLD((Object)null);
[Debug.Assert] public int Capacity => 2*_size;
[Debug.Assert] private void EnsureCapacity(int min){_size = min;}
[Debug.Assert] private void Clear() { _size = 0; _version++; }
[Debug.Assert] public int Add(Object value) {
if (_size == _items.Length) EnsureCapacity(_size + 1);
_items[_size] = value;
_version++;
return _size++; }
[Debug.Assert] public int IndexOf(Object value) => Array.IndexOf((Array)_items, value, 0, _size);
[Debug.Assert] public int LastIndexOf(Object value) => LastIndexOf(value, _size - 1, _size);
[Debug.Assert] public int Remove(Object obj) { int index = IndexOf(obj); if (index >= 0) RemoveAt(index); return index; }
