using System;

public static void InsertAssert(Stack s, int x)
{
    int oldSize = s.Count;
    for (int i = 0; i < x; i++){
        int inp = Input();
        s.push(inp);
    }
    Debug.Assert(s.Count == oldSize + x);
}

public static void PaddAssert(int x, int y)
{
    int sum = x + y;
    Debug.Assert(sum >= x && sum >= y);
    return sum;
}

public static void SearchAssert(Collection c, int val)
{
    int index = c.SearchFrom(c, val, 2);
    Debug.Assert(index == -1 || index >= 2);
    return index;
}

public static void AddAssert(ArrayList list, Object value)
{
    int oldSize = list.Count;
    list.Add(value);
    Debug.Assert(list.Count == oldSize + 1);
}

public static void AddRangeAssert(ArrayList list, System.Collections.ICollection c)
{
    int oldSize = list.Count;
    list.AddRange(c);
    Debug.Assert(list.Count >= oldSize && list.Count <= oldSize + c.Count);
}

public static void ClearAssert(ArrayList list)
{
    int oldSize = list.Count;
    list.Clear();
    Debug.Assert(list.Count == 0);
}

public static void ContainsAssert(ArrayList list, Object item)
{
    bool oldContain = list.Contains(item);
    list.Add(item);
    Debug.Assert(list.Contains(item) == true);
}

public static void IndexOfAndRemoveAtAssert(ArrayList list, int index)
{
    int oldCount = list.Count;
    int oldIndex = list.IndexOf(list[index]);
    list.RemoveAt(index);
    Debug.Assert(list.IndexOf(list[index]) == -1);
}

public static void LastIndexOfAssert(ArrayList list, Object value)
{
    int oldCount = list.Count;
    int oldLastIndex = list.LastIndexOf(value);
    list.Add(value);
    Debug.Assert(list.LastIndexOf(value) == oldCount);
}
