
public class ArrayList
{
    private Object[] _items; // Do not rename (binary serialization)
    private int _size; // Do not rename (binary serialization)
    private int _version; // Do not rename (binary serialization)
    [NonSerialized]
    private Object _syncRoot;

    private const int _defaultCapacity = 4;

    // Copy of Array.MaxArrayLength
    internal const int MaxArrayLength = 0X7FEFFFFF;

    // The constructor
    public ArrayList()
    {
        _items = EmptyArray<Object>.Value;
    }

    // The capacity property
    public virtual int Capacity
    {
        get
        {
            return _items.Length;
        }
        set
        {
            if (value < _size) value = _size;
            if (value != _items.Length)
            {
                if (value > 0)
                {
                    Object[] newItems = new Object[value];
                    if (_size > 0) Array.Copy(_items, 0, newItems, 0, _size);
                    _items = newItems;
                }
                else
                {
                    _items = EmptyArray<Object>.Value;
                }
            }
            _version++;
        }
    }

    // The count property
    public virtual int Count
    {
        get
        {
            return _size;
        }
    }

    // This indexer
    public virtual Object this[int index]
    {
        get
        {
            if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");

            return _items[index];
        }
        set
        {
            if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
            _items[index] = value;
            _version++;
        }
    }

    // This method
    public virtual int Add(Object value)
    {
        if (_size == _items.Length) EnsureCapacity(_size + 1);
        _items[_size] = value;
        _version++;
        return _size++;
    }

    // This method
    public virtual void Clear()
    {
        if (_size > 0)
        {
            Array.Clear(_items, 0, _size);
            _size = 0;
            _version++;
        }
    }

    private void EnsureCapacity(int min)
    {
        if (min > _items.Length)
        {
            int newCapacity = (_items.Length == 0) ? _defaultCapacity : _items.Length * 2;
            if (min > newCapacity) newCapacity = min;
            else if (newCapacity > MaxArrayLength) newCapacity = MaxArrayLength;
            Capacity = newCapacity;
        }
    }

    // This method
    public virtual int IndexOf(Object value)
    {
        return Array.IndexOf((Array)_items, value, 0, _size);
    }

    private int LastIndexOf(Object value, int startIndex, int count)
    {
        for (int i = startIndex; i >= 0; i--)
            if (Object.Equals(_items[i], value))
                return i;
        return -1;
    }

    // This method
    public virtual int LastIndexOf(Object value)
    {
        return LastIndexOf(value, _size - 1, _size);
    }

    // This method
    public virtual void Remove(Object obj)
    {
        int index = IndexOf(obj);
        if (index >= 0)
            RemoveAt(index);
    }

    // This method
    public virtual void RemoveAt(int index)
    {
        if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
        Array.Copy(_items, index + 1, _items, index, _size - index - 1);
        _size--;
    }
}
