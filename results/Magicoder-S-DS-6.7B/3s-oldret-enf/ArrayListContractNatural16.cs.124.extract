{
    private static int Previous(int index) => index > 0 ? index - 1 : index;
    public static void Insert(ArrayList S, int x)
    {
        for (int i = 0; i < x; i++){
            int inp = Input();
            S.Add(inp);
        }
        // @@@ Size of list increases by x in the function
        Debug.Assert(Previous(S.Count) + x + 1 == S.Count);
    }
}--------------------
