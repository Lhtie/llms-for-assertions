    public ArrayList()
    {
        Assert.IsNull(OLD(_items));
        Assert.AreEqual(0, OLD(_size));
        Assert.AreEqual(0, OLD(_version));
    }
    //...
    public int Add(Object value)
    {
        if (OLD(_size) == OLD(_items).Length) EnsureCapacity(OLD(_size) + 1);
        OLD(_items)[OLD(_size)] = value;
        OLD(_version)++;
        Assert.AreEqual(OLD(_size) + 1, OLD(_size));
                
        return OLD(_size)++;
    }
    //...
    public void Insert(int index, Object value)
    {
        Assert.IsTrue(index >= 0 && index <= OLD(_size));
        if (OLD(_size) == OLD(_items).Length) EnsureCapacity(OLD(_size) + 1);
        if (index < OLD(_size))
        {
            Array.Copy(OLD(_items), index, OLD(_items), index + 1, OLD(_size) - index);
        }
        OLD(_items)[index] = value;
        OLD(_size)++;
        OLD(_version)++;
        Assert.AreEqual(OLD(_size), OLD(_size)); // @@@ count of the list increases by 1 after inserting x in the array 
    }
    //...
}
