public static List<string> GetArrayListComments(string code)
{
    List<string> assertLines = new List<string>();

    StringReader reader = new StringReader(code);

    string line;
    StringBuilder stringBuilder = new StringBuilder();

    while ((line = reader.ReadLine()) != null)
    {
        if (line.StartsWith("// @@@"))
        {
            string assertStatement = line.Replace("// @@@", "").Trim();
            assertLines.Add(assertStatement);
        }
        else if (line.StartsWith("Debug.Assert"))
        {
            string assertStatement = line.Replace("Debug.Assert", "").Trim();
            assertLines.Add(assertStatement);
        }

        stringBuilder.Append(line);
        if (!line.EndsWith("}"))
        {
            stringBuilder.Append(" ");
        }
        else // Add the closing bracket only if this is the last line in the function
        {
            string functionBody = stringBuilder.ToString();
            string functionName = functionBody.Substring(0, functionBody.IndexOf(")") + 1).Trim();

            Match match = Regex.Match(code, functionName + @"\{[^\}]*\}");
            string functionCode = match.Value;
            List<string> variables = functionCode.Split(';').Select(x => x.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();

            List<string> accesses = assertLines[assertLines.Count - 1].Split('=').Select(x => x.Trim()).ToList();

            for (int i = 0; i < accesses.Count; i++)
            {
                if (accesses[i].StartsWith("OLD(") && accesses[i].EndsWith(")"))
                {
                    string oldVar = accesses[i].Replace("OLD(", "").Replace(")", "").Trim();
                    accesses[i] = GetAccesses(oldVar, variables);
                }
                else
                {
                    accesses[i] = Regex.Replace(accesses[i], "[^A-Za-z0-9]", "");
                }
            }

            if (accesses.Count == 2) // if the assertion involves one return value only
            {
                string retAssert = accesses[0] + " = " + accesses[1];
                assertLines[assertLines.Count - 1] = retAssert;
            }
            else if (accesses.Count > 2) // if the assertion involves more than one return value  
            {
                Assert.AreEqual(accesses[0], accesses[1], double.Parse(accesses[2]));
            }

            assertLines.RemoveAt(assertLines.Count - 1);
            stringBuilder.Clear();
        }
    }

    return assertLines;
}

public static string GetAccesses(string oldVar, List<string> variables)
{
    string accesses = string.Empty;

    List<string> varAccesses = variables.Where(x => x.Contains(oldVar)).ToList();

    if (varAccesses.Count > 0)
    {
        var access = varAccesses[0].Split('=')[0].Trim();

        if (access.StartsWith("=") && access.EndsWith("") || 
            access.StartsWith("++") && access.EndsWith("") || 
            access.StartsWith("--") && access.EndsWith(""))
        {
            return "0"; // default initial value
        }

        int endOfAccess = access.IndexOf(")") + 1;
        int startOfAccess = access.LastIndexOf(" ", endOfAccess);

        accesses = access.Substring(startOfAccess, endOfAccess - startOfAccess);
    }

    return accesses;
}</code>--------------------
