```cs
// @@@ Contains returns true if the specified value is in the ArrayList.
// It does a linear, O(n) search.  Equality is determined by calling item.Equals().

// This method uses the Array.IndexOf method to perform the search.
public virtual bool Contains(Object item)
{
    if (item == null)
    {
        for (int i = 0; i < _size; i++)
            if (_items[i] == null)
                return true;
        return false;
    }
    else
    {
        for (int i = 0; i < _size; i++)
            if ((_items[i] != null) && (_items[i].Equals(item)))
                return true;
        return false;
    }
}
