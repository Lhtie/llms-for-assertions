using System;
using System.Diagnostics;

class Program {
    public static void Main(string[] args) {
        ArrayList arr = new ArrayList();

        for(int i=0; i<10; i++){
            arr.Add(i);  // @@@ Size of ArrayList increases by 1 in the function
        }

        Debug.Assert(arr.Count - 10 == arr.Capacity);
        Debug.Assert(arr.Count > 0 && arr.Count <= 10);
    }
}
