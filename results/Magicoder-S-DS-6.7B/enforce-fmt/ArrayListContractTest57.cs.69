    [PexMethod]
    public void AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(true);

        int CountBefore = arrList.Count;

        arrList.Add(x);

        int CountAfter = arrList.Count;

        Assert.IsTrue(CountBefore <= CountAfter, "If there's change in count, it must increase");
        Assert.AreEqual(CountAfter, CountBefore + 1, "After adding, the count should be one larger than before");
        Assert.IsTrue(arrList.Contains(x), "After adding, the added item should exist in array list");
        Assert.GreaterOrEqual(arrList.IndexOf(x), 0, "After adding, index of the added item should not be negative");
        Assert.Greater(arrList.LastIndexOf(x), -1, "LastIndexOf the added item should not be negative");
    }

    [PexMethod]
    public void RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        AssumePrecondition.IsTrue(true);

        int CountBefore = arrList.Count;

        arrList.Remove(x);

        int CountAfter = arrList.Count;

        Assert.IsFalse(arrList.Contains(x), "After removing, the removed item should not exist in array list");
        if (CountBefore > CountAfter)
            Assert.AreEqual(CountAfter, CountBefore - 1, "After removing, the count should be one less than before");
        else if (CountBefore == CountAfter)
            Assert.Zero(CountBefore, "If no change in count, it should be zero");
    }

