```cs
[TestMethod]
public void TestAddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    //Assume initial conditions
    Assume.True(arrList.Count == 1);

    // Record initial state
    int oldCount = arrList.Count;

    // Call the Add method
    int newRet = arrList.Add(x);

    // Record final state
    int newCount = arrList.Count;

    // Use assert statements to check post-conditions
    Assert.AreEqual(oldCount + 1, newCount, "Count should have increased by 1");
    Assert.IsTrue(newRet > 0, "Return value should be greater than zero");
    Assert.IsTrue(arrList.Contains(x), "The list should contain the new value");
}

[TestMethod]
public void TestRemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    //Assume initial conditions
    Assume.True(arrList.Count == 1);
    Assume.True(arrList.Contains(x));

    // Record initial state
    int oldCount = arrList.Count;
    int oldIndexOfX = arrList.IndexOf(x);
    int oldLastIndexOfX = arrList.LastIndexOf(x);

    // Call the Remove method
    arrList.Remove(x);

    // Record final state
    int newCount = arrList.Count;
    int newIndexOfX = arrList.IndexOf(x);
    int newLastIndexOfX = arrList.LastIndexOf(x);

    // Use assert statements to check post-conditions
    Assert.AreEqual(oldCount - 1, newCount, "Count should have decreased by 1");
    Assert.AreEqual(-1, newIndexOfX, "IndexOf x should return -1");
    Assert.AreEqual(-1, newLastIndexOfX, "LastIndexOf x should return -1");
    Assert.IsFalse(arrList.Contains(x), "The list should not contain the original value");
}

// ...
// Repeat for all methods in the test class.
