    int Old_objListCount = arrList.Count;
    int Old_objListIndexOfX = arrList.IndexOf(x);
    arrList.Insert(index, x);
    int New_objListCount = arrList.Count;
    int New_objListIndexOfX = arrList.IndexOf(x);
    bool New_objListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_objListCount + 1, New_objListCount, "Inserting item to the list should increase its size.");
    Assert.AreEqual(index, New_objListIndexOfX, "Inserting an item in a certain position should cause its index to become that position.");
    Assert.IsTrue(New_objListContainsX, "Inserting an item into the list should make it known to contain this item.");

