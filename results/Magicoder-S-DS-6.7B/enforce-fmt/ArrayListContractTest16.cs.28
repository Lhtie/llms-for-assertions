[PexMethod]
public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    arrList.Add(x);
    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "Adding item to the list should increase its size.");
    Assert.AreEqual(New_arrListIndexOfX, New_arrListCount - 1, "Adding an item to the list should increase its index to be the last item.");
    Assert.IsTrue(New_arrListContainsX, "Adding an item to the list should make it known to contain this item.");
}
```

