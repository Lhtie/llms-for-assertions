    // Test for any exceptions
    Assert.Throws<UnauthorizedAccessException>(() => { throw new UnauthorizedAccessException(); });
    
    // Test that some value is not null
    Assert.NotNull(sampleString);
    
    // Test that two references point to the same object
    Assert.AreSame(sampleString, sampleString);
    
    // Test for floating point equality, with some given tolerance
