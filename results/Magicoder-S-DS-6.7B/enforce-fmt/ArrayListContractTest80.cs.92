[Test]
public void SampleAssertInCSharp()
{
    string sampleString = "SampleString";
    string expectedValue = "SampleString";

    // Test whether sampleString equals to expectedValue
    Assert.AreEqual(expectedValue, sampleString);

    // Test whether sampleString contains any number
