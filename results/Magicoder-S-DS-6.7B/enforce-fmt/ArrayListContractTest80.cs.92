public void testAddContract() { 
    ArrayList arrList = new ArrayList();
    int x = generateIntegerValue();  

    int Old_arrListCount = arrList.Count; 
    int Old_arrListIndexOfX = arrList.IndexOf(x); 
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x); 
    boolean Old_arrListContainsX = arrList.contains(x); 

    arrList.Add(x); 

    int New_arrListCount = arrList.Count; 
    int New_arrListIndexOfX = arrList.IndexOf(x); 
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x); 
    boolean New_arrListContainsX = arrList.contains(x); 

    Assert.assertEquals(Old_arrListCount, New_arrListCount - 1); 
    Assert.assertEquals(Old_arrListIndexOfX, New_arrListIndexOfX); 
    Assert.assertTrue(New_arrListLastIndexOfX==-1 || New_arrListLastIndexOfX==Old_arrListCount); 
    Assert.assertEquals(Old_arrListContainsX, New_arrListContainsX); 
    Assert.assertEquals(Old_arrListCount + 1, New_arrListCount); 
    } 

