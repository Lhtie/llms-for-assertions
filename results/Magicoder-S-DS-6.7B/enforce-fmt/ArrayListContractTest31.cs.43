```csharp
[Test]
public void Test_PUT_LastIndexOfContract()
{
    ArrayList arrList = new ArrayList {1, 2, 3, 4, 5, 5};
    int x = 5;
  
    Assume.That(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Assert.That(Old_arrListCount, Is.EqualTo(arrList.Count));
    Assert.That(New_arrListCount, Is.EqualTo(arrList.Count));
    Assert.That(Old_x, Is.EqualTo(x));
    Assert.That(Old_arrListIndexOfX, Is.EqualTo(arrList.IndexOf(x)));
    Assert.That(New_arrListIndexOfX, Is.EqualTo(arrList.IndexOf(x)));
    Assert.That(New_Ret, Is.EqualTo(arrList.LastIndexOf(x)));
    Assert.That(Old_arrListContainsX, Is.EqualTo(arrList.Contains(x)));
    Assert.That(New_arrListContainsX, Is.EqualTo(arrList.Contains(x)));

    // @@@ assert that the position of x in old array is more than or equal to -1 
    Assert.That(arrList.IndexOf(x), Is.GreaterThanOrEqualTo(-1));
}
```

