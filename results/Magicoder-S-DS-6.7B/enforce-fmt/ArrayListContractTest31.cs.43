```cs
[TestFixture, PexClass]
public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        // @@ Assert that the Count of arrayList increases by 1 after adding "x" to the List
        var oldCount = arrList.Count; 
        arrList.Add(x);
        Assert.AreEqual(oldCount+1, arrList.Count);
    }

    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        // The element is in the list and the count of the arraylist is decreased by one when "x" is removed from the list
        Assume.That(arrList.Contains(x));
        var oldCount = arrList.Count;
        arrList.Remove(x);
        Assert.AreEqual(oldCount - 1, arrList.Count);
    }

    [PexMethod]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        // If insert function does not throws InvalidOperationException when the index is out of range
        Assume.That(index >= 0 && index <= arrList.Count);
        try
        {
            arrList.Insert(index, x);
        }
        catch (InvalidOperationException)
        {
            Assert.Fail();
        }

        // @@ Check if x is inserted in the right position in the arranged order
        Assert.IsTrue(arrList[index] == x);
    }
    // @ similar Asserts for other methods...
}
```

