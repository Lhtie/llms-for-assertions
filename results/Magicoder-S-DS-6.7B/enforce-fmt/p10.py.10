import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    assert amnt <= 100, "Transfer amount should not be greater than 100"
    assert amnt > 0, "Transfer amount should be positive"
    
    acnt_money = sum(acnt.money for acnt in frm.accounts)
    assert acnt_money >= amnt, "Sender's account does not have enough money to transfer"
    
    for acnt in frm.accounts:
        if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
```

