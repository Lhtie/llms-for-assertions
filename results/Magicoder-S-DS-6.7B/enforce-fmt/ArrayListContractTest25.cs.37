using NUnit.Framework;
using System.Collections;
using System.Linq;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void AddTest()
        {
            var list = new ArrayList();
            int result = list.Add(1);

            Assert.AreEqual(1, list.Count);
            Assert.IsTrue(list.Contains(1));
        }

        [Test]
        public void RemoveTest()
        {
            var list = new ArrayList {1};
            list.Remove(1);

            Assert.AreEqual(0, list.Count);
            Assert.IsFalse(list.Contains(1));
        }

        [Test]
        public void InsertTest()
        {
            var list = new ArrayList {1};
            list.Insert(0, 2);

            Assert.AreEqual(2, list.Count);
            Assert.AreEqual(2, list[0]);
            Assert.AreEqual(1, list[1]);
        }

        [Test]
        public void SetTest()
        {
            var list = new ArrayList {1};
            list[0] = 2;

            Assert.AreEqual(2, list[0]);
        }

        [Test]
        public void GetTest()
        {
            var list = new ArrayList {1};

            Assert.AreEqual(1, list[0]);
        }

        [Test]
        public void ContainsTest()
        {
            var list = new ArrayList {1};
            bool result = list.Contains(1);

            Assert.IsTrue(result);
        }

        [Test]
        public void IndexOfTest()
        {
            var list = new ArrayList {1, 2, 3};
            int result = list.IndexOf(2);

            Assert.AreEqual(1, result);
        }

        [Test]
        public void LastIndexOfTest()
        {
            var list = new ArrayList {1, 2, 3, 2};
            int result = list.LastIndexOf(2);

            Assert.AreEqual(3, result);
        }

        [Test]
        public void CountTest()
        {
            var list = new ArrayList {1, 2, 3};

            Assert.AreEqual(3, list.Count);
        }
    }
}
```

