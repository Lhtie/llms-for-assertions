[PexMethod]
public void PUT_InsertAndRemoveContract([PexAssumeUnderTest]ArrayList arrList, int x, int insertIndex, int removeIndex)
{
    AssumePrecondition.IsTrue(true);

    int arrListSizeBeforeAddAndRemove = arrList.Count;
    arrList.Insert(insertIndex, x);

    Assert.IsTrue(arrList.Count > arrListSizeBeforeAddAndRemove);

    int listSizeBeforeRemove = arrList.Count;
    arrList.Remove(x);

    Assert.IsTrue(arrList.Count > 0);
    Assert.AreEqual(listSizeBeforeRemove, arrList.Count);

}
