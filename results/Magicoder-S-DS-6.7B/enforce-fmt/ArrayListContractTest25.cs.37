namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int OldCount = arrList.Count;
            int OldIndexOfX = arrList.IndexOf(x);
            int OldLastIndexOfX = arrList.LastIndexOf(x);
            bool OldContainsX = arrList.Contains(x);

            int NewRet = arrList.Add(x);

            int NewCount = arrList.Count;
            Assert.AreEqual(OldCount + 1, NewCount, "ArrayList size increases by 1 after Add");

            int NewIndexOfX = arrList.IndexOf(x);
            int NewLastIndexOfX = arrList.LastIndexOf(x);
            Assert.AreEqual(OldIndexOfX == -1 ? 0 : OldIndexOfX, NewIndexOfX, "Add returns zero index if it's the first add");
            Assert.AreEqual(OldLastIndexOfX == -1 ? 0 : OldLastIndexOfX, NewLastIndexOfX, "Add returns zero index if it's the first add");

            bool NewContainsX = arrList.Contains(x);
            Assert.IsTrue(NewContainsX, "Array list should contains x after Add");

            Assert.AreNotEqual(OldCount, NewCount, "ArrayList's count isn't reduced on removal");
            Assert.AreEqual(OldIndexOfX, NewIndexOfX, "Add should not change existing elements' position");
            Assert.AreEqual(OldLastIndexOfX, NewLastIndexOfX, "Add should not change existing elements' position");
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int OldCount = arrList.Count;
            int OldIndexOfX = arrList.IndexOf(x);
            int OldLastIndexOfX = arrList.LastIndexOf(x);
            bool OldContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int NewCount = arrList.Count;
            Assert.AreEqual(OldCount - 1, NewCount, "ArrayList size decreases by 1 after Remove");

            int NewIndexOfX = arrList.IndexOf(x);
            int NewLastIndexOfX = arrList.LastIndexOf(x);
            Assert.AreEqual(OldIndexOfX == -1 ? -1 : (OldIndexOfX > arrList.IndexOf(x) ? OldIndexOfX - 1 : OldIndexOfX), NewIndexOfX, "Remove shift right existing elements' positions correctly");
            Assert.AreEqual(OldLastIndexOfX == -1 ? -1 : (OldLastIndexOfX > arrList.LastIndexOf(x) ? OldLastIndexOfX - 1: OldLastIndexOfX), NewLastIndexOfX, "Remove shift right existing elements' positions correctly");

            bool NewContainsX = arrList.Contains(x);
            Assert.IsFalse(NewContainsX, "Array list should not contains x after Remove");

            Assert.AreNotEqual(OldCount, NewCount, "ArrayList's count isn't reduced on removal");
            Assert.AreEqual(OldIndexOfX, NewIndexOfX, "Remove shouldn't change existing elements' position");
            Assert.AreNotEqual(OldLastIndexOfX, NewLastIndexOfX, "Remove shouldn't change existing elements' position");
        }

