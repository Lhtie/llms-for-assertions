------------------------------------------------------------
PI = 3.14

class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        # Checks that the length and width are positive
        assert (l>0 and w>0), "Invalid values passed in"
        # Parent class initialization
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        # Area and Perimeter calculations are correct
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        # Return another rectangle, with the length and width swapped
        return Rectangle(self.wid, self.len)

class Circle(Shape):
    def __init__(self, r):
        # Checks that the radius is positive
        assert (r>0), "Invalid values passed in"
        # Parent class initialization
        super().__init__("Rectangle")
        self.rad = r
        # Area and Perimeter calculations are correct
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    a1, a2 = s1.area, s2.area
    
    if a1>a2: return a1
    else: return a2
