[TestMethod]
public void AddContractTest(List<int> arrList, int x)
{
    int oldCount = arrList.Count;
    arrList.Add(x);
    int newCount = arrList.Count;
    int indexOfX = arrList.IndexOf(x);
    int lastIndexOfX = arrList.LastIndexOf(x);
    bool containsX = arrList.Contains(x);

    Assert.IsTrue(newCount == oldCount + 1); 
    Assert.IsTrue(indexOfX >= 0);
    Assert.AreEqual(x, arrList[indexOfX]);
    Assert.IsTrue(lastIndexOfX == indexOfX);
    Assert.IsTrue(containsX);
}

[TestMethod]
public void RemoveContractTest(List<int> arrList, int x)
{
    int oldCount = arrList.Count;
    int oldIndexOfX = arrList.IndexOf(x);
    int oldLastIndexOfX = arrList.LastIndexOf(x);
    bool oldContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int newCount = arrList.Count;
    int newIndexOfX = arrList.IndexOf(x);
    int newLastIndexOfX = arrList.LastIndexOf(x);
    bool newContainsX = arrList.Contains(x);

    Assert.IsTrue(oldCount == newCount + 1); 
    Assert.IsTrue(newIndexOfX == -1);
    Assert.IsFalse(oldContainsX);
    Assert.IsFalse(newContainsX);
}

[TestMethod]
public void InsertContractTest(List<int> arrList, int x, int index)
{
    int oldCount = arrList.Count;
    arrList.Insert(index, x);
    int newCount = arrList.Count;
    int newIndexOfX = arrList.IndexOf(x);
    int newLastIndexOfX = arrList.LastIndexOf(x);
    bool containsX = arrList.Contains(x);

    Assert.IsTrue(oldCount + 1 == newCount);
    Assert.AreEqual(x, arrList[newIndexOfX]);
    Assert.IsTrue(newIndexOfX == newLastIndexOfX);
    Assert.IsTrue(containsX);
}

[TestMethod]
public void SetContractTest(List<int> arrList, int x, int index)
{
    int oldCount = arrList.Count;
    int oldIndexOfX = arrList.IndexOf(x);
    int oldLastIndexOfX = arrList.LastIndexOf(x);
    bool oldContainsX = arrList.Contains(x);

    arrList[index] = x;

    int newCount = arrList.Count;
    int newIndexOfX = arrList.IndexOf(x);
    int newLastIndexOfX = arrList.LastIndexOf(x);
    bool newContainsX = arrList.Contains(x);

    Assert.AreEqual(oldCount, newCount);
    Assert.AreEqual(x, arrList[index]);
    Assert.AreEqual(oldIndexOfX, newIndexOfX);
    Assert.AreEqual(oldLastIndexOfX, newLastIndexOfX);
}

[TestMethod]
public void GetContractTest(List<int> arrList, int index)
{
    int oldCount = arrList.Count;

    int itemAtIndex = arrList[index];
    bool containsItem = arrList.Contains(itemAtIndex);

    Assert.AreEqual(oldCount, arrList.Count);
    Assert.IsTrue(containsItem);
}

[TestMethod]
public void ContainsContractTest(List<int> arrList, int x)
{
    bool containsX = arrList.Contains(x);
    Assert.AreEqual(containsX, arrList.Contains(x));
}

[TestMethod]
public void IndexOfContractTest(List<int> arrList, int x)
{
    int indexOfX = arrList.IndexOf(x);
    Assert.AreEqual(indexOfX, arrList.IndexOf(x));
}

