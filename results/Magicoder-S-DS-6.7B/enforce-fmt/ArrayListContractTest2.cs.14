[Test]
public void TestAddContract()
{
    var arrList = new ArrayList();
    int x = 1;
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);
    int New_Ret = arrList.Add(x);
    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    // Assert statements
    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    Assert.AreEqual(New_Ret, Old_arrListIndexOfX + 1);
    Assert.AreEqual(New_Ret, Old_arrListLastIndexOfX + 1);
    Assert.AreEqual(true, New_arrListContainsX);
}
```--------------------```cs
using NUnit.Framework;
using System.Collections;

namespace ListTest
{
    public class AssertClass
    {
        public AssertClass(){}
        
        public void AssertAddContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.That(Old_arrListCount, Is.EqualTo(New_arrListCount-1));
            Assert.That(Old_x, Is.EqualTo(New_Ret));
            Assert.That(Old_arrListIndexOfX, Is.Not.EqualTo(New_arrListIndexOfX));
            Assert.That(Old_arrListLastIndexOfX, Is.EqualTo(New_arrListLastIndexOfX));
            Assert.That(Old_arrListContainsX, Is.False);
            Assert.That(New_arrListContainsX, Is.True);
        }

        public void AssertRemoveContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.That(Old_arrListCount, Is.EqualTo(New_arrListCount+1));
            Assert.That(Old_x, Is.EqualTo(Old_arrListIndexOfX));
            Assert.That(New_arrListIndexOfX, Is.EqualTo(-1));
            Assert.That(Old_arrListLastIndexOfX, Is.EqualTo(New_arrListLastIndexOfX));
            Assert.That(Old_arrListContainsX, Is.True);
            Assert.That(New_arrListContainsX, Is.False);
        }

        public void AssertInsertContract(ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.That(Old_arrListCount, Is.EqualTo(New_arrListCount));
            Assert.That(Old_x, Is.EqualTo(New_arrListIndexOfX));
            Assert.That(Old_index, Is.LessThan(New_arrListIndexOfX));
            Assert.That(Old_arrListIndexOfX, Is.EqualTo(New_arrListLastIndexOfX));
            Assert.That(Old_arrListLastIndexOfX, Is.GreaterThan(New_arrListLastIndexOfX));
            Assert.That(Old_arrListContainsX, Is.True--------------------Here is the C# code corresponding to the comments that start with "@@@":

