            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

# Output Python code

print("""
def getTotalBalance(person):
    balance_amount = sum(account.money for account in person.accounts)
    return balance_amount

def test_total_balance_of_all_frm_accounts_is_not_less_than_amnt():
    # create Person objects
    frm = Person('frm')
    to = Person('to')

    # set assertions
    amnt = 100
    assert getTotalBalance(frm) >= amnt, 'total balance of all "frm" accounts is less than "amnt"'

    transfer(frm, to, amnt)
    assert getTotalBalance(frm) == getTotalBalance(frm), 'total balance of all "frm" accounts should not have changed after transfer'
""")
