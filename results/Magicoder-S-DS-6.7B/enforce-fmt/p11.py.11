import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    # total balance of all "frm" accounts is not less than "amnt"

    for acnt in frm.accounts:
	if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

# Creating two persons
person1 = Person("Person One")
person2 = Person("Person Two")

# Transfer money from person1 to person2
transfer(person1, person2, 10)

# Assert statement: Person1's all accounts' money should not be less than 10 
check = True
for a in person1.accounts:
  if a.money < 10:
    check = False
assert check == True

# Assert statement: Person2's account's money should not be less than 10
