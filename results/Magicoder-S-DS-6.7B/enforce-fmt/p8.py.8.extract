# This is a random matrix calculation for the eigen values and vectors
import numpy as np

# Create a random matrix with 10 columns and 10 rows
mtx = np.random.random((10, 10))

# Calculate the eigen values and vectors
evalues, evectors = np.linalg.eig(mtx)

# Get the first eigenvalue and corresponding eigenvector
lambda0 = evalues[0]
vec = evectors[:, 0]

# Calculate lambda times vector and compare it with lambda times vector calculation
lambdavec = mtx @ vec

# Output assert statement
assert np.allclose(lambda0 * vec, lambdavec), "@@@ lambdavec is not close to lambda times vec"

print(evalues, evectors)
