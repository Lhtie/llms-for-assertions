{
   Assert.IsTrue(arrList.LastIndexOf(x) == -1 || arrList.Contains(x), "Element is not in the list");
   Assert.IsTrue(arrList.LastIndexOf(x) >= 0, "Index is negative");
}

[PexMethod]
public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
{
   Assert.IsTrue(arrList.Count >= 0, "Count is negative");
}
