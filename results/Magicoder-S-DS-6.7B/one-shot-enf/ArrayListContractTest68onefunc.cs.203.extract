
    Debug.Assert(New_Ret < 0, "If the return value is negative, x is not in old list");
    Debug.Assert(New_arrListCount == Old_arrListCount, "$old_arrList_Count should equal to $new_arrList_Count before & after the call");
    Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, "$old_arrList_LastIndexOf_x should equal to $new_arrList_LastIndexOf_x after the call");
    Debug.Assert(New_arrListContainsX == Old_arrListContainsX, "'$x' is now in or not in the list");
