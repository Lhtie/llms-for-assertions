        public Action AddContract([Values(...values go here...)] int x)
        {
            return () => Assert.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x));
        }

        public Action RemoveContract([Values(...values go here...)] int x)
        {
            return () => Assert.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x));
        }

        public Action InsertContract([Values(...values go here...)] int x, int index)
        {
            return () => Assert.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x));
        }

        public Action SetContract([Values(...values go here...)] int x, int index)
        {
            return () => Assert.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x));
        }

        public Action GetContract([Values(...values go here...)] int index)
        {
            return () => Assert.AreEqual(arrList[index], arrList.Last);
        }

        public Action ContainsContract([Values(...values go here...)] int x)
        {
            return () => Assert.AreEqual(arrList.Contains(x), arrList.Last.Equals(x));
        }

        public Action IndexOfContract([Values(...values go here...)] int x)
        {
            return () => Assert.AreEqual(arrList.IndexOf(x), arrList.Last.LastIndexOf(x));
        }

        public Action LastIndexOfContract([Values(...values go here...)] int x)
        {
            return () => Assert.AreEqual(arrList.LastIndexOf(x), arrList.Last.LastIndexOf(x));
        }

        public Action CountContract()
        {
            return () => Assert.AreEqual(arrList.Count, arrList.Last.Count);
        }
