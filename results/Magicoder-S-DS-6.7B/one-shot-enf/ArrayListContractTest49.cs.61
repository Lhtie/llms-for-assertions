                int newLastIndexOfX = arrList.LastIndexOf(x);
                bool isContained = arrList.Contains(x);
                
                Assert.AreEqual(oldCount, arrList.Count);
                Assert.AreEqual(newRet, arrList.Count - oldCount);
                Assert.AreEqual(indexOfX, arrList.IndexOf(x));
                Assert.AreEqual(lastIndexOfX, arrList.LastIndexOf(x));
                Assert.That(wasContained, is: wasContained);
                Assert.That(newindexOfX, Is.GreaterThanOrEqualTo(indexOfX));
                Assert.That(newLastIndexOfX, Is.GreaterThanOrEqualTo(lastIndexOfX));
                Assert.That(isContained, is: isContained);
            }
            
            //...
            
        }
    }
