    public void PUT_RemoveContract()
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int? New_arrListIndexOfX = null;
        int? New_arrListLastIndexOfX = null;
        bool New_arrListContainsX = false;

        if (Old_arrListCount > 0)
        {
            New_arrListIndexOfX = arrList.IndexOf(x);
            New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            New_arrListContainsX = arrList.Contains(x);
        }

        Debug.Assert(Old_arrListCount - 1 == New_arrListCount); // @@@ New count should be one less than the old count after removing

        if (Old_arrListIndexOfX != -1) 
        {
            Debug.Assert(New_arrListIndexOfX < Old_arrListIndexOfX || New_arrListIndexOfX == null); // @@@ Index of removed element should be less than the index of the removed element in the old list or not found if it was the last element
        }
        if (Old_arrListLastIndexOfX != -1) 
        {
            Debug.Assert(New_arrListLastIndexOfX < Old_arrListLastIndexOfX || New_arrListLastIndexOfX == null); // @@@ Last index of removed element should be less than the last index of the removed element in the old list or not found if it was the last element
        }
        
        Assert.AreEqual(!Old_arrListContainsX, !New_arrListContainsX); // @@@ The list should not contain the removed element if it was contained in the old list
    }
