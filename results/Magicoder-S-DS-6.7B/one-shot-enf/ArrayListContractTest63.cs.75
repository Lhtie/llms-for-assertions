    public partial class ArrayListContractTest 
    {
        [Test]
        public void PUT_AddContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 0;
            Assume.That(x >= 0); // @@@ x is greater than or equal to 0

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = -1;// arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = -1;//arrList.LastIndexOf(x);
            bool Old_arrListContainsX = false;//arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = -1;//arrList.IndexOf(x);
            int New_arrListLastIndexOfX = -1;//arrList.LastIndexOf(x);
            bool New_arrListContainsX = false;//arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount); // @@@ new count is greater than or equal to old count
            Assert.AreNotEqual(-1, New_Ret); // @@@ new return value is greater than -1
            Assert.AreEqual(Old_x, x); // @@@ old x equals new x
            Assert.AreEqual(Old_arrListIndexOfX + 1, New_arrListIndexOfX); // @@@ new index of x is old index + 1
            Assert.AreEqual(Old_arrListLastIndexOfX + 1, New_arrListLastIndexOfX); // @@@ new last indexing of x is at old last index + 1
            Assert.IsTrue(Old_arrListContainsX); // @@@ old list contains x
        }

        [Test]
        public void PUT_RemoveContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 0;
            Assume.That(x >= 0); // @@@ x is greater than or equal to 0
            arrList.Add(x);  // add x to arrayList

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x); // remove x to arrayList

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount); // @@@ new count is equal to old count minus 1
            Assert.AreEqual(-1, New_arrListIndexOfX); // @@@ new index of x is -1
            Assert.AreEqual(-1, New_arrListLastIndexOfX); // @@@ new last indexing of x is at -1
            Assert.IsTrue(!Old_arrListContainsX); // @@@ old list doesn't contain x
        }

