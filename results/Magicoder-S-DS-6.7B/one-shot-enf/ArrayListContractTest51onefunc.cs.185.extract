// @@@ If the return value is true, last position of x in new array is not the size of old array
Debug.Assert(New_Ret == false && New_arrListLastIndexOfX != Old_arrListCount);
--------------------
Debug.Assert(New_Ret ? New_arrListLastIndexOfX != Old_arrListCount : true);
--------------------
