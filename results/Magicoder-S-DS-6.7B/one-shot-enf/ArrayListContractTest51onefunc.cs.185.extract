Debug.Assert(New_Ret == false || New_arrListLastIndexOfX != Old_arrListCount);
--------------------
Debug.Assert(New_Ret == true && New_arrListLastIndexOfX != Old_arrListCount);
--------------------
Debug.Assert(New_arrListLastIndexOfX != Old_arrListCount);
--------------------
Debug.Assert(New_Ret, New_arrListLastIndexOf_x != Old_arrListCount);
