def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)
    for i in range(len(p43_coeffs)):
        for j in range(i+1, len(p43_coeffs)):
            diff = abs(p43_coeffs[i] - p43_coeffs[j])
            assert diff <= 1, f"Error:  Absolute difference between elements is not atmost 1"
--------------------
assert all(abs(p43_coeffs[i] - p43_coeffs[j]) <= 1 for i in range(len(p43_coeffs)) for j in range(i+1,len(p43_coeffs)))
--------------------
assert len(p43_coeffs) > 0 and all(abs(p43_coeffs[i+1] - p43_coeffs[i]) <= 1 for i in range(len(p43_coeffs)-1))
--------------------assert p43_coeffs[i]-p43_coeffs[i-1] <= 1 for i in range(1, n)--------------------
def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input(f'Enter coefficient {i+1}: '))
        p43_coeffs.append(inp)
    assert all(j - k <= 1 for j in p43_coeffs for k in p43_coeffs) 
--------------------
def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)
    # sum of all pairs of differences between terms in the array is atmost 1
    for i in range(len(p43_coeffs)):
        for j in range(i+1,len(p43_coeffs)):
            assert abs(p43_coeffs[i] - p43_coeffs[j]) <= 1, "Sum of all pairs of differences between terms in the array is atmost 1"
--------------------
def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.push_back(inp)
    sum_of_pairs = sum(p43_coeffs[i] - p43_coeffs[j] for i in range(n-1) for j in range(i + 1, n))
    assert sum_of_pairs <= 1
--------------------