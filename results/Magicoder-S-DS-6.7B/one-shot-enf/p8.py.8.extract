
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda_ = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

# lambdavec is close to lambda times vec

assert np.allclose(lambdavec, lambda_ * vec)
--------------------assert np.allclose(np.dot(mtx, vec), lambda*vec)--------------------
assert np.allclose(lambdavec, lambda*vec)
--------------------
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda_ = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert np.allclose(lambdavec, lambda_ * vec)

print(evalues, evectors)
--------------------
assert np.allclose(lambdavec, lambda * vec), 'lambdavec is not close to lambda times vec'--------------------
assert np.allclose(lambdavec, lambda * vec, rtol=1e-5, atol=1e-8)
--------------------
assert np.allclose(lambdavec, lambda * vec)
--------------------
import numpy as np

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda_ = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

# lambdavec is close to lambda times vec

assert np.allclose(lambdavec, lambda_ * vec)

--------------------assert np.allclose(lambdavec, lambda * vec)--------------------
assert np.isclose(lambda, evalues[0]), "Eigenvalues do not match"
assert np.allclose(lambda*vec, lambdavec), "Eigenvectors do not correspond to eigenvalues"
--------------------