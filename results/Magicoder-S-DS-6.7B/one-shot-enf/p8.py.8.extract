
import numpy as np

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

# @@@ lambdavec is close to lambda0 times vec
np.testing.assert_allclose(lambdavec, lambda0*vec)

print(evalues, evectors)
--------------------
assert numpy.allclose(lambdavec, lambda0 * vec)
--------------------
assert np.allclose(lambdavec, lambda0 * vec)
--------------------
import numpy as np

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

assert np.allclose(lambdavec, lambda0 * vec)

print(evalues, evectors)
--------------------
assert np.allclose(lambda0*vec, lambdavec)
--------------------
assert np.allclose(lambdavec, lambda0 * vec, rtol=1e-05, atol=1e-08, equal_nan=False)
--------------------
import numpy as np

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

# @@@ lambdavec is close to lambda times vec

print(evalues, evectors)
assert np.isclose(lambdavec, lambda0 * vec).all()
--------------------
    assert np.allclose(lambdavec, lambda0 * vec)
--------------------
