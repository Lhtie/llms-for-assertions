﻿using NUnit.Framework;
using ArrayList;
using System;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;
            
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount, New_arrListCount - 1);
            Assert.AreEqual(Old_x, New_arrListIndexOfX);
            Assert.AreEqual(Old_x, New_arrListLastIndexOfX);
            Assert.LessOrEqual(Old_x, New_Ret);
            Assert.IsFalse(Old_arrListContainsX);
            Assert.IsTrue(New_arrListContainsX);
        }

        [Test]
        public void PUT_RemoveContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;
            arrList.Add(x);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount, New_arrListCount + 1);
            Assert.AreNotEqual(Old_x, New_arrListIndexOfX);
            Assert.AreNotEqual(Old_x, New_arrListLastIndexOfX);
            Assert.IsFalse(Old_arrListContainsX);
            Assert.IsFalse(New_arrListContainsX);
        }

        [Test]
        public void PUT_InsertContract()
        {
            ArrayList arrList = new ArrayList();
            int x = 10;
            int index = 0;
            arrList.Add(x);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount, New_arrListCount);
            Assert.AreEqual(Old_x, New_arrListIndexOfX);
            Assert.AreEqual(Old_index, New_arrListLastIndexOfX);
            Assert.IsTrue(Old_arrListContainsX);
            Assert.IsTrue(New_arrListContainsX);
        }

