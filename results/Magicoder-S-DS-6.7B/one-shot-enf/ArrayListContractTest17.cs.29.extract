private static void ____Sum([PexAssumeUnderTest]int x, int y)
{
    Debug.Assert((y + x) >= 20);
    //the assert code starts
    int sum = x + y;
    Debug.Assert(sum >= x && sum >= y);
    //the assert code ends
}

private static void ____RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    Debug.Assert((Old_arrListIndexOfX + 0) >= 0);
}

private static void ____SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_index = index;
    arrList[index] = x;
    Debug.Assert((index + 0) == (index + 0));
}

private static void ____GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);
    int Old_arrListCount = arrList.Count;
    int Old_index = index;
    bool New_containsNewRet = arrList.Contains((int)(arrList[index]));
}

private static void ____ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    arrList.Contains(x);
}

private static void ____LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int New_Ret = arrList.LastIndexOf(x);
}

private static void ____CountContract([PexAssumeUnderTest]ArrayList arrList)
{
    AssumePrecondition.IsTrue(true);
    int New_Ret = arrList.Count;
}
