    Assert(@"the last position of x in old array is greater than or equal to some position of x in the same array", ((old_arrList_LastIndexOf_x <= new_arrList_LastIndexOf_x) || (new_arrList_LastIndexOf_x >= old_arrList_LastIndexOf_x)));
}
