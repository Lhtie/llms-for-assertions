            Debug.Assert(arrList.Count == New_arrListCount - 1);
            Debug.Assert(arrList.Count <= 0 || 0 <= New_arrListIndexOfX && New_arrListIndexOfX < arrList.Count);
            Debug.Assert(arrList.Count <= 0 || 0 <= New_arrListLastIndexOfX && New_arrListLastIndexOfX < arrList.Count);

            Debug.Assert(New_arrListCount == Old_arrListCount - 1);
            Debug.Assert(New_arrListIndexOfX >= 0);
            Debug.Assert(New_arrListLastIndexOfX >= 0);
            Debug.Assert(arrList.Equals(x));

        }

