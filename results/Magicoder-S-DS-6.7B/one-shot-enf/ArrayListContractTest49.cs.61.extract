using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList
{

public class ArrayList
{
    private List<int> list;

    public ArrayList() {
        list = new List<int>();
    }

    public int Add(int item)
    {
        list.Add(item);
        Debug.Assert(list.Count > 0);
        return list.Count;
    }

    public void Remove(int item)
    {
        list.Remove(item);
        Debug.Assert(list.Count >= 0);
    }

    public void Insert(int index, int item)
    {
        list.Insert(index, item);
        Debug.Assert(list.Count >= index);
    }

    public object this[int index]
    {
        get {
            var item = list[index];
            Debug.Assert(list.Contains(item));
            return item;
        }
        set {
            list[index] = (int)value;
            Debug.Assert(list.Contains((int)value));
        }
    }

    public int Count
    {
        get {
            Debug.Assert(list.Count >= 0);
            return list.Count;
        }
    }

    public bool Contains(int item) 
    {
        var contains = list.Contains(item);
        Debug.Assert(contains || indexOf(item) >= newArrListCount); 
        return contains; 
    }
    
    public int IndexOf(int item) 
    {
        var index = list.IndexOf(item);
        Debug.Assert(index >= old_arrListIndexOfX);
        return index;
    }
  
    public int LastIndexOf(int item) 
    {
        var index = list.LastIndexOf(item);
        Debug.Assert(index >= old_arrListLastIndexOfX);
        return index;
    }
}
}
