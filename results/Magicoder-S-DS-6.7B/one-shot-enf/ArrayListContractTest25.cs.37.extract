Debug.Assert(arrList.Count - 1 == New_arrListCount);
Debug.Assert(New_Ret == Old_arrListCount);
Debug.Assert(Old_arrListIndexOfX != -1);
Debug.Assert(Old_arrListLastIndexOfX != -1);
Debug.Assert(Old_arrListContainsX);
Debug.Assert(New_arrListIndexOfX == New_Ret);
Debug.Assert(New_arrListLastIndexOfX == New_Ret);
