        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.IsTrue(Old_arrListCount >= New_arrListCount, "The count of arrayList is decreasing after removing x.");
            Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX, "Index of x in old and new arrayList are not the same.");
            Assert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, "LastIndexOf x in old and new arrayList are not the same.");
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX, "Contains x in old and new arrayList returns same value.");


        }

