using System.Diagnostics; 
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    // @@@ PUT_AddContract method
    [Test]
    public void PUT_AddContract()
    {
        Assume.True(true);

        ArrayList arrList = new ArrayList();
        int x = Pex.Random.Next();

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Add(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);
        
        Debug.Assert(Old_arrListCount < New_arrListCount, "Add() doesn't increase Count");
        Debug.Assert(New_arrListContainsX, "Add() doesn't add item to the list");
        Debug.Assert(New_arrListIndexOfX == New_arrListCount - 1, "Add() doesn't add item at last position");
        Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1, "Add() doesn't add item at last position");
        Debug.Assert(Old_arrListIndexOfX != New_arrListIndexOfX || Old_arrListLastIndexOfX != New_arrListLastIndexOfX, "Add() doesn't change any index");
    }

    // @@@ PUT_RemoveContract method
    [Test]
    public void PUT_RemoveContract()
    {
        Assume.True(true);

        ArrayList arrList = new ArrayList();
        int x = Pex.Random.Next();

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(Old_arrListCount > New_arrListCount || !Old_arrListContainsX, "Remove() doesn't decrease Count when item doesn't exist in the list");
        Debug.Assert(Old_arrListIndexOfX == New_arrListLastIndexOfX, "Remove() doesn't update LastIndexOf or IndexOf when an item is removed from the list and the list is not empty");
        Debug.Assert(Old_arrListLastIndexOfX == -1, "Remove() doesn't update LastIndexOf or IndexOf when an item is removed from the list and the list is not empty");
        Debug.Assert(Old_arrListCount > New_arrListCount || !Old_arrListContainsX, "Remove() doesn't remove item from the list when it doesn't exist");
    }

