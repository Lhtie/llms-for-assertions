            Debug.Assert(New_arrListCount == Old_arrListCount - 1 && New_arrListCount <= New_arrListIndexOfX);
            Debug.Assert(New_arrListIndexOfX == -1 && New_arrListIndexOfX <= Old_arrListIndexOfX);
            Debug.Assert(New_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
            Debug.Assert(New_arrListContainsX == true && Old_arrListContainsX == false);   
        }

