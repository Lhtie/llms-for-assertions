namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract()
        {
            // @@@ If the return value is not -1, old array count is less than or equal to 1 
            Debug.Assert(New_Ret != -1 ? Old_arrListCount <= New_arrListCount : true);

            // @@@ sum is greater than or equal to x and y
            Debug.Assert(New_arrListCount >= Old_arrListCount);
        }

        [Test]
        public void PUT_RemoveContract()
        {
            // @@@ If the return value is not -1, old array count is greater than or equal to 1 
            Debug.Assert(New_ret != -1 ? Old_arrListCount >= New_arrListCount : true);

            // @@@ sum is greater than or equal to old x and old y
            Debug.Assert(New_arrListCount <= Old_arrListCount && New_arrListCount > 0 && New_arrListContainsX);
        }

        [Test]
        public void PUT_InsertContract()
        {
            // @@@ If index is not negative and less than or equal to count, old and new array count are equal
            Debug.Assert(Old_index < arrList.Count && Old_index >= 0 ? Old_arrListCount == New_arrListCount : true);

            // @@@ If x is present in arrList, newx is equal to oldx - if old_index is valid
            Debug.Assert(New_arrListCount > Old_arrListCount && Old_index < arrList.Count && Old_index >= 0 ? New_arrListIndexOfX >= Old_arrListIndexOfX : true);
        }

        [Test]
        public void PUT_SetContract()
        {
            // @@@ If index is valid, old and new array count are equal
            Debug.Assert(Old_index < arrList.Count && Old_index >= 0 ? Old_arrListCount == New_arrListCount : true);

            // @@@ If oldx is in arrList, newx is equal to oldx else x is not present in arrList after Set method
            Debug.Assert(Old_index < arrList.Count && Old_index >= 0 && New_arrListIndexOfX == Old_arrListIndexOfX ? Old_arrListIndexOfX == New_arrListIndexOfX : !New_arrListContainsX);
        }

        [Test]
        public void PUT_GetContract()
        {
            // @@@ If index is valid, old and new array count are equal or new array count is greater by 1
            Debug.Assert(Old_index < arrList.Count && Old_index >= 0 ? Old_arrListCount == New_arrListCount || New_arrListCount == Old_arrListCount + 1 : true);

            // @@@ If x is present in the list, then return value is equal to index value
            Debug.Assert(New_arrListIndexOfX != -1 ? New_Ret == New_arrListIndexOfX : true);
        }

        [Test]
        public void PUT_ContainsContract()
        {
            // @@@ If old List contains x, check if x is present in the current list
            Debug.Assert(Old_arrListContainsX ? New_Ret : true);
        }

        [Test]
        public void PUT_IndexOfContract()
        {
            // @@@ If the return value is not negative, old array count is greater than or equal to 1 
            Debug.Assert(New_Ret != -1 ? Old_arrListCount <= New_arrListCount : true);

            // @@@ If x is present in the list, return value is not negative
            Debug.Assert(New_arrListContainsX && New_Ret != -1);
        }

