Debug.Assert(New_Ret == Old_arrListCount + 1);
Debug.Assert(New_Ret == Old_arrListIndexOfX);//If value already present in arrList then indexOf will give -1. So when element is added this value remains the same.
Debug.Assert(New_Ret == New_arrListIndexOfX);//New_Ret should be equal to indexOf x only is the original arrList contained x.
Debug.Assert(New_Ret == Old_arrListLastIndexOfX);
Debug.Assert(New_Ret == New_arrListLastIndexOfX);
Debug.Assert(New_Ret == Old_arrListCount + 1 && New_arrListContainsX);//New_ret is increment from Old_arrListCount + 1 and the inserted value should be in new arrList.
Debug.Assert(New_arrListCount == Old_arrListCount + 1);
