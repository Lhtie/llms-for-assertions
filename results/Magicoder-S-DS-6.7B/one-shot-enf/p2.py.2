class AssertFinder(ast.NodeVisitor):
    
    def visit_Expr(self, node):
        comment_start = "assert"
        if isinstance(node.value, ast.Str):
            # match 'assert' statement within comment
            if node.value.s.startswith("### " + comment_start):
                print(f'Found "{comment_start}" in source comment: {node.value.s}')
        self.generic_visit(node)

