public partial class ArrayListContractTest
{
    public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Dns.Assert(!New_Ret || Old_arrListCount != -1, "If the return value is false, old list's count is not -1");

        Dns.Assert(New_arrListCount == Old_arrListCount || New_arrListCount == Old_arrListCount - 1 || New_arrListCount == Old_arrListCount + 1,
         "If the return value is false, new list's count should be equal to, greater than, or less than old list's count by one");

        Dns.Assert(New_arrListIndexOfX == Old_arrListIndexOfX, 
        "If the return value is false, new list's index of x should be same as old list's index of x");

        Dns.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, 
        "If the return value is false, new list's last index of x should be same as old list's last index of x");

