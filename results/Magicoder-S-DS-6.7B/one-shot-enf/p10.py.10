def test_transfer():
    person1 = Person('John')
    person2 = Person('James')

    assert all(acnt.money != 0 for acnt in person1.accounts)
    assert all(acnt.money != 0 for acnt in person2.accounts)

    # Trying to transfer more than possible
    assert transfer(person1, person2, 101) == False
    
    # Trying to transfer a positive amount
    assert transfer(person1, person2, 100) == True

    assert all(acnt.money == 0 for acnt in person1.accounts)
    assert all(acnt.money == 100 for acnt in person2.accounts)

    # After transferring 100, trying another transfer, which is now impossible
    assert transfer(person2, person1, 100) == False
