class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1


class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Parameters L and W must be positive"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)


    def flipped(self):
        return Rectangle(self.wid, self.len)


class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Paramter R must be positive"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r


def compare_a(s1, s2):
    assert isinstance(s1, Shape) and isinstance(s2, Shape), "Parameters S1 and S2 must be a Shape"
    a1, a2 = s1.area, s2.area

    if a1>a2: return a1
    else: return a2
