def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    total_frm_balance = sum(acnt.money for acnt in frm.accounts)
    assert total_frm_balance >= amnt, 'total balance of all "frm" accounts is not enough'
    # @@@ total balance of all "to" accounts is not less than "amnt"
    total_to_balance = sum(acnt.money for acnt in to.accounts)
    if total_to_balance < amnt:
      for acnt in frm.accounts:
         if(acnt.money >= amnt):
           acnt.money -= amnt
           to.accounts[0].money += amnt
           return True
      return False
