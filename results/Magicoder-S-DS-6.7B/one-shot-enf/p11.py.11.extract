
class Account:
    def __init__(self, money):
        self.money = money
        assert money >= 0, 'Account money cannot be negative'

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    
    total_money_frm = sum(acnt.money for acnt in frm.accounts)
    assert total_money_frm >= amnt, 'Total money in "frm" accounts is not less than "amnt"'

    for acnt_frm, acnt_to in zip(frm.accounts, to.accounts):
        if acnt_frm.money >= amnt:
            acnt_frm.money -= amnt
            acnt_to.money += amnt
            return True

    return False
--------------------
assert sum([acnt.money for acnt in frm.accounts]) >= amnt
--------------------
def test_transfer():
    # total balance of all "frm" accounts is not less than "amnt"
    frm = Person("Test from")
    to = Person("Test to")
    for acnt in frm.accounts:
        assert sum([account.money for account in frm.accounts]) >= transfer_amnt

    # attempts to transfers "amnt" money from "frm" to "to"
    transfer_amnt = sum([account.money for account in frm.accounts])
    assert transfer(frm, to, transfer_amnt) == True

    # total balance of all "frm" accounts is not less than "amnt"
    assert sum([account.money for account in frm.accounts]) < transfer_amnt

if __name__ == "__main__":
    test_transfer()
