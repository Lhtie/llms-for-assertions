import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]

def transfer(frm, to, amnt):
    total_money = 0
    for acnt in frm.accounts:
        total_money += acnt.money
    # @@@Total balance of all "frm" accounts is not less than "amnt"
    assert total_money >= amnt

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
--------------------
assert(frm.accounts) == sum([x.money for x in frm.accounts])) >= amnt
assert(to.accounts) == sum([x.money for x in to.accounts]) >= amnt
--------------------
assert sum(frm, to, amnt):
    total_balance = sum([acnt.money for acnt in frm.accounts])
    assert total_balance >= amnt
