public class ArrayListContractTest {
    [Test]
    public void PUT_AddContract() {
        int Old_arrListCount;
        int Old_x;
        int Old_arrListIndexOfX;
        int Old_arrListLastIndexOfX;
        bool Old_arrListContainsX;
        int New_Ret;
        int New_arrListCount;
        int New_arrListIndexOfX;
        int New_arrListLastIndexOfX;
        bool New_arrListContainsX;

        Debug.Assert(New_arrListCount == Old_arrListCount + 1);
        Debug.Assert(New_arrListIndexOfX == -1 || New_arrListIndexOfX == 0 || New_arrListIndexOfX == Old_arrListCount);
        Debug.Assert(New_arrListLastIndexOfX == -1 || New_arrListLastIndexOfX == Old_arrListCount);
        Debug.Assert(New_arrListContainsX == true);
    }

    [Test]
    public void PUT_RemoveContract() {
        int Old_arrListCount;
        int Old_x;
        int Old_arrListIndexOfX;
        int Old_arrListLastIndexOfX;
        bool Old_arrListContainsX;
        int New_arrListCount;
        int New_arrListIndexOfX;
        int New_arrListLastIndexOfX;
        bool New_arrListContainsX;

        Debug.Assert(New_arrListCount == Old_arrListCount - 1);
        Debug.Assert(Old_arrListCount > 0 && New_arrListIndexOfX == -1);
        Debug.Assert(New_arrListContainsX == false);
    }

