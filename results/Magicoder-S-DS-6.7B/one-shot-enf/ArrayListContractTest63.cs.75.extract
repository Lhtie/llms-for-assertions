    [Test]
    public void PUT_AddContract()
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        int New_Ret = arrList.Add(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

        bool New_arrListContainsX = arrList.Contains(x);

        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount); // @@@ New count should be one more than the old count after adding

        Debug.Assert(New_Ret == Old_arrListCount); // @@@ Index after adding should be the old count

        if (Old_arrListCount > 0)
        {
            Debug.Assert(New_arrListIndexOfX == New_arrListCount - 1); // @@@ Index of new element in the list should be the old count minus 1 when the list is not empty
            Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1); // @@@ Last index of new element in the list should be the old count minus 1 when the list is not empty
            Debug.Assert(New_arrListContainsX); // @@@ New element should be contained in the list after adding
        }
        else
        {
            Debug.Assert(!New_arrListContainsX); // @@@ New element should not be contained in the list if the list is empty when adding
        }
        
    }
--------------------
Debug.Assert(New_Ret >= Old_arrListCount);
----------------------------------------
System.Diagnostics.Debug.Assert(arrList.Contains(x) == Old_arrListContainsX);
System.Diagnostics.Debug.Assert(arrList.IndexOf(x) == Old_arrListIndexOfX);
System.Diagnostics.Debug.Assert(arrList.LastIndexOf(x) == Old_arrListLastIndexOfX);
System.Diagnostics.Debug.Assert(arrList.Count == New_arrListCount);
System.Diagnostics.Debug.Assert(New_arrListIndexOfX == arrList.IndexOf(x) && New_arrListLastIndexOfX == arrList.LastIndexOf(x) && New_arrListContainsX == arrList.Contains(x));
System.Diagnostics.Debug.Assert(arrList.Contains(New_Ret));
System.Diagnostics.Debug.Assert(New_Ret == arrList[index]);
