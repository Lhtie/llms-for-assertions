Debug.Assert(Old_arrListCount + 1 == New_arrListCount);
Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
Debug.Assert(New_arrListContainsX == Old_arrListContainsX);
Debug.Assert(New_Ret == Old_x);    // @@@ sum of old and new list is greater than or equal to old sum
Debug.Assert(New_arrListCount >= 0);
Debug.Assert(New_containsNewRet == Old_arrListContainsX);
Debug.Assert(New_Ret == Old_x || New_Ret >= -1);    // @@@ If the return value is false, last position of x in old list is >= -1
Debug.Assert(New_Ret >= Old_arrListIndexOfX);
Debug.Assert(New_Ret >= Old_arrListLastIndexOfX);
Debug.Assert(New_Ret >= 0);
Debug.Assert(New_Ret < arrList.Count);
