public class Test{
    [Fact]
    public void Test1(){
        ArrayList arrList = new ArrayList();
        int Old_arrListCount = arrList.Count;
        arrList.Add(1);

        Debug.Assert(Old_arrListCount < arrList.Count, "New arrListCount "+ arrList.Count +" is less than or equal to old "+ Old_arrListCount);
    }

    [Fact]
    public void Test2(){
        ArrayList arrList = new ArrayList();
        int Old_arrListCount = arrList.Count;
        arrList.Add(1);

        Debug.Assert(arrList.Contains(1) && Old_arrListCount < arrList.Count, "New arrListCount "+ arrList.Count +" is less than or equal to old "+ Old_arrListCount +" and "+ arrList.Count + " contains 1");
    }

    [Fact]
    public void Test3(){
        ArrayList arrList = new ArrayList();
        int Old_arrListCount = arrList.Count;
        arrList.Insert(0, 1);

        Debug.Assert(arrList.IndexOf(1) >= Old_arrListCount, "New arrList IndexOf 1 "+ arrList.IndexOf(1) +" is greater than or equal to old "+ Old_arrListCount);
    }

    [Fact]
    public void Test4(){
        ArrayList arrList = new ArrayList();
        int Old_arrListCount = arrList.Count;
        arrList.Set(0, 1);

        Debug.Assert(arrList.IndexOf(1) < Old_arrListCount, "New arrList IndexOf 1 "+ arrList.IndexOf(1) +" is less than or equal to old "+ Old_arrListCount);
    }
}
