
public static void Sum(int x, int y) {
    int sum = x + y;
    Debug.Assert(sum >= x && sum >= y, "sum is greater than or equal to x and y");
}

public static void AddContract(ArrayList arrList, int x) {
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Add(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(Old_arrListCount <= New_arrListCount, "New arrListCount is greater or equal to the old");
    Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX, "New arrListIndexOfX is greater than or equal to the old");
    Debug.Assert(Old_arrListLastIndexOfX <= New_arrListLastIndexOfX, "New arrListLastIndexOfX is greater than or equal to the old");
    Debug.Assert(Old_arrListContainsX == New_arrListContainsX, "Old arrListContainsX and new arrListContainsX is the same");
}

public static void RemoveContract(ArrayList arrList, int x) {
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(New_arrListCount <= Old_arrListCount, "Old arrListCount is greater or equal to the new");
    Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX, "Old arrListIndexOfX is greater or equal to the new");
    Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX, "Old arrListLastIndexOfX is greater or equal to the new");
    Debug.Assert(New_arrListContainsX != Old_arrListContainsX, "Old arrListContainsX and new arrListContainsX does not match");
}

public static void InsertContract(ArrayList arrList, int x, int index) {
    int Old_arrListCount = arrList.Count;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    arrList.Insert(index, x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(New_arrListCount == Old_arrListCount + 1, "1 more item inserted in arrList");
    Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX, "The old index of x in the new list is greater or equal to the new one");
    Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX, "The last index of x in new list is greater or equal to the old one");
    Debug.Assert(New_arrListContainsX == Old_arrListContainsX, "Old arrListContainsX and new arrListContainsX do not match");
}

