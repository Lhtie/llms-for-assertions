using System;
using Microsoft.VisualStudio.TestTools.UnitTesting;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListContractTest
    {
        [TestMethod]
        public void PUT_AddContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

	    Debug.Assert(New_arrListCount >= Old_arrListCount + 1);
            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
        }

        [TestMethod]
        public void PUT_RemoveContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(Old_arrListCount > New_arrListCount);
            Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX);
        }

        [TestMethod]
        public void PUT_InsertContract(ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(New_arrListCount >= Old_arrListCount + 1);
            Debug.Assert(Old_index <= New_arrListIndexOfX);
        }

        [TestMethod]
        public void PUT_SetContract(ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;

            arrList[index] = x;

            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(New_arrListIndexOfX == Old_index);
        }

        [TestMethod]
        public void PUT_GetContract(ArrayList arrList, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            int New_Ret = (int)(arrList[index]);

            Debug.Assert(Old_index == arrList.IndexOf(New_Ret));
        }

        [TestMethod]
        public void PUT_ContainsContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(New_Ret == (Old_arrListIndexOfX != -1));
            Debug.Assert(New_arrListCount == Old_arrListCount);
            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
        }

        [TestMethod]
        public void PUT_IndexOfContract(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
