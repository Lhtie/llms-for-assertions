            Debug.Assert(Old_arrListCount == New_arrListCount - 1);
            Debug.Assert(New_arrListIndexOfX == Old_index || New_arrListIndexOfX == Old_index+1 || New_arrListIndexOfX == Old_arrListCount);
            Debug.Assert(New_arrListLastIndexOfX == Old_index || New_arrListLastIndexOfX == Old_index+1 || New_arrListLastIndexOfX == Old_arrListCount);
