```cs
using System.Collections.Generic;
using Microsoft.Exchange.WebClient.Common;

namespace Microsoft.Exchange.WebClient.CachedMode.UnitTest
{
    public class ExchangeClientSessionTest : ExchangeClientSessionTestBase
    {
        protected override string SessionId
        {
            get
            {
                return base.SessionId;
            }
            set
            {
                base.SessionId = value;
                this.ExchangeService = new EmailService(base.SessionId, this.ExchangeUri, this.TestSettings.ConnectionTimeout);
                base.ConnectionPool.Current = this.ExchangeService;
            }
        }

        [TestMethod, Priority(1), TestCategory("BVT"), TestCategory("CachedMode")]
        public void ExchangeClientSession_Verify_SessionId_CorrectlyInitialized()
        {
            // @@@ SessionId should not be null after session is setup
            Assert.IsNotNull(this.ExchangeService.SessionId, "SessionId should not be null after session is setup.");
        }

        [TestMethod, Priority(2), TestCategory("BVT"), TestCategory("CachedMode")]
        public void ExchangeClientSession_Verify_SessionId_CorrectlyStored()
        {
            // @@@ SessionId should match the value set in the SessionId setter 
            Assert.AreEqual(base.SessionId, this.ExchangeService.SessionId, "SessionId should match the value set in the SessionId setter.");
        }

        [TestMethod, Priority(3), TestCategory("BVT"), TestCategory("CachedMode")]
        public void ExchangeClientSession_Verify_CurrentConnection_NotClosed()
        {
            // @@@ Current connection should stay open until disposed
            using (base.ConnectionPool.Current as IDisposable)
            {
                Assert.IsFalse(this.ExchangeService.IsClosed, "Current connection should stay open until disposed.");
            }
        }

        [TestMethod, Priority(4), TestCategory("BVT"), TestCategory("CachedMode")]
        public void ExchangeClientSession_Verify_ConnectionPoolCurrent_Changed()
        {
            // @@@ SessionId should match the value set in the SessionId setter 
            Assert.AreEqual(this.ExchangeService.SessionId, this.ConnectionPool.Current.SessionId, "Current connection pool's Current connection should be changed to the session created.");
        }
    }
}
