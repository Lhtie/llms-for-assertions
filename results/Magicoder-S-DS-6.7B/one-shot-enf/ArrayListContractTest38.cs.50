using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        partial void PUT_AddContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count < arrList.Count); // @@@ no loss in count when adding
        }

        partial void PUT_RemoveContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) || !arrList.Contains(x)); // @@@ a removed item cannot still exist 
        }

        partial void PUT_InsertContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert((x >= 0 && x < arrList.Count) && arrList[index] != x); // @@@ an item cannot be inserted at the same index
        }

        partial void PUT_SetContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList[index] == x); // @@@ the old value was the same as the new value
        }

        partial void PUT_GetContract(ArrayList arrList, int index)
        {
            Debug.Assert(index >= 0 && index < arrList.Count); // @@@ the requested index is within bounds
        }

        partial void PUT_ContainsContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) || !arrList.Contains(x)); // @@@ the item existed or it doesn't exist
        }

        partial void PUT_IndexOfContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) != -1); // @@@ the index of any element is never negative 
        }

        partial void PUT_LastIndexOfContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) != -1); // @@@ the last index of any element is never negative
        }

        partial void PUT_CountContract(ArrayList arrList)
        {
            Debug.Assert(arrList.Count >= 0); // @@@ the count of an array list is never negative
        }
    }
}
</code>--------------------
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        public void Test_SumContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // @@@ an index of x in old array is <= last index of x in the same array
            Debug.Assert(New_arrListCount >= Old_arrListCount);
        }
    }
}
