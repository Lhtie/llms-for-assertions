using System;
using System.Collections.Generic;
using System.Diagnostics;

public static class MyAssert
{
    public static void MyAssert(bool assertion, string message)
    {
        if (!assertion)
        {
            Debug.Assert(assertion, message);
        }
    }
}

public static class MyCollectionAssert
{
    public static void MyCollectionAssert<T>(ICollection<T> collection, Func<T, bool> condition, string message)
    {
        MyAssert(collection.Count != 0, "The collection is not empty.");

        foreach (T element in collection)
        {
            MyAssert(condition(element), "The collection does not satisfy the condition.");
        }
    }
}
