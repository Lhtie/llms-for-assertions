            Debug.AreEqual(Old_index, New_arrListLastIndexOfX);
            Debug.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            Debug.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
