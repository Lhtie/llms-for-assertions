using System.Diagnostics;
[Test]
public void PUT_IndexOfContract_ReturnValueIsNegative_ThenLastIndexOfXInOldArrayIsMinusOne()
{
    ArrayList arrList = new ArrayList();
    int index = arrList.LastIndexOf(x);
    Debug.Assert(index == -1);
}
----------------------------------------
Debug.Assert(arrListCount == New_arrListCount); Debug.Assert(x == Old_x); Debug.Assert(arrListIndexOfX == New_arrListIndexOfX); Debug.Assert(arrListLastIndexOfX == New_arrListLastIndexOfX); Debug.Assert(arrListContainsX == New_arrListContainsX);

Debug.Assert(arrListCount == New_arrListCount); Debug.Assert(x == Old_x); Debug.Assert(index == Old_index); Debug.Assert(arrListIndexOfX == New_arrListIndexOfX); Debug.Assert(arrListLastIndexOfX == New_arrListLastIndexOfX); Debug.Assert(arrListContainsX == New_arrListContainsX);

Debug.Assert(arrListCount == New_arrListCount); Debug.Assert(x == Old_x); Debug.Assert(index == Old_index); Debug.Assert(arrListIndexOfX == New_arrListIndexOfX); Debug.Assert(arrListLastIndexOfX == New_arrListLastIndexOfX); Debug.Assert(arrListContainsX == New_arrListContainsX);

Debug.Assert(arrListCount == New_arrListCount); Debug.Assert(x == Old_x); Debug.Assert(index == Old_index); Debug.Assert(arrListIndexOfX == New_arrListIndexOfX); Debug.Assert(arrListLastIndexOfX == New_arrListLastIndexOfX); Debug.Assert(arrListContainsX == New_arrListContainsX);

Debug.Assert(arrListCount == New_arrListCount); Debug.Assert(index == Old_index); Debug.Assert(New_ContainsRet == New_containsNewRet);

Debug.Assert((New_Ret == -1 && Old_arrListLastIndexOfX == -1) || New_Ret != -1);

Debug.Assert(arrListCount == New_arrListCount);

