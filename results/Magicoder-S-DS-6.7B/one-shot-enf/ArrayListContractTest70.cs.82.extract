using System.Diagnostics;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) == false);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) == false);
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList.IndexOf(x) == -1);
            Debug.Assert(arrList.LastIndexOf(x) == -1);
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(index < arrList.Count);
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(index < arrList.Count);
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // No Assert is needed as Contains method already handles this.
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            // No Assert is needed as IndexOf method already handles this.
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) == -1 || arrList.LastIndexOf(x) < arrList.Count || arrList.LastIndexOf(x) >= 0);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            // No Assert is needed as Count method already handles this.
        }
    }
}
----------------------------------------
Debug.Assert(New_arrListCount == Old_arrListCount + 1); // @@@ Count should increase when adding a value.
Debug.Assert(New_arrListIndexOfX == Old_arrListCount); // @@@ IndexOf and LastIndexOf should return the new count if the value has been added at the end.
Debug.Assert(New_arrListLastIndexOfX == Old_arrListCount); // @@@ IndexOf and LastIndexOf should return the new count if the value has been added at the end.
Debug.Assert(New_arrListContainsX); // @@@ Contains should return true if the value has been added.
