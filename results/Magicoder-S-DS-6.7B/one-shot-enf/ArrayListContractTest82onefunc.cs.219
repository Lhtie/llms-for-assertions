```python
import re

def extract_comments(code_string):
    """
    Extract C# comments (lines starting with three slashes) from string code.
    Returns a list of comments.
    """
    comments = re.findall(r'//.*?\n', code_string)
    return comments

def extract_triple_slash_comments(code_string):
    """
    Extract C# comments (lines starting with three slashes) from string code.
    Returns a list of comments.
    """
    comments = re.findall(r'///.*?\n', code_string)
    return comments

def extract_double_slash_comment(code_string):
    """
    Extract C# comments (lines starting with two slashes) from string code.
    Returns a list of comments.
    """
    comments = re.findall(r'//.*?\n', code_string)
    return comments

def extract_asserts(code_string, comments = False):
    """
    Extract assert statements from string code.
    Returns a list of assert statements.
    """
    asserts = []
    if comments:
        comments = extract_triple_slash_comments(code_string)
        for comment in comments:
            if "@@@" in comment:
                asserts.append(comment.replace("// ", "").replace("//", ""))
    else:
        asserts = re.findall(r'Debug\.Assert\(.*\);', code_string)
    return asserts

# test with sample code
