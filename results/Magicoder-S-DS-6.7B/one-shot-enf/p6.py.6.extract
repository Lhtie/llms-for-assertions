
class Rectangle():
    def __init__(n, m):
        self.exp = n # this is how tall
        assert n > 0, "The height of rectangle should be positive"
        self.mat = n+m+2
        self.lin = m # this is how wide
        assert m > 0, "The width of rectangle should be positive"

def func(n, m):
    r = Rectangle(n, m)
    assert n > 0 and m > 0, "The parameters for creating rectangle should be positive"
--------------------
class Rectangle():
    def __init__(n, m):
        self.exp = n # this is how tall
        self.mat = n+m+2
        self.lin = m # this is how wide

def func(n, m):
    r = Rectangle(n, m)
    assert r.exp > 0  # height of r is positive
--------------------
class Rectangle():
    def __init__(n, m):
        self.exp = n 
        self.mat = n+m+2
        self.lin = m 

assert self.exp > 0, "height of r is positive"
assert self.lin > 0, "width of r is positive"
