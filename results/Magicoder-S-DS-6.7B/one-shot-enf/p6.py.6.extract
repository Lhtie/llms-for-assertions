assert r.exp > 0
assert r.lin > 0
--------------------
class Rectangle():
    def __init__(n, m):
        self.exp = n  # this is how tall
        # @@@ Height of r is positive
        assert n > 0, "Height of r is positive"

        self.mat = n+m+2
        self.lin = m  # this is how wide
        # @@@ Width of r is positive
        assert m > 0, "Width of r is positive"


def func(n, m):
    r = Rectangle(n, m)
    # @@@ height of r is positive
    assert n > 0, "Height of r is positive"
