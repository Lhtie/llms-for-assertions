            Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);
            Debug.Assert(Old_arrListContainsX);
            Debug.Assert(New_arrListContainsX);
            Debug.Assert(New_Ret == Old_arrListCount);
