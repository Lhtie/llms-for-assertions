------------------------------------------------------------DEBUG.ASSERT($old_arrList_Count < $new_arrList_Count);----------------------------------------
Debug.Assert(sum && x >= 0 && y >= 0);
------------------------------------------------------------
using System.Diagnostics;
using System;
using Microsoft.Pex.Framework;
using PexAPIWrapper;

Debug.Assert(x < y, "x is less than y");
Debug.Assert(New_Ret == Old_arrListCount + 1, "New count should be old count plus one");
Debug.Assert(New_arrListIndexOfX > Old_arrListIndexOfX, "New index of x should be greater than old index of x");
Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, "New last index of x should be equal to old last index of x");
Debug.Assert(index <= arrList.Count+1, "Index should not exceed the current index value plus one");
Debug.Assert(index <= arrList.Count, "Index should not exceed the current index value");
Debug.Assert(index >= 0, "Index should be nonnegative");
Debug.Assert(index < arrList.Count, "Index should be within bounds");
Debug.Assert(arrayList.Contains(x) != Old_arrListContainsX, "Old/new arrList contains x state should differ");
Debug.Assert(New_Ret > Old_arrListCount, "New list count should exceed the old list count");
--------------------
[Test]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
int Old_arrListCount = arrList.Count;
int Old_x = x;
int Old_arrListIndexOfX = arrList.IndexOf(x);
bool Old_arrListContainsX = arrList.Contains(x);

int New_Ret = arrList.LastIndexOf(x);

int New_arrListCount = arrList.Count;
int New_arrListIndexOfX = arrList.IndexOf(x);
bool New_arrListContainsX = arrList.Contains(x);

Assert.AreEqual(Old_arrListCount, New_arrListCount, "Count mismatch");
Assert.AreEqual(Old_x, x, "x mismatch");
Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX, "IndexOf mismatch");
Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX, "Contains mismatch");

Assert.AreNotEqual(New_Ret, arrList.Count, "Index mismatch LastIndexOf non-negative");
}
