def test_transfer():
    # total balance of all "frm" accounts is not less than "amnt"
    frm = Person("Test from")
    to = Person("Test to")
    for acnt in frm.accounts:
        assert sum([account.money for account in frm.accounts]) >= transfer_amnt

    # attempts to transfers "amnt" money from "frm" to "to"
    transfer_amnt = sum([account.money for account in frm.accounts])
    assert transfer(frm, to, transfer_amnt) == True

    # total balance of all "frm" accounts is not less than "amnt"
    assert sum([account.money for account in frm.accounts]) < transfer_amnt

if __name__ == "__main__":
    test_transfer()
