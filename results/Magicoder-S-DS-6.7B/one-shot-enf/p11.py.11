<code>
def test_transfer():
    sender = Person("Alice")
    receiver = Person("Bob")
    amount = 20
    
    assert sum(x.money for x in sender.accounts) >= amount
    
    result = transfer(sender, receiver, amount)
    
    assert sum(x.money for x in sender.accounts) == sum(x.money for x in sender.accounts) - amount
    assert sum(x.money for x in receiver.accounts) == sum(x.money for x in receiver.accounts) + amount
    assert result == True
