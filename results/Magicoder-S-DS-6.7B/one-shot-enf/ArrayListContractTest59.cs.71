    public void PUT_AddContract() {
        AssumePrecondition.IsTrue(true);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        int New_Ret = arrList.Add(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(New_arrListCount > Old_arrListCount);
        Debug.Assert(Old_arrListCount > 0 || New_arrListCount == 1);
        Debug.Assert(New_arrListIndexOfX == Old_arrListCount);
        Debug.Assert(New_arrListLastIndexOfX == Old_arrListCount);
        Debug.Assert(New_arrListContainsX);

         // @@@ The return value should be equal to the new count
        Debug.Assert(New_Ret == New_arrListCount);

    }

    public void PUT_RemoveContract() {
        AssumePrecondition.IsTrue(true);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        // @@@ The new and old count cannot be the same
        Debug.Assert(!(New_arrListCount == Old_arrListCount));
        // @@@ If the old list does not contain x, indexOf & lastIndexOf should be -1. Otherwise, if a remove operation has been performed, the indexOf and lastIndexOf values should decrease with the index of the removed element
        Debug.Assert(New_arrListIndexOfX != -1 ? New_arrListIndexOfX < Old_arrListIndexOfX : (New_arrListIndexOfX == Old_arrListLastIndexOfX && New_arrListIndexOfX == -1));
        Debug.Assert(New_arrListLastIndexOfX != -1 ? New_arrListLastIndexOfX < Old_arrListLastIndexOfX : (New_arrListLastIndexOfX == -1 && Old_arrListContainsX));
        // @@@ The list should not contain the removed value
        Debug.Assert(!New_arrListContainsX);

    }

