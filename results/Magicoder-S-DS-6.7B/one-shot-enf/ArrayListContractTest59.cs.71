[Test]
public void TestAddContract()
{
    var Old_arrList = new ArrayList();
    int x = 0;

    int Old_arrListCount = Old_arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool Old_arrListContainsX = Old_arrList.Contains(x);

    var New_Ret = Old_arrList.Add(x);

    int New_arrListCount = Old_arrList.Count;
    int New_arrListIndexOfX = Old_arrList.IndexOf(x);
    int New_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool New_arrListContainsX = Old_arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    Assert.AreEqual(Old_x, x);
    Assert.AreEqual(New_Ret, Old_arrListIndexOfX);
    Assert.AreEqual(New_Ret, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
    Assert.IsFalse(Old_arrListContainsX);
    Assert.IsTrue(New_arrListContainsX);
}

[Test]
public void TestRemoveContract()
{
    var Old_arrList = new ArrayList();
    int x = 0;

    int Old_arrListCount = Old_arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool Old_arrListContainsX = Old_arrList.Contains(x);

    Old_arrList.Remove(x);

    int New_arrListCount = Old_arrList.Count;
    int New_arrListIndexOfX = Old_arrList.IndexOf(x);
    int New_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool New_arrListContainsX = Old_arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
    Assert.AreEqual(Old_x, x);
    Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
    Assert.IsTrue(Old_arrListContainsX);
    Assert.IsFalse(New_arrListContainsX);
}

[Test]
public void TestInsertContract()
{
    var Old_arrList = new ArrayList();
    int x = 0;
    int index = 0;

    int Old_arrListCount = Old_arrList.Count;
    int Old_x = x;
    int Old_index = index;
    int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
    int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool Old_arrListContainsX = Old_arrList.Contains(x);

    Old_arrList.Insert(index, x);

    int New_arrListCount = Old_arrList.Count;
    int New_arrListIndexOfX = Old_arrList.IndexOf(x);
    int New_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
    bool New_arrListContainsX = Old_arrList.Contains(x);

    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    Assert.AreEqual(Old_x, x);
    Assert.AreEqual(New_arrListIndexOfX, Old_index);
    Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
    Assert.IsFalse(Old_arrListContainsX);
    Assert.IsTrue(New_arrListContainsX);
}

