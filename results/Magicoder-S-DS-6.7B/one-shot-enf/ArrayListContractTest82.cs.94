using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int old_arrListCount = arrList.Count;
            int old_x = x;
            int old_arrListIndexOfX = arrList.IndexOf(x);
            int old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool old_arrListContainsX = arrList.Contains(x);

            int new_Ret = arrList.Add(x);

            int new_arrListCount = arrList.Count;
            int new_arrListIndexOfX = arrList.IndexOf(x);
            int new_arrListLastIndexOfX = arrList.LastIndexOf(x);

            bool new_arrListContainsX = arrList.Contains(x);

            // @@@ The return value of Add method is equal to the new Count
            Assert.AreEqual(new_Ret, new_arrListCount);

            // @@@ The index of item added to the array is 
            Assert.IsTrue(new_arrListIndexOfX == new_arrListLastIndexOfX && new_arrListCount == (new_arrListIndexOfX + 1));

            // @@@ Item should be present in the array
            Assert.IsTrue(new_arrListContainsX); 
        }

        [Test]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int old_arrListCount = arrList.Count;
            int old_x = x;
            int old_arrListIndexOfX = arrList.IndexOf(x);
            int old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool old_arrListContainsX = arrList.Contains(x);

            arrList.Remove(x);

            int new_arrListCount = arrList.Count;
            int new_arrListIndexOfX = arrList.IndexOf(x);
            int new_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool new_arrListContainsX = arrList.Contains(x);

            // @@@ The count of the arraylist decreases by 1 on calling Remove method
            Assert.AreEqual(old_arrListCount-1, new_arrListCount);

            // @@@ If the item was present in the list, index of and last index should be updated
            if (!old_arrListContainsX)
            {
                // @@@ If the item is not present in the list, index of the item and last index should be -1
                Assert.AreEqual(-1, new_arrListIndexOfX);
                Assert.AreEqual(-1, new_arrListLastIndexOfX);
            }
            else
            {
                Assert.IsTrue(new_arrListIndexOfX != old_arrListIndexOfX || new_arrListLastIndexOfX != old_arrListLastIndexOfX);
            }

            // @@@ the item should not be present in the array after removal
            Assert.IsFalse(new_arrListContainsX); 
        }

