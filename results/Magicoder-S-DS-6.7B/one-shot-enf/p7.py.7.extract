import numpy as np

num = np.random.random((10, 10))
evalue, evector = np.linalg.eig(num)
lambda0 = evalue[0]
vec = evector[:, 0]
lambdavec = num @ vec
print(evalue, evector)

assert np.__version__ > '1.1'
