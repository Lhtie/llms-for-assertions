import numpy as np

# numpy version is greater than 2

assert int(np.__version__.split('.')[0]) > 2

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda_ = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)
--------------------
assert np.__version__ > '2'
--------------------
assert np.__version__ > '2' # check numpy version is above 2

assert all(evalues > 0) # all eigenvalues should be greater than zero

assert vec.ndim == 2 # eigenvectors is a matrix
