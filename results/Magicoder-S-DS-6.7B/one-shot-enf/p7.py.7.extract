# numpy version is greater than 2
import numpy as np 
assert np.version.version[0] > 2

# The eigenvectors and eigenvalues are expected to be real numbers 
assert np.allclose(evalues, evalues.real)
assert np.allclose(evectors, evectors.real)
--------------------
import numpy as np

# numpy version is greater than 2
assert np.__version__ > "2.0.0"

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda_ = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)

assert np.allclose(lambdavec, mtx @ vec)  # eigenvectors of matrix
--------------------
assert np.__version__ >= "2.0.0"
