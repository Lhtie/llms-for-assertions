import numpy as np

numpy_version = np.version.version

assert numpy_version > '1.1'

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)
