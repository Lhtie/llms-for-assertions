import numpy as np

assert int(str(np.__version__).split('.')[0]) > 1

mtx = np.random.random((10, 10))

evalues, evectors = np.linalg.eig(mtx)

lambda0 = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)

