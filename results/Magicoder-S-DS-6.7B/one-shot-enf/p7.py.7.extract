
assert np.__version__ > '2', 'numpy version is greater than 2'
--------------------
import numpy as np

# numpy version is greater than 2
assert float(np.__version__) > 2.0

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]

# The largest eigenvalue should be strictly greater than 0
assert lambda > 0

vec = evectors[:, 0]

lambdavec = mtx @ vec

# The lambda vec should be near zero
assert np.allclose(lambdavec, 0.0)

print(evalues, evectors)
--------------------
import numpy as np

# numpy version is greater than 2
assert int(np.version.split('.')[1]) > 2

mtx = np.random.random((10,10))

evalues, evectors = np.linalg.eig(mtx)

lambda = evalues[0]
vec = evectors[:, 0]

lambdavec = mtx @ vec

print(evalues, evectors)

assert np.allclose(evalues[0], np.all(evalues),atol=1e-8)
assert np.allclose(lambdavec - mtx @ vec, np.zeros((10,10)),atol=1e-8)
assert np.allclose(evalues, evalues[::-1],atol=1e-8)
assert np.allclose(vec, vec[::-1],atol=1e-8)
assert np.allclose(mtx @ vec, eigenvec, atol=1e-8)
assert np.allclose(vec / np.linalg.norm(vec), np.ones((10,)), atol=1e-8)
assert np.allclose(eigenvec / np.linalg.norm(eigenvec), np.ones((10,)), atol=1e-8)
