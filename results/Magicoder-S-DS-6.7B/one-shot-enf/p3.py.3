# for Shape class
class Shape:
    def __init__(self, typ):
        self.typ = typ
        self.area = -1
        self.perimeter = -1

# for Rectangle class
class Rectangle(Shape):
    def __init__(self, l, w):
        assert (l>0 and w>0), "Invalid values passed in"
        super().__init__("Rectangle")
        self.len = l
        self.wid = w
        self.area = l*w
        self.perimeter = 2*(l+w)

    def flipped(self):
        return Rectangle(self.wid, self.len)

# for Circle class
class Circle(Shape):
    def __init__(self, r):
        assert (r>0), "Invalid values passed in"
        super().__init__("Circle")
        self.rad = r
        self.area = PI*r*r
        self.perimeter = 2*PI*r

# for compare_a function
def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    a1, a2 = s1.area, s2.area
    # a1 and a2 holds the correct value of area
    if a1>a2: 
        return a1
    else: 
        return a2
