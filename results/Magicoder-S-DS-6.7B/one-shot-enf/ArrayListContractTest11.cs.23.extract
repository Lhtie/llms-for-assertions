--------------------﻿using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count >= 0);

            Debug.Assert(arrList.Count - arrList.LastIndexOf(x) > 0);
            // @@@ index of x in new array is valid ie >= 0 
        }

        [Test]
        public void PUT_RemoveContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count >= 0);
            Debug.Assert(arrList.Count - arrList.LastIndexOf(x) > 0);
        }

        [Test]
        public void PUT_InsertContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert(index <= arrList.Count && index >= 0);

            Debug.Assert(arrList.Count > 0);
            Debug.Assert(arrList.Count - arrList.LastIndexOf(x) > 0);
        }

        [Test]
        public void PUT_SetContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert(index >= 0 && index < arrList.Count);

            Debug.Assert(arrList.Count > 0);
            Debug.Assert(arrList.Count - arrList.LastIndexOf(x) > 0);
        }

        [Test]
        public void PUT_GetContract(ArrayList arrList, int index)
        {
            Debug.Assert(index < arrList.Count && index >= 0);

            Debug.Assert(index >= 0);
            Debug.Assert(index < arrList.Count);
        }

        [Test]
        public void PUT_ContainsContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count = arrList.LastIndexOf(x) + 1);
        }

        [Test]
        public void PUT_IndexOfContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) <= arrList.Count && arrList.IndexOf(x) >= 0);
        }

        [Test]
        public void PUT_LastIndexOfContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) <= arrList.Count && arrList.LastIndexOf(x) >= 0);
        }

        [Test]
        public void PUT_CountContract(ArrayList arrList)
        {
            Debug.Assert(arrList.Count >=0);
        }
    }
}
