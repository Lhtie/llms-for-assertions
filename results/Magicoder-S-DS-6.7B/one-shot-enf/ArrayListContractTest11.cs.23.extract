[Assertion]: https://docs.microsoft.com/en-us/visualstudio/debugger/assertion-functions?view=vs-2019

[PexAssert]: https://regextudelft.nl/pex/api/Assertions

[Should]: https://fluentassertions.com/

public static int Sum(int x, int y)
{
    sum = x + y;
    
    [Assertion]("sum is greater than or equal to x and y", sum >= x && sum >= y);  
    
    return sum;
}
