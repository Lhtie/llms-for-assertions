// @@@ the index where x is being inserted is less than or equal to last index of x in new array 
Assert.IsTrue(New_arrListIndexOfX <= New_arrListLastIndexOfX);
--------------------
﻿using System.Diagnostics;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Add(x) < arrList.Count);
            Debug.Assert(arrList.Contains(x));
            Debug.Assert(arrList.IndexOf(x) <= arrList.LastIndexOf(x));
        }

        [PexMethod]
        public void PUT_RemoveContract(ArrayList arrList, int x)
        {
            // @@@
            // The code below is assuming that the remove() method of ArrayList class will only remove the first occurrence of the element from the list.
            int index = arrList.IndexOf(x);
            arrList.RemoveAt(index);
            Debug.Assert(!arrList.Contains(x));
            // The lastIndexOf method of ArrayList class returns the last occurring index, not the first occurring one.
            // So, it doesn't affect this code.
            Debug.Assert((index < 0) || (index >= arrList.Count));

        }

        [PexMethod]
        public void PUT_InsertContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert(index >= 0 && index <= arrList.Count);
            arrList.Insert(index, x);
            Debug.Assert(arrList.Contains(x));
            Debug.Assert(arrList.LastIndexOf(x) >= index);
        }

        [PexMethod]
        public void PUT_SetContract(ArrayList arrList, int x, int index)
        {
            Debug.Assert(index >= 0 && index < arrList.Count);
            arrList[index] = x; 
            Debug.Assert(arrList.IndexOf(x) >= index);
        }

        [PexMethod]
        public void PUT_GetContract(ArrayList arrList, int index)
        {
            Debug.Assert(index >= 0 && index < arrList.Count);
        }

        [PexMethod]
        public void PUT_ContainsContract(ArrayList arrList, int x)
        {
			Debug.Assert(arrList.Contains(x) == (arrList.IndexOf(x) >= 0));
        }

        [PexMethod]
        public void PUT_IndexOfContract(ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) == (arrList.Contains(x)? arrList.IndexOf(x): -1));
        }

        [PexMethod]
        public void PUT_LastIndexOfContract(ArrayList arrList, int x)
        {
			Debug.Assert(arrList.LastIndexOf(x) == (arrList.Contains(x)? arrList.LastIndexOf(x): -1));
        }

        [PexMethod]
        public void PUT_CountContract(ArrayList arrList)
        {
            // @@@
            // count property of ArrayList is not observable directly, it provides a way to determine the number of elements actually in the ArrayList
        }
    }
}
