using System;
using System.Collections.Generic;

public class Example
{
    public void Test1()
    {
        List<int> numbers = new List<int>() { 5, 4, 1, 3, 9, 8, 6, 7, 2, 0 };
        numbers.Sort();

        // @@@ the first number of the sorted list is 0
    }
  
   public void Test2()
    {
        List<int> numbers = new List<int>() { 5, 4, 1, 3, 9, 8, 6, 7, 2, 0 };
        numbers.Sort((x, y) => {
          // @@@ this if statement is always true
          if (x == y) 
          {
              return 0;
          } 
          else if (x < y) 
          {
              return -1;
          } 
          else 
          {
              return 1;
          }
        });
    }
}

