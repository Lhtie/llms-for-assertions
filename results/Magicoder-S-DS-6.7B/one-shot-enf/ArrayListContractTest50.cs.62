using System.Diagnostics;

namespace ArrayList.Test
{
    partial class ArrayListContractTest
    {
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count == Old_arrListCount + 1 && New_arrListCount == Old_arrListCount + 1);
            // @@@ Check that the count of new list is one more than the old list
            Debug.Assert(arrList.IndexOf(x) >= Old_arrListIndexOfX && arrList.IndexOf(x) >= New_arrListIndexOfX && arrList.LastIndexOf(x) >= New_arrListLastIndexOfX);
            // @@@ Check that the new index of x is not lower than the old index
            Debug.Assert(New_arrListContainsX && Old_arrListContainsX);
            // @@@ Check that the new list contains x and the old list
        }
        
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count == Old_arrListCount - 1 && New_arrListCount == Old_arrListCount - 1);
            // @@@ Check the count is one less in new list than old list
            Debug.Assert(arrList.IndexOf(x) >= Old_arrListIndexOfX && arrList.IndexOf(x) >= New_arrListIndexOfX && arrList.LastIndexOf(x) >= New_arrListLastIndexOfX);
            // @@@ Check the new indexes of x are not lower than the old indexes
            Debug.Assert(New_arrListContainsX && !Old_arrListContainsX);
            // @@@ Check if new list contains x and if old list does not
        }
        
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            if (Old_index == arrList.Count)
            {
                Debug.Assert(arrList.Count == Old_arrListCount + 1 && New_arrListCount == Old_arrListCount + 1);
                // @@@ Check count if index is equal to the count meaning we added it at the end
                Debug.Assert(arrList.IndexOf(x) == index && arrList.LastIndexOf(x) == index);
                // @@@ Check if indexes are as expected 
                Debug.Assert(New_arrListContainsX && Old_arrListContainsX);
                // @@@ Check if new list contains x and if old list does
            }
            else
            {
                Debug.Assert(arrList.Count == Old_arrListCount && New_arrListCount == Old_arrListCount);
                // @@@ Check count is not changing if index is not the last one 
                Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX && New_arrListLastIndexOfX == Old_arrListLastIndexOfX);
                // @@@ Check if indexes are as expected
                Debug.Assert(New_arrListContainsX && Old_arrListContainsX);
                // @@@ Check if new list contains x and if old list contains x
            }
        }
        
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(New_arrListIndexOfX == index && New_arrListLastIndexOfX == index && Old_arrListIndexOfX == index && Old_arrListLastIndexOfX == index);
            // @@@ Check if indexes of x in new array is the same as in old array and in both cases, it is the same index we set x at
            Debug.Assert(New_arrListContainsX && Old_arrListContainsX);
            // @@@ Check if new list contains x and old list contains x
        }

        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(New_arrListIndexOfX == index);
            // @@@ Check if the new index of Get's value is exactly the same as the index in new list
            Debug.Assert(!New_containsNewRet);
            // @@@ Check if new list contains the value of Get
        }

