def test_transfer():
    person1 = Person('John')
    person2 = Person('James')

    assert all(acnt.money != 0 for acnt in person1.accounts)
    assert all(acnt.money != 0 for acnt in person2.accounts)

    # Trying to transfer more than possible
    assert transfer(person1, person2, 101) == False
    
    # Trying to transfer a positive amount
    assert transfer(person1, person2, 100) == True

    assert all(acnt.money == 0 for acnt in person1.accounts)
    assert all(acnt.money == 100 for acnt in person2.accounts)

    # After transferring 100, trying another transfer, which is now impossible
    assert transfer(person2, person1, 100) == False
--------------------
class Account:
    def __init__(self, money):
        self.money = money
        # account balance should always be positive or zero
        assert money >= 0

class Person:
    def __init__(self, name):
        self.name = name
        #  person must have at least one account
        assert len(self.accounts) >= 1

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    assert amnt <=100 and amnt > 0
    # at least one account in 'frm' should have enough balance
    assert amnt <= frm.accounts[0].money
--------------------assert amnt < 100 and amnt > 0--------------------
    assert amnt <= 100 and amnt > 0
