
            Debug.Assert((New_arrListCount - Old_arrListCount) <= New_arrListCount);
            Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);
            Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
            Debug.Assert(Old_arrListContainsX == New_arrListContainsX);
            Debug.Assert(New_arrListCount >= Old_arrListCount);
            Debug.Assert(New_Ret == Old_arrListCount);
            Debug.Assert(New_ret == Old_index);
            Debug.Assert(New_containsNewRet == Old_arrListContainsX);
            Debug.Assert(New_Ret == Old_arrListCount);
