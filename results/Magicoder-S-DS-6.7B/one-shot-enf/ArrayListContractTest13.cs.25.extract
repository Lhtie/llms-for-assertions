    Assert.AreEqual(New_arrListCount - 1, Old_arrListCount);
    Assert.IsTrue(Old_arrListContainsX);
    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    Assert.IsTrue(New_arrListContainsX);
    Assert.AreEqual(New_arrListIndexOfX, New_arrListLastIndexOfX);
    Assert.AreEqual(New_arrListLastIndexOfX, -1 ? New_arrListIndexOfX < 0 : New_arrListIndexOfX);
    Assert.AreEqual(New_arrListCount, New_Ret);
