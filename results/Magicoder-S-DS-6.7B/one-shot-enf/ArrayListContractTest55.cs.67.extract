    [Test]
    public void TestAdd()
    {
        int Old_arrList_Count = arrList.Count;
        int New_arrList_Count = arrList.Add(x);
        Assert.IsTrue(New_arrList_Count >= Old_arrList_Count);
    }

    [Test]
    public void TestRemove()
    {
        int Old_arrList_Count = arrList.Count;
        arrList.Remove(x);
        int New_arrList_Count = arrList.Count;
        Assert.IsTrue(New_arrList_Count <= Old_arrList_Count);
    }

    [Test]
    public void TestInsert()
    {
        Assume.True(index <= arrList.Count && index >= 0);
        int Old_arrList_Count = arrList.Count;
        arrList.Insert(index, x);
        int New_arrList_Count = arrList.Count;
        Assert.IsTrue(New_arrList_Count >= Old_arrList_Count);
    }

    [Test]
    public void TestSet()
    {
        Assume.True(index >= 0 && index < arrList.Count);
        arrList[index] = x;
        int New_arrList_IndexOf_x = arrList.IndexOf(x);
        Assert.IsTrue(New_arrList_IndexOf_x > index);
    }

    [Test]
    public void TestGet()
    {
        Assume.True(index < arrList.Count && index >= 0);
        int New_ret = arrList[index];
        Assert.IsNotNull(New_ret);
    }

    [Test]
    public void TestContains()
    {
        bool New_ret = arrList.Contains(x);
        Assert.IsTrue(New_ret);
    }

    [Test]
    public void TestIndexOf()
    {
        bool New_ret = arrList.IndexOf(x);
        Assert.IsTrue(New_ret >= 0);
    }

    [Test]
    public void TestLastIndexOf()
    {
        bool New_ret = arrList.LastIndexOf(x);
        Assert.IsTrue(New_ret >= 0);
    }

    [Test]
    public void TestCount()
    {
        int New_ret = arrList.Count;
        Assert.IsTrue(New_ret >= 0);
    }
