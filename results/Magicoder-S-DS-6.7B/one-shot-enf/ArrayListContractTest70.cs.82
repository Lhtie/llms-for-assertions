using System.Diagnostics;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            // @@@ Before: assert that the count changes when an item is added to the arraylist
            Debug.Assert((arrList.Count + 1) == arrList.Add(x));
            // @@@ After: assert that the index of added item is correctly tracked
            Debug.Assert(arrList.IndexOf(x) == x);
            // @@@ After: assert that the last index of added item is correctly tracked
            Debug.Assert(arrList.LastIndexOf(x) == x);

        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            // @@@ If the item is removed, the arraylist count decreases
            arrList.Remove(x);
            Debug.Assert(arrList.Count == (arrList.Count + 1));
            // @@@ The count should decrement and index of x should be -1 after removing
            Debug.Assert((arrList.Count == arrList.Count + 1) && arrList.IndexOf(x) == -1);

        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            // @@@ If the item is inserted, the arraylist count increases
            arrList.Insert(index, x);
            Debug.Assert((arrList.Count - 1) == arrList.Insert(index, x));
            // @@@ After: assert that the index of inserted item is correctly tracked
            Debug.Assert(arrList.IndexOf(x) == x);
            // @@@ After: assert that the last index of inserted item is correctly tracked
            Debug.Assert(arrList.LastIndexOf(x) == x);

        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            // @@@ Before: assert that the count remains same when an item at given index is set
            arrList[index] = x;
            Debug.Assert(arrList.Count == arrList[index] = x);
		    // @@@ After: assert that the index of inserted item is correctly tracked
            Debug.Assert(arrList.IndexOf(x) == x);
		    // @@@ After: assert that the last index of inserted item is correctly tracked
            Debug.Assert(arrList.LastIndexOf(x) == x);

        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            // @@@ Before: assert that the count remains same when an item at given index is retrieved
            arrList[index];
            Debug.Assert(arrList.Count == arrList[index]);

        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            // @@@ After: assert that the 'contains' and 'index of' methods return the expected values for present item
            Debug.Assert(arrList.Contains(x) == (arrList.IndexOf(x) != -1));

        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            // @@@ If return value of indexOf is negative, assert that lastIndex of x in old arraylist is -1
            Debug.Assert((arrList.IndexOf(x) == arrList.IndexOf(arrList.LastIndex--------------------
