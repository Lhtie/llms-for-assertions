    namespace ArrayList.Test
    {
        [TestFixture, PexClass]
        public partial class ArrayListContractTest
        {
            [PexMethod]
            public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
            {
                Debug.Assert(arrList.Count == arrList.Count - 1);
                Debug.Assert(arrList.Contains(x));
                int index = arrList.IndexOf(x);
                Debug.Assert(index != -1);
                Debug.Assert(arrList.LastIndexOf(x) != index || arrList.IndexOf(x) == index);
            }

            [PexMethod]
            public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
            {
                Debug.Assert(arrList.Count == arrList.Count + 1);
                Debug.Assert(!arrList.Contains(x));
                int index = arrList.IndexOf(x);
                Debug.Assert(index == -1);
                Debug.Assert(arrList.LastIndexOf(x) != index || arrList.IndexOf(x) == index);
            }

            [PexMethod]
            public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
            {
                Debug.Assert(index <= arrList.Count + 1 && index >= 0);
                Debug.Assert(arrList.Contains(x));
                Debug.Assert(arrList.IndexOf(x) != -1);
                Debug.Assert(arrList.LastIndexOf(x) < arrList.Count);
            }

            [PexMethod]
            public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
            {
                Debug.Assert(index >= 0 && index < arrList.Count);
                Debug.Assert(arrList.Contains(x));
                Debug.Assert(arrList.IndexOf(x) == index || arrList.IndexOf(x) != -1);
                Debug.Assert(arrList.LastIndexOf(x) < arrList.Count);
            }

            [PexMethod]
            public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
            {
                Debug.Assert(index < arrList.Count && index >= 0);
                Debug.Assert(arrList.Count == arrList.Count);
            }

            [PexMethod]
            public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
            {
                Debug.Assert(arrList.Contains(x) == arrList.Contains(x));
                Debug.Assert(arrList.IndexOf(x) == arrList.IndexOf(x) || arrList.IndexOf(x) != -1);
            }

            [PexMethod]
            public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
            {
                Debug.Assert(arrList.IndexOf(x) == arrList.IndexOf(x));
                Debug.Assert(arrList.LastIndexOf(x) != arrList.IndexOf(x) || arrList.IndexOf(x) != arrList.Count);
            }

            [PexMethod]
            public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
            {
                Debug.Assert(arrList.LastIndexOf(x) == arrList.LastIndexOf(x));
                Debug.Assert(arrList.IndexOf(x) != arrList.LastIndexOf(x) || arrList.IndexOf(x) != -1);
            }

            [PexMethod]
            public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
            {
                Debug.Assert(arrList.Count == arrList.Count);
            }
        }
    }
