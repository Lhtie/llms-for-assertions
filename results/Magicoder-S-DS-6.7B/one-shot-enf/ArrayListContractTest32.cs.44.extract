using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count >= Old_arrListCount - 1);
            Debug.Assert(New_Ret == Old_arrListCount); // @@@ return value from adding x 
            Debug.Assert(arrList.Contains(x));  // @@@ contains x in array after adding 
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count == Old_arrListCount - 1); // @@@ count of array after removing x
            Debug.Assert(!arrList.Contains(x));  // @@@ x is not in the array after removing x
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList.Count == Old_arrListCount + 1);  // @@@ count of array after inserting x
            Debug.Assert(arrList.Contains(x));    // @@@ x is in array after inserting x
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList.Count == Old_arrListCount);  // @@@ count remains same after setting x
            Debug.Assert(arrList.Contains(Old_x));   // @@@ old x is still in array
            Debug.Assert(arrList.Contains(x));     // @@@ new x is also in array
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(New_Ret == Old_index);     // @@@ return value equal to old index
            Debug.Assert(arrList.Contains(New_Ret)); // @@@ array after getting x, contains x 
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(New_Ret == Old_arrListContainsX); // @@@ return value equal to Old_arrListContainsX
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(New_Ret == Old_arrListIndexOfX || New_Ret == Old_arrListIndexOfX + 1);  // @@@ return value is equal to or one more than Old_arrListIndexOfX 
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(New_Ret == Old_arrListLastIndexOfX || New_Ret == Old_arrListLastIndexOfX + 1); // @@@ return value is equal to or one more than Old_arrListLastIndexOfX 
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            Debug.Assert(New_Ret == Old_arrListCount); // @@@ return value equal to Old_arrListCount
        }
    }
}
