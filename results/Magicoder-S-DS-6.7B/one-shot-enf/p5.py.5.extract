class Rectangle():
    def __init__(self, n, m):
        self.exp = n # this is how wide
        self.mat = n+m+2
        self.lin = m # this is how tall
        
def func(n, m):
    r = Rectangle(n, m)
    assert r.lin > 0 # height of r is positive
    return r
