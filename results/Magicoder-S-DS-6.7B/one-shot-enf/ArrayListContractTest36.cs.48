using Microsoft.VisualStudio.TestTools.UnitTesting;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
        [TestMethod]
        public void PUT_AddContract()
        {
            var arrList = new ArrayList.ArrayList();
            int x = 1;
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);
            
            Assert.IsNotNull(arrList);
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            Assert.AreEqual(Old_x, x);
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
            Assert.AreEqual(New_Ret, x);
            Assert.IsTrue(Old_arrListCount < New_arrListCount);
            Assert.AreEqual(Old_x, New_Ret);
            Assert.IsTrue(New_arrListIndexOfX >= 0);
            Assert.AreEqual(Old_x, x);
            Assert.IsTrue(Old_arrListCount <= New_arrListCount);
            Assert.IsTrue(New_arrListContainsX);
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX + 1);
        }

        [TestMethod]
        public void PUT_RemoveContract()
        {
            var arrList = new ArrayList.ArrayList();
            int x = 1;
            arrList.Add(x);
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);
            
            arrList.Remove(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.IsNotNull(arrList);
            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
            Assert.AreEqual(Old_x, x);
            Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            Assert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            Assert.AreNotEqual(Old_arrListContainsX, New_arrListContainsX);
            // @@@ last index of x in new array is not same as old array count – 1 
        }

