<code>```cs public static void InsertContract()
{
    ArrayList arrList = new ArrayList();
    arrList.Add(5);
    arrList.Add(6);
    arrList.Add(7);

    int Old_arrListCount = arrList.Count;
    int Old_x = 8;
    int Old_index = 1;
    int Old_arrListIndexOfX = arrList.IndexOf(Old_x);
    int Old_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);
    bool Old_arrListContainsX = arrList.Contains(Old_x);

    arrList.Insert(Old_index, Old_x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(Old_x);
    int New_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);
    bool New_arrListContainsX = arrList.Contains(Old_x);

    Debug.Assert(New_arrListCount == Old_arrListCount + 1 && New_arrListIndexOfX >= Old_arrListIndexOfX && New_arrListLastIndexOfX >= Old_arrListLastIndexOfX && New_arrListContainsX == Old_arrListContainsX);
}
