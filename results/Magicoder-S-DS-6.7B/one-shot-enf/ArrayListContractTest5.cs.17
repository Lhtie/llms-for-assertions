using NUnit.Framework;
using System.Text;

[TestFixture]
public class Task2Tests
{
	[PexMethod]
	public void AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
	{
		int New_Ret = arrList.Add(x);
		Assert.GreaterOrEqual(New_Ret, arrList.Count);
	}

	[PexMethod]
	public void RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
	{
		arrList.Remove(x);
		Assert.Null(arrList.IndexOf(x));
	}

	[PexMethod]
	public void GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
	{
		int New_Ret = arrList[index];
		Assert.GreaterOrEqual(New_Ret, index);
	}

	// ... similar methods that follow the same structure as 'AddContract' and 'RemoveContract' ...
}
</code>
You can then add similar methods for the other PexMethods. The general approach remains: you will iterate through all your methods, take the "PUT_" (Put under Test) ones and create new methods in "Task2Tests" with similar logic but the following assertions:

Assert.GreaterOrEqual(New_Ret, index, "message explaining the condition");
or 
Assert.Null(arrList.IndexOf(x), "message explaining the condition");
Remember to replace "New_Ret", "index", "x", and the message explaining the conditions with the appropriate variables and their relevant values based on the particular PexMethod being under test.--------------------