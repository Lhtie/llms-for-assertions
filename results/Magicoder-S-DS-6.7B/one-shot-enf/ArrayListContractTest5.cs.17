namespace ArrayList.Test
{
    using Microsoft.VisualStudio.TestTools.UnitTesting;

    [TestClass, PexClass]
    public class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int oldCount = arrList.Count;
            arrList.Add(x);
            int newCount = arrList.Count;

            Assert.IsTrue(newCount >= oldCount + 1);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            arrList.Remove(x);
            Assert.IsFalse(arrList.Contains(x));
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            int oldCount = arrList.Count;
            arrList.Insert(index, x);
            int newCount = arrList.Count;

            Assert.IsTrue(newCount >= oldCount + 1);
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            arrList[index] = x;

            Assert.AreEqual(x, arrList[index]);
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            var ret = (int)arrList[index];
            Assert.IsTrue(arrList.Contains(ret));
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            bool ret = arrList.Contains(x);
            if(arrList.Contains(x))
                Assert.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x));
            // Commented because it assumes that Contain(object) call in ArrayList class
            // if not found will return -1 and 
            // LastIndexOf(object) returns -1 if object is not found.
            // but asserting it might give unexpected result in some cases.
            
            //var firstIndex = arrList.IndexOf(x);
            //var secondIndex = arrList.LastIndexOf(x);
            //Assert.IsTrue(firstIndex == secondIndex);
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            var firstIndex = arrList.IndexOf(x);
            Assert.AreEqual(arrList.LastIndexOf(x), firstIndex);
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            var firstIndex = arrList.IndexOf(x);
            Assert.AreEqual(arrList.LastIndexOf(x), firstIndex);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            var newCount = arrList.Count;
            Assert.IsTrue(newCount >= 0);
        }
    }
}
