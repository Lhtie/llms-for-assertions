using System;
using System.Diagnostics;

namespace ArrayList {
    public class ArrayList {
        int[] List = new int[100];
        int Count = 0;

        // Adds an item to the ArrayList, maintaining the order of elements.
        public int Add(int x) {
            Debug.Assert(Count == 0 || List[Count-1] <= x, "Add: x is greater than the previous element");
            List[Count] = x;
            Count++;
            return Count;
        }

        // Removes the first occurrence of the specified item from the ArrayList if it contains x.
        public void Remove(int x) {
            for (int i = 0; i < Count; i++) {
                if (List[i] == x) {
                    Debug.Assert(IndexOf(List[i]) == i, "Remove: The removed item is not the first occurrence");
                    List[i] = List[Count-1];
                    List[Count-1] = 0;
                    Count--;
                    return;
                }
            }
        }

        // Inserts an item to the ArrayList at the specified index, shifting the remaining items to the right.
        public void Insert(int index, int x) {
            Debug.Assert(index <= Count && index >= 0, "Insert: Index out of bounds");
            Debug.Assert(LastIndexOf(x) < index, "Insert: The last position of x in old and new lists are different");
            for (int i = Count; i > index; i--) {
                List[i] = List[i-1];
            }
            List[index] = x;
            Count++;
        }

        // Sets the item at the specified index to the specified value.
        public void Set(int index, int x) {
            Debug.Assert(index >= 0 && index < Count, "Set: Index out of bounds");
            Debug.Assert(List[index] == x || IndexOf(List[index]) == index, "Set: The item at the specified index is not the first occurrence");
            List[index] = x;
        }

        // Gets the item at the specified index.
        public int Get(int index) {
            Debug.Assert(index < Count && index >= 0, "Get: Index out of bounds");
            return List[index];
        }

        // Returns true if the ArrayList contains x, false otherwise.
        public bool Contains(int x) {
            for (int i = 0; i < Count; i++) {
                if (List[i] == x) {
                    return true;
                }
            }
            return false;
        }

        // Returns the index of the first occurrence of x in the ArrayList, or -1 if the ArrayList does not contain x.
        public int IndexOf(int x) {
            for (int i = 0; i < Count; i++) {
                if (List[i] == x) {
                    return i;
                }
            }
            return -1;
        }

        // Returns the index of the last occurrence of x in the ArrayList, or -1 if the ArrayList does not contain x.
        public int LastIndexOf(int x) {
            for (int i = Count-1; i >= 0; i--) {
                if (List[i] == x) {
                    return i;
                }
            }
            return -1;
        }

        // Returns the number of elements in the ArrayList.
        public int Count() {
            return Count;
        }

    }
}
