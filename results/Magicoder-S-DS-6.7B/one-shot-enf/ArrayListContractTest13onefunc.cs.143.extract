
Debug.Assert(New_arrListCount <= Old_arrListCount);

// @@@ Removing same value from the list twice must not increase its size 
Debug.Assert(New_arrListCount <= Old_arrListCount);

// @@@ new array list must have the same size as old array list before and after remove if x was present in the old list 
Debug.Assert((Old_arrListContainsX) => (New_arrListCount == Old_arrListCount));

// @@@ If x was not in the old list, then the sizes must be the same after remove 
Debug.Assert(!(Old_arrListContainsX) => (New_arrListCount == Old_arrListCount));

// @@@ new index of x should be equal to old index of x after remove 
Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);

// @@@ new last index of x should be equal to old last index of x after remove 
Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);

// @@@ before and after remove of x check if x is present in new list or not 
Debug.Assert(New_arrListContainsX == Old_arrListContainsX);

Debug.Assert(New_arrListContainsX == Old_arrListContainsX);
--------------------
        Debug.Assert(New_arrListCount <= Old_arrListCount, "new array list has size at most as much as old array list");
--------------------Debug.Assert(New_arrListCount <= Old_arrListCount);
			Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX || New_arrListIndexOfX == Old_arrListLastIndexOfX || New_arrListIndexOfX <0);
			Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX || New_arrListLastIndexOfX == Old_arrListIndexOfX || New_arrListLastIndexOfX < 0);
			Debug.Assert(New_arrListContainsX == Old_arrListContainsX);

