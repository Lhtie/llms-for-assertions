
Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret} {Old_arrListContainsX} {New_arrListContainsX}");
Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret} {Old_arrListContainsX} {New_arrListContainsX}");
Assert.IsTrue(New_ContainsNewRet, $"{Old_arrListCount} {New_arrListCount} {Old_index} {New_Ret}");
Assert.IsTrue(New_Ret >= Old_arrListIndexOfX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.IsTrue(New_Ret >= Old_arrListLastIndexOfX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.IsTrue(Old_arrListContainsX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.IsTrue(New_arrListContainsX, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.AreEqual(Old_arrListCount, New_arrListCount, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.AreEqual(New_Ret, Old_x, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
Assert.AreEqual(Old_index, index, $"{Old_arrListCount} {New_arrListCount} {Old_x} {Old_arrListIndexOfX} {New_arrListIndexOfX} {Old_arrListLastIndexOfX} {New_arrListLastIndexOfX} {New_Ret}");
----------------------------------------
Debug.Assert((New_arrListIndexOf_x >= Old_arrListIndexOf_x) && (New_arrListCount == Old_arrListCount + 1) && (New_arrListContains_x == true) && (New_arrListLastIndexOf_x >= Old_arrListLastIndexOf_x));
