Here is the Python script that you need to generate assertions from the csharp code comments:

```python
import re

def extract_code(filename):
    code = ""
    with open(filename, 'r') as file:
        for line in file:
            if line.startswith("// @@@"):
                code += f"Debug.Assert({line[6:-1]});\n"
    return code

filename = 'YourPath/CodeFile.cs' 
code = extract_code(filename)
print(code)
```

Replace 'YourPath/CodeFile.cs' with the path to your csharp file.--------------------
using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract(ArrayList arrList, int x)
        {
            // Given:
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            // When:
            int New_Ret = arrList.Add(x);

            // Then:
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount); // @@@ new count is one more than old count
            Assert.AreEqual(Old_x, x); // @@@ the value being added is the same as the previous value
            Assert.IsTrue(Old_arrListIndexOfX == New_arrListIndexOfX, "arrList contains old x at same location"); // @@@ The index of x in arrList has not changed
            Assert.IsTrue(Old_arrListLastIndexOfX == New_arrListLastIndexOfX, "arrList contains old x at same last location"); // @@@ The last index of x in arrList has not changed
            Assert.IsTrue(Old_arrListContainsX == New_arrListContainsX, "arrList contains old x as same"); // @@@ arrList now contains old x
            Assert.IsTrue(arrList.Contains(x)); // @@@ arrList now contains x
        }

        [Test]
        public void PUT_RemoveContract(ArrayList arrList, int x)
        {
            // Given:
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            // When:
            arrList.Remove(x);

            // Then:
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount, "new count decreased by one"); // @@@ new count decreased by one
            Assert.IsFalse(arrList.Contains(x), "arrList does not contain the removed value"); // @@@ arrList does not contain x
            Assert.IsTrue(Old_arrListIndexOfX < New_arrListIndexOfX, "arrList contains x at higher location"); // @@@ The index of x in arrList has increased
            Assert.IsTrue(Old_arrListLastIndexOfX < New_arrListLastIndexOfX, "arrList contains x at higher last location"); // @@@ The last index of x in arrList has increased
            Assert.IsTrue(Old_arrListContainsX == New_arrListContainsX, "arrList contains old x as same"); // @@@ arrList still contains old x
        }

