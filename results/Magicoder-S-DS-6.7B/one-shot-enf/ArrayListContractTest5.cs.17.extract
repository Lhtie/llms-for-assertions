using NUnit.Framework;
using System.Text;

[TestFixture]
public class Task2Tests
{
	[PexMethod]
	public void AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
	{
		int New_Ret = arrList.Add(x);
		Assert.GreaterOrEqual(New_Ret, arrList.Count);
	}

	[PexMethod]
	public void RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
	{
		arrList.Remove(x);
		Assert.Null(arrList.IndexOf(x));
	}

	[PexMethod]
	public void GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
	{
		int New_Ret = arrList[index];
		Assert.GreaterOrEqual(New_Ret, index);
	}

	// ... similar methods that follow the same structure as 'AddContract' and 'RemoveContract' ...
}
