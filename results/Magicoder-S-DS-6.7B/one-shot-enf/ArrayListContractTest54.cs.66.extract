                Debug.Assert(New_ret >= Old_arrListLastIndexOfX, "If return value is True, New list's last index of x is >= old list's last index of x");
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(New_Ret >= 0, "Index cannot be negative");
        }

