And then your unit tests with asserts:

```cs
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test] private void PUT_ContainsContract()
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = ?;
            int Old_x = ?;
            int Old_arrListLastIndexOfX = ?;
            bool Old_arrListContainsX = ?;

            bool New_Ret = arrList.Contains(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            NUnit.Framework.Assert.IsTrue(Old_arrListCount == -1 ? New_arrListCount == -1 : Old_arrListCount == New_arrListCount);
            NUnit.Framework.Assert.AreEqual(Old_x,x);
            NUnit.Framework.Assert.AreEqual(Old_arrListLastIndexOfX,New_arrListLastIndexOfX);
            NUnit.Framework.Assert.AreEqual(Old_arrListContainsX,New_arrListContainsX);
            NUnit.Framework.Assert.AreEqual(New_Ret,arrList.Contains(x));
            
        }
        
        // Same for other test methods
    }
}
```
For each test method in the unit test class, you will need to replace the two ?s with the exact value expressions that would correspond to the variables initialized before the call to the PUT contract under test. The Assert.IsTrue(expression) checks if the condition is true, and if not, it throws an exception that will halt the test execution. The Assert.AreEqual(expected, actual) checks if the actual and expected values are equal, but if they are not, it will display an error message with the expected and actual values.--------------------

