using System;
using System.Diagnostics;

public class ArrayList
{
    private int[] arrayList;
    private int size;

    public int Count { get { return size;} }
    public int this[int index] { get { return arrayList[index]; } set { arrayList[index] = value; } }

    public int Add(int item)
    {
        Debug.Assert(arrayList.Length != size);
        if (size < arrayList.Length)
        {
            arrayList[size] = item;
            ++size;
        }
        return size;
    }

    public void RemoveAt(int index)
    {
        Debug.Assert(index >= 0 && index < size);
        for (int i = index; i < size - 1; i++)
        {
            arrayList[i] = arrayList[i + 1];
        }
        --size;
    }

    public void Insert(int index, int item)
    {
        Debug.Assert(index <= size && index >= 0);
        if (size < arrayList.Length)
        {
            for (int i = size; i > index; i--)
            {
                arrayList[i] = arrayList[i - 1];
            }
            arrayList[index] = item;
            ++size;
        }
    }

    public bool Contains(int item)
    {
        bool isFound = false;
        foreach (int i in arrayList)
        {
            if (i == item)
            {
                isFound = true;
                break;
            }
        }
        Debug.Assert(size >= 0);
        return isFound;
    }

    public int IndexOf(int item)
    {
        int index = -1;
        for (int i = 0; i < size; i++)
        {
            if (arrayList[i] == item)
            {
                index = i;
                break;
            }
        }
        Debug.Assert(index != -1 || arrayList.Length == 0);
        return index;
    }

    public int LastIndexOf(int item)
    {
        int index = -1;
        for (int i = 0; i < size; i++)
        {
            if (arrayList[i] == item)
            {
                index = i;
            }
        }
        Debug.Assert(index != -1);
        return index;
    }
}--------------------
using System;

class Program
{
    public static void Main()
    {
        // Tests to add and check if item exists in array
        TestAddAndContains();
        TestIndexOfAndLastIndexOfAndCount();
    }

    public static void TestAddAndContains()
    {
        ArrayList arrList = new ArrayList();

        int oldArrListCount = arrList.Count;
        int oldX = 1;
        int oldArrListIndexOfX = arrList.IndexOf(oldX);
        int oldArrListLastIndexOfX = arrList.LastIndexOf(oldX);
        bool oldArrListContainsX = arrList.Contains(oldX);

        arrList.Add(oldX);

        int newArrListCount = arrList.Count;
        int newArrListIndexOfX = arrList.IndexOf(oldX);
        int newArrListLastIndexOfX = arrList.LastIndexOf(oldX);
        bool newArrListContainsX = arrList.Contains(oldX);

        // Assert lines
        Debug.Assert(oldArrListCount - 1 == newArrListCount); // @@@ The count should decrease by one, since we delete the only occurrence of an item
        Debug.Assert(newArrListCount == newArrListIndexOfX); // @@@ The Item still exist in the Array
        Debug.Assert(newArrListCount == newArrListLastIndexOfX); // @@@ The Item still exist in the Array
        Debug.Assert(!oldArrListContainsX || newArrListContainsX); // @@@ Items should exist in the Array
    }

    public static void TestIndexOfAndLastIndexOfAndCount()
    {
        ArrayList arrList = new ArrayList();

        int oldArrListCount = arrList.Count;
        int oldArrListLastIndexOfX = arrList.LastIndexOf(1);
        bool oldArrListContainsX = arrList.Contains(1);

        int newArrListLastIndexOfX = arrList.LastIndexOf(1);
        bool newArrListContainsX = arrList.Contains(1);

        // Assert lines
        Debug.Assert(newArrListLastIndexOfX <= oldArrListCount); // @@@ If the return value is non-negative, x is in the old array 
        Debug.Assert(newArrListContainsX == oldArrListContainsX); // @@@ The new array should contain the same amount of the specified item as the old list
    }
}
