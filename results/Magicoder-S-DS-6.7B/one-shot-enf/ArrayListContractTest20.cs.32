    int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    Debug.Assert(Old_arrListCount == New_arrListCount);
    Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX && New_arrListIndexOfX >= 0);
    Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX && New_arrListLastIndexOfX >= 0);
    Debug.Assert(Old_arrListContainsX == true);
    Debug.Assert(New_arrListContainsX == true);
}

