</code>

This is the output corresponding to the assert statement in comment "@@@ index of x in old array is geq minus 1". Here, New_arrListIndexOfX is calculated later on before the Assert statement and the value is used in the assertion condition. Similarly, Old_arrListIndexOfX was calculated before the Remove method call therefore, it holds the correct value. Finally, index of x in old array should be greater or equal to index minus 1.--------------------
using System.Collections;
using System.Diagnostics;
using NUnit.Framework;
using ArrayList;

public class ArrayListContractTest 
{
    [Test]
    public void TestAdd()
    {
        ArrayList arrList = new ArrayList();
        int x = 1;

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        int New_Ret = arrList.Add(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(Old_arrListCount < New_arrListCount);

        Debug.Assert(Old_arrListIndexOfX == -1);
        Debug.Assert(New_arrListIndexOfX == New_arrListCount - 1);

        Debug.Assert(Old_arrListLastIndexOfX == -1);
        Debug.Assert(New_arrListLastIndexOfX == New_arrListCount - 1);

        Debug.Assert(!Old_arrListContainsX);
        Debug.Assert(New_arrListContainsX);
    }

    [Test]
    public void TestRemove()
    {
        ArrayList arrList = new ArrayList();
        int x = 1;

        arrList.Add(x);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(Old_arrListCount > New_arrListCount);

        Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);
        Debug.Assert(Old_arrListIndexOfX == -1);

        Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
        Debug.Assert(Old_arrListLastIndexOfX == -1);

        Debug.Assert(Old_arrListContainsX != New_arrListContainsX);
        Debug.Assert(!New_arrListContainsX);
    }

