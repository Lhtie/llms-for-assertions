            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_arrListIndexOfX == -1 || New_arrListIndexOfX > New_arrListLastIndexOfX);
            // @@@ If arrList.IndexOf(x) != -1, it should be larger than arrList.LastIndexOf(x)

        }

