public static class ArrayListMethods
{
    public static int Add(ArrayList arrList, int x)
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Add(x);

        Debug.Assert((Old_arrListCount == arrList.Count - 1) && (Old_x == x)
        && (arrList.Contains(Old_x) == Old_arrListContainsX)
        && (arrList.IndexOf(Old_x) == Old_arrListIndexOfX || arrList.IndexOf(Old_x) == arrList.Count - 1)
        && (arrList.LastIndexOf(Old_x) == Old_arrListLastIndexOfX || arrList.LastIndexOf(Old_x) == arrList.Count - 1));

        return arrList.Count;
    }

    public static void Remove(ArrayList arrList, int x)
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert((New_arrListCount == Old_arrListCount - 1) && (Old_x == x) && (arrList.Contains(Old_x) == Old_arrListContainsX || arrList.Contains(Old_x) == New_arrListContainsX || (arrList.Contains(Old_x) == Old_arrListContainsX 
                               && arrList.LastIndexOf(Old_x) != arrList.Count - 1 && arrList.LastIndexOf(Old_x) == Old_arrListLastIndexOfX && arrList.IndexOf(Old_x) != arrList.Count - 1 && arrList.IndexOf(Old_x) == Old_arrListIndexOfX)) && (arrList.IndexOf(Old_x) == New_arrListIndexOfX || arrList.LastIndexOf(Old_x) == New_arrListLastIndexOfX ));
    }

    public static void Insert(ArrayList arrList, int index, int x)
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_index = index;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Insert(index, x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert((Old_arrListCount + 1 == New_arrListCount) && (Old_x == x) && (Old_index == index) && (arrList.Contains(Old_x) == Old_arrListContainsX) && (arrList.IndexOf(Old_x) == New_arrListIndexOfX || arrList.IndexOf(Old_x) == index) && (arrList.LastIndexOf(Old_x) == New_arrListLastIndexOfX || arrList.LastIndexOf(Old_x) == index));
    }

