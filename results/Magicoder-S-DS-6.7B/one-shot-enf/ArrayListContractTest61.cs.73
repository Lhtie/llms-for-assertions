public class ArrayListContractTest
{
    [Test]
    public void AddContract([ValueSource(nameof(ArrListAdd))] ArrayList arrList, int x)
    {
        var Old_arrListCount = arrList.Count;
        var Old_x = x;
        var Old_arrListIndexOfX = arrList.IndexOf(x);
        var Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var Old_arrListContainsX = arrList.Contains(x);

        arrList.Add(x);

        var New_arrListCount = arrList.Count;
        var New_arrListIndexOfX = arrList.IndexOf(x);
        var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(New_arrListCount == Old_arrListCount + 1, "$new_arrList_Count");
        Debug.Assert(New_arrListIndexOfX != -1, "$new_arrList_IndexOf_x");
        Debug.Assert(New_arrListLastIndexOfX != -1, "$new_arrList_LastIndexOf_x");
        Debug.Assert(New_arrListContainsX, "$new_arrList_contains_x");

    }

    [Test]
    public void RemoveContract([ValueSource(nameof(ArrListRemove))] ArrayList arrList, int x)
    {
        var Old_arrListCount = arrList.Count;
        var Old_x = x;
        var Old_arrListIndexOfX = arrList.IndexOf(x);
        var Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        var New_arrListCount = arrList.Count;
        var New_arrListIndexOfX = arrList.IndexOf(x);
        var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(New_arrListCount == Old_arrListCount - 1, "$new_arrList_Count");
        Debug.Assert(New_arrListIndexOfX == -1, "$new_arrList_IndexOf_x");
        Debug.Assert(New_arrListLastIndexOfX == -1, "$new_arrList_LastIndexOf_x");
        Debug.Assert(!New_arrListContainsX, "$new_arrList_contains_x");

    }

    [Test]
    public void InsertContract([ValueSource(nameof(ArrListInsert))] ArrayList arrList, int x, int index)
    {
        var Old_arrListCount = arrList.Count;
        var Old_x = x;
        var Old_index = index;
        var Old_arrListIndexOfX = arrList.IndexOf(x);
        var Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var Old_arrListContainsX = arrList.Contains(x);

        arrList.Insert(index, x);

        var New_arrListCount = arrList.Count;
        var New_arrListIndexOfX = arrList.IndexOf(x);
        var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        var New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(New_arrListCount == Old_arrListCount + 1, "$new_arrList_Count");
        Debug.Assert(New_arrListIndexOfX != -1, "$new_arrList_IndexOf_x");
        Debug.Assert(New_arrListLastIndexOfX != -1, "$new_arrList_LastIndexOf_x");
        Debug.Assert(New_arrListContainsX, "$new_arrList_contains_x");

    }

