﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        // @@@ last index of x in new array is less than or equal to old array size 
        private static int Old_arrListCount;
        private static int Old_x;
        private static int Old_index;
        private static int Old_arrListIndexOfX;
        private static int Old_arrListLastIndexOfX;
        private static bool Old_arrListContainsX;

        private static int New_arrListCount;
        private static int New_arrListIndexOfX;
        private static int New_arrListLastIndexOfX;
        private static bool New_arrListContainsX;

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(index >= 0 && index < arrList.Count);

            Old_arrListCount = arrList.Count;
            Old_x = x;
            Old_index = index;
            Old_arrListIndexOfX = arrList.IndexOf(x);
            Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            Old_arrListContainsX = arrList.Contains(x);

            arrList[index] = x;

            New_arrListCount = arrList.Count;
            New_arrListIndexOfX = arrList.IndexOf(x);
            New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount, "last index of x in new array is less than or equal to old array size");
        }

        // ... The rest of the PUT_xxxxContract methods ...

        public class ArrayListContractTest
    {
        // ... The rest of the ArrayListContractTest class ...
    }
}
----------------------------------------
Debug.Assert(New_Ret >= 0 && New_Ret <= arrList.Count);
// @@@ last index of x in new array is less than or equal to old array size 
Debug.Assert(New_Ret >= 0 || New_Ret <= Old_arrListCount);
