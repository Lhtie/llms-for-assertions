using System;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    internal class ArrayListContractTest_PUT_RemoveContract_Adapter:IPexRunnable
    {
    
        public void Run(object underTest)
        {
            ArrayList arrList = (ArrayList) underTest;

            int Old_arrListCount = arrList.Count;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);
            
            arrList.Remove(x);
            
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);
            
            Debug.Assert(arrList.Count != arrList.LastIndexOf(x));    // @@@ array list count is not same as last index of x in old array
        }
    }
}
------------------------------------------------------------
using System.Collections.Generic;
using System.Diagnostics;

public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Assert.IsTrue(true);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(x);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool New_arrListContainsX = arrList.Contains(x);

        Assert.AreEqual(Old_arrListCount, New_arrListCount);
        Assert.AreEqual(Old_x, x);
        Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
        Assert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
        Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);

    }

    // @@@ array list count is not same as last index of x in old array 
}
