            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_arrListIndexOfX < Old_arrListIndexOfX);
            Debug.Assert(New_arrListLastIndexOfX < Old_arrListLastIndexOfX);
            Debug.Assert(New_arrListCount == Old_arrListCount - 1);
            Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX);
            Debug.Assert(!New_arrListContainsX && Old_arrListContainsX);

        }

