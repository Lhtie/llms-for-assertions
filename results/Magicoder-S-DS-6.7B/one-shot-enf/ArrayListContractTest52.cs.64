using System.Diagnostics;

[PexMethod]
public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    int New_Ret = arrList.Add(x);
    int New_arrListCount = arrList.Count;

    Debug.Assert(New_arrListCount - Old_arrListCount == 1);
}

[PexMethod]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    arrList.Remove(x);
    int New_arrListCount = arrList.Count;

    Debug.Assert(Old_arrListCount - New_arrListCount <= 1);
}

[PexMethod]
public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;
    arrList.Insert(index, x);
    int New_arrListCount = arrList.Count;

    Debug.Assert(New_arrListCount == Old_arrListCount + 1);
}

[PexMethod]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    arrList[index] = x;
}

[PexMethod]
public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    int New_Ret = (int)(arrList[index]);
    Debug.Assert(true);
}

[PexMethod]
public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    bool New_Ret = arrList.Contains(x);
    int New_arrListCount = arrList.Count;

    Debug.Assert(New_Ret == (Old_arrListCount != New_arrListCount - 1));
}

[PexMethod]
public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int New_Ret = arrList.IndexOf(x);
    Debug.Assert(true);
}

[PexMethod]
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int New_Ret = arrList.LastIndexOf(x);
    Debug.Assert(true);
}

[PexMethod]
public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
{
    int New_Ret = arrList.Count;
    Debug.Assert(true);
}
</code>
Please note that the condition in the assert statements is currently set to true as we didn't have the necessary information about the old array list state to make meaningful comparisons.--------------------
Debug.Assert(New_Ret >= Old_arrListIndexOfX);
</code>

This is the assert statement that corresponds to "@@@ If the return value is true, the last position of x is atleast arrListIndexOfX in the new array". The value of "New_Ret" is the index of the first occurence of x in the new ArrayList whereas "Old_arrListIndexOfX" is the index of the first occurence of x in the old ArrayList. Thus the assertion checks if the index of the first occurence of x in the new list is not less than the index of first occurence in the old list.--------------------
using System.Diagnostics;

namespace ArrayList.Test
{

    public static int Sum(int x, int y)
    {
        int sum = x + y;
        Debug.Assert(sum >= x && sum >= y);
        return sum;
    }

}
