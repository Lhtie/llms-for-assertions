using NUnit.Framework;
using System.Collections.Generic;

[TestFixture]
public class ArrayListContractTest
{
    public List<int> Old_arrList = new List<int>();
    public List<int> New_arrList = new List<int>();

    // Assert before Add method is called
    [Test]
    public void PUT_AddTest()
    {
        int Old_arrListCount = Old_arrList.Count;
        int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
        bool Old_arrListContainsX = Old_arrList.Contains(x);

        int New_Ret = arrList.Add(x);

        int New_arrListCount = New_arrList.Count;
        int New_arrListIndexOfX = New_arrList.IndexOf(x);
        int New_arrListLastIndexOfX = New_arrList.LastIndexOf(x);
        bool New_arrListContainsX = New_arrList.Contains(x);

        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
        Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
        
        // No changes in New_arrListLastIndexOfX if X doesn't exist in original list
        if(Old_arrListContainsX)
        {
            Assert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
        }
        Assert.AreEqual(New_arrListContainsX, Old_arrListContainsX);
    }

    // Assert after Remove method is called
    [Test]
    public void PUT_RemoveTest()
    {
        int Old_arrListCount = Old_arrList.Count;
        int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
        bool Old_arrListContainsX = Old_arrList.Contains(x);

        arrList.Remove(x);

        int New_arrListCount = New_arrList.Count;
        int New_arrListIndexOfX = New_arrList.IndexOf(x);
        int New_arrListLastIndexOfX = New_arrList.LastIndexOf(x);
        bool New_arrListContainsX = New_arrList.Contains(x);

        Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
        Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
        
        // No changes in New_arrListLastIndexOfX if X doesn't exist in original list or only one occurrence of x exists
        if(Old_arrListContainsX && Old_arrListCount - 1 > Old_arrListLastIndexOfX)
        {
            Assert.AreNotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
        }
        Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
    }

    // Assert after Insert method is called
    [Test]
    public void PUT_InsertTest()
    {
        int Old_arrListCount = Old_arrList.Count;
        int Old_arrListIndexOfX = Old_arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = Old_arrList.LastIndexOf(x);
        bool Old_arrListContainsX = Old_arrList.Contains(x);

        arrList.Insert(index, x);

        int New_arrListCount = New_arrList.Count;
        int New_arrListIndexOfX = New_arrList.IndexOf(x);
        int New_arrListLastIndexOfX = New_arrList.LastIndexOf(x);
        bool New_arrListContainsX = New_arrList.Contains(x);

        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
        Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
        
