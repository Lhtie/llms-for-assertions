using System.Diagnostics;
using System.Collections.Generic;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
    }

    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {            
            int Old_arrListCount = arrList.Count;
            Debug.Assert(arrList.Add(x) == Old_arrListCount + 1);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {            
            Debug.Assert(arrList.Remove(x) == false);
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {            
            Debug.Assert(arrList.Insert(index, x) == arrList.Count);
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {    
            arrList[index] = x;
            Debug.Assert(() => IndexOf(x) == index); 
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {        
            Debug.Assert(() => arrList[index] == arrList.Get(index));
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {        
            Debug.Assert(arrList.Contains(x) == arrList.IndexOf(x) != -1);
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {     
            Debug.Assert((arrList.IndexOf(x) == -1) == !arrList.Contains(x));
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {    
            Debug.Assert(arrList.LastIndexOf(x) == x);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {      
            int Old_arrListCount = arrList.Count;
            Debug.Assert(arrList.Count <= Old_arrListCount);
            Debug.Assert(() => arrList.GetCount() == Old_arrListCount);
        }
    }
}
--------------------
Debug.Assert(true);
Debug.Assert(Old_arrListCount <= New_arrListCount);
Debug.Assert(Old_x == arrList[Old_arrListIndexOfX]);
Debug.Assert(Old_x == arrList[Old_arrListLastIndexOfX]);
Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX || Old_arrListIndexOfX == -1);
Debug.Assert(Old_arrListIndexOfX <= Old_arrListLastIndexOfX);
Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX || Old_arrListLastIndexOfX == -1);
Debug.Assert(Old_arrListContainsX == New_arrListContainsX);
Debug.Assert(!New_arrListContainsX || New_Ret == New_arrListCount - 1);
// @@@ If the return value of IndexOf() is -1, the x has not been added to the list
----------------------------------------
    Assert.IsTrue(New_Ret >= (Old_arrListCount + 1));
    Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);
    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    Assert.IsFalse(New_arrListContainsX);
