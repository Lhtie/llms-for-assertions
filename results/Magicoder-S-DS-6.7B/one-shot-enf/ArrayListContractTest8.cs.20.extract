using System.Diagnostics;
using System;

class Program
{
    static void Main(string[] args)
    {
       var arrList = new ArrayList();
       var x = 3;
       var index = 2;

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(arrList.LastIndexOf(x) >= arrList.IndexOf(x));

       arrList.Add(x);
       var New_arrListCount = arrList.Count;
       var New_arrListIndexOfX = arrList.IndexOf(x);
       var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
       var New_arrListContainsX = arrList.Contains(x);

       // @@@ sum is greater than or equal to x and y  
       Debug.Assert(arrList.Count >= x && arrList.Count >= y);

       arrList.Remove(x);
       var New_arrListCount = arrList.Count;
       var New_arrListIndexOfX = arrList.IndexOf(x);
       var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
       var New_arrListContainsX = arrList.Contains(x);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(arrList.LastIndexOf(x) >= arrList.IndexOf(x));

       arrList.Insert(index, x);
       var New_arrListCount = arrList.Count;
       var New_arrListIndexOfX = arrList.IndexOf(x);
       var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
       var New_arrListContainsX = arrList.Contains(x);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(arrList.LastIndexOf(x) >= arrList.IndexOf(x));

       arrList[index] = x;
       var New_arrListCount = arrList.Count;
       var New_arrListIndexOfX = arrList.IndexOf(x);
       var New_arrListLastIndexOfX = arrList.LastIndexOf(x);
       var New_arrListContainsX = arrList.Contains(x);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(arrList.LastIndexOf(x) >= arrList.IndexOf(x));

       var New_Ret = (int)(arrList[index]);
       var New_containsNewRet = arrList.Contains(New_Ret);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX);

       var New_Ret = arrList.Contains(x);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX);

       var New_Ret = arrList.IndexOf(x);
       var New_containsNewRet = arrList.Contains(New_Ret);  

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX);

       var New_Ret = arrList.LastIndexOf(x);
       var New_containsNewRet = arrList.Contains(New_Ret);

       // @@@ last index of x is geq an index of x in new array list  
       Debug.Assert(New_arrListLastIndexOfX >= New_arrListIndexOfX);

       var New_Ret = arrList.Count;
    }    
}
