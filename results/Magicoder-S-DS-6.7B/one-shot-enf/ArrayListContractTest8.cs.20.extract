using System.Collections.Generic;
using System.Diagnostics;
using System.Text;

class Program
{
    public List<int> arrList = new List<int>();
    public int sum;
    public static int Sum(int x, int y)
    {
        var obj = new Program();
        obj.sum = x + y;
        Debug.Assert(obj.sum >= x && obj.sum >= y);
        return obj.sum;
    }
}
