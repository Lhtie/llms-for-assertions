    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

        int New_Ret = arrList.Add(x);

        Debug.Assert(arrList.Count == Old_arrListCount + 1);
        Debug.Assert(arrList.IndexOf(x) == Old_arrListIndexOfX);
        Debug.Assert(arrList.LastIndexOf(x) == Old_arrListLastIndexOfX);
    }

    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest] ArrayList arrList, int x)
    {
        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

        arrList.Remove(x);

        Debug.Assert(arrList.Count == Old_arrListCount - 1);
        Debug.Assert(arrList.IndexOf(x) == Old_arrListCount - 1 ? -1 : Old_arrListIndexOfX);
        Debug.Assert(arrList.LastIndexOf(x) >= -1 ? -1 : Old_arrListLastIndexOfX);
    }

    [PexMethod]
