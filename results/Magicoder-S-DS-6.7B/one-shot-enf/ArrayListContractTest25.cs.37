        arrList.Insert(index, x);

        Debug.Assert(arrList.Count == Old_arrListCount + 1);
        Debug.Assert(arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == arrList.Count - 1);
    }

