class Account:
    def __init__(self, money):
        self.money = money


class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0, 100)) for _ in range(5)]


def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            assert sum(acnt.money for acnt in frm.accounts) >= amnt, "@@@ some account of "frm" has more money than "amnt""
            return True

    return False
--------------------
def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """

    # @@@ some account of "frm" has more money than "amnt"
    assert any(acnt.money >= amnt for acnt in frm.accounts), 'Some account of "frm" has more money than the "amnt".'

    for acnt in frm.accounts:
        if (acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False
