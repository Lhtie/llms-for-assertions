﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;
using PexAPIWrapper;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Add(x) >= 0);

            PexObserve.ValueForViewing("$new_arrList_count", arrList.Count);
            PexObserve.ValueForViewing("$arrList_indexOf_x", arrList.IndexOf(x));
            PexObserve.ValueForViewing("$arrList_lastIndexOf_x", arrList.LastIndexOf(x));
            PexObserve.ValueForViewing("$arrList_contains_x", arrList.Contains(x));

        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));
            arrList.Remove(x);

            PexObserve.ValueForViewing("$new_arrList_count", arrList.Count);
            PexObserve.ValueForViewing("$arrList_indexOf_x", arrList.IndexOf(x));
            PexObserve.ValueForViewing("$arrList_lastIndexOf_x", arrList.LastIndexOf(x));
            PexObserve.ValueForViewing("$arrList_contains_x", arrList.Contains(x));

        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);

            arrList.Insert(index, x);

            PexObserve.ValueForViewing("$new_arrList_count", arrList.Count);
            PexObserve.ValueForViewing("$arrList_indexOf_x", arrList.IndexOf(x));
            PexObserve.ValueForViewing("$arrList_lastIndexOf_x", arrList.LastIndexOf(x));
            PexObserve.ValueForViewing("$arrList_contains_x", arrList.Contains(x));

        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= arrList.Count - 1);
            arrList[index] = x;
            
            var oldIndex = arrList.IndexOf(x);
            arrList.IndexOf(x);
            arrList.LastIndexOf(x);
            bool newContainsX = arrList.Contains(x);
            PexObserve.ValueForViewing("$old_arrList_index", oldIndex);
            PexObserve.ValueForViewing("$new_arrList_count", arrList.Count);
            PexObserve.ValueForViewing("$arrList_indexOf_x", arrList.IndexOf(x));
            PexObserve.ValueForViewing("$arrList_lastIndexOf_x", arrList.LastIndexOf(x));
            PexObserve.ValueForViewing("$arrList_contains_x", newContainsX);
        }

        [PexMethod]
