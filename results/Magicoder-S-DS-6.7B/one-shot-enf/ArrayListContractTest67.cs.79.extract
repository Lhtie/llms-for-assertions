using System.Collections.Generic;
using System.Diagnostics;
using System.Text.RegularExpressions;
using NUnit.Framework;

public static class ArrayListConverter
{
    public static void ProcessCodeAndOutputAssertStatements(string code)
    {
        var lines = code.Split('\n');

        foreach (var line in lines)
        {
            var trimmedLine = line.Trim(' ', '\r');
            if (trimmedLine.StartsWith("// @@@") || trimmedLine.StartsWith("// @@"))
            {
                var match = Regex.Match(trimmedLine, @"\/\/\s*\@\@*\s*(.*)");

                if (match.Success)
                {
                    var assertDescription = match.Groups[1].Value;
                    Debug.WriteLine($"Debug.Assert({assertDescription});");
                }
            }
        }
    }
}
