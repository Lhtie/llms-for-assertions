            arrList[index] = index;

            int Old_Ret = arrList[index];
            arrList[index] = index;
            int New_Ret = arrList[index];            
            
            Debug.Assert(Old_Ret == New_Ret);

            // @@@ Getting an element and setting it again should have the same return
        }

