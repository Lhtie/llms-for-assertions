using NUnit.Framework;
using System;
using System.Collections.Generic;

namespace ArrayList
{
    public class ArrayList
    {
        public int Count { get; private set; }
        public void Add(int x) { }
        public void Remove(int x) { }
        public void Insert(int index, int x) { }
        public int this[int index] 
        { 
            get { return -1; } 
            set { } 
        } 
        public bool Contains(int x) { return false; }
        public int IndexOf(int x) { return -1; }
        public int LastIndexOf(int x) { return -1; }
    }

    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            arrList.Add(x);

            int Old_arrListCount = arrList.Count;
            arrList.Add(x);
            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount > Old_arrListCount);
            
            // @@@ The Count of the array should increase
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {            
            arrList.Remove(x);
            int Old_arrListCount = arrList.Count;
            arrList.Remove(x);
            int New_arrListCount = arrList.Count;

            Debug.Assert(New_arrListCount < Old_arrListCount);

            // @@@ The Count of the array should decrease after removal
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            arrList.Add(x);
            arrList.Insert(index, x);

            int Old_arrListCount = arrList.Count;
            arrList.Insert(index, x);
            int New_arrListCount = arrList.Count;

            int Old_arrListIndexOfX = arrList.IndexOf(x);
            arrList.Insert(index, x);
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(New_arrListCount > Old_arrListCount && New_arrListIndexOfX >= Old_arrListIndexOfX);

            // @@@ The Count of the array should increase and inserted element should always have an index >= previous index 
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            arrList.Add(x);
            arrList[index] = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);            
            arrList[index] = x;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);

            // @@@ The IndexOf the element should always remain the same after setting
        }

