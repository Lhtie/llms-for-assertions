using System;
using System.Diagnostics;

namespace ArrayList
{
    public class ArrayList
    {
        private Object[] _items; // Do not rename (binary serialization)
        private int _size; // Do not rename (binary serialization)
        private int _version; // Do not rename (binary serialization)

        public void Insert(int index, Object value)
        {
            Debug.Assert(CheckedArray(index, _size));

            // The assertion logic here checks that the size of
            // the ArrayList has increased by one when an item is inserted at
            // any index greater than or equal to _size.
        }

        private static bool CheckedArray(int index, int size)
        {
            if (index >= size && index <= _size) return true;
            else return false;
        }
    }
}
</code>

