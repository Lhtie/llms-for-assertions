public static void Add() 
{
    if (_version != OLD(_version)) throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");

    if (_size == _items.Length) EnsureCapacity(_size + 1);
    _items[_size] = value;
    _version++;
 
  // @@@ Size of list increases by 1 after operation
}
</code>

<code>
public static void Insert(int index, Object value) 
{
    if (index < 0 || index > _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_ArrayListInsert");

    if (_size == _items.Length) EnsureCapacity(_size + 1);

    if (index < _size)
    {
        Array.Copy(_items, index, _items, index + 1, _size - index);
    }
    _items[index] = value;
    _size++;
    _version++;

  // @@@ Size of the list increases by 1 after operation
}
</code>

<code>
public static void AddRange(ICollection c)
{
    if (c == null) throw new ArgumentNullException("nameof(c)", "Argument cannot be null.");
    if (_version != OLD(_version)) throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");

    foreach (Object value in c)
    {
        Add(value);
    }
}
</code>

<code>
public static void Clear()
{
    if (_version != OLD(_version)) throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");
    _size = 0;
}
</code>

<code>
public static void RemoveAt(int index)
{
    if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_ArrayList");
    if (_version != OLD(_version)) throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");
    Array.Copy(_items, index + 1, _items, index, _size - index - 1);
    _size--;
    _version++;

  // @@@ Size of the list decreases by 1 after operation
}
</code>

<code>
public static void Remove(Object obj)
{
    int index = IndexOf(obj);
    if (index >= 0)
        RemoveAt(index);

  // @@@ Size of the list decreases by 1 after operation
}
</code>--------------------
Debug.Assert(COUNT.OLD == (oldCount + x > 0 ? oldCount + x : 0))
