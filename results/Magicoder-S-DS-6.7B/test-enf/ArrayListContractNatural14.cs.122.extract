    [TestMethod]
    public void ArrayList_Contains() 
    {
        // Initialize an array list
        ArrayList arrayList = new ArrayList();
        
        // Add multiple items to the list
        arrayList.Add("item1");
        arrayList.Add("item2");
        arrayList.Add("item3");
        arrayList.Add("item4");

        bool contains = arrayList.Contains("item1");

        // assert that `contains` is true
        Debug.Assert(contains == true, "item1 is not in the list");
    }
