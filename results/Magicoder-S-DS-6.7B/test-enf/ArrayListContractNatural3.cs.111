using System.Collections;

public static void Insert(Stack s, int x){
    for (int i = 0; i < x; i++){
        int inp = Input();
        s.push(inp);
    }
    Debug.Assert(OLD(s.size) + x == s.size);
}

public static int Padd(int x, int y){
    sum = x + y;
    Debug.Assert(RET >= x && RET >= y);
    return sum;
}

public static int Search(Collection c, int val){
    int index = c.SearchFrom(c, val, 2);
    Debug.Assert(index == -1 || index >= 2);
    return index;
}

public static void AddRange(ArrayList al, ICollection c){
    foreach (object o in c) {
        al.Add(o);
    }
    Debug.Assert(OLD(al.Count) + c.Count == al.Count);
}

public static object RemoveAt(ArrayList al, int index) {
    object r = al[index];
    al.RemoveAt(index);
    Debug.Assert(OLD(al.Count) - 1 == al.Count);
    return r;
}
