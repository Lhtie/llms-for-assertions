using System;
using System.Collections.Generic;
using System.Collections;
using System.Diagnostics;

namespace ArrayList
{
    public class ArrayList 
    {
        private Object[] _items; 
        private int _size; 
        private int _version; 
        private Object _syncRoot;

        private const int _defaultCapacity = 4;

        internal const int MaxArrayLength = 0X7FEFFFFF;

        public ArrayList()
        {
            _items = EmptyArray<Object>.Value;
        }

        public ArrayList(int capacity)
        {
            if (capacity < 0)
                throw new ArgumentOutOfRangeException(nameof(capacity), "Capacity is less than zero");

            _items = new Object[capacity];

        }

        public virtual int Capacity
        {
            get
            {
                return _items.Length;
            }
            set
            {
                if (value < _size)
                    throw new ArgumentException("Capacity is less than the current number of elements");
                if (value > MaxArrayLength)
                    throw new ArgumentOutOfRangeException(nameof(value),"Capacity is more than the maximum possible value");
                
                if (value != _items.Length)
                {
                    if (value > 0)
                    {
                        Object[] newItems = new Object[value];
                        if (_size > 0)
                        {
                            Array.Copy(_items, 0, newItems, 0, _size);
                        }
                        _items = newItems;
                    }
                    else
                    {
                        _items = EmptyArray<Object>.Value;
                    }
                }
            }
        }

        public virtual int Count
        {
            get
            {
                return _size;
            }
        }

        public virtual Object this[int index]
        {
            get
            {
            
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");

                return _items[index];
            }
            set
            {
                
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
                
                _items[index] = value;
                _version++;

            }
        }

        public virtual int Add(Object value)
        {
            if (_size == _items.Length) EnsureCapacity(_size + 1);
            _items[_size] = value;
            _version++;

            return _size++;
        }

        public virtual void Clear()
        {
            Array.Clear(_items, 0, _size);
            _size = 0;
            _version++;
        }

        public virtual bool Contains(Object item)
        {
            if (item == null)
            {
                for (int i = 0; i < _size; i++)
                    if (_items[i] == null)
                        return true;
                return false;
            }
            else
            {
                for (int i = 0; i < _size; i++)
                    if ((_items[i] != null) && (_items[i].Equals(item)))
                        return true;
                return false;
            }
        }

        public virtual int IndexOf(Object value)
        {
            return Array.IndexOf((Array)_items, value, 0, _size);
        }

        public virtual void Insert(int index, Object value)
        {
            // Note that insertions at the end are legal.
            if (index < 0 || index > _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_ArrayListInsert");

            if (_size == _items.Length) EnsureCapacity(_size + 1);
            if (index < _size)
            {
                Array.Copy(_items, index, _items, index + 1, _size - index);
            }
            _items[index] = value;
            _size++;
            _version++;

        }

        public virtual void Remove(Object obj)
        {
            int index = IndexOf(obj);
