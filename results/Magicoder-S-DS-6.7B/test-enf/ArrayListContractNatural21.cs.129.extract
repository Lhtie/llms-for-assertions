
public class ArrayList
{
    public ArrayList()
    {
        Assert.IsNull(OLD(_items));
        Assert.AreEqual(0, OLD(_size));
        Assert.AreEqual(0, OLD(_version));
    }
    //...
    public int Add(Object value)
    {
        if (OLD(_size) == OLD(_items).Length) EnsureCapacity(OLD(_size) + 1);
        OLD(_items)[OLD(_size)] = value;
        OLD(_version)++;
        Assert.AreEqual(OLD(_size) + 1, OLD(_size));
                
        return OLD(_size)++;
    }
    //...
    public void Insert(int index, Object value)
    {
        Assert.IsTrue(index >= 0 && index <= OLD(_size));
        if (OLD(_size) == OLD(_items).Length) EnsureCapacity(OLD(_size) + 1);
        if (index < OLD(_size))
        {
            Array.Copy(OLD(_items), index, OLD(_items), index + 1, OLD(_size) - index);
        }
        OLD(_items)[index] = value;
        OLD(_size)++;
        OLD(_version)++;
        Assert.AreEqual(OLD(_size), OLD(_size)); // @@@ count of the list increases by 1 after inserting x in the array 
    }
    //...
}
--------------------
Debug.Assert(INDEXOF(obj) == -1 && COUNT == OLD(COUNT));
Debug.Assert(index >= 0 && ARRAY.COPY.SOURCE.LENGTH >= -1 + INDEX - 1);
Debug.Assert(RET.ARRAY.COPY.DESTINATION.LENGTH == -1 + INDEX - 1);
Debug.Assert(RET = index || INDEX < OLD(COUNT));
--------------------
Debug.Assert(OLD(_items.Length - 1) + 1 == RET);
--------------------
Debug.Assert(Array.IndexOf((Array)_items, value, 0, _size) != -1);
--------------------
Debug.Assert(OLD(_items.Length) - COUNT(index) == 1); //The size of the list does increase by 1 after inserting an element at index i
--------------------
Debug.Assert(OLD(_size) + 1 = _size);
--------------------
Debug.Assert(count == (OLD(count) - x) && size == (OLD(size) - x) && capacity == (OLD(capacity) - x));
--------------------
--------------------
Debug.Assert(OLD(Count) + 1 == Count);
