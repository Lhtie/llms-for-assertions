--------------------
ArrayList arrlist = new ArrayList();
...
arrlist.Add("apple");
arrlist.Add("banana");
// @@@ list size increases after adding two elements
Debug.Assert(arrlist.Count == 2);
...
arrlist.Add("grapes");
arrlist.Add("orange");
// @@@ list size increases by two after adding more elements
Debug.Assert(arrlist.Count == 4);
...
// @@@ list size will increase or stay the same after removing an element
int listSize = arrlist.Count;
arrlist.RemoveAt(0);
Debug.Assert(arrlist.Count == listSize - 1);
...
// @@@ list size decreases by one after removing the first item
arrlist.RemoveAt(0);
Debug.Assert(arrlist.Count == listSize - 2);
...
arrlist.Insert(0, "mango");
// @@@ list size increases or stays the same after inserting an item
Debug.Assert(arrlist.Count == listSize - 2);
...
