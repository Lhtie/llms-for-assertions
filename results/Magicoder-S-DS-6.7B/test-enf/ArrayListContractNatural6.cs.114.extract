public static void Insert(Stack s, int x)
{
    for (int i = 0; i < x; i++) {
        int inp = Input();
        s.push(inp);
    }
    // @@@ Size of stack increases by x in the function
    Debug.Assert(OLD(s.size) + x == s.size);
}
