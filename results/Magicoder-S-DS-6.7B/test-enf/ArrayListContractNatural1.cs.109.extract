
// @@@ size of size is always >= 0
Debug.Assert(_size >= 0)

// @@@ size is only equal to or larger than 0 when count is also 0
if (_size > 0) Debug.Assert(_size == Count)

// @@@ size of array is always greater than or equal to 0
Debug.Assert(_size >= 0)

// @@@ size of array should be always >= 0
Debug.Assert(_size >= 0)

// @@@ '0' <= index <= _size 
Debug.Assert(0 <= index && index <= _size)

// @@@ size is always greater than -1
Debug.Assert(_size > -1)

// @@@ _size should always be greater than or equal to 0
Debug.Assert(_size >= 0)

// @@@ size must be greater than or equal to 0
Debug.Assert(_size >= 0)

// @@@ size will always be >= 0
Debug.Assert(_size >= 0)

// @@@ _size must be greater than or equal to 0
Debug.Assert(_size >= 0)

// @@@ 0 <= index && index < _size
Debug.Assert(0 <= index && index < _size)

// @@@ _size should be always greater than or equal to 0
Debug.Assert(_size >= 0)

// @@@ _size should always be greater than or equal to 0
Debug.Assert(_size >= 0)
--------------------
Debug.Assert(COUNT >= -1); // @@@ size of array is always greater than or equal to 0
Debug.Assert(INDEX >= 0); // @@@ index is either -1 or greater than or equal to 2
Debug.Assert(INDEX == -1 || INDEX >= 2);
--------------------
Debug.Assert(Count >= 0);
----------------------------------------
Debug.Assert(x &gt; 0 && x &lt;= _defaultCapacity);
