            Debug.Assert(Old_arrListCount == New_arrListCount + 1);--------------------Debug.Assert(Old_arrListCount < New_arrListCount, "$old_arrList_Count < new_arrList_Count");--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);----------------------------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "$old_arrList_Count + 1 equals $new_arrList_Count");------------------------------------------------------------Debug.Assert(old.Count == new.Count); // this would be true because Count cannot decrease but could increase--------------------        Debug.Assert(New_arrListCount >= Old_arrListCount);----------------------------------------