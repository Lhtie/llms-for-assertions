```C#
[Test]
public void TestArrayListContract()
{
    ArrayList arrList = new ArrayList();
    int x = 5;

    // PUT_CountContract
    Assert.AreEqual(arrList.Count, 0);

    // PUT_AddContract
    int oldCount = arrList.Count;
    int ret = arrList.Add(x);
    Assert.AreEqual(arrList.Count, oldCount + 1);
    Assert.AreEqual(ret, arrList[arrList.Count - 1]);

    // More test cases are omitted for brevity...

    // PUT_ContainsContract
    bool contains = arrList.Contains(x);
    int indexOfX = arrList.IndexOf(x);
    Assert.IsTrue(contains);
    // What if there are multiple occurrences of x?
    Assert.AreEqual(indexOfX, arrList.LastIndexOf(x));
    // Test condition for the comment "If the return value is false..."
    if (!contains)
        Assert.LessOrEqual(indexOfX, arrList.LastIndexOf(x));
}
```

