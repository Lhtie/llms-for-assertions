            Debug.Assert(new_arrListCount == old_arrListCount + 1);--------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------            Debug.Assert(index <= arrList.Count && index >= 0, "[PexAssumeUnderTest]ArrayList arrList index out of range.");----------------------------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);--------------------            Debug.Assert(New_arrListCount == Old_arrListCount + 1," @@@ array list size increases by 1 after insertion");--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount);----------------------------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1, "ArrayList size did not increase by 1 after insertion");--------------------Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------