```cs

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            // PexAssumeUnderTest attribute will be executed by Pex
            // Assumes given instance of arraylist is tested
            Debug.Assert(arrList != null, "arraylist is null");

            // AssumePrecondition.IsTrue checks if condition is true
            // Check if index is within arraylist's bound
            Debug.Assert(index < arrList.Count && index >= 0, "index is out of arraylist's bound");

            // Precondition - Old count
            int Old_arrListCount = arrList.Count;
            Debug.Assert(Old_arrListCount >= 0, "Old count is negative");

            // Precondition - Old index
            int Old_index = index;

            // Actions
            int New_Ret = (int)(arrList[index]);

            // Postcondition - New Count
            int New_arrListCount = arrList.Count;
            Debug.Assert(New_arrListCount == Old_arrListCount, "New count differs from old count");

            // Postcondition - New Ret
            bool New_containsNewRet = arrList.Contains(New_Ret);
            Debug.Assert(New_containsNewRet, "New retrieval value is not present in arraylist");

            // Observation
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$new_containsNewRet", New_containsNewRet);

	    // @@@ index passed in is not equal to the old array size 
            // Debug.Assert(index != Old_arrListCount, "index passed in is equal to old array list size");
        }
    }
}

```
