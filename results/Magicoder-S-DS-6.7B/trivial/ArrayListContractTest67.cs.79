```cs
    [Test]
    public void Add_CheckListCountIncrease1_WhenElementAdded()
    {
        var list = new ArrayList();
        PexAssume.IsTrue(true);
        int countBeforeAdd = list.Count;
        list.Add(42);
        int countAfterAdd = list.Count;
        Assert.AreEqual(countBeforeAdd + 1, countAfterAdd);
    }

    [Test]
    public void Remove_CheckIfElementIsNotContainedInList_WhenElementRemoved()
    {
        var list = new ArrayList(new[] { 42 });
        PexAssume.IsTrue(true);
        list.Remove(42);
        Assert.IsFalse(list.Contains(42));
    }

    [Test]
    public void Insert_CheckListCountIncrease1_WhenInsertAtValidIndex()
    {
        var list = new ArrayList();
        int index = PexAssume.Random.Next();
        PexAssume.IsTrue(index <= list.Count && index >= 0);
        int countBeforeInsert = list.Count;
        list.Insert(index, 42);
        int countAfterInsert = list.Count;
        Assert.AreEqual(countBeforeInsert + 1, countAfterInsert);
    }

    [Test]
    public void Set_CheckListContainsNewValue_WhenValueIsSetToValidIndex()
    {
        var list = new ArrayList(new[] { 42 });
        int index = PexAssume.Random.Next();
        PexAssume.IsTrue(index >= 0 && index < list.Count);
        list[index] = 13;
        Assert.IsTrue(list.Contains(13));
    }

    [Test]
    public void Get_CheckReturnedElement_WhenIndexIsValid()
    {
        var list = new ArrayList(new[] { 42 });
        int index = PexAssume.Random.Next();
        PexAssume.IsTrue(index < list.Count && index >= 0);
        Assert.AreEqual((int)(list[index]), 42);
    }

    [Test]
    public void Contains_CheckIfListContainsValue_WhenValueIsValid()
    {
        var list = new ArrayList(new[] { 42 });
        int value = 42;
        PexAssume.IsTrue(true);
        Assert.IsTrue(list.Contains(value));
    }

    [Test]
    public void IndexOf_CheckIfReturnedIndexIsContainingValue_WhenValueIsValid()
    {
        var list = new ArrayList(new[] { 42 });
        int value = 42;
        PexAssume.IsTrue(true);
        list.IndexOf(value);
        Assert.IsTrue(list.Contains(value));
    }

    [Test]
    public void LastIndexOf_CheckIfReturnedIndexIsContainingValue_WhenValueIsValid()
    {
        var list = new ArrayList(new[] { 42 });
        int value = 42;
        PexAssume.IsTrue(true);
        list.LastIndexOf(value);
        Assert.IsTrue(list.Contains(value));
    }

    [Test]
    public void Count_CheckReturnedCount_WhenListIsNotEmpty()
    {
        var list = new ArrayList(new[] { 42 });
        PexAssume.IsTrue(true);
        int count = list.Count;
        Assert.AreEqual(count, 1);
    }
```
The given tests use "PexAssume" to generate random values and also "PexAssume.IsTrue" to check conditions in method parameters. This is essential in creating robust test cases because Pex automatically analyzes all possible method parameters, so asserts are generated even for conditional logic.

