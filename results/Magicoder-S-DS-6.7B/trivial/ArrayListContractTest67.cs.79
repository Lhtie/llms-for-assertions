[TestFixture]
public partial class ArrayListContractTest
{
    [Test]
    public void Validate_PUT_AddContract([Frozen]ArrayList<int> arrList, int x)
    {
        int Old_arrListCount = arrList.Count;
        
        arrList.Add(x);

        int New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "Add operation did not succeed");
    }

    [Test]
    public void Validate_PUT_RemoveContract([Frozen]ArrayList<int> arrList, int x)
    {
        int Old_arrListCount = arrList.Count;

        arrList.Remove(x);

        int New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount - 1 == New_arrListCount, "Remove operation did not succeed");
    }

    [Test]
    public void Validate_PUT_InsertContract([Frozen]ArrayList<int> arrList, int x, int index)
    {
        int Old_arrListCount = arrList.Count;

        arrList.Insert(index, x);

        int New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "Insert operation did not succeed");
    }

    [Test]
    public void Validate_PUT_SetContract([Frozen]ArrayList<int> arrList, int x, int index)
    {
        int Old_arrListCount = arrList.Count;
        int Old_Element = arrList[index];

        arrList[index] = x;

        int New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount == New_arrListCount, "Set operation modified list count");
    }

    [Test]
    public void Validate_PUT_GetContract([Frozen]ArrayList<int> arrList, int index)
    {
        bool isIndexInRange = index >= 0 && index < arrList.Count;
        int arrListCount = arrList.Count;

        int element = arrList[index];

        Debug.Assert(isIndexInRange, "Index is out of bounds");
        Debug.Assert(arrListCount == arrList.Count, "Get operation changed count of list while getting element");
    }

    [Test]
    public void Validate_PUT_ContainsContract([Frozen]ArrayList<int> arrList, int x)
    {
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Contains(x);

        bool New_arrListContainsX = arrList.Contains(x);

        Debug.Assert(Old_arrListContainsX == New_arrListContainsX, "Contains operation changed the result");
    }

    [Test]
    public void Validate_PUT_IndexOfContract([Frozen]ArrayList<int> arrList, int x)
    {
        int Old_arrListIndexOfX = arrList.IndexOf(x);

        if (Old_arrListIndexOfX < 0)
        {
            arrList.Add(x);
            Old_arrListIndexOfX = arrList.IndexOf(x);
        }

        int New_arrListIndexOfX = arrList.IndexOf(x);

        Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX, "IndexOf operation changed the result");
    }

    [Test]
    public void Validate_PUT_LastIndexOfContract([Frozen]ArrayList<int> arrList, int x)
    {
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

        if (Old_arrListLastIndexOfX < 0)
        {
            arrList.Add(x);
            Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        }

        int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

        Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX, "LastIndexOf operation changed the result");
    }

