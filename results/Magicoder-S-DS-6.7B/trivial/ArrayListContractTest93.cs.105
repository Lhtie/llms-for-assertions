```cs
using System.Diagnostics;
using System;

namespace ArrayList.Test
{
    class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            
            Debug.Assert(arrList.Count == Old_arrListCount + 1, "AddContract: Count assertion failed");
            Debug.Assert(arrList.LastIndexOf(x) >= 0, "AddContract: LastIndexOf assertion failed");
            Debug.Assert(arrList.IndexOf(x) >= 0, "AddContract: IndexOf assertion failed");
            Debug.Assert(arrList.Contains(x), "AddContract: Contains assertion failed");
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;

            Debug.Assert(arrList.Count == Math.Max(0, Old_arrListCount - 1), "RemoveContract: Count assertion failed");
            Debug.Assert(arrList.LastIndexOf(x) < 0, "RemoveContract: LastIndexOf assertion failed");
            Debug.Assert(arrList.IndexOf(x) < 0, "RemoveContract: IndexOf assertion failed");
            Debug.Assert(!arrList.Contains(x), "RemoveContract: Contains assertion failed");
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;

            Debug.Assert(arrList.Count == Old_arrListCount + 1, "InsertContract: Count assertion failed");
            Debug.Assert(arrList.LastIndexOf(x) >= index, "InsertContract: LastIndexOf assertion failed");
            Debug.Assert(arrList.IndexOf(x) >= index, "InsertContract: IndexOf assertion failed");
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList[index] == x, "SetContract: Set assertion failed");
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(arrList.Count > 0, "GetContract: Count assertion failed");
            Debug.Assert(index >= 0 && index < arrList.Count, "GetContract: Out-of-Range exception assertion failed");
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) >= 0, "ContainsContract: IndexOf assertion failed");
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) >= 0, "IndexOfContract: IndexOf assertion failed");
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) >= 0, "LastIndexOfContract: LastIndexOf assertion failed");
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            Debug.Assert(arrList.Count >= 0, "CountContract: Count assertion failed");
        }
    }
}
