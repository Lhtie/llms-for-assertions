```cs
[PexMethod]
public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;

    int New_Ret = arrList.Add(x);
    
    int New_arrListCount = arrList.Count;

    Debug.Assert(Old_arrListCount == New_arrListCount - 1); // Added element is correctly added
    Debug.Assert(arrList.Contains(x)); // Newly added element exists in the array list
}

[PexMethod]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;

    arrList.Remove(x);

    int New_arrListCount = arrList.Count;

    Debug.Assert(Old_arrListCount == New_arrListCount + 1); // The removed element is correctly removed
    Debug.Assert(!arrList.Contains(x)); // The removed element is no longer in the array list
}

// Same as above for PUT_InsertContract, PUT_SetContract, PUT_GetContract, PUT_ContainsContract, PUT_IndexOfContract, PUT_LastIndexOfContract, PUT_CountContract.
