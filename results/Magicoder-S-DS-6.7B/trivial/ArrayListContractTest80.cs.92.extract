    Debug.Assert(result == expectedCount, "Count method did not return expected value.");--------------------Debug.Assert(New_Ret != -1, "If the return value is -1, old list size is not -1 ");----------------------------------------            Debug.Assert(New_Ret == -1 || arrList.Count != -1); // check for -1 when arrList size should not be -1 --------------------Debug.Assert(New_ret != -1 || Old_arrListCount != -1);------------------------------------------------------------Debug.Assert(New_Ret != -1 || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret != -1 ? Old_arrListCount != -1 : true);--------------------    Debug.Assert(oldCount + 1 == newCount);--------------------