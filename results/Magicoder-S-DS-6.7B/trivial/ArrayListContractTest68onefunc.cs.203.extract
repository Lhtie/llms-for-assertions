Debug.Assert(New_Ret < 0, "If the return value is negative, x is not in old list");--------------------Debug.Assert(Old_arrListContainsX || New_Ret < 0); --------------------Debug.Assert(Old_arrListCount == New_arrListCount, "The list count should not change");--------------------Debug.Assert(!new_ret.Equals(-1), "x is present in the arraylist but should not be");--------------------            Debug.Assert(New_Ret == -1, "If the return value is negative, x is not in old list", "The return value was: {0}", New_Ret);--------------------            Debug.Assert(New_Ret < 0, "If the return value is negative, x is not in old list");----------------------------------------Debug.Assert(New_Ret < 0, "x is not in the old list");--------------------            Debug.Assert(Old_arrListCount == New_arrListCount);--------------------            Debug.Assert(Old_arrListContainsX == New_arrListContainsX, "Contains X flag is not preserved after Indexof");--------------------