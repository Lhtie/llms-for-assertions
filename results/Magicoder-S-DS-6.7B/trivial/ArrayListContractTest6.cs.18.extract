    Debug.Assert(New_arrListCount == Old_arrListCount, "$old_arrList_Count must equal to $new_arrList_Count");--------------------Debug.Assert(Old_arrListCount <= New_arrListCount);--------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);------------------------------------------------------------            Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);--------------------------------------------------------------------------------        Debug.Assert(arrList.LastIndexOf(Old_x) <= Old_arrListCount, "Last position of x in new array is greater than old array size");--------------------