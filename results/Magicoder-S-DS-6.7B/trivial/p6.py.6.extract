    assert r.exp > 0, "height of r is not positive"--------------------    assert r.exp > 0, "Height of r is not positive. It is: {}".format(r.exp)--------------------assert r.exp > 0, "Height of r is not positive. Expected positive but got: " + str(r.exp)----------------------------------------        assert self.exp > 0, "Height of Rectangle should be positive"--------------------    assert r.exp > 0, "@@@ height of r is positive"--------------------    assert r.exp > 0, "height of r is not positive"--------------------assert r.exp > 0, "height of r is not positive"--------------------    assert r.height > 0, 'height of r is negative'--------------------    assert r.exp > 0, "@@@ height of r is positive"--------------------