        Debug.Assert(arrayList.Count >= Old_arrListCount);-------------------- Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------------------------------------------------------------------Debug.Assert(Old_arrListCount == (New_arrListCount - 1));----------------------------------------            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount); // @@@ last index of x in old array is smaller than or equal to new array size--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------