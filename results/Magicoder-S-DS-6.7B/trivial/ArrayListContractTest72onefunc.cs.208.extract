Debug.Assert(!(New_Ret < 0) || New_Ret <= New_arrListLastIndexOfX, "The return value of IndexOf is non-negative, then the new ret value should be less than or equal to the last index of x in new list");--------------------            Debug.Assert(New_Ret <= New_arrListLastIndexOfX, "Condition failed: New_Ret <= New_arrListLastIndexOfX");--------------------                Debug.Assert(New_Ret <= New_arrListLastIndexOfX);--------------------            Debug.Assert(New_Ret <= arrList.LastIndexOf(x), "If the return value is non-negative, new ret <= last index of x in new list");----------------------------------------                Debug.Assert(!(New_Ret > New_arrListLastIndexOfX));--------------------Debug.Assert(New_Ret >= -1, "New_Ret is less than -1");--------------------Debug.Assert(New_Ret <= New_arrListLastIndexOfX);--------------------Debug.Assert(New_Ret >= 0 ? New_Ret <= New_arrListLastIndexOfX : true);--------------------Debug.Assert(New_Ret <= New_arrListLastIndexOfX);--------------------