```cs
// @@@ When adding an element, count should increase by one.
Debug.Assert(arrList_count.initial == arr_list_count + 1);

// @@@ When removing a present element, count should decrease by one.
Debug.Assert(arrList_count.initial == arr_list_count - 1);

// @@@ If adding an element at a certain index out of range, a IndexOutOfRangeException should be thrown.
Debug.Assert(arrList_index_of_x.before < arrList_index_of_x.after && index <= arrList_count && index >= 0);

// @@@ If removing an element at a certain index out of range, return value should be -1.
Debug.Assert(arrList_index_of_x.before <= arrList_index_of_x.after && index < arrList_count && index >= 0);

// @@@ If inserting an element at a certain index out of range, a IndexOutOfRangeException should be thrown.
Debug.Assert(arrList_index_of_x.before == arrList_index_of_x.after && index <= arrList_count && index >= 0);

// @@@ If setting a value at a certain index out of range, a IndexOutOfRangeException should be thrown.
Debug.Assert(arrList_index_of_x.before == arrList_index_of_x.after && index < arrList_count && index >= 0);

// @@@ If getting value at a certain index out of range, a IndexOutOfRangeException should be thrown.
Debug.Assert(arrList_index_of_x.before = arrList_index_of_x.after && index < arrList_count && index >= 0);

// @@@ If the return value is false, index of x before is less than or equal to after.
Debug.Assert(!new_ret || old_arrList_index_of_x.before <= old_arrList_index_of_x.after);
```

