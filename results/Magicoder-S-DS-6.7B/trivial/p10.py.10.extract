    assert amnt <= 100 and amnt > 0, "Error: Transfer amount is not greater than 100 and is positive"--------------------            assert amnt < 101 and amnt > 0, "Transfer amount is not greater than 100 and is positive"--------------------        assert money >= 0, "Account's money should not be negateive." # @@@------------------------------------------------------------    assert person1.accounts[0].money == 50, 'Transfer amount is not equal to the required one'--------------------assert amnt <= 100 and amnt > 0, 'Transfer amount is not greater than 100 and is positive'--------------------assert transfer(Person('Anna'), Person('Bob'), 50) == True, "Fewer than 100"--------------------assert person1.accounts[0].money > 0, 'Balance for person1 account is zero'--------------------assert amnt > 0, "Amount must be positive."--------------------