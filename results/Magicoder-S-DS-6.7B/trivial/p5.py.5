    assert r.lin > 0, "Height of the rectangle should be positive"

    # height of r is less than or equal to n
    # Assert the height of the rectangle does not exceed the width of the rectangle
    assert r.lin <= r.exp, "Height of the rectangle cannot exceed the width of the rectangle"

    # Assert the mat is equal to the sum of the width and the height of the rectangle plus 2
    assert r.mat == r.exp+r.lin+2, "Mat should be equal to the sum of width and height of the rectangle plus 2"

