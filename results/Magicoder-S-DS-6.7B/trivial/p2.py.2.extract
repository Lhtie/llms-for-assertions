    assert sum(i**2 for i in p43_coeffs) == 1--------------------    assert sum([x**2 for x in p43_coeffs]) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum(i ** 2 for i in p43_coeffs) == 1----------------------------------------    assert sum([i**2 for i in p43_coeffs]) == 1, "The sum of squares of values in array should be 1"--------------------        assert sum([i**2 for i in p43_coeffs]) == 1--------------------    assert sum(i**2 for i in p43_coeffs) == 1, 'The sum of squares of values in the array is not 1.'--------------------assert sum([x**2 for x in p43_coeffs]) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum_of_squares == (n*n*(n+1)*(n+1))/4, f'Expected sum of squares to be ((n*n*(n+1)*(n+1))/4) but got {sum_of_squares}'--------------------    assert sum_squares == 1--------------------