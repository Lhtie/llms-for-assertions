    assert sum_of_squares == 1, f"The sum of squares of values in array is not 1: {sum_of_squares}"--------------------    assert total_sum == 1, f"Expected sum of squares of values in array to be 1, but got {total_sum}"--------------------    assert sum([i**2 for i in p43_coeffs]) == float(1), "Sum of squares of values is not equal to 1"--------------------    assert sum(map(lambda x: x**2, p43_coeffs)) == 1, 'Sum of squares of values in provided list is not 1.'--------------------    assert sum_of_squares == 1, "Sum of squares of values in array is not 1"--------------------    assert sum_of_squares == 1, f"The sum of squares of the array should be 1 but it is {sum_of_squares}."--------------------assert sum_of_squares(p43_coeffs) == 1--------------------    assert sum([i ** 2 for i in p43_coeffs]) == 1, 'Sum of squares of values in array is not 1'  # Assert statement--------------------    assert sum(i**2 for i in p43_coeffs) == 1, "Sum of squares of values in array is not 1"--------------------    assert sum_of_squares == 1, 'Sum of squares of values in array is not equal to 1'--------------------