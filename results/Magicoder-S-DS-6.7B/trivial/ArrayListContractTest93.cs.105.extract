            Debug.Assert(arrList.Count == Old_arrListCount + 1, "AddContract: Count assertion failed");----------------------------------------    Debug.Assert(Old_arrListCount == New_arrListCount - 1); // Added element is correctly added----------------------------------------Debug.Assert(New_Ret >= 0 && New_arrListContainsX);--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, new array list contains x");--------------------            Debug.Assert(New_Ret >= 0, "If the return value is non-negative, new array list contains x");--------------------    Debug.Assert(Old_arrListCount >= 0, "Old_arrListCount should be a non-negative number.");------------------------------------------------------------