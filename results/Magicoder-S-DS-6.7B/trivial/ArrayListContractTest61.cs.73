    [Test] 
    public void PUT_AddContract()
    {
        var arrList = new ArrayList();
        var x = PexRand.GetInt();
        int Old_arrListCount = arrList.Count;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        Debug.Assert(Old_arrListCount > -1, "Failure!");
        int New_Ret = arrList.Add(x);
        Debug.Assert(New_Ret > -1, "Failure!");
    }
    [Test] 
    public void PUT_RemoveContract()
    {
        var arrList = new ArrayList();
        int x = PexRand.GetInt();
        arrList.Add(x);
        int Old_arrListCount = arrList.Count;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        Debug.Assert(Old_arrListCount > -1 && Old_arrListIndexOfX > -1, "Failure!");
        arrList.Remove(x);
        Debug.Assert(arrList.Count == Old_arrListCount - 1, "Failure!");
    }
