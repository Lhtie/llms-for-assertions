using System.Diagnostics;

namespace ArrayList.Test
{
    public class ArrayListContractTest
    {
        [Test]
        public void PUT_AddContract([PexInlineData(0, 1, 2, 3)]int x)
        {
            ArrayList arrList = new ArrayList();
            int new_ret = arrList.Add(x);

            Debug.Assert(arrList.Count == 1, "$new_arrList_Count");
            Debug.Assert(arrList.Contains(x), "$new_arrList_contains_x");
            Debug.Assert(new_ret == 0, "$New_ret");
        }

        [Test]
        public void PUT_RemoveContract([PexInlineData(0, 1, 2, 3)]int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            arrList.Remove(x);

            Debug.Assert(arrList.Count == 0, "$new_arrList_Count");
            Debug.Assert(!arrList.Contains(x), "$new_arrList_contains_x");
        }

        [Test]
        public void PUT_InsertContract([PexInlineData(0, 1, 2, 3)]int x, [PexInlineData(0, 1)]int index)
        {
            ArrayList arrList = new ArrayList();
            arrList.Insert(index, x);

            Debug.Assert(arrList.Count == 1, "$new_arrList_Count");
            Debug.Assert(arrList.Contains(x), "$new_arrList_contains_x");
        }

        [Test]
        public void PUT_SetContract([PexInlineData(0, 1, 2, 3)]int x, [PexInlineData(0, 1)]int index)
        {
            ArrayList arrList = new ArrayList();
            arrList[index] = x;

            Debug.Assert(arrList.Count == 1, "$new_arrList_Count");
            Debug.Assert(arrList.Contains(x), "$new_arrList_contains_x");
        }

        [Test]
        public void PUT_GetContract([PexInlineData(0, 1)]int index)
        {
            ArrayList arrList = new ArrayList();
            arrList[index] = index;

            Debug.Assert(arrList[index] == index, "$New_ret");
            Debug.Assert(arrList.Contains(index), "$new_containsNewRet");
        }

        [Test]
        public void PUT_ContainsContract([PexInlineData(0, 1, 2, 3)]int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            bool contains = arrList.Contains(x);

            Debug.Assert(contains == true, "$New_ret");
        }

        [Test]
        public void PUT_IndexOfContract([PexInlineData(0, 1, 2, 3)]int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            int index = arrList.IndexOf(x);

            Debug.Assert(index == 0, "$New_ret");
            Debug.Assert(arrList.Contains(x), "$new_arrList_contains_x");
        }

        [Test]
        public void PUT_LastIndexOfContract([PexInlineData(0, 1, 2, 3)]int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            int index = arrList.LastIndexOf(x);

            Debug.Assert(index == 0, "$New_ret");
            Debug.Assert(arrList.Contains(x), "$new_arrList_contains_x");
        }

        [Test]
        public void PUT_CountContract()
        {
            ArrayList arrList = new ArrayList();
            int count = arrList.Count;

            Debug.Assert(count == 0, "$New_ret");
        }
    }
}
