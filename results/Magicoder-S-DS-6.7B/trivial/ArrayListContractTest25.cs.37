        {
            Debug.Assert(x == arrList[index], "Changing to element at index works.");
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(arrList.Contains((int)arrList[index]), "Getting the value at index works.");
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) == (arrList.IndexOf(x) != -1 && arrList.LastIndexOf(x) != -1), "Contains return correct value.");
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) != -1 && arrList.IndexOf(x) <= arrList.Count && arrList.IndexOf(x) >= 0, "IndexOf return correct value.");
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) != -1 && arrList.LastIndexOf(x) <= arrList.Count && arrList.LastIndexOf(x) >= 0, "LastIndexOf return correct value.");
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
