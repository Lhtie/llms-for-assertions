Debug.Assert(Old_arrListCount == New_arrListCount || New_Ret == -Old_arrListLastIndexOfX - 1);--------------------Debug.Assert(!New_Ret || (Old_arrListLastIndexOfX == -1));--------------------Debug.Assert(New_Ret >= 0);--------------------Debug.Assert(Old_arrListIndexOfX == -1 || Old_arrListIndexOfX == New_Ret);------------------------------------------------------------            Debug.Assert(New_Ret || Old_arrListLastIndexOfX >= 0);  // @@@ If the return value is false, last position of x in old list is >= -1----------------------------------------Debug.Assert(Old_arrListCount <= New_arrListCount && New_arrListCount >= 0, "New arrList count >= 0");-------------------- Debug.Assert(New_ret==Old_arrListCount+1 || New_arrListCount ==Old_arrListCount); // @@@ If the return value is the old count plus 1, or if new count == old count, then the item has not been added--------------------