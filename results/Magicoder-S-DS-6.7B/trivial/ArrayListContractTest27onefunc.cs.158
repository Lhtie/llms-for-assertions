```
This will verify that the Count property of the arrList has been incremented by 1 after adding the new element.--------------------```cs
Debug.Assert(Old_arrListLastIndexOfX >= Old_index);

// @@@ number of elements in array list is increased by 1.
Debug.Assert(Old_arrListCount + 1 == New_arrListCount);

// @@@ x is added into the array list at the correct position.
Debug.Assert(Old_arrListIndexOfX <= Old_index && New_arrListIndexOfX == Old_index);

// @@@ if the array list contains x, the index of x stays unchanged or shifts to the right.
Debug.Assert(New_arrListIndexOfX == Old_index || (Old_arrListContainsX && New_arrListIndexOfX == Old_index + 1));

// @@@ if the array list contains x, the last index of x is also updated to the new one.
