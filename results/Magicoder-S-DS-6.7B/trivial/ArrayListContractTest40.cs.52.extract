            Debug.Assert(New_arrListCount == Old_arrListCount + 1);--------------------Debug.Assert(New_arrList_IndexOf_x >= 0);------------------------------------------------------------            Debug.Assert(Old_arrListCount == New_arrListCount - 1);-------------------- Debug.Assert(Old_arrListCount + 1 == New_arrListCount);----------------------------------------Debug.Assert(New_arrListIndexOfX >= 0);------------------------------------------------------------