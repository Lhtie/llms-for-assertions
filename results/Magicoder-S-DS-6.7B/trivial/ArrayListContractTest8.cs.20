using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using System.Collections;

public class Test
{
    [Test]
    public void TestMethod1()
    {
        ArrayList arrList = new ArrayList();
        
        int x = 5;
        int index = 1;
        int oldCount = arrList.Count;
        int actualIndex = arrList.IndexOf(x);
        int actualLastIndex = arrList.LastIndexOf(x);
        bool containsX = arrList.Contains(x);

        arrList.Add(5);
        arrList.Remove(5);
        arrList.Insert(1, 5);
        arrList[1] = 5;
        int getIndexValue = (int)arrList[1];
    
        
        //The method Count should always return the correct number of elements in the ArrayList.
        int newCount = arrList.Count;
        Assert.AreEqual(oldCount, newCount);

        //The method IndexOf should return -1 when the element is not in the ArrayList.
        Assert.AreEqual(actualIndex, -1);

        //The method LastIndexOf should return -1 when the element is not in the ArrayList.
        Assert.AreEqual(actualLastIndex, -1);

        //The method Contains should return false when the element is not in the ArrayList.
        Assert.IsFalse(containsX);

    }
}
```

