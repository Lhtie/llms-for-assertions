```cs
public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    AssumePrecondition.IsTrue(true);

    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_arrListIndexOfX = arrList.IndexOf(x);
    bool Old_arrListContainsX = arrList.Contains(x);

    int New_Ret = arrList.LastIndexOf(x);

    int New_arrListCount = arrList.Count;
    int New_arrListIndexOfX = arrList.IndexOf(x);
    bool New_arrListContainsX = arrList.Contains(x);

    // @@@ If the return value is negative, old array's size is at least -1
    Debug.Assert(New_Ret < 0 ? Old_arrListCount == -1 : New_Ret >= Old_arrListCount);
    // @@@ New array index of x should be the same as old one
    Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);
    // @@@ New array count should be same as old array count plus 1
    Debug.Assert(New_arrListCount != Old_arrListCount ? New_arrListCount == Old_arrListCount + 1 : true);
    // @@@ Old array contains x should be true when new array does not
    Debug.Assert(New_arrListContainsX != Old_arrListContainsX ? !Old_arrListContainsX : true);

    PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
    PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
    PexObserve.ValueForViewing("$old_arrList_x", Old_x);
    PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
    PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
    PexObserve.ValueForViewing("$New_ret", New_Ret);
    PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
    PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
}
```--------------------The csharp code that uses Debug.Assert would look like this:

```cs
// This line assumes that arraylist contains the value 'x'
Debug.Assert(Old_arrListContainsX, "Old arraylist does not contain the specified value");

// This line ensures that the return value is less than the size of the arraylist if the arraylist contains 'x'
Debug.Assert((New_Ret <= New_arrListCount - 1), "Return value is greater than or equal to the arraylist size");

// This line asserts that if the return value is negative, old array's size is at least -1
Debug.Assert(New_Ret < -1 || New_Ret > Old_arrListCount, "Return value is negative, thus old arraylist size should be -1 or more");
```

