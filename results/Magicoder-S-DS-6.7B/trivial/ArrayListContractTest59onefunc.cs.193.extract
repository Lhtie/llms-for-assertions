            Debug.Assert(New_Ret == false || Old_arrListCount != -1, "The return value is false, old list's count is not -1");--------------------Debug.Assert(New_Ret, "The return value of the contains method is not true");--------------------Debug.Assert((New_Ret) == (Old_arrListCount != -1), "If the return value is false, old list's count is not -1");--------------------Debug.Assert(!New_Ret || Old_arrListCount != -1);--------------------Debug.Assert(New_Ret || Old_arrListCount != -1);--------------------            Debug.Assert(!New_Ret || Old_arrListCount != -1, "The old list's count is -1 if the return value is false");--------------------Debug.Assert(Old_arrListCount != -1, "If the return value is false, old list's count is not -1");--------------------Debug.Assert(!New_Ret || Old_arrListCount != -1);--------------------Debug.Assert(!New_Ret || Old_arrListCount != -1, "If the return value is false, old list's count is not -1");--------------------Debug.Assert(New_Ret == false, "// @@@ If the return value is false, old list's count is not -1");--------------------