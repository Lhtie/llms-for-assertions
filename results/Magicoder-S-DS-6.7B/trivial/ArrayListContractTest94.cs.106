[Test]
public void TestAddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    Assert.IsTrue(oldValues["old_arrList_Count"] + 1 == newValues["new_arrList_Count"]);
    Assert.AreEqual(oldValues["old_arrList_IndexOf_x"], newValues["new_arrList_IndexOf_x"], "IndexOf should not change after Add.");
    Assert.AreEqual(oldValues["old_arrList_LastIndexOf_x"], newValues["new_arrList_LastIndexOf_x"], "LastIndexOf should not change after Add.");
    Assert.AreEqual(oldValues["old_arrList_contains_x"] || newValues["new_arrList_contains_x"], true, "Contains should not change after Add.");
}

[Test]
public void TestRemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    Assert.AreEqual(oldValues["old_arrList_Count"], newValues["new_arrList_Count"] + 1, "Count should decrease by 1 after Remove.");
    Assert.AreEqual(oldValues["old_arrList_IndexOf_x"], newValues["new_arrList_IndexOf_x"], "IndexOf should not change after Remove.");
    Assert.AreEqual(oldValues["old_arrList_LastIndexOf_x"], newValues["new_arrList_LastIndexOf_x"], "LastIndexOf should not change after Remove.");
    Assert.AreEqual(oldValues["old_arrList_contains_x"], newValues["new_arrList_contains_x"], "Contains should not change after Remove.");
}

