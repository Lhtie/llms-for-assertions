using NUnit.Framework;
using System.Collections;

class ArrayListContractTest
{
    [Test]
    public void TestArrayListContract()
    {
        ArrayList arrList = new ArrayList();

        int Old_arrListCount = arrList.Count;
        int Old_arrListIndexOfX = -1;
        int Old_arrListLastIndexOfX = -1;
        bool Old_arrListContainsX = false;

        arrList.Add(10);

        // Add Contract
        int New_arrListCount = arrList.Count;
        int New_arrListIndexOfX = arrList.IndexOf(10);
        int New_arrListLastIndexOfX = arrList.LastIndexOf(10);
        bool New_arrListContainsX = arrList.Contains(10);

        Debug.Assert(Old_arrListCount == New_arrListCount - 1);
        Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);
        Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
        Debug.Assert(Old_arrListContainsX == New_arrListContainsX);

        // Remove Contract
        arrList.Remove(10);

        Old_arrListCount = arrList.Count;
        New_arrListCount = arrList.Count;
        New_arrListIndexOfX = arrList.IndexOf(10);
        New_arrListLastIndexOfX = arrList.LastIndexOf(10);
        New_arrListContainsX = arrList.Contains(10);

        Debug.Assert(Old_arrListCount == New_arrListCount + 1);
        Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);
        Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
        Debug.Assert(Old_arrListContainsX == New_arrListContainsX);

        // Insert Contract
        arrList.Add(10);

        Old_arrListCount = arrList.Count;
        arrList.Insert(0, 20);

        New_arrListCount = arrList.Count;
        New_arrListIndexOfX = arrList.IndexOf(20);
        New_arrListLastIndexOfX = arrList.LastIndexOf(20);
        New_arrListContainsX = arrList.Contains(20);

        Debug.Assert(Old_arrListCount == New_arrListCount - 1);
        Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
        Debug.Assert(New_arrListIndexOfX == 0);
        Debug.Assert(New_arrListContainsX);

        // Set Contract
        arrList[0] = 30;

        New_arrListIndexOfX = arrList.IndexOf(30);
        New_arrListLastIndexOfX = arrList.LastIndexOf(30);

        Debug.Assert(New_arrListLastIndexOfX == 0);
        Debug.Assert(New_arrListIndexOfX == 0);

        // Get Contract
        int Old_index = 0;
        int New_Ret = (int)(arrList[Old_index]);
        bool New_containsNewRet = arrList.Contains(New_Ret);

        Debug.Assert(New_containsNewRet);

        // Contains Contract
        bool New_Ret1 = arrList.Contains(10);
        bool New_Ret2 = arrList.Contains(20);
        bool New_Ret3 = arrList.Contains(30);

        Debug.Assert(New_Ret1 == false && New_Ret2 == false && New_Ret3 == true);

        // IndexOf Contract
        int arrIndex = arrList.IndexOf(30);
        int Old_x = 30;
        bool contains = arrList.Contains(Old_x);
        int New_ret = arrList.IndexOf(Old_x);

        Debug.Assert(contains && New_ret == arrIndex);

        // LastIndexOf Contract
        int Old_arrListLastIndex = arrList.LastIndexOf(30);
        New_ret = arrList.LastIndexOf(30);

