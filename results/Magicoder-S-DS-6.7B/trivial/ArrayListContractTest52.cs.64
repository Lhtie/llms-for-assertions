// @@@ The operation should not modify the state.
// @@@ i.e. arrList should not be modified after Add, Remove, Insert or Set
// @@@ so we ensure that old and new counts and x index, last index, and contains information are the same
Debug.Assert(Old_arrListCount == New_arrListCount, "The size of array should not change after Contains operation.");
Debug.Assert(Old_x == New_Ret, "The x value should not change after Contains operation.");
Debug.Assert(Old_arrListIndexOfX == arrList.IndexOf(Old_x), "The index of x should not change after Contains operation.");
Debug.Assert(Old_arrListLastIndexOfX == arrList.LastIndexOf(Old_x), "The last index of x should not change after Contains operation.");
Debug.Assert(Old_arrListContainsX == New_Ret, "The presence of x should not change after Contains operation.");
```
