Debug.Assert(New_Ret < 0 && Old_arrListLastIndexOfX == -1, "If the return value is negative, last index of x in old array is -1 ");----------------------------------------            Debug.Assert(New_Ret < 0 || Old_arrListLastIndexOfX == -1);----------------------------------------    Debug.Assert(New_Ret >= (Old_arrListLastIndexOfX == -1 ? -1 : Old_arrListLastIndexOfX), "Invalid Last Index Of 'X'");----------------------------------------            Debug.Assert(New_Ret < 0 || New_Ret == arrList.LastIndexOf(x));  // If the return value is negative, last index of x in old array is -1   --------------------Debug.Assert(Old_arrListLastIndexOfX == -1);----------------------------------------Debug.Assert(Old_arrListLastIndexOfX == -1);--------------------