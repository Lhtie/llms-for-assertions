using System.Collections;
using System.Diagnostics;

[TestFixture, PexClass]
public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Assume.That(arrList, Is.Any<ArrayList>());
        Assume.That(x, Is.Not.Null);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        int New_Ret = arrList.Add(x);

        Debug.Assert(arrList.Count == Old_arrListCount + 1);
        Debug.Assert(arrList[New_Ret - 1] == x);

        Debug.Assert(Old_x != x ? arrList.IndexOf(x) : Old_arrListIndexOfX == New_Ret);
        Debug.Assert(Old_x != x ? arrList.LastIndexOf(x) : Old_arrListLastIndexOfX >= New_Ret);
        Debug.Assert(Old_x != x ? arrList.Contains(x) : Old_arrListContainsX == arrList.Contains(x));
    }

    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Assume.That(arrList, Is.Any<ArrayList>());
        Assume.That(arrList.Contains(x));

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Remove(x);

        Debug.Assert(arrList.Count == Old_arrListCount - 1);
        Debug.Assert(arrList.IndexOf(x) == Old_arrListIndexOfX == -1);
        Debug.Assert(arrList.LastIndexOf(x) == Old_arrListLastIndexOfX == -1);

        bool New_arrListContainsX = arrList.Contains(x);


        Debug.Assert(New_arrListContainsX != Old_arrListContainsX);
    }

    [PexMethod]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        Assume.That(arrList, Is.Any<ArrayList>());
        Assume.That(index <= arrList.Count && index >= 0);
        Assume.That(x, Is.Not.Null);

        int Old_arrListCount = arrList.Count;
        int Old_x = x;
        int Old_arrListIndexOfX = arrList.IndexOf(x);
        int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
        bool Old_arrListContainsX = arrList.Contains(x);

        arrList.Insert(index, x);

        Debug.Assert(arrList.Count == Old_arrListCount + 1);
        Debug.Assert(arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == arrList.IndexOf(x));
        Debug.Assert(Old_arrListContainsX != arrList.Contains(x));
    }

