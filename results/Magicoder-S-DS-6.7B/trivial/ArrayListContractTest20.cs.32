import re

src = """
// @@@ index of x in old array is geq minus 1 
"""
src = src.replace("//","// ")

for line in src.split('\n'): # for each line in the source
    match = re.search('(// @@@ .*?)\r', line)
    if match: # if there is a match
        print(match.group(1)) # print the match which is the c# code
```

