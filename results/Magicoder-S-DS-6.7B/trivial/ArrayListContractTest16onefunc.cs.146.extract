            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------            Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------    Debug.Assert(true);----------------------------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------Debug.Assert(Old_arrListLastIndexOfX <= New_arrListCount);--------------------        Debug.Assert(Old_arrListIndexOfX <= New_arrListCount); // last index of x in old array is smaller than or equal to new array size--------------------