}
```
Each line of code after assert statements stands for the following conditions:
- `+++`: The method/property should behave as if it always returns the count increased by 1 after each operation.
- `---`: The method/property should behave as if it always returns the count decreased by 1 after each operation.
- `===`: The method/property should behave as if it always returns the same count after each operation.
- `^^^`: The method/property should behave as if it always contains the retrieved value.
- `+++`: The method should behave as if it always returns true if the value exists in the list, and otherwise false.
- `~~~`: The method/property should behave as if it always returns the same index of x (the first occurrence or the last one).
- `@@@`: The method/property should behave as if it always holds true.--------------------```cs
Debug.Assert(arrListCount < Int32.MaxValue); // @@@ The Count must not be Int32.MaxValue
Debug.Assert(Old_arrListCount >= 0 && New_arrListCount >= 0); // @@@ The Count should not be a negative number
Debug.Assert(Old_x == New_Ret); // @@@ If the element is in the list, it should be returned by Add, Insert, Set
Debug.Assert((Old_arrListIndexOfX == New_arrListIndexOfX && Old_arrListLastIndexOfX >= New_arrListLastIndexOfX) || Old_arrListIndexOfX == -1); // @@@ If the element is not in the list, -1 should be returned
Debug.Assert((Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX == -1) || (Old_arrListLastIndexOfX == New_arrListLastIndexOfX)); // @@@ If the element is not in the list, -1 should be returned
Debug.Assert((Old_arrListContainsX == New_arrListContainsX) || (!Old_arrListContainsX && New_arrListContainsX)); // @@@ If the element is not in the list, false should be returned
Debug.Assert((Old_arrListContainsX == New_arrListContainsX) || (Old_arrListContainsX && !New_arrListContainsX)); // @@@ If the element is in the list and it is removed, true should be returned
Debug.Assert(!Old_arrListContainsX || (New_arrListIndexOfX > Old_arrListIndexOfX && New_arrListLastIndexOfX > Old_arrListLastIndexOfX)); // @@@ If the element is added with index, index should not decrease
Debug.Assert(Old_arrListContainsX || (Old_arrListIndexOfX != New_arrListIndexOfX && Old_arrListLastIndexOfX != New_arrListLastIndexOfX)); // @@@ If the element is removed, it should return -1
Debug.Assert(Old_arrListCount == 0 || Old_arrListCount -1 == New_arrListCount || Old_arrListCount +1 == New_arrListCount); // @@@ Count should increase, decrease or be untouched when we call Add or Remove
Debug.Assert(New_Ret >= Old_arrListCount); // @@@ When we call Add or Insert, count should not change or decrease
Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX || New_arrListIndexOfX == Old_arrListCount); // @@@ When Remove, IndexOf and LastIndexOf should return -1 or the count
Debug.Assert(New_arrListIndexOfX == Old_arrListLastIndexOfX || New_arrListIndexOfX -1 == Old_arrListLastIndexOfX); // @@@ When Remove, IndexOf and LastIndexOf should return -1 or the count
Debug.Assert(Old_arrListContainsX || (Old_arrListLastIndexOfX == -1 && Old_arrListIndexOfX == -1)); // @@@ If an element is removed from the list, we should get true or false for Contains
