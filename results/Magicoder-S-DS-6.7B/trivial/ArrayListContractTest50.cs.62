    // "===" represents that the counts are the same after the insert operation
}

public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    Debug.Assert(Old_arrListCount==New_arrListCount);
    // "===" represents that the counts are the same after the set operation 
}

public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    Debug.Assert(New_containsNewRet==true);
    // "^^^" represents that the retrieved value is in the array
}

public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    Debug.Assert(New_Ret==true?"+++":"---");
    // "+++" represents that the x is in the array
    // "---" represents that the x is not in the array
}

public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
