[TestFixture, PexClass]
public partial class ArrayListContractTest
{
    [PexMethod]
    public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList.Count + 1 == arrList.Add(x));
        Debug.Assert(arrList.Contains(x));
        Debug.Assert(arrList.IndexOf(x) == arrList.Count - 1);
        Debug.Assert(arrList.LastIndexOf(x) == arrList.Count - 1);
    }

    [PexMethod]
    public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList.Count == arrList.Remove(x) + 1);
        Debug.Assert(!arrList.Contains(x));
        Debug.Assert(arrList.IndexOf(x) == -1);
        Debug.Assert(arrList.LastIndexOf(x) == -1);
    }

    [PexMethod]
    public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        Debug.Assert(arrList.Count + 1 == arrList.Insert(index, x));
        Debug.Assert(arrList.Contains(x));
        Debug.Assert(arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == index);
    }

    [PexMethod]
    public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
    {
        arrList[index] = x;
        Debug.Assert(arrList.Count == arrList.Count);
        Debug.Assert(arrList.Contains(x));
        Debug.Assert(arrList.IndexOf(x) == index);
        Debug.Assert(arrList.LastIndexOf(x) == index);
    }

    [PexMethod]
    public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
    {
        Debug.Assert(arrList[index] == arrList[index]);
    }

    [PexMethod]
    public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        Debug.Assert(arrList.Contains(x) == arrList.Contains(x));
    }

    [PexMethod]
    public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
    {
        // This test assumes that `IndexOf` and `LastIndexOf` behave the same
        Debug.Assert(arrList.IndexOf(x) == arrList.LastIndexOf(x));
        if (arrList.IndexOf(x) != -1)
