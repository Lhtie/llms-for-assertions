            // @@@ If the return value is negative, new list doesnt contain x
        }
    }
}
"""

pattern = "@@@.*"

matches = re.findall(pattern, code, re.DOTALL)

for match in matches:
    parts = match.split(" ")
    assertion_type = parts[2]
    test = " ".join(parts[3:])

    if assertion_type == "If":
        # Use Debug.Assert() for If assertions.
        assertion = "Debug.Assert({});".format(test.replace("new list doesnt contain x", "New_arrListContainsX == false"))
    else:
        # Unknown assertion type, skip.
        continue

    print(assertion)
```

