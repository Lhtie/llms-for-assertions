--------------------            Debug.Assert(New_Ret || New_arrListIndexOfX < Old_arrListIndexOfX); // @@@ If the return value is true, the last position of x is atleast arrListIndexOfX in the new array --------------------Debug.Assert(Old_arrListIndexOfX <= New_arrListIndexOfX, "Last position of x should be at least arrListIndexOfX after an operation that adds x to the array.");--------------------        Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "Count mismatch");----------------------------------------------------------------------------------------------------        Debug.Assert(Old_arrListCount == New_arrListCount - 1);--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "Counts should be equal");--------------------