```python
import math

class Shape:
    def __init__(self, typ):
        assert type(typ) == str, 'Typ must be a string'
        self.typ = typ
        self.area = -1
        self.perimeter = -1

class Rectangle(Shape):
    def __init__(self, l, w):
        assert isinstance(l, (int, float)) and isinstance(w, (int, float)), "Invalid values passed in"
        assert l > 0 and w > 0, "Invalid length and width values"
        super().__init__("Rectangle")
        self.length = l
        self.width = w
        self.area = l * w
        self.perimeter = 2 * (l + w)

    def flipped(self):
        return Rectangle(self.width, self.length)


class Circle(Shape):
    def __init__(self, r):
        assert isinstance(r, (int, float)), "Invalid values passed in"
        assert r > 0, "Invalid radius value"
        super().__init__("Circle")
        self.radius = r
        self.area = math.pi * r * r
        self.perimeter = 2 * math.pi * r


def compare_a(s1, s2):
    '''returns area of shape with larger area'''
    a1, a2 = s1.area, s2.area
    # a1 and a2 holds the correct value of area
    assert a1 >= 0 and a2 >= 0, 'Shape areas should be positive'
    return a1 if a1 > a2 else a2
```--------------------
