            Debug.Assert(New_Ret != -1, "Return value is negative.");--------------------Debug.Assert(New_Ret >= 0); // If the return value is non-negative --------------------Debug.Assert((arrList.IndexOf(x) >= 0) == (Old_arrListContainsX), "IndexOf returns a negative number if item is not present");--------------------            Debug.Assert(New_Ret >= 0, "The return value should be non-negative or equal to -1.");--------------------Debug.Assert(New_Ret >= 0, "If the return value is non-negative, list counts of new and old array are equal.");--------------------Debug.Assert(New_Ret != -1);--------------------            Debug.Assert(New_Ret >= 0 && New_arrListCount == Old_arrListCount);------------------------------------------------------------Debug.Assert(New_Ret != -1 && Old_arrListCount == New_arrListCount);--------------------