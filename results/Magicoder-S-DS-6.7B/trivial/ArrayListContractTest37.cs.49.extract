            Debug.Assert(Old_arrListCount == New_arrListCount - 1);  // @@@ new array size is one less than old--------------------Debug.Assert((int)arrList[0] == (Old_arrListCount == 0 ? Old_x : (int)arrList[0] + Old_x));--------------------                Debug.Assert(false, "Add() method is throwing an exception.");----------------------------------------Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);------------------------------------------------------------Debug.Assert(Old_arrListCount >= 0);----------------------------------------    Debug.Assert(arrList.Count == New_Ret + 1);--------------------