Debug.Assert(Old_arrListLastIndexOfX == -1 || Old_arrListLastIndexOfX >= -1 && Old_arrListLastIndexOfX <= Old_arrListCount);
Debug.Assert(New_arrListCount == Old_arrListCount);
Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX);
Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);
Debug.Assert(!New_Ret || arrList.Count > 0);
Debug.Assert(New_Ret==arrList.Contains(x));
```

