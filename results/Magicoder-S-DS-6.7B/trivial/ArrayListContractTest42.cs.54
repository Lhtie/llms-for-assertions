using System;
using System.Text.RegularExpressions;

namespace RegexTest
{
    class Program
    {
        static void Main(string[] args)
        {    
            string codeSnippet = @"
                // @@@ the array contains New_Ret 
                // Here is comment @@@ I will find this"; 

            var matchCollection = Regex.Matches(codeSnippet, "@@@[^\\r\\n]*"); 

            foreach (Match match in matchCollection)
