    int Old_arrListCount = 5; // Actual count before operation
    int Old_x = 3; // Element for IndexOf
    int Old_arrListIndexOfX = 2; // Actual IndexOf X count
    int Old_arrListLastIndexOfX = 3; // Actual LastIndexOf X count
    bool Old_arrListContainsX = true; // Contains x or not

    ArrayList objList = new ArrayList();
    objList.Add(1);
    objList.Add(3); // X is added to the list
    objList.Add(2);

    // Act
    int New_Ret = IndexOf(3);

    // Assert
    Assert.Equal(New_Ret, Old_arrListIndexOfX);
}
