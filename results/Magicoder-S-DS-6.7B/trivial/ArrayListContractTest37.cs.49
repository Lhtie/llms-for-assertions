```cs
﻿using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Exceptions;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = -1;
            int Old_arrListLastIndexOfX = -1;
            bool Old_arrListContainsX = false;

            try
            {
                Old_arrListIndexOfX = arrList.IndexOf(x);
            }
            catch { }

            try
            {
                Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            }
            catch { }

            Old_arrListContainsX = arrList.Contains(x);

            try
            {
                arrList.Add(x);
            }
            catch
            {
                Debug.Assert(false, "Add() method is throwing an exception.");
            }

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = -1;
            int New_arrListLastIndexOfX = -1;
            bool New_arrListContainsX = false;

            try
            {
                New_arrListIndexOfX = arrList.IndexOf(x);
            }
            catch { }

            try
            {
                New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            }
            catch { }

            New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX, "The index of the old list should not be smaller than the index of the new list.");
            
            if(Old_arrListIndexOfX >= 0)
            {
                Debug.Assert(New_arrListCount == Old_arrListCount + 1, "Count should be increased by one after add operation.");
            }
            else
            {
                Debug.Assert(New_arrListCount == Old_arrListCount, "Count should be same after add operation if the element is not present.");
            }

            if(Old_arrListIndexOfX >= 0)
            {
                Debug.Assert(New_arrListIndexOfX == Old_arrListIndexOfX, "The index of the element in new array list should be the old index.");
            }
            else
            {
                Debug.Assert(New_arrListIndexOfX == Old_arrListCount, "After adding element, it should be at the end in the new list if the element was not present in the list.");
            }

            Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, "The last index of the old list should not be smaller than the last index of the new list.");
            
            if(Old_arrListIndexOfX >= 0)
            {
                Debug.Assert(New_arrListCount == Old_arrListCount + 1, "Count should be increased by one after add operation.");
            }
            else
            {
                Debug.Assert(New_arrListCount == Old_arrListCount, "Count should be same after add operation if the element is not present.");
            }
            
            Debug.Assert(New_arrListContainsX == Old_arrListContainsX, "Contains should keep the same value.");
        }
    .................. [Other PUT methods and their corresponding Debug.Assert statements]
    }
}
```
