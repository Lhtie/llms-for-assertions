[TestMethod]
public void PUT_LastIndexOfContract()
{
    var arrList = new ArrayList(3);
    arrList.Add(1);
    arrList.Add(2);
    arrList.Add(3);
    arrList.Add(1);

    int result = (int)arrList.LastIndexOf(1);

    Assert.AreEqual(result, 3);
}
[TestMethod]
public void PUT_CountContract()
{
    var arrList = new ArrayList(3);
    arrList.Add(1);
    arrList.Add(2);
    arrList.Add(3);
    arrList.Add(1);

    int result = arrList.Count;

    Assert.AreEqual(result, 4);
}
[TestMethod]
public void PUT_IndexOfContract()
{
    var arrList = new ArrayList(3);
    arrList.Add(1);
    arrList.Add(2);
    arrList.Add(3);
    arrList.Add(1);

    int result = (int)arrList.IndexOf(1);

    Assert.AreEqual(result, 0);
}
