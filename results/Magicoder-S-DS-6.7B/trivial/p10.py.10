```python
import random

class Account:
    def __init__(self, money):
        self.money = money

class Person:
    def __init__(self, name):
        self.name = name
        self.accounts = [Account(random.randint(0,100)) for _ in range(5)]

def transfer(frm, to, amnt):
    """ attempts to transfers "amnt" money from "frm" to "to" """
    assert amnt <= 100, "Transfer amount is greater than 100"
    assert amnt > 0, "Transfer amount is not positive"
    
    for acnt in frm.accounts:
	if(acnt.money >= amnt):
            acnt.money -= amnt
            to.accounts[0].money += amnt
            return True

    return False

# test cases
alice = Person("Alice")
bob = Person("Bob")
frm = alice
to = bob
amnt = random.randint(1, 100)  # Assuming random number as the amount to be transfered
transfer(frm, to, amnt)
```

