import re

source_code = """
// Your source code here...
"""

def extract_asserts(source_code):
    assert_statements = re.findall(r'\/\/\ @\@\@(.*?)\n', source_code)
    for statement in assert_statements:
        print('Debug.Assert({});'.format(statement.strip()))

extract_asserts(source_code)
```

