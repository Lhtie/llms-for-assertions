            Debug.Assert(New_Ret < 0 && Old_arrListCount != -1);--------------------            Debug.Assert(Old_arrListCount != -1 && New_Ret == -1 || New_Ret >= 0 && New_Ret < Old_arrListCount);--------------------Debug.Assert(Old_arrListCount != -1, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(!(New_Ret < 0 && Old_arrListCount != -1));--------------------Debug.Assert(New_arrListCount < 0 || Old_arrListCount != -1); // @@@ If the return value is negative, old list size is not -1 --------------------Debug.Assert(New_Ret < 0 || Old_arrListCount != -1, "The list size is -1 only when the return value is negative.");--------------------            Debug.Assert(New_Ret < 0 || Old_arrListCount != -1, "If the return value is negative, old list size is not -1");--------------------Debug.Assert(New_Ret == -1 || Old_arrListCount > 0);--------------------Debug.Assert(New_Ret < 0 && Old_arrListCount != -1, "An error has occurred");--------------------Debug.Assert(Old_arrListCount != -1);--------------------