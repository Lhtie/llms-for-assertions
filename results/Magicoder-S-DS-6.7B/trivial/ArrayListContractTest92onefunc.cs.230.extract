            Debug.Assert(New_Ret >= 0, "If the return value is non-negative, index of x in old array is more than or equal to index in new list.");--------------------Debug.Assert(New_Ret >= 0 && Old_arrListIndexOfX >= New_Ret, "If the return value is non-negative, index of x in old array is more than or equal to index in new list.");--------------------            Debug.Assert(New_Ret >= 0 && Old_arrListIndexOfX <= New_Ret, "If the return value is non-negative, index of x in old array is more than or equal to index in new list");--------------------Debug.Assert(New_Ret >= 0 && New_Ret >= Old_arrListIndexOfX, "If the return value is non-negative, index of x in old array is more than or equal to index in new list");--------------------Debug.Assert(New_Ret != -1 && Old_arrListIndexOfX >= New_arrListIndexOfX);--------------------Debug.Assert(Old_arrListCount >= 0);   // It is supposed to not be negative------------------------------------------------------------Debug.Assert(New_Ret >= 0 && Old_arrListIndexOfX >= New_Ret);--------------------Debug.Assert(New_Ret >= 0, "'LastIndexOf' returned a negative value!");--------------------