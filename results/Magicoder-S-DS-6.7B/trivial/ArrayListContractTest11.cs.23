[Test]
public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
{
    int Old_arrListCount = arrList.Count;
    int Old_index = index;
    
    object New_Ret = arrList[index];
    
    bool New_containsNewRet = arrList.Contains(New_Ret);

    if (Old_index >= 0 && Old_index < Old_arrListCount)
    {
        Assert.IsNotNull(New_Ret);
        Assert.AreEqual(Old_index, arrList.IndexOf(New_Ret));
    }

    Assert.AreEqual(Old_arrListCount, arrList.Count);
    Assert.IsTrue(New_containsNewRet);
}

[Test]
public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    
    int New_Ret = arrList.Add(x);
    int New_arrListCount = arrList.Count;

    Assert.IsTrue(New_Ret >= 0);
    Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
}

[Test]
public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    
    arrList.Remove(x);

    int New_arrListCount = arrList.Count;

    if (Old_arrListCount == New_arrListCount || Old_arrListCount == 0)
    {
        Assert.IsTrue(!arrList.Contains(x));
    }
    else
    {
        Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
    }
}

[Test]
public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;
    int Old_x = x;
    int Old_index = index;

    arrList.Insert(index, x);

    int New_arrListCount = arrList.Count;

    if (Old_index < 0 || Old_index > Old_arrListCount)
    {
        Assert.IsFalse(arrList.Contains(x));
    }
    else
    {
        Assert.IsTrue(arrList.Contains(x));
        Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
    }
}

[Test]
public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
{
    int Old_arrListCount = arrList.Count;
    int Old_index = index;

    arrList[index] = x;

    int New_arrListCount = arrList.Count;

    if (Old_index >= 0 && Old_index < Old_arrListCount)
    {
        Assert.IsTrue(arrList.Contains(x));
        Assert.AreEqual(Old_index, arrList.IndexOf(x));
        Assert.AreEqual(Old_arrListCount, New_arrListCount);
    }
    else
    {
        Assert.IsFalse(arrList.Contains(x));
        Assert.AreEqual(Old_arrListCount, arrList.Count);
    }
}
