    Debug.Assert(New_Ret==Old_arrListCount+1);--------------------Debug.Assert(arrListCount < Int32.MaxValue); // @@@ The Count must not be Int32.MaxValue--------------------Debug.Assert(Old_arrListCount < New_arrListCount, "After adding an item, count should increase");----------------------------------------Debug.Assert(New_ret >= Old_arrListCount, "if the return value is true, last index of x in new array is <= size of old array");------------------------------------------------------------    Debug.Assert(arrList.Count == arrList.Old_arrListCount + 1);--------------------Debug.Assert(arrList.Count > 0); //The list should not be empty--------------------Debug.Assert(Old_arrListCount < New_arrListCount || Old_arrListCount > 0);--------------------