--------------------Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true); --------------------Debug.Assert(New_Ret >= 0, "Return value from IndexOf is negative");--------------------            Debug.Assert(New_Ret >= 0 && New_arrListLastIndexOfX <= Old_arrListCount, "Expected new array list's last index of x is less than or equal to old array list's count");--------------------Debug.Assert(New_Ret >= 0, string.Format("LastIndexOf(x) is not less than or equal to the old ArrayList count"));--------------------                Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount);----------------------------------------Debug.Assert(New_Ret >= 0, $"'$old_arrList_x' is not found.");--------------------            Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount); --------------------Debug.Assert(New_Ret >= 0 || New_arrListCount <= Old_arrListCount, "If the return value is non-negative, new array list's last index of x is <= old arrays count");--------------------