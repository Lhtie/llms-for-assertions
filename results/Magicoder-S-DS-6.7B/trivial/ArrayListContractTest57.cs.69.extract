            Debug.Assert(Old_arrListCount <= New_arrListCount);--------------------        Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX, "If the return value is true, index of x before is less than or equal to after ");--------------------Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOf || New_arrListIndexOfX == Old_arrListCount);----------------------------------------            Debug.Assert(New_Ret, "The return value is true, the index of x before is less than or equal to after.");--------------------Debug.Assert(New_arrListCount >= 1, "New count shall be at least 1");--------------------Debug.Assert(New_arrList_Count > Old_arrList_Count);----------------------------------------Debug.Assert((Old_arrListIndexOfX == -1) && (Old_arrListLastIndexOfX == -1) && (Old_arrListContainsX == false) && (New_arrListIndexOfX == Old_arrListCount) && (New_arrListLastIndexOfX == New_arrListCount) && (New_arrListContainsX == true), "The element " + x + "is not added at the end of the list");----------------------------------------