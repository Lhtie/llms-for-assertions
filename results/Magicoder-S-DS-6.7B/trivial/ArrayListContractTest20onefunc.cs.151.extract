            Debug.Assert(Old_arrListIndexOfX >= -1, "@@@ index of x in old array is geq minus 1");--------------------    Debug.Assert(Old_arrListIndexOfX >= -1, "index of x in old array is geq minus 1");--------------------            Debug.Assert(Old_arrListIndexOfX >= -1, "index of x in old array is geq minus 1 ");----------------------------------------Debug.Assert(Old_arrListIndexOfX >= -1);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount - 1, "The count of the list should be greater or equal to count - 1");----------------------------------------	Debug.Assert(Old_arrListIndexOfX >= -1, "Index of x in old array is greater than or equal to minus 1.");----------------------------------------Debug.Assert(Old_arrListIndexOfX >= -1, "index of x in old array is geq minus 1");--------------------