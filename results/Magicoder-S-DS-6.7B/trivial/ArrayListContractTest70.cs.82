```cs
[TestFixture]
public class ArrayListSpecTest
{
    [Test]
    public void Spec_Add()
    {
        int x = 10;
        ArrayList arrList = new ArrayList();

        // Assume the initial state of the arrayList
        AssumePrecondition.IsTrue(arrList.Count == 0, "Initial state is empty");
        AssumePrecondition.IsFalse(arrList.Contains(x), "List does not contain x initially");

        // Perform the operation
        arrList.Add(x);

        // Make assertions
        Assert.IsNotNull(arrList, "Added value is not null");
        Assert.IsTrue(arrList.Count == 1, "Count is 1 after adding x");
        Assert.IsTrue(arrList.Contains(x), "List now contains x");
        Assert.IsTrue(arrList.IndexOf(x) == 0, "x is at index 0");
        Assert.IsTrue(arrList.LastIndexOf(x) == 0, "x last index is 0");
    }

    [Test]
    public void Spec_Remove()
    {
        int x = 10;
        ArrayList arrList = new ArrayList(){x};

        // Assume the initial state of the arrayList
        AssumePrecondition.IsTrue(arrList.Count == 1, "Initial state has 1 element");
        AssumePrecondition.IsTrue(arrList.Contains(x), "List contains x initially");

        // Perform the operation
        arrList.Remove(x);

        // Make assertions
        Assert.IsNotNull(arrList, "Removed value is not null");
        Assert.IsTrue(arrList.Count == 0, "Count is 0 after removing x");
        Assert.IsFalse(arrList.Contains(x), "List no longer contains x");
        Assert.IsTrue(arrList.IndexOf(x) == -1, "x is no longer at an index");
        Assert.IsTrue(arrList.LastIndexOf(x) == -1, "x last index is no longer 0");
    }

    [Test]
    public void Spec_Insert()
    {
        int x = 10;
        int index = 0; // can be 0 due to the way the arrayList is structured
        ArrayList arrList = new ArrayList();

        // Assume the initial state of the arrayList
        AssumePrecondition.IsTrue(arrList.Count == 0, "Initial state is empty");
        AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0, "index is valid");
        AssumePrecondition.IsFalse(arrList.Contains(x), "List does not contain x initially");

        // Perform the operation
        arrList.Insert(index, x);

        // Make assertions
        Assert.IsNotNull(arrList, "Inserted value is not null");
        Assert.IsTrue(arrList.Count == 1, "Count is 1 after inserting x");
        Assert.IsTrue(arrList.Contains(x), "List now contains x");
        Assert.IsTrue(arrList.IndexOf(x) == 0, "x is at index 0");
        Assert.IsTrue(arrList.LastIndexOf(x) == 0, "x last index is 0");
    }

    // And so on...
}
```
The tests are structured in such a way that they are following the contract:
They cover the happy path, i.e., every precondition should be true for the test case to run successfully.

It is crucial to maintain this invariant while writing the tests.

Please be aware that writing automated property-based tests like these takes some time and might not directly lead to real code improvement. However, they increase confidence in your code as they can be run frequently and at any scale.--------------------Here you can find csharp assert statements that correspond to the comments that start with "@@@".

