Debug.Assert(New_arrListLastIndexOfX == Old_arrListLastIndexOfX || New_arrListLastIndexOfX == Old_arrListCount, "Last index of inserted element should reflect presence or if added element is the last element");
Debug.Assert(New_arrListContainsX == true, "Contains method should reflect presence of inserted element");

Debug.Assert(index >= 0, "Index for set should be greater than or equal to 0");
Debug.Assert(index < Old_arrListCount, "Index for set should be less than old array list count");
