Debug.Assert(New_arrListIndexOfX != Old_arrListIndexOfX, "Index of removed element should change");
Debug.Assert(New_arrListLastIndexOfX != Old_arrListLastIndexOfX, "Last index of removed element should change");
Debug.Assert(New_arrListContainsX == false, "Contains method should reflect removal of element");

