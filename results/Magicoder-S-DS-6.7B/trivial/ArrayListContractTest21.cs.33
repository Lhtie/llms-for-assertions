Replace `New_arrListIndexOfX` with `Old_arrListIndexOfX` if you want to check if the IndexOf value after inserting has not changed. Similarly, replace `New_arrListLastIndexOfX` with `Old_arrListLastIndexOfX` if you want to verify the LastIndexOf value after inserting. 

In addition, these assertions are for the assumptions that the `AddContract`, `RemoveContract`, `InsertContract`, `SetContract`, `GetContract`, `ContainsContract`, `IndexOfContract`, `LastIndexOfContract` and `CountContract` methods have correctly enforced and updated their assumptions. The methods should also respect any new assumptions added regarding the input data or the data that is returned.--------------------```cs
using System.Diagnostics;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_AddContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) < -1 && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList.IndexOf(x) == index && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_SetContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            Debug.Assert(arrList.IndexOf(x) == index && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_GetContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Debug.Assert(arrList.Contains(arrList[index]) && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.Contains(x) == arrList.Contains(x) && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.IndexOf(x) == arrList.IndexOf(x) && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            Debug.Assert(arrList.LastIndexOf(x) == arrList.LastIndexOf(x) && arrList.Count == arrList.Count);
        }

        [PexMethod]
        public void PUT_CountContract([PexAssumeUnderTest]ArrayList arrList)
        {
            Debug.Assert(arrList.Count == arrList.Count);
        }
    }
}
