Here are the assert statements:

In "PUT_AddContract", Assert that the index of x in the new array is equal to or greater than the old number of elements:
```csharp
Debug.Assert(New_arrListIndexOfX >= Old_arrListCount);
```

In "PUT_RemoveContract", Assert that the index of x in the new array is equal to or greater than -1:
```csharp
Debug.Assert(New_arrListIndexOfX >= -1);
```

In "PUT_InsertContract", Assert that index is less than or equal to the old count, but greater than or equal to 0:
```csharp
Debug.Assert(index <= Old_arrListCount && index >= 0);
```

In "PUT_SetContract", Assert that index is less than the old count and greater than or equal to 0:
```csharp
Debug.Assert(index < Old_arrListCount && index >= 0);
```

In "PUT_GetContract", Assert that index is strictly less than the old count, but strictly greater than or equal to 0:
```csharp
Debug.Assert(index < Old_arrListCount && index >= 0);
```

In "PUT_ContainsContract" and "PUT_IndexOfContract" and "PUT_LastIndexOfContract", Assert the return value is valid:
```csharp
Debug.Assert(New_Ret >= -1 && New_Ret <= arrList.Count);
```

In "PUT_CountContract", Assert that the new count is greater than or equal to the old count:
```csharp
Debug.Assert(New_Ret >= arrList.Count);
```--------------------Here's how the code will look:

```cs
using System.Diagnostics;
using Microsoft.Pex.Framework;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListContractTest
    {
        private static void AssertIndexOf(int OldIndex, int NewIndex, int OldArrListCount)
        {
            Debug.Assert(NewIndex >= 0 && NewIndex <= OldArrListCount);
        }

        private static void AssertLastIndexOf(int OldLastIndex, int NewLastIndex, int OldArrListContainsX)
        {
            Debug.Assert(NewLastIndex == -1 || (NewLastIndex >= 0 && NewLastIndex <= OldArrListContainsX));
        }

        [PexMethod]
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            AssertIndexOf(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, OldArrListCount);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
        }

        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            AssertLastIndexOf(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, Old_arrListCount);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);
            PexObserve.ValueForViewing("$old_arrList_contains_x", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_contains_x", New_arrListContainsX);
        }

        // And so on...
    }
}
```--------------------The above csharp code is a test class that contains methods that assert various conditions for a 'ArrayList' class. There are many such asserts in the code. 

Here's an extracted code for these asserts:

```cs

    Debug.Assert(New_arrListCount == Old_arrListCount + 1);    // @@@ array count increased by 1
    Debug.Assert(new_arrList_IndexOf_x == Old_arrListCount);  // @@@ index of x in new array is geq count
    Debug.Assert(old_arrList_IndexOf_x == -1 || new_arrList_IndexOf_x >= 0); // @@@ index of old x in newer array is either -1 or geq 0
    Debug.Assert(New_arrListIndexOfX == Old_arrListCount);    // @@@ index of x in new list equal to the old count


