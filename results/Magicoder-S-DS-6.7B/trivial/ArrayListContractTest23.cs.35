[Test]
public void TestPUT_AddContract()
{
    ArrayList arrList = new ArrayList();
    int x = /* some value */;

    int old_arrListCount = arrList.Count;
    int old_x = x;
    int old_arrListIndexOfX = arrList.IndexOf(x);
    int old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool old_arrListContainsX = arrList.Contains(x);

    int new_Ret = arrList.Add(x);

    int new_arrListCount = arrList.Count;
    int new_arrListIndexOfX = arrList.IndexOf(x);
    int new_arrListLastIndexOfX = arrList.LastIndexOf(x);

    bool new_arrListContainsX = arrList.Contains(x);

    // Assert here.
    Assert.AreEqual(old_arrListCount + 1, new_arrListCount);
    Assert.AreEqual(x, new_arrListIndexOfX);
    Assert.AreEqual(x, new_arrListLastIndexOfX);
    Assert.AreEqual(new_Ret, old_arrListCount);
    Assert.AreEqual(old_arrListContainsX || new_arrListContainsX, true);
}

[Test]
public void TestPUT_RemoveContract()
{
    ArrayList arrList = new ArrayList();
    int x = /* some value */;

    arrList.Add(x);

    int old_arrListCount = arrList.Count;
    int old_x = x;
    int old_arrListIndexOfX = arrList.IndexOf(x);
    int old_arrListLastIndexOfX = arrList.LastIndexOf(x);
    bool old_arrListContainsX = arrList.Contains(x);

    arrList.Remove(x);

    // Assert here.
    Assert.AreEqual(old_arrListCount - 1, arrList.Count);
    Assert.AreEqual(-1, arrList.IndexOf(x));
    Assert.AreEqual(-1, arrList.LastIndexOf(x));
    Assert.AreEqual(!old_arrListContainsX, !arrList.Contains(x));
}

