```cs
Debug.Assert(Old_arrListCount == New_arrListCount);
Debug.Assert(Old_x == New_Ret);
Debug.Assert(Old_arrListIndexOfX == New_arrListIndexOfX);
Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
Debug.Assert(Old_arrListContainsX == New_arrListContainsX);

if (!New_Ret) {
    Debug.Assert(Old_arrListCount == New_arrListCount);
}
```

These debug.asserts do the following:

1. Old_arrListCount == New_arrListCount: Checks whether Count values before and after the operation for the ArrayList are same.
2. Old_x == New_Ret: Checks whether the added value (in the Add operation) is present in the ArrayList.
3. Old_arrListIndexOfX == New_arrListIndexOfX & Old_arrListLastIndexOfX == New_arrListLastIndexOfX: For the element removed or updated, the index and lastIndex values should be same before and after the operation.
4. Old_arrListContainsX == New_arrListContainsX: Whether the removed value is already contained in the ArrayList or not.

If the return value of an operation is false for the ArrayList, we assert that the size is same.--------------------```cs
Using NUnit.Framework;
using System.Collections;

namespace ArrayList.Test
{
    public class ArrayListTest
    {
        [Test]
        public void TestAdd()
        {
            var arrList = new ArrayList();
            int x = 5;
            
            int oldCount = arrList.Count;
            int newRet = arrList.Add(x);
            int newCount = arrList.Count;
            
            Debug.Assert(oldCount == newCount - 1, $"Error in TestAdd: new count = {newCount}, old count = {oldCount}");
            Debug.Assert(newRet == oldCount + 1, $"Error in TestAdd: new ret = {newRet}, old count = {oldCount}");
        }

        [Test]
        public void TestRemove()
        {
            var arrList = new ArrayList();
            int x = 5;
            arrList.Add(x);

            int oldCount = arrList.Count;
            arrList.Remove(x);
            int newCount = arrList.Count;

            Debug.Assert(oldCount == newCount + 1, $"Error in TestRemove: new count = {newCount}, old count = {oldCount}");
        }

        [Test]
        public void TestInsert()
        {
            var arrList = new ArrayList();
            int x = 5;
            int index = 0;

            int oldCount = arrList.Count;
            arrList.Insert(index, x);
            int newCount = arrList.Count;

            Debug.Assert(oldCount == newCount - 1, $"Error in TestInsert: new count = {newCount}, old count = {oldCount}");
        }

        [Test]
        public void TestSet()
        {
            var arrList = new ArrayList();
            int x = 5;
            int index = 0;

            int oldCount = arrList.Count;
            arrList[index] = x;
            int newCount = arrList.Count;

            Debug.Assert(oldCount == newCount, $"Error in TestSet: new count = {newCount}, old count = {oldCount}");
        }

        [Test]
        public void TestGet()
        {
            var arrList = new ArrayList { 1, 2, 3 };
            int index = 0;

            int ret = (int)arrList[index];
            bool containsNewRet = arrList.Contains(ret);

            Debug.Assert(containsNewRet, $"Error in TestGet: Value does not exist in the ArrayList {ret}");
        }

        [Test]
        public void TestContains()
        {
            var arrList = new ArrayList();
            int x = 5;

            arrList.Add(x);
            bool ret = arrList.Contains(x);

            Debug.Assert(ret, $"Error in TestContains: Value {x} not in ArrayList");
        }

        [Test]
        public void TestIndexOf()
        {
            var arrList = new ArrayList();
            int x = 5;

            arrList.Add(x);
            int ret = arrList.IndexOf(x);

            Debug.Assert(ret >= 0, $"Error in TestIndexOf: Value {x} not in ArrayList");
        }

        [Test]
        public void TestLastIndexOf()
        {
            var arrList = new ArrayList();
            int x = 5;

            arrList.Add(x);
            int ret = arrList.LastIndexOf(x);

            Debug.Assert(ret >= 0, $"Error in TestLastIndexOf: Value {x} not in ArrayList");
        }

        [Test]
        public void TestCount()
        {
            var arrList = new ArrayList();
            int ret = arrList.Count;

            // No assertion here as the count will initially be 0
        }
    }
}
