            Debug.Assert(New_Ret == -1 ? !New_arrListContainsX : true);--------------------Debug.Assert(New_Ret < 0, "This should not happen. If x is not in the list, IndexOf() method should return -1");--------------------            Debug.Assert(New_Ret < 0 || New_arrListContainsX);--------------------Debug.Assert(New_Ret == -1 || New_arrList_contains_x == true, "If the return value is non-negative, new list contains x");------------------------------------------------------------Debug.Assert(New_Ret < 0, "If the return value is negative, new list doesn't contain x");--------------------Debug.Assert(New_Ret < 0 || New_arrListContainsX);--------------------            Debug.Assert(Old_arrListCount > 0 || !Old_arrListContainsX); // If the return value is negative or the old list don't contain x, assert--------------------            Debug.Assert(New_Ret < 0 || New_arrListContainsX == true);--------------------