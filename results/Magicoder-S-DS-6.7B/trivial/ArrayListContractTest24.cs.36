using System;
using System.Text.RegularExpressions;

namespace OutputAsserts
{
    class Program
    {
        static void Main(string[] args)
        {
            string testCode = @"
...paste your code here...
```cs
";

            // Use a regular expression to extract assertions
            var mentions = Regex.Matches(testCode, @"// @@@ (.*)");

            foreach(Match mention in mentions)
            {
                string assertion = mention.Groups[1].Value;
                Console.WriteLine("Debug.Assert(" + assertion + ");");
            }
        }
    }
}
```

