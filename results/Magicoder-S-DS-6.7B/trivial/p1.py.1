    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)
        # sum of all pairs of differences between terms in the array is atmost 1
        for i in range(len(p43_coeffs)-1):
            for j in range(i+1, len(p43_coeffs)):
                if abs(p43_coeffs[i] - p43_coeffs[j]) > 1:
                    print(f"Sum of pair differences in p43_coeffs is more than 1: {p43_coeffs[i], p43_coeffs[j]}")
