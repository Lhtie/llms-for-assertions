Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "The count of the ArrayList should increase by one when adding an item");--------------------        Debug.Assert(New_Ret >= 0, "If the return value of IndexOf, LastIndexOf, or IndexOf is non-negative, x is in the old array.");----------------------------------------    Debug.Assert((New_arrListCount == Old_arrListCount + 1), "Add failed");--------------------Debug.Assert(New_Ret >= 0, "Error: x is not found in the old array.");--------------------Debug.Assert(New_Ret != -1);--------------------------------------------------------------------------------Debug.Assert(New_Ret == Old_arrListIndexOfX);--------------------