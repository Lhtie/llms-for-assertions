```cs
using System.Diagnostics;

namespace ArrayList.Test
{
    public class LastIndexOfTest
    {
        public void TestLastIndexOf(ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            Debug.Assert(New_Ret >= 0); // @@@ If the return value is non-negative, index of x in new array is >= 0 

            Debug.Assert(New_arrListCount == Old_arrListCount); // @@@ After LastIndexOf() is executed, Count property of list should be same.

            Debug.Assert((Old_arrListIndexOfX < 0 || New_Ret >= Old_arrListIndexOfX)); // @@@ new index should be greater or equals to existing index of x , if x exists in the list.
 
            Debug.Assert((Old_arrListContainsX && New_Ret >= 0) || (!Old_arrListContainsX && New_Ret == -1)); // @@@ If x does not exist in new list, then ret should be -1.
             
            Debug.Assert(New_arrListIndexOfX == New_Ret); // @@@ If x exists in the list, then index of x in new array list should be equal with the return value of LastIndexOf() method.
        }
    }
}
```
This code creates a debug assertion after each line of logic in the body of the function. The first assertion checks if the return value of LastIndexOf is non-negative. The second and third assertions check for inconsistencies in the Count property and IndexOf method after the LastIndexOf method has been called. The fourth assertion validates the behavior of the Contains method. The fifth assertion checks if the index of x in the new array list equals to the return value of the LastIndexOf() method.--------------------