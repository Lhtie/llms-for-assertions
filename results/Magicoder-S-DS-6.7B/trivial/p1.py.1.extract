            assert diff_sum <= len(p43_coeffs) * (len(p43_coeffs) - 1) // 2, "the sum of all pairs of differences between terms is too large"--------------------    assert sum_of_diff <= 1, "There are pairs of differences between terms in the array that exceed 1"----------------------------------------assert diff_sum <= 1--------------------    assert sum(diffs) <= n * (n - 1) / 2, "The array does not meet the condition; the sum of all pairs of differences between terms in the array is more than 1"--------------------    assert diff_sum <= 1, "The sum of all pairs of differences between terms in the array is not at most 1"--------------------    assert sum_of_diffs <= 1, f"The sum of all pairs of differences is {sum_of_diffs}, but it should be at most 1"--------------------    assert sum_diffs <= 1, "The sum of all pairs of differences between terms in the array is greater than 1"--------------------    assert all(x > -1 and x < 2 for x in diffs), "The sum of all pairs of differences between terms in the array is greater than 1"--------------------        assert isinstance(inp, int), "All inputs must be integers"--------------------