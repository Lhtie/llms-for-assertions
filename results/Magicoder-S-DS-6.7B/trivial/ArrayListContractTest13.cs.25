[Test]
[ExpectedException(typeof(NotSupportedException))]
public void PUT_AddContractTest([PexInlineAutoMock]ArrayList arrList, int x)
{
   var oldCount = arrList.Count;
   arrList.Add(x);
  
   Assert.That(arrList.Count, Is.GreaterThanOrEqualTo(oldCount));
}
```
```cs
[Test]
[ExpectedException(typeof(NotSupportedException))]
public void PUT_RemoveContractTest([PexInlineAutoMock]ArrayList arrList, int x)
{
   var oldCount = arrList.Count;
   arrList.Remove(x);
   
   Assert.That(arrList.Count, Is.LessThanOrEqualTo(oldCount));
}
```
```cs
[Test]
public void PUT_InsertContractTest([PexInlineAutoMock]ArrayList arrList, int x, int index)
{
   var oldCount = arrList.Count;
   arrList.Insert(index, x);
   
   Assert.AreEqual(oldCount + 1, arrList.Count);
}
```
```cs
[Test]
public void PUT_SetContractTest([PexInlineAutoMock]ArrayList arrList, int x, int index)
{
