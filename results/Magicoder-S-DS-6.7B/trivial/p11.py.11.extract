    assert total_money >= amnt, "Total balance of all frm accounts is less than amnt"--------------------    assert sum([acnt.money for acnt in frm.accounts]) >= amnt, "Total balance of all 'frm' accounts is less than 'amnt'."--------------------    assert sum(acnt.money for acnt in frm.accounts) >= amnt, '@@@ total balance of all "frm" accounts is not less than "amnt"'--------------------assert transfer(p1, p2, 50)--------------------assert sum([acnt.money for acnt in frm.accounts]) >= amnt, 'Total balance of all "frm" accounts is less than "amnt"'--------------------    assert total_money_frm >= amnt, "Total balance of all accounts of 'frm' is not enough for the transfer!"--------------------assert frm.accounts, "Accounts from where money needs to be transferred isn't available\--------------------assert sum([acnt.money for acnt in person1.accounts]) >= total_money_person1, \--------------------assert frm.accounts is not None, "Accounts of 'frm' are not valid"--------------------    assert total_balance >= amnt, "@@@ total balance of all " + str(frm) + " accounts is not less than " + str(amnt)--------------------