Debug.Assert(Old_arrListCount - 1 == arrList.Count, "array list count is not same as last index of x in new array");--------------------Debug.Assert(New_arrListCount == Old_arrListCount - 1 || New_arrListCount == Old_arrListCount, "the new array list count should be one less than the old count");--------------------Debug.Assert(Old_arrListCount != New_arrListCount, "array list count is not same as last index of x in new array");--------------------Debug.Assert(Old_arrListCount != New_arrListLastIndexOfX);--------------------Debug.Assert(Old_arrListCount - 1 == New_arrListCount || Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_arrListCount != New_arrListLastIndexOfX, "ArrayList count is not the same as last index of x in new array");--------------------Debug.Assert(New_arrListCount != New_arrListLastIndexOfX, "@@ array list count is not same as last index of x in new array");----------------------------------------Debug.Assert(New_arrListCount != Old_arrListLastIndexOfX);--------------------            Debug.Assert(New_arrListCount != Old_arrListLastIndexOfX);--------------------