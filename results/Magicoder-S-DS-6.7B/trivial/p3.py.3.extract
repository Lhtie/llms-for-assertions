        assert (l>0 and w>0), "Invalid values passed in"--------------------        assert (l>0 and w>0), "Invalid values passed in"--------------------assert compare_a(r, c) == 78.5, "compare_a function failed"  # Assert the correct values and function return----------------------------------------        assert (l>0 and w>0), "Error: Invalid values passed in"--------------------assert ((s1 is Shape or s2 is Shape) is False), "Invalid Shape passed in"--------------------assert r1.area == 12, "Area of Rectangle is not correct after initialization"--------------------        assert (l > 0 and w > 0), "Invalid values passed in"--------------------assert rec.len == 4, "Length of rect not correctly initialized"----------------------------------------