    [Test]
    [TestCase(10)]
    public void TestAdd(int newitem)
    {
        var arrList = new ArrayList();
        Assume.That(arrList.Count, Is.EqualTo(0));
        var Old_arrListCount = arrList.Count;
        var New_Ret = arrList.Add(newitem);
        var New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount+1 == New_arrListCount);
        Debug.Assert(New_Ret == 0); // assuming add returns position of new item which is always 0 for this case
        Debug.Assert(arrList.Contains(newitem));
    }

    [Test]
    [TestCase(10)]
    public void TestRemove(int removeitem)
    {
        var arrList = new ArrayList();
        arrList.Add(removeitem);
        Assume.That(arrList.Count, Is.EqualTo(1));

        var Old_arrListCount = arrList.Count;
        arrList.Remove(removeitem);
        var New_arrListCount = arrList.Count;

        Debug.Assert(Old_arrListCount-1 == New_arrListCount);
        Debug.Assert(arrList.Contains(removeitem) == false);   
    }

