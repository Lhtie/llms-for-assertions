    assert r.lin > 0, "The height of the rectangle should be greater than zero"--------------------    assert r.lin > 0, "height of r is positive"--------------------    assert r.lin > 0--------------------    assert r.lin > 0, "Height of r is not positive"----------------------------------------    assert r.lin > 0, 'The height of r is not positive'--------------------    assert r.lin > 0, "height of r is not positive"--------------------        assert n >= 0, "width of a rectangle can't be negative"--------------------    assert r.lin > 0, "Height of r is not positive"--------------------    assert r.lin > 0, "height of r is not positive"--------------------