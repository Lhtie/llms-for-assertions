        /// <summary>
        /// Asserts that `Count` property value has not changed after inserting an element.
        /// </summary>
        private static void AddContract(List<int> arrList, int x)
        {
            int Old_Count = arrList.Count;            
            arrList.Add(x);
            int New_Count = arrList.Count;
            
            Debug.Assert(Old_Count == New_Count - 1);    // Asserts that Count has increased by 1
        }

        /// <summary>
        /// Asserts that `Contains` method return value is `true` for the inserted element after inserting element.
        /// </summary>
        private static void AddContract(List<int> arrList, int x)
        {       
            arrList.Add(x);
            bool New_Contains = arrList.Contains(x);

            Debug.Assert(New_Contains);    // Asserts that the list contains the inserted element
        }

        /// <summary>
        /// Asserts that `IndexOf` and `LastIndexOf` methods return same value when inserting an element.
        /// </summary>
        private static void AddContract(List<int> arrList, int x)
        {
            arrList.Add(x);
            
            int New_IndexOf = arrList.IndexOf(x);
            int New_LastIndexOf = arrList.LastIndexOf(x);

            Debug.Assert(New_IndexOf == New_LastIndexOf);    // Asserts that IndexOf and LastIndexOf are the same
        }
```
