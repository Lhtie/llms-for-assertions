            Debug.Assert(arrList != null, "arraylist is null");--------------------Debug.Assert(Old_arrListCount != index);--------------------Debug.Assert(index != Old_arrListCount);--------------------Debug.Assert(Old_arrListCount != arrList.Count, "index passed in is not equal to the old array size");--------------------            Debug.Assert(index != Old_arrListCount, "index passed in is equal to the old array size");--------------------            Debug.Assert(index < arrList.Count && index >= 0);--------------------Debug.Assert(Old_arrListCount != index);--------------------            Debug.Assert(New_arrListCount == Old_arrListCount); --------------------            Debug.Assert(index != Old_arrListCount); ----------------------------------------