Debug.Assert(Old_arrListLastIndexOfX == -1 || Old_arrListLastIndexOfX < New_arrListLastIndexOfX);
Debug.Assert(Old_arrListContainsX == false && New_arrListContainsX == true);

Debug.Assert(New_Ret == Old_arrListCount + 1 || New_Ret == 0 || New_Ret < Old_arrListCount);

Debug.Assert(New_Ret == 0 || New_containsNewRet == true);

Debug.Assert(New_Ret >= 0);

Debug.Assert(New_Ret == -1 || New_arrListContainsX == true);
Debug.Assert(New_Ret >= Old_arrListCount - Old_arrListLastIndexOfX || New_Ret ==  Old_arrListIndexOfX);

Debug.Assert(New_Ret == Old_arrListCount);
