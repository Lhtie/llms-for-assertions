            Debug.Assert(true);--------------------Debug.Assert(Old_arrListCount >= 0);----------------------------------------            Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_x == x);--------------------Debug.Assert(Old_arrListCount < New_arrListCount, "Old count was not less than new count");--------------------Debug.Assert(New_Ret < 0 || arrList.Contains(x)); // @@ If the return value is negative, old array list doesnt contain x --------------------Debug.Assert(arrList.Count == Old_arrListCount + 1);------------------------------------------------------------