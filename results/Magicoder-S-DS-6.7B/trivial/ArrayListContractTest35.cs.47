            var ex = Assert.Throws<IndexOutOfRangeException>(() => New_Ret = (int)arrList[Old_arrListCount]);
            Assert.AreEqual("Index was outside the bounds of the array.", ex.Message);

            // @@@ Calling contains with a non-existent x should return false.
            Assert.IsFalse(New_ContainsX);

            // @@@ IndexOf should return the index of the last occurance of x in the list.
            Assert.AreEqual(New_arrListLastIndexOfX, New_arrListIndexOfX);

            // @@@ The count of the list should be the same after remove operation or before insertion operation.
            Assert.AreEqual(New_arrListCount, Old_arrListCount);

            // @@@ The x at the index that was removed should be equal to the removed x.
            Assert.AreEqual(arrList[Old_index], x);
