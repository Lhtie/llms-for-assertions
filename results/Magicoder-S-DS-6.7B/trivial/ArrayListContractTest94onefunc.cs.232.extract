Debug.Assert(New_Ret >= 0, "The return value is non-negative, x is in the old array list");--------------------Debug.Assert(Old_arrListCount == New_arrListCount, "count did not remain unchanged");--------------------Debug.Assert(Old_arrListContainsX == true);--------------------Debug.Assert(New_Ret < 0, "If the return value is non-negative, x is in the old array list");--------------------Debug.Assert(Old_arrListCount >= 0);--------------------            Debug.Assert(New_Ret != -1, $"If the return value is non-negative, x is in the old array list.");--------------------            Debug.Assert(New_Ret >= 0 && Old_arrListContainsX);--------------------            Debug.Assert(Old_arrListIndexOfX >= 0, "x is not in the old array list");--------------------Debug.Assert(New_Ret != -1, "Non-negative return value is required, but it was found that x is not in the array list.");--------------------Debug.Assert(Old_arrListCount >= Old_arrListIndexOfX); // @@@ If the return value is non-negative, x is in the old array list--------------------