using System;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [Test]
        public void PUT_ContainsContract()
        {
            var arrList = new ArrayList(); // Assume the ArrayList class is defined in the current namespace 
            var x = 10; // assume an int x
            arrList.Add(x);

            bool currentContainsX = arrList.Contains(x);
            arrList.Remove(x);
            bool newContainsX = arrList.Contains(x);

            Assert.IsFalse(newContainsX);
        }
        
        [Test]
        public void PUT_IndexOfContract()
        {
            var arrList = new ArrayList();
            var x = 10;
            arrList.Add(x);

            int currentIndexOfX = arrList.IndexOf(x);
            Assert.AreEqual(-1, currentIndexOfX);
            arrList.Remove(x);
            int newIndexOfX = arrList.IndexOf(x);

            Assert.AreEqual(-1, newIndexOfX);
        }

        [Test]
        public void PUT_LastIndexOfContract()
        {
            var arrList = new ArrayList();
            var x = 10;
            arrList.Add(x);

            int currentLastIndexOfX = arrList.LastIndexOf(x);
            Assert.AreEqual(-1, currentLastIndexOfX);
            arrList.Remove(x);
            int newLastIndexOfX = arrList.LastIndexOf(x);

            Assert.AreEqual(-1, newLastIndexOfX);
        }

        [Test]
        public void PUT_CountContract()
        {
            var arrList = new ArrayList();

            int count = arrList.Count();
            
            arrList.Add(10);
            Assert.AreEqual(0, count);
        }

        [Test]
        public void PUT_GetContract()
        {
            var arrList = new ArrayList();
            arrList.Add(10);
            var index = arrList.IndexOf(10);

            int currentRet = (int)(arrList[index]);

            arrList.Remove(10);

            Assert.Throws<Exception>(() => { 
                _ = arrList[index];
            });
            Assert.Throws<Exception>(() => { 
                _ = currentRet;
            });
        }

        [Test]
        public void PUT_SetContract()
        {
            var arrList = new ArrayList();
            arrList.Add(10);
            var index = arrList.IndexOf(10);

            int x = 15;
            arrList.Set(index, x);

            Assert.AreEqual(x, arrList[index]);

            arrList.Remove(15);

            Assert.Throws<IndexOutOfRangeException>(() => { 
                arrList.Set(index, x);
            });
        }

        [Test]
        public void PUT_InsertContract()
        {
            var arrList = new ArrayList();

            int x = 10;
            int index = 0;
            arrList.Insert(index, x);

            Assert.AreEqual(x, arrList[index]);

            arrList.Remove(10);

            Assert.Throws<IndexOutOfRangeException>(() => {
                arrList.Insert(index, x);
            });
        }

        [Test]
        public void PUT_RemoveContract()
        {
            var arrList = new ArrayList();
            arrList.Add(10);

            int currentIndexOfX = arrList.IndexOf(10);
            Assert.AreEqual(-1, currentIndexOfX);
            arrList.Remove(10);

            Assert.AreEqual(-1, arrList.IndexOf(10));
        }

        [Test]
        public void PUT_AddContract()
        {
            var arrList = new ArrayList();

            int x = 10;

            int count = arrList.Count();
            arrList.Add(x);

            Assert.AreEqual(count + 1, arrList.Count());
        }
