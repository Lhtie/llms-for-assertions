public void testIndexOfIsLessorEqualToCount()
{
     var arrList = ArrayList.createInstance();
     int index = 10,x = 10;
     Assume.assumeTrue(index <= arrList.Count);
     Assert.assertTrue(arrList.IndexOf(x)<=arrList.Count);
}
