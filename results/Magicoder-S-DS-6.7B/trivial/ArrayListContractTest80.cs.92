[Test]
public void PUT_AddContract()
{
  // arrange
  int Old_arrListCount = arrList.Count;
  int Old_x = 0; // Insert an value here. For example 42.
  int Old_arrListIndexOfX = arrList.IndexOf(Old_x);
  int Old_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);
  bool Old_arrListContainsX = arrList.Contains(Old_x);

  // act
  int New_Ret = arrList.Add(Old_x);

  // assert
  Assert.AreEqual(Old_arrListCount + 1, arrList.Count);
  Assert.AreEqual(Old_arrListIndexOfX, arrList.IndexOf(Old_x));
  Assert.AreEqual(Old_arrListLastIndexOfX, arrList.LastIndexOf(Old_x));
  Assert.AreEqual(Old_arrListContainsX, arrList.Contains(Old_x));
  Assert.AreEqual(New_Ret, arrList.Count - 1);
}

[Test]
public void PUT_RemoveContract()
{
  // arrange
  int Old_arrListCount = arrList.Count;
  int Old_x = 0; // Insert an value here. For example 42.
  int Old_arrListIndexOfX = arrList.IndexOf(Old_x);
  int Old_arrListLastIndexOfX = arrList.LastIndexOf(Old_x);
  bool Old_arrListContainsX = arrList.Contains(Old_x);

  // act 
  arrList.Remove(Old_x);

  // assert
  Assert.AreEqual(Old_arrListCount - 1, arrList.Count);
  Assert.AreNotEqual(Old_arrListIndexOfX, arrList.IndexOf(Old_x));
  Assert.AreNotEqual(Old_arrListLastIndexOfX, arrList.LastIndexOf(Old_x));
  Assert.AreNotEqual(Old_arrListContainsX, arrList.Contains(Old_x));
}

