```cs
using System;
using System.Diagnostics;

[Test]
public void WhenCountCalled_EnsureCorrectReturnValue()
{
    //arrange
    int expectedCount = arrList.Count - 1;

    //act
    var result = arrList.Count;

    //Assert
    Debug.Assert(result == expectedCount, "Count method did not return expected value.");
}

[Test]
public void WhenAddCalled_EnsureListContainsNewValue()
{
    //arrange
    int expectedCount = arrList.Count + 1;
    int valueToAdd = 10;

    //act
    var result = arrList.Add(valueToAdd);

    //Assert
    Debug.Assert(result == expectedCount, "Add method did not add value to the list and increase size");
    Debug.Assert(arrList.Contains(valueToAdd), "Add method did not actually add the value into the list"); 
}

[Test]
public void WhenRemoveCalled_EnsureListDoesNotContainValue()
{
    //arrange
    int valueToRemove = 10;

    //act
    arrList.Remove(valueToRemove);

    //Assert
    Debug.Assert(!arrList.Contains(valueToRemove), "Remove method did not actually remove the specified value from the list");
}

[Test]
public void WhenInsertCalled_EnsureValuePlacedAtCorrectIndex()
{
    //arrange
    int index = 0;
    int value = 10;

    //act
    arrList.Insert(index, value);

    //Assert
    Debug.Assert(arrList[index] == value, "Insert method did not put inserted value at the correct index");
}

[Test]
public void WhenSetCalled_EnsureValueChangesAtIndexWhenListIsNotEmpty()
{
    //arrange
    int index = 0;
    int oldValue = arrList[index];
    int newValue = oldValue != 10 ? arrList[0] : 10;

    //act
    arrList[index] = newValue;

    //Assert
    Debug.Assert(arrList[index] == newValue, "Set method did not correctly replace the value at the specified index");
}

[Test]
public void WhenGetCalled_EnsureCorrectValueReturned()
{
    //arrange
    int expectedValue = 10;

    Debug.Assert(arrList.Count > 0, "List is empty, unable to perform get operation when it's empty");
    
    //act
    var result = (int)arrList[0];

    //Assert
    Debug.Assert(result == expectedValue, "Get method did not return the expected value");
}

[Test]
public void WhenContainsCalled_EnsureCorrectResponse()
{
    //arrange
    int valueToCheck = 10;

    //act
    var result = arrList.Contains(valueToCheck);

    //Assert
    Debug.Assert(result == arrList.IndexOf(valueToCheck) != -1, "Contains method did not correctly return whether the list contains the specified value");
}

[Test]
public void WhenIndexOfCalled_EnsureCorrectReturnValue()
{
    //arrange
    int valueToCheck = 10;

    //act
    var result = arrList.IndexOf(valueToCheck);

    //Assert
    Debug.Assert(arrList.Contains(valueToCheck) || result == -1, "IndexOf method did not correctly return the index of the first occurrence of the specified value in the list");
}

[Test]
public void WhenLastIndexOfCalled_EnsureCorrectReturnValue()
{
    //arrange
    int valueToCheck = 10;

    //act
    var result = arrList.LastIndexOf(valueToCheck);

    //Assert
    Debug.Assert(arrList.Contains(valueToCheck) || result == -1, "LastIndexOf method did not correctly return the index of the last occurrence of the specified value in the list");
}
```
