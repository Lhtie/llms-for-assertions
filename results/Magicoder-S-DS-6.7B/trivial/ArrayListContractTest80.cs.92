public void testIndexOfIsInRange()
{
     var arrList = ArrayList.createInstance();
     int index = 10;
     Assume.assumeTrue(index >= 0 && index < arrList.Count);
     Assert.assertTrue(arrList.IndexOf(index) >= 0 && index < arrList.Count);
}
