assert all([a.money >= amnt for a in frm.accounts for amnt in range(amnt+1) if acnt.money >= amnt]), "Some account of 'frm' has more money than 'amnt'"--------------------        assert acnt.money >= amnt, "Not enough money to transfer in some account of {}".format(frm.name)--------------------assert all(person.accounts[0].money + person.accounts[1].money + person.accounts[2].money + person.accounts[3].money + person.accounts[4].money <= sum(account.money for account in person.accounts))--------------------    assert acnt.money >= amnt, f"Not enough money in {acnt} for transfer of {amnt}"--------------------assert sum([acnt.money for acnt in frm.accounts]) >= amnt, "Some account of 'frm' has less money than 'amnt'"--------------------assert frm.accounts[0].money - amnt >= 0, "@@@ some account of 'frm' has more money than 'amnt'"--------------------        assert acnt.money >= amnt--------------------    assert total >= amnt, "some account of 'from' has more money than 'amnt'"--------------------    assert any(acnt.money >= amnt for acnt in frm.accounts), "No sufficient amount in accounts to transfer"--------------------assert frm.accounts[0].money > amnt, f"Some account of '{frm.name}' has more money than '{amnt}'"--------------------