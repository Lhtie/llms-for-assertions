assert all([acnt.money < 0 or acnt.money > 50 for acnt in p1.accounts]), "All accounts of person 'from' should have either less than 0 or more than 50 money"--------------------assert p1.accounts[0].money == 90     # The first account of John should have 90 dollars----------------------------------------assert transfer(Person("Tom"), Person("Bob"), 5)--------------------assert transfer(person1, person2, 40)--------------------assert transfer(person1, person2, 50), "Failed to transfer money"--------------------assert not transfer(alice, bob, 50)--------------------assert result == True     # Transfer should be successful--------------------assert transfer(Person("Alice"), Person("Bob"), 50) == True, "transfer function should return True when enough money is available in accounts"----------------------------------------