assert (np_ver > '2.0.0'), 'numpy version is not greater than 2'----------------------------------------assert np.allclose(mtx @ evectors[:, 0], evalues[0] * evectors[:, 0])--------------------assert np.version.version >= '1.18.5', "Numpy version is less than 1.18.5"--------------------assert np.linalg.norm(lambda_*vec - lambdavec) < 1e-10, "eigenvalues and eigenvectors are not correct"----------------------------------------    assert abs(lambda - np.abs(vec.dot(lambdavec))) < 1e-5, "The largest eigenvalue doesn't match the first eigenvector's dot product of the matrix"----------------------------------------assert np.__version__>'1.0.4' # checks for numpy version----------------------------------------