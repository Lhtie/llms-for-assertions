            Debug.Assert(New_Ret == 0);--------------------Debug.Assert(index <= arrList_old.IndexOf(x), "index passed in is less than or equal to 'index of x' in precondition array");--------------------            Debug.Assert(Old_arrListCount < New_arrListCount); // @@@ arrList count increase----------------------------------------            Debug.Assert(arrList.Count == Old_arrListCount + 1);----------------------------------------Debug.Assert((Old_arrListCount + 1 == New_arrListCount), "Insert operation failed!");--------------------------------------------------------------------------------