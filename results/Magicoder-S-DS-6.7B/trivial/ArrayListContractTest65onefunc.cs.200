            Debug.Assert(Old_x == x);
            Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX);
            Debug.Assert(New_arrListContainsX == Old_arrListContainsX);

            // If the return value is negative, list count remains same
            Debug.Assert(New_Ret < 0 || Old_arrListCount == New_arrListCount);
		    
