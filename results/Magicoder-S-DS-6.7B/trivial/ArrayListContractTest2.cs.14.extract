Debug.Assert(New_arrListCount == Old_arrListCount + 1, "Count did not increase by 1 after adding");--------------------            Debug.Assert(Old_arrListCount <= arrList.Count, "Error: Precondition: Old array list count <= Count in array list");------------------------------------------------------------Debug.Assert(Old_arrListCount == New_arrListCount);--------------------Debug.Assert(Old_arrListCount <= New_arrListCount);--------------------Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "Add failed to increase count by 1");------------------------------------------------------------Debug.Assert((Old_arrListCount + 1) == New_arrListCount, "Expected Count to increment by 1");--------------------