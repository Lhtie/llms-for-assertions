```cs
namespace ArrayList.Test {
    public partial class ArrayListContractTest {
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x) {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.IndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // @@@ If the return value is non-negative, new array list's last index of x is <= old arrays count 
            System.Diagnostics.Debug.Assert(New_Ret >= 0, "If the return value is non-negative, new array list's last index of x is <= old arrays count");
            System.Diagnostics.Debug.Assert(New_arrListLastIndexOfX <= Old_arrListCount, "If the return value is non-negative, new array list's last index of x is <= old arrays count");
        }
    }
}
```
These assert commands will check if the return value is non-negative and the new array list's last index of x is not greater than the old arrays's count.--------------------// If the return value is non-negative, new array list's last index of x is <= old arrays count 
Debug.Assert(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true); 

// The old array list count and new array list count should be the same 
Debug.Assert(Old_arrListCount == New_arrListCount); 

// The old and new last index of x in array list should be the same or one of them should be -1 (if x is not in the list) 
Debug.Assert(Old_arrListLastIndexOfX == New_arrListLastIndexOfX || Old_arrListLastIndexOfX == -1 && New_arrListLastIndexOfX == -1); 

// x is in the old array list and new array list should have the same value of contains x 
