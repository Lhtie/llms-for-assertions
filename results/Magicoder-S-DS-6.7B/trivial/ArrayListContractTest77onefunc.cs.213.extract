    Debug.Assert(true);--------------------Debug.Assert(New_arrListCount >= Old_arrListCount);--------------------Debug.Assert(New_Ret >= Old_arrListLastIndexOfX, "If the return value is non-negative, last index of x in old array is smaller than or equal to new array");--------------------            Debug.Assert(New_Ret == -1 || New_arrListLastIndexOfX <= New_arrListCount || Old_arrListLastIndexOfX <= Old_arrListCount);--------------------Debug.Assert(New_Ret >= 0 && Old_arrListLastIndexOfX <= New_arrListLastIndexOfX);----------------------------------------Debug.Assert(New_Ret >= 0 && Old_arrListLastIndexOfX <= New_Ret);--------------------------------------------------------------------------------