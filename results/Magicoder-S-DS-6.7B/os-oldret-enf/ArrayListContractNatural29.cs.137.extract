
Debug.Assert(OLD(_size) == RET.Count);
Debug.Assert(OLD(_size) <= Capacity);
Debug.Assert(RET.Count >= Count - 1);
Debug.Assert(Array.IndexOf(OLD(_items), (Object)RET, 0, RED(old, _size)) >= 0);
Debug.Assert(IndexOf(RET, (Object)RET) == RET - 1);
Debug.Assert(Contains((Object)false));
--------------------
// @@@ array list size decreases by one or remains the same after remove 
Debug.Assert(OLD(_size) - 1 == RET);
--------------------
Debug.Assert(OLD(_items.Length) - OLD(_size) == 1);
--------------------
Debug.Assert(Count - 1 >= 0);
Debug.Assert(OLD(_items.Length) == Capacity);
Debug.Assert(Array.IndexOf((Array)_items, value, 0, Count) == ReturnValue.CheckForNull(IndexOf(value)));
Debug.Assert(Count - 1 == RET);
Debug.Assert(Count == _size);
Debug.Assert(Count == Array.IndexOf((Array)_items, value, 0, Count));
--------------------
Debug.Assert(oldCapacity < Capacity, "SR.ArrayList_Capacity_Invalid");
--------------------
Debug.Assert(_size == OLD(_size) - 1);
--------------------
Debug.Assert(OLD(Count) - 1 = RET);
--------------------
Debug.Assert(OLD(_size) == _size - 1 || _size == _items.Length, "ArrayList size should decrease by one or length should remain the same");
--------------------
Debug.Assert(Capacity = _items.Length); // initial capacity
Debug.Assert(_items.Length == 0 && Count == 0); // ArrayList is initially empty
Debug.Assert(Capacity = Math.Abs(Capacity)); // ensure capacity is a positive number
Debug.Assert(IndexOf(null) == -1); // ensure null does not exist in list initially
Debug.Assert(IndexOf(1) != IndexOf(2)); // ensure uniqueness of elements in list
Debug.Assert(Count = _items.Length); // count and array length should be equal at begin 
Debug.Assert(Add(1) = 0); // check the increment when adding an item
Debug.Assert(Add(1) = Add(2)); // check the increment of adding new items
Debug.Assert(Add(1) = Count); // check the increment of adding items
Debug.Assert(Insert(0, 1) = 0); // check the increment of inserting at front
Debug.Assert(Remove(1) = IndexOf(1)); // check the removal of item and its index
// @@@ the next line should fail
Debug.Assert(Capacity = Add(_defaultCapacity * 2)); // check increment of capacity on adding
// @@@ the next line may fail
Debug.Assert(Contains(1)); // item should be in ArrayList after being added
Debug.Assert(IndexOf(1) > 0 && IndexOf(1) < Count); // the index of the first 1 should be somewhere between 0 and Count
Debug.Assert(LastIndexOf(1) >= Capacity); // the last index of element 1 should not be negative and not greater than the capacity
Debug.Assert(RemoveAt(0) = Remove(1)); // check the removal of element by index and by value
Debug.Assert(Count = _size); // the Count should equal the length of the array
Debug.Assert(RemoveAt(Count - 1) = IndexOf(1)); // check the removal of last element in the list
Debug.Assert(Clear()); // check if the list clears its elements and their indices
--------------------
Debug.Assert(IndexOf(RET) == Count - 1);
