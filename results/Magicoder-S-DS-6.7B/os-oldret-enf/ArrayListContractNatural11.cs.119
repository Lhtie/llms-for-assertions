<code>
public int IndexOf(Object value)
{
    if (value == null)
    {
        for (int i = 0; i < _size; i++)
            if (_items[i] == null)
                return i;
        return -1;
    }
    else
    {
        for (int i = 0; i < _size; i++)
            if ((_items[i] != null) && (_items[i].Equals(value)))
                return i;
        return -1;
    }
}
</code>

<code>
public void Clear()
{
    Array.Clear((Array)_items, 0, _size);
}
</code>

<code>
public void AddRange(System.Collections.ICollection c)
{
    Object[] values = new Object[c.Count];
    c.CopyTo(values, 0);
    AddRange(values);
}
</code>

<code>
private int LastIndexOf(Object value, int startIndex, int count)
{
    int stopIndex = startIndex - count;

    for (int index = startIndex; index > stopIndex; index--)
    {
        if (Object.Equals(_items[index], value))
            return index;
    }

    return -1;
}
</code>

<code>
private void EnsureCapacity(int min)
{
    int newCapacity = _items.Length == 0 ? _defaultCapacity : _items.Length * 2;

    if (newCapacity < min)
        newCapacity = min;

    if (newCapacity <= Int32.MaxValue)
        SetCapacity(newCapacity);
    else
        throw new OutOfMemoryException();
}
</code>

<code>
private void SetCapacity(int value)
{
    if (value < _size)
        return;

    Object[] newArray = new Object[value];
    Array.Copy(_items, 0, newArray, 0, _size);
    _items = newArray;
}
