if (index < 0 || index > OLD(Count))
{
    throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_ArrayListInsert");
}

Debug.Assert(OLD(Count) + 1 != OLD(Capacity));

if (index < OLD(Count))
{
    int oldsize = OLD(Count);
    for (int i = oldsize - 1; i >= index; i--)
    {
        OLD(items)[i + 1] = OLD(items)[i];
    }
}

OLD(items)[index] = value;

if (OLD(Count) + 1 == Capacity)
{
    Capacity = OldCapacity * 2;
}
else
{
    Capacity = OLD(Capacity); // old capacity
}

OLD(Count) = oldCount + 1;
OLD(Version) = OLD(Version) + 1;
