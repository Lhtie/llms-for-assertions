```cs
public void TestArrayList() {
    ArrayList list = new ArrayList();
    list.Add(1);
    Assert.AreEqual(list.Count, list.Capacity);
    
    list.Add(2);
    Assert.IsTrue(list.IndexOf(2) != -1);
    Assert.IsTrue(list.Contains(2));
    Assert.AreEqual(list.LastIndexOf(2), 1);
    Assert.AreEqual(list[1], 2);

    list.Remove(1);
    Assert.AreNotEqual(list.Count, list.Capacity);
    Assert.AreEqual(list.IndexOf(1), -1);
    Assert.IsTrue(!list.Contains(1));
    Assert.IsNull(list[0]);

    list.RemoveAt(0);
    Assert.AreEqual(list.LastIndexOf(null), -1);
  
    // Add more test cases and assert statements based on other operations performed, 
    // and your assert comments' intentions.
}
```

