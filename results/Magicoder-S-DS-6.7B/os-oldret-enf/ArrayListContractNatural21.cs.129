This code reads the comments associated with the insertion of an element into the list, removal of an element from the list and the count property of the list. Here `size` means the list size. In the first Debug.Assert, it checks the validity of the index value. In the second Assert, it checks if the size of the list decreased by one after removing an element. In the third one, it checks if the Count property remains the same for its value is equal to return value from the function.--------------------
using System;
using System.Diagnostics;

// The ArrayList inserts the element at the specified position in the array 
// and move the rest of the elements backward.
Debug.Assert(OLD(_version) + 1 == NEW(_version));
Debug.Assert(OLD(_size) + 1 == NEW(_size));
Debug.Assert(OLD(_size) == NEW(_size) - 1);
Debug.Assert(Array.IndexOf(_items, _items[index], 0, OLD(_size) + 1) == index);
</code>
<br>
<code>
// @@@ If you try to access an element that is not existent with an index, it will throw an ArgumentOutOfRangeException
Debug.Assert(IndexOf(null) == -1);
</code>
<br>
<code>
// @@@ Calling add method on the ArrayList increases the count of the list by one.
Debug.Assert(OLD(_size) + 1 == _size);
Debug.Assert(Array.IndexOf(_items, value, 0, _size) == _size - 1);
</code>
<br>
<code>
// @@@ Insert element at specified position.
Debug.Assert(_size == OLD(_size) + 1);
Debug.Assert(_items[index] == value);
Debug.Assert(Array.IndexOf(_items, _items[index], 0, _size) == index);
</code>
<br>
<code>
// @@@ Remove element from list and check size
Debug.Assert(OLD(_size) - 1 == _size);
Debug.Assert(_size >= 0);
Debug.Assert(Array.IndexOf(_items, value, 0, _size) == -1);
</code>
<br>
<code>
// @@@ Adding a null to the list increases the count by one 
Debug.Assert(OLD(_size) + 1 == _size);
Debug.Assert(_size >= 0);
Debug.Assert(Array.IndexOf(_items, null, 0, _size) == _size - 1);
</code>
<br>
<code>
// @@@ Clearing the list reduces the count to 0 
Debug.Assert(_size == 0);
</code>
