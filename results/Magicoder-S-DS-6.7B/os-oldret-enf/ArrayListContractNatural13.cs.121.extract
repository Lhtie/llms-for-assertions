using System.Diagnostics;
// @@@ Add items to list increases Count
Debug.Assert(OLD(_size) + 1 = RET);
--------------------
Debug.Assert(OLD(index) >= 0 && index &lt;= _size);
--------------------
Debug.Assert(OLD(x) + OLD(y) = ARRAY(RET));
--------------------
Debug.Assert(Array.IndexOf(_items, value, 0, _size) == index, $"Assertion failed. Expected index: {index}, Actual index: {Array.IndexOf(_items, value, 0, _size)}");
--------------------
Debug.Assert(_size >= _items.Length); // There will always be more items in the list than the size of the internal array; array reallocation is done when we insert too many items.
Debug.Assert(_version >= _internalIntVersion); // The version is always greater than the internal int version; this is used to keep the ArrayList synchronized with the int size change in an array.
Debug.Assert(Count == _size); // The count property always returns the same value as the _size member variable.
Debug.Assert(_syncRoot == null || _syncRoot.GetType() == typeof(Object)); // The sync root object is either null or an System.Object.
Debug.Assert((Count >= 0) && Count < MaxArrayLength); // The size of ArrayList should be positive and less than MaxArrayLength as enforced in this class.
Debug.Assert((index >= 0) && (index < _size)); // The provided index should be in appropriate range for the current list.
Debug.Assert((Capacity >= _size) && (Capacity <= MaxArrayLength)); // The Capacity should be within appropriate range for the current list._size and MaxArrayLength defined in this class.
Debug.Assert(item == null || !Contains(item)); // The item should not exist in the ArrayList before and after it is added.
Debug.Assert(this[index] != null); // The element at the given index should never be null.
Debug.Assert(Count, this[RandomIndex(Count)]); // Any operation that modifies the list, like adding or removing items, keeps the item at a random index the same.
Debug.Assert(Count, this[OriginalIndex]); // Any operation that modifies the list, like adding or removing items, keeps the item at the original index the same unless the original index was removed.
--------------------
ArrayList arrayList = new ArrayList();
Object element = "element";
Debug.Assert(OLD(arrayList).Count + 1 == arrayList.Add(element));
--------------------
// @@@ array list count does not change on applying contains
Debug.Assert(_size = Count);

// @@@ array list count does not change on applying index of
Debug.Assert(_items.Length = Capacity);

// @@@ array list count does not change on inserting item
Debug.Assert(_size = Count);

// @@@ array list count decreases on removing item
Debug.Assert(_size - 1 = Count);

// @@@ array list count increases on adding item
Debug.Assert(_size + 1 = Count);

// @@@ count never increases when adding multiple items
Debug.Assert(_size = Count);

// @@@ count never increases when adding multiple items and inserting item
Debug.Assert(_size = Count);

// @@@ count increases and item is still accessible by index
Debug.Assert(_size + 1 == Count && _items[_size - 1].Equals(value));

// @@@ count never decreases when removing one item
Debug.Assert(_size = Count);

// @@@ count equals to number of items after removing specific item
for(int i=0;i<_size;i++){
    if (_items[i] != null && _items[i].Equals(value))
    {
        Debug.Assert(Count - 1 == _size);
        Debug.Assert(_items[i] == null);
        break;
    }
}
