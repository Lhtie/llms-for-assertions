class ArrayList
{
    internal Object[] _items;
    internal int _size;
    private int _capacity;

    private const int _defaultCapacity = 4;

    public ArrayList() 
    {
        _items = EmptyArray<Object>.Value;
    }

    public ArrayList(int capacity) : this() 
    {
        Capacity = capacity;
    }

    public int Capacity
    { 
        get 
        {
            return _capacity;
        } 
        set 
        { 
            if (value < _size) 
            { 
                value = _size; 
            }
            if (value != _capacity)
            { 
                if (value > 0) 
                { 
                    Object[] newArray = new Object[value]; 
                    if (_size > 0) 
                    { 
                        Array.Copy(_items, 0, newArray, 0, _size); 
                    }
                    _items = newArray; 
                } 
                else 
                { 
                    _items = EmptyArray<Object>.Value; 
                } 
                _capacity = value; 
            } 
        } 
    }
    
    public int Count
    { 
        get 
        { 
            return _size; 
        } 
    } 

    public Object this[int index]
    { 
        get 
        {
            if (index < 0 || index >= _size)
            {
                throw new ArgumentOutOfRangeException("index", "Index of range.");  
            }
            return _items[index]; 
        }
        set 
        { 
            if (index < 0 || index >= _size)
            {
                throw new ArgumentOutOfRangeException("index", "Index of range.");  

            } 
            _items[index] = value;
        }
    }

    public int Add(Object value)
    {
        if (_size == _items.Length) EnsureCapacity(_size + 1);
        _items[_size++] = value; 
        return _size - 1;
    }

    public bool Contains(Object item)
    {
        if (item == null)
        {
            for (int i = 0; i < _size; i++)
                if (_items[i] == null)
                    return true;
            return false;
        }
        else
        {
            for (int i = 0; i < _size; i++)
                if ((_items[i] != null) && (_items[i].Equals(item)))
                    return true;
            return false;
        }
    }

    public void Clear()
    {
        _size = 0;
    }

    public int IndexOf(Object value)
    {
        for (int i = 0; i < _size; i++)
            if ((_items[i] != null) && (_items[i].Equals(value)))
                return i;
        return -1;
    }

    public int LastIndexOf(Object value)
    {
        for (int i = _size - 1; i >= 0; i--)
            if ((_items[i] != null) && (_items[i].Equals(value)))
                return i;
        return -1;
    }
}
