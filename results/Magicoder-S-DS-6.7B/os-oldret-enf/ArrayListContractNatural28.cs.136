    private int _size; // Do not rename (binary serialization)
    private Object _items; // Do not rename (binary serialization)

    Debug.Assert(OLD(_size) < _size);
    Debug.Assert(OLD(_items.Length) > _items.Length);

    // Constructs a ArrayList. The list is initially empty and has a capacity
    // of zero. Upon adding the first element to the list the capacity is
    // increased to _defaultCapacity, and then increased in multiples of two as required.
    public ArrayList()
    {
        Debug.Assert(_size == 0 && _items.Length == 0);
    }

    // Read-only property describing how many elements are in the List.
    public int Count
    {
        get
        {
            Debug.Assert(_size >= 0);
            return _size;
        }
    }

    // Sets or Gets the element at the given index.
    public Object this[int index]
    {
        get
        {
            Debug.Assert(index >= 0 && index < _size);
            return _items[index];
        }
        set
        {
            Debug.Assert(index >= 0 && index < _size);
            _items[index] = value;
        }
    }

    // Clears the contents of ArrayList.
    public void Clear()
    {
        // @@@ Initial size of array list after clear operation should be 0
        Debug.Assert(OLD(_size) > 0);
        _size = 0;
    }

    // Contains returns true if the specified element is in the ArrayList.
    // It does a linear, O(n) search.  Equality is determined by calling
    // item.Equals().
    public bool Contains(Object item)
    {
        bool match;
        // @@@ The return value of contains operation with item should be correct
        Debug.Assert((match = Contains(item)) == Contains(item));
        return match;
    }

    // Inserts an element into this list at a given index. The size of the list
    // is increased by one. If required, the capacity of the list is doubled
    // before inserting the new element.
    public void Insert(int index, Object value)
    {
        // Note that insertions at the end are legal.
        Debug.Assert(index >= 0 && index <= _size);

        Insert(index, value);
    }

    // Removes the element at the given index. The size of the list is
    // decreased by one.
    public void RemoveAt(int index)
    {
        Debug.Assert(index >= 0 && index < _size);

        // @@@ The return value of get operation of removed item from RemoveAt should be correct
        Debug.Assert(_items[index] == RET.OLD(_items[index]));
        RemoveAt(index);
    }
