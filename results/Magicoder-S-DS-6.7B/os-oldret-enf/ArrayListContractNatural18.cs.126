<code>
public static void AddRange(System.Collections.ICollection c)
{
    if (c == null)
        throw new ArgumentNullException(NAMEOF(c));

    foreach (Object item in c)
        Add(item); // @@@ Value of this index is the value of object if it is same as item then it will be added to ArrayList
}
