Debug.Assert(this[index] != null); // The element at the given index should never be null.
Debug.Assert(Count, this[RandomIndex(Count)]); // Any operation that modifies the list, like adding or removing items, keeps the item at a random index the same.
Debug.Assert(Count, this[OriginalIndex]); // Any operation that modifies the list, like adding or removing items, keeps the item at the original index the same unless the original index was removed.
