Debug.Assert(OLD(Count) + 1 == Count); // Increase in size after inserting object
Debug.Assert(OLD(Count) - 1 == Count); // Decrease in size before removing object
Debug.Assert(OLD(Count).Equals(Count)); // Size should not be modified
Debug.Assert(OLD(Count).CompareTo(Count) <= 0); // Size should not decrease
Debug.Assert(OLD(Count) >= 0); // Size shouldn't be negative
