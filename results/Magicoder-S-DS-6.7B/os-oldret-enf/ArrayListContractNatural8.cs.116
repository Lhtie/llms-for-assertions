
public class AssertStatement
{
    public string OriginalCode;
    public string AssertStatementCode;

    public AssertStatement(string code)
    {
        OriginalCode = code;
        GenerateAssertStatement();
    }

    private void GenerateAssertStatement()
    {
        int openComment = OriginalCode.IndexOf("// @@@");
        if (openComment != -1)
        {
            int closeComment = OriginalCode.IndexOf(";", openComment);
            if (closeComment != -1)
            {
                string comment = OriginalCode.Substring(openComment, closeComment - openComment).Trim();
                Debug.Assert(comment.StartsWith("@@@"));

                bool isStatic = OriginalCode.Contains("static ");

                // This is a basic parsing logic. Real-life scenarios would require a full parser or syntax tokens.
                int firstIndex = OriginalCode.IndexOf('(');
                int lastIndex = OriginalCode.LastIndexOf('(');

                string methodName = isStatic ? OriginalCode.Substring(8, firstIndex - 8) : OriginalCode.Substring(2, firstIndex - 2);
                string parameterNames = OriginalCode.Substring(firstIndex + 1, lastIndex - firstIndex - 1);
                string variableName = parameterNames.Split(',').FirstOrDefault().Trim();

                string returnValue = "RET";
                if (isStatic)
                {
                    returnValue = comment.Substring(comment.IndexOf('(') + 1, comment.IndexOf('=') - comment.IndexOf('(') - 1).Trim();
                }

                AssertStatementCode = $"Debug.Assert({returnValue} == OLD({variableName}));";
            }
        }
    }
}

