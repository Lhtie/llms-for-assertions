public static int Sum(int x, int y) {
    for (int i = 0; i < y; i++) {
        x = x + 1; // Updating x by one as per requirement
    }
    // @@@ Value of x increases by y in the function
    Debug.Assert(x = OLD(x) + y);
    return x;
}
