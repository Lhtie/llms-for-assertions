public void RemoveAt(int index)
{
    Debug.Assert((index >= 0 && index < _size), "SR.ArgumentOutOfRange_Index");
    Array.Copy(_items, index+1, _items, index, _size - index - 1);
    _items[--_size] = null;
    _version++;
}
