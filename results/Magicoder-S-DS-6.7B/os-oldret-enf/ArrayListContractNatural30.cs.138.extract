public void TestArrayListAdd()
{
    // @@@ The returned object at index 1 is the first object added to ArrayList
    ArrayList obj = new ArrayList();
    obj.Add(1);
    obj.Add("two");
    obj.Add(3.0);
    Assert.AreEqual(obj[0], 1);

    // @@@ The number of elements in a arraylist is 3.
    obj.Add(4);
    obj.Add("five");
    Assert.AreEqual(obj.Count, 5);
    Assert.AreEqual(obj[4], "five");

    // @@@ After the removal, the count is 4.
    obj.Remove(3.0);
    Assert.AreEqual(obj.Count, 4);

    // @@@ After the insertion, the count is 5.
    obj.Insert(1, "two_updated");
    Assert.AreEqual(obj.Count, 5);
    Assert.AreEqual(obj[1], "two_updated");
}
