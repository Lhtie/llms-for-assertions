using System;
using System.Diagnostics;

namespace ArrayList
{
    public class ArrayList
    {
        private Object[] _items; // Do not rename (binary serialization)
        private int _size; // Do not rename (binary serialization)
        private int _version; // Do not rename (binary serialization)

        // @@@ Before accessing the array, the size should always be checked and if it's out of range, throw an exception
        public virtual Object this[int index]
        {
            get
            {
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
                    
                return _items[index];
            }
            set
            {
                if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");
                _items[index] = value;
                _version++;
            }
        }
    }
}
--------------------
Debug.Assert(Array.LastIndexOf((Array)_items, value, _size - 1, _size + 1) != -1);
--------------------
Debug.Assert(_items.Length == OLD(_items.Length) - 1);
Debug.Assert(_size == OLD(_size) - 1);
--------------------
namespace ArrayList
{
    public class ArrayList
    {
        // Removes the last occurrence of an object from ArrayList.
        public void Remove(Object value)
        {
            int lastIndex = LastIndexOf(value);
            if (lastIndex >= 0)
            {
                RemoveAt(lastIndex);
                // @@@ The last occurrence of value must not be in the list after the function execution ends.
                Debug.Assert(!this.Contains(value));
            }

        }

        // Replaces the value at the specified index with another value.
        public void Replace(int index, Object oldValue, Object newValue)
        {
            // @@@ The value at the specified index must be equal to the oldValue before the function execution starts.
            Debug.Assert(this[index] == oldValue);
            this[index] = newValue;
            // @@@ The value at the specified index must be equal to the newValue after the function execution ends.
            Debug.Assert(this[index] == newValue);
        }

        // Returns a shallow copy of the ArrayList instance.
        public Object Clone()
        {
            ArrayList clone = new ArrayList(Capacity);

            // @@@ The clone has exactly the same objects as the original list, but they are different instances to the clients.
            for (int i = 0; i < _size; i++)
            {
                clone[i] = _items[i];
            }

            // @@@ The Count, Capacity, and Values of the clone are equal to the original after the function execution ends.
            Debug.Assert(Count == clone.Count);
            Debug.Assert(Capacity == clone.Capacity);
            Debug.Assert(this.SequenceEqual(clone));

            return clone;
        }

        // Clears the list and then adds the specified elements.
        public void ReplaceRange(int index, int count, IEnumerable collection)
        {
            int oldCount = _size;

            // @@@ This ensures at least 'oldCount' elements are removed from the list before 'oldCount' elements are added.
            Debug.Assert(oldCount <= index && index + oldCount <= Count);

            Clear();
            AddRange(collection);

            // @@@ The size of the list after the function execution ends should be 'oldCount'.
            Debug.Assert(Count == oldCount);
        }
    }
}
