private int LastIndexOf(Object value, int startIndex, int count)
{
  for (int i = startIndex; i >= 0; i--)
  {
     if ((_items[i] != null) && _items[i].Equals(value))
     {
       Debug.Assert(count > i);
       return i;
     }
  }
  Debug.Assert(false);	// value was not found
  return -1;
}
