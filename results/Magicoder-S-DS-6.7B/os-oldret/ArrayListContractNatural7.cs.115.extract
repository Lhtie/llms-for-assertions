def read_and_print_assert(code_string):
    # Regular expression pattern that matches the comments starting with "@@@".
    pattern = r'(?<=\@\@\@)[\s\S]*(?=\@\@\@|\Z)'

    comments = re.findall(pattern, code_string)
    for comment in comments:
        print(f'Debug.Assert({html.unescape(comment)});')

