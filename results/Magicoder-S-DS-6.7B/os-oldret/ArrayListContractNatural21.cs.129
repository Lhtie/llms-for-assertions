Here is the corresponding Python program that reads and outputs an assert statement corresponding to the comment that starts with "@@@". 

```python
import re

def csharp2assert(code):
    # Regular expression to find the comments
    regex = r"\/\*\*\s*(.*?)\s*\@\@\@\s*(.*)\n"

    matchObj = re.findall(regex, code, re.DOTALL)
    assertStatements = []
    for comment in matchObj:
        if comment[1]:
            comment = comment[1].strip().replace("\n", " ")
            assertStatement = f"Debug.Assert({comment});"
            assertStatements.append(assertStatement)
            # Replace the comment with corresponding assert statement
            code = code.replace(comment, "// " + assertStatement.replace("Debug.Assert", "").rstrip().lstrip("(").rstrip(")"), 1)

    return code, assertStatements
```

