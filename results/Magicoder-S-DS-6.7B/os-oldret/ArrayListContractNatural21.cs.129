def csharp2assert(tree):
    assertStatements = []
    for node in tree:
        if isinstance(node, Comment) and node.value.startswith("@@@"):
            comment = node.value[3:].strip().replace("\n", " ")
            assertStatement = f"Debug.Assert({comment});"
            assertStatements.append(assertStatement)
            node.value = "// " + assertStatement.replace("Debug.Assert", "").rstrip().lstrip("(").rstrip(")")
    return assertStatements
```

