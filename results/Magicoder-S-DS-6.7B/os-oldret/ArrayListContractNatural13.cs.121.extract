// Count of ArrayList objects is correctly maintained, even when Add, RemoveAt, and Clear are invoked
Debug.Assert(OLD(Count) == ArrayList.Count);
// ArrayList count does not change on applying RemoveAt
Debug.Assert(Collection_Helpers.CollectionTest(
            RemoveAt => new Action(_size =>
            {
                ArrayList arrayList = new ArrayList(_size);
                for (int i = 0; i < _size; ++i)
                    arrayList.Add(Guid.NewGuid().ToString());

                arrayList.RemoveAt(_size - 1);
                return new ArrayList(arrayList);
            }),
            Clear => new Action(() => new ArrayList { "a" })
        ));
