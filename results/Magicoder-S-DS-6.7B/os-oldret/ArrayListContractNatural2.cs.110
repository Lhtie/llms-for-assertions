import re
import pycparser

def find_assertions(node):
    for child in node.children():
        if isinstance(child, pycparser.c_ast.FuncDef) and child.decl.name.name == "ArrayList":
            for statement in child.body.block_items:
                if statement.type == 'func_decl' and re.match(r"@@@.*", statement.name):
                    yield statement.name
        find_assertions(child)

program_node = pycparser.parse("<your csharp code here>")
assertions = [a for a in find_assertions(program_node)][0]

# Remove the @@@ symbol and any following spaces/tabs etc.
