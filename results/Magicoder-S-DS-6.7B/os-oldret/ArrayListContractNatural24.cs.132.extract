
    // There is at least one instance of Count always greater than or equal to 0
    Debug.Assert(Count >= 0);
    
    // The Array.Length property is always equals to 4
    Debug.Assert(Capacity == 4);

    // Capacity is always equals or greater than Count
    Debug.Assert(Capacity >= Count);

    // The argument index for ArrayList.Insert(index, value) is always within the range of 0 to Count
    Debug.Assert(index >= 0 && index <= Count);

    // The argument index for ArrayList.RemoveAt(index) is always within the range of 0 to Count - 1
    Debug.Assert(index >= 0 && index <= Count - 1);

    // Value added to Array is not null, Value removed from Array is not null
    Debug.Assert(value != null);

    // The Size always equals to 0 when Clear() is executed
    Debug.Assert(Count == 0);

--------------------------------------------------------------------------------
<!-- @@@ Returns -1 (Int32) if not Found -->
Debug.Assert(ArrayList().IndexOf(Object) >= -1);
<!-- @@@ Removes and returns: false (False) if Not in List and returns: true (True) upon successful removal -->
Debug.Assert(ArrayList().ArrayList.Remove(Object) is bool);
<!-- @@@ Contains: false (False) if not in array and true (True) if in array -->
Debug.Assert(ArrayList().ArrayList.Contains(Object) is bool);
<!-- @@@ Last occurrence index must be smaller than the array size -->
Debug.Assert(ArrayList().LastIndexOf(Object) < ArrayList().Count);
<!-- @@@ Add object to the end of the list and return the size of the updated list -->
Debug.Assert(ArrayList().ArrayList.Add(Object) == ArrayList().ArrayList.Count);
<!-- @@@ Add range of objects to the end of the list and return the updated size of the list -->
Debug.Assert(ArrayList().ArrayList.AddRange(ICollection) == ArrayList().ArrayList.Count);
<!-- @@@ Clearing the array list and its size should be zero -->
Debug.Assert(ArrayList().ArrayList.Clear() == ArrayList().ArrayList.Count);
<!-- @@@ Inserting an element at a given index and returning the updated size of the list -->
Debug.Assert(ArrayList().ArrayList.Insert(int,Object) == ArrayList().ArrayList.Count);
<!-- @@@ Removing an object at a given index and returning the updated size of the array list -->
Debug.Assert(ArrayList().ArrayList.RemoveAt(int) == ArrayList().ArrayList.Count);
<!-- @@@ Inserting elements to a given index, checking if array list size remains unchanged -->
Debug.Assert(ArrayList().ArrayList.Count == ArrayList().ArrayList.Insert(int,Object));
<!-- @@@ The count should increase (size increase by one) when an element is added to the list -->
Debug.Assert(ArrayList().ArrayList.Count + 1 == ArrayList().ArrayList.Add(Object));
