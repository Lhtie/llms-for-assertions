Debug.Assert(ObjectEquals(OLD(_size), Increment(_size * 2)) && OLD(_items).Length == ValueOf(2 * OLD(_items).Length));
Debug.Assert(ObjectEquals(_items[index], Increment(_size * 2)) && _items.Length == ValueOf(2*_items.Length));
Debug.Assert(ObjectEquals(OLD(value), ADD(_items, _items.Length)) && _items.Length == ValueOf(2*_items.Length));
Debug.Assert(OLD(value) == ValueOf(2*) && _items.Length == ValueOf(2*_items.Length));
Debug.Assert(OLD(value) == ValueOf(2*) && _size == ValueOf(2*_size));
