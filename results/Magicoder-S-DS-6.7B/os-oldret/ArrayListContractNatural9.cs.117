import subprocess

def generate_assert_statement(func_body: str) -> str:
    code = f'''
namespace Test {{
    public class Value
    {{public int Value = 0;}}
    public class Program
    {{
        static void Main(string[] args)
        {{
            var a = new Value();
            var b = new Value();
            var results = {func_body};
            System.Diagnostics.Debug.Assert(results);
        }}
    }}
}}
'''
    with open('test.cs', 'w') as f:
        f.write(code)

    return_code = subprocess.run(['dotnet', 'run', '-p', 'test.csproj'], universal_newlines=True, stdout=subprocess.PIPE).stdout
    return return_code

code = generate_assert_statement("return a.Value + b.Value;")
print(code)
