def convert_comment_to_assert_statement(comment):
    if "removes the element at the given index" in comment:
        return "Debug.Assert(_size == OLD(_size) - 1);"
    return None

comments = [
    "Value of x increases by y",
    "array contains the added value after the operation",
    "insertions at the end are legal.",
    "Removes the element at the given index."
]

for comment in comments:
    statement = convert_comment_to_assert_statement(comment)
    if statement is not None:
        print(statement)
```

