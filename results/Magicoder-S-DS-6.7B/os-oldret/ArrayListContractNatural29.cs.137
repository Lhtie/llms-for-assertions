```cs
using System;
using System.Collections;
using System.Diagnostics;
using System.Linq;

public class Program
{
    public static void Main()
    {
        string csharpCode = @"
public static int Sum(int x, int y)
{
    for (int i = 0; i < y; i++){
        x.Inc(1);
    }
    // @@@ Value of x increases by y in the function
    return x;
}";

        ReadAndProcessComments(csharpCode);
    }

    private static void ReadAndProcessComments(string csharpCode)
    {
        var lines = csharpCode.Split(new string[] { Environment.NewLine }, StringSplitOptions.None);
        foreach (var line in lines)
        {
            if (line.TrimStart().StartsWith("// @@@"))
            {
                string comment = line.Replace("// ", "").Trim();
                Debug.Assert(comment, "Assert statement failed");
                Console.WriteLine($"<code>Debug.Assert({comment});</code>");
            }
        }
    }
}
```

