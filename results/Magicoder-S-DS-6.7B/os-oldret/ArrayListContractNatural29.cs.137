public class ArrayList : System.Collections.IList, ICloneable
{
    private Object[] _items; 
    private int _size;  
    private int _version; 
    [NonSerialized]
    private Object _syncRoot;

    private const int _defaultCapacity = 4;


    public ArrayList()
    {
        _items = EmptyArray<Object>.Value;
    }

    public ArrayList(int capacity);

    public virtual int Capacity
    {
        get
        {
            return this._items.Length;
        }
        set
        {
           //implementation details not shown for brevity
           //@ asserts that capacity is greater as required
           Debug.Assert(value > Old(this._items.Length));
        }
    }

    public virtual int Count
    {
        get
        {
            return _size;
        }
    }

    public virtual Object this[int index]
    {
        get
        {
            //Some constraints not shown for brevity
            return _items[index];
        }
        set
        {
            //Some constraints not shown for brevity
            _items[index] = value;
            _version++;
        }
    }

    public virtual int Add(Object value)
    {
        if (_size == _items.Length) EnsureCapacity(_size + 1);
        _items[_size] = value;
        _version++;
        //We need to ensure that 'Count' of elements in ArrayList increase by 1
        //@assert: _size of ArrayList(obj) is increased by 1
        Debug.Assert(_size == Old(_size) + 1);
        return _size++;
    }

