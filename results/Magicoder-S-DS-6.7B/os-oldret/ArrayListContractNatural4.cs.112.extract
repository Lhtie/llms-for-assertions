Debug.Assert(_size == OLD(c._size), "Size of ArrayList did not match after calling AddRange with another ArrayList as parameter");

Debug.Assert(_items.Length == OLD(c._items.Length), "Capacity of array list is not correctly after calling AddRange method with another ArrayList as parameter");
--------------------
Debug.Assert(OLD(_size) == ret);
----------------------------------------
Debug.Assert(OLD(_size) < _items.Length); // Comment: size of array does not change after the operation
Debug.Assert(_items[_size].Equals(value)); // Comment: value is added at the end of the array
Debug.Assert(_size == _items.Length); // Comment: size of array changes after the operation
Debug.Assert(_size != _items.Length); // Comment: size of array changes after the operation
Debug.Assert(Array.IndexOf((Array)_items, value, 0, OLD(_size)) == -1); // Comment: value was added into an array 
Debug.Assert(LastIndexOf(value, _size - 1, OLD(_size)) != -1); // Comment: value was removed from an array
Debug.Assert(index < 0 || index >= _size); // Comment: index is valid for size of the array
Debug.Assert(Array.IndexOf((Array)_items, value, 0, OLD(_size)) == -1); // Comment: value was not found in the array
Debug.Assert(LastIndexOf(value, _size - 1, OLD(_size)) == -1); // Comment: value was not found in the array
Debug.Assert(index >= 0 && index <= _size); // Comment: index is not valid for size of the array
Debug.Assert(_items[index] == null); // Comment: item at the given index is null
Debug.Assert(_items[index] != null); // Comment: item at the given index is not null
--------------------
Debug.Assert((int)OLD(_items.Length) == _size);
