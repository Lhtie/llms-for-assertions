import re

csharp_code = """
// @@@ The function should throw if the given argument is out of range
public static int GetValue(int[] arr, int index)
{
    if (index < 0 || index >= arr.Length) 
    {
        throw new IndexOutOfRangeException();
    }
    return arr[index];
}
"""

def replace_comments(code):
    # Using regex to find comments starting with "@@@"
    matches = re.findall("(?s)(?<=// @@@ )(.*)(?=\n)", code)
    for match in matches:
        assert_command = ""
        variables = re.findall("\b\w+\b", match)

        if "OLD" in variables:
            for variable in variables:
                if variable == "OLD":
                    variable = re.findall("OLD\((.+?)\)", match)[0]
                    assert_command = f"Assert.AreEqual(x, {variable});"

        if "RET" in variables:
            for variable in variables:
                if variable == "RET":
                    assert_command = f"Assert.AreEqual(x, {variable});"
                    
        print(f"<code>{assert_command}</code>")

replace_comments(csharp_code)
```

