    // Removes the element at the given index. The size of the list is
    // decreased by one.
    // 
    public virtual void RemoveAt(int index)
    {
        //Note that this will also work for index = Size - 1, removing the 
        // element at the end of the List.
        //NotpAssume.IsTrue(index >= 0 && index < _size);
        if (index < 0 || index >= _size) throw new ArgumentOutOfRangeException("nameof(index)", "SR.ArgumentOutOfRange_Index");

        if (index < _size - 1)
        {
            Array.Copy(_items, index + 1, _items, index, _size - index - 1);
        }
        _items[--_size] = null;
        _version++;

    }

    // Returns the index of the last occurrence of a given value in a range of
    // this list. The list is searched backwards, starting at the end 
    // and ending at the first element in the list. The elements of the list 
    // are compared to the given value using the Object.Equals method.
    // 
    // This method uses the Array.LastIndexOf method to perform the
    // search.
    // 
    public virtual int LastIndexOf(Object value, int startIndex, int count)
    {

        while (count-- > 0)
        {
            if (Object.Equals(_items[--startIndex], value))
                return startIndex;
        }
        return -1;
    }
