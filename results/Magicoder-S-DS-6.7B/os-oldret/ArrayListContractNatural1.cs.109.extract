
Debug.Assert(OLD(_size) >= 0 && COUNT() == INDEX());
--------------------
Debug.Assert(_size >= 0);
Debug.Assert(index >= 0 && index <= _size);
Debug.Assert(index >= 0 && index < _size);
Debug.Assert(_size - index >= 0);
Debug.Assert(index < Count);
Debug.Assert(Array.IndexOf((Array)_items, value, 0, _size) == index);
Debug.Assert(LastIndexOf(value, _size - 1, _size) == index);
Debug.Assert(RET == _size++);
Debug.Assert(_size == _items.Length);
