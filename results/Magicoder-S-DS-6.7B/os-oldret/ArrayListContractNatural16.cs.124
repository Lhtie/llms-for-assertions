```python
import re

def findAssertStatement(cs_code):
    assertions = re.findall(r'// @@@ (.*?)//', cs_code, re.DOTALL)
    
    for comment in assertions:
        cs_part = re.search(r'(?s)(?<=\{\n).*?(?=>\n\}|return)', cs_code)

        if cs_part:
            print(f'\nDebug.Assert({cs_part.group().strip()});\n')
        else:
            print(f'\nDebug.Assert({comment.strip()});\n')

