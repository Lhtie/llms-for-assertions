using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp;
using System;
using System.IO;
using System.Linq;
using System.Text;

namespace RoslynTest
{
    class Program
    {
        static void Main(string[] args)
        {
            var src = File.ReadAllText("./Program.cs");
            var tree = CSharpSyntaxTree.ParseText(src);
            var root = (CSharpSyntaxNode)tree.GetRoot();

            var sb = new StringBuilder();

            // walk the Abstract Syntax Tree 
            root.DescendantTokens()
                .Where(w => w.Kind() == SyntaxKind.XmlTextLiteralToken)   // we are looking for the string between < > in comments
                .ToList()
                .ForEach(token => sb.AppendLine(token.Text));  // this will help you to get comment between <> in xml comment

            var commentLines = sb.ToString().Split(new[] { "\n" }, StringSplitOptions.RemoveEmptyEntries);   // you may want to split by new Line
            commentLines.ToList().ForEach(commentLine =>
            {
                if (commentLine.StartsWith("@@@"))
                {
                    // process commentLine here extracting required information using Regex for example
                    Console.WriteLine(commentLine.Trim().Substring(3));
                }
            });
        }
    }
}
