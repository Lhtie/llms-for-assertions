```python
import re

def cs_get_assert(code):
    match_objects = re.findall('\/\/\/\s*@@@\s*(.*)', code, re.DOTALL)
    asserts = []
    
    for match_object in match_objects:
        match_object = match_object.strip()
        if match_object:
            if match_object.find('RET') != -1:
                return_value = match_object.split('RET:')[1].strip()
                assert_string = 'Debug.Assert(%s);\n' % return_value
                asserts.append(assert_string)
            elif match_object.find('OLD(') != -1:
                old_variable_name = match_object.split('OLD(')[-1].split(')')[0]
                old_value = match_object.split('OLD(%s) = ' % old_variable_name)[1].strip()
                old_value = old_value.split(';')[0].strip()
                assert_string = 'Debug.Assert(%s == %s);\n' % (old_variable_name, old_value)
                asserts.append(assert_string)
        
    return asserts

def main():
    with open('path/to/your/code.py', 'r') as f:
        code = f.read()
        asserts = cs_get_assert(code)
        for assert_string in asserts:
            print(assert_string)

if __name__ == '__main__':
    main()
```
