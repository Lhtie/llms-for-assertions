// Assuming that the List of comments start at the beginning of the method
String[] lines = code.Split(Environment.NewLine);
for(int i = 0; i < lines.Length; i++) {
   if(lines[i].Trim().StartsWith("@@@")) {
      String assertion = lines[i].Trim().Substring(3); //Removing the `@@@`
      int startIndex = assertion.IndexOf('(');
      int endIndex = assertion.IndexOf('=');
      String variableName = assertion.Substring(startIndex+1, endIndex-startIndex-1).Trim();
      String before = assertion.Substring(0, endIndex-1);
      String after = assertion.Substring(endIndex+1).Trim().Replace("OLD(", "").Replace(")", "");
      assertion = String.Format("Debug.Assert({0}, \"{1}\")", before, after);
      Console.WriteLine("<code>\n" + assertion + "\n</code>");
   }
}
