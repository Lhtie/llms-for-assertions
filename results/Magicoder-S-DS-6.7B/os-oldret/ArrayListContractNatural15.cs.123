Here's how we could implement this in Python:

Python:
```python
import re

def comment_assert_statement(csharp_code):
    pattern = "@@@ (.+?)"
    comments = re.findall(pattern, csharp_code)
    assert_statements = []

    for comment in comments:
        assert_statements.append("Debug.Assert(" + comment.replace("x", "OLD(x)").replace("y", "y") + ");")

    return assert_statements

csharp_code = """
public static int Sum(int x, int y)
{
    for (int i = 0; i < y; i++){
        x.Inc(1);
    }
    // @@@ Value of x increases by y in the function
    return x;
}
"""

assert_statements = comment_assert_statement(csharp_code)
print("\n".join(assert_statements))
```

