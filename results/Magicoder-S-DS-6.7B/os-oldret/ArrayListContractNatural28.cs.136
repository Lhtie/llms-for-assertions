```python
import re

def parse_csharp_comments(filename):
    with open(filename, 'r') as file:
        code = file.read()

    # find function definitions
    function_regex = r"\bpublic\b\s*\w*\s*.*\n\s*\((.*?)\)"
    functions = re.findall(function_regex, code)

    # find assert statement comments
    assert_statement_regex = r"^\s*//\s*@@\w*+\s*(.*?)\s*$"
    assert_statements = re.findall(assert_statement_regex, code, re.MULTILINE)    
    
    return functions, assert_statements

def generate_assert(statements, functions):
    for i, function in enumerate(functions):
        print(f"<code> {function} </code>")
        statement = statements[i]
        variable_names = [i.split('_')[-1] for i in function.split('_') if 'int ' in i]
        print(f"Assert.IsTrue({variable_names[0]} + ({statement.split('increases by ')[1].split(' in')[0]}) == {variable_names[0]});")
        
functions, assert_statements = parse_csharp_comments("ArrayList.cs")
generate_assert(assert_statements, functions)
```

