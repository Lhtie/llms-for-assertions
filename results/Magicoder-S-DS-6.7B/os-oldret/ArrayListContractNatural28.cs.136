def extract_assert_statements(code_file_path):
    with open(code_file_path, 'r') as file:
        code = file.read()

    assert_statements = []
    in_method = False
    assert_statement = ""
    for i in range(len(code)):
        if in_method:
            if code[i] == '{':
                block_brackets = 0
                for j in range(i+1, len(code)):
                    if code[j] == '{':
                        block_brackets += 1
                    elif code[j] == '}':
                        block_brackets -= 1
                    if code[j] == ';':
                        if "Debug.Assert" in code[i:j]:
                            assert_statement += code[i:j]
                            assert_statements.append(assert_statement)
                            assert_statement = ""
                            in_method = False
                            break
                    elif block_brackets == 0:
                        break
        else:
            if code[i:i+4] == "public":
                in_method = True
                assert_statement += code[i:i+4] + ' '

    return assert_statements

# Call the function
print(extract_assert_statements('path_to_your_csharp_code_file.cs'))
```

