Here's how you can do it in python.

```python
import re

def parse_assert_and_code(code):

    code_lines = code.split('\n')
    assert_stmt = ''
    csharp_code = ''

    for line in code_lines:
        if line.strip().startswith('// @@@'):
            assert_stmt += line[7:] + ' '
        elif line.strip().startswith('//'):
            assert_stmt += line[2:]
        else:
            csharp_code += line + '\n'

    # Regex to replace variables in the expression
    pattern = r'\b(OLD\(([_a-zA-Z]\w*)\)|RET)\b'
    assert_stmt = re.sub(pattern, lambda match: 'OLD(\1)' if match.group(1) == 'OLD' else 'RET', assert_stmt.strip())
    return '<code>' + assert_stmt + '</code>', csharp_code


code = '''
public static int Sum(int x, int y)
{
    for (int i = 0; i < y; i++){
        x.Inc(1);
    }
    // @@@ Value of x increases by y in the function
    return x;
}
'''

assert_statement, csharp_code = parse_assert_and_code(code)

print(assert_statement)
print(csharp_code)
```

