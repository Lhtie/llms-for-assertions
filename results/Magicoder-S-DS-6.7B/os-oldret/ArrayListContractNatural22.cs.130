import re

def generate_assert_statement(code):
    # The regular expression to match the comments starting with "@@@"
    matches = re.findall('//(\s*@@@\s*)(.*)', code)
    
    # Generate and print the assert statements
    for match in matches:
        assert_text, comment = match
        print('Debug.Assert(' + comment + ');')

if __name__ == "__main__":
