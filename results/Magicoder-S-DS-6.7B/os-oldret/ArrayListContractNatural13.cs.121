```python
import re

def extract_assert(code):
    # Regular expression to match the comment line
    pattern = r"// @@@ (.*?)\n"

    # Find all comments that start with "@@@" and extract the content
    assert_statements = re.findall(pattern, code)

    return assert_statements

# Sample code
code = """ 
public static int Sum(int x, int y)
{
    for (int i = 0; i < y; i++){
        x.Inc(1);
    }
    // @@@ Value of x increases by y in the function
    return x;
}
"""

# Get the assert statements
assert_statements = extract_assert(code)

for assert_statement in assert_statements:
    print("Debug.Assert({} == {});".format(assert_statement.split('Value')[1], return_variable).replace('Inc(1)', 'value').replace(';', ''))
```

