```python
import re

def find_comments(code):
    pattern = r'(\/\/.*)|(\/\*[\s\S]*?\*\/)|(".*?")|(\'.*?\')'
    matches = re.findall(pattern, code)
    comments = [m[0].strip() for m in matches if m[0].strip().startswith("@@@")]
    return comments

def generate_assert(comment):
    assert_statement = f"Debug.Assert({comment.strip('@@@').strip()});\n"
    return assert_statement

if __name__ == "__main__":
    code = """ 
    Your_code_here 
    """
    comments = find_comments(code)
    for comment in comments:
        print(generate_assert(comment))
```

The above script would first find all comments in your code, then the ones that start with '@@@', and finally turn each such comment into a Debug.Assert line. 

