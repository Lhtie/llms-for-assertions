Here's one way to read and parse the comments in the provided code and generate the assert statements:

```python
import re

def find_comments(code):
    # Finding comments
    comments = re.findall(r'//.*?$|/\*[\s\S]*?\*/', code, re.MULTILINE)
    
    return comments

def gen_assert_stat(comment, val):
    # generating assert statement
    comment = comment.strip()
    if " Value " in comment:
        vars = re.findall(r'Value of (.*?)\s', comment)
        for var in vars:
            comment = comment.replace("Value of "+var, f"OLD({var})")
    
    return "Debug.Assert(" +  comment + f" = {val});"

code = """
public static int Sum(int x, int y)
{
    for (int i = 0; i < y; i++){
        x.Inc(1);
    }
    // @@@ Value of x increases by y in the function
    return x;
}
"""

# getting all comments from the code
comments = find_comments(code)

assert_statements = []

for comment in comments:
    # If the comment is related to "@@@" then generate assert statement
    if "@@@" in comment:
        for keyword in comment.split():
            if keyword == "@@@":
                return_val = "RET"
            else:
                return_val = keyword.split(' of ')[1]
        
        assert_statements.append(gen_assert_stat(comment, return_val))
        
for assert_statement in assert_statments:
    print(assert_statement)
```

