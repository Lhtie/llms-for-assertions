// @@@ Element at position x in array is equal to OLD(x) 
Debug.Assert((OLD(x) &lt; _size) && _items[OLD(x)] != OLD(x));

// @@@ Position of x in array after insertion is greater than or equal to 0 
Debug.Assert((x = OLD(x) + 1) &gt;= 0);

// @@@ Value of x increases by y in the function
Debug.Assert(OLD(x) + y == x);
----------------------------------------------------------------------------------------------------