```csharp
using System;
using System.Diagnostics;
using System.Text.RegularExpressions;

public class Program
{
    static void Main(string[] args)
    {
        string csharpCode = @"
namespace ArrayList{
    // Constructs a ArrayList with a given initial capacity. 
    // The list is initially empty, but will have room for the given number of elements
    // before any reallocations are required.
    //
    public virtual ArrayList(int capacity) {
        
        // @@@ Value of _size is always less than or equal to _items.Length, which is the Capacity of the ArrayList 
    }
}";

        ExtractCommentsAndConstructAssert(csharpCode);
    }

    static void ExtractCommentsAndConstructAssert(string csharpCode)
    {
        // Regex that matches the comment starting with "@@@"
        Regex regex = new Regex(@"\/\/\s@+\s(.*)", RegexOptions.Multiline);
    
        foreach (Match match in regex.Matches(csharpCode))
        {
            if (match.Success)
            {
                Console.WriteLine($"Debug.Assert({match.Value.Trim()});");
            }
        }    
    }
}
```

The above program does the following: 
1. Defines a Regular Expression pattern that matches the comments that start with "@@@"
2. Uses Regex.Matches to find all the matches in the input C# code
3. If a match is successful, it will print out Debug.Assert() statement

Please note that this program does not compile or run C# code, it only parses text containing C# comments. If you want C# code to function please compile and run it.

