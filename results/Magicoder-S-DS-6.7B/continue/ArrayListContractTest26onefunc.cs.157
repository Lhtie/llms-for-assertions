            Assert.Less(Old_arrListIndexOfX, index);

            // an assertion using "Debug.Assert\(.*?\);" that original array count before insertion is exactly less than new array count after insertion 
            Assert.Equal(Old_arrListCount - 1, New_arrListCount);
