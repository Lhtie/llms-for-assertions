            if (Old_arrListCount != 0)
            {
                // assertion that for any old and new x values, @@@ x's old index is less than its new index after insertion
                Debug.Assert(!((Old_arrListIndexOfX < New_arrListIndexOfX) && (Old_arrListLastIndexOfX < New_arrListLastIndexOfX)),
                    "If x's old index was less than its new index after insertion, its old and new last index should also be less than their new value.");

                // assertion that x's old index less than its new index, last index is not less than new last index
                Debug.Assert((Old_arrListIndexOfX < New_arrListIndexOfX) && ((Old_arrListLastIndexOfX >= New_arrListLastIndexOfX)),
                    "If x's old index was less than its new index while x's old last index was greater than or equal to its new last index, then the new array list's last index of x is not less than old x's index.");
            }
            else
                // assertion that x's old index less than its new index
                Debug.Assert(Old_arrListIndexOfX < New_arrListIndexOfX, 
                    "If there were no elements in the array, no insertions could have happened, so the old and new indexes of x should not be the same.");

            // assertion that old and new count of arrList is not same
            Debug.Assert(Old_arrListCount != New_arrListCount, 
                    "Inserting an element to an array should change its count.");

            // assertion that old and new x contains in array
            Debug.Assert(Old_arrListContainsX == New_arrListContainsX, 
                    "Inserting an element to an array should not affect the presence or absence of x in the array.");
        }
    }
}
