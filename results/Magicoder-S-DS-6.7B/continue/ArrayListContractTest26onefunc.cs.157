            AssumeProperty.ForAll(index,
                i => index < arrList.Count,
                arrList.LastIndexOf(x) < arrList.Count);

            // an assertion using "Assert\.AreEqual\(.*?\);" that @@  x is in the list after insertion
            Assert.AreEqual(true, New_arrListContainsX);

            // an assertion using "Assert\.AreEqual\(.*?\);" that  @@  count of x in the list after insertion is equal to count of x in original list 
            Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
        }

    }
}--------------------            Debug.Assert(New_arrListCount >= Old_arrListCount + 1 && New_arrListContainsX == true && New_arrListIndexOfX == Old_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ last position of x after insertion is less than or equal to original array count 
            Debug.Assert(New_arrListLastIndexOfX >= Old_index && New_arrListLastIndexOfX <= Old_arrListCount);
        }
    }
}
