            // (i.e. it is within the valid indexes for the new array). 
            if (New_Ret >= 0)
            {
                Debug.Assert(New_arrListIndexOfX >= 0);
            }

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ In the new list, x contains 0 or 1 times. 
            // (i.e. if it's in the list, it should only appear once).
            Debug.Assert(New_arrListContainsX == (New_arrListIndexOfX >= 0));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ The last index value in the new list is equal to the last index before adding value x. 
            Debug.Assert(New_Ret == New_arrListIndexOfX);
        }
    }
}--------------------            if (New_Ret >= 0)
              Assert.IsTrue(New_arrListIndexOfX >= 0);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the old array list count is same as the new array list count 
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the array list doesn't contain x, the return value of LastIndexOf is -1 
            if (!Old_arrListContainsX)
              Assert.AreEqual(-1, New_Ret);
            
            if (Old_arrListContainsX)
            {
                Assert.IsTrue(New_arrListIndexOfX == New_Ret);
            }
	    // a comment stating "If the value to look for is in the array, then the return must be equal to or greater than 0"
        }
    }
}--------------------            PexAssert.AreNotEqual(New_Ret, -1, "If the return value is non-negative, index of x in new array is >= 0");
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is -1, then the array does not contain x
            PexAssert.AreEqual<int>(New_Ret, -1, "If the return value is -1, then the array does not contain x");
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ The count in the arraylist does not change
            PexAssert.AreEqual<int>(New_arrListCount, Old_arrListCount, "The count in the arraylist does not change");
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ The index of x in arraylist should be the same before and after method call
            PexAssert.AreEqual<int>(New_arrListIndexOfX, Old_arrListIndexOfX, "The index of x in arraylist should be the same before and after method call");
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ The arraylist should contain x after method call
            PexAssert.IsTrue(New_arrListContainsX, "The arraylist should contain x after method call");
        }
    }
}
```

Here we have a partial test method which has a loop unrolling where it iterates over the input arraylist and test the LastIndexOf on various inputs. Then it performs some post checks to validate the correctness of `LastIndexOf` method behavior.

The annotations `PexObserve.ValueForViewing` and `PexAssert` are the Pex equivalents to `Console.WriteLine` and `Debug.Assert` respectively. They are used for observing values in the GUI and checking the expected result.

The property `IsTrue` from AssumePrecondition tells that the test should only be run if the underlying condition is true. This can be useful to shorten the execution time of the test method.--------------------            if (New_Ret >= 0)
                Assert.IsTrue(New_arrListIndexOfX >= 0);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is negative, then @Old_arrListCount == New_arrListCount 
            else
                Assert.AreEqual(Old_arrListCount, New_arrListCount);
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If value x doesn't exists in arraylist, @Old_arrListContainsX == New_arrListContainsX
            if (!Old_arrListContainsX)
                Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If value x exists in arraylist, and is present in old arraylist, @New_Ret < 0
            else
                Assert.IsTrue(New_Ret < 0);
        }
    }
}--------------------	    Assert.IsTrue(New_Ret >= 0 || Old_arrListCount == 0);

	    // an assertion using "Debug.Assert\(.*?\);" that @@new array count = old array count
	    Assert.AreEqual(Old_arrListCount, New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that @@if old array contains x, new array contains x
	    Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that @@new array index of x >= old array index of x
	    Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that @@if new array index of x =-1 for old arrList.count =0 and new arrList count =0, other wise, new arrList index of x =-1
	    //Assert.IsTrue(New_arrListIndexOfX == -1 && Old_arrListCount == 0 && New_arrListCount == 0 || New_arrListIndexOfX != -1);
        }
    }
}--------------------        }
    }
}--------------------    // and that the value of this index matches the return value
            if (Old_arrListIndexOfX >= 0)
            {
                Debug.Assert(New_Ret >= 0);
                Debug.Assert(New_Ret == Old_arrListIndexOfX);
            }
        }
    }
}

//src/OpenCoverExample/ArrayList.Test/ArrayListContractTest/PUT_LastIndexOfContract.cs
using Microsoft.Pex.Framework;
using System.Diagnostics;

namespace ArrayList.Test
{
    // Test last index of function
    public partial class ArrayListContractTest
    {
        [PexMethod]
        public void PUT_LastIndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_arrListIndexOfX = arrList.IndexOf(x);

            int New_Ret = arrList.LastIndexOf(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$New_ret", New_Ret);

            // an assertion using "Debug.Assert\(.*?\);" that if the return value is non-negative, 
	    //index of x in new array is >= 0 and that the value of this index matches the return value
            if (Old_arrListIndexOfX >= 0)
            {
                Debug.Assert(New_Ret >= 0);
                Debug.Assert(New_Ret == Old_arrListIndexOfX);
            }
        }
    }
}--------------------	    Assert.IsTrue(New_arrListIndexOfX >= 0);
	    // an assertion using "Debug.Assert\(.*?\);" that new value of x in old array is == x
	    Assert.AreEqual(Old_x, arrList[New_arrListIndexOfX]);
        }
    }

    public partial class ArrayListContractTest
    {
        public void PUT_TrimToSizeContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.TrimToSize();

            int New_arrListCount = arrList.Count;
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

    	// an assertion using "Debug.Assert\(.*?\);" that new array size is equal to old array size after invoking TrimToSize method
	    Assert.AreEqual(Old_arrListCount, New_arrListCount);
        }
    }

// More contract testing methods follow.
}--------------------            Assert.IsTrue((Old_arrListIndexOfX == -1) ? (New_Ret == -1) : (New_Ret >= 0));

            // an verification assertion using "Assert\.IsTrue\(.*?\);" that  @@@ If old array contains x, the new array contains x 
            Assert.IsTrue((Old_arrListContainsX == false) ? (New_arrListContainsX == false) : (New_arrListContainsX == true));
        }
    }
}--------------------            if (New_Ret >= 0)
                Assert.IsTrue(New_arrListIndexOfX >= 0);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, contains x in new array is true
            if (New_Ret >= 0)
                Assert.IsTrue(New_arrListContainsX);

            //  an assertion using "Debug.Assert\(.*?\);" that @@@ Count in old array is equal to count in new array
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
        }
    }
