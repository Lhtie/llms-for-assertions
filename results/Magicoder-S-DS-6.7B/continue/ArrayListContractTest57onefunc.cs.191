    public partial class ArrayListContractTest
    {
        public void PUT_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int item)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfItem = arrList.IndexOf(item);

            bool New_Ret = arrList.Add(item);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfIItem = arrList.IndexOf(item);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_item", Old_arrListIndexOfItem);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_Item", New_arrListIndexOfIItem);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is false, index of item before is less than or equal to after 

            if (!New_Ret)
                Assert.IsTrue(Old_arrListIndexOfItem <= New_arrListIndexOfIItem);

            else
                // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is true, index of item before is equal to the index of item after the call to 'Add'

                Assert.AreEqual(Old_arrListIndexOfItem, New_arrListIndexOfIItem);
        }
    }
