        [PexMethod]
        public void PUT_AppendContract([PexAssumeUnderTest]ArrayList arrList, int[] newElements)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            arrList.AddRange(newElements);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrListCount", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrListCount", New_arrListCount);

            Assert.IsTrue(Old_arrListCount < New_arrListCount);
        }
    }
}--------------------            // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x in old array is >= -1
