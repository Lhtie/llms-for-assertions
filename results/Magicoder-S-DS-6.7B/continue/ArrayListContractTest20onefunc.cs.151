	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array list's contains of X should be false
            Assert.IsFalse(New_arrListContainsX, "new arrlist.Contains(X) should be false");
	    // an assertion using "Assert.AreEqual\(.*?\);" that  @@@ old count should be greater than new count
            Assert.AreEqual(Old_arrListCount > New_arrListCount, true, "old array list count should be less than new count");
