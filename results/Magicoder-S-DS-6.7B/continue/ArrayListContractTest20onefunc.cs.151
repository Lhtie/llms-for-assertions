	    Assert.That(New_arrListLastIndexOfX, Is.EqualTo(-1));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ 'contains' x in old array is true
	    Assert.True(Old_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ 'contains' x in new array is false
	    Assert.False(New_arrListContainsX);
        }
