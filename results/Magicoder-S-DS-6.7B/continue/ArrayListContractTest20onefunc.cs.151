}--------------------            Assert.IsTrue((Old_arrListIndexOfX < Old_arrListLastIndexOfX), "old arrlist.IndexOf(X) should be less than, or equal to, old arrlist.LastIndexOf(X)");
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ new index of x in new array is geq minus 1 
            Assert.IsTrue((New_arrListIndexOfX <= New_arrListLastIndexOfX), "new arrlist.IndexOf(X) should be less than, or equal to, new arrlist.LastIndexOf(X)");
