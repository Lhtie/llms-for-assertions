	    Assert.That(Old_arrListIndexOfX, Is.GreaterThanOrEqualTo(-1));

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in new array is eq minus 1
	    Assert.That(New_arrListIndexOfX, Is.EqualTo(-1));

