            AssumePostcondition.IsTrue((New_arrListCount - Old_arrListCount) == (Old_arrListIndexOfX != -1 ? 1 : 0));
            AssumePostcondition.IsTrue(!Old_arrListContainsX || New_arrListIndexOfX < Old_arrListIndexOfX);
