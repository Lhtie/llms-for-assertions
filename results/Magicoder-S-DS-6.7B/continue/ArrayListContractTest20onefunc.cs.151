            // an assertion using "Debug.Assert\(.*?\);" that last index of x in old array is lt 
            Assert.IsTrue((New_arrListLastIndexOfX < Old_arrListLastIndexOfX), "LastIndex of X remains same or is +1 after the method Remove");

            // an assertion using "Debug.Assert\(.*?\);" that contains x is false after the method Remove 
            Assert.IsFalse(New_arrListContainsX, "Contains X remains same after the method Remove");
        }
