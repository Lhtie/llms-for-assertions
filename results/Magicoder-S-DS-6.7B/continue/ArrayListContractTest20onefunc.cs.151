            Assert.AreEqual(Old_arrListIndexOfX != -1, New_arrListContainsX);
            
            if (Old_arrListIndexOfX == -1)
                Assert.AreEqual(Old_arrListLastIndexOfX, -1); // this is because LastIndexOf will return -1 when the item is not present.
            else
