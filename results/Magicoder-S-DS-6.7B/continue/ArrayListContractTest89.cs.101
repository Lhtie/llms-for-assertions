    public class ArrayList
    {
        private object[] _items;
        private int _count;

        public ArrayList()
        {
            _items = new object[4];
        }

        public int Count
        {
            get { return _count; }
        }

        public object this[int index]
        {
            get { return _items[index]; }
            set { _items[index] = value; }
        }

        public int Add(object value)
        {
            if (_count == _items.Length)
            {
                Array.Resize(ref _items, _items.Length * 2);
            }
            _items[_count++] = value;
            return _count;
        }

        public void Clear()
        {
            Array.Clear(_items, 0, _count);
            _count = 0;
        }

        public bool Contains(object value)
        {
            return IndexOf(value) != -1;
        }

        public int IndexOf(object value)
        {
            for (int i = 0; i < _count; i++)
            {
                if (EqualityComparer.Equals(_items[i], value)) return i;
            }
            return -1;
        }

        public int LastIndexOf(object value)
        {
            for (int i = _count - 1; i >= 0; i--)
            {
                if (EqualityComparer.Equals(_items[i], value)) return i;
            }
            return -1;
        }

        public void Remove(object value)
        {
            int index = IndexOf(value);
            if (index != -1)
            {
                Array.Copy(_items, index + 1, _items, index, _count - index - 1);
                _count--;
            }
        }

        public void Insert(int index, object value)
        {
            if (index < 0 || index > _count) throw new IndexOutOfRangeException();

            if (_count == _items.Length)
            {
                object[] newArray = new object[_count * 2];
                Array.Copy(_items, 0, newArray, 0, index);
                Array.Copy(_items, index, newArray, index + 1, _count - index);
                _items = newArray;
            }
            else
            {
                Array.Copy(_items, index, _items, index + 1, _count - index);
            }
            _items[index] = value;
            _count++;
        }

        public override string ToString()
        {
            StringBuilder sb = new StringBuilder(_count * 16);
            for (int i = 0; i < _count; i++)
            {
                if (i > 0) sb.Append(", ");
                sb.Append(_items[i].ToString());
            }
            return sb.ToString();
        }
    }

    public class EqualityComparer
    {
        public static bool Equals(object x, object y)
        {
            if (object.ReferenceEquals(x, y)) return true;
            return (x != null) && x.Equals(y);
        }
    }
}

#region PEX API Wrapper

namespace PexAPIWrapper
{
    public class PexObserve
    {
        public static void ValueForViewing(string s, object o)
        {
            if (o != null)
            {
                Console.WriteLine("[" + s + "] " + o);
            }
            else
            {
                Console.WriteLine("[" + s + "] null");
            }
        }
    }

    public class AssumePrecondition
    {
        public static void IsTrue(bool statement)
        {
            if (!statement)
            {
                throw new System.ArgumentOutOfRangeException();
            }
        }
    }
}
