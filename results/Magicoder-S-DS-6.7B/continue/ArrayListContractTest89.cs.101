        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            Assume.That(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfOldIndex = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfOldIndex = arrList.LastIndexOf(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            // bool? New_arrListContainsOldIndex = arrList.Contains(arrList[Old_index]); old-index could be deleted, so can't check if contains or not.
            int New_arrListIndexOfOldIndex = arrList.IndexOf(arrList[Old_index]);
            int New_arrListLastIndexOfOldIndex = arrList.LastIndexOf(arrList[Old_index]);

            Assume.That(Old_arrListIndexOfOldIndex - index < New_arrListCount - Old_arrListCount - 1);
            Assume.That(New_arrListIndexOfOldIndex == arrList.Count - Old_arrListCount + Old_arrListIndexOfOldIndex - index);
            Assume.That(New_arrListLastIndexOfOldIndex == arrList.Count - Old_arrListCount + Old_arrListLastIndexOfOldIndex - index);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_old_index", Old_arrListIndexOfOldIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_old_index", New_arrListIndexOfOldIndex);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_old_index", Old_arrListLastIndexOfOldIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_old_index", New_arrListLastIndexOfOldIndex);

        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            Assume.That(New_arrListCount == 0);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
        }
    }
