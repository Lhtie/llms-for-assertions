        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] array, int index)
        {
            AssumePrecondition.IsTrue(index <= array.Length && index >= 0);

            int Old_arrListLastIndex = arrList.LastIndexOf(arrList[0]);
            bool Old_arrListContainsOldLastIndexElement = arrList.Contains(array[Old_arrListLastIndex]);

            arrList.CopyTo(array, index);

            int New_arrListLastIndex = arrList.LastIndexOf(arrList[0]);
            bool New_arrListContainsNewLastIndexElement = arrList.Contains(array[New_arrListLastIndex]);

            PexObserve.ValueForViewing("$old_arrList_array_LastIndex", Old_arrListLastIndex);
            PexObserve.ValueForViewing("$new_arrList_array_LastIndex", New_arrListLastIndex);
            PexObserve.ValueForViewing("$old_arrList_Contains_old_LastIndex_element", Old_arrListContainsOldLastIndexElement);
            PexObserve.ValueForViewing("$new_arrList_Contains_new_LastIndex_element", New_arrListContainsNewLastIndexElement);

        }
    }
