        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList arrToAdd)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrToAddCount = arrToAdd.Count;

            arrList.AddRange(arrToAdd);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$arrList.Count", Old_arrListCount);
            PexObserve.ValueForViewing("$arrToAdd.Count", Old_arrToAddCount);
            PexObserve.ValueForViewing("$new_arrList.Count", New_arrListCount);

