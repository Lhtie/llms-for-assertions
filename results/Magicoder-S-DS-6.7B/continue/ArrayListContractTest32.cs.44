        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >=0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

        }

        [PexMethod]
        public void GET_ItemContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_index = index;

            object ret = arrList[index];

            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$return_value", ret);

        }

        [PexMethod]
        public void PUT_ItemContract([PexAssumeUnderTest]ArrayList arrList, int index, object x)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_index = index;
            object Old_x = x;

            arrList[index] = x;

            object New_x = arrList[index];
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$new_arrList_x", New_x);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

        }
    }
}--------------------
