            if (New_Ret != -1)
            {
                Assert.AreEqual("If the return value is non-negative, list counts of new and old array are equal.", Old_arrListCount, New_arrListCount);
            }
	    
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is non-negative, x is last index of old array and also contains in array 
            if (New_Ret != -1)
            {
                Assert.AreEqual("If the return value is non-negative, x is last index of old array and also contains in array.", Old_arrListLastIndexOfX, New_Ret);
                Assert.IsTrue("If the return value is non-negative, x is last index of old array and also contains in array.",Old_arrListContainsX);
            }
	    
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is negative, x is not in the list but contain in array 
            else
            {
                Assert.IsFalse("If the return value is negative, x is not in the list but contain in array.", Old_arrListContainsX);
            }
        }
    }
}--------------------            Assert.AreEqual(Old_arrListCount, New_arrListCount);
        }
    }    
}
```

### Caveats
1. Assumption is assumed to be valid only for Pex. You might need to add your own checks in production code depending on your use case.
2. To observe the state during debugging, choose the values on the right. (E.g., old_listCount, new_arrListCount)

3. Please replace the comment in the PUT_IndexOfContract function with relevant assertion if required.

### Testing
1. Pex Test Runner should be visible in Test Exlorer in VisualStudio. You can run tests on specific contracts individually as well. 

2. Before executing Pex, make sure your code has been build (using Ctrl + Shift + B) to avoid any "Could not find a part of the path" error. 

3. Enable Pex on your projects, by using "Enable Pex" in context menu of your project. 

4. Check for any dependencies on non-testable elements, they will fail execution in Pex.

Remember Pex is a tool for finding logical bugs in your programs, it doesn't replace the role of QA by finding bugs in test cases. To actually prove the correctness of an implementation, you still need to write your test cases or use tools like NUnit or xUnit.  

Please note, Pex was part of the research initiative from Microsoft on "Find Bugs with Confidence" and has been deprecated since 2018. Microsoft suggests other testing tools like FxCop or TestDriven.NET.--------------------            if (New_Ret >= 0)
