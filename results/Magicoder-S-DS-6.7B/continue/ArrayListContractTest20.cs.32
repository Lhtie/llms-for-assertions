        // and in new array is geq minus 1 with same exception 
	}
    }
}--------------------	    // for any x that gets "old_arrList_IndexOf_x" or "old_arrList_LastIndexOf_x".
        }

    }
}--------------------	    // and is equal to the @@@ result of the @@ operation on the same array.  
	}
    }
}--------------------            Assert.GreaterOrEqual(Old_arrListIndexOfX, -1);
        }
    }
}--------------------        }
    }
}--------------------            if (Old_arrListIndexOfX >= 0)
            {
                Assert.LessOrEqual(Old_arrListIndexOfX, Old_arrListCount - 1);
