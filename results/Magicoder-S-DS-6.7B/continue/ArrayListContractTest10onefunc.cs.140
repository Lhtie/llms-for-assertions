    [FilePathPredictor(ArrayPathPredictor.Predict)] 
    public partial class ArrayContractTest
    {
        [ContractTestCase]
        public void PushContractTest(ArrayPushContract contractTest)
        {
            var stack = new Array(contractTest.arr);

            // Pre-condition:
            AssumePrecondition.IsNotZeroOrLower(contractTest.value);
            AssumePrecondition.IsNotNull(contractTest.arr);

            // Method Execution:
            var result = stack.Push(contractTest.value);

            // Post-Condition:
            // Verify the return value against the expected value.
            Assert.AreEqual(contractTest.expected, result);
            // Verify that the stack was updated.
            Assert.AreNotEqual(stack.ArrayToCompare(contractTest.arr), stack.ArrayToCompare(result));
        }
    }
}

