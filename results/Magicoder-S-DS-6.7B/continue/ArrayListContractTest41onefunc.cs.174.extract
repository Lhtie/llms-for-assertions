            // which indicated that the item was not in list
            // a failure will occur in production environments when running in release mode
            Debug.Assert(Old_arrListIndexOfX >= 0);
------------------------------------------------------------        Debug.Assert(Old_arrListIndexOfX >= -1, "@@@ index of x in old array list is more than or same as -1");
