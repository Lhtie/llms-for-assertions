            PexAssert.AreNotEqual("{Old_arrListCount} should have decreased by 1", Old_arrListCount - 1, New_arrListCount);

            // an assumption using "Assume.True\(true\);" that @@@ old array list count decreases one on @@@ remove
            AssumePrecondition.IsTrue(Old_arrListCount >= New_arrListCount + 1);

            // an assumption using "Assume.True\(true\);" that @@@ x is not in new array list
            AssumePrecondition.IsFalse(New_arrListContainsX);

            // an assumption uing "Assume.Untrue\(false\);" that @@@ new array list index of x is less than or equal to last index of x
            AssumePrecondition.IsTrue(New_arrListIndexOfX <= New_arrListLastIndexOfX);
            
            // an assumption using "Assume.Untrue\(false\);" that @@@ new array list contains x
            AssumePrecondition.IsTrue(New_arrListContainsX);
            
            if (Old_arrListIndexOfX != -1 || Old_arrListLastIndexOfX != -1)
            {
                PexAssert.GreaterThanOrEqual("index of x", New_arrListIndexOfX, Old_arrListIndexOfX);

                PexAssert.GreaterThanOrEqual("last index of x", New_arrListLastIndexOfX, Old_arrListLastIndexOfX);
            }
        }
    }
}--------------------            PexObserve.ValueForViewing("$old_LastIndexOf_and_Count_Not_Same", Old_arrListLastIndexOfX != Old_arrListCount);

	    // assertion using "System.Diagnostics.Debug.Assert\(.*?\);" that if x is removed, then the first index of x is not equal to its old index
            Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);

        }
    }
}--------------------            Debug.Assert(Old_arrListCount != -1);

            // an assertion using "Debug.Assert\(.*?\);" that the array list count is lesser or equal to original count, because index of removed element is removed from the list.
            Debug.Assert(New_arrListCount <= Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list index of x is the same as previous last index of x. 
            Debug.Assert(Old_arrListLastIndexOfX == New_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ array list last index of x is the same as previous index of x.
            Debug.Assert(Old_arrListIndexOfX == New_arrListLastIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ array list contains x now equals false, since the element was removed.
            Debug.Assert(New_arrListContainsX.Equals(false));
        }
    }
}--------------------	    PexAssume.True(Old_arrListLastIndexOfX != arrList.IndexOf(@@@));

            // an assertion using "Debug.Assert\(.*?\);" that @@@ is not in new array 
            PexAssume.True(New_arrListContainsX !== @@@);
        }
    }
}--------------------            Debug.Assert(
                !(Old_arrListCount.Equals(Old_arrListIndexOfX)) ||
                // @@@ array list count is not same as last index of x in old array and 
                // @@@ last index of x in old array is not greater than or equal to last index of x in new array
                (!(Old_arrListCount.Equals(Old_arrListLastIndexOfX)) && 
                !Old_arrListLastIndexOfX.Equals(New_arrListLastIndexOfX)));
        }
    }
}--------------------            Assert.NotEqual(Old_arrListCount, New_arrListCount);

            if (Old_arrListIndexOfX != -1)
            {
                Assert.NotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            }
            if (Old_arrListLastIndexOfX != -1)
            {
                Assert.NotEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
            }
            
            Assert.NotEqual(Old_arrListContainsX, New_arrListContainsX);

        }

        public void GET_IndexOfContract([PexAssumeUnderTest] ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));

            int index = arrList.IndexOf(x);

            Assert.NotEqual(-1, index);
        }

        public void GET_LastIndexOfContract([PexAssumeUnderTest] ArrayList arrList, int x)
        {
            AssumePrecondition.IsTrue(arrList.Contains(x));

            int index = arrList.LastIndexOf(x);

            Assert.NotEqual(-1, index);
        }
    }
}--------------------            Args.Old_arrListCount = New_arrListCount;
            Args.New_arrListIndexOfX = New_arrListIndexOfX;
            Args.New_arrListLastIndexOfX = New_arrListLastIndexOfX;
            Args.New_arrListContainsX = New_arrListContainsX;
        }

        public partial class Args
        {
            public int New_arrListIndexOfX { get; set; }
            public int New_arrListLastIndexOfX { get; set; }
            public bool New_arrListContainsX { get; set; }

            [PexAssumeNotNull]
            public int Old_arrListCount { get; set; }
        }
    }
}
```

PexObserve statements can be used to log the observed values for the purpose of debugging or reporting. This will allow users to visualize the interaction between actions taken on input data.

PexArrange.Values and PexAssume statements are used to specify what conditions should be tested.

PexAssume.UnderTest attribute is used for testing the contracts and properties of the main algorithm.

In addition, it is possible to use the IsTrue and IsFalse methods from the Assumptions class for specifying preconditions to be met.

Finally, in the contract test class, you can add Args class to store necessary parameters to be checked in the test method.--------------------
            AssertContract.Essential(New_arrListCount, Old_arrListCount - 1);
            AssertContract.Essential(New_arrListIndexOfX, Old_arrListIndexOfX < 0 ? -1 : Math.Max(-1, Old_arrListIndexOfX - 1));
            AssertContract.Essential(New_arrListLastIndexOfX, Old_arrListLastIndexOfX < 0 ? -1 : Math.Max(-1, Old_arrListLastIndexOfX - 1));
            AssertContract.Essential(New_arrListContainsX, !Old_arrListContainsX);
        }
    }
