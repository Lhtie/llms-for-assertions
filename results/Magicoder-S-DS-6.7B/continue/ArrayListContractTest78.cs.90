        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfIndex = arrList.IndexOf(index);

            bool hasAnyErrors = false;

            try
            {
                arrList.RemoveAt(index);
            }
            catch (IndexOutOfRangeException)
            {
                hasAnyErrors = true;
            }

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfIndex = arrList.IndexOf(index);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_index", Old_arrListIndexOfIndex);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_index", New_arrListIndexOfIndex);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ If there is not an error, x is in the old array 
            bool condition1 = hasAnyErrors;
            bool condition2 = !condition1;
            bool condition3 = New_arrListIndexOfIndex != -1;

	    PexAssert.IsTrue(condition2 && condition3); }
    }
