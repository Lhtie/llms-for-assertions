        [PexMethod]
        public void AddFirstContract([PexAssumeUnderTest]System.Collections.Generic.LinkedList<T> linkedList, T item)
        {
            AssumePrecondition.IsNotNull(linkedList);
            int Old_Count = linkedList.Count;
            linkedList.AddFirst(item);
            int New_Count = linkedList.Count;
            PexAssert.AreEqual("$Old_Count", Old_Count, New_Count);
        }

