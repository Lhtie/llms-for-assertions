        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] array, int arrayIndex)
        {
            AssumePrecondition.IsTrue(arrayIndex >= 0 && arrayIndex <= array.Length && arrayIndex + arrList.Count <= array.Length);

            int Old_arrListCount = arrList.Count;
            int Old_arrayIndex = arrayIndex;

            arrList.CopyTo(array, arrayIndex);

            int New_arrListCount = arrList.Count;

            bool New_ret = true;
            for (int i = 0; i < Old_arrListCount; i++) {
                if (arrList[i] != array[Old_arrayIndex + i] || arrList[i] != array[Old_arrayIndex + i]) {
                    New_ret = false;
                    break;
                }
            }

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$New_ret", New_ret);

        }
    }
