
            if (Old_arrListContainsX)
            {
                Assert.IsTrue(New_Ret >= Old_arrListIndexOfX, "If the return value is non-negative, index of x in old array is more than or equal to index in new list.");
            }
        }
    }
}--------------------            if (Old_arrListIndexOfX >= 0)
            {
                Assert.IsTrue(New_Ret >= Old_arrListIndexOfX, "New_Ret must be more than or equals to Old_arrListIndexOf_x");
            }
            else
            {
                Assert.IsFalse(New_Ret >= 0, "New_Ret should be -1 when array doesn't contain the item");
            }
