}--------------------	    Assert.IsTrue(New_Ret >= Old_arrListIndexOfX);
	    Assert.IsTrue(New_arrListIndexOfX >= Old_arrListIndexOfX); 

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the return value is negative, then list doesn't contain x 
	    Assert.AreEqual(New_Ret < 0 && New_arrListContainsX == false, Old_arrListContainsX == false);	       

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ List count should not change 
	    Assert.AreEqual(New_arrListCount, Old_arrListCount);
            
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the list doesn't contain x, then return value is negative (New_ret < 0)
	    Assert.AreEqual(New_Ret < 0, !New_arrListContainsX);
            
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If the list contains x, then the IndexOf x in new list should be between 0 and the list count minus 1
	    Assert.IsTrue(New_arrListIndexOfX >= 0 && New_arrListIndexOfX <= New_arrListCount - 1);
        }
    }
}--------------------            Assert.IsGreaterOrEqual(New_Ret, Old_arrListIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ If return value is -1, old array does not contain x  
            If(New_Ret == -1) Assert.IsFalse(Old_arrListContainsX);
	    // an assertion using "Assert.AreEqual\(.*?\)" that  @@@ Count property of old array is equal to new array list count  
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
    
        }
    }
}
```
Here `[PexAssumeUnderTest] ArrayList arrList` is a parameter that gets the data to be tested.

