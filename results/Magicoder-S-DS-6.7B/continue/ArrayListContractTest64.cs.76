        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] array, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index <= array.Length);
            if (array.Length >= arrList.Count + index)
                arrList.CopyTo(array); 

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int[] Old_array = new int[array.Length];
            for (int i = 0; i < array.Length; i++)
            {
                Old_array[i] = array[i];
            }

            arrList.CopyTo(array, index);

            int New_array_Count = array.Length;
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfArrayItemAtIndex = arrList.IndexOf(array[index]);
            int New_arrListLastIndexOfArrayItemAtIndex = arrList.LastIndexOf(array[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

            for (int i = 0; i < Old_array.Length; i++)
            {
                PexObserve.ValueForViewing("$old_array_" + i + "_item", Old_array[i]);
            }
            //PexObserve.ValueForViewing("$old_array", Old_array);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_item_at_index", New_arrListIndexOfArrayItemAtIndex);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_item_at_index", New_arrListLastIndexOfArrayItemAtIndex);

        }

