// The helper function to check the validity of XML block.
bool IsValidXmlBlock(string line)
{
	try {
		XmlDocument doc = new XmlDocument();
		doc.LoadXml(line);
	} catch (Exception ex) {
		return false;
	}
	return true;
}--------------------