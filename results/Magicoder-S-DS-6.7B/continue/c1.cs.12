List<Template> TemplateParsing(string fileText)
{
	List<Template> templates = new List<Template>();
	foreach (string fileLine in fileText.Split('\n'))
	{
		string[] items = fileLine.Split(';');
		if (items.Length >= 2)
		{
			Template newTemplate = new Template
			{
				Key = items[0],
				Parameters = items[1]
			};
			templates.Add(newTemplate);
		}
	}
	return templates;
}--------------------	Debug.Assert(templatesFileExist, "The template file does not exist");
