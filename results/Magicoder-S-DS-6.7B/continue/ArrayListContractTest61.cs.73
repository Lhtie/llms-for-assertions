                    if (index < New_destinationArrayCount)
                    {
                        int Old_new_array_at_index = ((int)(destinationArray[index]));

                        //PexObserve.ValueForViewing("$Old_new_array_at_index", Old_new_array_at_index);
                    }
                }
            }
        
        }

