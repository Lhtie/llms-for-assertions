        [PexMethod]
        public void PUT_InsertRangeContract([PexAssumeUnderTest]ArrayList arrList, int[] arr, int index)
        {
            ArrayAdapterWrapper oldArrList = new ArrayAdapterWrapper(arrList);

            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
            ArrayAdapterWrapper arrAdapter = Old_InsertRangeContractHelper(oldArrList, arr, index);
            int Old_index = index;

            arrList.InsertRange(index, arr);

            int[] New_arr = arrAdapter.GetArray();

            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$Old_arr", arrAdapter.GetArray());
            PexObserve.ValueForViewing("$New_arr", New_arr);

        }

        private ArrayAdapterWrapper Old_InsertRangeContractHelper(ArrayAdapterWrapper oldArrList, int[] arr, int index)
        {
            ArrayAdapterWrapper arrAdapter = new ArrayAdapterWrapper(new ArrayList());
            arrAdapter.AddRange(arr);
            oldArrList.InsertRange(index, arr);
            return arrAdapter;
        }

        [PexMethod]
        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, int[] arr, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            ArrayAdapterWrapper oldArrList = new ArrayAdapterWrapper(arrList);

            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);
            oldArrList.RemoveRange(index, index + arr.Length);
            arrList.RemoveRange(index, index + arr.Length);

            int[] Old_arr = arr;
            int[] New_arr = arrList.ToArray();

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_index", Old_index);
            PexObserve.ValueForViewing("$Old_arrList", oldArrList.GetArray());
            PexObserve.ValueForViewing("$New_arr", New_arr);

            // Assert  @@@ if the arr list count is the same, all the elements in Old_arr are also in the New_arr 
            AssertionHelper.AssertAllInNewArray(Old_arr, New_arr);

        }

        // Helper Class
        private class AssertionHelper
        {
            public static void AssertAllInNewArray(int[] Old_arr, int[] New_arr)
            {
                foreach (var item in Old_arr)
                {
                    bool isInArray = Array.IndexOf(New_arr, item) != -1;
                    if (!isInArray)
                    {
                        StringBuilder str = new StringBuilder();
                        str.AppendLine("Assert fail: " + item + " ");
                        str.AppendLine("Is not in New Array");
                        return;

                    }
                }
            }
        }

        // Helper Class
        private class ArrayAdapterWrapper
        {
            private ArrayList _arrList;

            public ArrayAdapterWrapper(ArrayList arrayAdapter)
            {
                _arrList = arrayAdapter;
            }

            public void AddRange(int[] arr)--------------------	    //      // An assertion using "Debug.Assert\(.*?\);" that the return value equals the new arlist contains x

        }

