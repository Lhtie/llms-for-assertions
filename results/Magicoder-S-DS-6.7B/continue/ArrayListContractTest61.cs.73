            PexObserve.ValueForViewing("$old_destinationIndex", Old_destinationIndex);
            PexObserve.ValueForViewing("$old_destinationArrayCount", Old_destinationArrayCount);
            PexObserve.ValueForViewing("$new_destinationArrayCount", New_destinationArrayCount);

            if (destinationArray != null)
            {
                for (int i = Old_destinationIndex; i < Old_destinationIndex + Old_arrListCount; i++)
                {
                    int Old_array_at_index = ((int)(destinationArray[i]));
                    int index = i - Old_destinationIndex + New_destinationIndex;

                    //PexObserve.ValueForViewing("$old_array_at_index", Old_array_at_index);

