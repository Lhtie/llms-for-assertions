            Debug.Assert(New_arrListCount >= New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index of x in the array (after the remove operation) is less than or equal to its previous index
            Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX);
       
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of the element x equals to the last index in the array minus the difference between the last index of x in the old array and new array minus 1.
	    // The value that is used to obtain this index is computed as: Old_arrListLastIndexOfX - (Old_arrListLastIndexOfX - New_arrListLastIndexOfX) - 1
            Debug.Assert(New_arrListIndexOfX == Old_arrListLastIndexOfX - (Old_arrListLastIndexOfX - New_arrListLastIndexOfX) - 1);

	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains result of the old array equals to the contains result of the new array
            Debug.Assert(Old_arrListContainsX == New_arrListContainsX);
        }
    }
}--------------------            Assert.IsTrue(Old_arrListLastIndexOfX >= arrList.IndexOf(x));
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the new count is one less than old count
            Assert.AreEqual(Old_arrListCount - 1, New_arrListCount);
	    
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if the old index of x is valid in the old array, it should be different from the index of x in the new array
            if (Old_arrListIndexOfX != -1)
                Assert.AreNotEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ if the old last index of x is valid in the old array, it should be less than the last index of x in the new array
            if (Old_arrListLastIndexOfX != -1)
                Assert.IsTrue(Old_arrListLastIndexOfX < New_arrListLastIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the new array should not contain the x
            Assert.IsFalse(New_arrListContainsX);
        }
    }
}--------------------            Debug.Assert(Old_arrListCount > New_arrListCount);
        }
    }
}
