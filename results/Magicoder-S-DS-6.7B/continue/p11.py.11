    """ Performs several transfer operations for testing """

    names = ["Alice", "Bob", "Charlie", "David", "Eve"]
    persons = [Person(name) for name in names]

    transfer(persons[0], persons[1], 0)
    transfer(persons[0], persons[1], 10)
    transfer(persons[2], persons[3], 50)

test_transfer()--------------------    total = 0
