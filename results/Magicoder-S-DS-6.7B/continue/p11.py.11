    assert sum(a.money for a in frm.accounts) >= amnt, "Insufficient funds"
    
    # an assertion that the account to-be transferring to is not the sender's
    assert id(to) != id(frm), "Can't transfer money to the same account"
    
    for acc in frm.accounts:
        if acc.money >= amnt:
            acc.money -= amnt
            to.accounts[id(to)-id(frm)].money += amnt
            break

