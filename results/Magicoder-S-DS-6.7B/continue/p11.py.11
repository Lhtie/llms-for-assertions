def random_transfers(persons, num_transfers):
    """ perform 'num_transfers' random transfers """
    for _ in range(num_transfers):
        # pick two random persons and randomly select a transfer amount
        frm, to = random.sample(persons, 2)
        amnt = random.randint(0, sum(acc.money for acc in frm.accounts))

        try:
            # perform transfer
            transfer(frm, to, amnt)
        except AssertionError as e:
            print(f'Error: {e}')
            
