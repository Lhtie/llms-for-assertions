def test():
    Alice = Person('Alice')
    Bob = Person('Bob')
    print('Test transfer $50 back and forth between Alice and Bob')
    account_Alice = Alice.accounts[0]
    account_Bob = Bob.accounts[0]

    Alice_init_balance = total_balance(Alice)
    Bob_init_balance = total_balance(Bob)

    transfer(account_Bob, account_Alice, 50)

    assert Alice_init_balance - 50 == Alice.accounts[0].money, 'Alice account money should be deducted'
    assert Bob_init_balance + 50 == Bob.accounts[0].money, 'Bob account money should be added'

    test()--------------------    total_from_balance = sum(account.money for account in frm.accounts)
    assert total_from_balance >= amnt, f"Not enough money on {frm.name}'s accounts"

    # perform the transfer
    frm.accounts[0].money -= amnt
    to.accounts[0].money += amnt

    # after the transfer:
    # an assertion using "assert .*?" that the total balance of the "frm" accounts is now equal to the previous balance minus "amnt"
    assert total_from_balance - amnt == sum(account.money for account in frm.accounts), f"Incorrect balance on {frm.name}'s accounts after the transfer"

    # and an assertion using "assert .*?" that the total balance of the "to" accounts is now equal to the previous balance plus "amnt"
    assert sum(account.money for account in to.accounts) == total_from_balance + amnt, f"Incorrect balance on {to.name}'s accounts after the transfer"

