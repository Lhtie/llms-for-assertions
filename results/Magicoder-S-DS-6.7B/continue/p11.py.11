    print()--------------------    if sum(a.money for a in frm.accounts) < amnt:
        print(f"Insufficient funds in {frm.name}'s accounts for the transfer.")
        return

    # deduct "amnt" from "frm" total account balance 
    for account in frm.accounts:
        if amnt <= 0: # no more money left to transfer
            break
        # if current account has enough money, transfer it all and 
        if account.money < amnt: 
            amnt -= account.money
            account.money = 0
        else: # transfer remaining amount 
            account.money -= amnt
            amnt = 0

    # add "amnt" to "to" total account balance
    for account in to.accounts:
        if amnt <= 0: # no more money left to transfer
            break
        # if the total amount to be transferred is larger than what remains in the account, donate the rest of the money
        amount_to_add = min(amnt, 100 - account.money)
        account.money += amount_to_add
        amnt -= amount_to_add

    return

