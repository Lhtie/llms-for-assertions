    # deduct from "frm"
    for acct in frm.accounts:
        if acct.money < amnt:
            amnt -= acct.money
            acct.money = 0
        else:
            acct.money -= amnt
            amnt = 0
            break
        
    # add to "to"
    for acct in to.accounts:
        if acct.money <= 0: # add to next account
            amnt -= acct.money
        else:  # add to this account and break
            acct.money += amnt
            amnt = 0
            break

    # assertion that transaction was successful (no remaining "amnt" to transfer)
    assert amnt==0, "Error: transaction was not performed successfully"

