    total_balance = sum([account.money for account in frm.accounts])
    assert total_balance >= amnt, f'Insufficient funds to transfer {amnt} from {frm.name} in {frm.accounts}'

    # subtract "amnt" from the first account in "frm"
    # add "amnt" to the first account in "to"
    frm.accounts[0].money -= amnt
    to.accounts[0].money += amnt


def transfer_all(frm, to):
    """ transfers remaining money from "frm" to "to" """
    remaining_balance = sum([account.money for account in frm.accounts])
    to.accounts[0].money += remaining_balance
    frm.accounts[0].money = 0


def main():
    p1 = Person('Pers-1')
    p2 = Person('Pers-2')

    transfer(p1, p2, 50)

    print(f'{p1.name} balance: {sum([account.money for account in p1.accounts])}')
    print(f'{p2.name} balance: {sum([account.money for account in p2.accounts])}')

    transfer_all(p1, p2)

    print(f'{p1.name} balance: {sum([account.money for account in p1.accounts])}')
    print(f'{p2.name} balance: {sum([account.money for account in p2.accounts])}')


