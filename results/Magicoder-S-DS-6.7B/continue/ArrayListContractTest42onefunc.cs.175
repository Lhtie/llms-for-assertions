            Debug.Assert(New_containsNewRet);
        }
    }
}--------------------	    Debug.Assert(New_containsNewRet);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ the returned value is what we expected
            Debug.Assert(New_Ret == arrList[index]);
        }
    }
}--------------------	    // and Old_arrList_Count equals New_arrList_Count 
        }
