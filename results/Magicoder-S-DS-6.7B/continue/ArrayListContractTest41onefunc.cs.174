            // which indicated that the item was not in list
            // a failure will occur in production environments when running in release mode
            Debug.Assert(Old_arrListIndexOfX >= 0);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old aray list is less than index 
            // which indicated that the item was at that index in the old array list
            Debug.Assert(Old_arrListIndexOfX <= Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old aray list is less than or equal to count 
            // which indicated that the item was at that index in the old array list
            Debug.Assert(Old_arrListIndexOfX <= Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index of x in new aray list is equal to i (param). 
            // which indicated that the item was removed
            Debug.Assert(New_arrListIndexOfX == Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ old array count is less than new array count 
            // which indicated that the array list size has been increased
            Debug.Assert(Old_arrListCount < New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ old and new counts are the same ? 
            // which indicated that the new array list contains old items and any added items only
            Debug.Assert(Old_arrListCount == New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ x is in new array list at i (param)
            // which indicated that the item has been inserted at the index in new array list
            Debug.Assert(New_arrListCount == New_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in old aray list and new aray list is the same 
            // which indicated that the item was removed from the old array list and added to the new array list at same index
            Debug.Assert(New_arrListIndexOfX == Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index of x in old aray list is less than old index 
            // which indicated that the item was moved to a lower index in the old array list
            Debug.Assert(Old_arrListLastIndexOfX < Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ old and new index of x are the same (param)
            // which indicated that the position of x in old and new array list is the same
            Debug.Assert(New_arrListLastIndexOfX == Old_index);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ contains x in new aray list is 'true'
            // which indicated that x exists in new array list
            Debug.Assert(New_arrListContainsX == true);
        }
    }
}--------------------	    // and @@@ index of x in new array list is more than or same as index
            Assert.AreEqual(Old_arrListIndexOfX, Old_arrListCount - 1);
            Assert.AreEqual(New_arrListIndexOfX, index);

            if (Old_index == index)
            {
                // an assertion using "Debug.Assert\(.*?\);" that  @@@ old index of x in old aray list is equal to new index of x in new array list  
                Assert.AreEqual(Old_arrListIndexOfX, New_arrListIndexOfX);
            }
            else
            {
                // an assertion using "Debug.Assert\(.*?\);" that  @@@ old index of x in old aray list is more than new index of x in new array list 
