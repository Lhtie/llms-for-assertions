            Debug.Assert(index == Old_index, "@@@ value of index is equals to old_index");

            // an assertion using "Debug.Assert\(.*?\);" that @@@ value of arrList[index] is equals to x
            Debug.Assert(arrList[index] == x, "@@@ value of arrList[index] is equals to x");
        }
    }
}
