//Project1/Code/Test/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexMethodBackdoor]
    public partial class ArrayListContractTest
    {
        [PexSymbol]
		public int arrayList_IndexOf_x { get; set; }

	    [PexFactoryMethod]
		public static ArrayList CreateArrayList(int numOfElements)
		{
			ArrayList arrList = new ArrayList();
			for (int i = numOfElements; i >= 1; --i)
			{
			    arrList.Add(i);
			}
			return arrList;
		} 
	}
}

