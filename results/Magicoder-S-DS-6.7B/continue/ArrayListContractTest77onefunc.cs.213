        private void PUT_IndexOfContract_TestImplementation([PexAssumeValid("(arrList.Count < 500)||(x <= 500)"), PexAllowedExceptionFromMethod(typeof(Assert), "Fail")] PexAssumeValid("0 <= New_Ret < Old_arrListCount"), PexAllowedExceptionFromAttribute(typeof(PexAssemblyExceptionAttribute), typeof(PexNoReplayAttribute), typeof(PexAllowedExceptionFromMethodAttribute), typeof(PexAllowedExceptionFromAttributeAttribute)), PexAssemblyExceptionFromType(typeof(Assert))] ArrayList arrList, int x)
