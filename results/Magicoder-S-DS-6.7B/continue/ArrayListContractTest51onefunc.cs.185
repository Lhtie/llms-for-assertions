            Assert.AreEqual(Old_arrListLastIndexOfX != New_arrListCount - 1, New_Ret);

	    // an assertion using "Debug.Assert\(.*?\);" that @@ If return value is true, last index of x in old array is not equal to the new size of the array minus one
            Assert.AreEqual(Old_arrListLastIndexOfX != New_arrListCount - 1, New_Ret);
