
            if (New_Ret)
                Assert.AreNotEqual(New_arrListCount, New_arrListLastIndexOfX);
        }
    }
}--------------------	    if (New_Ret)
            {
                Assert.AreNotEqual(New_arrListLastIndexOfX, Old_arrListCount);
            }
        }

    }
}
```
In the above PUT test we have a requirement that if the array list contains the searched value then the `IndexOf()` method should not return the last position of the searched value. If there was a bug in the Contains method or the IndexOf method of an ArrayList returns the size of the ArrayList as a last index of searched value then the assertion would fail. We have added a conditional assertion inside the `if` statement checking the `LastIndexOf()` method call returns not equal to the old array list size.--------------------
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListCount - 1, "An item was added to the list, but the last index of the old item was not the size of the old array");
        }
    }
}--------------------            Debug.Assert((New_Ret == true && New_arrListLastIndexOfX + 1 != New_arrListCount));
            Debug.Assert((New_Ret == true && New_arrListIndexOfX  ==  New_arrListLastIndexOfX));


            // an assertino using "Debug.Assert\(.*?\);" that @@@ In case of x is not present in arraylist return value is false and all index method 
            // must return value -1
            Debug.Assert((New_Ret == false && New_arrListIndexOfX == -1 && New_arrListLastIndexOfX == -1));
        }
    }
}--------------------	    //@@@ Else if the return value is false, last position of x in new array is not the index of x in old array

            if (New_Ret)
            {
                Assert.IsTrue(New_arrListLastIndexOfX != arrList.Count);
            }
            else
            {
                Assert.IsTrue(New_arrListLastIndexOfX != Old_arrListIndexOfX);
            }

            Assert.IsTrue(New_arrListCount == Old_arrListCount);
            Assert.IsTrue(New_arrListIndexOfX == Old_arrListIndexOfX);
            Assert.IsTrue(New_arrListLastIndexOfX == Old_arrListLastIndexOfX);            
        }
    }
}--------------------	    // If the return value is false, last position of x in new array is 1 less than the size of old array
            Debug.Assert(New_Ret != arrList.Contains(x));  

        }
    }
}--------------------            if (New_Ret.Equals(true))
            {
                Debug.Assert(!(New_arrListLastIndexOfX == New_arrListCount - 1 && Old_arrListLastIndexOfX == Old_arrListCount - 1));
            }

            // an assertion using "Debug.Assert\(.*?\);" that if x is in old array, it is also in the new array
            if (Old_arrListIndexOfX != -1)
            {
                Debug.Assert(New_arrListIndexOfX != -1);
            }

            // an assertion using "Debug.Assert\(.*?\);" that if x is not in old array, it is not in the new array
            if (Old_arrListIndexOfX == -1)
            {
                Debug.Assert(New_arrListIndexOfX == -1);
            }

            // an assertion using "Debug.Assert\(.*?\);" that if number of occurrences of x in old array is less than in a new array, the new array contains new copies of x
            if (Old_arrListIndexOfX != -1 && Old_arrListLastIndexOfX != -1)
            {
                Debug.Assert((New_arrListLastIndexOfX - New_arrListIndexOfX + 1) >= (Old_arrListLastIndexOfX - Old_arrListIndexOfX + 1));
            }

            // an assertion using "Debug.Assert\(.*?\);" that changes in size of array after call to Contains method does not affect contains result
            Debug.Assert((New_arrListCount == Old_arrListCount) == New_Ret);

            // an assertion using "Debug.Assert\(.*?\);" that changes in position of item after call to Contains method does not affect contains result
            Debug.Assert((New_arrListIndexOfX == Old_arrListIndexOfX && New_arrListLastIndexOfX == Old_arrListLastIndexOfX) == New_Ret);
        }
    }
}--------------------            if (New_Ret)
                Assert.AreNotEqual(New_arrListCount, New_arrListLastIndexOfX);
            
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ IndexOf x in new array is not greater than IndexOf x in old array
            if (New_arrListIndexOfX != -1)
                Assert.GreaterOrEqual(New_arrListLastIndexOfX, Old_arrListIndexOfX);
            
            // an assertion using "Debug.Assert\(.*?\);" that  
            // If the old and new arrays lengths are not the same, @@@ Last position of x in old array should be less than first position of x in new array
            if (Old_arrListCount != New_arrListCount)
                Assert.Less(Old_arrListLastIndexOfX, New_arrListIndexOfX);
            else
            {
                bool Old_arrListContainsX = Old_arrListIndexOfX != -1 || Old_arrListLastIndexOfX != -1;
                bool New_arrListContainsX = New_arrListIndexOfX != -1 || New_arrListLastIndexOfX != -1;

                if (Old_arrListContainsX)
                {
                    // an assertion using "Debug.Assert\(.*?\);" that 
                    // An array with x in the middle should contain x in both IndexOf and LastIndexOf
                    if (New_arrListContainsX)
                        Assert.AreEqual(New_arrListLastIndexOfX, New_arrListIndexOfX);
                }
                // an assertion using "Debug.Assert\(.*?\);" that 
                // If the return value of contains is false in old array, @@@ the return value of contains should be false in new array
                else if (!New_Ret)
                    Assert.AreEqual(New_Ret, New_Ret);
            }
        }
    }
}

//Tests/ArrayList.Test/Contracts/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using Microsoft.VisualStudio.TestTools.UnitTesting;
using Pex.Framework;

namespace ArrayList.Test
{
    [TestClass]
    public partial class ArrayListContractTest
    {
        [TestMethod]
        [PexMethod(MaxExpectedCalls = 100)]
        public void GET_Peek([PexAssumeUnderTest]ArrayList source)
        {
            Assert.IsTrue(source.Count > 0);
            if (source.Count > 0)
                source.Peek();
            else
                throw new InvalidOperationException();
        }

        [TestMethod]
        [PexMethod(MaxExpectedCalls = 100)]
        public void GET_Pop([PexAssumeUnderTest]ArrayList source)
        {
            Assert.IsTrue(source.Count > 0);
            if (source.Count > 0)
            {
                object peek = source.Peek();
                source.Pop();
                Assert.AreEqual(source.Count, 0 || source.Count > 0 ? 1 : 0);
            }
            else
                throw new InvalidOperationException();
        }

        [TestMethod]
        [PexMethod(MaxExpectedCalls = 100)]
        public void GET_Stack_Pop([PexAssumeUnderTest]Stack source)
        {
            Assert.IsTrue(source.Count > 0);
            if (source.Count > 0)
            {
                object peek = source.Peek();
                source.Pop();
                Assert.AreEqual(source.Count, 0 || source.Count > 0 ? 1 : 0);
            }
            else
                throw new InvalidOperationException();
        }

        [TestMethod]
        [PexMethod(MaxExpectedCalls = 100)]
        public void GET_Queue_Dequeue([PexAssumeUnderTest]Queue source)
        {
            Assert.IsTrue(source.Count > 0);
            if (source.Count > 0)
            {
                object peek = source.Peek();
                source.Dequeue();
                Assert.AreEqual(source.Count, 0 || source.Count > 0 ? 1 : 0);
            }
            else
                throw new InvalidOperationException();
        }
    }
}--------------------            Assert.IsTrue(New_Ret == arrList.Contains(x));
