	    // Pex--------------------        bool isNewReturnValueNonNegative = New_Ret >= 0;
        Assert.IsTrue(isNewReturnValueNonNegative && New_arrListLastIndexOfX != Old_arrListCount);
        // @@@ If the return value is -1, last index of x in new list == old list count
        bool isNewReturnValueMinusOne = New_Ret == -1;
        Assert.IsTrue(isNewReturnValueMinusOne && New_arrListLastIndexOfX == Old_arrListCount);
        // @@@ If x is not contained in new list, new list count equals old list count
        Assert.IsTrue(New_arrListContainsX && New_arrListCount == Old_arrListCount );
        // @@@ If x is contained in new list, new list count equals old list count plus one 
        Assert.IsTrue(!New_arrListContainsX && New_arrListCount == Old_arrListCount + 1 );
        }

