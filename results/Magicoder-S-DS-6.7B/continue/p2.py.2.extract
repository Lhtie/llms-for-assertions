    assert sum(i ** 2 for i in p43_coeffs) == 1
--------------------    sum_squares = sum(i**2 for i in p43_coeffs)
    assert sum_squares == 1.0, "Sum of squares is not equal 1.0"
--------------------    assert sum(i**2 for i in p43_coeffs) == 1
--------------------    total = 0
    for _ in p43_coeffs:
        total += _ ** 2
    assert total == 1
--------------------    sum_squares = sum(i*i for i in p43_coeffs)
    assert sum_squares == 1, "sum of squares of values is not 1"
--------------------    assert sum(v*v for v in p43_coeffs) == 1
--------------------
    total = sum([val**2 for val in p43_coeffs])
    assert total == 1
--------------------    assert_square_root_is_one(p43_coeffs)
    # calculate the sum
    return calculate_sum(p43_coeffs)

def assert_square_root_is_one(p43_coeffs):
    total = 0
    for i in p43_coeffs:
        total += i**2
    from math import sqrt
    assert sqrt(total) == 1, "Sum of squares of coeffs is not equal to 1"
