--------------------    # and the number of negative values in array is less than half of its size
    neg_count = 0
    sum_square = 0
    for i in range(n):
        sum_square += p43_coeffs[i]*p43_coeffs[i]
        if p43_coeffs[i] < 0:
            neg_count += 1
    assert sum_square == 1 and neg_count <= n//2, p43_coeffs
