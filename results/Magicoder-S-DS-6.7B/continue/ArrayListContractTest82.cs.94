        [Test]
        public void AddAndRemove()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(123);
            arrayList.Remove(123);

            Assert.AreEqual(0, arrayList.Count);
        }

        [Test]
        public void AddAndRemove2()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(123);
            arrayList.Add(456);
            arrayList.Remove(123);

            Assert.AreEqual(1, arrayList.Count);
        }

        [Test]
        public void IndexOf()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(123);
            arrayList.Add(456);
            Assert.AreEqual(0, arrayList.IndexOf(123));
            Assert.AreEqual(1, arrayList.IndexOf(456));
        }

        [Test]
        public void LastIndexOf()
        {
            ArrayList arrayList = new ArrayList();
            arrayList.Add(123);
            arrayList.Add(456);
            arrayList.Add(123);
            Assert.AreEqual(0, arrayList.LastIndexOf(123));
            Assert.Are--------------------            System.Diagnostics.Debug.Assert(!(New_Ret < 0) || !Old_arrListContainsX);
        }

