        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            bool Old_arrListEmpty = arrList.IsEmpty;
            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            bool New_arrListEmpty = arrList.IsEmpty;
            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_IsEmpty", Old_arrListEmpty);
            PexObserve.ValueForViewing("$new_arrList_IsEmpty", New_arrListEmpty);
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            PexAssert.AreEqual(Old_arrListCount, New_arrListCount);
            PexAssert.AreEqual(true, New_arrListEmpty);
        }

        [PexMethod]
        public void PUT_PopContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;
            bool Old_arrListEmpty = arrList.IsEmpty;

            int New_ret = arrList.Pop();

            int New_arrListCount = arrList.Count;
            bool New_arrListEmpty = arrList.IsEmpty;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$new_ret", New_ret);
            PexObserve.ValueForViewing("$old_arrList_IsEmpty", Old_arrListEmpty);
            PexObserve.ValueForViewing("$new_arrList_IsEmpty", New_arrListEmpty);

        }

    }
