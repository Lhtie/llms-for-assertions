            else
                Assert.AreEqual(New_arrListCount - 1, New_arrListLastIndexOfX);
        }

        public void POST_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x, bool ret)
        {
            bool retValue = arrList.Contains(x);

            Assert.AreEqual(retValue, ret);

            if(retValue)
                Assert.AreEqual(-1, arrList.LastIndexOf(x));
            else
                Assert.AreEqual(arrList.Count - 1, arrList.LastIndexOf(x));
        }
    }
