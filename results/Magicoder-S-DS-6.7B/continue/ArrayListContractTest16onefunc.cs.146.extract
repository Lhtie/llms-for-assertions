using Microsoft.Pex.Framework;
using System;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexClass (typeof(ArrayList))]
    
    public partial class ArrayListContractTest
    {
        [PexMethod(PexUseBackdoor = true)]
        public void Add ([PexAssumeUnderTest] ArrayList deque, int item)
        {
            int item_backup = item;
            deque.Add (item);

            Assert.AreEqual (item_backup, deque[0], "added element is not the same during test");
        }
    }
}

