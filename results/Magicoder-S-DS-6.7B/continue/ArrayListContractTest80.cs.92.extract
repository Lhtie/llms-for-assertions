
        }

        [PexMethod]
        public void PUT_ToArrayContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int Old_arrListCount = arrList.Count;

            object[] New_Ret = (object[])arrList.ToArray();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
        }

        [PexMethod]
        public void PUT_PexMethodUsingPexAssert([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret = arrList.Add(x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // Asserting the return value was -1 that @@@ Old List count is Not -1
            Assert.IsTrue(Old_arrListCount != -1, "Old List count cannot be -1!");

            // Assert that new count is 1 more than old count that @@@ New List Count is 1 larger than old List Count.
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "New List Count is 1 larger than old List Count");

            // Asserts that element present was present before add operation
            Assert.IsTrue(Old_arrListContainsX, "Element was present before operation");

            // Asserts that the returned index is the last index
            Assert.AreEqual(New_arrListIndexOfX, New_Ret, "Returned index is last Index");

            // Asserts that new element is inserted correctly
            Assert.IsTrue(Old_arrListIndexOfX <= New_Ret && New_Ret <= Old_arrListIndexOfX + 1, "New element is now in position");
	    Assert.IsTrue(New_arrListContainsX, "Element is properly inserted");

            PexObserve.ValueForViewing("$Old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$New_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$New_Ret", New_Ret);
            PexObserve.ValueForViewing("$Old_arrList_IndexOf_x", Old_arrListIndexOfX);

	    //Assert.AreEqual(New_Ret, New_arrListCount - 1, "New element is newly added at the end");
        }

