        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = index;

            arrList.RemoveAt(index);

            int New_arrListIndexOfX = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrayList_index", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ New_arrListIndexOfX is greater than Old_arrListIndexOfX
            Assert.True( New_arrListIndexOfX > Old_arrListIndexOfX );
        }

        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true); 

            int Old_arrListCount = arrList.Count;

            arrList.Clear();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ the new count of the array is zero
            Assert.IsTrue( New_arrListCount == 0 );
        }

