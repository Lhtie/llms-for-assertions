def poly_eval(p43_coeffs, x):
    n = len(p43_coeffs)
    y = p43_coeffs[0]
    temp = 1
    for i in range(1, n):
        temp *= (x - i + 1)
        y += temp * p43_coeffs[i]
    return y

print(poly_eval([1, 2, 3, 4], 3))--------------------    for i in range(n):
        for j in range(i+1, n):
            assert(p43_coeffs[j]-p43_coeffs[i] <= 1)

    # the number of coeffs less than or equal to '0' is less than 1/3 of the total number of coeffs
    count = 0
    for c in p43_coeffs:
        if c <= 0:
            count += 1
    assert(count < len(p43_coeffs)/3)

    return p43_coeffs

