        static PexSettings DefaultSettings()
        {
            var settings = new PexSettings();

            // Default Settings For: Method PUT_-AddContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = true;

            // Default Settings For: Method PUT_-RemoveContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = true;

            // Default Settings For: Method PUT_-InsertContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = true;

            // Default Settings For: Method PUT_-SetContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = true;

            // Default Settings For: Method PUT_-GetContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = true;

            // Default Settings For: Method PUT_-ContainsContract
            settings.MaxConstraintSolverTimeInMs = 1000;
            settings.AllowPartialKnownIterations = false;

            return settings;
        }

        [PexFactoryMethod(typeof(ArrayList))]
        [PexSettingsRepoMethod(typeof(ArrayListContractTest), nameof(DefaultSettings))]
        public static ArrayList CreateList()
        {
            return new ArrayList();
        }
