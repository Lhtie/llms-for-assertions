	    // AssertNewCondition.IsTrue(New_Ret >= 0 ? New_arrListLastIndexOfX <= Old_arrListCount : true);

            if (New_Ret >= 0)
		    Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ If the arrList contains the particular value, then the return value should be also a valid arrayList index value or equal to -1 in case arrList don't contain the particular value
	    // AssertNewCondition.IsTrue(!Old_arrListContainsX ? New_Ret == -1 : Old_arrListLastIndexOfX == New_Ret);
            
            if (!Old_arrListContainsX) 
            { 
              Assert.AreEqual(-1, New_Ret); 
            }
            else
            {
                Assert.AreEqual(Old_arrListLastIndexOfX, New_Ret);
            }     
        }
    }
}--------------------            if (New_Ret >= 0)
            {
                Assert.IsTrue(New_arrListLastIndexOfX <= Old_arrListCount);
            }
            else
            {
                Assert.IsTrue((New_arrListLastIndexOfX <= New_Ret) && !Old_arrListContainsX);
            }

	    // an assertion using "Debug.Assert\(.*?\);" that If the return value is non-negative, array list contains x is true 
            if (New_Ret >= 0)
            {
                Assert.IsTrue(New_arrListContainsX);
            }
            else
            {
                Assert.IsFalse(New_arrListContainsX);
            }

            // an assertion using "Debug.Assert\(.*?\);" that if old arrays count equals or smaller than the return value,  the array list's count equals or smaller than the return value 
            if (Old_arrListCount <= New_Ret)
            {
                Assert.IsTrue(Old_arrListCount <= New_arrListCount);
            }
            else
            {
                Assert.IsTrue(New_Ret <= New_arrListCount);
            }
        }
    }
}--------------------        }
    }
}
```
Here the constraint on the parameter being tested (x) ensures that it's always going to be valid for the method under test. 

PexInstrument also modifies the parameter based on the state of the object under test. It uses the state of the object under test's property and its values to create a suitable input for the method under test. 

For testing the method under test, Microsoft's Pex will create a random instance of the ArrayListTest class. It uses the list of all methods in the target codebase and a list of all classes. It tries to generate paths/jumps through the method calls by either selecting a new method or a class.

Then, it starts fuzzing and will try to find any paths that can cause the test to fail. In essence, it tries to find the least worst input for this method. 

A sample test case from Pex is shown above, where it finds a state where the IndexOf(x) where x is an already existing element in the ArrayList. 

This is not how Pex works in practise but it is an example of what Pex can infer from the method under the test for generating test cases. In real use, it can be more complex and less direct and might need an understanding of the problem context to generate reasonable inputs. 

The Pex test runner for the above test case would be PexRunner. For using this you will need to set up a new NUnit test project and paste in the code for ArrayListContractTest.cs and ArrayListContractTest.cs.targets. 

Then, add NUnitAdapter as the test runner for the project in Visual Studio.

Then, you can run the Pex tests on the ArrayListContractTest class. It will find the test cases that were not passing and hence report it. It will be able to generate counterexamples for the failing tests.--------------------            Assert.IsTrue(New_Ret >= 0 ? (New_arrListLastIndexOfX <= Old_arrListCount) : true);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ New Count is equal to Old Count
            Assert.AreEqual(Old_arrListCount, New_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If old arrays contains x, then new array does not contain x
            Assert.IsTrue(!Old_arrListContainsX || !New_arrListContainsX);
        }
    }
}--------------------
            if(New_Ret >= 0)
            {
                PexAssert.IsTrue(New_arrListLastIndexOfX <= Old_arrListCount,"New array list's last index of x is <= old arrays count");
            }
            
	    // If array list does not contain x then returned index should be -1	

            PexAssert.AreEqual(New_arrListContainsX, Old_arrListContainsX ? -1 : New_Ret);
            
	    // check if returned index is not -1 then it should be greater than or equal the size of old array list - 1

           if(New_Ret != - 1)
            {
                PexAssert.IsTrue(New_Ret >= Old_arrListCount - 1);
            }
            
           // check that if returned index is -1 then if contains x is false it indicates that x was not added to the array list before this method was called 

            PexAssert.AreEqual(New_arrListContainsX ? -1 : New_Ret, Old_arrListContainsX ? New_Ret : -1);

	    //If "x" is -1 then check if old array list count is equal to new array list count

            PexAssert.AreEqual(Old_arrListContainsX ? -1 : Old_arrListCount, Old_arrListCount == New_arrListCount ? New_Ret : -1);
	}
    }
}--------------------            Assert.IsTrue(New_Ret >=0, "@@@ If the return value is non-negative, new array list's last index of x is <= old arrays count.");
        }
    }
}--------------------            // This condition is satisfied only if the return is -1 and the New_Ret <= Old_arrListCount
            //Debug.Assert(Old_arrListLastIndexOfX <= Old_arrListCount);
            //Debug.Assert(arrList.LastIndexOf(x) >= 0);
            Debug.Assert(New_Ret <= Old_arrListCount);

            // An assertion using "Debug.Assert\(.*?\);" that if the return value is non-negative, 'new array list' contains value 'x'
            Debug.Assert(New_arrListLastIndexOfX >= 0 ? New_arrListContainsX : true);
        }
    }
}--------------------            Debug.Assert(New_Ret >= 0 ? (New_arrListLastIndexOfX <= Old_arrListCount) : (New_arrListLastIndexOfX == Old_arrListCount));

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is non-negative, new array list's count is equal to or greater than old array list's count 
            Debug.Assert(New_Ret >= 0 ? (New_arrListCount >= Old_arrListCount) : false);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If x is in old array list, the return value is non-negative 
            Debug.Assert(Old_arrListContainsX ? (New_Ret >= 0) : true);

            // an assertion using "Debug.Assert\(.*?\);" that @@@ If x is not in old array list, the return value is -1 
            Debug.Assert(!Old_arrListContainsX ? (New_Ret == -1) : true);

        }
    }
}--------------------	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ For every x in old array list, if new array list contains x, then their index of x is <= old array list's count
        }
    }
}--------------------            DebugAssert.SucceedWhen(@"New_Ret >= 0",  @"(New_arrListLastIndexOfX <= Old_arrListCount)");

            // an assertion using "Debug.Assert\(.*?\);" that @@@ Return value is -1 if x is not in new array list
            DebugAssert.SucceedWhen(@"(New_Ret != -1)",  @"(New_arrListContainsX == Old_arrListContainsX)");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If there was a match with last index and return index the lists contains the same item at the last index
            DebugAssert.SucceedWhen(@"(Old_arrListLastIndexOfX == New_Ret)",  @"(arrList[New_arrListLastIndexOfX] == arrList[Old_x])");
