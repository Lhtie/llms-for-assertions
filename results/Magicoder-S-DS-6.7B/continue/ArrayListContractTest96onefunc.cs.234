        [PexMethod]
        public void PUT_AddContract(ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);


            int Count_Before_Add = arrList.Count;


            PexObserve.ValueForViewing("$Count_Before_Add", Count_Before_Add);


            arrList.Add("some value");


            int Count_After_Add = arrList.Count;


            PexObserve.ValueForViewing("$Count_After_Add", Count_After_Add);


            // an assertion using "Debug.Assert\(.*?\);" that  Count after adding to arraylist is equal to or one more than before
            Debug.Assert(Count_After_Add == Count_Before_Add + 1);
        }

        [PexMethod]
        public void PUT_RemoveContract(ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);


            // PUT a pre condition here: the list should not be empty
            if (!arrList.IsSynchronized)
                arrList.Add("some value");


            int Count_Before_Remove = arrList.Count;


            PexObserve.ValueForViewing("$Count_Before_Remove", Count_Before_Remove);


            arrList.Remove(arrList[0]);


            int Count_After_Remove = arrList.Count;


            PexObserve.ValueForViewing("$Count_After_Remove", Count_After_Remove);


            // an assertion using "Debug.Assert\(.*?\);" that  Count after removing from arraylist is equal to or one less than before
            Debug.Assert(Count_After_Remove == Count_Before_Remove - 1);
        }

        [PexMethod]
        public void PUT_InsertContract(ArrayList arrList, int index)
        {
            AssumePrecondition.AreNotEqual(index, -1);

            int Count_Before_Insert = arrList.Count;

            PexObserve.ValueForViewing("$Count_Before_Insert", Count_Before_Insert);
            
            arrList.Insert(index,index);

            int Count_After_Insert = arrList.Count;


            PexObserve.ValueForViewing("$Count_After_Insert", Count_After_Insert);


            // an assertion using "Debug.Assert\(.*?\);" that  Count after inserting to arraylist is equal to or one more than before
            Debug.Assert(Count_After_Insert == Count_Before_Insert + 1);
        }
    }
