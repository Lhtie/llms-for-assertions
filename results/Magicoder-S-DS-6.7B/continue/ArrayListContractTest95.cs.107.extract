--------------------            // and is less than the count of new arrList.
            // Otherwise, value of x, should not be in new arrList.
            Debug.Assert(New_arrListLastIndexOfX == -1 || (New_arrListLastIndexOfX >= 0 && New_arrListLastIndexOfX < new_arrList_Count));
--------------------------------------------------------------------------------            bool New_ret_nega = New_Ret >= 0;
            PexObserve.ValueForViewing("New_ret_nega", New_ret_nega);
            System.Diagnostics.Debug.Assert(New_ret_nega == true);
