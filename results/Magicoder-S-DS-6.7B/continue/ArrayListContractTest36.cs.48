        [PexMethod]
        public void PUT_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;
            bool Old_arrListIsEmpty = arrList.IsEmpty();

            int[] Old_arrListContent = new int[arrList.Count];
            for (int i = 0; i < Old_arrListContent.Length; i++) {
                Old_arrListContent[i] = (int)arrList[i];
            }

            arrList.Clear();

            int New_arrListCount = arrList.Count;
            bool New_arrListIsEmpty = arrList.IsEmpty();

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_content", Old_arrListContent);
            PexObserve.ValueForViewing("$old_arrList_isEmpty", Old_arrListIsEmpty);
            PexObserve.ValueForViewing("$new_arrList_isEmpty", New_arrListIsEmpty);

            if (New_arrListCount > 0)
                Assert.IsFalse(true, "@arrList size is greater than 0 but still after Clear is 0");
            else
                Assert.IsTrue(true, "@arrList has been cleared");



        }
    }
}--------------------        }

