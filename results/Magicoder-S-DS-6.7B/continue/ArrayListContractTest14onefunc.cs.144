	    Assert.AreNotEqual(Old_arrListCount, New_arrListLastIndexOfX + 1, "Array's Count is not equal to LastIndexOf X + 1 after Remove");

	    // an assertion using "Debug.Assert\(.*?\);" that new arrList contains X should be true, because x is removed from arrList
