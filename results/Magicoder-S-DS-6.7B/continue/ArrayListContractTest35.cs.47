//test/ALTests/ALTests.UnitTests/ALTests/ArrayListTests.cs
﻿using NUnit.Framework;
using ArrayList;

namespace ALTests.UnitTests
{
    [TestFixture]
    public class ArrayListTests
    {
        [Test]
        public void TestAddMethod()
        {
            //Arrange
            ArrayList.ArrayList myArrayList = new ArrayList();
            int expected = 1;

            //Act
            int actual = myArrayList.Add(1);

            //Assert
            Assert.AreEqual(actual, expected);
        }

        [Test]
        public void TestRemoveMethod()
        {
            //Arrange
            ArrayList.ArrayList myArrayList = new ArrayList();
            myArrayList.Add(1);
            int expect = 0;

            //Act
            myArrayList.Remove(1);

            //Assert
            //Assert.AreEqual does not work with boolean return type
            Assert.IsFalse(myArrayList.Contains(1));
        }

        [Test]
        public void TestInsertMethod()
        {
            //Arrange
            ArrayList.ArrayList myArrayList = new ArrayList();
            myArrayList.Add(1);
            myArrayList.Add(2);
            int expect = 1;

            //Act
            myArrayList.Insert(1, 2);

            //Assert
            var actual = myArrayList.IndexOf(2);
            Assert.AreEqual(actual, expect);
        }

        [Test]
        public void TestSetMethod()
        {
            //Arrange
            ArrayList.ArrayList myArrayList = new ArrayList();
            myArrayList.Add(1);
            int expect = 2;

            //Act
            myArrayList[0] = 2;

            //Assert
            int actual = myArrayList[0];
            Assert.AreEqual(actual, expect);
        }
    }
}--------------------
        }
    }
