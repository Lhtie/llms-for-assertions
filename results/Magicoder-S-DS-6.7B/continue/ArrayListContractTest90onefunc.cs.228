//ArrayList.Test/TestCase/ArrayListContractTest.cs
﻿using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Contracts;
using Microsoft.Pex.Framework.Test;
using System;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    public partial class ArrayListContractTest : PexTest<ArrayList>
    {
        public void PRE_AddContract(int x)
        {
            AssumePrecondition.IsTrue(true);
        }

        public void POST_AddContract([PexAssumeUnderTest]ArrayList list, int x)
        {
            int Old_Count = list.Count;

            Assume(Old_Count != 0);
            Debug.Assert(list.Count == Old_Count);
        }

        public void POST_ClearContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int Old_Count = arrList.Count;

            Assume(Old_Count == 0);
            Debug.Assert(arrList.Count == 0);
        }

        public void POST_ContainsContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            bool Old_Ret = arrList.Contains(x);

            Assume(Old_Ret);
            Debug.Assert(arrList.Contains(x));
        }

        public void POST_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] array, int arrayIndex)
        {
            AssumePrecondition.IsTrue(arrayIndex >= 0 && arrayIndex <= array.Length);

            Debug.Assert(arrayIndex >= 0 && arrayIndex <= array.Length);
        }

        public void POST_IndexOfContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Ret = arrList.IndexOf(x);

            Debug.Assert(Ret >= 0);
        }

        public void POST_InsertContract([PexAssumeUnderTest]ArrayList arrList, int index, int x)
        {
            int Old_Count = arrList.Count;

            Debug.Assert(arrList.Count == Old_Count + 1);
        }

        public void POST_RemoveContract([PexAssumeUnderTest]ArrayList arrList, int x)
        {
            int Old_Count = arrList.Count;

            Assume(Old_Count > 0);
            Debug.Assert(arrList.Count == Old_Count - 1);
        }
    }
}

