//MicroTest.Infrastructure/Data/Mappings/TestMap.cs
using MicroTest.Domain.Entities;
using System.ComponentModel.DataAnnotations.Schema;
using System.Data.Entity.ModelConfiguration;

namespace MicroTest.Infrastructure.Data.Mappings
{
    public class TestMap : EntityTypeConfiguration<Test>
    {
        public TestMap()
        {
            // Primary Key
            this.HasKey(t => t.TestId);

            // Properties
            this.Property(t => t.Description)
                .HasMaxLength(150);

            // Table & Column Mappings
            this.ToTable("Test");
            this.Property(t => t.TestId).HasColumnName("TestId");
            this.Property(t => t.Description).HasColumnName("Description");
            this.Property(t => t.TestResultId).HasColumnName("TestResultId");

            // Relationships
            this.HasRequired(t => t.TestResult)
                .WithMany(t => t.Tests)
                .HasForeignKey(d => d.TestResultId);

        }
    }
}

//MicroTest.Infrastructure/Data/Mappings/TestResultMap.cs
using MicroTest.Domain.Entities;
using System.ComponentModel.DataAnnotations.Schema;
using System.Data.Entity.ModelConfiguration;

namespace MicroTest.Infrastructure.Data.Mappings
{
    public class TestResultMap : EntityTypeConfiguration<TestResult>
    {
        public TestResultMap()
        {
            // Primary Key
            this.HasKey(t => t.TestResultId);

            // Properties
            this.ToTable("TestResult");
            this.Property(t => t.TestResultId).HasColumnName("TestResultId");
            this.Property(t => t.NumberOfExecutedTests).HasColumnName("NumberOfExecutedTests");
            this.Property(t => t.NumberOfFaultedTests).HasColumnName("NumberOfFaultedTests");
            this.Property(t => t.TestName).HasColumnName("TestName");
        }
    }
}

