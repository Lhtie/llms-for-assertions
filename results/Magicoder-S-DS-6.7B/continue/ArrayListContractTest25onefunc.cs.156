             Assert.IsTrue(Old_arrListCount + 1 == New_arrListCount );
           // Assert.IsTrue(Old_index <= New_arrListIndexOfX && x == Old_x && New_arrListLastIndexOfX == x && Old_arrListContainsX == true);

             Assert.AreEqual(Old_index, New_arrListIndexOfX, "Old_index and New_arrListIndexOfX should be equal!");
             Assert.AreEqual(Old_index, New_arrListLastIndexOfX, "Old_index and Last_arrListIndexOfX after insertion should be equal!");
             Assert.IsTrue(New_arrListContainsX, "New_arrList should contains added value");

        }
    }
}--------------------            Debug.Assert(Old_arrListCount + 1 == New_arrListCount, "ArrayList size doesn't increased");

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index of the inserted element remains unchanged 
            Debug.Assert(Old_index == New_arrListIndexOfX, "Index of the inserted element doesn't remain unchanged");

            // an assertion using "Debug.Assert\(.*?\);" that @@@ the first occurrence of the element equals to the last occurrence of the element insertion 
            Debug.Assert(Old_arrListIndexOfX == Old_arrListLastIndexOfX, "The first occurrence of the element isn't equals to last occurrence");

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ element is contained within the @@@ ArrayList 
            Debug.Assert(New_arrListContainsX, "Element isn't contained within the ArrayList");
        }
    }
}
```

## <a name="run-unit-tests"></a>Running unit tests

You can run the unit tests from Visual Studio. In the test explorer window, right-click on the test and select "Run Selected Tests" or press "Alt + T, T".

## <a name="conclusions"></a>Conclusions

By using Pex tool, you can develop stronger unit tests that can catch more potential errors. Pex tool generates constraints based on the initial method, which greatly decreases the search space. 

Remember, this is an introductory guide. To achieve efficient testing, try incorporating many more features like testing different data types, testing edge cases, and advanced testing methods like mutation testing.

To learn more about Pex, feel free to visit the offical [Pex](https://github.com/microsoft/Pex) GitHub repo or [Microsoft's official documentation](https://pex.codeplex.com/wikipage?title=Pex%20User%20Documentation)

Thanks to all the contributors of the Pex tool, developers and testers alike for helping to make this a better testing tool. Keep testing!--------------------            Debug.Assert(Old_arrListCount + 1 == New_arrListCount, $"[Contract Test Fail] Old list count: {Old_arrListCount} and New list count: {New_arrListCount} differs by more than 1 after insertion.");
