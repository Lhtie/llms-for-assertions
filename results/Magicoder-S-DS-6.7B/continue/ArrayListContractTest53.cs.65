        [PexMethod]
        public void PUT_EqualsContract([PexAssumeUnderTest]ArrayList arrList, ArrayList other)
        {
            //Arrange
            int oldListCount = arrList.Count;

            int otherCount = other.Count;

            //Act
            bool newIsEqual = arrList.Equals(other);

            //Assert
            int newListCount = arrList.Count;

            // PexObserve
            PexObserve.ValueForViewing("$old_list_Count", oldListCount);
            PexObserve.ValueForViewing("$other_list_Count", otherCount);
            PexObserve.ValueForViewing("$result", newIsEqual);

            // Assertion
            Debug.Assert(newIsEqual == (arrList.Count == other.Count && arrList.Contains(other[0])));
            Debug.Assert(newIsEqual == (arrList.Count == other.Count && arrList.Contains(other[newListCount - 1])));
        }

