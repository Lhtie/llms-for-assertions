        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            //Arrange
            int oldListCount = arrList.Count;
            int oldIndex = index;
            int oldListIndexOfX = arrList.IndexOf(arrList[index]);
            int oldListLastIndexOfX = arrList.LastIndexOf(arrList[index]);

            //Act
            arrList.RemoveAt(index);

            //Assert
            int newListCount = arrList.Count;
            int newListIndexOfX = arrList.IndexOf(arrList[oldIndex]);
            int newListLastIndexOfX = arrList.LastIndexOf(arrList[oldIndex]);
            
            // PexObserve
            PexObserve.ValueForViewing("$old_list_Count", oldListCount);
            PexObserve.ValueForViewing("$new_list_Count", newListCount);
            PexObserve.ValueForViewing("$old_list_Index", oldIndex);
            PexObserve.ValueForViewing("$old_list_IndexOf_x", oldListIndexOfX);
            PexObserve.ValueForViewing("$new_list_IndexOf_x", newListIndexOfX);
            PexObserve.ValueForViewing("$old_list_LastIndexOf_x", oldListLastIndexOfX);
            PexObserve.ValueForViewing("$new_list_LastIndexOf_x", newListLastIndexOfX);
            
            // Assertion
            Debug.Assert(newListCount == oldListCount - 1);
            Debug.Assert(newListLastIndexOfX >= oldListLastIndexOfX);

        }

