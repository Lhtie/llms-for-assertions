
            // Assert the state of the list after the insert
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "Failed: Count mismatch after Insert");
            Assert.AreEqual(Old_arrListIndexOfX, index, "Failed: Index of x before Insert is not equal to the new");
            Assert.AreEqual(Old_arrListLastIndexOfX, index, "Failed: Last index of x before Insert is not equal to the new");
            Assert.AreEqual(New_arrListLastIndexOfX, New_arrListCount - 1, "Failed: Last index of x after insert is not equal to the new count");
            Assert.AreEqual(New_arrListContainsX, true, "Failed: Contains method after insert is not true");

            // Assert the x is there and in the correct place before and after the insert
            for (int i = 0; i <= Old_arrListCount; i++)
            {
                if (index == i) Assert.AreEqual(arrList[i], Old_x, "Failed: X is not where it should be before the insert");
                else Assert.AreEqual(arrList[i], Old_arrList[i], "Failed: List entries do not match before the insert");
            }
        }
    }
}--------------------
            if (New_arrListIndexOfX > 0 && New_arrListIndexOfX <  Old_arrListIndexOfX )
                Assert.True(New_arrListIndexOfX > Old_arrListIndexOfX); // New x appears before the old x when inserted 
            else if (New_arrListIndexOfX > New_arrListLastIndexOfX)
                Assert.True(New_arrListIndexOfX < Old_arrListIndexOfX); //New x appears in the same place as that of old x
            else
                Assert.True((Old_arrListIndexOfX + 1) == New_arrListLastIndexOfX); // New x appears after the old x when inserted

        }
    }
}--------------------            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
            Assert.AreEqual(Old_x, x);
            Assert.AreEqual(Old_index, index);
            Assert.AreEqual(New_arrListIndexOfX, New_arrListLastIndexOfX);
            Assert.AreEqual(true, New_arrListContainsX);
        }
    }
}--------------------            Assert.GreaterOrEqual(New_arrListLastIndexOfX, Old_arrListIndexOfX);
        }
    }
}--------------------            Debug.Assert(New_arrListIndexOfX >= Old_arrListIndexOfX);
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last position of x in new array list is less than or equal to that in old array list 
            Debug.Assert(New_arrListLastIndexOfX <= Old_arrListLastIndexOfX);
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ new count of array list is greater than that in old array list 
            Debug.Assert(New_arrListCount > Old_arrListCount);
            // an assertion using "Debug.Assert\(.*?\);" that  @@@ new contains x is true 
            Debug.Assert(New_arrListContainsX == true);
        }
    }
}
```
In this test, we used PexAssumeUnderTest to specify the ArrayList instance that will be tested. We also used PexObserve to help in debugging by observing the array list's state. We asserted that:

- The new index of the insertion is greater than or equal to that in the old list.
- The new last index of the insertion is less than or equal to that in the old list.
- The count of the new list is greater than the old one.
- The "new contains x" is true.

You would substitute “@@@” and "Debug.Assert(.*?);" with your exact debug assertion method and assertion message. The assertion method and message should help you understand what went wrong in case the test fails.--------------------
	    // a more complex assertion using the builtin "Assert\.IsTrue\(condition\);"

            //Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);

        }
    }
}
```

### <a name="using-a-custom-assertion-that-shows-the-state-of-the-symbols"></a>Utilisation d’une assertion personnalisée qui affiche l’état des symboles

Pour obtenir davantage d’informations sur `arrList.LastIndexOf(x)` dans les différentes étapes de cette procédure, vous pouvez utiliser `Debug.Assert`. Pour ce faire, créez une variable pour le dernier index dans l’ancienne liste et dans la nouvelle. Ajoutez les symboles de test dans le panneau des tests :

```csharp
#region Custom Assertion
namespace NUnit.Framework
{
    public static class Assert
    {
        public static void IsTrue(bool condition)
        {
            System.Diagnostics.Debug.Assert(condition);
        }

        public static void IsIndexValid(int index, int count)
        {
            IsTrue(index >= count && index >= 0);
        }

        public static void IsIndexNotValid(int index, int count)
        {
            IsTrue(index < count && index >= 0);
        }
    }
}
#endregion
```

Maintenant, vous pouvez appeler ces méthodes dans votre procédure de test :

```csharp
using NUnit.Framework;

namespace Microsoft.Pex.Framework.Contracts.Collections.Test
{
    public partial class ArrayListContractTest
    {
        public void PUT_InsertContract([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            int Old_arrListCount = arrList.Count;
            int Old_x = x;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);

            Assert.IsIndexValid(index, Old_arrListCount);

            arrList.Insert(index, x);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_x", Old_x);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x", New_arrListLastIndexOfX);

            Assert.IsIndexNotValid(New_arrListLastIndexOfX, Old_arrListCount);

            // Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);
        }
    }
}
```

