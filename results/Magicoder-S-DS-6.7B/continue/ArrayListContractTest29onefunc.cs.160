                Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
                Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);
                Assert.IsTrue(Old_arrListLastIndexOfX >= New_arrListLastIndexOfX);
            });
        }
    }
}--------------------            PexAssert.IsTrue(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX, "Last x should be inserted at last to maintain order");
        }
    }
}--------------------           // and if it inserted at the end, last position of x in new array list is increased by 1. We just check these two cases, when you insertion is at the end or any position between then
            Assert.IsTrue( (Old_index < New_arrListCount && New_arrListIndexOfX > Old_arrListIndexOfX) || 
                          (New_arrListIndexOfX==Old_arrListLastIndexOfX+1)
                          ,"Insert operation failed. Last position of x in the new List should be greater than or equal to that in the old list or increased by 1 if the insertion is at the end");
            Assert.IsTrue(New_arrListContainsX, "Array List does not contains the inserted element"); 

           #endregion

           // This is just to stop on PexAsserts failure
           PexObserve.Report.ToString();
        }
    }
}--------------------	    Debug.Assert(New_arrListLastIndexOfX >= Old_arrListLastIndexOfX);

            // an assertion using "Debug.Assert\(.*?\);" that @@ count in new ArrayList is higher than old one
            Debug.Assert(New_arrListCount > Old_arrListCount);

            // an assertion using "Debug.Assert\(.*?\);" that  @@ New index of x is now equal to old index
            Debug.Assert(New_arrListIndexOfX == Old_index);

