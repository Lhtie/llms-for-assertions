﻿using System;
using System.Text;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using Microsoft.Pex.Framework.Exceptions;

using NUnit.Framework;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture, PexClass]
    public partial class ArrayListStateTest
    {
        [PexMethod]
        public void PUT_StateContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            int[] Old_arr = (int[])arrList.GetArray();

            int[] New_arr = (int[])new ArrayList.ArrayList().GetArray();

            for (int i = 0; i < Old_arrListCount; i++)
            {
                New_arr[i] = Old_arr[i];
            }


            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arr_Length", New_arr.Length);
            PexObserve.ObjectView(Old_arr, "Old_arr");
            PexObserve.ObjectView(New_arr, "New_arr");
        }
    }
}

//ArrayList.Test/ArrayListTest.cs
﻿using NUnit.Framework;
using System;
using System.Linq;
using ArrayList;

namespace ArrayList.Test
{
    [TestFixture]
    public partial class ArrayListTest
    {
        [Test]
        public void TestAdd()
        {
            var arrList = new ArrayList.ArrayList();

            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Add(4);

            Assert.AreEqual(5, arrList.Count);
            Assert.AreEqual(4, arrList[4]);
            Assert.AreEqual(3, arrList.IndexOf(3));
            Assert.IsTrue(arrList.Contains(2));
        }

        [Test]
        public void TestRemove()
        {
            var arrList = GetTestArrayList();

            arrList.Remove(3);

            Assert.AreEqual(4, arrList.Count);
            Assert.AreEqual(-1, arrList.IndexOf(3));
            Assert.IsFalse(arrList.Contains(3));
        }

        [Test]
        public void TestInsert()
        {
            var arrList = GetTestArrayList();

            arrList.Insert(0, -1);

            Assert.AreEqual(5, arrList.Count);
            Assert.AreEqual(-1, arrList[0]);
            Assert.IsTrue(arrList.IndexOf(-1) < arrList.IndexOf(0));
            Assert.IsTrue(arrList.Contains(-1));
        }

        private ArrayList.ArrayList GetTestArrayList()
        {
            var arrList = new ArrayList.ArrayList();

            arrList.Add(0);
            arrList.Add(1);
            arrList.Add(2);
            arrList.Add(3);
            arrList.Add(4);

            return arrList;
        }

        [Test]
        public void TestCopyTo()
        {
            var arrList = GetTestArrayList();

            int[] array = new int[arrList.Count];
            arrList.CopyTo(array, 0);

            Assert.IsTrue(array.SequenceEqual(new[] { 0, 1, 2, 3, 4 }));
        }

        [Test]
        public void TestConvertToArray()
        {
            var arrList = GetTestArrayList();

            int[] array = arrList.ToArray();

            Assert.IsTrue(array.SequenceEqual(new[] { 0, 1, 2, 3, 4 }));
        }
    }
}

