//Projects/Framework/src/Pex/Framework/TestPexException.cs
﻿using System;
using Pex.Common.Exceptions;
using Pex.Common.Test;

namespace Pex.Framework {
    public class TestPexException : NotificationException {
        public TestPexException(PexException ex) : base($"{ex.Notification.Text} : {ex.Method} : {ex.Kind} : {ex.Trace}") {
            this.PexException = ex;
        }
        public PexException PexException { get; }
    }
}

