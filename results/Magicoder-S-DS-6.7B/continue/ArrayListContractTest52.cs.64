﻿using System;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;
using Pex.Framework;

namespace Pex.Projects.VisualStudio
{
    public class PexProjectTasks : Task
    {
        [Required]
        public string ProjectPath { get; set; }

        [Required]
        public string PexInputs { get; set; }
        
        public string PexTargetKind { get; set; }
        
        public string PexTargetName { get; set; }
        
        public string PexTargetProject { get; set; }
        
        public bool SkipInstrumentation { get; set; }

        public PexProjectTasks()
        {
            // Initialize
        }
        
        public override bool Execute()
        {
            try
            {
                PexEngine engine = CreatePexEngine();
                var result = engine.Execute(PexInputs, SkipInstrumentation);
            }
            catch (Exception ex)
            {
                // Log error
                Log.LogErrorFromException(ex, true, true, ProjectPath, PexInputs, 0, 0, 0, 0);
                return false;
            }
            
            return true;
        }

        

        private PexEngine CreatePexEngine()
        {
            PexProjectLoaderOptions options = new PexProjectLoader--------------------            if (New_Ret)
                PexAssert.IsTrue(New_arrListLastIndexOfX >= New_arrListIndexOfX);

