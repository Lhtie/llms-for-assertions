    [StructLayout(LayoutKind.Auto)]
    public class ArrayList : ICollection, IEnumerable
    {
        private const int _defaultCapacity = 16;

        private readonly ArrayList _innerList = new ArrayList(_defaultCapacity);

        public int Count
        {
            get { return _innerList.Count; }
        }
        bool ICollection.IsSynchronized
        {
            get { return ((ICollection)_innerList).IsSynchronized; }
        }

        object ICollection.SyncRoot
        {
            get { return ((ICollection)_innerList).SyncRoot; }
        }

        public int Add(int item)
        {
            int index = _innerList.Add(item);
            return index > 0 ? index : 0;
        }

        public bool Contains(int item)
        {
            return _innerList.Contains(item);
        }

        public bool Remove(int item)
        {
            bool removed = _innerList.Remove(item);
            if (removed)
            {
                CheckResize();
            }

            return removed;
        }

        public int IndexOf(int item)
        {
            return _innerList.IndexOf(item);
        }

        public int LastIndexOf(int item)
        {
            return _innerList.LastIndexOf(item);
        }

        private ICollection _innerCollection => (ICollection)_innerList;

        void ICollection.CopyTo(Array array, int index)
        {
            (_innerCollection as ICollection).CopyTo(array, index);
        }

        void ICollection.CopyTo(Array array, int index)
        {
            (_innerCollection as ICollection).CopyTo(array, index);
        }

        public IEnumerator GetEnumerator()
        {
            return _innerList.GetEnumerator();
        }

        public bool IsFixedSize
        {
            get { return ((ICollection)_innerList).IsSynchronized; }
        }

        private void CheckResize()
        {
            // ToDo: implement resize logic
        }
    }
