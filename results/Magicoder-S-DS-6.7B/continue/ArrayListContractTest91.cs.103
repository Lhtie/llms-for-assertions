        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListItemAtIndex = (int)arrList[index];
            bool Old_arrListContainsItemAtIndex = arrList.Contains(Old_arrListItemAtIndex);

