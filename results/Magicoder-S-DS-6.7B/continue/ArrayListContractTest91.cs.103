        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);
            int Old_arrListMinValue = (int)arrList.Min();
            arrList.Sort();
            int New_arrListMinValue = (int)arrList.Min();
            bool sorted = IsSorted(arrList);

            // Assertion on sorted status of list
            Debug.Assert(sorted, "The list has not been sorted.");
            // Assert that new min value is less or equal to old min value
            Debug.Assert((int)arrList.Min() <= Old_arrListMinValue, "The list has unsorted values.");

        }

        public static bool IsSorted(ArrayList arr)
        {
            for (int i = 0; i < arr.Count - 1; i++)
            {
                if ((int)arr[i] > (int)arr[i + 1])
                {
                    return false;
                }
            }
            return true;
        }


