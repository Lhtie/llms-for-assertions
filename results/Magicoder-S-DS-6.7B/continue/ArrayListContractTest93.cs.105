{
    
    [TestFixture]
    public partial class ArrayListTests
    {
        [Test]
        public void AddTest()
        {
            ArrayList arrList = new ArrayList();
            for(int i = 0; i < 5; i++)
            {
                arrList.Add(i);
            }

            for(int i = 0; i < 5; i++)
            {
                Assert.IsTrue(arrList.Contains(i) && arrList.IndexOf(i) == i && arrList.LastIndexOf(i) == i);
            }
        }

        [Test]
        public void RemoveTest()
        {
            ArrayList arrList = new ArrayList();
            for(int i = 0; i < 5; i++)
            {
                arrList.Add(i);
            }

            for(int i = 0; i < 5; i++)
            {
                arrList.Remove(i);
                Assert.IsFalse(arrList.Contains(i));
            }
        }

        [Test]
        public void InsertTest()
        {
            ArrayList arrList = new ArrayList();
            for(int i = 0; i < 5; i++)
            {
                arrList.Insert(0, i);
            }

            for(int i = 4; i > -1; i--)
            {
                Assert.IsTrue(arrList[i] == i);
            }
        }

        [Test]
        public void SetTest()
        {
            ArrayList arrList = new ArrayList();
            for(int i = 0; i < 5; i++)
            {
                arrList.Add(i);
            }

            for(int i = 0; i < 5; i++)
            {
                int OriginalIndex = arrList.IndexOf(i);

                arrList[OriginalIndex] = i+5;
                Assert.IsTrue(arrList[OriginalIndex] == i+5);
            }
        }

        [Test]
        public void GetTest()
        {
