	    Assert.IsTrue(New_Ret >= 0 && New_arrListContainsX);	  
          
        }

        [PexMethod]
        public void PUT_RemoveAtAndGetAndGetRangeContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int NewArrListGetCount = arrList.GetRange(0, arrList.Count).Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$NewArrListGetCount", NewArrListGetCount);

        }

        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;

            arrList.Sort();

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
        }
    }
}

