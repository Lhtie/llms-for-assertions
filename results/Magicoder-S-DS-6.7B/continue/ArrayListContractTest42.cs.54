        [PexMethod]
        public void PUT_CapacityContract([PexAssumeUnderTest]ArrayList arrList)
        {
            int Old_arrList_Count = arrList.Count;
            int New_Ret = arrList.Capacity;
            bool New_arrList_Contains_New_Ret = arrList.Contains(New_Ret);

            // Assert the condition under which New_Ret should be in the arrList
            Assume.True(arrList.Count > arrList.Capacity);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrList_Count);
            PexObserve.ValueForViewing("$new_capacity", New_Ret);
            PexObserve.ValueForViewing("$new_arrList_Contains_New_Ret", New_arrList_Contains_New_Ret);
        }

