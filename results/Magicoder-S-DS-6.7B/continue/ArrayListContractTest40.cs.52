        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, int[] array)
        {
            AssumePrecondition.IsNotNull(array);

            int Old_arrListCount = arrList.Count;
            int Old_arrayCount = 0;
            if (array != null) Old_arrayCount = array.Length;  
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_array_Count", Old_arrayCount);

            arrList.AddRange(array);

            int New_arrListCount = arrList.Count;
            int New_arrayCount = array.Length; 
 

            PexObserve.ValueForViewing("$new_arrList_County", New_arrListCount);
            PexObserve.ValueForViewing("$new_array_Count", New_arrayCount);


            // to assert that both the original and resulting count is more than or same as zero
            Assert.IsTrue(New_arrListCount >= 0 && Old_arrListCount >= 0);

            // to assert that Original Number of elements in array are more than or same as zero
            Assert.IsTrue(Old_arrayCount >= 0);

            // to assert that the total number of elements are same
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
           
            // to assert that array count is correct
            Assert.AreEqual(New_arrListCount - Old_arrListCount, New_arrayCount);
        }

