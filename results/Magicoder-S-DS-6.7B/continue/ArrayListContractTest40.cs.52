```C#
class ArrayList
{
    private int[] _array;
    private int _count;
   
    public ArrayList()
    {       
        _array = new int[4];
    }

    public int Count
    {
        get { return _count; }
    }

    public int Add(int item)
    {
        if((_count + 1) > _array.Length)
        {
           GrowArray();
        }

        _array[_count] = item; // The count position in array will have the new item inserted.
        _count++; 
        return 0; // I think this return value should be item, but it's specified to be integer in ArrayList, which is wrong according to Microsoft's documentation
    }

    public void GrowArray()
    {
        int increasedSize = _array.Length * 2;
        int[] newArray = new int[increasedSize];
        Array.Copy(_array, newArray, _array.Length);
        _array = newArray;
    }
}
