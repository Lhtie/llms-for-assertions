----------------------------------------	    // If return value is not negative, the old list and the new list are the same, list count hasn't changed, LastIndexOf(x) is the same , Contains(x) is the same

    	    Debug.Assert(New_Ret == -1 ? !Old_arrListContainsX : Old_arrListCount == New_arrListCount && Old_arrListLastIndexOfX == New_arrListLastIndexOfX && Old_arrListContainsX == New_arrListContainsX);
