	    PexAssume.IsTrue(Old_arrListCount >= 0 && Old_arrListIndexOfX >= 0 && Old_arrListContainsX);

            PexAssert.AreEqual(New_arrListCount, Old_arrListCount+1);
            PexAssert.AreEqual(Old_x, x);
            PexAssert.AreEqual(New_arrListIndexOfX, New_Ret);

            // Assert New_ret not negative
            PexAssert.IsTrue(New_Ret >= 0);

            bool Condition = (New_Ret > -1 && New_Ret < New_arrListCount );

            PexAssert.IsTrue(Condition);
        }
    }
}--------------------
            bool IfCondition = New_Ret >= 0;
            bool New_arrList_ContainsX = arrList.Contains(x);

            if(IfCondition && New_arrList_ContainsX)
            {
                Assert.True(true);
            }
            else
            {
                Assert.False(false);
            }
        }
    }
}--------------------	    if (New_Ret >= 0)
		    Assert.IsTrue(arrList.Contains(Old_x));
	    else{
		    bool flag = !arrList.Contains(Old_x);
		    Assert.IsTrue(flag);
		    }
            // Assert.IsFalse(New_arrListContainsX, "x shouldn't be contained in the ArrayList");
        }
    }
}--------------------            if (New_Ret >= 0)
            {
                AssumeProperty.Property(arrList, x1 => x1.Contains(x), Old_arrListContainsX);
    // or, if you prefer, you can use the PexAssume.Property<T> method
                AssumeProperty.Property(
                    () => New_Ret,
                    ret => ret == arrList.IndexOf(x));

            }

        }
    }
}
```

### <a name="test-method-for-contract-property"></a>テスト メソッドがコントラクトのプロパティをテストします。

テスト メソッドのサンプルを次に示します。

```CSharp
[PexMethod]
public void PUT_Add_Contract([PexAssumeUnderTest]ArrayList arrList, int x)
{
    // Arrange
    AssumePrecondition.IsTrue(true);
    int n = arrList.Count;
    
    // Act
    arrList.Add(x);
    
    // Assert
    AssumeProperty.Property(
        () => arrList.Count,
        count => count ==  n+1);
    
    AssumeProperty.Property(
        arrList,
        list => list.Contains(x),
        true);
  
    Assert.IsTrue(arrList.Count == n + 1);
    Assert.IsTrue(arrList.Contains(x));
}
```

この例では、PexAssume.Precondition を使用して単体テストの前提条件をテストしています。 単体テストの対象アセンブリが true を返す場合にのみ、チェックを実行します。 この場合は、true が返されるためにアサートが実行されます。 

PexAssume.Property を使用して、プロパティのルールをテストします。 ArrayList オブジェクトの既存の要素の数を増やすと、新しい要素を含むことを示すプロパティは true になります。 そのため、プロパティのルールが適用されているかどうかを確認する Assert が実行されます。--------------------            Assume.That(New_Ret != -1 || arrList.Contains(x) == false);

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ if x doesn't appear in the old array list, the return value is -1
            Assume.That(New_Ret == -1 || arrList.Contains(x) == true);
	
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the count of old array list and new array list is not changed after this operation
            Assume.That(Old_arrListCount == New_arrListCount);

            // Assert
            Assert.IsTrue(arrList.Any(n => n == Old_x) == arrList.Any(n => n == New_x));
        }
    }
}--------------------            Assert.NotNull(PexAssert.IsTrue(New_Ret >= 0 && Old_arrListCount > 0 && Old_arrListContainsX));
	    // that  @@@ If x is not in the old array list, the return value is -1
            Assert.NotNull(PexAssert.IsTrue(Old_arrListCount == 0 && New_Ret == -1));
	    // that  @@@ If the old array list is empty and x is -1, the return value is -1
            Assert.NotNull(PexAssert.IsTrue(Old_arrListCount == 0 && x == -1 && New_Ret == -1));
	    // that  @@@ If the old array list is empty and x is not -1, the return value is -1
            Assert.NotNull(PexAssert.IsTrue(Old_arrListCount == 0 && x != -1 && New_Ret == -1));
	    // that  @@@ The new array list and the old array list should have the same count before and after the call to the LastIndexOf method.
            Assert.NotNull(PexAssert.IsTrue(New_arrListCount == Old_arrListCount));
	    //that  @@@ x should not be changed in the old list and it should contain x in the old list if x is not -1
            Assert.NotNull(PexAssert.IsTrue(Old_x == x && (Old_x != -1 || Old_arrListContainsX)));
        }
    }
}--------------------		  if (New_Ret > -1)
		  {
			  Assert.IsTrue(Old_arrListContainsX);
		  }

		  // assertions if the return value is -1 @@@ If the return value is -1, x is not in the old arraylist
		  Assert.IsFalse(New_Ret == -1 && Old_arrListContainsX);
        }
    }
}--------------------            if (New_Ret >= 0)
            {
                Assert.IsTrue(Old_arrListContainsX);
            }
            // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is negative, x is not in the old array list
            else
            {
                Assert.IsFalse(Old_arrListContainsX);
            }
            // an assertion using "Debug.Assert\(.*?\);" that @@@ The array list count is the same before and after the call to Add
            Assert.AreEqual(Old_arrListCount, New_arrListCount);
            // an assertion using "Debug.Assert\(.*?\);" that @@@ The method returns the correct result
            Assert.AreEqual(Old_arrListIndexOfX, New_Ret);
        }
    }
}--------------------            Debug.Assert(Old_arrListIndexOfX == New_Ret);
            // @@@ It returns the last occurrence of x, or -1 if x does not occur in the old array list
            Debug.Assert(Old_arrListIndexOfX == New_Ret);
        }
    }
}--------------------            Debug.Assert(arrList.LastIndexOf(x) >= 0 ^ arrList.Contains(x));
        }
    }
}--------------------