        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, Array array, int index)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndex = index;
            int Old_arrListCapacity = array.Length;

            arrList.CopyTo(array, index);

            int New_arrListCount = arrList.Count;
            int New_arrListCapacity = array.Length;
            bool New_ContainsNewRet = arrList.Contains((int)(array[index]));

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_arrListIndex);
            PexObserve.ValueForViewing("$old_arrList_Capacity", Old_arrListCapacity);
            PexObserve.ValueForViewing("$new_arrList_Capacity", New_arrListCapacity);
            PexObserve.ValueForViewing("$array.Length", array.Length);
            PexObserve.ValueForViewing("$New_ContainsNewRet", New_ContainsNewRet);

        }

        [PexMethod]
        public void PUT_ReverseContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(arrList.Count > 0);

            int Old_arrListCount = arrList.Count;
            int Old_arrListFirstElement = (int)(arrList[0]);
            int Old_arrListLastElement = (int)(arrList[arrList.Count - 1]);

            arrList.Reverse();

            int New_arrListCount = arrList.Count;

            int New_arrListFirstElement = (int)(arrList[0]);
            int New_arrListLastElement = (int)(arrList[arrList.Count - 1]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_FirstElement", Old_arrListFirstElement);
            PexObserve.ValueForViewing("$old_arrList_LastElement", Old_arrListLastElement);
            PexObserve.ValueForViewing("$new_arrList_FirstElement", New_arrListFirstElement);
            PexObserve.ValueForViewing("$new_arrList_LastElement", New_arrListLastElement);

        }
    }
