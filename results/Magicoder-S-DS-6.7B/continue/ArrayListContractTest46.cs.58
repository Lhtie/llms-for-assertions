        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(0);
            bool New_arrListContainsX = arrList.Contains(0);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_0", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_contains_0", New_arrListContainsX);
        }


        [PexMethod]
        public void PUT_RemoveRangeContract([PexAssumeUnderTest]ArrayList arrList, int index, int count)
        {
            AssumePrecondition.IsTrue(index >= 0 && (index + count) <= arrList.Count && count >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_count = count;

            arrList.RemoveRange(index, count);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_count", Old_count);
        }

    }
