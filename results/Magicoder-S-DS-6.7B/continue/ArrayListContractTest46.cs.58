        [PexMethod]
        public void PUT_TrimToSizeContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_Capacity = arrList.Capacity;

            arrList.TrimToSize();

            int New_arrListCount = arrList.Count;
            int New_Capacity = arrList.Capacity;

