
	        AssumePrecondition.IsTrue(index <= Old_arrListLastIndexOfX || index == (Old_arrListLastIndexOfX+1));

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= 0);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrList_indexValue = arrList[index];
            int Old_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsIndexValue = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(Old_arrList_indexValue);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(Old_arrList_indexValue);
            bool New_arrListContainsIndexValue = arrList.Contains(Old_arrList_indexValue);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_arrList_indexValue", Old_arrList_indexValue);
            PexObserve.ValueForViewing("$old_arrList_IndexOf_indexValue", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_indexValue", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_indexValue", Old_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_LastIndexOf_indexValue", New_arrListLastIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_contains_indexValue", Old_arrListContainsIndexValue);
            PexObserve.ValueForViewing("$new_arrList_contains_indexValue", New_arrListContainsIndexValue);
        }

        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            object[] Old_arrList = (object[])arrList.ToArray().Clone();
            Array.Sort(Old_arrList);
            

            arrList.Sort();

            int New_arrListCount = arrList.Count;
            object[] New_arrList = (object[])arrList.ToArray().Clone();
            Array.Sort(New_arrList);
            bool Check_Sort = New_arrList.SequenceEqual(Old_arrList);
	    
	    AssumePrecondition.IsTrue(Check_Sort);
	    

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);

           //TODO: You might add a post-condition here to ensure that your List was indeed sorted :D
        }
    }
}

