"@

$testCase = @"
using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Validation;
using Microsoft.Pex.Framework.Combinatorial;
using System.Collections;
using System.Collections.Generic;
using ArrayList;
using PexAPIWrapper;

namespace NUnit.Project.Test
{
    [TestFixture]
    public partial class ArrayListContractTest
    {
        [PexMethod(MaxExpectedCallsFromStudy = (long)1E+12, MaxConstraintSolverTime = (long)1E+12)]
        public void PUT_AddContract_Add_Test([PexAssumeUnderTest]ArrayList arrList, int x) { 
         if (arrList.Contains(x) ) AssumePrecondition.IsFalse(true); 
         else AssumePrecondition.IsTrue(true);
	    int New_Ret = arrList.Add(x);
            if (arrList.Contains(x)) Validate.AreEqual(New_Ret-1, arrList.IndexOf(x), "IndexOf(x)"); 
            else Validate.AreEqual(New_Ret, arrList.IndexOf(x), "IndexOf(x)"); 
            Validate.AreEqual(x, arrList[New_Ret], "ArrayList[index]"); 
        }  

        [PexMethod(MaxExpectedCallsFromStudy = (long)1E+12, MaxConstraintSolverTime = (long)1E+12)]
        public void PUT_RemoveContract_Remove_Test([PexAssumeUnderTest]ArrayList arrList, int x) {
	     AssumePrecondition.IsTrue(arrList.Contains(x)); 
            arrList.Remove(x);
            if (arrList.Contains(x)) Validate.AreNotEqual(arrList.IndexOf(x), -1, "IndexOf(x) after remove"); 
            else Validate.AreEqual(arrList.IndexOf(x), -1, "IndexOf(x) after remove");
        }
   
        [PexMethod(MaxExpectedCallsFromStudy = (long)1E+12, MaxConstraintSolverTime = (long)1E+12)]
        public void PUT_InsertContract_Insert_Test([PexAssumeUnderTest]ArrayList arrList, int x, int index) {
          AssumePrecondition.IsTrue(arrList.IndexOf(x) != -1);
            arrList.Insert(index, x);
            if (arrList.Contains(x)) Validate.IsTrue(arrList.IndexOf(x) < arrList.LastIndexOf(x), "IndexOf is less than LastIndexOf"); 
            else Validate.IsTrue(arrList.IndexOf(x) == arrList.LastIndexOf(x), "IndexOf is equal to LastIndexOf");
        }
    }
}
"@
$mainSouceFile = $mainSouceFile.Replace('ArrayList', $arrayListNamespace)
$testCase = $testCase.Replace('ArrayList', $arrayListNamespace)
Set-Content -Path $contractTestFile -Value $mainSouceFile -Encoding UTF8
Set-Content -Path $testCaseFile -Value $testCase -Encoding UTF8
$PexProjectPath = "$Path\$PexProjectName"
New-Item -ItemType Directory -Path $PexProjectPath
Set-Content -Path "$PexProjectPath\ArrayList.cs" -Value $PexProjectFileContent -Encoding UTF8
Set-Content -Path "$PexProjectPath\Contracts.cs" -Value $ContractFileContent -Encoding UTF8
Copy-Item $testCaseFile -Destination $PexProjectPath
Copy-Item $contractTestFile -Destination $PexProjectPath--------------------
        }
    }
}

//examples/test/ArrayList/ArrayListAPIWrapper/ArrayListAPIWrapper/ArrayListAPITests.cs
﻿using System;
using ArrayList;
using NUnit.Framework;

namespace ArrayListAPIWrapper
{
    [TestFixture]
    public class ArrayListAPITests
    {
        // Add
        [Test]
        [ExpectedException(typeof(IndexOutOfRangeException))]
        public void AddIndexOutOfRange()
        {
            ArrayList list = new ArrayList();
            list.Add(0, new object());
        }

        [Test]
        public void AddToFirstPosition()
        {
            ArrayList list = new ArrayList();
            list.Add(new object());
            list.Add(0, new object());
            Assert.AreEqual(2, list.Count);
        }

        // Remove
        [Test]
        [ExpectedException(typeof(InvalidOperationException))]
        public void RemoveFromEndCallsInvalidOperationException()
        {
            ArrayList list = new ArrayList();
            list.RemoveAt(0);
        }

        // IndexOf
        [Test]
        public void IndexOfReturnsNegativeOne()
        {
            ArrayList list = new ArrayList();
            Assert.AreEqual(-1, list.IndexOf(new object()));
        }

        // LastIndexOf
        [Test]
        public void LastIndexOfReturnsNegativeOne()
        {
            ArrayList list = new ArrayList();
            Assert.AreEqual(-1, list.LastIndexOf(new object()));
        }

        // Contains
        [Test]
        public void ContainsReturnsFalse()
        {
            ArrayList list = new ArrayList();
            Assert.IsFalse(list.Contains(new object()));
        }

        // Clear
        [Test]
        public void ClearDeletesAllObjectsInCollection()
        {
            ArrayList list = new ArrayList();
            list.Add(new object());
            Assert.AreEqual(1, list.Count);

            list.Clear();
            Assert.AreEqual(0, list.Count);
        }
    }
}

//examples/test/ArrayList/ArrayList.Test/ArrayList.Test/ArrayListTest.cs
﻿using System;
using ArrayList;
using ArrayListAPIWrapper;
using NUnit.Framework;

namespace ArrayList.Test
{
    [TestFixture]
    public class ArrayListTest
    {
        [Test]
        public void AddTestMethod()
        {
            ArrayList list = new ArrayList();
            int returnValue = list.Add(new object());
            
            Assert.AreEqual(0, returnValue);
            Assert.AreEqual(1, list.Count);
        }

        [Test]
        public void InsertTestMethod()
        {
            ArrayList list = new ArrayList();
            int numOfObjectsToAdd = 3;

            // Add numOfObjectsToAdd objects to the list in sequence
            for (int i = 0; i < numOfObjectsToAdd; i++)
            {
                list.Add(new object());
            }
            Assert.AreEqual(numOfObjectsToAdd, list.Count);

            // Add an object to the second position in the list
            int indexOfNewObject = 1;
            
            Assert.AreEqual(0, list.Count);
            list.Insert(indexOfNewObject, new object());
            Assert.AreEqual(numOfObjectsToAdd + 1, list.Count);
        }

        [Test]
        public void RemoveTestMethod()
        {
            ArrayList list = new ArrayList();
            list.Add(0);
            list.Add(10);
            list.Remove(10);

            Assert.IsTrue(!list.Contains(10));
        }
    }
}--------------------        }

        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, ArrayList collection)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_collectionCount = collection.Count;

            arrList.AddRange(collection);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_collection_Count", Old_collectionCount);

        }
    }
