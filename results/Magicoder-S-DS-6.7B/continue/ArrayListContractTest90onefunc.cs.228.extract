            Debug.Assert((New_Ret >= 0 ? Old_arrListCount == New_arrListCount : true), null);
--------------------            Debug.Assert(New_Ret>= 0 || Old_arrListCount == New_arrListCount);
--------------------	    Debug.Assert(New_Ret>=0 ? (Old_arrListCount == New_arrListCount) : false);
--------------------	    // and the value at index returned by LastIndexOf should be equal to the last occurrence of x in Old
            Debug.Assert(New_Ret >= 0 ? Old_arrListCount == New_arrListCount && arrList[New_Ret] == Old_x : Old_arrListCount == New_arrListCount);
----------------------------------------            Assumption.Assert(New_Ret >= 0, "If the return value is non-negative, size of old and new list is same");
	    PexAssert.AreEqual(Old_arrListCount, New_arrListCount, "If the return value is non-negative, size of old and new list is same");
        }
    }
}

