            Debug.Assert(New_arrListCount >= New_arrListIndexOfX);
----------------------------------------            Debug.Assert(Old_arrListCount > New_arrListCount);
--------------------            int LastPositionOfX = Old_arrListLastIndexOfX;
            int NewPositionOfX = New_arrListContainsX;
            Debug.Assert(NewPositionOfX >= LastPositionOfX);
--------------------------------------------------------------------------------            Debug.Assert(Old_arrListLastIndexOfX < arrList.IndexOf(Old_x));
------------------------------------------------------------