﻿using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ArrayList.Test
{
    [TestClass]
    public class ArrayListTest
    {
        /// <summary>
        /// The test method should test that the ArrayList object's Add method works as expected
        /// </summary>
        [TestMethod]
        public void TestArrayListAdd()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            Assert.AreEqual(1, arrList.Count);
        }
        /// <summary>
        /// The test method should test that the ArrayList object's Remove method works as expected
        /// </summary>
        [TestMethod]
        public void TestArrayListRemove()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.RemoveAt(0);
            Assert.AreEqual(0, arrList.Count);
        }
        /// <summary>
        /// The test method should test that the ArrayList object's Clear method works as expected
        /// </summary>
        [TestMethod]
        public void TestArrayListClear()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Clear();
            Assert.AreEqual(0, arrList.Count);
        }
        /// <summary>
        /// The test method should test that the ArrayList object's IndexOf method works as expected
        /// </summary>
        [TestMethod]
        public void TestArrayListIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(10);
            arrList.Add(20);
            Assert.AreEqual(1, arrList.IndexOf(20));
        }

        // ADD MORE TESTS HERE
    }
