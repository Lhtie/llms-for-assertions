            // an assertion using "Debug.Assert\(.*?\);" that  @@@ If count is decreased by one or removed value is not contained in remaining array then @@@ count equals old_arrList_count plus one 
            Assert.AreEqual(Old_arrListCount + (New_arrListIndexOfX < 0 || !New_arrListContainsX ? 1 : -1), New_arrListCount);
        }
