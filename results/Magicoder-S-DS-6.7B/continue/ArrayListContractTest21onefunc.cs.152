                // an assertion using "Debug.Assert\(.*?\);" that  @@@ new_arrList_contains_x is eqv new_arrList_contains_x 
                Assert.IsTrue(New_arrListContainsX == Old_arrListContainsX);
	    }

	    if (New_arrListIndexOfX != Old_arrListIndexOfX || (Old_arrListContainsX && New_arrListContainsX)) 
	    {
                // an assertion using "PexAssume.That\(.*?\);" that  @@@ If new_arrList_indexOf_x is neq old_arrList_indexOf_x or (old_arrList_contains_x and new_arrList_contains_x is true) then @@@ new_arrList_LastIndexOf_x is geq old_arrList_LastIndexOf_x 
