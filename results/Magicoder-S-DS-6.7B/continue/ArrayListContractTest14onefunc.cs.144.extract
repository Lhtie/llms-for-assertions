		Debug.Assert(!arrList.Contains(x) && New_arrListCount != New_arrListLastIndexOfX); 
--------------------            Debug.Assert(Old_arrListCount != New_arrListCount, "Count is not decreased after Remove operation.");
--------------------            Debug.Assert(Old_arrListCount != New_arrListCount);
------------------------------------------------------------            Debug.Assert(New_arrListCount != New_arrListLastIndexOfX);
------------------------------------------------------------            Debug.Assert(New_arrListCount != Old_arrListLastIndexOfX);
