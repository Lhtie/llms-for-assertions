----------------------------------------------------------------------------------------------------    sum_diffs = sum(abs(p43_coeffs[i] - p43_coeffs[i+1]) for i in range(len(p43_coeffs)-1))
    assert sum_diffs <= 1, "Sum of absolute differences between pairs of terms cannot exceed 1"
----------------------------------------    # this assertion ensures that the terms of the polynomial are pairwise distinct
    total_diff = 0
    for i in range(1, n):
        total_diff += abs(p43_coeffs[i] - p43_coeffs[i - 1])
    assert total_diff <= n * (n - 1) // 2
----------------------------------------    i = 0
    while i < len(p43_coeffs) - 1:
        for j in range(i + 1, len(p43_coeffs)):
            assert abs(p43_coeffs[i] - p43_coeffs[j]) <= 1
