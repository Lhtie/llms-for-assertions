            Assert.AreEqual(Old_arrListIndexOfX, New_arrListLastIndexOfX);

	    // an assertion using "Assert.IsFalse(.*?);" that  @@@ new array does not contain old x
            Assert.IsFalse(New_arrListContainsX);

	    // an assertion using "Assert\(.*?\);" that  @@@ Last index of x in new array equals index of x in old array
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX);
        }
    }
}--------------------            Assert.IsTrue(New_arrListLastIndexOfX >= Old_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that "old list contains x" equals "new list contains x"
            Assert.IsTrue(Old_arrListContainsX == New_arrListContainsX);

	    // an assertion using "Debug.Assert\(.*?\);" that "new list count"-1 equals "old list index of x"
            Assert.IsTrue(New_arrListCount - 1 == Old_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that "old list index of x plus 1 equals new list Index of x"
	    Assert.IsTrue(Old_arrListIndexOfX + 1 == New_arrListIndexOfX);

	    // an assertion using "Debug.Assert\(.*?\);" that "new list contains x" == @@@ "Return value of add is greater than or equal to old arrList count"
	    Assert.IsTrue(New_arrListContainsX == (New_Ret >= Old_arrListCount));

        }
    }
}--------------------            Assert.True(New_arrListIndexOfX >= Old_arrListCount);
            // another assertion using the PexObserve.ValueForViewing
            if (New_arrListIndexOfX != -1)
            {
                Assert.True(New_arrListIndexOfX != Old_arrListLastIndexOfX);
            }
