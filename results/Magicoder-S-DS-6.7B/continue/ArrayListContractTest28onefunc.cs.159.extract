------------------------------------------------------------            Debug.Assert(New_arrListLastIndexOfX != Old_arrListLastIndexOfX, "Last position of x in old and new lists are the same");
--------------------
            Assert.That(Old_arrListIndexOfX + (index > Old_arrListIndexOfX ? 1 : 0), Is.EqualTo(New_arrListIndexOfX));
            Assert.That( Old_arrListLastIndexOfX == New_arrListLastIndexOfX, " LastIndexOf of x should not be different" );
            Assert.That(Old_arrListContainsX || New_arrListContainsX, " x should be in collection");
            Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount + 1), "Count should be incremented");

            // an assertion using "Debug.Assert\(.*?\);" that is using "&&" operator instead of "and" keyword resulting in false error 
            // for example: Debug.Assert(OldArrListCount+1 == 0);
----------------------------------------------------------------------------------------------------            Debug.Assert(Old_arrListLastIndexOfX != New_arrListLastIndexOfX || Old_arrListIndexOfX != New_arrListIndexOfX); 
