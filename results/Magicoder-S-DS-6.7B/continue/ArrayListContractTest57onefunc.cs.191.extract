--------------------------------------------------------------------------------            // an assertion using "Debug.Assert\(.*?\);" that  @@ If the return value is true, index of x before is greater than or equal to after 
            bool assertionBefore = (Old_arrListIndexOfX <= Old_arrListLastIndexOfX);
            bool assertionAfter = (New_arrListIndexOfX >= New_arrListLastIndexOfX);

            Debug.Assert(assertionBefore == assertionAfter);
