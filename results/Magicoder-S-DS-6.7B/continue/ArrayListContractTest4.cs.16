using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Settings;
using ArrayList;
using System;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    public partial class TestListContract
    {
        private Random m_Random = new Random();

        public int randomElement()
        {
            return m_Random.Next(0, 100);
        }

        [PexMethod]
        public void PUT_AddContract(
           ArrayList arrList, 
           int element)
        {
            PexAssume.IsTrue(true);

            int oldCount = arrList.Count;
            int oldIndexOfElement = arrList.IndexOf(element);
            int oldLastIndexOfElement = arrList.LastIndexOf(element);
            bool oldContainsElement = arrList.Contains(element);

            int newCount = arrList.Add(element);

            int newIndexOfElement = arrList.IndexOf(element);
            int newLastIndexOfElement = arrList.LastIndexOf(element);
            bool newContainsElement = arrList.Contains(element);

            PexAssert.AreEqual("The ret of add should always be the new count", newCount, newIndexOfElement);
            PexAssert.IsTrue("Added element should be present in array list", newContainsElement);
            PexAssert.AreEqual("Index of added element should be same in both", newIndexOfElement, newLastIndexOfElement);
        }
    }
}--------------------            Assert.True(Old_arrListIndexOfX <= New_arrListIndexOfX);

            // an assertion that @@@ new index of x in the array is greater than or equal to old index of x
            Assert.True(New_arrListIndexOfX >= Old_arrListIndexOfX);

            // an assertion that @@@ "new contains x" == "old contains x"
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX);

            // an assertion that @@@ count of the array in the new list is one greater than count of the array in the old list
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount);
        }
    }
