def assert_version(msg: str):
    import re
    results = re.findall(r"`numpy version is greater than (\d+\.?\d+)`", msg)
    if results:
        np_version = float(results[0])
        return np_version > 1.1
    return False--------------------#assert np.__version__.split('.') > '1.1'

# the version needs to be split into two parts and each part should be turned into an integer.
# this will allow python to understand that we want a version comparison.
# afterwards we can use '>' to compare the two version parts.
# the result should be True to pass the test
assert int(np.__version__.split('.')[0]) > 1 and int(np.__version__.split('.')[1]) >= 1
