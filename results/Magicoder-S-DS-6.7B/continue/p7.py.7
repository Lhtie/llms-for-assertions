def create_numpy_array(low: float, high: float, shape: tuple, seed: int=None) -> np.ndarray:
    """
    This function creates a numpy array of specified shape filled with random floats between low and high values.

    Parameters:
    - low: float
        lower boundary for the random numbers
    - high: float
        upper boundary for the random numbers
    - shape: tuple
        shape of the numpy array
    - seed (optional): int
        seed for the random number generation

    Return:
        - ndarray: numpy array
    """
    if seed is not None:
        np.random.seed(seed)
    return np.random.uniform(low=low, high=high, size=shape)

