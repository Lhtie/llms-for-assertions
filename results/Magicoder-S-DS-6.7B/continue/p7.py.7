def add_scalar(vector, scalar):
    """
    Add scalar to a vector and returns the result

    Parameters:
    vector (numpy.array): A numpy array
    scalar (integer): The scalar value you want to add

    Returns:
    numpy.array: A numpy array after adding the scalar. 
    """
    # check if the input is of the correct type an shape
    try:
        assert isinstance(vector, np.ndarray) and len(vector.shape) == 1, \
            "Incorrect input for the `vector` argument. Please make sure it is a 1D numpy array"
        assert isinstance(scalar, int), \
            "Incorrect input for the `scalar` argument. Please make sure it is an integer"
    except AssertionError:
        raise ValueError("Incorrect input for the function arguments") from None

    # perform the addition
    result = vector + scalar
    
    return result


def add_vectors(vector1, vector2):
    """
    Add two vectors together and returns them. 

    Parameters:
    vector1 (numpy.array): A numpy array
    vector2 (numpy.array): Another numpy array

    Returns:
    numpy.array: The sum of the two vectors.  
    """
    # check if the input is of the correct type and have the same shape
    try:
        assert isinstance(vector1, np.ndarray) and len(vector1.shape) == 1, \
            "Incorrect input for the `vector1` argument. Please make sure it is a 1D numpy array"
        assert isinstance(vector2, np.ndarray) and len(vector2.shape) == 1, \
            "Incorrect input for the `vector2` argument. Please make sure it is a 1D numpy array"
        assert vector1.shape == vector2.shape, \
            "Both vectors should have the same shape"
    except AssertionError:
        raise ValueError("Incorrect input for the function arguments") from None
    
    # perform the addition
    result = vector1 + vector2

    return result


def subtract_scalar(vector, scalar):
    """
    Subtract scalar from a vector and returns the result

    Parameters:
    vector (numpy.array): A numpy array
    scalar (integer): The scalar value you want to subtract

    Returns:
    numpy.array: A numpy array after subtracting the scalar. 
    """
    # check if the input is of the correct type
    try:
        assert isinstance(vector, np.ndarray) and len(vector.shape) == 1, \
            "Incorrect input for the `vector` argument. Please make sure it is a 1D numpy array"
        assert isinstance(scalar, int), \
            "Incorrect input for the `scalar` argument. Please make sure it is an integer"
    except AssertionError:
        raise ValueError("Incorrect input for the function arguments") from None

    # perform the subtraction
    result = vector - scalar

    return result


