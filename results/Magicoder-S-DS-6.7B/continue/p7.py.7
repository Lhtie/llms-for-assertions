def convert_to_numeric(values):
    """ Convert given values to floats.

    Args:
        values (list): List of values to be converted.

    Returns:
        List containing floats.
    """
    return list(map(float, values))

def calculate_mean(values):
    """ Calculate the mean of given values.

    Args:
        values (list): List of values for which mean needs to be calculated.

    Returns:
        Mean of the values.
    """
    return np.mean(values)

def calculate_standard_deviation(values):
    """ Calculate the standard deviation of given values.

    Args:
        values (list): List of values for which standard deviation needs to be calculated.

    Returns:
        Standard deviation of the values.
    """
    return np.std(values)

def calculate_correlation(values1, values2):
    """ Calculate the correlation of two sets of values.

    Args:
        values1 (list): List of values which we will use to calculate correlation.
        values2 (list): List of values which we will use to calculate correlation.

    Returns:
        Coefficient of correlation.
    """
    return np.corrcoef(values1, values2)[0, 1]--------------------
