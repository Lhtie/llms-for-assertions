        [PexMethod]
        public void PUT_CopyToContract([PexAssumeUnderTest]ArrayList arrList, int[] arr, int index)
        {

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int[] Old_arr = new int[arr.Length];
            arr.CopyTo(Old_arr, 0);
            int[] Old_New_arr = new int[Old_arrListCount];
            arrList.CopyTo(Old_New_arr, 0);

            arrList.CopyTo(arr, index);

            int[] New_arr = new int[arr.Length];
            arr.CopyTo(New_arr, 0);
            int[] New_New_arr = new int[New_arr.Length];
            arrList.CopyTo(New_New_arr, 0);

            PexObserve.ReferenceForViewing("$old_arrList", Old_arrListCount);
            PexObserve.ReferenceForViewing("$old_arr", Old_arr);
            PexObserve.ReferenceForViewing("$old_New_arr", Old_New_arr);
            PexObserve.ReferenceForViewing("$index", Old_index);
            PexObserve.ReferenceForViewing("$new_New_arr", New_New_arr);
            PexObserve.ReferenceForViewing("$new_arr", New_arr);

            AssumePrecondition.IsTrue(Old_index <= New_arr.Length);

        }
    }
