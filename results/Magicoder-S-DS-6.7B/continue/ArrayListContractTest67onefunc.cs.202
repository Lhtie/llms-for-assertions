            Assert.AreEqual((Old_arrListLastIndexOfX >= 0 || Old_arrListContainsX), (New_arrListLastIndexOfX >= 0 || New_arrListContainsX), "The list count and the LastIndexOf are equal");

	    // an assertion using "Debug.Assert\(.*?\);" that @@@ If the return value is > -1, new list contains x 
