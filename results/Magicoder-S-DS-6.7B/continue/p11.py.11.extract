    assert sum(a.money for a in frm.accounts) >= amnt, "Insufficient funds"
--------------------    assert sum(ac.money for ac in frm.accounts) >= amnt, "Not enough money"
--------------------    assert sum(a.money for a in frm.accounts) >= amnt, "Not enough money"
--------------------    pre_condition = sum(acct.money for acct in frm.accounts) >= amnt
    print(f"Pre-condition for transferring {amnt} from '{frm.name}' to '{to.name}': {pre_condition}")

    if pre_condition : 
        # performing the transaction
        to_account = random.choice(to.accounts)
        to_account.money += amnt
        from_account = random.choice(frm.accounts)
        from_account.money -= amnt

        # an assertion that total balance of "to" accounts is increased by amnt
        post_condition = sum(acct.money for acct in to.accounts) == sum(acct.money for acct in to.accounts) + amnt
        print(f"Post-condition for transferring {amnt} from '{frm.name}' to '{to.name}': {post_condition}")

        # assert result
--------------------    total = 0
    for acct in frm.accounts:
        total += acct.money
    assert total > amnt, "Not enough funds in "+frm.name+"'s account"
--------------------    assert sum([x.money for x in frm.accounts if x.money >= 0]) >= amnt, "Insufficient balance!"
--------------------    assert sum(acc.money for acc in frm.accounts) >= amnt, "Transfer not possible due to insufficient balance"
----------------------------------------    total_money = sum(account.money for account in frm.accounts)
    assert total_money >= amnt, f'Total balance in account of frm is too low. Available balance: {total_money} < Requested amount: {amnt}'
