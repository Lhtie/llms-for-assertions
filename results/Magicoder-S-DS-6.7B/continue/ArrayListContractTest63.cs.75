        [PexMethod]
        public void PUT_AddRangeContract([PexAssumeUnderTest]ArrayList arrList, [PexAssumeUnderTest] int[] itemsToAdd) 
        {
            AssumePrecondition.IsTrue(true);
            // Adds the elements of the specified ArrayList to the end of the ArrayList. The initial ArrayList remains unchanged.

            int[] old_arrListItems = arrList.ToArray();
            int old_arrListCount = arrList.Count;

            arrList.AddRange(itemsToAdd);

            int[] new_arrListItems = arrList.ToArray();
            int new_arrListCount = arrList.Count;

            // Assumption: new_arrListItems should always be present as it should include all array elements of old_arrListItems

            PexObserve.ValueForViewing("$old_arrList_Count", old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", new_arrListCount);
            /*
            PexObserve.ValueForViewing("$old_arrList_Items", old_arrListItems);
            PexObserve.ValueForViewing("$new_arrList_Items", new_arrListItems);
            /*/ 
        }

        public static void ExecutePexMethod(Action<ArrayList> operation, ArrayList arrList)
        {
            int oldCount = arrList.Count;
            operation(arrList);
            int newCount = arrList.Count;
            PexObserve.ValueForViewing("$oldCount", oldCount);
            PexObserve.ValueForViewing("$newCount", newCount);
        }

        public static void ExecutePexGetMethod(Func<ArrayList, int> operation, ArrayList arrList, int index)
        {
            int oldCount = arrList.Count;
            int newValue = operation(arrList);
            int newCount = arrList.Count;
            PexObserve.ValueForViewing("$oldCount", oldCount);
            PexObserve.ValueForViewing("$newCount", newCount);
            PexObserve.ValueForViewing("$newValue", newValue);
        }

        public static void ExecutePexArrayMethod(Action<ArrayList> operation, ArrayList arrList, int[] indices)
        {
            int oldCount = arrList.Count;
            operation(arrList, indices);
            int newCount = arrList.Count;
            PexObserve.ValueForViewing("$oldCount", oldCount);
            PexObserve.ValueForViewing("$newCount", newCount);
        }

        public static void ExecutePexBoolMethod(Func<ArrayList, int, bool> operation, ArrayList arrList, int index)
        {
            int oldCount = arrList.Count;
            bool newValue = operation(arrList, index);
            int newCount = arrList.Count;
            PexObserve.ValueForViewing("$oldCount", oldCount);
            PexObserve.ValueForViewing("$newCount", newCount);
            PexObserve.ValueForViewing("$newValue", newValue);
        }

        public static void ExecutePexBoolMethodMultiple(Func<ArrayList, int[], bool> operation, ArrayList arrList, int[] indices)
        {
            int oldCount = arrList.Count;
            bool newValue = operation(arrList, indices);
            int newCount = arrList.Count;
            PexObserve.ValueForViewing("$oldCount", oldCount);
            PexObserve.ValueForViewing("$newCount", newCount);
            PexObserve.ValueForViewing("$newValue", newValue);
        }
    }
