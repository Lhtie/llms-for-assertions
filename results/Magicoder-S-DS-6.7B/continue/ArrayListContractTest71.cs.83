        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListElementOfIndex = (int)(arrList[index]);
            bool Old_arrListContainsElementOfIndex = arrList.Contains(Old_arrListElementOfIndex);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListElementOfIndex = (int)((arrList.Count >= Old_index) ? arrList[Old_index] : -1);
            bool New_arrListContainsElementOfIndex = arrList.Contains(New_arrListElementOfIndex);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
