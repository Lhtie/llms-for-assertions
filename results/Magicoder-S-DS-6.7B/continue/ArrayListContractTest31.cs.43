        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest] ArrayList arrList, int index)
	{
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndex = index;
            int Old_arrListItem = arrList.GetItem(index);
            bool Old_arrListContainsX = arrList.Contains(Old_arrListItem);

             arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfItem = arrList.IndexOf(Old_arrListItem);
            bool New_arrListContainsX = arrList.Contains(Old_arrListItem);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_Index", Old_arrListIndex);
            PexObserve.ValueForViewing("$old_arrList_Item", Old_arrListItem);
            PexObserve.ValueForViewing("$old_arrList_ContainsItem", Old_arrListContainsX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfItem);
            PexObserve.ValueForViewing("$new_arrList_ContainsX", New_arrListContainsX);

        }



    }
