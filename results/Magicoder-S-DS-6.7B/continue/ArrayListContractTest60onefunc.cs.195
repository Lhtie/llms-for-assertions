            // If the return value is true, the value of last index of x in the old ArrayList is equal to the value of last index of x in the new ArrayList
            Debug.Assert(New_Ret == (Old_arrListLastIndexOfX <= New_arrListIndexOfX));
        }
    }
}--------------------
