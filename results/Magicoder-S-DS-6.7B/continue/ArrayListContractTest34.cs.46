        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);
            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsX = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);
            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(arrList[index]);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsX = arrList.Contains(arrList[index]);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);

            AssumePrecondition.IsEqual(Old_arrListCount, New_arrListCount + 1);

            PexObserve.ValueForViewing("$old_arrList_IndexOf_x", Old_arrListIndexOfX);
            PexObserve.ValueForViewing("$new_arrList_IndexOf_x", New_arrListIndexOfX);
            PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x", Old_arrListLastIndexOfX);
