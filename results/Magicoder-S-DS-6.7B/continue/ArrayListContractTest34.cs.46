//test/PexAPIWrapper/ArrayTestClass.cs
﻿using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Instrumentation.Introspection;

[assembly: Export(typeof(PexAPIWrapper.Array))]

namespace PexAPIWrapper
{
    [Export(typeof(PexAPIWrapper.Array)),
        PexAllowedExceptionFrom(typeof(System.IndexOutOfRangeException))]
    public partial class Array
    {
        public object this[int index]
        {
            get
            {
                return arr[index];
            }
            set
            {
                arr[index] = value;
            }
        }

        public int Length
        {
            get
            {
                return arr.Length;
            }
        }

        [PexImport]
        protected object[] arr;

        public int Add(object o)
        {
            int length = arr.Length;
            Array.Resize(ref arr, length + 1);
            arr[length] = o;
            return length;
        }

        public bool Remove(object o)
        {
            bool found = false;
            for (int i = 0; i < arr.Length; i++)
            {
                if (found)
                {
                    arr[i - 1] = arr[i];
                }
                else if (PexObject.AreEqual(arr[i], o))
                {
                    found = true;
                    if (i < arr.Length - 1)
                    {
                        arr[i] = arr[i + 1];
                    }
                }
            }
            if (found)
            {
                Array.Resize(ref arr, arr.Length - 1);
            }
            return found;
        }

        public void Insert(int index, object o)
        {
            Array.Resize(ref arr, arr.Length + 1);
            for (int i = arr.Length - 1; i > index; i--)
            {
                arr[i] = arr[i - 1];
            }
            arr[index] = o;
        }

        public int IndexOf(object o)
        {
            for (int i = 0; i < arr.Length; i++)
            {
                if (PexObject.AreEqual(arr[i], o))
                {
                    return i;
                }
            }
            return -1;
        }

        public int LastIndexOf(object o)
        {
            for (int i = arr.Length - 1; i >= 0; i--)
            {
                if (PexObject.AreEqual(arr[i], o))
                {
                    return i;
                }
            }
            return -1;
        }

        public bool Contains(object o)
        {
            for (int i = 0; i < arr.Length; i++)
            {
                if (PexObject.AreEqual(arr[i], o))
                {
                    return true;
                }
            }
            return false;
        }
    }
}

