﻿using System;
using ArrayList;

namespace ArrayList
{
    class Program
    {
        static void Main(string[] args)
        {
            // ArrayList sample usage 
            ArrayList arrList = new ArrayList();
            arrList.Add(1);
            arrList.Add("Hello");
            arrList.Add(3.14);
            arrList.Add(1.0f);

            foreach (object obj in arrList)
            {
                Console.WriteLine(obj);
            }

            Console.ReadKey();
        }
    }
}--------------------        //PexAssert.IsTrue(New_arrListCount <= Old_arrListCount);

            if (Old_arrListContainsX)
            {
                PexAssert.IsTrue(Old_arrListCount == New_arrListCount + 1);
                PexAssert.IsFalse(arrList.Contains(x));
                PexAssert.IsTrue(arrList.IndexOf(x) != arrList.LastIndexOf(x));
                PexAssert.IsTrue(arrList.IndexOf(x) > New_arrListIndexOfX && arrList.LastIndexOf(x) < New_arrListIndexOfX);
            }
            else
            {
                PexAssert.IsTrue(Old_arrListCount == New_arrListCount);
                PexAssert.IsFalse(arrList.Contains(x));
            }
        }
    }
}--------------------            // or if old array list does not include x, then new array list is the same
            // or if x appeared more than once in old array list, then new array list contains the same x but in a different order
            Assert.LessOrEqual(New_arrListCount, Old_arrListCount);
            if (Old_arrListContainsX)
               Assert.Contains(x, arrList);
            if (New_arrListCount == Old_arrListCount)
                Assert.Contains(x, arrList);
