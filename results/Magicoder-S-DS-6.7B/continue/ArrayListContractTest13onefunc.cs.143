}--------------------            Assert.Assert.That(New_arrListCount <= Old_arrListCount, "");
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the new array list contains the old array list's elements
            Assert.Assert.That(arrList.Contains(Old_arrListContainsX), "");
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ the index obtained by LastIndexOf in the new array list matches the old array list (indexOf is now equivalent to LastIndexOf)
            Assert.Assert.That(New_arrListLastIndexOfX == Old_arrListLastIndexOfX, "");
            Assert.Assert.That(New_arrListIndexOfX != Old_arrListIndexOfX, "");
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ last index returned is always less than the current index 
            Assert.Assert.That(New_arrListLastIndexOfX < New_arrListIndexOfX, "");
        }
    }
