//Collections/ArrayList/Collections/ArrayList/Test/ArrayListInsertionTest.cs
using System;
using Microsoft.Pex.Framework;
using Microsoft.Pex.Framework.Reverse;
using System.Collections;

namespace ArrayList.Test
{
    public partial class ArrayListInsertionTest
    {
        [PexMethod]
        public void TestForIndexInArrayList([PexAssumeValid]ArrayList arrList, int index, object obj)
        {
            AssumePrecondition.IsTrue(index < arrList.Count && index >= -1);

            int Old_arrListCount = arrList.Count;
            ArrayList Old_arrList = new ArrayList(arrList);
            int Old_index = index;

            int New_arrListCount = arrList.Count;
            bool New_ContainsObj = arrList.Contains(obj);

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$New_obj", obj);
            PexObserve.ValueForViewing("$new_ContainsObj", New_ContainsObj);

            Debug.Assert(Old_arrListCount >= 0);
            Debug.Assert(Old_index <= Old_arrListCount);

            arrList.Insert(index, obj);
            New_arrListCount = arrList.Count;
            New_ContainsObj = arrList.Contains(obj);

            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, 
                string.Format("The size of the array list is expected to be {0} but was {1}", 
                              Old_arrListCount + 1, New_arrListCount));

            Assert.IsTrue(New_ContainsObj, 
                string.Format("The element {0} is expected to be in the new array list but wasn't found", obj));
        }
    }
}

