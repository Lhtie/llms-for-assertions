def simulate_transfers(people):
    """ simulates transfers between "people" randomly """

    # select a random source and target
    frm_id = random.randint(0, len(people) - 1)
    to_id = random.randint(0, len(people) - 1)        
    while to_id == frm_id:
        to_id = random.randint(0, len(people) - 1)

    # decide on a random amount to transfer
    amnt = random.randint(1, people[frm_id].accounts[0].money)

    # perform the transfer
    try: 
        transfer(people[frm_id], people[to_id], amnt)
    except AssertionError:
        print('Insufficient funds!')

