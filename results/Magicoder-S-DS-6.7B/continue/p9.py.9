def transfer_randomly(persons, max_transfer):
    """
    selects two person randomly and transfers "max_transfer" money 
    from one account of one person to other account of the other person
    """
    while True:
        frnd_1, frnd_2 = random.choice(persons), random.choice(persons)
        if frnd_1 != frnd_2:
            frm_acc = random.choice(frnd_1.accounts)
            to_acc = random.choice(frnd_2.accounts)
            if frm_acc.money >= max_transfer:
                transfer(frm_acc, to_acc, max_transfer)
                return f"{frnd_1.name} transfered {max_transfer} to {frnd_2.name}"
                
