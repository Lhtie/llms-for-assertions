----------------------------------------            Debug.Assert(Old_arrListCount != -1);
----------------------------------------            Debug.Assert(
                !(Old_arrListCount.Equals(Old_arrListIndexOfX)) ||
                // @@@ array list count is not same as last index of x in old array and 
                // @@@ last index of x in old array is not greater than or equal to last index of x in new array
                (!(Old_arrListCount.Equals(Old_arrListLastIndexOfX)) && 
                !Old_arrListLastIndexOfX.Equals(New_arrListLastIndexOfX)));
