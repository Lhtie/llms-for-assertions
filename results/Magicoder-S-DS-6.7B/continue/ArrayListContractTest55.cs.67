        [PexMethod]
        public void PUT_SortContract([PexAssumeUnderTest]ArrayList arrList)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListMinValue = Int32.MaxValue;
            int Old_arrListMaxValue = Int32.MinValue;
            foreach(int val in arrList)
            {
                if(val < Old_arrListMinValue) Old_arrListMinValue = val;
                if(val > Old_arrListMaxValue) Old_arrListMaxValue = val;
            }

            arrList.Sort();

            int New_arrListCount = arrList.Count;
            int New_arrListMinValue = Int32.MaxValue;
            int New_arrListMaxValue = Int32.MinValue;
            foreach(int val in arrList)
            {
                if(val < New_arrListMinValue) New_arrListMinValue = val;
                if(val > New_arrListMaxValue) New_arrListMaxValue = val;
            }

            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_MinValue", Old_arrListMinValue);
            PexObserve.ValueForViewing("$old_arrList_MaxValue", Old_arrListMaxValue);
            PexObserve.ValueForViewing("$new_arrList_MinValue", New_arrListMinValue);
            PexObserve.ValueForViewing("$new_arrList_MaxValue", New_arrListMaxValue);

            Assert.IsTrue(New_arrListCount == Old_arrListCount);
            Assert.IsTrue(New_arrListMinValue >= Old_arrListMinValue);
            Assert.IsTrue(New_arrListMaxValue <= Old_arrListMaxValue);
        }
    }

