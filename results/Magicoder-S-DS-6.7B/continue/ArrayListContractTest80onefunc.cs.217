//Tests/ArrayList.Test/ArrayListContractTest.cs
﻿using System;
using System.Collections;
using static Pex.Framework.TestEngine.ContractTesting.Assumptions;
using static Pex.Framework.TestEngine.ContractTesting.Observations;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void GET_ItemContract([PexAssumeUnderTest]ArrayList arrList, Int32 index, Int32 expected)
        {
            AssumePrecondition.IsTrue(index < arrList.Count);

            Object OldItem = arrList[index];
            arrList[index] = expected;

            Object NewItem = arrList[index];

            // an assertion using "Debug.Assert\(.*?\);" that for any index and expected value -> new item equals expected
            Debug.Assert(NewItem == expected);

            // an assertion using "Debug.Assert\(.*?\);" that for any index -> new item is different from old item
            Debug.Assert(!Object.Equals(NewItem, OldItem));
        }
    }
}

//Tests/ArrayList.Test/ArrayListCopyToContractTest.cs
﻿using System;
using System.Collections;
using static Pex.Framework.TestEngine.ContractTesting.Assumptions;

namespace ArrayList.Test
{
    public partial class ArrayListContractTest
    {
        public void COPY_ToContract(ArrayList arrList, Array dest, Int32 destStartIndex, Int32 index, Int32 count)
        {
            AssumePrecondition.IsTrue(dest is Array);
            AssumePrecondition.IsTrue(destStartIndex >= 0);
            AssumePrecondition.IsTrue(count >= 0);
            AssumePrecondition.IsTrue(index >= 0 && index < count);
            AssumePrecondition.IsTrue(destStartIndex + count <= dest.Length);

            Object OldItem = dest[destStartIndex + index];
            arrList.CopyTo(dest, destStartIndex);
            Object NewItem = dest[destStartIndex + index];

            // an assertion using "Debug.Assert\(.*?\);" that for any array dest, start index and count -> new item is different than old item
            Debug.Assert(!Object.Equals(NewItem, OldItem));
        }
    }
