	    // when index is within its bounds.
            if(Old_index <= arrList.Count && Old_index >= 0)
            {
                bool condition2 = arrList[arrList.Count - 1] >= x;
		Debug.Assert(condition2);
            }
        }
    }
}
```
In the test case of 'PUT_InsertContract', we have added an assertion checking that when a certain condition is met, the last element of the array should be greater than or equal to the inserted element. 

The condition checked is whenever 'index' is within its bounds.

For example, if one tries to insert an element 'y' at index 3 in an array, where array contains [a,b,c], 'a' should not be less than 'y'. This assertion validates the position of newly inserted elements with the last element of the updated array.

## Conclusion 
This blog post outlines the steps to create a custom contract test using Pex for .NET.

The code created here may not suit your actual needs or the application you're working with, but it provides a solid foundation for you to further customize based on your requirements.--------------------            int oldPosition = -1;
            for (int i = 0; i < Old_arrListCount; i++)
            {
                if (arrList[i] == Old_x)
                {
                    oldPosition = i;
                }
            }

            AssumePrecondition.IsTrue(oldPosition != -1);

            int newPosition = -1;
            for (int i = 0; i < New_arrListCount; i++)
            {
                if (arrList[i] == Old_x)
                {
                    newPosition = i;
                }
            }
            
            AssumePrecondition.IsTrue(newPosition != -1);

            if(oldPosition >= New_arrListIndexOf_x && oldPosition == New_arrListLastIndexOf_x)
            { Assert.IsTrue(true); }
            else
            {  Assert.Fail("The last position of x in old list is not greater than or equal to the position of x in the new list"); }

            Assert.AreEqual(New_arrListIndexOf_x, New_index);
            Assert.AreEqual(New_arrListLastIndexOf_x, New_index);
            Assert.AreEqual(New_arrListContains_x, true);
        }
    }
}
```
This program will check if the last appearance of the element is greater than or equal to the insertion point in a list and if everything works fine it will pass the test.

Let’s say if LastIndexOf x is less than or equal to IndexOf x it means that x has been inserted before all old instances of x which is not correct. 

This would imply that Pex is not checking that the last instance of x is not moved or even removed after insertion, instead it is just checking whether the position of x after insertion is correct or not, this may lead to inaccuracies.

This leads us to the next point.

## The Sequence Property of LastIndexOf

When using LastIndexOf function we follow the rule that:
>  The LastIndexOf method returns the highest index of the specified item in the array, or -1 if the item is not found.
 
From this, we understand that the last occurrence of an element in the ArrayList follows a property that LastIndexOf should exhibit, i.e., it must always return the highest index when called with parameters that result in at least one match.

This is a fundamental feature of ArrayList. The problem here is that Pex is not testing this feature properly. It just checks if an element exists somewhere or not, not the position. It shouldn't be used to check insertion for such properties as it might lead to false positives.

## How to fix the issue:

The issue is that the LastIndexOf function always returns the last position of the specified item in an ArrayList when an item appears multiple times, because that's what it's designed to do. 

However, in our scenario, we need to test if the most recent occurrence of a certain value has been shifted to the right properly, i.e., as the list grows, if the old most recent copy of an element is being moved to the right after each insertion.

We are not able to directly use Pex to test this, because Pex does not naturally support this type of testing as it is not possible for it to 'observe' any changes occurring inside an ArrayList that occur outside the ArrayList. Pex is designed to observe a method call, and then automatically generate test inputs until all its inputs produce a method that returns a consistent output, without any side effects. 

Here the solution is simple:

Write a custom assertion method that does this check manually. This will give you the power to check whatever condition you want.

Alternately, you may have to restructure your ArrayList or List implementation in a way that it allows you to observe when an element's last position changes, then use Pex to test that changing that position correctly. 

This isn't easy to do and may involve a significant redesign of your codebase.--------------------            
            Debug.Assert( Old_arrListLastIndexOfX >= Old_arrListIndexOfX || (New_arrListIndexOfX>Old_arrListIndexOfX && New_arrListLastIndexOfX==Old_arrListLastIndexOfX));
           
        }
    }
}--------------------	    // after the inserting an item (when a new item is added in a correct position).
	    
        }

        public void PUT_InsertContract_Fail([PexAssumeUnderTest]ArrayList arrList, int x, int index)
        {
            AssumePrecondition.IsTrue(index <= arrList.Count && index >= 0);
            AssumePrecondition.IsFalse(arrList.Contains(x));

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_x = x;

            var exceptionA = Record.Exception(() => arrList.Insert(index, x));
            PexObserve.Exception(exceptionA);

            int New_arrListCount = arrList.Count;

            PexObserve.ValueForViewing("$old_arrList_count", Old_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
            PexObserve.ValueForViewing("$old_x", Old_x);
            PexObserve.ValueForViewing("$new_arrList_count", New_arrListCount);

	    // an assertion using "Debug.Assert\(.*?\);" that the count of array has not changed 
	    // after trying to insert an item into the array that already contains an instance of it.
	    
        }
    }
}
```

In these contracts we are assuming the behavior of `Insert(int index, T item)` method of the `ArrayList` class. 
- PUT_InsertContract is where an object is inserted into a list at a provided index and then we observe how the count of the elements, their indices, the existence of the item, and the indices of the item have changed.
- PUT_InsertContract_Fail is where we're inserting a new item into the list and observing that the count of elements hasn't changed after a failure scenario (when the list contains the item already). This ensures that `Insert` doesn't silently ignore any attempts to insert an item that exists in the list already. 

These contracts would provide a level of confidence that the code is working according to the specification for different parameter cases.

There are plenty of contracts available, however, ensure that the contracts fulfill the needs of your current use case.--------------------            if (Old_arrListLastIndexOfX >= index && New_arrListLastIndexOfX == index)
            {
                Debug.Assert(Old_arrListLastIndexOfX >= index && New_arrListLastIndexOfX == index);
            }  
	    // an assertion using an expression that asserts @@@ that the count of the new collection is greater than or equal to the count of the original collection
            Assert.IsTrue(New_arrListCount >= Old_arrListCount);
            Assert.AreEqual(New_arrListIndexOfX, Old_arrListIndexOfX);
            Assert.AreEqual(New_arrListLastIndexOfX, Old_arrListLastIndexOfX);
            Assert.AreEqual(New_arrListContainsX, Old_arrListContainsX);
        }
    }
}--------------------	    // after insertion
            Assert.True(Old_arrListLastIndexOfX == Old_arrListIndexOfX && New_arrListLastIndexOfX > New_arrListIndexOfX,
                "Failed Insert Contract: Position of insertion is greater than old last index.");

            // an assertion using "Debug.Assert\(.*?\);" that old collection contains x and new collection also contains x
            Assert.True(Old_arrListContainsX && New_arrListContainsX,
                "Failed: Collection contains x post insertion.");

            // and that the new collection's count is exactly one more than the old collection's
            Assert.True(New_arrListCount == Old_arrListCount + 1,
                "Failed: Count of collection post insertion is one plus the old count.");
        }
    }
}

