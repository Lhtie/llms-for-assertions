        [PexMethod]
        public void PUT_AddContract_RandomRange([PexAssumeUnderTest]ArrayList arrList, int x, [PexAllValues] int[] range)
        {
            AssumePrecondition.IsTrue(true);

            int Old_arrListCount = arrList.Count;
            int Old_arrListIndexOfX = arrList.IndexOf(x);
            int Old_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool Old_arrListContainsX = arrList.Contains(x);

            int New_Ret;
            // the condition of adding x to the array depends only on x value which can be changed in the range
            if (range.Length - 1 > 0 && x > range[0] && x < range[range.Length - 1])
            {
                New_Ret = arrList.Add(x);
            }
            else
            {
                New_Ret = arrList.Add(range[0]); // the x value does not satisfy the condition to add the variable x
            }

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX = arrList.IndexOf(x);
            int New_arrListLastIndexOfX = arrList.LastIndexOf(x);
            bool New_arrListContainsX = arrList.Contains(x);

            // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x in new array is valid ie >= 0 
            Assert.IsTrue(New_arrListIndexOfX >= 0);
            Assert.AreEqual(New_arrListIndexOfX, New_arrListLastIndexOfX);
            Assert.AreEqual(New_arrListContainsX, Old_arrListContainsX);
        }
    }
}--------------------
            Assert.That(New_arrListCount, Is.EqualTo(Old_arrListCount + 1)); // should reflect that add returns the new size
            Assert.That(New_arrListIndexOfX, Is.GreaterThanOrEqualTo(0)); // should reflect that add returns the right index
            Assert.That(New_arrListLastIndexOfX, Is.GreaterThanOrEqualTo(Old_arrListCount)); // reflect that last index of add is valid and unique
            Assert.That(Old_arrListCount +1 == New_Ret); // ret reflects new size increment of the array

            if (New_arrListContainsX)
            { // if x was in the list before, it should still be there at the end of the add
                Assert.IsTrue(New_arrListIndexOfX == New_arrListLastIndexOfX);
            }
            else
	    { // if x wasn't in the list before, there is no last index, it's correct (and there is no error)
             Assert.IsTrue(New_arrListLastIndexOfX == -1);
            }
        }    
    }
}--------------------            Assert.IsTrue(New_Ret >= 0, "Failed!");

            // another assertion using "Assert.AreEqual\(expected: 1, actual: 2, \"message\");" that new arrList count is 1 more than old arrList count
            Assert.AreEqual(Old_arrListCount + 1, New_arrListCount, "Failed!");

            // a final assertion using "throw new PexException\(\"message\");" that index of x in new array equals old array index of x + 1
            Assert.IsTrue(New_arrListIndexOfX == Old_arrListIndexOfX + 1, "Failed!");
        }
	}
