    {
        [Test]
        public void TestAdd()
        {
            ArrayList arrList = new ArrayList();
            int count = arrList.Count;
            int ret = arrList.Add(100);
            Assert.AreEqual(ret, 0);
            Assert.AreEqual(arrList.Count, count + 1);
        }

        [Test]
        public void TestRemove()
        {
            ArrayList arrList = new ArrayList();
            int count = arrList.Count;
            arrList.Add(100);
            arrList.Remove(100);
            Assert.AreEqual(arrList.Count, count);
        }

        [Test]
        public void TestInsert()
        {
            ArrayList arrList = new ArrayList();
            int count = arrList.Count;
            arrList.Add(200);
            arrList.Insert(0, 100);
            Assert.AreEqual(arrList[0], 100);
            Assert.AreEqual(arrList.Count, count + 1);
        }

        [Test]
        public void TestSet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(200);
            arrList[0] = 100;
            Assert.AreEqual(arrList[0], 100);
        }

        [Test]
        public void TestGet()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(100);
            Assert.AreEqual(arrList[0], 100);
        }

        [Test]
        public void TestIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(100);
            Assert.AreEqual(arrList.IndexOf(100), 0);
        }

        [Test]
        public void TestLastIndexOf()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(100);
            arrList.Add(100);
            arrList.Add(100);
            Assert.AreEqual(arrList.LastIndexOf(100), 2);
        }

        [Test]
        public void TestContains()
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(100);
            Assert.IsTrue(arrList.Contains(100));
        }
    }
