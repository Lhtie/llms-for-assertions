def update_bank(persons):
    """ randomly selects two person and transfer some money from one's account to another """
    
    frm_person = random.choice(persons)

    # ensure person doesn't have an empty account
    while all([acc.money == 0 for acc in frm_person.accounts]):
        frm_person = random.choice(persons)
    
    to_person = None
    while to_person is None:
        p = random.choice(persons)
        if p.name != frm_person.name and any([acc.money > 0 for acc in p.accounts]):
            to_person = p

    amnt = random.randint(1, frm_person.accounts[0].money)
    for acc in frm_person.accounts:
        if amnt <= acc.money:
            transfer(acc, to_person.accounts[0], amnt)
            break


persons = [Person("John"), Person("Andrew"), Person("Sara"), Person("Peter")]
for _ in range(100):
    update_bank(persons)

