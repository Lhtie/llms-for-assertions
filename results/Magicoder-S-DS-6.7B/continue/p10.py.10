def test_transfer():
    alice = Person("Alice")
    bob = Person("Bob")

    # attempt to transfer from random account, then the other random account
    from_acc = random.choice(alice.accounts)
    to_acc = random.choice(bob.accounts)

    # try to execute the function to be tested (with assertion failure for illustration)
    try:
        transfer(from_acc, to_acc, 10)
    except AssertionError as e:
        print(f"Assertion raised: {e}")
    else:
        raise AssertionError("Transfer should raise an AssertionError if amounts are negative or too high")

    transfer(from_acc, to_acc, 60)

    assert from_acc.money == 40, "Transfer from did not debit correct amount"
    assert to_acc.money == 60, "Transfer to did not credit correct amount"


