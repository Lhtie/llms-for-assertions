    transfer(person1, person2, 50)
    transfer(person1, person2, 60)
    transfer(person2, person1, 20)

    # create a transfer amount that exceeds the maximum and a negative number
    transfer(person1, person2, 200)  # should fail to transfer
    transfer(person1, person2, -10)  # should fail to transfer


transfer_money()--------------------    assert 0 < amnt <= 100, f"transfer amount {amnt} should be between 0 and 100"

