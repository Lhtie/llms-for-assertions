    frm.money -= amnt
    to.money += amnt

def validate_accounts(persons):
    """ validate the sum of money in every account for every person """

    for person in persons:
        total_money = sum([account.money for account in person.accounts])
        assert total_money == 100, f'{total_money} is not equal to 100'

