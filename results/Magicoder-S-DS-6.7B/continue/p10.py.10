    assert amnt <= 100 and amnt > 0, "Invalid transfer amount"

    # if the account does not have sufficient balance in it then raise an exception
    if frm.money < amnt:
        raise Exception("Not enough balance in account")

    # if both the accounts are from the same person then there is no need for bank to validate this

    # transfer the money
    frm.money -= amnt
    to.money += amnt


