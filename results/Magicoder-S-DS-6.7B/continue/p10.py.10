            if acc.money >= amnt:
                acc.money -= amnt
                for to_acc in to.accounts:
                    to_acc.money += amnt
                print(f"{frm.name} transfered {amnt} to {to.name}")
                break


def bank_run(persons):
    """
    Executes a bank run
    """
    shuffled = persons.copy()
    random.shuffle(shuffled)
    for frm in shuffled:
        for to in shuffled:
            if frm is to:
                continue
            amnt = random.random() * 100
            transfer(frm, to, amnt)


person1 = Person("Alice")
person2 = Person("Bob")
bank_run([person1, person2])

# Print the final balances (after the bank run) of Alice and Bob
print(f"Bob has {sum(acc.money for acc in person2.accounts)} money.")
print(f"Alice has {sum(acc.money for acc in person1.accounts)} money.")--------------------    assert 1 <= amnt <= 100, "Amount must be between 1 and 100"

    i = 0
    success = False
    while i < len(frm.accounts) and not success:
        if frm.accounts[i].money >= amnt:
            frm.accounts[i].money -= amnt
            to.accounts[i].money += amnt
            success = True
        i += 1

    return success


def test_transfer():
    bob = Person("Bob")
    alice = Person("Alice")

    initial_money = bob.accounts[0].money
    initial_money_alice = alice.accounts[0].money

    # Test transferring 1 from Bob to Alice
    assert transfer(bob, alice, 1), 'Transfer should succeed'
    assert bob.accounts[0].money == initial_money - 1, 'Bob\'s money should decrease by transfer amount'
    assert alice.accounts[0].money == initial_money_alice + 1, 'Alice\'s money should increase by transfer amount'

    # Test transferring 99 from Bob to Alice
    initial_money = bob.accounts[0].money
    initial_money_alice = alice.accounts[0].money
    assert transfer(bob, alice, 99), 'Transfer should succeed'
    assert bob.accounts[0].money == initial_money - 99, 'Bob should have less money after 2nd transfer'
    assert alice.accounts[0].money == initial_money_alice + 99, 'Alice should have more money after 2nd transfer'

    # Test transferring 100 from Bob to Alice
    initial_money = bob.accounts[0].money
    initial_money_alice = alice.accounts[0].money
    assert not transfer(bob, alice, 100), 'Transfer should fail'
    assert bob.accounts[0].money == initial_money, 'Bob should stay same after 3rd failure'
    assert alice.accounts[0].money == initial_money_alice, 'Alice should stay same after 3rd failure'

    # Test transferring 200 from Bob to Alice
    initial_money = bob.accounts[0].money
    initial_money_alice = alice.accounts[0].money
    assert not transfer(bob, alice, 200), 'Transfer should fail'
    assert bob.accounts[0].money == initial_money, 'Bob should stay same after 4th failure'
    assert alice.accounts[0].money == initial_money_alice, 'Alice should stay same after 4th failure'

    # Test transferring 0 from Bob to Alice
    initial_money = bob.accounts[0].money
    initial_money_alice = alice.accounts[0].money
    assert not transfer(bob, alice, 0), 'Transfer should fail'
    assert bob.accounts[0].money == initial_money, 'Bob should stay same after 5th failure'
    assert alice.accounts[0].money == initial_money_alice, 'Alice should stay same after 5th failure'


test_transfer()
print("All tests pass.")--------------------    assert amnt < 100 and amnt > 0, "Transfer amount should be between 0 and 100"

    assert isinstance(frm, Account) and isinstance(to, Account), "Transfer source and destination should be an account"

    if frm.money < amnt:
        print(f"{frm} doesn't have enough money to transfer {amnt}")
        return False

    frm.money -= amnt
    to.money += amnt
    print(f"Transferred {amnt} from {frm} to {to}")
    return True


