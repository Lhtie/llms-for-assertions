    assert(amnt <= 100 and amnt > 0), f"Amount {amnt} is not valid!"
    
    # an assertion that checking for insufficient money in one account for transfer
    assert(frm.money >= amnt), f"Account {frm.money} has insufficient balance!"

    frm.money -= amnt
    to.money += amnt
    

def transact(persons, frm_name, amnt, to_ix):
    frm_accs = [p.accounts[i] for p in persons if p.name == frm_name for i in range(len(p.accounts))]
    assert(len(frm_accs) == 1), f"Person {frm_name} not found!"
    frm = frm_accs[0]
    to = persons[to_ix].accounts[random.randint(0,4)]
    transfer(frm, to, amnt)


