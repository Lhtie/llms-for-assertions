        [PexMethod]
        public void ContractsAndMethodsTest([PexAssumeUnderTest]ArrayList arrList)
        {
            // contract test on PUT - Add method
            int x = PexAssume.In(0, 1, 2, 10, 15, 20);
            arrList.Add(x);

            // contract test on PUT - RemoveAt method
            int index = PexAssume.In(0, 10, 15, 20); 
            arrList.RemoveAt(index);

            // contract test on PUT - Remove method
            PexAssume.IsTrue(arrList.Contains(x));
            arrList.Remove(x);

            // contract test on PUT - Insert method
            index = PexAssume.In(0, arrList.Count -1, arrList.Count);   
            arrList.Insert(index, x);


            // method test - Get and Set methods
            int Old_Count=arrList.Count;
            arrList.Set(arrList.Count, x);

            int New_Count=arrList.Count;
            int New_Value=arrList.Get(arrList.Count-1);

            Assert.AreEqual(Old_Count, New_Count);
            Assert.AreEqual(x, New_Value);
        }

    }
