            //    in the array minus the number of items you removed from the array.
            Assert.AreEqual(Old_arrListLastIndexOfX, New_Ret, "New ret is not equal old ret.");

            // a post-condition that 
            // @@@ New_arrList_contains_x is the same as the old value of arrList contains x after performing a state preservation.
            Assert.AreEqual(Old_arrListContainsX, New_arrListContainsX, "New contains is not equal old contains.");
