            Assert.AreEqual(Old_arrListCount, New_arrListCount, "New count is not equal old count.");

            // a post-condition that 
            // @@@ New_arrList_LastIndexOf_x equals old_arrList_LastIndexOf_x - the number of items you removed from the array 
            //    plus the number of items you added to the array.
            Assert.AreEqual(Old_arrListLastIndexOfX, New_arrListLastIndexOfX, "New last index is not equal old last index.");

            // a post-condition that 
