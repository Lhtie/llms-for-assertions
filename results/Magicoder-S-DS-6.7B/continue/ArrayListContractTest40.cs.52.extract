--------------------------------------------------------------------------------------------------------------------------------------------	    // PexObserve.ValueForViewing("$new_arrList_IndexOf_x_gt_eq_0", New_arrListIndexOfX >= 0);

        }

        [PexMethod]
        public void PUT_RemoveAtContract([PexAssumeUnderTest]ArrayList arrList, int index)
        {
            AssumePrecondition.IsTrue(index >= 0 && index < arrList.Count);

            int Old_arrListCount = arrList.Count;
            int Old_index = index;
            int Old_arrListIndexOfX_before_remove = arrList.IndexOf(arrList[index]);
            int Old_arrListLastIndexOfX_before_remove = arrList.LastIndexOf(arrList[index]);
            bool Old_arrListContainsX_before_remove = arrList.Contains(arrList[index]);

            arrList.RemoveAt(index);

            int New_arrListCount = arrList.Count;
            int New_arrListIndexOfX_after_remove = arrList.IndexOf(arrList[index]);
            int New_arrListLastIndexOfX_after_remove = arrList.LastIndexOf(arrList[index]);
            bool New_arrListContainsX_after_remove = arrList.Contains(arrList[index]);
            
            PexObserve.ValueForViewing("$old_arrList_Count", Old_arrListCount);
            PexObserve.ValueForViewing("$new_arrList_Count", New_arrListCount);
            PexObserve.ValueForViewing("$old_arrList_index", Old_index);
	        PexObserve.ValueForViewing("$old_arrList_IndexOf_x_before_remove", Old_arrListIndexOfX_before_remove);
	        PexObserve.ValueForViewing("$old_arrList_LastIndexOf_x_before_remove", Old_arrListLastIndexOfX_before_remove);
	        PexObserve.ValueForViewing("$old_arrList_Contains_x_before_remove", Old_arrListContainsX_before_remove);
	        PexObserve.ValueForViewing("$new_arrList_IndexOf_x_after_remove", New_arrListIndexOfX_after_remove);
	        PexObserve.ValueForViewing("$new_arrList_LastIndexOf_x_after_remove", New_arrListLastIndexOfX_after_remove);
	        PexObserve.ValueForViewing("$new_arrList_Contains_x_after_remove", New_arrListContainsX_after_remove);
            
	    // an assertion using "Debug.Assert\(.*?\);" that  @@@ index of x after remove is more than or same as zero 
	    // PexObserve.ValueForViewing("$new_arrList_IndexOf_x_after_remove_gt_eq_0", New_arrListIndexOfX_after_remove >= 0);

        }

    }
}

