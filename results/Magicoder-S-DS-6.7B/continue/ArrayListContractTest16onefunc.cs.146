//ArrayList.Test/ArrayDequeContractTest.cs
using Microsoft.Pex.Framework;
using System;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;

namespace ArrayList.Test
{
    [PexClass (typeof(ArrayList))]
    
    public partial class ArrayListContractTest
    {
        [PexMethod(PexUseBackdoor = true)]
        public void Add ([PexAssumeUnderTest] ArrayList deque, int item)
        {
            int item_backup = item;
            deque.Add (item);

            Assert.AreEqual (item_backup, deque[0], "added element is not the same during test");
        }
    }
}

//ArrayList.Test/AssumedAttributes/TestContractForArrayList.cs
using Microsoft.Pex.Framework;
using System.Diagnostics;
using System;

namespace ArrayList.Test
{
    [PexClass(typeof(ArrayList))]
    [PexMethodUnderTest("Add")]
    public class ContractForArrayList
    {
        // TODO: Add your testing code here
        [PexMethod(typeof(int))]
        public int GetLength([PexAssumeValid] int item)
        {
            return 2;
        }
        
        [PexMethodUnderTest("Add")]
        public void Add(int x)
        {
            ArrayList arrList = new ArrayList();
            arrList.Add(x);
            Debug.Assert(arrList.Count > 0);
        }

        [PexMethodUnderTest("AddRange")]
        public void AddRange(Object[] x)
        {
            ArrayList arrList = new ArrayList();
            arrList.AddRange(x);
            Debug.Assert(arrList.Count >= x.Length);
        }
    }
}--------------------            if (Old_arrListLastIndexOfX <= New_arrListCount)
            {
                Debug.Assert(Old_arrListIndexOfX <= New_arrListCount);
            }
            else
            {
                Debug.Assert(New_arrListIndexOfX <= Old_arrListIndexOfX);
            }
  	}
    }
}
```

This Pex test case contract `PUT_RemoveContract` verifies that the `Remove` method affects the `Count` and `IndexOf`, `LastIndexOf`, and `Contains` methods appropriately. It further validates the postcondition by asserting that the last index of `x`, before and after the removal, is less or equal to the new array size. Furthermore, it also asserts that the return value of `IndexOf` is less or equal to the new array size.

Remember to include the `PexObserve` and `Debug` in the right sections as shown above. This allows you to observe the input and output values and assertions respectively.

The [PexAssumeUnderTest attribute](https://docs.microsoft.com/en-us/dotnet/framework/test/quick-start-with-microsoft-pex-framework#the-pexassumeundertest-attribute) denotes that the method under test is under the specified test case, which can be helpful in understanding the code's behavior for each test case.

PexContractTest should be included in the same project as the ArrayList class under test and has to be added as a reference for the project. You can run the Pex tests in Pex Explorer, that executes the tests based off configurations. You can manually run the tests as well if you prefer.--------------------            // an assertion using "Debug.Assert\(.*?\);" that  @@@ new array does not contain removed element
            Assert.IsTrue(Old_arrListLastIndexOfX <= New_arrListCount, "Last index of x is larger than new array size");
            Assert.IsFalse(New_arrListContainsX, "New array contains removed element");
        }
    }
}
