assert \result != null &&
    (a.length >= elementCount ==> 
        (\result == a && 
         (\forall int i; 0 <= i && i < elementCount; \result[i] == (T) elementData[i]) &&
         (a.length > elementCount ==> \result[elementCount] == null)
        )
    ) &&
    (a.length < elementCount ==> 
        (\result != a && \result.length == elementCount &&
         (\forall int i; 0 <= i && i < elementCount; \result[i] == (T) elementData[i])
        )
    );
