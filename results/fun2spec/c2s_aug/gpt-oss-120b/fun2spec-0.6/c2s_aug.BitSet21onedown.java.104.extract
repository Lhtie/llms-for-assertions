assert bitIndex >= 0 => (\forall int i; i >= 0; (i == bitIndex ? get(i) == !\old(get(i)) : get(i) == \old(get(i))));
--------------------
assert bitIndex >= 0 => (\forall int i; i >= 0; ((i == bitIndex) => (get(i) == !\old(get(i)))) && ((i != bitIndex) => (get(i) == \old(get(i)))));
--------------------
assert \forall int i; i >= 0; ((i == bitIndex) => (get(i) == !\old(get(i)))) && ((i != bitIndex) => (get(i) == \old(get(i))));
--------------------
assert \forall int i; i >= 0; ((i == bitIndex) => (this.get(i) == !\old(this.get(i)))) && ((i != bitIndex) => (this.get(i) == \old(this.get(i))));
