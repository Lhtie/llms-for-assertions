POST(
    (fromIndex < 0) => (fromIndex == -1 && \result == -1) &&
    (fromIndex >= 0) => (
        (\result == -1) <=> (\forall int i; 0 <= i && i <= fromIndex; get(i))
    ) &&
    (\result != -1) => (
        0 <= \result && \result <= fromIndex &&
        !get(\result) &&
        (\forall int j; \result < j && j <= fromIndex; get(j))

--------------------
POST((\result == -1) ? (\forall int i; 0 <= i && i <= fromIndex; this.get(i)) : (0 <= \result && \result <= fromIndex && !this.get(\result) && (\forall int i; \result < i && i <= fromIndex; this.get(i))))
