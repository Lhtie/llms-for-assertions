assert (0 <= index && index < \old(size())) =>
        (\result == \old(get(index)) &&
         size() == \old(size()) - 1 &&
         (\forall int i; 0 <= i && i < index; get(i) == \old(get(i))) &&
         (\forall int i; index <= i && i < size(); get(i) == \old(get(i + 1))) &&
         !contains(\result) &&
         (\forall Object o; o != \result; contains(o) == \old(contains(o))));
