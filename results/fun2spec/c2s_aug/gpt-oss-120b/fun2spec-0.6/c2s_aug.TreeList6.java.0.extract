assert size() == \old(size()) + 1 &&
    get(index) == obj &&
    (\forall int i; 0 <= i && i < index; get(i) == \old(get(i))) &&
    (\forall int i; index < i && i < size(); get(i) == \old(get(i-1)));
--------------------
assert size() == \old(size()) + 1 && get(index) == obj && (\forall int i; 0 <= i && i < index; get(i) == \old(get(i))) && (\forall int i; index < i && i < size(); get(i) == \old(get(i-1)));
--------------------

--------------------
assert size() == \old(size()) + 1 && get(index) == obj && (\forall int i; 0 <= i && i < \old(size()); (i < index ? get(i) == \old(get(i)) : get(i+1) == \old(get(i))));
--------------------
assert size() == \old(size()) + 1 && get(index) == obj && (\forall int i; 0 <= i && i < \old(size()); (i < index => get(i) == \old(get(i))) && (i >= index => get(i+1) == \old(get(i))));
--------------------
assert true;
