def func(n):
    p43_coeffs = []
    for i in range(n):
        inp = int(input())
        p43_coeffs.append(inp)

    # generate all possible pairs
    pairs = [(p43_coeffs[i], p43_coeffs[j]) for i in range(len(p43_coeffs)) for j in range(i+1, len(p43_coeffs))]
            
    # check if sum of all pairs of differences is at most 1
    for pair in pairs:
        diff = abs(pair[0] - pair[1])
        assert diff <= 1
