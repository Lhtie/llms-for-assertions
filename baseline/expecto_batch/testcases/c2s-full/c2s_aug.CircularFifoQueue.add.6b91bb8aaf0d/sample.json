  "method_code": "@Override\n    public boolean add(final E element) {\n        Objects.requireNonNull(element, \"element\");\n\n        if (isAtFullCapacity()) {\n            remove();\n        }\n\n        elements[end++] = element;\n\n        if (end >= maxElements) {\n            end = 0;\n        }\n\n        if (end == start) {\n            full = true;\n        }\n\n        return true;\n        \n        \n        \n        \n        \n        \n    }",
